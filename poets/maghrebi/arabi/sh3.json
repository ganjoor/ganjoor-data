      "Text": "ولقدک المیاس قلبی طایر",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "ما طیبه و السلع و الواد الحمی",
