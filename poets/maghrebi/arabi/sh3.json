  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "بدت ذاتی باعلام الصفات",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: ذات من به‌واسطهٔ نشانه‌های صفات آشکار شد و همهٔ صفات من نیز به‌واسطهٔ ذات پدیدار شدند. ذات و صفات یکدیگر را آشکار می‌کنند."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "صفاتی کلها ظهرت بذات",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "و شمس الذات قد غابت حجابا",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: آیا خورشید ذات از آن رو پنهان شد و در حجاب رفت که سایه‌های اعیانِ نهفته پدیدار شدند؟ یعنی ظهور کثرت‌ها پرده‌ای بر ذات شد."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "لما ظهرت ظلال الکمنات!؟",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "بکماله ما فی الوجود مظاهر",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: به سبب کمال او، هرچه در هستی است جلوه‌گاه اوست و جمال او در آن‌ها و از آن‌ها آشکار است."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "و جماله فیها و منها ظاهر",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "و لقد تجلی و اختفی بظهوره",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: او جلوه کرد و در همان جلوه‌گری پنهان شد؛ نورهای خود او پرده‌ها و حجاب‌های اویند. شدت ظهور، سبب پنهانی اوست."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "انواره حجب له و ستایر",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "سفرت به الاکوان طرا اوبدا",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: همهٔ موجودات همواره به‌واسطهٔ او از پرده بیرون آمدند و این پرده‌برداری از اوست و هم به سوی او بازمی‌گردد."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "و سفورها منه علیه سافر",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "ما غاب عن عین غیابه فرقه",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: او از چشمی که غیابش جدایی است غایب نشده است؛ آن‌که گمان می‌رود از چشم غایب است، در حقیقت حاضر است."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "ان الذی قدغاب عنها حاضر",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "عن وجهه المستور نورا ساطعا",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: چشم‌ها و بصیرت‌های ما از چهرهٔ پوشیدهٔ او که نوری درخشان است در حجاب نماندند و آن را می‌بینند."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "لم تحتجب ابصار نا و بصایر",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "لو غبت عن شکوی الانام و شکرها",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: اگر از توجه به شکایت و سپاس مردم فارغ شوی، او را در هر شکایت‌کننده و هر سپاسگزاری خواهی دید."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "لرایته فی کل شاک شاکر",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "کل الجمال جمال عن احببته",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: هر زیبایی، زیبایی همان کسی است که دوستش دارم و جمال او در هر عشقی آشکار است."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "و جماله فی کل حب سافر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "ان الجمال حقیقه منه یدا",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: زیبایی در حقیقت از او آغاز شده و از هر عشقی سرانجام به سوی او بازمی‌گردد."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "و الیه من کل حب صابر",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "یا سروه البستان یا غصن النقی",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: ای سرو بوستان و ای شاخهٔ تپهٔ ریگزار، دل من برای قامت خرامان تو پرواز می‌کند."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "ولقدک المیاس قلبی طایر",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "ما طیبه و السلع و الواد الحمی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: طیبه و کوه سلع و وادی و حِمی و منحنی و حاجر، اگر شما نبودید چه ارزشی داشتند؟ این جای‌های نامدار شعر عربی تنها به سبب معشوق معنا دارند."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "و المنحنی لولاکم و الحاجر",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "ما هذه الاطلال لولا انتم",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: این ویرانه‌ها و آثار دیار اگر شما نبودید چه بودند؟ و این آبادی‌ها اگر آبادکننده‌ای نبود چه بودند؟"
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "ما هذه العمران لولا عامر",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "ما فی و ما سلمی و ما لیلی الحمی",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: میّه و سلمی و لیلای حِمی چیزی جز آینه‌ها و جلوه‌گاه‌های زیبایی شما نیستند."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "الا مرا یا حسنکم و مظاهر",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "کل الملاح ارایک و مدارک",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "CoupletSummary": "هوش مصنوعی: همهٔ زیبارویان تخت‌گاه‌ها و منزلگاه‌های تو و نشانه‌ها و منظره‌های جمال شمایند."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "و معالم لجمالکم و مناظر",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "انت الجمیل لک الجمال حقیقه",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17,
      "CoupletSummary": "هوش مصنوعی: زیبای حقیقی تویی و زیبایی در حقیقت از آنِ توست؛ در هر دیده‌شده‌ای تو هستی و بیننده نیز تویی."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "فی کل منظور و انت الناظر",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "یا ظاهرا فی نوره انا باطن",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18,
      "CoupletSummary": "هوش مصنوعی: ای که در نور خود آشکاری، من پنهانم؛ ای که با ظهورت نخستینی، من واپسینم. اشاره به آیهٔ «هو الاول و الآخر و الظاهر و الباطن» است."
    },
    {
      "VOrder": 34,
