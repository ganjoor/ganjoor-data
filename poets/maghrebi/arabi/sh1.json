      "SectionIndex2": 1
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "و تقدس تقدس من یتجلی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "فیک معنی و صوره و خیالا",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "و توحد عن السمات نعوتا",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "و تفرد عن الصفات خیالا",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "و اطو سبع الطباق طی سجل",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "و ارتفع عن جمیعهن خیالا",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 29,
      "Position": "CenteredVerse1",
      "Text": "کبرالله اذ رایت بدورا",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "SectionIndex3": 4
    },
    {
      "VOrder": 30,
      "Position": "CenteredVerse2",
      "Text": "هلل الله اذ شهدت هلالا",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "SectionIndex3": 4
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "ابدا منکم الیکم اهرب",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "و جنابکم یا سادتی لی مهرب",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "حبی لمن اهواه فی دین الهوی",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "هو مذهبی عن مذهب لا اذهب",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "حاشاکم ان تحبونی اننی",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "عن حبکم اسلو او عنکم ارغب",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "یا منتهی المطلوب یا انهی المنی",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "شیئا هواکم عنکم لا اطلب",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "قلبی لدیکم هو فی تصریفکم",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "ابدا علی تقلیبکم یتقلب",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "لا انه بوصالکم یتنعم",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "و ببعدکم و فراقکم یتعذب",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "المر حلو منکم بمذاق من",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "یهواکم و عذابکم مستعذب",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "فاو عدو افضل و صل و اعدل",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "یا طیبا فالکل منکم طیب",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "ما نسبتی الا الیکم سادتی",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "من غیرکم حتی الیه انسب",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "ما غیرکم من ناظری لک ناظر",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "مالی اراکم عنکم یتحجب",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "من یشتکی من بعد قرب بعدکم",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "اذ انتم منه الیه اقرب",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "بظهورکم ظلی انطوی فی نورکم",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "و بنورکم قد زال عنی الغیب",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "منکم بدامابی بدو بی اختفا",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "اعنی له انا مشرق انا مغرب",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    }
  ]
}
