  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "حکم الجمال بذله العشاق",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: زیبایی، فرمانروایی می‌کند بر دل‌های عاشقان و جاذبه معشوق در هر گوشه از عالم محسوس است."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "و بعشوه المعشوق فی الافاق",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "یا اکمل مظهر الوجه الباق",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: ای کامل‌ترین نمایاننده حقیقت جاودانی، ای واسطه‌ی فیض از جانب خالق!"
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "یا واسطه الفیض من الخلاق",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "ختمت بکم مظاهر الاشیاء",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: با وجود شما، جلوه‌های ظاهری تمام شدند و شما موجب کامل شدن فضائل اخلاقی هستید."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "تمت بکم مکارم الاخلاق",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "خذوا العلم من افواه الرجال",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: علم را از زبان مردان دریافت کنید، با دل و احساس نه با عقل و تفکر خردمند."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "بقلب لا بعقل ذی عقال",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "و اقبل نحوهم روحا و قلبا",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: به سوی آن‌ها با روح و قلبت رو کن، اما هیچ کس نمی‌تواند با وجود پر عظمت خود به آن‌ها نزدیک شود."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "ولا یقبل بنفس ذی جلال",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "من یطلب فی الحب من الحب وصال",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: کسی که در عشق بخواهد به وصال معشوق برسد بدون اینکه خودش را فدای عشق کند، امیدی به این کار ندارد."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "من غیر فنا نفسه فهو محال",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "ان تشبه تبلغ وصل المحبوب",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: اگر می‌خواهی به محبوب خود نزدیک شوی، خودت را در مسیر عشق آماده کن و گام به جلو بگذار."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "دع نفسک فی الدرب تقدم و تعال",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "تعبنا من نزول و انتقال",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: ما از نشستن و انتقال در رنج هستیم؛ و از آمدن و رفتن خسته شده‌ایم."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "رمیتا من حلول و ارتحال",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "علی کهف ارینا مستریحا",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: علی در غار آرام نشسته است و در کنار من، در میان کوه‌ها، به استراحت پرداخته است."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "علی طرف من اطراف الجبال",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "حفرنا حفره فیها وقعنا",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: ما در جایی حفره‌ای ایجاد کرده‌ایم و در آن جا افتادیم، همان گونه که باران در دل لعل‌ها فرو می‌افتد."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "وقوع الغیث فی صدق اللالی",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "العین بدت بکسوه الاعیان",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: چشم عمیق و بینا به سمت زیبایی‌ها می‌نگرد و از همان جا حقیقت‌های جهان به شکل‌های مختلف نمایان می‌شود."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "منها ظهرت بصورت الاکوان",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "ماتم ظهورها کمالا الا",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: هیچ کدام از تجلیات کامل و تمام، جز در مظهر جامع انسان، قابل مشاهده نیستند."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "فی مظهر کون جامع الانسان",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "یا مبداء و مابدا من الاکوان",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: ای خدای آغاز و انجام جهانیان، یا ای کسی که همه چیز به سوی تو بازمی‌گردد."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "یا مرجع یا یعود الی الرحمن",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "الحق بکم ینظر الی الاعیان",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: به راستی، تنها به خاطر وجود انسان است که به چهره‌های واقعی نگاه می‌کنید."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "سماک لاجل ذالک بالانسان",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "یا خاتم نص حکمه القران",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "CoupletSummary": "هوش مصنوعی: این بیت به نوعی اشاره به این دارد که قرآن به عنوان یک منبع الهام و دانش در نظر گرفته شده و آیات آن جملگی روشنایی بخش و هدایتگر هستند. همچنین به نقش سوره فرقان به عنوان یک نشانه از حقانیت و راهنمایی اشاره شده است. در واقع، این متن به اهمیت و قدرت قرآن در هدایت انسان‌ها اشاره می‌کند."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "یا لوح نصوص سوره الفرقان",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "لاحب بکم لوایح التوحید",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17,
      "CoupletSummary": "هوش مصنوعی: دوست داشتن شما نشانه‌های یکتاپرستی است که زبان رحمان به آن‌ها سخن می‌گوید."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "نطقت بکم السنه الرحمن",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "فی تیه هوی الحبیب قوم یا هو",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18,
      "CoupletSummary": "هوش مصنوعی: در بیابان عشق، فریاد بزنید ای مردم، الهی، به یاد او ندا کنید."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "نادوا بندایا الهی یا هو",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "ما التیه و ما القوم و ما التیاه",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19,
      "CoupletSummary": "هوش مصنوعی: از کجا بیابم آن راه را و آن مردم را، و آن سرگردانی چیست؟ سرگردانی آنها فقط اوست."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "التیه هم و ما هم الا هو",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    }
