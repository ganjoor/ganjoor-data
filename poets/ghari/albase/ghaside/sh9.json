      "Text": "رشته جامه بوده پودم و تار",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "از خطوط لباس مخفی ماست",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "این سواد بیاض لیل و نهار",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "بکتان و شمط بر افرازیم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "علم از بام این کبود حصار",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "وز دمشقی عمامه بربائیم",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "افسر از فرق گنبد دوار",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "چند در فکر جامه سر در جیب",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "تا بکی ماندن به بند ازار",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "جز برخت نفیس در محفل",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "نتوان شد بصدر صفه بار",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "شخص را پاکی آورد حمام",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "جامه را نازکی دهد آهار",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "مخفی خورد چشم بر قدمن",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "نرسانید جامه هموار",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "همچو ابنای روزگار او نیز",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "تنگ چشمی خویش کرد اظهار",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "نو بپوشیم و آنزمان بخشیم",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "کهنه پار و خرقه پیرار",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "نه عجب نقره و طلا بکمر",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "نیست جای تامل بسیار",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "در جهان هر فراخ چنبر هست",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "صاحب مال و درهم و دینار",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "ای که هستی نیازمند بره",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "پوستین بره نکو ببر آر",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "گوی لولو بجامه کمخا",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "دانهای عرق بروی نگار",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "رخت والا و سوزن سرتیز",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "خار باگل بهم بود ناچار",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "آفتابیست اطلس گلگون",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "بخیهارا بر او چو ذره شمار",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "ساعد آستین اطلس را",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "که سجیف خشیشی است سوار",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "گاه بر اسب ابلق سنجاب",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "روی صوف مربع است سوار",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "ای چو چکمه دوروبسان شریت",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "ترک نرمادگی بگوزنهار",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "غیر نعلین و گیوه و موزه",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "غیر مسحی و کفش و پای اوزار",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "بنما در بساط فرش رخوت؟",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "سالکان مسالک اطوار",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "از گل شرب و لاله والا",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "گلستانیست کلبه تجار",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 60,
      "Position": "Right",
      "Text": "جبه بی پیرهن بدان ماند",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "که بپوشی قبای بی شلوار",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 62,
      "Position": "Right",
      "Text": "اینمقالت دراز چون کرباس",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "چند باید کشید دست بدار",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 64,
      "Position": "Right",
      "Text": "خود چولازم بود بگوقاری",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 65,
      "Position": "Left",
      "Text": "جامه دوختن بقد منار",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    }
  ]
}
