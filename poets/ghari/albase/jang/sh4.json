  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "چو بر تخت سلطان کمخا نشست",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "به پیشش کمر هر لباسی ببست",
