    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "حرم نرمدست مخیل مشیر",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "خزاین بصندوق و مفرش سپرد",
