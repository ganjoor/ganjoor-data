  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "برینگونه چون دگمه چرخش نشاند",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
