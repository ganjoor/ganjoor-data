    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "این‌بار دل از کوی تو غیرت‌زده رفته است",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
