      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "با سنگ طفلان یارب چه سازد",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "نازک دل من مینا دل من",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
