      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "ویرانهٔ عشق معموهٔ حسن",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
