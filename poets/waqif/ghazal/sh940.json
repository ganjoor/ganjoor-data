    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "گر راست ز من پرسی از یار بتر چیزی",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "آخر دل جانان راکردیم به خود مایل",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "از گریهٔ شب چیزی از آه سحر چیزی",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "دیگر چه کمر بندی در کشتن من ظالم",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
