      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "گوشت به حرف مدّعیان است ورنه من",
      "CoupletIndex": 12,
      "SectionIndex1": 0
