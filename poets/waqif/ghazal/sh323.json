      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "آه آن زمان که روی به بسیاری آورد",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
