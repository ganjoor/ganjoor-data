      "Text": "زهی آشنایی زهی آشنایی",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "به جان اشتیاق تو آتش افتد",
