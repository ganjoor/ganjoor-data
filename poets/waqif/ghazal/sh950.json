    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "که تعلیم کردت چنین بی‌وفایی",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
