      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "گر دلش نیست به یاران لباسی چسبان",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
