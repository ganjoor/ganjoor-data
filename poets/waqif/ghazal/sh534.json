    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "می‌کنم ذوق به صد رنگ ز خون خوردن دل",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "کی مرا نعمت الوان به‌نظر می‌آید",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
