      "SectionIndex1": 0,
      "SectionIndex2": 21,
      "SectionIndex3": 27
    },
    {
      "VOrder": 24,
      "Position": "CenteredVerse2",
      "Text": "نگهی به سوی گدا کنی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 21,
      "SectionIndex3": 27
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "تو چرا، الست بربّکم",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "نزنی بزن که اگر، زنی",
