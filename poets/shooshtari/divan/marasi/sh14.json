      "VOrder": 18,
      "Position": "Left",
      "Text": "به حیات من به ممات من",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 19,
      "Position": "CenteredVerse1",
      "Text": "چه زیان کنی چه ضرر، بری",
