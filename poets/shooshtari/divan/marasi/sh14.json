      "SectionIndex1": 0,
      "SectionIndex2": 21,
      "SectionIndex3": 26
    },
    {
      "VOrder": 20,
      "Position": "CenteredVerse2",
      "Text": "که برآوری و عطا کنی",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 21,
      "SectionIndex3": 26
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "تو شه سریر ولایتی",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "تو مه منیر هدایتی",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 23,
      "Position": "CenteredVerse1",
      "Text": "چه شود، گهی به عنایتی",
