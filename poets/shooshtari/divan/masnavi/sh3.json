      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "چو بینم جانب ریحان و سنبل",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "به یاد آرد، مرا آن زلف و کاکل",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "مولّه در چمن بید، است و شمشاد",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "ز هجر قاسم ناکام ناشاد",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "شقایق گر، زبی آبی نزار است",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "همانا حلق طفل شیرخوار است",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "به نیلوفر، نگر که چون سکینه است",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "رُخش سیلی ز سیلی های کینه است",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "به نرگس بین که همچون چشم زینب",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "به حسرت مانده باز از صبح تا شب",
