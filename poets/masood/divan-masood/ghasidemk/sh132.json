      "Text": "نظر زهره و اتصال قمر",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "بوستانیت گشته لشکرگاه",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "مرغزاریت بوده راهگذر",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "اندرین ره هزار بتکده بیش",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
