  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ای غزا کار حیدر صفدر",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "وی سخا پیشه حاتم سرور",
      "CoupletIndex": 0,
      "SectionIndex1": 0
