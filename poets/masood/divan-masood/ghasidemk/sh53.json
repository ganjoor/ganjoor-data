      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "پیوسته یار خنجر نصرت نگار باد",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "محکم نظام دولت و ثابت قوام داد",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
