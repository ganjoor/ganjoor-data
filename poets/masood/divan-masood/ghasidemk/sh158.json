      "Position": "Left",
      "Text": "اگر چه گشتم چون زیر چنگ زار و نزار",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "همیشه جویم همچون شراب شادی او",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
