  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ملک ملک ارسلان",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ملک ارسلان در باغ‌های بهشت ساکن است."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "ساکن روض الجنان",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "شاه زمانه فروز",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: پادشاه دوران، درخشان و مانند خسرو صاحبقران است."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "خسرو صاحبقران",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "رایت و رایش بلند",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: سوار و اسبش در اوج قدرت و بختش به سرمی‌برد."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "دولت و بختش جوان",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "همت او آفتاب",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: عزم و اراده او همچون خورشید درخشان است و مرتبه‌اش به اندازه آسمان بلند و وسیع است."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "رتبت او آسمان",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "مطرب راهی بزن",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای خواننده، لحن شادت را بنواز و دو بندی از شعر بگو."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "راوی بیتی بخوان",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "فی ملک عدله",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در حکومت عدالت، آتش به خدمت درمی‌آید."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "یخدمها النیران",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "ای بدل اردشیر",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای بدل اردشیر، تو نماینده و جانشین اردوان هستی."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "وی عوض اردوان",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "بنده امرت سپهر",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من غلام دستور تو هستم و رازهای جهان به سختی درک می‌شود."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "بسته حکمت جهان",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "ای ملک کامران",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای پادشاه موفق و خوشبخت، تو همچون فرشته‌ای زیبا و زندگی‌بخش هستی."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "خسرو صاحبقران",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "دوش به خواب اندرون",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دیشب در خواب، هنگامی که سپیده صبح دمیده بود،"
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "وقت سپیده دمان",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "آمد نزد رهی",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: نفر را به نزد رهی بردند که در راهی خوشحال و سرزنده بود و از نوشیروان، پادشاه دادگستر، یاد می‌کرد."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "روان نوشیروان",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "گفت که مسعود سعد",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: مسعود سعد، شاعری برجسته و توانمند در هنر شاعری بود."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "شاعر چیره زبان",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "دیدی عدلی که خلق",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آیا دیده‌ای که چگونه عدالت را مردم فراموش کرده‌اند؟"
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "یاد ندارد چنان",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "دید کآباد کرد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: او دید که همه‌ی زمین و آسمان را آباد کرده است."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "جمله زمین و زمان",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "عدل ملک بوالملوک",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: عدالت پادشاه بزرگ و عالی مقام، شاه ملک ارسلان، در میان پادشاهان نمایان است."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "شاه ملک ارسلان",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "در صفت عدل او",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در توصیف عدالت او، ستایش را به آسمان برسان."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "مدح به گردون رسان",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "ورچه امروز هست",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر امروز بدنت این‌قدر ضعیف و ناتوان است،"
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "تنت چنین ناتوان",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "چو گرددت تن درست",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: وقتی که بدنت سالم و ایمن باشد، جانت نیز آرام خواهد بود."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "و ایمن گردی به جان",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "تو وصف این عدل کن",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در توصیف این عدالت، باید به زیبایی و خوبی آن اشاره کنی."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "به وصف نیکو بیان",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "درین معانی به شعر",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در این مفاهیم، ده داستان را به شعر تبدیل کن."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "بساز ده داستان",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "ای ملک مال ده",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای پادشاه، دارایی‌های خود را به کسی ببخش که شایسته است و به او قدرت و سرمایه‌ای بده تا از دنیای خود بهره‌مند شود."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "خسرو گیتی ستان",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "سیاست ملک را",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: سیاست کشور در یک لحظه به تو بستگی دارد."
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "پیش تو در یک زمان",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "جمع شد از هر سویی",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از هر طرف دوصد کوه به حرکت درآمده‌اند."
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "دویست کوه روان",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "جمله بر آن هر یکی",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هرکدام از این افراد، موجودی بسیار قوی و خطرناک هستند."
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "یک اژدهای دمان",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "بر سر هر پیل مست",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بالای هر فیل نیرومند، یک نگهدارنده حاضر است."
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "نشسته یک پیلبان",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "برین سیاست که رفت",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای پادشاه موفق، بر این روش حکومتی اصرار ورزید."
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "ای ملک کامران",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "قحط چو باران نشاند",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: وقتی باران کم می‌شود و زندگی سخت می‌گردد، رحمت تو از آسمان بر زمین نازل می‌شود."
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "رحمت تو از جهان",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "احسنت ای پادشاه",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آفرین بر تو ای پادشاه، امیدوارم که در این جهان همیشه خوشبخت و سالم بمانی."
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "شاد به گیتی بمان",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "داشتن ملک و دین",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: داشتن دارایی و مذهب چه فایده‌ای دارد اگر به این صورت باشد؟"
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "جز که چنین کی توان",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "خلق جهان را همه",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تمامی مردم این کره خاکی، از کودکان و نوجوانان تا بزرگسالان و کهنسالان، در این جهان زندگی می‌کنند."
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "کودک و پیر و جوان",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "به جود کردی غنی",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تو با بخشندگی‌ات ثروتمند کردی و با عدل و انصاف به ما امنیت بخشیدی."
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "به عدل دادی امان",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "زایل کردی شها",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تو باعث شدی که زیبایی‌های این جهان از نظرها پنهان شود و چیزهای ارزشمندی که قبلاً مورد توجه بودند، کم‌ارزش جلوه کنند."
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "ز خلق نرخ گران",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "جانشان دادی همه",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به آن‌ها جان و زندگی‌ات را هدیه کردی، در حالی که اصل و ریشه زندگی، نان و روزی است."
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "که اصل جانست نان",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "خلق به گیتی ندید",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هیچ کس در این دنیا مثل تو که مهربانی، دیده نشده است."
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "چون تو شهی مهربان",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "زین پس دزدان شوند",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از این به بعد، دزدان همراه کاروان خواهند شد."
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "بدرقه کاروان",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "بیش نترسد ز گرگ",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: مرد شبان از گرگ‌ها برای گله‌اش چندان نگران نمی‌شود."
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "بر رمه مرد شبان",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "ز جود خالی نه ای",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از نعمت بخشش بی‌بهره نیستی و از آن بهره‌ای می‌برى."
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "حظی داری از آن",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "عدل تو بر ملک و دین",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: خوشبختی و عدالت تو در جهان و دین، و generosity و بخشش تو نسبت به ثروت و منابع، نشان از عظمت و شایستگی تو دارد."
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "جود تو بر گنج و کان",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "چون تو نبودست و نیست",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: این بیت اشاره دارد به آنکه در غیاب تو، قدرت و عظمت دیده نمی‌شود و زندگی همچنان بی‌روح و بی‌معناست. در واقع، نبود تو باعث می‌شود که جهان رنگ و رونق خود را از دست بدهد."
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "خسرو فرمان روان",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "عادلی و عدل تو",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: عدل و انصاف تو در هر جایی برقرار است."
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "رسید در هر مکان",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "شاها با عدل و ملک",
      "CoupletIndex": 40,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای شاه، با انصاف و حاکمیتت می‌توانی همیشه و تا ابد بر سرزمینت باقی بمانی."
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "زنده بمان جاودان",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    }
  ]
}
