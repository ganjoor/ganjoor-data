    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ملک ملک ارسلان",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: قلمرو ملک ارسلان از آسودگی و آبادی چون باغ‌های بهشت است و مردمش گویی در بهشت ساکن‌اند."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "ساکن روض الجنان",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "شاه زمانه فروز",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: او پادشاهی است که روزگار را روشن می‌کند و خسروی است که بخت و اقبالش یار است (صاحبقران)."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "خسرو صاحبقران",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "رایت و رایش بلند",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: پرچم و اندیشه‌اش بلندپایه است و دولت و بختش جوان و تازه."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "دولت و بختش جوان",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "همت او آفتاب",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: همت او مانند خورشید است و مقام و منزلتش به بلندی آسمان."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "رتبت او آسمان",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "مطرب راهی بزن",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای نوازنده، آهنگی بنواز و ای راوی، بیتی در ستایش او بخوان."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "راوی بیتی بخوان",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "فی ملک عدله",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به عربی می‌گوید: در پادشاهی‌ای که عدالتش چنان است که خورشید و ماه خدمتگزار آن‌اند."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "یخدمها النیران",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "ای بدل اردشیر",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای پادشاهی که جانشین و همتای اردشیر و اردوان، شاهان بزرگ باستانی، هستی."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "وی عوض اردوان",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "بنده امرت سپهر",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آسمان فرمانبردار امر توست و جهان در بند حکم تو."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "بسته حکمت جهان",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "ای ملک کامران",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای پادشاه کامروا و خسرو بلنداقبال."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "خسرو صاحبقران",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "دوش به خواب اندرون",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دیشب در خواب، هنگام سپیده‌دم،"
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "وقت سپیده دمان",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "آمد نزد رهی",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: روان انوشیروان (پادشاه دادگر ساسانی) نزد من، بندهٔ تو، آمد."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "روان نوشیروان",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "گفت که مسعود سعد",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: و گفت: ای مسعود سعد، ای شاعر سخنور و زبان‌آور،"
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "شاعر چیره زبان",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "دیدی عدلی که خلق",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آیا عدلی دیدی که مردم مانند آن را به یاد ندارند؟"
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "یاد ندارد چنان",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "دید کآباد کرد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دیدی که آن عدل همهٔ زمین و روزگار را آباد کرد؟"
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "جمله زمین و زمان",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "عدل ملک بوالملوک",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آن عدل، عدل پادشاه پدر پادشاهان، شاه ملک ارسلان است."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "شاه ملک ارسلان",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "در صفت عدل او",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در وصف عدل او ستایشی بگو که به آسمان برسد."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "مدح به گردون رسان",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "ورچه امروز هست",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هرچند امروز تنت چنین ناتوان و رنجور است،"
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "تنت چنین ناتوان",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "چو گرددت تن درست",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هنگامی که تنت سالم شد و جانت از خطر در امان ماند،"
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "و ایمن گردی به جان",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "تو وصف این عدل کن",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تو این عدل را وصف کن و آن را با بیانی نیکو شرح بده."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "به وصف نیکو بیان",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "درین معانی به شعر",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در این مضمون‌ها ده داستان به شعر بساز."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "بساز ده داستان",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "ای ملک مال ده",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای پادشاهی که مال می‌بخشی و ای خسروی که جهان را می‌گشایی."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "خسرو گیتی ستان",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "سیاست ملک را",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: برای سیاست و کیفر دادن در کار مملکت، در یک زمان در پیشگاه تو..."
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "پیش تو در یک زمان",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "جمع شد از هر سویی",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از هر سو دویست کوه روان، یعنی دویست فیل بزرگ، گرد آمد."
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "دویست کوه روان",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "جمله بر آن هر یکی",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بر هر یک از آن فیلان گویی اژدهایی خروشان سوار بود؛ یعنی سوارانی سهمگین و ترسناک."
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "یک اژدهای دمان",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "بر سر هر پیل مست",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بر سر هر فیل مست یک فیلبان نشسته بود."
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "نشسته یک پیلبان",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "برین سیاست که رفت",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای پادشاه کامروا، با این سیاست و کیفری که انجام شد..."
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "ای ملک کامران",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "قحط چو باران نشاند",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: رحمت تو مانند باران، قحطی را از جهان فرونشاند و برطرف کرد."
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "رحمت تو از جهان",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "احسنت ای پادشاه",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آفرین بر تو ای پادشاه، در جهان شاد و پاینده بمان."
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "شاد به گیتی بمان",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "داشتن ملک و دین",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: نگه‌داشتن ملک و دین جز به این شیوه، یعنی با عدل و سیاست، ممکن نیست."
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "جز که چنین کی توان",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "خلق جهان را همه",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: همهٔ مردم جهان را، از کودک و پیر و جوان..."
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "کودک و پیر و جوان",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "به جود کردی غنی",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: با بخشش خود بی‌نیاز کردی و با عدالتت امنیت بخشیدی."
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "به عدل دادی امان",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "زایل کردی شها",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای شاه، گرانی نرخ‌ها را از سر مردم برداشتی."
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "ز خلق نرخ گران",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "جانشان دادی همه",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: با این کار به همه جان تازه دادی، زیرا مایهٔ جان و زندگی نان است."
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "که اصل جانست نان",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "خلق به گیتی ندید",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: مردم در جهان پادشاهی به مهربانی تو ندیده‌اند."
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "چون تو شهی مهربان",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "زین پس دزدان شوند",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از این پس از بیم عدل تو دزدان نگهبان و همراه کاروان‌ها می‌شوند."
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "بدرقه کاروان",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "بیش نترسد ز گرگ",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: شبان دیگر برای گله‌اش از گرگ نمی‌ترسد؛ یعنی امنیت کامل برقرار شده است."
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "بر رمه مرد شبان",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "ز جود خالی نه ای",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تو هرگز از بخشش تهی نیستی و از آن بهرهٔ فراوان داری."
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "حظی داری از آن",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "عدل تو بر ملک و دین",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: عدل تو بر ملک و دین گسترده است و بخشش تو بر گنج‌ها و معدن‌ها جاری است و آن‌ها را می‌پراکند."
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "جود تو بر گنج و کان",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "چون تو نبودست و نیست",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: پادشاهی فرمانروا مانند تو نه پیش از این بوده و نه اکنون هست."
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "خسرو فرمان روان",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "عادلی و عدل تو",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تو دادگری و عدالتت به همه جا رسیده است."
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "رسید در هر مکان",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "شاها با عدل و ملک",
      "CoupletIndex": 40,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای شاه، همراه با عدل و پادشاهی جاودانه زنده بمان."
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "زنده بمان جاودان",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    }
  ]
}
