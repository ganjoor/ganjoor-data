  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "وز آنسو چو پور بهو رفت پیش",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
