      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "گروهی به ایزدنگویند کس",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
