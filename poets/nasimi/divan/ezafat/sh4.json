  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ای شاه تخت «من عرف »",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: ای پادشاه تخت «من عرف نفسه فقد عرف ربه» (کسی که خود را شناخت خدا را شناخت)، سرمایهٔ عبادت‌هایم بر باد رفته است."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "شد نقد طاعاتم تلف",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "در بقاء بحر لطف",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: در ماندگاری دریای لطف و بخشش، تو از روی بزرگواری دستم را می‌گیری."
    },
    {
      "VOrder": 4,
      "Position": "Left",
