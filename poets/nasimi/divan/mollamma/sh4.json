      "CoupletsCount": 1,
      "MetreId": 12,
      "MetreRefSectionIndex": 0
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "بده ساقی شراب لایزالی",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: به من شراب دائمی بده، تا عاشقان بی‌خیال و بی‌پروا از آن لذت ببرند."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "به دست عاشقان لاابالی",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "تموج فی سفینة بحر خمر",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: امواج در کشتی‌ای در دریای شراب به حرکت درآمده‌اند، گویی که خورشید در درون هلالی جای گرفته باشد."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "کأن الشمس فی جوف الهلال",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "مبادا چشم ما بی‌باده روشن",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: مراقب باش که چشمان ما بدون شراب روشن نشود و مبادا جان ما از عشق تهی گردد."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "مبادا جان ما از عشق خالی",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "همه چیزی زوالی دارد آخر",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: همه چیز در نهایت از بین می‌رود، اما تنها عشق است که از این زوال مستثنی است."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "فقط عشقک تبرا عن زوال",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "اگر در آب باشم یا در آتش",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: اگر در آب باشم یا در آتش، تو همیشه در ذهنم هستی."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "خیالک مونسی فی کل حال",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "و ما تنظر علی عینی و دمعی",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: به آنچه من می‌بینم و اشکم که جاری است نگاه نکن، زیرا در دریا، مرواریدها نیز انتظار دارند."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "و ما فی البحر اشتاق اللالی",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "دلت سخت است و مهرت اندکی سست",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: دل تو سنگی است و محبتت کمی ضعیف است، اما من هر چه بگویم در مورد کمال و خوبی‌ات، فایده‌ای ندارد."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "دگرها هرچه گویم بر کمالی",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "تزد مالا و مالی غیر قلبی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: مال و ثروت را به دست می‌آوری، اما قلبت به آن وابسته نیست و در این دنیا، قلب تو بیشتر از مال و ثروت اهمیت دارد."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "و هذاالقلب فی دنیای مالی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "چنان مستم ندانم روز از شب",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: به قدری سرمست و شادابم که نمی‌توانم روز را از شب تشخیص دهم و نمی‌دانم راست را از چپ."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "و ما اعرف یمینی عن شمالی",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "(چرا از دوستان دل برگرفتی",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: چرا از دوستانت فاصله گرفته‌ای؟ اگر این کار را نمی‌کردی، در دل دشمنان به راحتی می‌توانستی جانت را از دست بدهی."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "وگرنه در تو دشمن جان حلالی) (؟)",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "به گوشت گر رسانم ناله زار",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: اگر صدای غم‌انگیز و ناله‌ام را به تو برسانم، به خاطر سوز و دردی که در دل دارم، تو هم ناله و فریاد خواهی زد."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "ز سوز ناله زارم بنالی",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "فقد حملت حملا غیر حملی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: من بار سنگینی را به دوش می‌کشم که از عهده‌ام خارج است و توانایی تحمل آن را ندارم."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "و ما لی طاقتی عن احتمال",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "لب لعل تو را خواندم شرابی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: من شرابی از لب‌های زیبای تو خواستم که پروردگارشان به آن‌ها نوشیدنی زلالی عطا کرده است."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "«سقاهم ربهم خمرا» زلالی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "بده ساقی شرابی با نسیمی",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: بده به من بطری شرابی که همچون نسیم تازه است و با آن نوشیدنی پاکی را بنوشم."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "شرابک اسقنی واشرب حلالی",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    }
  ]
}
