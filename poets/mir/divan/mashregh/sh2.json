  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ای خرد از حلقه به گوشان تو",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "خلق خوش از عطر فروشان تو",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ای ز تو این گوی گریبان چرخ",
