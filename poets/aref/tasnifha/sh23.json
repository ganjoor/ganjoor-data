      "CoupletIndex": 6,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "پس «امسال خان» آنجا چه می‌کرد",
      "CoupletIndex": 7,
      "SectionIndex1": 1,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: پس «امسال خان» آنجا با عبدالله چه می‌کرد؟ شکری با این پرسش امیر را به بی‌وفایی متهم می‌کند."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "با عبدالله، با عبدالله",
      "CoupletIndex": 7,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "شبی آنجا مهمانی بود",
      "CoupletIndex": 8,
      "SectionIndex1": 1,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: یک شب آنجا مهمانی بود و «اسماعیل قربانی» هم در آن حضور داشت."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "«اسماعیل قربانی» بود",
      "CoupletIndex": 8,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "تو صندوقخانه پنهانی بود",
      "CoupletIndex": 9,
      "SectionIndex1": 1,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: اسماعیل قربانی پنهانی در صندوق‌خانه بود، به اذن خدا. یعنی او را مخفی کرده بودند."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "به اذن الله، به اذن الله",
      "CoupletIndex": 9,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "شبی که خانه خالی بود",
      "CoupletIndex": 10,
      "SectionIndex1": 1,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: شبی که خانه خالی بود، همان معشوقِ نامشروعِ همیشگی آنجا بود."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "فاسق هر سالی بود",
      "CoupletIndex": 10,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "آشکرالله پشت قالی بود",
      "CoupletIndex": 11,
      "SectionIndex1": 1,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: و من، شکرالله، به یاری خدا پشت قالی پنهان شده بودم و همه‌چیز را دیدم."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "به عون الله، به عون الله",
      "CoupletIndex": 11,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "قسم خوردی آی بد نکنی",
      "CoupletIndex": 12,
      "SectionIndex1": 1,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: تو سوگند خورده بودی که بدی نکنی و شکری را از خود نرانی."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "شکری را رد نکنی",
      "CoupletIndex": 12,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "الهی خصمت بکند",
      "CoupletIndex": 13,
      "SectionIndex1": 1,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: خدا کند همان قرآنی که به آن سوگند خوردی، دشمن تو شود و تو را به سزای پیمان‌شکنی برساند."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "کلام الله، کلام الله",
      "CoupletIndex": 13,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    }
  ]
}
