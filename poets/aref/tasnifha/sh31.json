      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "ژیان هاف...",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "اگر خواهی که جنس خر نبینی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "قرق از قاف تا قاف کن ببینم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "طرفدار قجر شد ضد جمهور",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "جدل با این دو سر قاف کن ببینم",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "ژیان هاف...",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "تو تولهٔ «خالصی‌زاده» است تازی",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "پراکنده‌اش به اطراف کن ببینم",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "برای خاطر من هم شد این کار",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "برو بر ضد انصاف کن ببینم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "ژیان هاف...",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "بِدَر تُنبانِ کَرباسِ مُدَرِّس",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "به روی فا و نون کاف کن ببینم",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "«ملک الشعرای» بی‌شرف را",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "ز خون همرنگ اشراف کن ببینم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "ژیان هاف...",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "جواهردزد ملت را تو روزی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "به روز بوریاباف کن ببینم",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "علوفهٔ ملت خر غرق خون، در",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "غیاب شاه علاف کن ببینم",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "ژیان هاف...",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "در ایران، انقلابی جز تو کس نیست",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "درین خونریزی، اسراف کن ببینم",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "ژیان هاف...",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    }
  ]
}
