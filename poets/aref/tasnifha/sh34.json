      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "ز بانگ چنگ و نی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 9,
      "Position": "CenteredVerse1",
      "Text": "که ملک جم یکسر خراب است",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "برای انتخاب",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "در این ملک خراب",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 12,
      "Position": "CenteredVerse1",
      "Text": "وطن فروش مشغول کار است",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "وکیلان را بگو",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "بس است این تکاپو",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 15,
      "Position": "CenteredVerse1",
      "Text": "دور از بهشت شیطان و مار است",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "ما و عشق رخ دوست",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "قبلۀ ما، ابروی اوست",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 18,
      "Position": "CenteredVerse1",
      "Text": "ما ندهیم دل خود، جز به یار",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 19,
      "Position": "CenteredVerse2",
      "Text": "ما نکنیم اعتماد بر اغیار",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "مطرب مجلس بکش این نغمه را",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "از پرده بیرون",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 22,
      "Position": "CenteredVerse1",
      "Text": "ساقی مهوش بده جامی از آن",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "CenteredVerse2",
      "Text": "بادۀ گلگون",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "ای وطن من",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "تو لیلای منی",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 26,
      "Position": "CenteredVerse1",
      "Text": "من بر تو مجنون",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "پاینده بادا درفش کاویان",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "تیغ فریدون",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "ای دل غافل",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "بر احوال وطن",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 31,
      "Position": "CenteredVerse1",
      "Text": "خون گریه کن خون",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "من با تو مایل",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 33,
