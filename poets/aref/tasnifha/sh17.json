      "Text": "زبردست شد، زیردست زیردستان",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "(دستان زیردستان زیردستان)",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "اگر ملک جم شد خراب، گو به ساقی",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "(گو به ساقی تو باش باقی تو باش باقی)",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "صبوحی بده زان شراب شب به مستان",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "(بده به مستان، بده به مستان)",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "بس است ما را هوای بستان",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "که گل دو روز است در گلستان",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "بده می که دنیا دو روز بیشتر نیست",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "مخور غم که ایران ز ما خرابتر نیست",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 13,
      "Position": "CenteredVerse1",
      "Text": "بد آن ملتی کز خرابیش خبر نیست",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 14,
      "Position": "CenteredVerse2",
      "Text": "(جانم خبر نیست)",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "آه که گر آه پر بگیرد",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "دامن هر خشک و تر بگیرد",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "بی خبران را خبر رسانید",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "ز شان بر ما خبر بگیرد",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 19,
      "Position": "CenteredVerse1",
      "Text": "**********",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "ز دارالفنون به جز جنون نداریم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "معارف نه، مالیه نی، قشون نداریم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "برفت حس ملت آن چنان که گوئی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "به تن جان به جان رگ به رگ خون نداریم",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 24,
      "Position": "CenteredVerse1",
      "Text": "به غیر عشق جنون نداریم",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "چه خون توان خورد که خون نداریم",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "نداریم اگر هیچ، هیچ غم نداریم",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "ز اسباب بدبختی هیچ کم نداریم",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "وجودی که باشد به از عدم نداریم",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "پند پدر گر پسر بگیرد",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "دامن فضل و هنر بگیرد",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "ما ز نیاکان نشان چه داریم؟",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "تا که ز ما آن دگر بگیرد",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "به سر نی کله لیک فوج فوج سردار",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "به هر ده یراغ اسب بین شر و سالار",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "ز دربار دولت پی فروش هر روز",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "لقب با جوال می‌برند خرک‌وار",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "پسر اگر شام شب نداریم",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "چه بد است از لقب نداریم",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "تهی‌تو به سان دهل پر از صداییم",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "همه شاه وارث چه باک اگر گداییم",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    }
  ]
}
