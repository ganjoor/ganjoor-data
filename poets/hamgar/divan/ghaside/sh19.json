      "Text": "ز بس شیب و فراز و غور نجدش",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "صبا گردد در او گمراه و مضطر",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
