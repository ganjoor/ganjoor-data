      "VOrder": 30,
      "Position": "Left",
      "Text": "به نازک طبعی آن سیمگون ساق",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "بدان دو طره طرار سرباز",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "بدان دو غمزه غماز ایقاق",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "به گلزار رخت نزهتگه دل",
