      "Position": "Right",
      "Text": "جهانی زحسن ونمی بینمت",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "جهان دیده دیده جهان بین خوهد",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "چنین حسن در نوع انسان کجاست",
