  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "در برِ یاری و به خود مشغولی",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "ای عجب باده نوشی و هُشیار",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "مستی ‌و هستی، این ‌چه‌ بوالهَوسی ‌است",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "بگذر از این و گرنه آن بگذار",
