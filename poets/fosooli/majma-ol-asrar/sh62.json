  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "سؤال اوّل:",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Right",
      "Text": "نخست از فکر خویشم در تَحَیُّر",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Left",
      "Text": "چه چیز است آنکه گویندش تفکّر",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Paragraph",
      "Text": "جواب:",
      "CoupletIndex": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "بود فکر تو، راهِ تو اِلیَ اللّه",
      "CoupletIndex": 3,
      "SectionIndex1": 1
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "تفکّرهای تو، پیمودن راه",
      "CoupletIndex": 3,
      "SectionIndex1": 1
    },
    {
      "VOrder": 7,
      "Position": "Paragraph",
      "Text": "سؤال دوّم:",
      "CoupletIndex": 4
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "کدامین فکر، ما را شرط راه است؟",
      "CoupletIndex": 5,
      "SectionIndex1": 2
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "چرا گه طاعت و گاهی گناهست؟",
      "CoupletIndex": 5,
      "SectionIndex1": 2
    },
    {
      "VOrder": 10,
      "Position": "Paragraph",
      "Text": "جواب:",
      "CoupletIndex": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "توجّه طاعت و هم شرطِ راه است",
      "CoupletIndex": 7,
      "SectionIndex1": 3
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "تَعَیُّن مانع و عین گناه است",
      "CoupletIndex": 7,
      "SectionIndex1": 3
    },
    {
      "VOrder": 13,
      "Position": "Paragraph",
      "Text": "سؤال سوم:",
      "CoupletIndex": 8
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "که باشم من، مرا از من خبر کن",
      "CoupletIndex": 9,
      "SectionIndex1": 4
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "چه معنی دارد اندر خود سفر کن",
      "CoupletIndex": 9,
      "SectionIndex1": 4
    },
    {
      "VOrder": 16,
      "Position": "Paragraph",
      "Text": "جواب:",
      "CoupletIndex": 10
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "توئی آن راه، ز اوّل تا به آخِر",
      "CoupletIndex": 11,
      "SectionIndex1": 5
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "به باطن جاده، در ظاهر مسافر",
      "CoupletIndex": 11,
      "SectionIndex1": 5
    },
    {
      "VOrder": 19,
      "Position": "Paragraph",
      "Text": "سؤال چهارم:",
      "CoupletIndex": 12
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "مسافر چون بود، رهرو کدامست؟",
      "CoupletIndex": 13,
      "SectionIndex1": 6
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "کِه را گویم که او مرد تمام است؟",
      "CoupletIndex": 13,
      "SectionIndex1": 6
    },
    {
      "VOrder": 22,
      "Position": "Paragraph",
      "Text": "جواب:",
      "CoupletIndex": 14
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "مسافر، عامه از بی راهه یا راه",
      "CoupletIndex": 15,
      "SectionIndex1": 7
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "تمام، آن رهرو از راه آگاه",
      "CoupletIndex": 15,
      "SectionIndex1": 7
    },
    {
      "VOrder": 25,
      "Position": "Paragraph",
      "Text": "سؤال پنجم:",
      "CoupletIndex": 16
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "که شد بر سِرِّ وحدت، واقف آخر",
      "CoupletIndex": 17,
      "SectionIndex1": 8
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "شناسایِ چه آمد عارف آخر؟",
      "CoupletIndex": 17,
      "SectionIndex1": 8
    },
    {
      "VOrder": 28,
      "Position": "Paragraph",
      "Text": "جواب:",
      "CoupletIndex": 18
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "کسی کو راه و رهرو را یکی دید",
      "CoupletIndex": 19,
      "SectionIndex1": 9
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "ز سِرِّ وحدت او آگاه گردید",
      "CoupletIndex": 19,
      "SectionIndex1": 9
    },
    {
      "VOrder": 31,
      "Position": "Paragraph",
      "Text": "سؤال ششم:",
      "CoupletIndex": 20
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "اگر معروف و عارف، ذات پاکست",
      "CoupletIndex": 21,
      "SectionIndex1": 10
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "چه سودا بر سر این مشت خاکست؟",
      "CoupletIndex": 21,
      "SectionIndex1": 10
    },
    {
      "VOrder": 34,
      "Position": "Paragraph",
      "Text": "جواب:",
      "CoupletIndex": 22
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "زهی زین مشت خاک و پاک سودا",
      "CoupletIndex": 23,
      "SectionIndex1": 11
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "که ذات پاک، در آن شد هویدا",
      "CoupletIndex": 23,
      "SectionIndex1": 11
    },
    {
      "VOrder": 37,
      "Position": "Paragraph",
      "Text": "سؤال هفتم:",
      "CoupletIndex": 24
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "کدامین نقطه را نُطق است، اَنَاالحق؟",
      "CoupletIndex": 25,
      "SectionIndex1": 12
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "چه گوئی هرزه‌ای بود آن مُزَبَّق؟",
      "CoupletIndex": 25,
      "SectionIndex1": 12
    },
    {
      "VOrder": 40,
      "Position": "Paragraph",
      "Text": "جواب:",
      "CoupletIndex": 26
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "همان نقطه که بی خود گشت و شیدا",
      "CoupletIndex": 27,
      "SectionIndex1": 13
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "حروف کُون از آن گردید پیدا",
      "CoupletIndex": 27,
      "SectionIndex1": 13
    },
    {
      "VOrder": 43,
      "Position": "Paragraph",
      "Text": "سؤال هشتم:",
      "CoupletIndex": 28
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "چرا مخلوق را گویند واصل",
      "CoupletIndex": 29,
      "SectionIndex1": 14
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "سلوک و سیرِ او چون گشت حاصل؟",
      "CoupletIndex": 29,
      "SectionIndex1": 14
    },
    {
      "VOrder": 46,
      "Position": "Paragraph",
      "Text": "جواب:",
      "CoupletIndex": 30
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "چو بی چون شد به بی چون واصل آمد",
      "CoupletIndex": 31,
      "SectionIndex1": 15
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "تَعیُّن داد و عینش حاصل آمد",
      "CoupletIndex": 31,
      "SectionIndex1": 15
    },
    {
      "VOrder": 49,
      "Position": "Paragraph",
      "Text": "سؤال نهم:",
      "CoupletIndex": 32
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "وصال ممکن و واجب به هم چیست؟",
      "CoupletIndex": 33,
      "SectionIndex1": 16
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "حدیث قُرب و بُعد و بیش و کم چیست؟",
      "CoupletIndex": 33,
      "SectionIndex1": 16
    },
    {
      "VOrder": 52,
      "Position": "Paragraph",
      "Text": "جواب :",
      "CoupletIndex": 34
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "چو وصل واجب آمد فصل ز امکان",
      "CoupletIndex": 35,
      "SectionIndex1": 17
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "حدیث قرب او در بُعد خود خوان",
      "CoupletIndex": 35,
      "SectionIndex1": 17
    },
    {
      "VOrder": 55,
      "Position": "Paragraph",
      "Text": "سؤال دهم:",
      "CoupletIndex": 36
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "چه بحر است آنکه نُطقش ساحل آمد؟",
      "CoupletIndex": 37,
      "SectionIndex1": 18
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "ز قعر او چه گوهر حاصل آید؟",
      "CoupletIndex": 37,
      "SectionIndex1": 18
    },
    {
      "VOrder": 58,
      "Position": "Paragraph",
      "Text": "جواب:",
      "CoupletIndex": 38
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "ولی، دریا و نطق اوست ساحل",
      "CoupletIndex": 39,
      "SectionIndex1": 19
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "که از قَعرش برون شد این مسائل",
      "CoupletIndex": 39,
      "SectionIndex1": 19
    },
    {
      "VOrder": 61,
      "Position": "Paragraph",
      "Text": "سؤال یازدهم:",
      "CoupletIndex": 40
    },
    {
      "VOrder": 62,
      "Position": "Right",
      "Text": "چه جزء است آنکه ‌او از کُل فزونست؟",
      "CoupletIndex": 41,
      "SectionIndex1": 20
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "طریقِ جستنِ آن جُزء، چون است؟",
      "CoupletIndex": 41,
      "SectionIndex1": 20
    },
    {
      "VOrder": 64,
      "Position": "Paragraph",
      "Text": "جواب:",
      "CoupletIndex": 42
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "تو جزء از کُل افزون بی گمانی",
      "CoupletIndex": 43,
      "SectionIndex1": 21
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "بجو خود را که تو، بی تو همانی",
      "CoupletIndex": 43,
      "SectionIndex1": 21
    },
    {
      "VOrder": 67,
      "Position": "Paragraph",
      "Text": "سؤال دوازدهم:",
      "CoupletIndex": 44
    },
    {
      "VOrder": 68,
      "Position": "Right",
      "Text": "قدیم و مُحدَث از هم چون جدا شد",
      "CoupletIndex": 45,
      "SectionIndex1": 22
    },
    {
      "VOrder": 69,
      "Position": "Left",
      "Text": "که این عالم شد آن دیگر خدا شد",
      "CoupletIndex": 45,
      "SectionIndex1": 22
    },
    {
      "VOrder": 70,
      "Position": "Paragraph",
      "Text": "جواب:",
      "CoupletIndex": 46
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "تو در آئینه بنگر صورت خویش",
      "CoupletIndex": 47,
      "SectionIndex1": 23
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "که تا مقصود یابی بی کم و بیش",
      "CoupletIndex": 47,
      "SectionIndex1": 23
    },
    {
      "VOrder": 73,
      "Position": "Paragraph",
      "Text": "سؤال سیزدهم:",
      "CoupletIndex": 48
    },
    {
      "VOrder": 74,
      "Position": "Right",
      "Text": "چه خواهد مَرد معنی، ز آن عبارت؟",
      "CoupletIndex": 49,
      "SectionIndex1": 24
    },
    {
      "VOrder": 75,
      "Position": "Left",
      "Text": "که دارد سوی چشم و لب اشارت",
      "CoupletIndex": 49,
      "SectionIndex1": 24
    },
    {
      "VOrder": 76,
      "Position": "Paragraph",
      "Text": "جواب:",
      "CoupletIndex": 50
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "همان خواهد که اندر چشم ولب هست",
      "CoupletIndex": 51,
      "SectionIndex1": 25
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "که عاشق می‌شود زان چشم و لب مست",
      "CoupletIndex": 51,
      "SectionIndex1": 25
    },
    {
      "VOrder": 79,
      "Position": "Paragraph",
      "Text": "سؤال چهاردهم:",
      "CoupletIndex": 52
    },
    {
      "VOrder": 80,
      "Position": "Right",
      "Text": "چه جوید از رُخ و زُلف و خط و خال",
      "CoupletIndex": 53,
      "SectionIndex1": 26
    },
    {
      "VOrder": 81,
      "Position": "Left",
      "Text": "کسی کاندر مقامات است و احوال",
      "CoupletIndex": 53,
      "SectionIndex1": 26
    },
    {
      "VOrder": 82,
      "Position": "Paragraph",
      "Text": "جواب:",
      "CoupletIndex": 54
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "رُخ و زُلف و خط و خالِ دل آرام",
      "CoupletIndex": 55,
      "SectionIndex1": 27
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "از آن جوید که یابد زان دل، آرام",
      "CoupletIndex": 55,
      "SectionIndex1": 27
    },
    {
      "VOrder": 85,
      "Position": "Paragraph",
      "Text": "سؤال پانزدهم:",
      "CoupletIndex": 56
    },
    {
      "VOrder": 86,
      "Position": "Right",
      "Text": "شراب و شمع و شاهد را چه معنی ‌است؟",
      "CoupletIndex": 57,
      "SectionIndex1": 28
    },
    {
      "VOrder": 87,
      "Position": "Left",
      "Text": "خراباتی شدن آخر چه دعوی است؟",
      "CoupletIndex": 57,
      "SectionIndex1": 28
    },
    {
      "VOrder": 88,
      "Position": "Paragraph",
      "Text": "جواب:",
      "CoupletIndex": 58
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "شراب و شمع و شاهد هادی تو است",
      "CoupletIndex": 59,
      "SectionIndex1": 29
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "خراباتی شدن، آبادی توست",
      "CoupletIndex": 59,
      "SectionIndex1": 29
    },
    {
      "VOrder": 91,
      "Position": "Paragraph",
      "Text": "سؤال شانزدهم:",
      "CoupletIndex": 60
    },
    {
      "VOrder": 92,
      "Position": "Right",
      "Text": "بُت و زُنّار و ترسائی در این کوی",
      "CoupletIndex": 61,
      "SectionIndex1": 30
    },
    {
      "VOrder": 93,
      "Position": "Left",
      "Text": "همه کفر است و گرنه چیست؟ برگوی",
      "CoupletIndex": 61,
      "SectionIndex1": 30
    },
    {
      "VOrder": 94,
      "Position": "Paragraph",
      "Text": "جواب:",
      "CoupletIndex": 62
    },
    {
      "VOrder": 95,
      "Position": "Right",
      "Text": "بُت و زُنّار و ترسائی همین است",
      "CoupletIndex": 63,
      "SectionIndex1": 31
    },
    {
      "VOrder": 96,
      "Position": "Left",
      "Text": "که کُفرِعاشق دلداده، دین است",
      "CoupletIndex": 63,
      "SectionIndex1": 31
    },
    {
      "VOrder": 97,
      "Position": "Paragraph",
      "Text": "",
      "CoupletIndex": 64
    },
    {
      "VOrder": 98,
      "Position": "Paragraph",
      "Text": "خاتمه:",
      "CoupletIndex": 65
    },
    {
      "VOrder": 99,
      "Position": "Right",
      "Text": "سخن را هست دامان درازی",
      "CoupletIndex": 66,
      "SectionIndex1": 32,
      "SectionIndex2": 34
    },
    {
      "VOrder": 100,
      "Position": "Left",
      "Text": "ندارم من خیال پرده بازی",
      "CoupletIndex": 66,
      "SectionIndex1": 32,
      "SectionIndex2": 34
    },
    {
      "VOrder": 101,
      "Position": "Right",
      "Text": "بس است ار آشنا در خانه باشد",
      "CoupletIndex": 67,
      "SectionIndex1": 32,
      "SectionIndex2": 35
    },
    {
      "VOrder": 102,
      "Position": "Left",
      "Text": "که از بیگانه‌ها، بیگانه باشد",
      "CoupletIndex": 67,
      "SectionIndex1": 32,
      "SectionIndex2": 35
    },
    {
      "VOrder": 103,
      "Position": "Right",
      "Text": "به نام و سال این سِرِّ حقیقت",
      "CoupletIndex": 68,
      "SectionIndex1": 32,
      "SectionIndex2": 36
    },
    {
      "VOrder": 104,
      "Position": "Left",
      "Text": "بگو (گلزار اسرار حقیقت)",
      "CoupletIndex": 68,
      "SectionIndex1": 32,
      "SectionIndex2": 36
    },
    {
      "VOrder": 105,
      "Position": "Paragraph",
      "Text": "(تاریخ سرودن اشعار فوق با حروف ابجد ۱۳۳۸قمری میباشد.)",
      "CoupletIndex": 69
    },
    {
      "VOrder": 106,
      "Position": "Paragraph",
      "Text": "وَالسَّلَامُ عَلَیْنَا وَعَلَیٰ عِبَادِ اللَّهِ الصَّالِحِینَ",
      "CoupletIndex": 70
    }
  ]
}
