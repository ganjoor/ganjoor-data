  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "چون نداند کس در آخر حال خویش",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "چون نماید تکیه بر اعمال خویش؟",
