  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "اَلغَرَض آن مرد، چون این حال دید",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "حال هر یک را به این مِنوال دید",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "پس بسوی آن پیَمبر بازگشت",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
