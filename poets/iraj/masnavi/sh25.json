  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "شد گذار عزبی از در باغ",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "دید در باغ یکی ماده الاغ",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "باغبان غایب و شهوت غالب",
