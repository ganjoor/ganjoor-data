  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "شنیدم یاوه‌گویی هرزه‌پویی",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "گدایی، سفله‌ای، بی‌آبرویی",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "چو اشعار حجابم را شنیده",
