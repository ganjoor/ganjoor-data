  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "جانا چه شود گر تو درِ مِهر گشایی",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "وز در به در آیی و چو جانم به بر آیی",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "دانی چه گذشتست و زِ ما حال نپرسی",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "وز هیچ دَری هیچ دَرِ ما نگشایی",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "تایی برِ ما ، ور گذرد عمری و آیی",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "ننشسته به پا خیزی و چون عمر نپایی",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "دو بیت ز خاقانیِ شروانی خوانَم",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "استادِ سخن رانی و ممدوح سِتایی",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "«هیچ افتدت امشب که برافتادگیِ من",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "رحم آری و در کاهِشِ جانم نَفَزایی»",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "«یا بر شِکَرِ خویش مرا داری مهمان",
      "CoupletIndex": 5,
      "SectionIndex1": 0
