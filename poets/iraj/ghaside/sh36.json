    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "صد قِصّه به دل گیری ور زان که نمایی",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "خواهی که دلِ من بربایی و ندانی",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "کاین دل نه دلی باشد کو را بربایی",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "من دل به هوای میر دادستم از اول",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "«هرکس به هوایی شد و سعدی به هوایی»",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "چرخِ عظمت میر نظام آن که نگردد",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "الّا که به کامِ دل او چرخِ رَحایی",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "فرخنده خداوندا از ناخوشیِ تو",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "شد پیر فلک ، کرد همی پشت دوتایی",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "یک شهر رها گشت ز بندِ تعب و رنج",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "کامروز ز بندِ تعب و رنج رهایی",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "از ضعف رهانید دعایِ ضُعَفایت",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "زان روی که تو پشت و پناهِ ضعفایی",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "در لیل و نهارت فقرا جمله دعاگو",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "زیرا که تو ملجاء و مَلاذِ فقرایی",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "کس را نبُدی یَد که نرفتی به سویِ حقّ",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "کس را نبُدی لب که نکردیت دعایی",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "ایزد به تو در عالم دردی نپسندد",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "زیرا که به دردِ همه عالم تو دوایی",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "دادارِ جهان رنج و بلا از تو کند دفع",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "کز خلقِ جهان دافعِ رنجی و بلایی",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "حیف است که رانم به زبان نامِ عدویت",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "هر کس که ترا دوست بود باد فدایی",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "دافع بُوَدت حق ضرر از خاکی و بادی",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "نافع بُوَدت آن چه بود ناری و مایی",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "ار شاخه‌ای افسرده شود باک نباشد",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "بیخی تو ، که می‌باید سر سبز بپایی",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "پیوسته بر افراخته باشی و تن آسا",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "کاندر صف دولت تو فرازنده لِوایی",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "همواره به جا باشی و هرگز بِنَیُفتی",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "کاندر کفِ مُلکَت تو بَرازنده عصایی",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "تا ارض و سما باشد باشیّ و مصون باد",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "جان و تنت از آفتِ ارضیّ و سَمایی",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "یک رأیِ تو دو مملکت آسوده نمودی",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "فرخنده چنین رای و چنین صاحب رایی",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "دشتی که وزد رایحۀ قهرِ تو آن جا",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "تا حشر مرویاد در آن مهر گیایی",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "قارن به تو شمشیر دهد چون تو بجنگی",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "بهمن سپر اندازد چون تو به وَغایی",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "در رزم چو کوشش کنی و بزم چو بخشش",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "چون قهرِ خدا باشی و چون بحرِ عطایی",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "یک نثرِ تو بهتر ز مقاماتِ حمیدی",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "یک نظمِ تو خوشتر ز غزل هایِ سنایی",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "این بیت ز صدر الشعّرایِ پدر خویش",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "آرم به مدیحِ تو در این چامه گُوایی",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "«بر حاشیۀ مائدۀ فضلِ تو باشد",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "کشکولِ گدایی به کفِ شیخ بَهایی»",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "صدرا و وزیرا و بلند اختر میرا",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "صَدر الوُزَرایی و امیرُ الأُمَرایی",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "فَخرالشُعَرا خواندی در عیدِ عزیزم",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "دیدی چو کرا داعیۀ مَدح سُرایی",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "چونان که نکردستم از بی لقبی عار",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "فخری نکنم نیز به فَخرُ الشّعرایی",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "خود عار بُوَد ، لیکِن فخرست و مُباهات",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "ممدوح تو چون باشی ، ممدوح ستایی",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "نز با لقبی بوی و بَهایَم بفزودی",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "نز بی لقبی کاست ز من بوی و بهایی",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "فخر من از آنست که همچون تو امیری",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "نامم به زبان آری و گویی که مَرایی",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "از شاعری و شعر بَری باشم و خواهم",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "در سلکِ ادیبان لقبم لطف نمایی",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "از تربیتت هست به من ، گر به ادیبان",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "فضل و هنری باید و ذوقی و ذُکایی",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "شِعرم همه چون شعرِ بُتان چِگِل و چین",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "نثرم همه چون خطِّ نکویانِ خَتایی",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "بس سُخره نمایم من و بس ضِحکه زنم من",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 86,
      "Position": "Left",
      "Text": "گر صرف مُبَرَّد بُوَد و نحوِ کِسایی",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "ایدون که مرا تربیت از شاه بیفزود",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "شاید که تو هم تربیتِ من بفزایی",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "گر ساعدِ مُلکِ شه اینجا بُدی امروز",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "تصدیق مرا کردی از پاک دَهایی",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 91,
      "Position": "Right",
      "Text": "ای ساعدِ مُلک ای که تو از فرّخ حالی",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 92,
      "Position": "Left",
      "Text": "بر ساعدِ مُلک اندر فرخنده همایی",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 93,
      "Position": "Right",
      "Text": "اعیادِ گذشته که مدیح عرضه نمودم",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 94,
      "Position": "Left",
      "Text": "اینجا بُدی امروز ندانم به کجایی",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 95,
      "Position": "Right",
      "Text": "صد حیف که امروز جدا بینمت از میر",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 96,
      "Position": "Left",
      "Text": "ای کاش نبودی ، به جهان نامِ جدایی",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 97,
      "Position": "Right",
      "Text": "نی نی نه جدایی که تو اندر دل اویی",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 98,
      "Position": "Left",
      "Text": "اندر دل او باشی و در دیده نیایی",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 99,
      "Position": "Right",
      "Text": "از بسکه ترا دیده و دل خواهد و جوید",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 100,
      "Position": "Left",
      "Text": "بر هر که نماییم نظر چون تو نمایی",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 101,
      "Position": "Right",
      "Text": "اندر برِ میر ارچه بُوَد خالی جایت",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 102,
      "Position": "Left",
      "Text": "اندر دلِ او خالی نبوَد ز تو جایی",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 103,
      "Position": "Right",
      "Text": "فرخنده دلِ میر یکی خانۀ آنست",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 104,
      "Position": "Left",
      "Text": "کو را به خدا می رسدی خانه خدایی",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 105,
      "Position": "Right",
      "Text": "شاید اگر از فخر بنازی و ببالی",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 106,
      "Position": "Left",
      "Text": "در خانۀ اُنسی تو و همرازِ خدایی",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 107,
      "Position": "Right",
      "Text": "هم مجلسِ عقلی تو و هم صحبتِ عشقی",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 108,
      "Position": "Left",
      "Text": "همخوابۀ صدقی تو و همدوشِ صفایی",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 109,
      "Position": "Right",
      "Text": "در کعبۀ مقصود خود اکنون به طَوافی",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 110,
      "Position": "Left",
      "Text": "در مروۀ آمال خود ایدون به صفایی",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 111,
      "Position": "Right",
      "Text": "کارِ دو جهان سامان زین دل بپذیرفت",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 112,
      "Position": "Left",
      "Text": "زنگِ تعب از این دل یا رب بِزُدایی",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 113,
      "Position": "Right",
      "Text": "ای راد امیری که به گاهِ کرم و جود",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 114,
      "Position": "Left",
      "Text": "آمد به دَرَت حاتمِ طائی به گدایی",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 115,
      "Position": "Right",
      "Text": "بر خِلعتِ شاهی پیِ تبریک سُرایم",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 116,
      "Position": "Left",
      "Text": "فرخنده و فّرخ بُوَدَت خِلعتِ شایی",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 117,
      "Position": "Right",
      "Text": "زین پیش که بودی به امیران و وزیران",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 118,
      "Position": "Left",
      "Text": "اندر سفر و غیرِ سفر مدح سُرایی",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 119,
      "Position": "Right",
      "Text": "از بهرِ ستودنشان بود و ز پیِ مدح",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 120,
      "Position": "Left",
      "Text": "دادندی اگر سیم و زر و برگ و نوایی",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 121,
      "Position": "Right",
      "Text": "تو از پیِ مدحِ خود بر من ندهی زر",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 122,
      "Position": "Left",
      "Text": "خواهی که همه مَکرُمت و جود نمایی",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 123,
      "Position": "Right",
      "Text": "ناچار بُوَد طبع تو از بخشش زان روی",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 124,
      "Position": "Left",
      "Text": "هر لحظه به یک واسطه و عذر برآیی",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 125,
      "Position": "Right",
      "Text": "قدر تو و شأن تو فزونتر بود از این",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 126,
      "Position": "Left",
      "Text": "کز مدح بیفزایی و از هجو بِکایی",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 127,
      "Position": "Right",
      "Text": "من در خورِ فضلِ خود مدحِ تو سُرایم",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    },
    {
      "VOrder": 128,
      "Position": "Left",
      "Text": "اما نه بدان سان که بباییّ و بشایی",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    },
    {
      "VOrder": 129,
      "Position": "Right",
      "Text": "فرخنده امیرا پیِ این نیک قصیده",
      "CoupletIndex": 64,
      "SectionIndex1": 0
    },
    {
      "VOrder": 130,
      "Position": "Left",
      "Text": "خواهم که کنم نیز یکی خوب دعایی",
      "CoupletIndex": 64,
      "SectionIndex1": 0
    },
    {
      "VOrder": 131,
      "Position": "Right",
      "Text": "چون وعدۀ مهدی خان عمر تو مطوّل",
      "CoupletIndex": 65,
      "SectionIndex1": 0
    },
    {
      "VOrder": 132,
      "Position": "Left",
      "Text": "چون آرزویم دولتِ تو باد بقایی",
      "CoupletIndex": 65,
      "SectionIndex1": 0
    },
    {
      "VOrder": 133,
      "Position": "Right",
      "Text": "کان وعده نپندارم هرگز به سر آید",
      "CoupletIndex": 66,
      "SectionIndex1": 0
    },
    {
      "VOrder": 134,
      "Position": "Left",
      "Text": "وین آرزویِ من مپذیراد فنایی",
      "CoupletIndex": 66,
      "SectionIndex1": 0
    },
    {
      "VOrder": 135,
      "Position": "Right",
      "Text": "استاد منوچهری خوش گفت بدین وزن",
      "CoupletIndex": 67,
      "SectionIndex1": 0
    },
    {
      "VOrder": 136,
      "Position": "Left",
      "Text": "«ای تُرکِ من امروز نگویی به کجایی؟»",
      "CoupletIndex": 67,
      "SectionIndex1": 0
    }
  ]
}
