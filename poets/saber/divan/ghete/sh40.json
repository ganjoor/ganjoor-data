      "Text": "آسمانه بر آسمان بردند",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "آسمان ماند و آسمانه نماند",
