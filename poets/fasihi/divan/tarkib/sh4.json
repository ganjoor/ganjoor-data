      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "که کشندش مژه‌ها دوش به دوش",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "مطربا سینه تاری بخراش",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "بلبل باغ نشاطی بخروش",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "ناله‌ای کن که چو گل مستان را",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "خون دل جوش زند تا بر دوش",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "زنده کن تار به مضرابی چند",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "که رگ مرده بود تار خموش",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "دو جهان را به نوایی مستان",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "ناله‌ای را به دو عالم مفروش",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 39,
      "Position": "CenteredVerse1",
      "Text": "خوش هراتی‌ست حزینم مپسند",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 10
    },
    {
      "VOrder": 40,
      "Position": "CenteredVerse2",
      "Text": "طرفه فصلی‌ست بزن راهی چند",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 10
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "این چه فردوس طرب فرجام است",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "که در آن خاک سیه گلفام است",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "چون سموم از غم او باد بهشت",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "رنجه دایم ز تب سرسام است",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "بی سبب مرغ صفیری زد دوش",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "که مهین جنت دنیا شام است",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "باغ زد خنده که ای خام‌نوا",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "آخر این چه دم بی‌هنگام است",
