    },
    {
      "VOrder": 76,
      "Position": "CenteredVerse2",
      "Text": "دهر بی شاه و هری بی تو مباد",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 12
    }
  ]
