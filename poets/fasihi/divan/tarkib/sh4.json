      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 75,
      "Position": "CenteredVerse1",
      "Text": "تا بود انجمن کون و فساد",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
