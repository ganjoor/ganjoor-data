      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "صاف عیش ابدش در جام است",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 57,
      "Position": "CenteredVerse1",
      "Text": "خان جم جاه فلک قدر حسین",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 11
    },
    {
      "VOrder": 58,
      "Position": "CenteredVerse2",
      "Text": "ای ز عدل تو خراسان با زین",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 11
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "ای جهاندار جهانگیر مدار",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "مهر عدل تو فلک را معمار",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "ای جهان از تو همه دم نوروز",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "وی هرات از تو همه روز بهار",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "دوش با دست تو همت می‌گفت",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "کای ترا ابر سخا دریا بار",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "آفتاب فلک جودی لیک",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "اینقدر گرم مشو در ایثار",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "گر همه خود کف خاکیست جهان",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "دیده دشمن خان راست بکار",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "لجه دست تو زده موج عتاب",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "کای تنک مایه ز خود شرم بدار",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "تهمت دیده بر آن قوم مبند",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "که ندانند ز هم لیل و نهار",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "کوری دیده خفاشان را",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "خصمی مهر بود آینه‌وار",
