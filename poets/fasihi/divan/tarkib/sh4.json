      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "آن ولی شام غم دوران است",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "وین صبوح طرب ایام است",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "خاصه امروز که از دولت خان",
