      "Position": "Left",
      "Text": "هر دو از دست خفته و بیدار",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "در مقامی است فاتح الابواب",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
