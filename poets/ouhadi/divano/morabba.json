      "VOrder": 8,
      "Position": "CenteredVerse2",
      "Text": "کندر دل و جان مقام دارد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "SectionIndex3": 18
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "من کشتهٔ عشق آن جمالم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "آشفتهٔ آن دو زلف و خالم",
