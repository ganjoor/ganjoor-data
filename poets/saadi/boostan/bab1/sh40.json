      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "که ممکن بود زهر در انگبین",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
