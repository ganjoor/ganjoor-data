      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "سیاهان براندند کشتی چو دود",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
