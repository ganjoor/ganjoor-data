      "Position": "Left",
      "Text": "قدمهای خاکی، دم آتشین",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "به یک نعره کوهی ز جا بر کنند",
