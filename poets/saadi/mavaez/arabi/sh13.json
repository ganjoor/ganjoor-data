  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "إنْ لَم أمُتْ یَوم الوداعِ تأسفا",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "لا تَحسَبونِي فِي المَوَدَّةِ مُنصِفاً",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "مَن ماتَ لا تَبکُوا عَلَيهِ تَرَحُّماً",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "وَابکُوا لِحَيٍّ فارَقَ المُتَألِّفَا",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "يا طَيفُ إِنْ غَدَرَ الحَبِيبُ تَجانَبَا",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "بَينِي وَبَينَکَ مَوعِدٌ لَن يُخلَفَا",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "لَمّا حَدا الحادِي وَجَدَ رَحِيلَهُمُ",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "ظَفِرَ العَدُوُّ بِما يُؤَمِّلُ واشتَفَى",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "سارُوا بِأَقسَى مِن جِبالِ تِهامَةٍ",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "قَلباً فَلا تَذَرِ الدُموعَ فَتَتلَفَا",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "يا سائِلي عَمَّن بُلِيتُ بِحُبِّهِ",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "أَبَتِ المَحاسِنُ أَن تُعَدَّ وَتُوصَفَا",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "ماذا يُقالُ وَلا شَبِيهَ لِحُسنِهِ",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "لَو کانَ ذا مِثلٍ إِذاً لَتَألَّفَا",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "فَکَشَفنَ عَمّا في البَراقِعِ مُختَفٍ",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "وَتَرَکنَ ما تُخفي الصُّدورُ مُکَشَّفَا",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "هَل يَقتَنِعَنَّ مِنَ الحَبِيبِ بِنَظرةٍ",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "ظَمآنُ لَو شَرِبَ البُحَيرةَ ما اکتَفَى",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "أَوقَفتُ راحِلَتي بِأَرضِ مُوَدِّعٍ",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "وَبَکيتُ حَتّى أَن بَلَلتُ المَوقِفَا",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "مِنهُم إِلَيهِم شَکوتِي وَتَوَجُّعِي",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "ما أَنصَفُونِي وَلَم أَجِد مُستَنصِفَا",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "سَعدِي صَبرا فَالتَّصَبُّرُ لَم يَکُنْ",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "في العِشقِ إِلّا أَن يَکُونَ تَکَلُّفَا",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    }
  ]
}
