  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "الحمدُ للّه ربِّ العالمینَ علیَ",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "ما دَرَّ مِن نعمةٍ عَزَّ اسمُهُ و عَلا",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "الکافلِ الرزقِ احساناً و موهبةً",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "اِن اَحسنُوهُ و اِن لَم یُحسِنوا عَمَلا",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "سبحانهُ من عظیمٍ قادرٍ صمدٍ",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "مُنشی الوَریَ جیلاً مِن بَعدِهِم جیلا",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "الجِنُّ والاِنسُ والاَکوانُ جَمهَرَةً",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "تخِرُّ بینَ یَدَیهِ سُجَّدَاً ذُلُلا",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "طوبیَ لِطالِبِه تَعساً لِتارِکِه",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "بُعداً لِمُتِّخذٍ مِن دوِنه بَدَلا",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "کم فِی البَریّةِ مِن آثارِ قدرتِهِ",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "و فی السماءِ لَآیاتٌ لِمَن عَقَلا",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "مُبَیِّناتٌ لِمَن اَضحی لَهُ بَصَرٌ",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "بنورِ معرفةِ الرحمنِ مُکتَحَلا",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "یُزجی السحائِبُ والآکامُ هامدة",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "یُعیدُها بعدَ یُبسٍ مَربَعاً خَضِلا",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "اَنشا برحمته من حَبّةٍ شجراً",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "سَوّیَ بِقُدرتهِ من نُطفةٍ رَجُلا",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "مَولیً تَقاصَرَتِ الاوهامُ عاجزة",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "لا یعتدونَ الی ادراکِهِ سُبُلا",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "ما العالمون بمُحصِیِّ حقِّ نعمته",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "و لا الملائکُ فی تَسبیحِهم زَجَلا",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "سعدیُّ حَسبُک واقصر عَن مُبالغةٍ",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "لا تَنطِقَنَّ بدعویً تورِثُ الخَجَلا",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "جَلَّ المُهَیمِنُ اَن تُدریَ حقائقَهُ",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "مَن لا لَهُ المثلُ لا تَضرِب لَهُ مَثَلا",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    }
  ]
