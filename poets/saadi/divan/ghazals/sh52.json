      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "ز اندازه به در مبر جفا را",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 7,
      "Position": "CenteredVerse1",
      "Text": "بازآی که از غم تو ما را",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "SectionIndex3": 18
    },
    {
      "VOrder": 8,
      "Position": "CenteredVerse2",
      "Text": "چشمی و هزار چشمه آب است",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "SectionIndex3": 18
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "تندی و جفا و زشت‌خویی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "هرچند که می‌کنی نکویی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 11,
      "Position": "CenteredVerse1",
      "Text": "فرمان برمت به هر چه گویی",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "SectionIndex3": 19
    },
    {
      "VOrder": 12,
      "Position": "CenteredVerse2",
      "Text": "جان بر لب و چشم بر خطاب است",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "SectionIndex3": 19
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "ای روی تو از بهشت بابی",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "دل بر نمک لبت کبابی",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 15,
      "Position": "CenteredVerse1",
      "Text": "گفتم بزنم بر آتش آبی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "SectionIndex3": 20
    },
    {
      "VOrder": 16,
      "Position": "CenteredVerse2",
      "Text": "وین آتش دل نه جای آب است",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "SectionIndex3": 20
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "صبر از تو کسی نیاورَد تاب",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "چشمم ز غمت نمی‌برد خواب",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 19,
      "Position": "CenteredVerse1",
      "Text": "شک نیست که بر مَمَرِّ سیلاب",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "SectionIndex3": 21
    },
    {
      "VOrder": 20,
      "Position": "CenteredVerse2",
      "Text": "چندان که بنا کنی خراب است",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "SectionIndex3": 21
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "ای شهرهٔ شهر و فتنهٔ خیل",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "فی منظرک النّهارُ و اللّیل",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 23,
      "Position": "CenteredVerse1",
      "Text": "هر کاو نکند به صورتت میل",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "SectionIndex3": 22
    },
    {
      "VOrder": 24,
      "Position": "CenteredVerse2",
      "Text": "در صورت آدمی دَواب است",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "SectionIndex3": 22
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "ای داروی دلپذیر دردم",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "اقرار به بندگیت کردم",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 27,
      "Position": "CenteredVerse1",
      "Text": "دانی که من از تو برنگردم",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "SectionIndex3": 23
    },
    {
      "VOrder": 28,
      "Position": "CenteredVerse2",
      "Text": "چندان که خطا کنی صواب است",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "SectionIndex3": 23
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "گرچه تو امیر و ما اسیریم",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "گرچه تو بزرگ و ما حقیریم",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 31,
      "Position": "CenteredVerse1",
      "Text": "گرچه تو غنی و ما فقیریم",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "SectionIndex3": 24
    },
    {
      "VOrder": 32,
      "Position": "CenteredVerse2",
      "Text": "دلداری دوستان ثواب است",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "SectionIndex3": 24
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "ای سرو روان و گلبن نو",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "مه پیکرِ آفتاب‌پرتو",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 35,
      "Position": "CenteredVerse1",
      "Text": "بستان و بده؛ بگوی و بشنو",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "SectionIndex3": 25
    },
    {
      "VOrder": 36,
      "Position": "CenteredVerse2",
      "Text": "شب‌های چنین نه وقت خواب است",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "SectionIndex3": 25
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "امشب شب خلوت است تا روز",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "ای طالعِ سعد و بخت فیروز",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 39,
      "Position": "CenteredVerse1",
      "Text": "شمعی به میان ما برافروز",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "SectionIndex3": 26
    },
    {
      "VOrder": 40,
      "Position": "CenteredVerse2",
      "Text": "یا شمع مکن که ماهتاب است",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "SectionIndex3": 26
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "ساقی قدحی قلندری‌وار",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "در ده به معاشرانِ هشیار",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 43,
      "Position": "CenteredVerse1",
      "Text": "دیوانه به حال خویش بگذار",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "SectionIndex3": 27
    },
    {
      "VOrder": 44,
      "Position": "CenteredVerse2",
      "Text": "کاین مستی ما نه از شراب است",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "SectionIndex3": 27
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "باد است غرور زندگانی",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "برق است لَوامِعِ جوانی",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 47,
      "Position": "CenteredVerse1",
      "Text": "دریاب دمی که می‌توانی",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "SectionIndex3": 28
    },
    {
      "VOrder": 48,
      "Position": "CenteredVerse2",
      "Text": "بشتاب که عمر در شتاب است",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "SectionIndex3": 28
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "این گُرسِنه‌گرگِ بی‌ترحم",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "خود سیر نمی‌شود ز مردم",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 51,
      "Position": "CenteredVerse1",
      "Text": "ابنای زمان مثال گندم",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "SectionIndex3": 29
    },
    {
      "VOrder": 52,
      "Position": "CenteredVerse2",
      "Text": "وین دور فلک چو آسیاب است",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "SectionIndex3": 29
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "سعدی تو نه مرد وصل اویی",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "تا لاف زنی و قرب جویی",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 55,
      "Position": "CenteredVerse1",
      "Text": "ای تشنه به خیره چند پویی",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "SectionIndex3": 30
    },
    {
      "VOrder": 56,
      "Position": "CenteredVerse2",
      "Text": "کاین ره که تو می‌روی سراب است",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "SectionIndex3": 30
    }
  ]
}
