      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "الا به فراق جسم و جانم",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "مجنونم اگر بهای لیلی",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
