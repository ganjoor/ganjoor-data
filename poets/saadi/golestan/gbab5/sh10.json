    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "شپّره گر وصلِ آفتاب نخواهد",
      "CoupletIndex": 5,
      "SectionIndex1": 2
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "رونقِ بازارِ آفتاب نکاهد",
      "CoupletIndex": 5,
      "SectionIndex1": 2
    },
    {
      "VOrder": 10,
      "Position": "Paragraph",
      "Text": "این بگفت و سفر کرد و پریشانی او در من اثر.",
      "CoupletIndex": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "فَقَدْتُ زَمانَ الْوَصْلِ وَ الْمَرْءُ جاهِلٌ",
      "CoupletIndex": 7,
      "SectionIndex1": 3,
      "SectionIndex2": 20
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "بِقَدْرِ لَذیذِ الْعَیْشِ قَبْلَ المَصٰائِبِ",
      "CoupletIndex": 7,
      "SectionIndex1": 3,
      "SectionIndex2": 20
    },
    {
