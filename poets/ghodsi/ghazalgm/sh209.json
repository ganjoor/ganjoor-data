      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ز جان بگسل ولی مگسل ز جانان",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "که جان دارد عوض، جانان ندارد",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "مرا سخت است دل برکندن از تو",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
