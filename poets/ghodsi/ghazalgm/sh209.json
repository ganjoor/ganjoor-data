      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "مترس از کشتن ما بیگناهان",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "که خون عاشقان تاوان ندارد",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "چنان انکار تیر انداختن کرد",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
