      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "چه داند لذت گل‌چیدن آن کس",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
