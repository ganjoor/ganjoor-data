      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "پناه عرش و کرسی سایه اوست",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "ز جزمش عزم دشمن در گریز است",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "ز تبعش فتح را بازار تیرست",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "به شمشیرش عدو در دست‌بازی",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "چو شمع از پنجه در ساعدگدازی",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "کسی از دستبردش جان نبرده",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "عدم، گویی به تیغش دم سپرده",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "ترحم بر جنابش ایستاده",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "دری بر روی نیک و بد گشاده",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "به هیبت حمله‌ای بر دشمن آورد",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "که شد خونش چو آب زعفران زرد",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "جهان را برق تیرت رُفت و رو کرد",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "ز رنگ دشمنت پیدا نشد گرد",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "فلک با گرد خیلت گر ستیزد",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "چنان افتد که گردش برنخیزد",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "ز بانگ کرّنای پادشاهی",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "بود زیر زمین کر گوشِ ماهی",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    }
  ]
}
