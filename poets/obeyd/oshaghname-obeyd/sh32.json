    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "چه کم گردد خدایا از خدائیت",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: خدایا، اگر کمی از خدایی تو کاسته شود، چه آسیبی به پادشاهی و سلطنت تو می‌رسد؟"
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "چه نقصان آید اندر پادشائیت",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "که گر بیچاره‌ای کامی بیابد",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: اگر کسی بیچاره و ناخوش حال باشد، با رسیدن به آرامش و دلخوشی، خوشبختی را به دست خواهد آورد."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "دل‌افگاری دلارامی بیابد",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "خداوندا اگر چه دورم از یار",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: خداوندا، اگرچه از محبوبم دور هستم و از او جدا شده‌ام، اما همچنان امیدوارم که یک بار دیگر به او برسم."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "از او ببریده‌ام امید یکبار",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "و گرچه روزگارم زو جدا کرد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: هرچند روزگار مرا از او جدا کرده است، جدایی او باعث شده که پوشش صبر من به لباس مخصوصی تبدیل شود."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "فراقش جامهٔ صبرم قبا کرد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "قضا دستم ز وصلش کرد کوتاه",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: سرنوشت و قضا و قدر موجب شد که نتوانم به وصالش برسم و این کار به صورت ناگهانی دلخواه من را از من گرفت."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "قدر ببرید ناگاهم ز دلخواه",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "ز من دور اوفتاد آن جان شیرین",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: دوری آن محبوب شیرین از من باعث شد که فراق و جدایی نصیبم شود، در حالی که او به زیبایی خود می‌بالد."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "فراق آمد نصیبم زان نگارین",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "زمانه خاطر ناشاد خواهد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: زمانه خوشی و شادی را از ما دور خواهد کرد و وصال و دیدار محبوب که به دست آوردن آن دشوار است، به مشکل خواهد افتاد."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "وصال از دست مشکل داد خواهد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "به تاثیر اختران بر باد دادند",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: به تأثیر ستاره‌ها، از همدیگر جدا شدیم و هر یک به سرنوشتی متفاوت گرفتار شدیم."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "ز ما هر یک به اقلیمی فتادند",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "به ناکامی شدیم از یکدگر دور",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: ما به خاطر نامرادی از هم جدا شدیم و در جهان به خاطر عشق مان شناخته شدیم."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "به عشق اندر جهان گشتیم مشهور",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "امید از وصل جانان برنگیرم",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: هرگز امیدم را از وصال معشوق (جانان) کنار نخواهم کشید، مگر اینکه از غم دوری او بمیرم."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "مگر کز غصهٔ هجران بمیرم",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "به فضلت همچنان امیدوارم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: من به فضیلت تو همچنان امیدوارم، به طوری که امیدم هیچ‌گاه از کنارم دور نمی‌شود."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "که امیدم نهی اندر کنارم",
