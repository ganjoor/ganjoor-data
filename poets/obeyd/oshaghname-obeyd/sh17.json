      "Text": "میان مردمان بدنام گردد",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "بگو لطفی یکی زین کوی برگرد",
