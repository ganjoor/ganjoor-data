  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "دگر بار آن فسون پرداز استاد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "بر او افسونی از نو کرد بنیاد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "جوابش داد کای سرو سرافراز",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "مکن زین بیشتر بر بیدلان ناز",
