      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "دگر عزیمت صحرا و کوهسار کند",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
