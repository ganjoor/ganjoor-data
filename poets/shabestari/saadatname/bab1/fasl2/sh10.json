  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "دیدن وگفتن و نوشتن حال",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "همچو علم است و قدرت و افعال",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "هر یکی زان بر آن دگر افزون",
