    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "«انت منی» شنو خطاب علی",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "صد هزاران درود باد و سلام",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25,
      "CoupletSummary": "هوش مصنوعی: صدها هزار درود و سلام بر جان پیامبران که پیام خدا را رساندند."
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "بر روان مبلغان پیام",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "خاصه بر روضۀ مطهر پاک",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26,
      "CoupletSummary": "هوش مصنوعی: به‌ویژه بر آرامگاه پاک پیامبری که پروردگارش دربارهٔ او گفت «اگر تو نبودی جهان را نمی‌آفریدم»."
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "الذی قال ربّه «لولاک»",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "بعد از آن بر روان قوم گزین",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27,
      "CoupletSummary": "هوش مصنوعی: پس از او، درود بر جان برگزیدگان یعنی خاندان و یاران پاک و پاک‌آیین او."
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "آل و اصحاب پاک و پاک آئین",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "آنگهی بر روان شیخ کلام",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28,
      "CoupletSummary": "هوش مصنوعی: سپس درود بر جان پیشوای علم کلام، ابوالحسن اشعری، امام مردمان."
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "بوالحسن اشعری، امام انام",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "آنکه بنهاد بهر طاعت را",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29,
      "CoupletSummary": "هوش مصنوعی: کسی که برای فرمانبرداری از خدا، مذهب اهل سنت و جماعت را بنیاد نهاد."
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "مذهب سنت و جماعت را",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "پس بر ارواح سالکان طریق",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30,
      "CoupletSummary": "هوش مصنوعی: سپس درود بر جان رهروان طریقت که شاهبازان عالم حقیقت‌اند."
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "شاه بازان عالم تحقیق",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "زینهار ای عزیز هر دو جهان",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31,
      "CoupletSummary": "هوش مصنوعی: ای عزیز هر دو جهان، زنهار ارزش ایمان خود را به‌خوبی بشناس."
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "قدر ایمان خویش نیک بدان",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "تا به هر شبهه ای ز بی رایی",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 32,
      "CoupletSummary": "هوش مصنوعی: تا مبادا از بی‌خردی با هر شبهه‌ای گره باور خود را بگشایی و ایمانت را سست کنی."
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "عقدۀ اعتقاد نگشایی",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "پند از این روزگار رفته پذیر",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 33,
      "CoupletSummary": "هوش مصنوعی: از روزگار گذشته پند بگیر تا در بند عقل گرفتار نمانی."
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "تا نمانی به بند عقل اسیر",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "وارهان خویش را ز چون و چرا",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 34,
      "CoupletSummary": "هوش مصنوعی: خود را از چون و چرا رها کن؛ زیرکی را که چون بت پرستیده‌ای به چه کار می‌خواهی؟"
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "تا چه خواهی فطانت بت را",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    }
  ]
}
