  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "چو موسی باز می‌گردید از طور",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "در آن وادی سیاهی دید از دور",
