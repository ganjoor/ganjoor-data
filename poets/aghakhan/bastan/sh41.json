    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "به شهنامه اخواست خواند ورا",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: شما به داستان‌های شاهانه علاقه دارید و می‌دانید که او هم به گرد و غبار نوآوری و تغییرات جدیدی که به وجود آمده، پی برده است."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "یکی گرد نوخاست داند ورا",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "زبانش چنو خنجر تیز بود",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: زبان او مانند خنجری تیز است، بسیار سریع و چابک و خونین است."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "بسی تند و چالاک و خونریز بود",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "همه دوده ی پاک اسفندیار",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: اسفندیار تمام دودمان پاک را نابود کرد و از آنها نابودی و پایان کار برآورد."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "بکشت و برآورد از ایشان دمار",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "بسی از بزرگان ایران بکشت",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: بسیاری از بزرگانی که در ایران بوده‌اند، به قتل رسیدند و تو از آنها داستان‌ها و سخنان درست و حقیقی را شنیده‌ای."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "کزایشان سخنها شنیدی درست",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "در ایام او اهل سیدون و تیر",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: در زمان او، افرادی از سیدون و تیر، همان کسانی که به دلیر بودن مشهور بودند."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "همان نامور ارتباس دلیر",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "بشورید و کردند بس سرکشی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: همه جا را آشفته کردند و از هر سو لشکرکشی کردند."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "زهر سو نمودند لشکرکشی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "ز شیپروس و رودس سپاهی دگر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: از سرزمین شیپروس و رودس، نیرویی دیگر به همراه منتور، به سوی جنگ و نبرد می‌آید."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "به همراه منتور پرخاش خر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "به یاری بر تیریان آمدند",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: آنها برای کمک به تیریان آمدند و با خود توافقی در مورد دستاوردها و زیان‌ها به همراه داشتند."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "به پیمان سود و زیان آمدند",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "فرستاد شه آذر و فوسیون",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: شاه آذر و فوسیون سپاهی از ستاره‌ها را فرستاده است."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "ابا لشگری از ستاره فزون",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "که سازند بر دشمنان کار سخت",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: کارهایی که بر ضد دشمنان انجام می‌شود، دشوار است، اما تقدیر و سرنوشت به طور دیگری رقم خورده است."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "ولیکن دگرگونه گردید بخت",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "شکست اندر آمد به ایران سپاه",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: سپاه دشمن به ایران شکست خورد و این خبر باعث ناراحتی و نگرانی شاه شد."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "زاندوه لشکر بجوشید شاه",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    }
  ]
}
