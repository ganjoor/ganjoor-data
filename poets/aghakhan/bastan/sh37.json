  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "پس از مرگ داراب شاه اردشیر",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
