      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "هریدوت خوانده ورا منسومون",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
