    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "ببستند بر قیصر روم راه",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "سواران ایران همه ارجمند",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: سواران ایرانی همه بزرگوار و ارجمند بودند و نیزه‌های بلند در دست داشتند."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "به دست اندرون نیزه های بلند",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "کله خودها چون سر آدمی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: کلاه‌خودهایشان به شکل سر آدمی بود و جای چشم و دهان در آن باز بود."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "در آن جای چشم و دهان بد همی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "کماندارها جنگ را کرده ساز",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: کمانداران برای جنگ آماده شده بودند و تیرهای بلندی از نی داشتند."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "ز نی بودشان تیرهای دراز",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "به ژولین یکی جنگ کردند سخت",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: آنان با ژولین جنگی سخت کردند و گویی بخت از رومیان برگشت."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "همانا که از روم برگشت بخت",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "به شط اندرون ساخت کشتی هزار",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "CoupletSummary": "هوش مصنوعی: سردار روم بر رود هزار کشتی ساخت، اما سرانجام از جنگ به ستوه آمد."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "سپهدار سیر آمد از کارزار",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "آپوستا به جنگ اندرون کشته شد",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17,
      "CoupletSummary": "هوش مصنوعی: آپوستا (ژولین) در جنگ کشته شد و بخت سپاه روم واژگون گشت."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "سر بخت رومی سپه گشته شد",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "ژووین گشت برجای قیصر امیر",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18,
      "CoupletSummary": "هوش مصنوعی: ژووین به جای قیصر فرمانروا شد، اما زود از جنگ خسته و بیزار شد."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "ولیکن به زودی شد از رزم سیر",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "بدانست کو راز ایرانیان",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19,
      "CoupletSummary": "هوش مصنوعی: او دریافت که از جنگ و درگیری با ایرانیان جز زیان به او نمی‌رسد."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "به رزم و به آویزش آید زیان",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "بر شه فرستاد دینار و گنج",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20,
      "CoupletSummary": "هوش مصنوعی: پس برای شاه زر و گنج فرستاد و پنج ولایت را نیز به شاپور واگذار کرد."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "همان داد کشور به شاپور پنج",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "به شهنامه یانس سرایدش نام",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21,
      "CoupletSummary": "هوش مصنوعی: در شاهنامه نام این قیصر «یانس» آمده یا «بزانوش» که نامدار و کامروا بوده است."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "و یا خود بزانوش با نام و کام",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "دگر هرچه زین در زند داستان",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22,
      "CoupletSummary": "هوش مصنوعی: اما داستان‌های دیگری که در این باره در شاهنامه از گفته‌های کهن آمده است،"
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "به شهنامه از گفته باستان",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "که شاپور در روم شد کاروان",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23,
      "CoupletSummary": "هوش مصنوعی: مانند اینکه شاپور همچون ساربانی با کاروان برای بازرگانی به روم رفت،"
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "به بازارگانی چو یک ساروان",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "در آن جای قیصر گرفتش به تنگ",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24,
      "CoupletSummary": "هوش مصنوعی: و قیصر در آنجا او را گرفتار کرد و در پوست خر بست و سخت زندانی کرد،"
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "به چرم خر اندر ببستش چو سنگ",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "همه ژاژ و افسانه باشد سخن",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25,
      "CoupletSummary": "هوش مصنوعی: همه سخن بیهوده و افسانه است و هیچ سر و بنی (پایهٔ درستی) ندارد."
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "که پیدا نمی آیدش سرزبن",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    }
  ]
}
