      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "گر به دست آرم شبی آن طره شبرنگ را",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
