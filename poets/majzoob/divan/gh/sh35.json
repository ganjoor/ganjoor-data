      "Position": "Left",
      "Text": "آرزوی هر دو عالم را به یکدیگر زند",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "لامکان عشق‌بازان صیدگاه عقل نیست",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
