      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "تا ز اکسیر قناعت نظرم یافت جلا",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
