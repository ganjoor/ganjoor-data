  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "مگر کرد شاهی به وقتی شکار",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
