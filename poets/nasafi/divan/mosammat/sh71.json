      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "پامال نرگس سیه رهزنت شوم",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "مفتون چشم کم نگه پر فنت شوم",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 5,
      "Position": "CenteredVerse1",
      "Text": "مجنون آهوانه نگه کردنت شوم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "جان مرا فگار چو ایوب می کنی",
