      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 10,
      "Position": "CenteredVerse1",
      "Text": "قربان طرح و طرز نگه کردنت شوم",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 8
