  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "چو مرغ امر ذی بالی ز آغاز",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "نه از نیروی حمد آید به پرواز",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "به مقصد نارسیده پر بریزد",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "فتد زانسان که هرگز برنخیزد",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Paragraph",
      "Text": "هزاران داستان حمد و ثنا از زبان مرغان بهارستان عشق و وفا که از منابر اغصان فضل و احسان به حسن اصوات و طیب الحان علی الدوام خوانند و به مسامع حاضران مجامع قدس و ناظران مناظر انس علی مرالشهور و الاعوام رسانند.",
      "CoupletIndex": 2
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "صانعی را که گلستان سپهر",
      "CoupletIndex": 3,
      "SectionIndex1": 1
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "باشد از گلشن حسنش ورقی",
      "CoupletIndex": 3,
      "SectionIndex1": 1
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "یا بود بهر ثنا خوانانش",
      "CoupletIndex": 4,
      "SectionIndex1": 1
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "پر نثار در و گوهر طبقی",
      "CoupletIndex": 4,
      "SectionIndex1": 1
    },
    {
      "VOrder": 10,
      "Position": "Paragraph",
      "Text": "جلت عظمة جلاله و علت کلمة کماله و هزار درود و تحیت و سرود از گلوی عندلیبان بستانسرای فضل وجود که مطربان بزم شهود و مغنیان عشرتخانه وجد و وجودند.",
      "CoupletIndex": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "هر گل روضه ابلاغ که هست",
      "CoupletIndex": 6,
      "SectionIndex1": 2
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "گل این باغ ز رویش ورقی",
      "CoupletIndex": 6,
      "SectionIndex1": 2
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "نیست زاوراق چمن مرغان را",
      "CoupletIndex": 7,
      "SectionIndex1": 2
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "بجز اوصاف جمالش سبقی",
      "CoupletIndex": 7,
      "SectionIndex1": 2
    },
    {
      "VOrder": 15,
      "Position": "Paragraph",
      "Text": "و علی صحبه و آله المقتبسین من مشکاة علومه و احواله امابعد نموده می آید که چون در این وقت دلپسند فرزند ارجمند ضیاء الدین یوسف - عصمه الله عما یفضیه الی التلهف و التأسف - به آموختن مقدمات کلام عرب و اندوختن قواعد فنون ادب اشتغال نمود.",
      "CoupletIndex": 8
    },
    {
      "VOrder": 16,
      "Position": "Paragraph",
      "Text": "و پوشیده نماند که طفلان نورسیده و کودکان رنج نادیده را از تعلم اصطلاحاتی که مأنوس طباع و مألوف استماع ایشان نیست بر دل بار وحشتی و در خاطر غبار دهشتی می نشیند، از برای تلطیف سر و تشحیذ خاطر وی گاه گاهی از کتاب گلستان که از انفاس متبرکه شیخ نامدار و استاد بزرگوار مصلح الدین سعدی شیرازی است رحمه الله تعالی، سطری چند خوانده می شد.",
      "CoupletIndex": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "نه گلستان که روضه ای ز بهشت",
      "CoupletIndex": 10,
      "SectionIndex1": 3,
      "SectionIndex2": 5
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "خاک و خاشاک او عبیر سرشت",
      "CoupletIndex": 10,
      "SectionIndex1": 3,
      "SectionIndex2": 5
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "بابهایش بهشت را درها",
      "CoupletIndex": 11,
      "SectionIndex1": 3,
      "SectionIndex2": 6
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "فیض ده قصه هاش کوثرها",
      "CoupletIndex": 11,
      "SectionIndex1": 3,
      "SectionIndex2": 6
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "نکته هایش نهفته در پرده",
      "CoupletIndex": 12,
      "SectionIndex1": 3,
      "SectionIndex2": 7
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "رشک حوران ناز پرورده",
      "CoupletIndex": 12,
      "SectionIndex1": 3,
      "SectionIndex2": 7
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "دلکش اشعار او بلند اشجار",
      "CoupletIndex": 13,
      "SectionIndex1": 3,
      "SectionIndex2": 8
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "از نم لطف تحتهاالانهار",
      "CoupletIndex": 13,
      "SectionIndex1": 3,
      "SectionIndex2": 8
    },
    {
      "VOrder": 25,
      "Position": "Paragraph",
      "Text": "در آن اثنا چنان در خاطر آمد که - تبرکا با نفاسه الشریفة و تتبعا لا شعاره اللطیفة - ورقی چند بر آن اسلوب ساخته شود و جزوی چند بر آن منوال پرداخته گردد تا حاضران را داستانی باشد و غایبان را ارمغانی و چون این معنی به انجام رسید و این صورت به اتمام انجامید،",
      "CoupletIndex": 14
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "با خرد گفتم چه سازم زیور این نوعروس",
      "CoupletIndex": 15,
      "SectionIndex1": 4
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "تا به چشم خواستگارانش فزاید زیب و زین",
      "CoupletIndex": 15,
      "SectionIndex1": 4
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "گفت درهای ثنای شهریار کامگار",
      "CoupletIndex": 16,
      "SectionIndex1": 4
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "نصرة الدینا معز الدوله کهف الخافقین",
      "CoupletIndex": 16,
      "SectionIndex1": 4
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "اختر برج جلالت گوهر درج شرف",
      "CoupletIndex": 17,
      "SectionIndex1": 4
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "شمع بزم دوده تیمورخان سلطان حسین",
      "CoupletIndex": 17,
      "SectionIndex1": 4
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "آسمان قدری که چون خور حال ذرات جهان",
      "CoupletIndex": 18,
      "SectionIndex1": 4
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "باشد از چشم عنایت دیدن او را فرض عین",
      "CoupletIndex": 18,
      "SectionIndex1": 4
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "دین دان در ذمه جودش همه حاجات خلق",
      "CoupletIndex": 19,
      "SectionIndex1": 4
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "کم پسندد جود او در گردن خود عار دین",
      "CoupletIndex": 19,
      "SectionIndex1": 4
    },
    {
      "VOrder": 36,
      "Position": "Paragraph",
      "Text": "اعز الله تعالی انصاره و ضاعف اقتداره و ادام اولاده الکرام تحت ظلال ملکه و سلطانه و انام کافة الانام فی کنف عدله و احسانه.",
      "CoupletIndex": 20
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "گلستان گرچه سعدی کرد از این پیش",
      "CoupletIndex": 21,
      "SectionIndex1": 5,
      "SectionIndex2": 7
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "به نام سعد بن زنگی تمامش",
      "CoupletIndex": 21,
      "SectionIndex1": 5,
      "SectionIndex2": 7
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "بهارستان من نام از کسی یافت",
      "CoupletIndex": 22,
      "SectionIndex1": 5,
      "SectionIndex2": 8
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "که شاید سعد بن زنگی غلامش",
      "CoupletIndex": 22,
      "SectionIndex1": 5,
      "SectionIndex2": 8
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "گذری کن درین بهارستان",
      "CoupletIndex": 23,
      "SectionIndex1": 11,
      "SectionIndex2": 9
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "تا ببینی در او گلستانها",
      "CoupletIndex": 23,
      "SectionIndex1": 11,
      "SectionIndex2": 9
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "وز لطایف به هر گلستانی",
      "CoupletIndex": 24,
      "SectionIndex1": 11,
      "SectionIndex2": 10
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "رسته گلها دمیده ریحانها",
      "CoupletIndex": 24,
      "SectionIndex1": 11,
      "SectionIndex2": 10
    },
    {
      "VOrder": 45,
      "Position": "Paragraph",
      "Text": "و ترتیب این بهارستان بر هشت روضه اتفاق افتاده است، هر روضه ای بهشت آیین مشتمل بر رنگ دیگر از شقایق و بوی دیگر از ریاحین نه شقایقش را از پایمال باد خزان پژمردگی، و نه ریاحینش را از دستبرد برد دی افسردگی.",
      "CoupletIndex": 25
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "دمیده مرغزارش بر جوانب",
      "CoupletIndex": 26,
      "SectionIndex1": 6
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "شکفته لاله زارش در نواحی",
      "CoupletIndex": 26,
      "SectionIndex1": 6
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "ز شبنم لاله را خوی در بناگوش",
      "CoupletIndex": 27,
      "SectionIndex1": 6
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "ز باران غنچه را می در صراحی",
      "CoupletIndex": 27,
      "SectionIndex1": 6
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "غزیر الدمع من عین السواقی",
      "CoupletIndex": 28,
      "SectionIndex1": 6
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "کثیرالضحک عن ثغر الاقاحی",
      "CoupletIndex": 28,
      "SectionIndex1": 6
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "اشارت می کند نرگس که می نوش",
      "CoupletIndex": 29,
      "SectionIndex1": 6
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "فان العفو للزلات ماحی",
      "CoupletIndex": 29,
      "SectionIndex1": 6
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "همی ترسم که از لطف اشارت",
      "CoupletIndex": 30,
      "SectionIndex1": 6
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "کند پرهیزگاران را مباحی",
      "CoupletIndex": 30,
      "SectionIndex1": 6
    },
    {
      "VOrder": 56,
      "Position": "Paragraph",
      "Text": "التماس از تماشائیان این ریاض خالی از خار ملاحظه اعراض و خاشاک مطالبه اعواض آنکه چون به قدم اهتمام بر اینان بگذرند و به نظر اعتبار در اینها بنگرند باغبان را که در تربیت شان خون جگر خورده است و در تنمیت شان جان شیرین بر لب آورده به دعایی یاد کنند و به ثنایی شاد گردانند.",
      "CoupletIndex": 31
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "هر کس ز نیک بختان زین تازه رس درختان",
      "CoupletIndex": 32,
      "SectionIndex1": 7
    },
    {
      "VOrder": 58,
      "Position": "Left",
