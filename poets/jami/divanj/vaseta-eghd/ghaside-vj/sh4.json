    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "قطره اش از وی به کام هرکه چکیده",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "ساقیم آن درد کش که طبع بلندش",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "خرمن هستی به نیم جو نخریده",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "ساغر من کاسه کنار شکسته",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "مطرب من لولی رباب دریده",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "شاهد من دفتری که بر رخ ساده",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "از خط کج مج نهاده زلف خمیده",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "شمع شبم آه آتشین که ز دودش",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "خواب شب از چشم انجم است رمیده",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "من به چنین شب اسیر و نور ضمیرم",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "بر همه آفاقیان چون صبح دمیده",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "منتشر از نثر من هزار صحیفه",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "منتظم از نظم من هزار جریده",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "زاده طبع من است و سخره کلکم",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "فرد و غزل، قطعه، مثنوی و قصیده",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "سلک رباعی زمن نظام گرفته",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "فن معما زمن به نام رسیده",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "در چمن فضل و بوستان فصاحت",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "نخل روانی چو خامه ام نچمیده",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "میوه آن نخل را به کام تأمل",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "هرکه مکیده ست شهد ناب مکیده",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "میوه نخل من این و چاشنیش را",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "کام کسان جز به امتحان نچشیده",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "هر نفسم گفته پیر عقل که جامی",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "ای زدمت نفخه مسیح وزیده",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "چند فشانی رطب بر آن که ز خلقش",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "بر جگرت صد هزار خار خلیده",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "لذت خرمای تر چگونه شناسد",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "ناقه طبعی که خار خشک چریده",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "به که ازین پس به گوش کس نرسانی",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "نکته ناخواه و شعر ناطلبیده",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "بس سخن خوش که در نشیمن نسیان",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "بر سر و پایش عناکبند تنیده",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "چون مگس صید گشته بهر خلاصی",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "گرچه بسی زیر آن تنیده طپیده",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "عاقبت الامر از تمادی دوران",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "نعت خمولی بر اشتهار گزیده",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    }
  ]
}
