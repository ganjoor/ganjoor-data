      "VOrder": 27,
      "Position": "Left",
      "Text": "دین است مرتب شده تاهای مدینه",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "کوثر که شنیدی نبود تشنه دلان را",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "جز ساغر آب از کف سقای مدینه",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "شد جای کسی خاک مدینه که نشاید",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "جز قمه عرش از شرفش جای مدینه",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "مرغ ازلی لحن که از زمرهة اوست",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "در رقص ابد صخره صمای مدینه",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "کالای مدینه چه بود خاک ره او",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "ملک دو جهان قیمت کالای مدینه",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "تا خاک مدینه شده دریای وجودش",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "عقل کل و غواصی دریای مدینه",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "تا یافته حضرت زنم چشمه جودش",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "نزهتگه خضر آمده خضرای مدینه",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "سقف حرم اوست به صد مشعله نور",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "این گنبد فیروزه به بالای مدینه",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "آفاق همه منتظر مقدم اویند",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "و او پردگی مهد معلای مدینه",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "هر چند که در خاک خراسان شده محبوس",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "جامی که بود عاشق شیدای مدینه",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "دارد به خود امید که فردای قیامت",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "سر بر زند از شقه خارای مدینه",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    }
  ]
}
