    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "به غیرت ساخت جان شاه را جفت",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "اشارت کرد کز خوبان هزاران",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "به دارالملک خوبی شهریاران",
