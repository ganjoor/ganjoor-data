      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "پوست اگر بر تن تو جوشن است",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "دست اجل موم کند آهنت",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
