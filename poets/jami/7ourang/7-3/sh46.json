    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "تخت زرت آتش و گوهر در او",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "هست درخشنده چو اخگر در او",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "شعله به جان در زده آن آتشت",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "لیک ز بس بیخودی آید خوشت",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "چون به خود آیی ز شراب غرور",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "آورد آن سوختگی بر تو زور",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "هر دمت از درد دو صد قطره خون",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "از بن هر موی تراود برون",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "سود سر ایوان تو را بر سپهر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "شمسه آن گشت معارض به مهر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "قصر تو چون کاخ فلک سر بلند",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "حادثه را قاصر از آنجا کمند",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "حارس و بواب تو بر بد سگال",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "بسته پی حفظ تو راه خیال",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "لیک نیارند به مکر و حیل",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "بستن آن رخنه که آید اجل",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "زود بود کاید اجل از کمین",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "شیشه عمر تو زند بر زمین",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "نقد حیات تو به غارت برد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "خصم تو را بخت بشارت برد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "کنگر کاخ تو به خاک افکند",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "طاق بلندت به مغاک افکند",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "افسرت از فرق فتد زیر پای",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "پایه تخت تو بلغزد ز جای",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "روزی ازین واقعه اندیشه کن",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "قاعده دادگری پیشه کن",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "ظلم تو را بیخ چو محکم کند",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "ظلم تو ظلم همه عالم بود",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "خواجه به خانه چون بود دف سرای",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "اهل سرایش همه کوبند پای",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "شهری از آشوب تو غارت شود",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "تات یکی خانه عمارت شود",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "کاش کنی ترک عمارتگری",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "تا نکشد کار به غارتگری",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "باغی از آسیب تو گردد تلف",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "تات درآید ته سیبی به کف",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "به که ازان سیب شکیبت بود",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "ور نه به هر سیب حسیبت بود",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "میوه و مرغ سر خوانت مقیم",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "از حرم بیوه و باغ یتیم",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "مطبخیت هیمه ز خوی درشت",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "می کشد از پشته هر کوژپشت",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "باز تو را میر شکاران به فن",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "طعمه ده از جوژه هر پیرزن",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "بارگی خاص تو را هر پسین",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "کاه و جو از توبره خوشه چین",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "گوش کنیزان تو را داده بهر",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "از زر دریوزه گدایان شهر",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "چند کنی ظلم به هر بوم و مرز",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "چند گهی رسم و ره عدل ورز",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "بین که ازین هر دو کدام است به",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "هر چند نه به بر رخ آن دست نه",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "ظلم نهد دام سراب غرور",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "عدل دهد جام شراب سرور",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "هان که جگر سوخته و دل کباب",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "باز نمانی به سراب از شراب",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "شهر و ده آباد به عدل است و بس",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "طبع جهان شاد به عدل است و بس",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "تو چو شبانی و رعیت همه",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "در کنف رحمت تو چون رمه",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "وای شبانی که کند کار گرگ",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 36
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "همچو سگ زرد شود یار گرگ",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 36
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "بره کند باز ز پستان میش",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 37
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "تا دردش گرگ به دندان خویش",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 37
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "عدل تو گر فیض رسانی کند",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 38
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "بر رمه ها گرگ شبانی کند",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 38
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "پنجه کند شانه به دشت و دره",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 39
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "شانه زند گردن و پشت بره",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 39
    }
  ]
}
