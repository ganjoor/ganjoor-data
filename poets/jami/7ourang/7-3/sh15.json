      "Text": "هست نسیم چمن آرای کن",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "صبحدم آن نفحه چو برخاسته ست",
