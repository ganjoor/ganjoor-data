  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "پیشترین نفحه باغ سخن",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
