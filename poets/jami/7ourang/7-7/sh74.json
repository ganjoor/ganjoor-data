      "Text": "به تیغ قضای خداوند پاک",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "که باشد روان از سمک تا سماک",
