  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "چو سرچشمه فیض اسکندری",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "کزو بود همچون صدف گوهری",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
