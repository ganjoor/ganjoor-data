      "Text": "شه سلامان را در آن ماتم چو دید",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "بر دلش صد زخم رنج و غم رسید",
