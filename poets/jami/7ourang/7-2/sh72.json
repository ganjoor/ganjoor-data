  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "افسر شاهی چه خوش سرمایه است",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "تخت سلطانی چه عالی پایه است",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "هر سری لایق به آن سرمایه نیست",
