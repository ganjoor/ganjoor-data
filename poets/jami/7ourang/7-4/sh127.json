  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ای ز گلزار سخن یافته بوی",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "وز تماشای چمن تافته روی",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
