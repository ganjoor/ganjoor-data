  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "بوتراب آن گهر بحر شرف",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "کابرو یافت ازو خاک نسف",
