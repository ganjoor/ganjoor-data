  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "سعدی آن بلبل شیراز چمن",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "در گلستان سخن دستان‌زن",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
