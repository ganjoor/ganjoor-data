      "Position": "Left",
      "Text": "یک اعوذت اعوذبالله نیست",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "بلکه آن پیش صاحب عرفان",
