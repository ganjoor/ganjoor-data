  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "آن یکی از همه جهان بجهد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "تا ز آسیب گمرهان برهد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "کند از نفع و ضرشان حذری",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "تا نبیند ز شرشان شرری",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "رمد از خلق در سرار و جهار",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "تا زید ایمن از شرار و شرار",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "ای بسا کس که خرمنی اندوخت",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "جست ناگاه یک شرار و بسوخت",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "دوستداران که نیکخواهانند",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "روز دزدان و عمر کاهانند",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "روز عمر تو را به حیله و ریو",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "آلت دد کنند و عدت دیو",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "گاه هم پنجه ددت سازند",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "گاه در دام دیوت اندازند",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "بخردی گوهر خرد سفته است",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "مار بد به که یار بد گفته است",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "مار بد جز به گرد تن نتند",
