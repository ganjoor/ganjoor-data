      "Text": "اکتساب مراد نفس فحسب",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "حرکاتش همه هوا و هوس",
