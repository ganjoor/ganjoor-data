  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "قال خیرالوری علیه سلام",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: حضرت خیرالوری (علیه السلام) فرمودند: تنها مردم در خواب و غفلتند."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "انما الناس هجع و نیام",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "فاذا جائهم و ان کرهوا",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: زمانی که آنان به حالت بی‌خوابی و ترس از مرگ می‌رسند، پس از آن به خود می‌آیند و متوجه واقعیت می‌شوند."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "سکرة الموت بعدها انتبهوا",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "آدمیزاده در مبادی حال",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: انسان در آغاز زندگی‌اش همیشه در پی خواسته‌ها و تمایلات خود می‌گردد و این روند ادامه دارد."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "پی نفس و هوا رود همه سال",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "غیر تن پروری ندارد خوی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: تن پروری و پرهیز از کار و کوشش، انسان را از دانایی و علم باز می‌دارد. اگر کسی فقط به دنبال راحتی جسمی باشد، نمی‌تواند به علم و دانش دست یابد."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "سوی دانشوری نیارد روی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "خواب غفلت گرفته چشم دلش",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: چشم دل او تحت تأثیر خواب غفلت قرار گرفته و نتوانسته است به زیبایی‌های زندگی و دنیای مادی توجه کند."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "نگذشته نظر ز آب و گلش",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "پی نبرده ز فرط نادانی",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: این شخص به دلیل نادانی‌اش فقط به خوشی‌های جسمی و مادی توجه دارد و از مسائل عمیق‌تر بی‌خبر است."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "جز به لذات جسم و جسمانی",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
