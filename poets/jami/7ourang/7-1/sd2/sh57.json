    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "خواسته ست از خدای استغفار",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "از برای چه دوستدارانند",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: دوستداران به چه دلیلی وجود دارند و خواستگاران به چه انگیزه‌ای در پی عشق و محبت‌اند؟"
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "وز هوای که خواستگارانند",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "گفت بهر یگانه ای ز کرام",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: او گفت که به خاطر یگانه‌ای از افراد با فضیلت و بزرگ‌نسب، به نام عیینه، اینجا آمده است."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "عالی اندر نسب عیینه به نام",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "گفت من هم شنیده ام خبرش",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: او گفت که من هم داستانش را شنیده‌ام و می‌دانم که هیچ نسبتی با دیگران ندارد."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "نسبتی نیست با کسی دگرش",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "چون کند وعده در وفا کوشد",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: وقتی کسی وعده می‌دهد، سعی می‌کند که به آن عمل کند و از سختی‌های زندگی ناامید نمی‌شود."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "وز جفای زمانه نخروشد",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "هر چه آید به دست او بدهد",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: هر چه از دست او بیفتد، به او باز می‌گردد و هرگز به آنچه دیگران دارند نگاه نمی‌کند."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "چشم بر دست دیگران ننهد",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "پدرش گفت می خورم سوگند",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: پدرش گفت: به خدایی که هیچ کس مانند او نیست، سوگند می‌خورم که می‌خورم."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "به خدایی که نبودش مانند",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "که تو را هیچگه به وی ندهم",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: من هیچ وقت تو را به او نمی‌عدم و اجازه نمی‌دهم که با دامنش ارتباطی داشته باشی."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "نقد وصلت به دامنش ننهم",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "واقفم از فسانه تو و او",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: من از داستان تو و او آگاه هستم و او نیز از آنچه میان شما دو نفر گذشته، خبر دارد."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "زانچه بوده میانه تو و او",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "گفت باری مرا چه بازار است",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "CoupletSummary": "هوش مصنوعی: فردی می‌گوید که چه نیازی به بازار و دنیا دارم، در حالی که همه چیز برایم به خاطرتو و به خاطر وجود تو ارزشمند است."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "که ازان خاطر تو دربار است",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "نه خیالی ز روی من دیده ست",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17,
      "CoupletSummary": "هوش مصنوعی: هیچ چیز از چهره‌ام در خیال کسی نیست و هیچ گیاهی از باغم چیده نشده است."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "نه گیاهی ز باغ من چیده ست",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "لیک چون سبق یافت سوگندت",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18,
      "CoupletSummary": "هوش مصنوعی: اما وقتی که تو به پیروزی رسیدی، به قولت عمل نمی‌کنم و به بند تو تن نمی‌دهم."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "به اجابت نمی کنم بندت",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "قوم انصار پاکدینانند",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19,
      "CoupletSummary": "هوش مصنوعی: مردم انصار افرادی پاک‌دین و باصداقت هستند و در هر زمان و مکانی قابل اعتمادند."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "در زمان و زمین امینانند",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "بر مقالاتشان مگردان پشت",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20,
      "CoupletSummary": "هوش مصنوعی: به گزارشات و نوشته‌های آنها به سادگی توجه نکن و در پی بی‌اعتبار کردن صحبت‌هایشان با کلمات زننده و تند نرو."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "رد ایشان مکن به قول درشت",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "مکن از منع کامشان پر زهر",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21,
      "CoupletSummary": "هوش مصنوعی: اگر نمی‌خواهی که به دل کسی سخت بگذرانی و باعث رنجش او شوی، از لذت خودداری نکن و اجازه نده که احساسات تلخ در دلشان ایجاد شود."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "گر نمی بایدت گران کن مهر",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "نرخ کالا ز حد چو در گذرد",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22,
      "CoupletSummary": "هوش مصنوعی: وقتی قیمت کالا از حد معقول فراتر رود، تمایل و رغبت خریدار نیز از دست می‌رود."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "رغبت از جان مشتری ببرد",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "گفت احسنت خوب گفتی خوب",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23,
      "CoupletSummary": "هوش مصنوعی: گفتی بسیار خوب و درست است، خوب است که نکته‌ای اینچنینی کم پیدا شود و ارزشمند باشد."
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "کم فتد نکته اینچنین مرغوب",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "آنگه آمد برون و با ایشان",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24,
      "CoupletSummary": "هوش مصنوعی: سپس او بیرون آمد و با آن‌ها سخن گفت و گفت: ای گروه وفاداران."
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "گفت کای زمره وفاکیشان",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "کرد ریا قبول این پیوند",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25,
      "CoupletSummary": "هوش مصنوعی: او به این پیوند ظاهری که شبیه ریا است، توجهی نمی‌کند، اما در واقع، او گوهری بی‌نظیر و منحصر به فرد است."
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "لیکن او گوهریست بی مانند",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "مهر او هم به قدر او باید",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26,
      "CoupletSummary": "هوش مصنوعی: عشق و affection او نیز باید به اندازه‌ی خود او باشد تا به حقیقت و عمق احساساتش نزدیک شود."
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "تا سر او به آن فرو آید",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "باشد او گوهری جهان افروز",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27,
      "CoupletSummary": "هوش مصنوعی: او همچون گوهری درخشان و ارزشمند است که امروز به سختی می‌توان قیمتی برایش تعیین کرد."
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "کیست قایم به قیمتش امروز",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    }
  ]
}
