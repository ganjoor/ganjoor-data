      "Text": "یک شبی خواب راحتش بربود",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "روی جانان به خواب دید آن شب",
