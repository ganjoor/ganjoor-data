      "Position": "Right",
      "Text": "پای میشی شکست در بغداد",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "در پلی سخت سست و بی بنیاد",
