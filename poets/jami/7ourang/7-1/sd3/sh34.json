  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "بود پیری به خطه خوارزم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: در سرزمین خوارزم امیری سالخورده بود که در همه حال، چه در مجلس شادی و چه در میدان جنگ، به دنبال ستم بود."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "همه جا ظلمجو چه بزم و چه رزم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "در پی گام ها چه صبح و چه شام",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: او صبح و شام در هر قدمی که برمی‌داشت، ظاهر کارش را با شریعت هماهنگ نشان می‌داد."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "به شریعت روی همی زد گام",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "چار زن داشت لیک چون به نکاح",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: چهار زن داشت، اما چون در شریعت گرفتن بیش از چهار همسر به نکاح جایز نیست (نمی‌توانست زن دیگری را به عقد خود درآورد)."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "زن فزون از چهار نیست مباح",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "هر کجا دختر مسلمانی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: هر جا دختری مسلمان بود که در پس پردهٔ پاکدامنی پنهان می‌زیست،"
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "پس ستر عفاف پنهانی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "در کمند هوایش افتادی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: اگر هوس امیر به او تعلق می‌گرفت، چند زن را نزد آن دختر می‌فرستاد."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "چند زن پیش او فرستادی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "تا کشیدندیش به خاک و به خون",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: تا آن زنان او را به زور و با خواری و آزار بکشانند و از پرده و خانه‌اش بیرون بیاورند."
    },
    {
      "VOrder": 12,
