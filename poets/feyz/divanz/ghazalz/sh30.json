  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "هر که آگه شد از فسانهٔ ما ",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر کس از داستان و حال ما باخبر شود، سرانجام راه خانه و منزل ما را پیدا می‌کند."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "عاقبت پی برد بخانهٔ ما ",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "آنکه جوید نشان نشان نبرد ",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: کسی که با نشانه‌های ظاهری در پی ما باشد به ما نمی‌رسد، زیرا نشانهٔ ما همان بی‌نشانی است."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "بی نشانی بود نشانهٔ ما ",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "بگذراند زعرش هر که نهد ",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر کس سر اطاعت بر آستان ما بگذارد، او را از عرش هم فراتر می‌بریم."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "سرطاعت بر آستانهٔ ما ",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "توسن چرخ را بدین شوکت ",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تازیانهٔ ما اسب سرکش آسمان را با این شکوه و قدرت رام کرده است."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "رام کرده است تازیانهٔ ما ",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "نرسد دست کوته همت",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دست کسی که همتش کوتاه است به ما نمی‌رسد، چون جایگاه و آشیانهٔ ما بسیار بلند است."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "که بلندست آشیانهٔ ما ",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "قدر ما را کسی نمیداند ",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: کسی ارزش ما را نمی‌شناسد جز آن صاحب و فرمانروای روزگار ما."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "غیرآن صاحب زمانهٔ ما ",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "همه عالم اگر شود دشمن ",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر همهٔ جهان دشمن ما شوند، ما با آن دوست یگانه‌مان خوشیم و به او بسنده می‌کنیم."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "ما و آن دوست یگانهٔ ما ",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "هر که با ما بسر برد نفسی ",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر کس لحظه‌ای با ما همدم شود، خوشی جاودانهٔ ما را درمی‌یابد."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "داند او عیش جاودانهٔ ما ",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "هر که را وصل ما بچنگ آید ",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر کس به وصال ما دست یابد، نوای ساز ما هوش و خرد از او می‌رباید."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "هوش بربایدش چغانهٔ ما ",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "غیر درگاه ما پناهی نیست ",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: جز درگاه ما پناهگاهی وجود ندارد؛ سر همهٔ مردم است و آستانهٔ ما."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "سرخلقی و آستانه ما ",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "کار و استاد و کار گه مائیم ",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هم کار، هم استادِ کار و هم کارگاه ما هستیم؛ در کارخانهٔ ما کسی جز ما نیست."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "غیرمانیست کار خانهٔ ما ",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "همه ما و بهانهٔ اغیار ",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: همه‌چیز ماییم و دیگران تنها بهانه‌اند؛ کجاست کسی که بتواند بهانهٔ ما را بشکند و نادرست نشان دهد؟"
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "کو کسی بشکند بهانهٔ ما ",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "دام پیدا و دانه ناپیدا ",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دام ما آشکار است و دانه پنهان؛ تنها مرغی به دانهٔ ما می‌رسد که غیب‌بین باشد."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "غیب بینست مرغ دانهٔ ما ",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "از سر اهل رباید هوش ",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: فیض به خود می‌گوید: داستان ما هوش از سر اهل دل می‌رباید، پس از آن سخن مگو."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "دم مزن فیض از فسانهٔ ما ",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    }
  ]
