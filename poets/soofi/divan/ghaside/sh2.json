\u003Eوین میسر نشود رحم بود بر نرگس\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn48\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eگفت گر بلبل شوریده ثنای گل دوش\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eهست در کوی تو امروز ثناگر نر گس\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn49\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eگر بنفشه است چو انگشت دل افسرده زغم\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eهست در خدمت او گرم چو اخگر نرگس\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn50\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eزدهان آب فکندی چو به اطراف چمن\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eبمکید و شد از آن روز مخمر نرگس\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn51\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eرفت سوی چمن و خیمه زد از روی طرب\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003E...برگرد و شد حاجب آن در نرگس\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn52\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eاز می لطف تو گر یک قدحی نوش کند\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eبه جوی می نخرد حشمت سنجر نرگس\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn53\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eدر شب بدر سها را بتواند دیدن\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eگر زکوی تو شود دیده اغبر نرگس\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn54\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eسوسن از بهر چرا رشک برد بر جانش\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eگشته از سیم و زر خویش توانگر نرگس\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn55\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eچون تبشه بدو چشم سیهش کرد از آن\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eگشت در صحن چمن حاکم و سرور نرگس\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn56\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eترک کژ کرده کلاهی است مگر پنداری\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eشسته بر تخت زمرد چو سکندر نرگس\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn57\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eاز سفال سگ او گر بخورد آب، شود\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eبهتر از صوفی بیچاره سخنور نرگس\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E",
      "PoemFormat": "Ghaside",
      "CoupletsCount": 57
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "کرد با چشم تو خود را چو برابر نرگس",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "گل بخندید ازین واقعه خوش بر نرگس",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "انفعالی که زچشمان تو دارد در باغ",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "نتواند که بر آرد به چمن سرنرگس",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "تا نثار قدم یار کند در گلزار",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "ایستادست ببین کاغذ پر زر نرگس",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "کرده کژ گردن و در لعل لبش می نگرد",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "مست مخمور کند میل به ساغر نرگس",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "نو عروسی است که در صحن چمن آمده است",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "می کند میل از آن با زر و زیور نرگس",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "سبز پوشیده و در عین توجه شب و روز",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "خضر گلهاست به آن موی معنبر نرگس",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "تن عریان و سرانداز همی دانی چیست",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "به تمنای تو گشته است قلندر نرگس",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "بس که در روی گل از چشم تو شرمنده بود",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "می رود سوی چمن بر سر چادر نرگس",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "خواهد امروز چو سوسن که زبان بگشاید",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "تا دعای تو کند بر سر منبر نرگس",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "چون در آیی به چمن سر بنهد بر قدمت",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "کرده شب با گل سیراب مقرر نرگس",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "در خمارم من سودا زده از چشمانش",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "بارها گفته به گلزار مکرر نرگس",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "چشم جادوی تو ناگه چو نظر کرد به خاک",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "از دل خاک همان لحظه شد اخضر نرگس",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "داده رشوت به صبا در هوس خاک درش",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "خوردهای زر خود، کرده درین سر نرگس",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "سر به زانو نهد از ذوق دو چشم سیهش",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "چون من دل شده، در فرقت دلبر نرگس",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "چشم بگشای که بیمار شد از فرقت تو",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "تا زمانی شود از درد تو خوشتر نرگس",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "گو مگوئید که سروی چو قدش هست به باغ",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "سخن کژ نکند راست چو باور نرگس",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "تو زبان آوری ای سوسن و او صاحب حسن",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "خویشتن را نکند با تو برابر نرگس",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "سرو از سایه قد تو به عالم روید",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "گشته از عکس دو چشم تو مصور نرگس",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "نشنود تا که گل از پیرهنش، لاف زند",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "زآن معاشر نشود با گل احمر نرگس",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "به هواداری چشم سیهش روز جزا",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "سر برآرد ز دل خاک به محشر نرگس",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "گر بدی بال و پرش در هوس چشمانت",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "بر سر کوی تو گشتی چو کبوتر نرگس",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "به چمن مست درآیی به در آید ز خمار",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "گر نگاهی بکند چشم تو اندر نرگس",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "هست مداح دو چشم سیهت در گلزار",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "زآن دهان است در آفاق پر از زر نرگس",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "تا نبیند رخ زیبای ترا نامحرم",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "بر کشیدست ازین واقعه خنجر نرگس",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "سرگران است و سبک از لب او جوید می",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "وه ببیند که چها داشته در سر نرگس",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "تا قیامت بود او شاه ریاحین جهان",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "مست آید به چمن پای تو بر سر نرگس",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "دیده در مصحف گل وصف ترا زان ساعت",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "آیت حسن ترا می کند از بر نرگس",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "ای دل از حسرت آن غمزه مستانه او",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "سوی گلزار رو و زار نگر در نرگس",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "شب چو آیی به چمن در ره تو بهر ضیا",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "مشعل گل بود و شمع منور نرگس",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "گل در آن صحن چمن ته به تهش ذالی چیست",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "صفت حسن ترا برده به دفتر نرگس",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "چو قلم زار و ضعیف است بگویم که چراست",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "گشته در فرقت چشمان تو لاغر نرگس",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "گر ز خاک کف پای تو نشانی یابد",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "سر به عیوق کشد همچو صنوبر نرگس",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "تا به پابوس تو باشد که مشرف گردد",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "آمده باز و قدم ساخته از سر نرگس",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "بس که در فرقت او شب سر شب گرید زار",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "چه کند گر نکند دامن خود تر نرگس",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "چون ز پیراهن دلدار ز گل یافت نشان",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "گشت در خدمت او بنده و چاکر نرگس",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "غیر چشم تو نخواهد که ببیند چیزی",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "بر سر انداخته زین واقعه معجر نرگس",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "تا دگر غیر دعای شه عادل نکند",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "دوش در صحن چمن کرده مقرر نرگس",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "خسرو روی زمین فخر جهان شاه حسین",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "آن که از خاک رهش یافته افسر نرگس",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "در چمن سایه قدش چو فتد بر سر او",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "سرو هر جا که بود رشک برد بر نرگس",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "می نداند به چه منصوبه نهد سر بر پاش",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "گشته حیران و سراسیمه و مضطر نرگس",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "به ادب سر فکند پیش و ستاده شب و روز",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "می کند خدمت سلطان مظفر نرگس",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "رو دگر ای گل سیراب شکایت نکنی",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "که چو خاک ره شاه است مطهر نرگس",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "کرده از پیرهن شاه گدایی بویی",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 86,
      "Position": "Left",
      "Text": "زآن سبب صحن چمن کرده معطر نرگس",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "نیستی قابل خاک ره سلطان گویند",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "گوش خود ساخته از بهر همین کر نرگس",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "گر ببارد نفسی ابر عطا و کرمش",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "بگذرد از سر شمشاد و ز عرعر نرگس",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 91,
      "Position": "Right",
      "Text": "تا نشستی تو مربع به چمن با دل شاد",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 92,
      "Position": "Left",
      "Text": "نکند میل به خورشید مدور نرگس",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 93,
      "Position": "Right",
      "Text": "آرزومند به پابوس سگان تو بود",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 94,
      "Position": "Left",
      "Text": "وین میسر نشود رحم بود بر نرگس",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 95,
      "Position": "Right",
      "Text": "گفت گر بلبل شوریده ثنای گل دوش",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 96,
      "Position": "Left",
      "Text": "هست در کوی تو امروز ثناگر نر گس",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 97,
      "Position": "Right",
      "Text": "گر بنفشه است چو انگشت دل افسرده زغم",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 98,
      "Position": "Left",
      "Text": "هست در خدمت او گرم چو اخگر نرگس",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 99,
      "Position": "Right",
      "Text": "زدهان آب فکندی چو به اطراف چمن",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 100,
      "Position": "Left",
      "Text": "بمکید و شد از آن روز مخمر نرگس",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 101,
      "Position": "Right",
      "Text": "رفت سوی چمن و خیمه زد از روی طرب",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 102,
      "Position": "Left",
      "Text": "...برگرد و شد حاجب آن در نرگس",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 103,
      "Position": "Right",
      "Text": "از می لطف تو گر یک قدحی نوش کند",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 104,
      "Position": "Left",
      "Text": "به جوی می نخرد حشمت سنجر نرگس",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 105,
      "Position": "Right",
      "Text": "در شب بدر سها را بتواند دیدن",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 106,
      "Position": "Left",
      "Text": "گر زکوی تو شود دیده اغبر نرگس",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 107,
      "Position": "Right",
      "Text": "سوسن از بهر چرا رشک برد بر جانش",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 108,
      "Position": "Left",
      "Text": "گشته از سیم و زر خویش توانگر نرگس",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 109,
      "Position": "Right",
      "Text": "چون تبشه بدو چشم سیهش کرد از آن",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 110,
      "Position": "Left",
      "Text": "گشت در صحن چمن حاکم و سرور نرگس",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 111,
      "Position": "Right",
      "Text": "ترک کژ کرده کلاهی است مگر پنداری",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 112,
      "Position": "Left",
      "Text": "شسته بر تخت زمرد چو سکندر نرگس",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 113,
      "Position": "Right",
      "Text": "از سفال سگ او گر بخورد آب، شود",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 114,
      "Position": "Left",
      "Text": "بهتر از صوفی بیچاره سخنور نرگس",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    }
  ]
}
