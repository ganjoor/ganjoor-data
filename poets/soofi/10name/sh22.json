  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "عاشق بیچاره چو بیدار شد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "مست رخ یار چو هشیار شد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "هیچ اثری از رخ دلبر ندید",
