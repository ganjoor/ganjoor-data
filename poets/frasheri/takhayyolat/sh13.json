      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "می‌روی بی‌پای و سر قلاش وار",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "گاه خندان، گاه گریان، گاه زار",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "آتش خورشید کردت زو جدا",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "آه تو شد ابر و رعد اندر فضا",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "هم زآه و آتش هجران تو",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "از سرشگ دیدهٔ گریان تو",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "ابرها از چارسو طغیان کنند",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "زیر خود خورشید را پنهان کنند",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "سرتسر جو و هوا گردد سیاه",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "چون درونان و دلان پرگناه",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "ناگهان اندر میان آسمان",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "برق‌ها پاشند از هر سو عیان",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "شعشعه گردد سراسر آسمان",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "تار و پر دهشت بود جمله جهان",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "کس نبند جز زباران و سحاب",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "جز به برق و جز به دود و جز به آب",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "باچنین جلوه‌گری ای نازئین",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "پاز می‌آیی برین روی زمین",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "تاشود تازه زمین از همّتت",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "تا شود شاد و بکام از وصلتت",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "هر شکوفه عاشق دیدار توست",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "هرچه بیند چشمم اینجا کار توست",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "از تو خاک مرده خندان می‌شود",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "سبزه زار و باغ و بستان می‌شود",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "رنگ و بو می‌آوری از آسمان",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "می‌شود روی زمین باغ جنان",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "گاه برفی، گاه باران، گه سحاب",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "گاه برقی، گاه دودی، گاه آب",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "گه روی سوی سما، گه بر زمین",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "می‌شوی جوی و بتازی همچنین",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "خاک را چون کرده‌‌ای احیاء و پاک",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "کرده‌ای هم دشت و کوهش چاک‌چاک",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "می‌روی اکتون شادان نزد یار",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "با ترنم، بیدرنگ و بیقرار",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "تا نباشی واصل جانان تو",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "کم نباشد ناله و افغان تو",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 55,
      "Position": "Comment",
      "Text": "۱۲۹۳ ه ق / ۱۸۷۶-۷۷ م"
    }
  ]
}
