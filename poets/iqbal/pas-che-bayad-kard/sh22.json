      "Position": "Right",
      "Text": "این کار حکیمی نیست دامان کلیمی گیر",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "صد بندهٔ ساحل مست یک بنده دریا مست",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "دل را به چمن بردم از باد چمن افسرد",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "میرد بخیابانها این لالهٔ صحرا مست",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "از حرف دلاویزش اسرار حرم پیدا",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "دی کافرکی دیدم در وادی بطحا مست",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "سینا است که فاران است یارب چه مقام است این",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "هر ذره خاک من چشمی است تماشا مست",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "خرقهٔ آن «برزخ لایبغیان»",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "دیدمش در نکتهٔ «لی خرقتان»",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "دین او آئین او تفسیر کل",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "در جبین او خط تقدیر کل",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "عقل را او صاحب اسرار کرد",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "عشق را او تیغ جوهر دار کرد",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "کاروان شوق را او منزل است",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "ما همه یک مشت خاکیم او دل است",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "آشکارا دیدنش اسرای ماست",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "در ضمیرش مسجد اقصای ماست",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "آمد از پیراهن او بوی او",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "داد ما را نعره الله هو",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "با دل من شوق بی پروا چه کرد",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "بادهٔ پر زور با مینا چه کرد",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "رقصد اندر سینه از زور جنون",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "تا ز راه دیده میآید برون",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "گفت «من جبریلم و نور مبین»",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "پیش ازین او را ندیدم اینچنین",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "شعر رومی خواند و خندید و گریست",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "یا رب این دیوانهٔ فرزانه کیست؟ ",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "در حرم با من سخن زندانه گفت",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "از می و مغ زاده و پیمانه گفت",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "گفتمش این حرف بیباکانه چیست",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "لب فرو بند این مقام خامشی ست",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "من ز خون خویش پروردم ترا",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "صاحب آه سحر کردم ترا",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "بازیاب این نکته را ای نکته رس",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "عشق مردان ضبط احوال است و بس",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "گفت عقل و هوش آزار دل است",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "مستی و وارفتگی کار دل است",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "نعره ها زد تا فتاد اندر سجود",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "شعلهٔ آواز او بود او نبود",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    }
  ]
}
