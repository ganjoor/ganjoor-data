  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "تربت آن خسرو روشن ضمیر",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "از ضمیرش ملتی صورت پذیر",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "گنبد او را حرم داند سپهر",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "با فروغ از طوف او سیمای مهر",
