  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "شهر کابل خطهٔ جنت نظیر",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "آب حیوان از رگ تاکش بگیر",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "چشم صائب از سوادش سرمه چین",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "روشن و پاینده باد آن سر زمین",
