      "Text": "از بهار پاستان رنگین تری",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "هر زمان تدبیرها دارد رقیب",
