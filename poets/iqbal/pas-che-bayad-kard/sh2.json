      "VOrder": 19,
      "Position": "Right",
      "Text": "هیچ قومی زیر چرخ لاجورد",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "بی جنون ذوفنون کاری نکرد",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "مؤمن از عزم و توکل قاهر است",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "گر ندارد این دو جوهر کافر است",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "خیر را او باز میداند ز شر",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "از نگاهش عالمی زیر و زبر",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "کوهسار از ضربت او ریز ریز",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "در گریبانش هزاران رستخیز",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "تا می از میخانهٔ من خورده ئی",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "کهنگی را از تماشا برده ئی",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "در چمن زی مثل بو مستور و فاش",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "در میان رنگ پاک از رنگ باش",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "عصر تو از رمز جان آگاه نیست",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "دین او جز حب غیر الله نیست",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "فلسفی این رمز کم فهمیده است",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "فکر او بر آب و گل پیچیده است",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "دیده از قندیل دل روشن نکرد",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "پس ندید الا کبود و سرخ و زرد",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "ای خوش آن مردی که دل با کس نداد",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "بند غیر الله را از پا گشاد",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "سر شیری را نفهمد گاو و میش",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "جز به شیران کم بگو اسرار خویش",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "با حریف سفله نتوان خورد می",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "گرچه باشد پادشاه روم و ری",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "یوسف ما را اگر گرگی برد",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "به که مردی ناکسی او را خرد",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "اهل دنیا بی تخیل بی قیاس",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "بوریا بافان اطلس ناشناس",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "اعجمی مردی چه خوش شعری سرود",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "سوزد از تأثیر او جان در وجود",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "«نالهٔ عاشق بگوش مردم دنیا",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "بانگ مسلمانی و دیار فرنگ است»",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "معنی دین و سیاست باز گوی",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "اهل حق را زین دو حکمت باز گوی",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "«غم خور و نان غم افزایان مخور",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "زانکه عاقل غم خورد کودک شکر»",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 55,
      "Position": "Comment",
      "Text": "رومی",
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "خرقه خود بار است بر دوش فقیر",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "چون صبا جز بوی گل سامان مگیر",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "قلزمی با دشت و در پیهم ستیز",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "شبنمی خود را به گلبرگی بریز",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 60,
      "Position": "Right",
      "Text": "سر حق بر مرد حق پوشیده نیست",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "روح مؤمن هیچ میدانی که چیست؟",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 62,
      "Position": "Right",
      "Text": "قطرهٔ شبنم که از ذوق نمود",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "عقدهٔ خود را بدست خود گشود",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 64,
      "Position": "Right",
      "Text": "از خودی اندر ضمیر خود نشست",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 65,
      "Position": "Left",
      "Text": "رخت خویش از خلوت افلاک بست",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 66,
      "Position": "Right",
      "Text": "رخ سوی دریای بی پایان نکرد",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 67,
      "Position": "Left",
      "Text": "خویشتن را در صدف پنهان نکرد",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 68,
      "Position": "Right",
      "Text": "اندر آغوش سحر یکدم تپید",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 69,
      "Position": "Left",
      "Text": "تا بکام غنچهٔ نورس چکید»",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    }
  ]
}
