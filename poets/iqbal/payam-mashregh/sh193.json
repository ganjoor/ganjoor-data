      "CoupletSummary": "هوش مصنوعی: بی آنکه راهنمایی چون خضر داشته باشم، به سوی منزل می‌شتافتم و بار سفرم را بر دوش خیال بسته بودم؛ یعنی تکیه‌گاهم تنها پندار و گمان بود."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "بر دوش خیال بسته محمل",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "جویای می و شکسته جامی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: در پی شراب حقیقت بودم اما جامم شکسته بود؛ مانند صبح که برای گرفتن باد دام بگستراند، کوششم بیهوده بود."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "چون صبح به باد چیده دامی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "پیچیده بخود چو موج دریا",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: مانند موج دریا در خود می‌پیچیدم و مانند گردباد بیابان سرگردان بودم."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "آواره چو گرد باد صحرا",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "عشق تو دلم ربود ناگاه",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: ناگهان عشق تو دلم را ربود و گره کارم را به یک‌باره گشود."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "از کار گره گشود ناگاه",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "آگاه ز هستی و عدم ساخت",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: عشق مرا از راز هستی و نیستی آگاه کرد و بتخانهٔ عقل مرا به حرم بدل ساخت."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "بتخانهٔ عقل را حرم ساخت",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "چون برق به خرمنم گذر کرد",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: عشق مانند آذرخش از خرمن وجودم گذشت و مرا با لذت سوختن آشنا کرد."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "از لذت سوختن خبر کرد",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "سر مست شدم ز پا فتادم",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: از عشق مست شدم و از پا افتادم و مانند تصویری که از صاحبش جدا می‌افتد، از خود جدا شدم و از خودی رها گشتم."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "چون عکس ز خود جدا فتادم",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "خاکم به فراز عرش بردی",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: با رازی که به دلم سپردی، خاک وجود مرا تا بالای عرش بالا بردی."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "زان راز که با دلم سپردی",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "واصل به کنار کشتیم شد",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: همان طوفان عشق کشتی مرا به ساحل رساند و زشتی مرا به زیبایی بدل کرد."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "طوفان جمال زشتیم شد",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "جز عشق حکایتی ندارم",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: جز داستان عشق سخنی ندارم و از سرزنش دیگران هیچ باکی ندارم."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "پروای ملامتی ندارم",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "از جلوهٔ علم بی نیازم",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: به جلوه و شکوه دانش نیازی ندارم؛ کار من سوختن و گریستن و تپیدن و گداختن در عشق است."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "سوزم ، گریم ، تپم ، گدازم",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    }
  ]
}
