      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 9,
      "Position": "CenteredVerse1",
      "Text": "ترک من و تو کرد",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "یا اخترکی ماه مبینی به کمینی",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "نزدیک تر آمد بتماشای زمینی",
