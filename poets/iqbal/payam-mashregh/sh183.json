      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 12,
      "Position": "CenteredVerse1",
      "Text": "از چرخ برینی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "یا ماه تنک ضو که بیک جلوه تمام است",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "ماهی که برو منت خورشید حرام است",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 15,
      "Position": "CenteredVerse1",
      "Text": "آزاد مقام است",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "ای کرمک شب تاب سراپای تو نور است",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "پرواز تو یک سلسلهٔ غیب و حضور است",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 18,
      "Position": "CenteredVerse1",
      "Text": "آئین ظهور است",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "در تیره شبان مشعل مرغان شب استی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "آن سوز چه سوز است که در تاب و تب استی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 21,
      "Position": "CenteredVerse1",
      "Text": "گرم طلب استی",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "مائیم که مانند تو از خاک دمیدیم",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "دیدیم تپیدیم ، ندیدیم تپیدیم",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 24,
      "Position": "CenteredVerse1",
      "Text": "جائی نرسیدیم",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "گویم سخن پخته و پرورده و ته دار",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "از منزل گم گشته مگو پای بره دار",
