      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 41,
      "Position": "CenteredVerse1",
      "Text": "زنده رود",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "زورق ما خاکیان بی ناخداست",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "کس نداند عالم قرآن کجاست",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 44,
      "Position": "CenteredVerse1",
      "Text": "افغانی",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "عالمی در سینهٔ ما گم هنوز",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "عالمی در انتظار قم هنوز",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "عالمی بی امیتاز خون و رنگ",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "شام او روشن تر از صبح فرنگ",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "عالمی پاک از سلاطین و عبید",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "چون دل مؤمن کرانش ناپدید",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "عالمی رعنا که فیض یک نظر",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "تخم او افکند در جان عمر",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "لایزال و وارداتش نو به نو",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "برگ و بار محکماتش نو به نو",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "باطن او از تغیر بی غمی",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "ظاهر او انقلاب هر دمی",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "اندرون تست آن عالم نگر",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "می دهم از محکمات او خبر",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    }
  ]
}
