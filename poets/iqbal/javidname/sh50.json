      "Position": "Left",
      "Text": "بیش این عالم به آن عالم کمی",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "عقل ما اندر جهانی ذوفنون",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "در جهان دیگری خوار و زبون",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "بر ثغور این جهان چون و چند",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "بود مردی با صدای دردمند",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "دیدهٔ او از عقابان تیز تر",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "طلعت او شاهد سوز جگر",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "دمبدم سوز درون او فزود",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "بر لبش بیتی که صد بارش سرود",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "«نه جبریلی نه فردوسی نه حوری نی خداوندی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "کف خاکی که میسوزد ز جان آرزومندی»",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "من به رومی گفتم این دیوانه کیست",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "گفت« این فرزانهٔ المانوی ست",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "در میان این دو عالم جای اوست",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "نغمهٔ دیرینه اندر نای اوست",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "باز این حلاج بی دار و رسن",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "نوع دیگر گفته آن حرف کهن",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "حرف او بی باک و افکارش عظیم",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "غربیان از تیغ گفتارش دو نیم",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "همنشین بر جذبه او پی نبرد",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "بندهٔ مجذوب را مجنون شمرد",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "عاقلان از عشق و مستی بی نصیب",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "نبض او دادند در دست طبیب",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "با پزشکان چیست غیر از ریو و رنگ",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "وای مجذوبی که زاد اندر فرنگ",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "ابن سینا بر بیاضی دل نهد",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "رگ زند یا حب خواب آور دهد",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "بود حلاجی به شهر خود غریب",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "جان ز ملا برد و کشت او را طبیب",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "مرد ره دانی نبود اندر فرنگ",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "پس فزون شد نغمه اش از تار چنگ",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "راهرو را کس نشان از ره نداد",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "صد خلل در واردات او فتاد",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "نقد بود و کس عیار او را نکرد",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "کاردانی مرد کار او را نکرد",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "عاشقی در آه خود گم گشته ئی",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "سالکی در راه خود گم گشته ئی",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "مستی او هر زجاجی را شکست",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "از خدا ببرید و هم از خود گسست",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "خواست تا بیند به چشم ظاهری",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "اختلاط قاهری با دلبری",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "خواست تا از آب و گل آید برون",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "خوشه ئی کز کشت دل آید برون",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "آنچه او جوید مقام کبریاست",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "این مقام از عقل و حکمت ماوراست",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "زندگی شرح اشارات خودی است",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "لا و الا از مقامات خودی است",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "او به لا درماند و تا الا نرفت",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "از مقام عبده بیگانه رفت",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "با تجلی همکنار و بی خبر",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "دور تر چون میوه از بیخ شجر",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "چشم او جز رؤیت آدم نخواست",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "نعره بیباکانه زد «آدم کجاست»",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 67,
      "Position": "CenteredVerse1",
      "Text": "ق",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 68,
      "Position": "Right",
      "Text": "ورنه او از خاکیان بیزار بود",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 69,
      "Position": "Left",
      "Text": "مثل موسی طالب دیدار بود",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 70,
      "Position": "Right",
      "Text": "کاش بودی در زمان احمدی",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 71,
      "Position": "Left",
      "Text": "تا رسیدی بر سرور سرمدی",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 72,
      "Position": "Right",
      "Text": "عقل او با خویشتن در گفتگوست",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 73,
      "Position": "Left",
      "Text": "تو ره خود رو که راه خود نکوست",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 74,
      "Position": "Right",
      "Text": "پیش نه گامی که آمد آن مقام",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 75,
      "Position": "Left",
      "Text": "کاندرو بی حرف می روید کلام»",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    }
  ]
}
