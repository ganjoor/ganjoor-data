      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "نغمه ئی می خواند آن مست مدام",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "در حضور سید والا مقام",
