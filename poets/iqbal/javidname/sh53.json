      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "سید السادات ، سالار عجم",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "دست او معمار تقدیر امم",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "تا غزالی درس الله هو گرفت",
