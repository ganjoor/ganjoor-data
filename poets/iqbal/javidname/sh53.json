      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "مرشد آن کشور مینو نظیر",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "میر و درویش و سلاطین را مشیر",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "خطه را آن شاه دریا آستین",
