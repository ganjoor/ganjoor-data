      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "نی دعائی نی درودی اندرو»",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "برخیا گفت« ای فسون پرداز خیز،",
