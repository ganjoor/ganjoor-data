      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "قرأت آن پیر مرد سخت کوش",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "سوره والنجم و آن دشت خموش",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 49,
