      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "روح پاک جبرئیل آید به وجد",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "دل ازو در سینه گردد ناصبور",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "شور الا الله خیزد از قبور",
