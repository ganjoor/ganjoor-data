      "Position": "Left",
      "Text": "سوز و مستی میدهد داؤد را",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "آشکارا هر غیاب از قرأتش",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "بی حجاب ام الکتاب از قرأتش",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "من ز جا بر خاستم بعد از نماز",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "دست او بوسیدم از راه نیاز",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "گفت رومی «ذرهٔ گردون نورد",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "در دل او یک جهان سوز و درد",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "چشم جز بر خویشتن نگشاده ئی",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 62,
