  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "مشت خاکی کار خود را برده پیش",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "در تماشای تجلی های خویش",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "یا من افتادم بدام هست و بود",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "یا بدام من اسیر آمد وجود",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "اندرین نیلی تتق چاک از من است",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "من ز افلاکم که افلاک از من است",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "یا ضمیرم را فلک در بر گرفت",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "یا ضمیر من فلک را در گرفت",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "اندرونست این که بیرون است چیست؟",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "آنچه می بیند نگه چون است چیست؟",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "پر زنم بر آسمانی دیگری",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "پیش خود بینم جهانی دیگری",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "عالمی با کوه و دشت و بحر و بر",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "عالمی از خاک ما دیرینه تر",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "عالمی از ابرکی بالیده ئی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "دستبرد آدمی نادیده ئی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "نقشها نابسته بر لوح وجود",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "خرده گیر فطرت آنجا کس نبود",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "من به رومی گفتم این صحرا خوش است",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "در کهستان شورش دریا خوش است",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "من نیابم از حیات اینجا نشان",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "از کجا می آید آواز اذان",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "گفت رومی این مقام اولیاست",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "آشنا این خاکدان با خاک ماست",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "بوالبشر چون رخت از فردوس بست",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "یک دو روزی اندرین عالم نشست",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "این فضاها سوز آهش دیده است",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "ناله های صبحگاهش دیده است",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "زائران این مقام ارجمند",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "پاک مردان از مقامات بلند",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "پاک مردان چون فضیل و بوسعید",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "عارفان مثل جنید و با یزید ",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "خیز تا ما را نماز آید بدست",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "یک دو دم سوز و گداز آید بدست",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "رفتم و دیدم دو مرد اندر قیام",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "مقتدی تاتار و افغانی امام",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "پیر رومی هر زمان اندر حضور",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "طلعتش برتافت از ذوق و سرور",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "گفت «مشرق زین دو کس بهتر نزاد",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "ناخن‌شان عقده‌های ما گشود",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "سیدالسادات مولانا جمال",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "زنده از گفتار او سنگ و سفال",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "ترک سالار آن حلیم دردمند",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "فکر او مثل مقام او بلند",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "با چنین مردان دو رکعت طاعت است",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 46,
