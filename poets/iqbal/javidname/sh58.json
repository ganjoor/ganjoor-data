      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "از خدا کم خواستم طول حیات",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "زندگی را چیست رسم و دین و کیش",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "یک دم شیری به از صد سال میش",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "زندگی محکم ز تسلیم و رضاست",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "موت نیرنج و طلسم و سیمیاست",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "بندهٔ حق ضیغم و آهوست مرگ",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "یک مقام از صد مقام اوست مرگ",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 60,
      "Position": "Right",
      "Text": "می فتد بر مرگ آن مرد تمام",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "مثل شاهینی که افتد بر حمام",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 62,
      "Position": "Right",
      "Text": "هر زمان میرد غلام از بیم مرگ",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "زندگی او را حرام از بیم مرگ",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 64,
      "Position": "Right",
      "Text": "بندهٔ آزاد را شأنی دگر",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 65,
      "Position": "Left",
      "Text": "مرگ او را میدهد جانی دگر",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 66,
      "Position": "Right",
      "Text": "او خود اندیش است مرگ اندیش نیست",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 67,
      "Position": "Left",
      "Text": "مرگ آزادان ز آنی بیش نیست",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 68,
      "Position": "Right",
      "Text": "بگذر از مرگی که سازد با لحد",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 69,
      "Position": "Left",
      "Text": "زانکه این مرگست مرگ دام و دد",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 70,
      "Position": "Right",
      "Text": "مرد مؤمن خواهد از یزدان پاک",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 71,
      "Position": "Left",
      "Text": "آن دگر مرگی که بر گیرد ز خاک",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 72,
      "Position": "Right",
      "Text": "آن دگر مرگ انتهای راه شوق",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 73,
      "Position": "Left",
      "Text": "آخرین تکبیر در جنگاه شوق",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 74,
      "Position": "Right",
      "Text": "گرچه هر مرگ است بر مؤمن شکر",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 75,
      "Position": "Left",
      "Text": "مرگ پور مرتضی چیزی دگر",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 76,
      "Position": "Right",
      "Text": "جنگ شاهان جهان غارتگری است",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 77,
      "Position": "Left",
      "Text": "جنگ مؤمن سنت پیغمبری است",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 78,
      "Position": "Right",
      "Text": "جنگ مؤمن چیست؟ هجرت سوی دوست",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 79,
      "Position": "Left",
      "Text": "ترک عالم اختیار کوی دوست",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 80,
      "Position": "Right",
      "Text": "آنکه حرف شوق با اقوام گفت",
      "CoupletIndex": 40,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 81,
      "Position": "Left",
      "Text": "جنگ را رهبانی اسلام گفت",
      "CoupletIndex": 40,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 82,
      "Position": "Right",
      "Text": "کس نداند جز شهید این نکته را",
      "CoupletIndex": 41,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 83,
      "Position": "Left",
      "Text": "کو بخون خود خرید این نکته را",
      "CoupletIndex": 41,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    }
  ]
}
