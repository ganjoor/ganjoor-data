      "Position": "CenteredVerse1",
      "Text": "نادر",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "خوش بیا ای نکته سنج خاوری",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "ای که می زیبد ترا حرف دری",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "محرم رازیم با ما راز گوی",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "آنچه میدانی ز ایران باز گوی",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 59,
      "Position": "CenteredVerse1",
      "Text": "زنده رود",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 60,
      "Position": "Right",
      "Text": "بعد مدت چشم خود بر خود گشاد",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "لیکن اندر حلقهٔ دامی فتاد",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 62,
      "Position": "Right",
      "Text": "کشتهٔ ناز بتان شوخ و شنگ",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "خالق تهذیب و تقلید فرنگ",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 64,
      "Position": "Right",
      "Text": "کار آن وارفتهٔ ملک و نسب",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 65,
      "Position": "Left",
      "Text": "ذکر شاپور است و تحقیر عرب",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 66,
      "Position": "Right",
      "Text": "روزگار او تهی از واردات",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 67,
      "Position": "Left",
      "Text": "از قبور کهنه می جوید حیات",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 68,
      "Position": "Right",
      "Text": "با وطن پیوست و از خود در گذشت",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 69,
      "Position": "Left",
      "Text": "دل به رستم داد و از حیدر گذشت",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 70,
      "Position": "Right",
      "Text": "نقش باطل می پذیرد از فرنگ",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 71,
      "Position": "Left",
      "Text": "سر گذشت خود بگیرد از فرنگ",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 72,
      "Position": "Right",
      "Text": "پیری ایران زمان یزد جرد",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 73,
      "Position": "Left",
      "Text": "چهرهٔ او بی فروغ از خون سرد",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 74,
      "Position": "Right",
      "Text": "دین و آئین و نظام او کهن",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 75,
      "Position": "Left",
      "Text": "شید و تار صبح و شام او کهن",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 76,
      "Position": "Right",
      "Text": "موج می در شیشهٔ تاکش نبود",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 77,
      "Position": "Left",
      "Text": "یک شرر در تودهٔ خاکش نبود",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 78,
      "Position": "Right",
      "Text": "تا ز صحرائی رسیدش محشری",
      "CoupletIndex": 40,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 79,
      "Position": "Left",
      "Text": "آنکه داد او را حیات دیگری",
      "CoupletIndex": 40,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 80,
      "Position": "Right",
      "Text": "اینچین حشر از عنایات خداست",
      "CoupletIndex": 41,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 81,
      "Position": "Left",
      "Text": "پارس باقی ، رومةالکبری کجاست",
      "CoupletIndex": 41,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 82,
      "Position": "Right",
      "Text": "آنکه رفت از پیکر او جان پاک",
      "CoupletIndex": 42,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 83,
      "Position": "Left",
      "Text": "بی قیامت بر نمی آید ز خاک",
      "CoupletIndex": 42,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 84,
      "Position": "Right",
      "Text": "مرد صحرائی به ایران جان دمید",
      "CoupletIndex": 43,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 85,
      "Position": "Left",
      "Text": "باز سوی ریگزار خود رمید",
      "CoupletIndex": 43,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 86,
      "Position": "Right",
      "Text": "کهنه را از لوح ما بسترد و رفت",
      "CoupletIndex": 44,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 87,
      "Position": "Left",
      "Text": "برگ و ساز عصر نو آورد و رفت",
      "CoupletIndex": 44,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 88,
      "Position": "Right",
      "Text": "آه ، احسان عرب نشناحتند",
      "CoupletIndex": 45,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 89,
      "Position": "Left",
      "Text": "از تش افرنگیان بگداختند",
      "CoupletIndex": 45,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    }
  ]
}
