      "Text": "این مساوات این مواخات اعجمی است",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "خوب میدانم که سلمان مزدکی است",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "ابن عبدالله فریبش خورده است",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "رستخیزی بر عرب آورده است",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "عترت هاشم ز خود مهجور گشت",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "از دو رکعت چشم شان بی نور گشت",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "اعجمی را اصل عدنانی کجاست",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "گنگ را گفتار سحبانی کجاست",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "چشم خاصان عرب گردیده کور",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "بر نیائی ای زهیر از خاک گور",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "ای تو ما را اندرین صحرا دلیل",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "بشکن افسون نوای جبرئیل",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "باز گوی ای سنگ اسود باز گوی",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "آنچه دیدیم از محمد باز گوی",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "ای هبل ، ای بنده را پوزش پذیر",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "خانهٔ خود را ز بی کیشان بگیر",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "گلهٔ شان را به گرگان کن سبیل",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "تلخ کن خرمایشان را بر نخیل",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "صرصری ده با هوای بادیه",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "«انهم اعجاز نخل خاویه»",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "ای منات ای لات ازین منزل مرو",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "گر ز منزل میروی از دل مرو",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "ای ترا اندر دو چشم ما وثاق",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "مهلتی ، ان کنت ازمعت الفراق»",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    }
  ]
}
