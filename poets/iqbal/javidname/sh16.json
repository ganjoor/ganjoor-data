      "Text": "استخوان آن جوان در تن شکست",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "بانگ زد ای وای بر تقدیر من",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "وای بر فریاد بی تأثیر من",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "گفت افرنگین «اگر داری نظر",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "اندگی اعمال خود را هم نگر",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "پور مریم آن چراغ کائنات",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "نور او اندر جهات و بی جهات",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "آن فلاطوس آن صلیب آن روی زرد",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "زیر گردون تو چه کردی او چه کرد",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "ای بجانت لذت ایمان حرام",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "ای پرستار بتان سیم خام",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "قیمت روح القدس نشناختی",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "تن خریدی نقد جان در باختی»",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "طعنهٔ آن نازنین جلوه مست",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "آن جوان را نشتر اندر دل شکست",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "گفت «ای گندم نمای جو فروش",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "از تو شیخ و برهمن ملت فروش",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "عقل و دین از کافریهای تو خوار",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "عشق از سوداگریهای تو خوار",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "مهر تو آزار و آزار نهان",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "کین تو مرگ است و مرگ ناگهان",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "صحبتی با آب و گل ورزیده ئی",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "بنده را از پیش حق دزدیده ئی",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "حکمتی کو عقدهٔ اشیا گشاد",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "با تو غیر از فکر چنگیزی نداد",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "داند آن مردی که صاحب جوهر است",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "جرم تو از جرم من سنگین تر است",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "از دم او رفته جان آمد بتن",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "از تو جان را دخمه میگردد بدن",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "آنچه ما کردیم با ناسوت او",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "ملت او کرد با لاهوت او",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "مرگ تو اهل جهان را زندگی است",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "باش تا بینی که انجام تو چیست»",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    }
  ]
}
