      "Text": "هم به خیل نوریان صحبت گزین",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "از نگاهی کیمیا کن خاک را",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "از مناجاتی بسوز افلاک را",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "در کهستان چون کلیم آواره شو",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "نیم سوز آتش نظاره شو",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "لیکن از پیغمبری باید گذشت",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "از چنین ملا گری باید گذشت",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "کس میان ناکسان ناکس شود",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "فطرتش گر شعله باشد خس شود",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "تا نبوت از ولایت کمتر است",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "عشق را پیغمبری درد سر است",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "خیز و در کاشانهٔ وحدت نشین",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "ترک جلوت گوی و در خلوت نشین",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 28,
      "Position": "CenteredVerse1",
      "Text": "زرتشت",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "نور دریای است ظلمت ساحلش",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "همچو من سیلی نزاد اندر دلش",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "اندرونم موجهای بیقرار",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "سیل را جز غارت ساحل چه کار",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "نقش بیرنگی که او را کس ندید",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "جز بخون اهرمن نتوان کشید",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "خویشتن را وانمودن زندگی است",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "ضرب خود را آزمودن زندگیست",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "از بلا ها پخته تر گردد خودی",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "تا خدا را پرده در گردد خودی",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "مرد حق بین جز بحق خود را ندید",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "لااله می گفت و در خون می تپید",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "عشق را در خون تپیدن آبروست",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "اره و چوب و رسن عیدین اوست",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "در ره حق هر چه پیش آید نکوست",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "مرحبا نامهربانیهای دوست",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "جلوهٔ حق چشم من تنها نخواست",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "حسن را بی انجمن دیدن خطاست",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "چیست خلوت درد و سوز و آرزوست",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "انجمن دید است و خلوت جستجو است",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "عشق در خلوت کلیم اللهی است",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "چون بجلوت می خرامد شاهی است",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "خلوت و جلوت کمال سوز و ساز",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "هر دو حالات و مقامات نیاز",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "چیست آن بگذشتن از دیر و کنشت",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "چیست این تنها نرفتن در بهشت",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "گرچه اندر خلوت و جلوت خداست",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "خلوت آغازست و جلوت انتهاست",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "گفته ئی پیغمبری درد سر است",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "عشق چون کامل شود آدم گر است",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "راه حق با کاروان رفتن خوش است",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "همچو جان اندر جهان رفتن خوش است",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    }
  ]
}
