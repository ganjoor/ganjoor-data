  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "منکر نتوان گشت اگر دم زنم از عشق",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "این نشه بمن نیست اگر با دگری هست",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 3,
      "Position": "CenteredVerse1",
      "Text": "عرفی",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 4,
      "Position": "Right",
      "Text": "ای ترا حق خاتم اقوام کرد",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Left",
      "Text": "بر تو هر آغاز را انجام کرد",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "ای مثال انبیا پاکان تو",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "همگر دلها جگر چاکان تو",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "ای نظر بر حسن ترسازاده ئی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "ای ز راه کعبه دور افتاده ئی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "ای فلک مشت غبار کوی تو",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "«ای تماشا گاه عالم روی تو»",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 12,
      "Position": "Right",
      "Text": "همچو موج ، آتش ته پا میروی",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 13,
      "Position": "Left",
      "Text": "«تو کجا بهر تماشا میروی»",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "رمز سوز آموز از پروانه ئی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "در شرر تعمیر کن کاشانه ئی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "طرح عشق انداز اندر جان خویش",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "تازه کن با مصطفی پیمان خویش",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "خاطرم از صحبت ترسا گرفت",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "تا نقاب روی تو بالا گرفت",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "هم نوا از جلوه ی اغیار گفت",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "داستان گیسو و رخسار گفت",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "بر در ساقی جبین فرسود او",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "قصه ی مغ زادگان پیمود او",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "من شهید تیغ ابروی تو ام",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "خاکم و آسوده ی کوی تو ام",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "از ستایش گستری بالاترم",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "پیش هر دیوان فرو ناید سرم",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "از سخن آئینه سازم کرده اند",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "وز سکندر بی نیازم کرده اند",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "بار احسان بر نتابد گردنم",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "در گلستان غنچه گردد دامنم",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "سخت کوشم مثل خنجر در جهان",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "آب خود می گیرم از سنگ گران",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "گرچه بحرم موج من بیتاب نیست",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "بر کف من کاسه ی گرداب نیست",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "پرده ی رنگم شمیمی نیستم",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "صید هر موج نسیمی نیستم",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "در شرار آباد هستی اخگرم",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "خلعتی بخشد مرا خاکسترم",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "بر درت جانم نیاز آورده است",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "هدیه ی سوز و گداز آورده است",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "ز آسمان آبگون یم می چکد",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "بر دل گرمم دمادم می چکد",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "من ز جو باریکتر می سازمش",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "تا به صحن گلشنت اندازمش",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "زانکه تو محبوب یار ماستی",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "همچو دل اندر کنار ماستی",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "عشق تا طرح فغان در سینه ریخت",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "آتش او از دلم آئینه ریخت",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "مثل گل از هم شکافم سینه را",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "پیش تو آویزم این آئینه را",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "تا نگاهی افکنی بر روی خویش",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "می شوی زنجیری گیسوی خویش",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "باز خوانم قصه ی پارینه ات",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "تازه سازم داغهای سینه ات",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "از پی قوم ز خود نامحرمی",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "خواستم از حق حیات محکمی",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "در سکوت نیم شب نالان بدم",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "عالم اندر خواب و من گریان بدم",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 60,
      "Position": "Right",
      "Text": "جانم از صبر و سکون محروم بود",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "ورد من یاحی و یاقیوم بود",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 62,
      "Position": "Right",
      "Text": "آرزوئی داشتم خون کردمش",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "تا ز راه دیده بیرون کردمش",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 64,
      "Position": "Right",
      "Text": "سوختن چون لاله پیهم تا کجا",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 65,
      "Position": "Left",
      "Text": "از سحر دریوز شبنم تا کجا؟",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 66,
      "Position": "Right",
      "Text": "اشک خود بر خویش می ریزم چو شمع",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 67,
      "Position": "Left",
      "Text": "با شب یلدا در آویزم چو شمع",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 68,
      "Position": "Right",
      "Text": "جلوه را افزودم و خود کاستم",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 69,
      "Position": "Left",
      "Text": "دیگران را محفلی آراستم",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 70,
      "Position": "Right",
      "Text": "یک نفس فرصت ز سوز سینه نیست",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 71,
      "Position": "Left",
      "Text": "هفته ام شرمنده ی آدینه نیست",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 72,
      "Position": "Right",
      "Text": "جانم اندر پیکر فرسوده ئی",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 73,
      "Position": "Left",
      "Text": "جلوه ی آهی است گرد آلوده ئی",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 74,
      "Position": "Right",
      "Text": "چون مرا صبح ازل حق آفرید",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 75,
      "Position": "Left",
      "Text": "ناله در ابریشم عودم تپید",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 76,
      "Position": "Right",
      "Text": "ناله ئی افشا گر اسرار عشق",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 77,
      "Position": "Left",
      "Text": "خونبهای حسرت گفتار عشق",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 78,
      "Position": "Right",
      "Text": "فطرت آتش دهد خاشاک را",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 79,
      "Position": "Left",
      "Text": "شوخی پروانه بخشد خاک را",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 80,
      "Position": "Right",
      "Text": "عشق را داغی مثال لاله بس",
      "CoupletIndex": 40,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 81,
      "Position": "Left",
      "Text": "در گریبانش گل یک ناله بس",
      "CoupletIndex": 40,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 82,
      "Position": "Right",
      "Text": "من همین یک گل بدستارت زنم",
      "CoupletIndex": 41,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 83,
      "Position": "Left",
      "Text": "محشری بر خواب سرشارت زنم",
      "CoupletIndex": 41,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 84,
      "Position": "Right",
      "Text": "تا ز خاکت لاله زار آید پدید",
      "CoupletIndex": 42,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 85,
      "Position": "Left",
      "Text": "از دمت باد بهار آید پدید",
      "CoupletIndex": 42,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    }
  ]
}
