  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ای ردایت پردهٔ ناموس ما",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "تاب تو سرمایهٔ فانوس ما",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "طینت پاک تو ما را رحمت است",
