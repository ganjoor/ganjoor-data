      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "بدترین عیب او بخواهم گفت",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
