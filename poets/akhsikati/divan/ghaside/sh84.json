      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "رخش چرخ از هلال، در کردن",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "طوق روشن فکنده بود، خرام",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "گفتم: این نیم طشت زرین چیست",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
