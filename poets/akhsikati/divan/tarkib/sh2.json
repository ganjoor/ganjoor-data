      "HtmlText": "\u003Cdiv class=\u0022b2\u0022 id=\u0022bn1\u0022\u003E\u003Cp\u003Eماهی که آفتاب سزد دورباش او\u003C/p\u003E\r\n\u003Cp\u003Eبهرام تند طبع سزد خیل تاش او\u003C/p\u003E\u003C/div\u003E",
      "CoupletsCount": 1
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ای بنده ی لب تو لب آبدار می",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "گلگونه کرد عکس رخت برعذار می",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "تخت هوس نهاده رخت بربساط گل",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "رخت خرد فکنده لبت در جوار می",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "چون صبح جامه چاک زده غنچه حباب",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "پیش نسیم زلف تو بر جویبار می",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "برخیزد از مقرنس سقف فلک نشان",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "صد نرگسه ز شعله ی انجم شرارمی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "در هم شکن شماری زنگاری فلک",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "چون از قسیمه موج برآرد بحارمی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "عالم سیاه کردان بر ذوالخمار غم",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "دست طرب چو لعل کند ذوالفقارمی",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 13,
      "Position": "CenteredVerse1",
      "Text": "عکس می است شعله ی مجلس فروز عید",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 6
    },
    {
      "VOrder": 14,
      "Position": "CenteredVerse2",
      "Text": "روز طرب بباده برافروز روز عید",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 6
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "دست زمان نقاب گشاد از جمال عید",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "دلاله عروس طرب شد دلال عید",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "چشم سیه سپید زمانه بدید و گفت:",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "با او گسسته عین کمال از جمال عید",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "خالی است عید بر لب ایام تا بحشر",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "خط زوال دست بریده ز خال عید",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "سعد فلک چو آینه چشم است جمله تن",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "بر بوی عکس از رخ مسعود فال عید",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "بر ارغنون بلبله ی ارغوان نمای",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "حال طرب خوش است که خوش بادحال عید",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "گر نو بهار عشرت خسرو دهد مثال",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "بستان روزگار بگیرد نهال عید",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "عین کمال عید رخ اوست دور باد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "عین کمال فتنه، ز عین کمال عید",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 29,
      "Position": "CenteredVerse1",
      "Text": "چرخ ظفر مظفر دین عالم کرم",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 7
    },
    {
      "VOrder": 30,
      "Position": "CenteredVerse2",
      "Text": "در شان خستگان عنا مرهم کرم",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 7
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "دریا گه سخا زغلامان دست اوست",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "در روی مهر طبع کرم پای بست اوست",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "دُردی کشی است ازشکر، شکراو، از آنک",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "در مجلس نوال شده مست مست اوست",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "دیری است تا که مسند شاهی نهاده چشم",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "بر پای انتظار به بوی نشست اوست",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "جای بلند پایه وجود فراخ او",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "هرچند نسبت همه خلق است هست اوست",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "میدان دهر اگرچه فراخ است تنک اوست",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "ایوان چرخ اگرچه بلند است پست اوست",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "تیری همی نه بینم در جعبه سخن",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "کان در مصاف گاه نه بامرد شست اوست",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "همچون کمان پنبه زنان بشکلی است خصم",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "ور خودز آهن است نه مردان شست اوست",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "صدرش چوپای مرد فتوح است روزگار",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "گر زان ستانه لاف زند حق بدست اوست",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 47,
      "Position": "CenteredVerse1",
      "Text": "ماهی که آفتاب سزد دورباش او",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 8
    },
    {
      "VOrder": 48,
      "Position": "CenteredVerse2",
      "Text": "بهرام تند طبع سزد خیل تاش او",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 8
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "کان، دایم از سخاش بخروار زر کشد",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "جان، دایم از بیانش بدامن گهر کشد",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "سیمرغ مشرقی است به پرواز رایتش",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "زان طول و عرض گیتی درزیر پر کشد",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "هم کفته فلک شکند هم عمود صبح",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "گر حلم او زمانه به معیار بر کشد",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "بر در گه کمالش شبدیز آسمان",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "هرمه دو بار کردن در طوق زر کشد",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "پیش کمال او که جهانی است پایدار",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "فانی جهان، هر آنچه کشد مختصر کشد",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "اقبال گرنه بوسه دهد آستان او",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "دست تصرف اجلش دربدر کشد",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "عزمش بپشت باد برافکنده راحله",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "یعنی که بار اسب سبکبار خر کشد",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    }
  ]
