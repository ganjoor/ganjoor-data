      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "نه بر تاجدار و نه بر موبدان",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
