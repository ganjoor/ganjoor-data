  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "همی رفت منزل به منزل به راه",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "ز ره رنجه و مانده یکسر سپاه",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
