  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "چو بنشست بهرام بهرامیان",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "ببست از پی داد و بخشش میان",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "به تاجش زبرجد برافشاندند",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
