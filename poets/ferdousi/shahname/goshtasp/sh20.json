      "Position": "Left",
      "Text": "سوی گاه باز آمد از رزمگاه",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "به بستور گفتا که فردا پکاه",
