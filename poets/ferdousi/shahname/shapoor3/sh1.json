    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "همی دانشی نام جوید ز لاف",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "دو گیتی بیابد دل مرد راد",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "نباشد دل سفله یک روز شاد",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "بدین گیتی او را بود نام زشت",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "بدان گیتی‌اندر نیابد بهشت",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "دو گیتی نیابد دل مرد لاف",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "که بپراگند خواسته بر گزاف",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "ستوده کسی کو میانه گزید",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "تن خویش را آفرین گسترید",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "شما را جهان‌آفرین یار باد",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "همیشه سر بخت بیدار باد",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "جهاندارمان باد فریادرس",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "که تخت بزرگی نماند به کس",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "بگفت این و از پیش برخاستند",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "ز یزدان برو آفرین خواستند",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "چو شد سالیان پنج بر چار ماه",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "بشد شاه روزی به نخچیرگاه",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "جهان شد پر از یوز و بازان و سگ",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "چه پرنده و چند تازان به تگ",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "ستاره زدند از پی خوابگاه",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "چو چیزی بخورد و بیاسود شاه",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "سه جام می خسروانی بخورد",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "پراندیشه شد سر سوی خواب کرد",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "پراگنده گشتند لشکر همه",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "چو در خواب شد شهریار رمه",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "بخفت او و از دشت برخاست باد",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "که کس باد ازان سان ندارد به یاد",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "فروبرده چوب ستاره بکند",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "بزد بر سر شهریار بلند",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "جهانجوی شاپور جنگی بمرد",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "کلاه کیی دیگری را سپرد",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "میاز و مناز و متاز و مرنج",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "چه تازی به کین و چه نازی به گنج",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "که بهر تو اینست زین تیره‌گوی",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "هنر جوی و راز جهان را مجوی",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "که گر بازیابی به پیچی بدرد",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "پژوهش مکن گرد رازش مگرد",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "چنین است کردار این چرخ تیر",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "چه با مرد برنا چه با مردپیر",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    }
  ]
}
