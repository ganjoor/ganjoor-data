  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "زهی بجود تو ایام مکرمت مشهور",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "خهی بسعی تو اعلام محمدت معمور",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "بهر بلاد علامات عدل تو پیدا",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "بهر دیار مقامات تو مشهور",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
