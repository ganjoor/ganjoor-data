  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "فغان من از نعرهٔ پاسبان ",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "که افگند تعجیل در کاروان ",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "سبک برگرفتند بار مرا ",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "نهدند بر سینه بار گران ",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "برفت آن مه آسمان و ز رنج ",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "ندانم زمین را همی ز آسمان ",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "برفت او و جان شد ز شخصم برون ",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
