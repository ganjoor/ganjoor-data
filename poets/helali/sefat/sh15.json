  "Title": "بخش ۱۵ - حکایت آن دو صاحب جمال که یکی از خلق خوش عاقلان را دیوانه ساخته بود و دیگری از خوی بد آشنایان را بیگانه خویش کرده بود",
  "FullTitle": "هلالی جغتایی » صفات العاشقین » بخش ۱۵ - حکایت آن دو صاحب جمال که یکی از خلق خوش عاقلان را دیوانه ساخته بود و دیگری از خوی بد آشنایان را بیگانه خویش کرده بود",
  "FullUrl": "/helali/sefat/sh15",
