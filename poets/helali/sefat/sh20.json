      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "حریفان بال همت باز کردند",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
