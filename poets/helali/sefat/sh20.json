  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "بیا، ای پست همت، این چه سستیست؟",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "طریق رهروان گرمی و چستیست",
