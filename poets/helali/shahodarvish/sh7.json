    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "بلکه جایش همیشه بر فلکست",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "نه سخن از دهن برون آید",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: سخن در اصل از دهان بیرون نمی‌آید، بلکه از سخنی دیگر یعنی کلام آفریننده سرچشمه می‌گیرد."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "که سخن از سخن برون آید",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "این سخن زادهٔ دو حرف کنست",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: این سخن زادهٔ دو حرفِ «کن» یعنی فرمان آفرینش است؛ و خودِ این «کن» نیز با آنکه دو حرف است، یک سخن است."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "بلکه این کن دو حرف یک سخنست",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "ای خرد از سخن روایت کن",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: ای خرد، از سخن روایت کن و با زبان قلم دربارهٔ آن داستان بگو."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "به زبان قلم حکایت کن",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "کاتب صنع داشت میل سخن",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: نگارندهٔ آفرینش یعنی خداوند به سخن گرایش داشت و لوح و قلم را به خاطر سخن و در پیِ آن آفرید."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "ساخت لوح و قلم طفیل سخن",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "ای قلم، ساعتی زبان بگشای",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: ای قلم، لحظه‌ای زبان بگشا و دهانِ صندوقچهٔ مشک یعنی دواتِ مرکب را باز کن."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "حقهٔ مشک را دهان بگشای",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "واقفی از سفیدی و سیهی",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "CoupletSummary": "هوش مصنوعی: تو از سپیدی کاغذ و سیاهی مرکب آگاهی؛ به سیاهی درآ، زیرا تو همچون خضر راهنمایی که در تاریکی به آب حیات رسید."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "در سیاهی در آ که خضر رهی",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "گرچه از تیغ من قلم شده ای",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17,
      "CoupletSummary": "هوش مصنوعی: هرچند تو با تیغ من تراشیده و «قلم» شده‌ای، به سبب سخن در جهان «عَلَم» و نامدار شده‌ای."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "به سخن در جهان علم شده‌ای",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "تو به گفتار شکرین سمری",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18,
      "CoupletSummary": "هوش مصنوعی: تو به سبب گفتار شیرینت مشهوری؛ تو قلم نیستی بلکه نیشکری."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "تو قلم نیستی که نی شکری",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "چون تو نازک نهال دیگر نیست",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19,
      "CoupletSummary": "هوش مصنوعی: هیچ نهال باریک و لطیفی مانند تو نیست؛ همهٔ انگشت‌ها یکسان نیستند و تو در میان آن‌ها ممتازی."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "همه انگشت‌ها برابر نیست",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "ملک معنی از آن تست همه",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20,
      "CoupletSummary": "هوش مصنوعی: سراسر قلمرو معنا از آنِ توست؛ ای قلم، این حقیقت را در یک کلمه می‌توان گفت که فرمانروایی معنا با توست."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "این قلم زو تو راست یک کلمه",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "شاه معنی تویی، علم بردار",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21,
      "CoupletSummary": "هوش مصنوعی: پادشاه معنا تویی؛ پرچم برافراز و به سوی سرزمین سخن گام بردار."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "سوی ملک سخن قدم بردار",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "یاد کن سحرآفرینان را",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22,
      "CoupletSummary": "هوش مصنوعی: از شاعران جادوسخن و نکته‌دانان و باریک‌بینان یاد کن."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "نکته‌دانان و خرده‌بینان را",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "که همه مخزن سخن بودند",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23,
      "CoupletSummary": "هوش مصنوعی: آنان همه گنجینهٔ سخن بودند و رازهای نو و کهن را می‌دانستند."
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "رازدان نو کهن بودند",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "عالم از در نظم پر کردند",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24,
      "CoupletSummary": "هوش مصنوعی: جهان را از مرواریدهای شعر پر کردند و مانند دریا مروارید نثار کردند."
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "همچو دریا نثار در کردند",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "ابر رحمت نثار ایشان باد",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25,
      "CoupletSummary": "هوش مصنوعی: باران رحمت بر آنان ببارد و لطف جاودان همواره همراهشان باشد."
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "لطف جاوید یار ایشان باد",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "بر رسولی که نعت اوست کلام",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26,
      "CoupletSummary": "هوش مصنوعی: و نیز رحمت و درود بر پیامبری که کلام در ستایش اوست، یعنی سرور پیامبران، که سلام بر او باد."
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "سیدالمرسلین علیه سلام",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    }
  ]
}
