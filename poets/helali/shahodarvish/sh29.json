  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "چند روزی که شاه بنده‌نواز",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
