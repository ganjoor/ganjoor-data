  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "شاه چون در گدا نظر می‌کرد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: وقتی شاه به گدا نگاه می‌کرد، محبت او در دل شاه تأثیر می‌گذاشت."
    },
    {
      "VOrder": 2,
