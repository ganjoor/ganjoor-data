  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "شاه چون در گدا نظر می‌کرد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "مهر او در دلش اثر می‌کرد",
