  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "بود شه را کبوتری که فلک",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: شاه کبوتری داشت که آسمان نه در میان پریان و نه در میان فرشتگان مانند آن را دیده بود."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "نه پری دید مثل او نه ملک",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "در پریدن بلند پایهٔ او",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: در پرواز، اوجی بلند داشت و سایه‌اش مانند سایهٔ هما گرامی و فرخنده بود."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "چون همای ارجمند سایهٔ او",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "قمری از بهر بندگی کردن",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: قمری برای بندگی او، طوق بندگی به گردن انداخته و نزد او رفته بود؛ یعنی طوق گردن قمری نشان چاکری اوست."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "پیش او رفته طوق در گردن",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "حلقهٔ چشم باز را کنده",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: آن کبوتر چشم باز شکاری را از جا کنده بود و باز، زره زرین خود را به نشانهٔ تسلیم به پای او افکنده بود؛ یعنی حتی باز هم در برابرش زبون بود."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "زره زر به پایش افگنده",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "کرده پرواز تا مه و انجم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: تا ماه و ستارگان پرواز کرده بود؛ دمش از بس پرواز فرسوده شده و او یکسره به نفَس و پرواز بدل شده بود."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "دم همه سوده و شده همه دم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "روزی آن هدهد همایون فر",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: روزی آن پرندهٔ فرخنده، که همچون هدهد پیام‌آور بود، از بس گرد آسمان بال می‌زد..."
    },
    {
      "VOrder": 12,
      "Position": "Left",
