      "VOrder": 13,
      "Position": "Right",
      "Text": "تا کی از راه مطربان شنوم",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "که ترا می همی دهد دشنام",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "گاه گوید که رنگ تو نه درست",
