  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "گل بخندید و باغ شد پدرام",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
