      "Text": "می آن گویم که دانم، ور ندانم",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "مرا از جمله جهال مشمر",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
