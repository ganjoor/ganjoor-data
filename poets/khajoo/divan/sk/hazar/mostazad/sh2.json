  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "کس نیست که گوید ز من آن ترک ختارا",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: هیچ‌کس نیست که بگوید در مورد من آن دختر زیبا اگر اشتباهی کرده است."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "گر رفت خطائی",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "باز آی که داریم توقع ز تو یارا",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: برگرد و به ما امید بده، زیرا ما به تو اعتماد داریم و انتظار وفای به عهدت را داریم."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "با وعده وفائی",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "منداز بنام من دل سوخته فلفل",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: نگذار دل آزرده‌ام را به خاطر نامی سوزانتر از فلفل بر آتش چهره به تصویر بکشد."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "بر آتش رخسار",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "کافتاده دل از دانه ی مشکین تو ما را",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: دل ما به خاطر بوی خوش مشک تو در دام مصیبت‌ها گرفتار شده است."
    },
    {
