      "Position": "Right",
      "Text": "از موکب طلایه سلطان نیمروز",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "بشکست قلب کوکبه ی خیل زنگبار",
      "CoupletIndex": 1,
      "SectionIndex1": 0
