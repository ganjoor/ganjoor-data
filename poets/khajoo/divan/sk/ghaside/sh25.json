  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "چو نشد ز بام طارم این نیلگون حصار",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "منجوق چتر خسرو سیاره آشکار",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
