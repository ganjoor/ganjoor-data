  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "روان گشته با آن پریچهره ماه",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "تماشاکنان اندر آن بارگاه",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "به ناگه به کاخی رسید از قضا",
