      "VOrder": 3,
      "Position": "Right",
      "Text": "عیان شد عین عقل از قاف قدرت",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "سه جوی آورد اندر باغ فطرت",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "درخت نور چشم جان برافراخت",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "همای عشق بر سر آشیان ساخت",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "دهد بر جویبار چشم احباب",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "ز عین عشق بیخ حسن را آب",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "دو عالم ذره است و مهر خورشید",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "دلش انگشتری و عشق جمشید",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "سرای روح کرد این خانهٔ دل",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "خورای عشق گشت این دانهٔ دل",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "حصار جسم را از آب و گل ساخت",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "به چندین مهره دیوارش برافراخت",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "فراوان شد اساس شخص آدم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "به پشتیوان این گل مهره محکم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "به قدرت راست کرد این خانه دل",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "سه حاکم را در آنجا ساخت منزل",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "کبد را تکیه‌گاه از راست تا راست",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "مقام قلب کرد از صدر چپ راست",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "چو جسمی بارگاه هفت‌تو زد",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "دل آمد خیمه بر پهلوی او زد ",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "خرد را کو دماغی داشت در سر",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "از این هر دو مقامی داد برتر",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "مزین کرد لطفش سرو قامت",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "به حسن اعتدال و استقامت",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "که از صنعش کند درخواست شاهد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "که انسان را ز سر تا پاست شاهد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "هر آنچ از گوهر خاک آفریده‌ست",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "تو پاکش بین که او پاک آفریده‌ست",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "همه پاک آمدیم از عالم غیب",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "ز کج بینی ما پیدا شد این عیب",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "ز مینا خسروانی قصری افراخت",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "به شیرینکاری او را بی ستون ساخت",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "میان حقهٔ فیروزه پیکر",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "معلق کرد حسنش چار گوهر",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "فلک پیمانهٔ فضل نوالش",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "جهان پروانهٔ شمع جلالش",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "به دیوان ازل حکمش نشسته",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "همه کون و مکان را جمع بسته",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "برانده چرخ و باقی کرده پیدا",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "ز کل من علیه فان و یبقی",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "و یبقی وجه ربک ذوالجلالش",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "شده باقی وجه لایزالش",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "حریر لاله و گل را به شب ماه",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "ز صنعش داده حسن صبغة‌الله",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "به تاب خیط شمس و سوزن خار",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "بدوزد قرطهٔ زربفت گلزار",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "ز زرین نشتر خورشید تابان",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "گشاید خون یاقوت از دل کان",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "شکر را در میان نی نهان کرد",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "به چندینش قلم شرح و بیان کرد",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "سپارد ماهئی را مهر جمشید",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "به خرچنگی رساند تخت خورشید",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "به کرمی داد از ابریشم کناغی",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "به کرمی می‌دهد در شب چراغی",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "قمر با این همه کار و کیایی",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "بود هر مه شبی بی‌روشنایی",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "به موشان جبه سنجاب بخشد",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "کَوَلها بر پلنگ و شیر پوشد",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "به بوئی کو کند در نافه افزون",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "کند آهوی مشکین را جگر خون",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "قبایی از برای غنچه پرداخت",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "دگر بشکافت آن را پیرهن ساخت",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "خرد را کار با کار خدا نیست",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "کسی را زَهرهٔ چون و چرا نیست",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "فلک را با چنین کاری چه کار است",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "همه کاری به حکم کردگار است",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "اگر بودی فلک را اختیاری",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "گرفتی یک زمان بر جا قراری",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "ز ما در کار خود حیران‌تر است او",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 36
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "ز ما صد بار سرگردان‌تر است او",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 36
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "خرد در کار خود سرگشته رایی است",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 37
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "فلک در راه او بی‌دست و پایی است",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 37
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "در این مجلس که امرش حکم فرمود",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 38
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "فلک چون حلقهٔ بیرون در بود",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 38
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "صفات او ز کیف و کمّ فزون است",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "ز هرچه آن درون آمد برون است",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    }
  ]
}
