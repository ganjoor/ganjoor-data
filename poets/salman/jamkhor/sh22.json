      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "چو سایه در پی خورشید بودن",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "درین ره نیز خواهم شد چو خنجر",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "به سر خواهم برید این ره سراسر»",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "چو مهراب آتش کین ملک دید",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "به پیشش روی را بر خاک مالید",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "که: «من طبع ملک می‌آزمودم",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "در راز درونی می‌گشودم",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "چو دانستم که عشقت پای بر جاست",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "کنون این کار کردن پیشه ماست",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "رکاب اندر رکابت بسته دارم",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "عنانت با عنان پیوسته دارم",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "به هر جانب که بخرامی روانم",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "به هر صورت که فرمایی بر آنم",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "کنون باید بسیج راه کردن",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "شهنشه را ز حال آگاه کردن",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "بضاعت بردن از هر جنس با خویش",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "گرفتن پس طریق روم در پیش",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "به رسم تاجران در راه بودن",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "نمی‌شاید درین ره شاه بودن",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "درین معنی سخن بسیار گفتند",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "از آن گفت و شنید آن شب نخفتند",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "سحر چون رایت از مشرق برافراشت",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "فلک زیر زمین گنجی روان داشت",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "کلید صبح در جیب افق بود",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "برآورد و در آن گنج بگشود",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "برون آورد درج لعل پر زر",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "ز لعل و زر زمین را ساخت زیور",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    }
  ]
}
