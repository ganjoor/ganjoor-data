  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "تو ای جان من ای بیمار چونی؟",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
