  "Verses": [
    {
      "VOrder": 1,
      "Position": "Comment",
      "Text": "غزل",
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 2,
      "Position": "Right",
      "Text": "برو به کار خود ای واعظ این چه فریاد است",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 3,
      "Position": "Left",
      "Text": "مرا فتاده دل از ره ترا چه افتاده‌ست",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 4,
      "Position": "Right",
      "Text": "به کام تا نرساند مرا لبش چو نای ",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 5,
      "Position": "Left",
      "Text": "نصیحت همه عالم به گوش من باد است",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "دلا منال ز بیداد و جور یار که یار ",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "ترا نصیب همین کرده است و این داده‌ست",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "اگر چه مستی عشقم خراب کرد ولی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "اساس هستی ما ز آن خراب آباد است",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "میان او که خدا آفریده است از هیچ",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "دقیقه‌ای‌ست که هیچ آفریده نگشاده‌ست",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 12,
      "Position": "Right",
      "Text": "برو فسانه مخوان و فسون مدم بسیار",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 13,
      "Position": "Left",
      "Text": "کزین فسانه و افسون بسی مرا یاد است",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "گدای کوی تو از هشت خلد مستغنی است",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "اسیر بند تو از جمله عالم آزاد است",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 16,
      "Position": "Comment",
      "Text": "ادامه",
      "CoupletIndex": 7,
      "SectionIndex1": 1,
      "SectionIndex2": 2
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "دمم کم ده که دم آتش فروزد",
      "CoupletIndex": 8,
      "SectionIndex1": 1,
      "SectionIndex2": 2
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "چو چربی بیند آتش، بیش سوزد",
      "CoupletIndex": 8,
      "SectionIndex1": 1,
      "SectionIndex2": 2
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "بدین دم ترک این سودا نگیرم",
      "CoupletIndex": 9,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "رها کن تا درین آتش بمیرم",
      "CoupletIndex": 9,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "تنم چون خاک اگر در خاک ریزد",
      "CoupletIndex": 10,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "ز کوی دوست گردم برنخیزد",
      "CoupletIndex": 10,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "چو گفتار ملک بنشیند مهراب",
      "CoupletIndex": 11,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "فرو بارید مژگانش ز مهر آب ",
      "CoupletIndex": 11,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "به جم گفت این زمان تدبیر باید",
      "CoupletIndex": 12,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "که بی تدبیر کاری برنیاید",
      "CoupletIndex": 12,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "چو دولت بر تو اکنون گشت لازم",
      "CoupletIndex": 13,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "شدن بر درگه قیصر ملازم",
      "CoupletIndex": 13,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "نکرده‌ستی تو خدمت لیک دانی",
      "CoupletIndex": 14,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "تو رسم و خوی شاهان نیک دانی",
      "CoupletIndex": 14,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "چو قیصر رسم و آیین تو بیند",
      "CoupletIndex": 15,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "همانا با تو پیوندی گزیند",
      "CoupletIndex": 15,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "به دامادی خود نامت برآرد",
      "CoupletIndex": 16,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "مرادت بخشد و کامت برآرد",
      "CoupletIndex": 16,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "هنوز اسباب سلطانیت برجاست",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "اساس‌البیت جمشیدی مهیاست",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "سپاه است و درم اسباب شاهی",
