      "SectionIndex1": 1,
      "SectionIndex2": 17
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "رود در مرکب خورشید هر ماه",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 17
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "چنان کارش فروغ نور گیرد",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 18
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "که از نورش جهان رونق پذیرد",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 18
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "ملک چون قصه از مهراب بنشید",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 19
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "صلاح حال خود حالی در آن دید",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 19
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "از آن کهسار چون ابر بهاران",
      "CoupletIndex": 26,
      "SectionIndex1": 1,
      "SectionIndex2": 20
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "فرود آمد سرشک از دیده باران",
