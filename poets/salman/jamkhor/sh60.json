      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "هنوزت هست زین چندان که خواهی",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "هنوزت شمع دولت نامدار است",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "درختت سبز و تیغت آبدار است",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "هنوزت باد پایانند زینی",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 14
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "هنوزت ماهرویانند چینی",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 14
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "به هر کاری درم در دست باید",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 15
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "که از دست تهی کاری نیاید",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 15
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "ببین کز صحبت خور مهره گل",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 16
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "چه مایه زر و گوهر کرد حاصل",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 16
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "قمر پیکی است آخر زانچه هر ماه",
