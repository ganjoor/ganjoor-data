      "SectionIndex1": 1,
      "SectionIndex2": 22
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "زر و یاقوت را ترکیب کردند",
      "CoupletIndex": 29,
      "SectionIndex1": 1,
      "SectionIndex2": 23
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "چو خورشید افسری ترتیب کردند",
      "CoupletIndex": 29,
      "SectionIndex1": 1,
      "SectionIndex2": 23
    }
