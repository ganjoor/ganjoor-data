  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ز قلب لشکر آمد سوی جمشید ",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
