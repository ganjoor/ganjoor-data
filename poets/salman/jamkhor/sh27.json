    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "دراز آهنگ دیدش قصد پا کرد ",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "به تیغش گرد ران از تن جدا کرد ",
