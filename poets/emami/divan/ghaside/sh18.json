    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "قلمت نقش غیر را پرگار",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 104
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "گفت از جود، حاتم طائی",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 104
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "دلت از علم، حیدر (ع) کرار",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 105
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "اولیای ترا ز گردش چرخ",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 105
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "دیده ی بخت جاودان بیدار",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 106
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "روز جاه تو زیور ایام",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 106
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "دور حکم تو زبده ی ادوار",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 107
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "هم ز دست تو برق گوهر فتح",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 107
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "روز بدخواه کرده روز شمار",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 108
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "هم ز شست تو مرغ دانه ی روح",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 108
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "چار پر گشته وانگهی طیار",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 109
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "روز هیجا چو بر کشد ز نیام",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 109
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "دست شمشیر خسروان آثار",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 110
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "گر نگردد ز بیم او پنهان",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 110
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "گر نخواهد ز تاب او زنهار",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 111
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "بگسلد روح روزگار ز جسم",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 111
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "بر کشد پود کائنات ز تار",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 112
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "بر سر بدسکال دین چو نهد",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 112
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "آب رخسارش آتشین دستار",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 113
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "همه دشوار ملک ازو آسان",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 113
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "همه آسان خلق ازو دشوار",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 114
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "نیم جان گوید از زبان عدوت",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 114
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "چون بر آری روانش از بن و بار",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 115
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "مرگ را شد روان ز نایره آب",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 115
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "اجل آمد برون ز پوست چو مار",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 116
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "گرچه دریای خون بجوش آورد",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 116
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "بر در کازرون گه پیکار",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 117
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "گرچه در پای کرد کوه هنوز",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 117
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "موج خون زو همی رسد به حصار",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 118
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "قطره آب باشد اندر بحر",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 118
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "در کفش روز رزم و ساعت کار",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 119
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "دامنش پر ز گوهر است که هست",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 119
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "روز رزم تواش بدریا بار",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 120
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "ای بفضل و بزرگی از وزراء",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 120
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "گشته ممتاز و در زمانه مشار",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 121
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "بی تکلف بپایه تو، که باد",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 121
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "درت از جاه وجود برخوردار",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 122
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "دستم طبعم نمی رسد که رسید",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 122
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "تا بافلاک پایه اشعار",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 123
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "هنرت چون مکارم صدریست",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 123
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "بر تر از ذروه ی قیاس شمار",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 124
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "که فرود زمین حضرت اوست",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 124
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "اوج قدر اکابر و اخیار",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 125
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "سعد دین، فضل زمان و زمین",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 125
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "همچو من عاجز از ثناش هزار",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 126
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "دین پناهی که نوک خامه اوست",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 126
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "فیض بخش خرد پذیر فتار",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 127
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "ای ز آب زمین دولت تو",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 127
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "پر ز نورند انجم سیار",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 128
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "وی که بی نظم و نثر تو نبود",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 128
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "عالم علمرا شعا رود ثار",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 129
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "ای بتحسین زبان تیر سپهر",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 129
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "برده از خامه تو چون سوفار",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 130
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "علم، اندر هوای سایه تست",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 130
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "سایه بر وی فکن، بهانه میار",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 131
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "اندرین هفته همتت که سپهر",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 131
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "باد مأمور امر او هموار",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 132
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "با خود از روی تجربت می گفت",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 132
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "کای دل عیش جوی باده گسار",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 133
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "گرچه هنگام عشرتست و صبوح",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 133
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "خاصه با نعمه ی چکاوک و سار",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 134
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "گرچه سرمست رنگ و بوی گلند",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 134
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "تخت بزاز و کلبه عطار",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 135
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "بی رضای خدایگان صدور",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 135
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "نبود فیض روح نوش گذار",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 136
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "گرچه جز غم نبوده حاصل عمر",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 136
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "سر از آن چون بدین رسد بردار",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 137
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "در گرفت این حدیت و حالی گشت",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 137
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "قدم همت سپهر سپار",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 138
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "ای سحاب مطیر کلک تو را",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 138
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "درّ مکنون مقاطر اقطار",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 139
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "وی فسرده ز بخششت کانرا",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 139
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "خون یاقوت در تن احجار",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 140
    }
  ]
}
