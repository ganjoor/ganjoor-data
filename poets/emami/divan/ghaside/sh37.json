      "Position": "Right",
      "Text": "قضا ز قدرت کلک تو مهره برچیده",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "فلک بخاک جناب تو التجا کرده",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
