  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "زهی جلال تو از عرش متکا کرده",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "فروغ رای تو خورشید را سها کرده",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
