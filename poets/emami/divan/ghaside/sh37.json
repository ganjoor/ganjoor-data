      "Position": "Right",
      "Text": "جهان بعهد تو نا ایمن از سپهر شده",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "فلک بدور تو تا بر جهان وفا کرده",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 7,
