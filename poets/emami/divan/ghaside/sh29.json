  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "کای سر زلف ترا شب در شکن",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "در شبت روزست، در روزت فتن",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ماهت اندر مشک و روز اندر شبست",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "مشک اندر ماه و سنبل بر سمن",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
