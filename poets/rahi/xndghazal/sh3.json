      "SectionIndex3": 5
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "ای مشکبو نسیم صبحگاهی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "از من بگو بدان مه خرگاهی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "آه و فغان من به فلک بر شد",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "سنگین دلت نیافته آگاهی",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "با آهنین‌دل تو چه داند کرد؟",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "آه شب و فغان سحرگاهی",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "ای هم‌نشین بیهوده‌گو تا چند",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "جان مرا به خیره همی‌کاهی؟",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "راحت ز جان خسته چه می‌جویی؟",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "طاقت ز مرغ بسته چه می‌خواهی؟",
