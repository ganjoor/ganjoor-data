    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "در لطافتِ بهارِ حسنم گفت",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: او در شعرش زیبایی‌ام را در لطافت به بهار مانند کرد و از جهت شکوه و بزرگی، مرا همتای خورشید دانست."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "وز جلالت قرین مهرم ساخت",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "چهرگان مرا، به جلوه‌گری",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: و چهره‌ام را در جلوه و درخشش، مایهٔ رشک ستارهٔ صبح خواند."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "خواند رشکِ ستارهٔ سحری",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "خواستار سوم ز کَشّی و ناز",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: خواستگار سوم از خوش‌خرامی و ناز، آرامش دل‌ها را می‌سوزاند و افسونگر بود."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "عافیت‌سوز بود و افسون‌ساز",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "آفت عقل بود و غارت هوش",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: او آفت عقل و غارتگر هوش بود؛ نشانهٔ زیبایی و سرچشمهٔ ناز بود."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "آیت حسن بود و مایه ناز",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "دید چون قامت رسای مرا",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: با این همه، وقتی قامت بلند و رعنای مرا دید، در برابرم خم شد و پایم را بوسید."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "خم شد و بوسه داد پای مرا",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "تو نه زر داری و نه زیور و زیب",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: گوینده رو به محبوب خود می‌گوید: تو نه طلا داری و نه زر و زیور، نه شاعر و سخن‌پردازی و نه ادیب و دانشمند."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "نه سخن‌آفرینی و نه ادیب",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "نه تو را، چهره‌ای است لاله‌فروش",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: نه چهره‌ای زیبا و سرخ چون لاله داری و نه ظاهری که چشم را بفریبد."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "نه تو را منظری است دیده‌فریب",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "لیک یارم از این میانه تویی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: اما از میان همهٔ آنان، یار من تو هستی و تنها تویی که تیر عشق من به سوی تو نشانه رفته است."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "ناوک عشق را نشانه تویی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    }
  ]
}
