      "SectionIndex2": 1
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "دل خود چو از خاکیان واگرفتی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "مگر طایر بوستان بهشتی؟",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "که جا بر سر شاخ طوبی گرفتی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "مگر پنجه مشک‌سای نسیمی؟",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "که گیسوی آن سروْبالا گرفتی",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "مگر دست اندیشهٔ مایی ای گل؟",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "که زلفش به عجز و تمنا گرفتی",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "مگر فتنه بر آتشین‌روی یاری",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "که آتش چو ما در سراپا گرفتی؟",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "گرت نیست دل از غم عشق خونین",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "چرا رنگ خون دل ما گرفتی؟",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "بود موی او جای دل‌های مسکین",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "تو مسکن در آن حلقه بی‌جا گرفتی",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "از آن طره پرشکن هان به یک سو",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "که بر دیده راه تماشا گرفتی",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "تو را بود رنگی و بویی نبودت",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "کنون بوی ازآن زلف بویا گرفتی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "گلی بودی از هر گیا بی‌بهاتر",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "کنون زیب از آن روی زیبا گرفتی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 27,
      "Position": "CenteredVerse1",
      "Text": "نه تنها در آن حلقه بویی نداری",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "SectionIndex3": 4
    },
    {
      "VOrder": 28,
      "Position": "CenteredVerse2",
      "Text": "که با روی او آبرویی نداری",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "SectionIndex3": 4
    }
  ]
}
