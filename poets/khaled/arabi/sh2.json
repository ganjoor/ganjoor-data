      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "لحظه فی العمر لست فی الفراق",
      "CoupletIndex": 5,
      "SectionIndex1": 0
