  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "نَسیِم الوَرد یَذکُرنِی حَبِیب ِ",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "و یُحَیینی بصَوتِ العَندَلیبِ",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "طَبیبِ العِشقِ دَاوا کُل َّ داءٍ",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "فَکَیفَ و زادَنی دائی طَبِیبِ",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "یُفارقُنِی الرَّقِیبُ عَنِ الَّرفیقِ",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "فَقارب بَینَنا یا ذالرَقِیبِ",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "لِیَومِ الهَجرِ لِی یَومٌ عَصِیبٌ",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "و إنَّی خِفتُ مِن یومٍ عَصِیِبِ",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "فُؤادٍ غابَ یا سلمایَ عَنِیّ",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "فإذ یَاتِیک أحسِن بالغَریبِ",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "نَصیبی بالهَوا نَصَب وداءٌ",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "أصَبنا ما أصَبنا یا نَصیبِ",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "ببعدِ الهَجرِ إنی إذ امُوتُ",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "فَقُربُالوَصلِ أرجُو عَنقَریبِ",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    }
  ]
