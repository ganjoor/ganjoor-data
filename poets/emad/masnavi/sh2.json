      "Text": "از وی امید وفاداری خطاست",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "عاشق و شوریده و دیوانه شو",
