  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "آنکه را رفت ز کف هرچه که داشت",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "حال ما سهل نخواهد انگاشت",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "زارعی سوخته خرمن چه کند؟",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "مرده در شهر نشیمن چه کند؟",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "پاک دیوانه به از این که منم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "عقل را چیست بجز سوختنم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "ای خوش آن لحظه که رویش دیدم",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "ای خوش آن شب که لبش بوسیدم",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "یاد از آن جوی و اقاقی‌ها یاد",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "یاد از آن مستی و شیدایی باد",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "مست از باده و پیمانه‌ی عشق",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "بنشستیم در آن لانه‌ی عشق",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "بست پیمانی و پیمانی سخت",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "شاهد عقد، صبا بود و درخت",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "بهر امضای وفا نامه‌ی ما",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "بوسه آمد به میان، بوسه کجا",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "بوسه‌اش نام نهادن ستم است",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "جانش ار نام کنم باز کم است",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "چه شرر بود که در جانش زدند",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "به منش داده به دامانش زدند",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 21,
      "Position": "CenteredVerse1",
      "Text": "هرچه بود آن بت زیبای عماد",
