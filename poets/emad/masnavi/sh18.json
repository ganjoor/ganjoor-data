      "SectionIndex2": 4,
      "SectionIndex3": 6
    },
    {
      "VOrder": 24,
      "Position": "CenteredVerse2",
      "Text": "هم دگر خرمن ما داد به باد",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "SectionIndex3": 6
    },
    {
      "VOrder": 25,
      "Position": "CenteredVerse1",
      "Text": "کم کم از عشق ز من هم بگذشت",
