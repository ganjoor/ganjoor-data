      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "مست و در خرمن جانم آذر",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "بگرفتم که دهم او را تاب",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 38,
