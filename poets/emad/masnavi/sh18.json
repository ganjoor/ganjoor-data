      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "تاب می‌دادمش و شوق و شعف",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "برده بود این دل دیوانه ز کف",
