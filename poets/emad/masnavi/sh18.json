      "Text": "دست بالاتر و بالاتر رفت",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "تا سوی دست بُتم یکسر رفت",
