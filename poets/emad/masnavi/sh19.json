  "Verses": [
    {
      "VOrder": 1,
      "Position": "Comment",
      "Text": "از بیوک‌نامه"
    },
    {
      "VOrder": 2,
      "Position": "Right",
      "Text": "گهی یادم رود بودم کجا دوش",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Left",
      "Text": "زمانی نام خود سازم فراموش",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Right",
      "Text": "ولی من شکرها دارم ز نسیان",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Left",
      "Text": "که نتوانم ادایش کرد آسان",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "دل من تا که پیدا کرد او را",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "تحمل کرد چرخ فتنه‌جو را",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "دگر از زهر غم کی باک دارم",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "که با خود اینچنین تریاک دارم",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "نمی‌گویم که غم سویم نیاید،",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "که می‌آید، ولی دیری نپاید",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Right",
      "Text": "دگر غم مرد میدانم نباشد",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Left",
      "Text": "دو روزی چند مهمانم نباشد",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "مرا نسیان اگر آزرده دارد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "نهان در خویش صد غم مرده دارد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "نهد هر روز یک تابوت بر دوش",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "کنم هر شب غمی با وی فراموش",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "هر آن نامردمی کاید مرا پیش",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "که غم خواهد شوم بیگانه از خویش",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "هرآن روزی که بینم قلدری پست",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "به نخوت خاطر بیچاره‌ای خست",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "و یا بی‌دانشی گوید به من زور",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "به چنگ غم شوم مغلوب و مقهور",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "چو شب از دیدگان خوابم گریزد",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "چو خواهد دیو غم خونم بریزد",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "همین نسیان چو غمخواری دلآرام",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "برد آن غم ز دل آرام آرام",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "شرابی گردد از بهر دلِ تنگ",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "کند غم‌های هستی‌سوز کمرنگ",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "اگر مرگم چل و شش سال بگذاشت",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "نه چیزی غیر نسیانم نگه داشت",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "به گیتی گر فراموشی نمی‌بود",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "وگر مستی و مدهوشی نمی‌بود",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "کجا من بعد از آن یوسف به زندان",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "توانستم کشید این بار هجران",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "کجا بعد از چنان مهر جهان‌تاب",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "برای عمر بودم طاقت و تاب",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "از این زندان بسی زین پیش‌ترها",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "بیفکندم ز جان زنجیر تن را",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "ز غم می‌سوخت صد ره تار و پودم",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "کنون صدها کفن پوسانده بودم",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "کجا من بعد از آن ماه دل‌افروز",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "شبی را می‌توانستم کنم روز",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "اگرچه هرچه کرد این بار نسیان",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "نبرد از یاد من آن درد و حرمان",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "فریبی چند اگرچه بود در کار",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "که بودندم در آن سختی نگهدار",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "یکی ایمان ژرفی بعد از آن غم",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "که جز هستی نبودم جمله عالم",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "چو ناگه گم شد آن منظور و مقصود",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "قبول نیستی دشوار بنمود",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "دگر پیوند مهر مادر پیر",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "که با او کُشتن خود بود تقصیر",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "ولیکن باز گر نسیان نمی‌بود",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "نبود از این همه آنقدرها سود",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "اگرچه داغ آن پروانه‌ی مست",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "چو شمعم هست در دل تا دلی هست",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "اگرچه هست داغ آن گل‌اندام",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "چو لاله تا به سنگ آید مرا جام",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 60,
      "Position": "Right",
      "Text": "ولیکن باز نسیان همرهی کرد",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "وگرنه جان نمی‌بردم از آن درد",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 62,
      "Position": "Right",
      "Text": "بزرگی در کتابی می‌نگارد",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "جهان در کف گل خشخاش دارد",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    }
