      "Text": "۲- ای = این."
    },
    {
      "VOrder": 20,
      "Position": "Comment",
      "Text": "۳- مِزِنی = می‌زنی."
    },
    {
      "VOrder": 21,
      "Position": "Comment",
      "Text": "۴- راس = راست."
    },
    {
      "VOrder": 22,
      "Position": "Comment",
      "Text": "۵- نیس = نیست."
    },
    {
      "VOrder": 23,
      "Position": "Comment",
      "Text": "۶- اینچه‌ر = این جا را."
    },
    {
      "VOrder": 24,
      "Position": "Comment",
      "Text": "۷- نِمگُم = نمی‌گویم."
    },
    {
      "VOrder": 25,
      "Position": "Comment",
      "Text": "۸- دیگم = دیگر هم."
    },
    {
      "VOrder": 26,
      "Position": "Comment",
      "Text": "۹- اسمه = اسم است."
    },
    {
      "VOrder": 27,
      "Position": "Comment",
      "Text": "۱۰- چن = چند."
    },
    {
