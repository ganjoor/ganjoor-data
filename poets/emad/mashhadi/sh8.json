  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "همه جا روزَه وای مُلکِ خراب رِفتَه شَبه",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "همه‌ره لب به لب یارَه، مارَه جون به لَبَه",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "چشم تا کار مِکِنه مامایه کوتاه و بِلَند",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "کِلّه‌یِ بِچّه اگر کج نیه بیرون عجبه",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "خاویار ته مُبُرن با جونی والکر مُخُورَن",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "تُرُب و نون ندری واز بگو وقت طَِربه",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "بلدم مام که بسازِم کِرَه از سبب‌زمینی",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "اگه تا ماه مِدَِنَن او کافِرا چَن وجَبه",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "یا که تریاک بسازِم که سه لول شَم بکشی",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "واز ببینی که رِوَُن ۹ آب دماغ پوشتِ لَبه",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "رنگ و بوش مثل سناتوریه، خوش لول و قِشنگ",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "اما نیم من بکشی هیچیه وُ، وای عجبه",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "یک تِشَر دیو مِزِنه چُپ مِکِنم تو خَنَه‌ها",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "توی صف ؤَنگ مِکِنم کی جُلُوه کی عقبه",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "دَس بزن هرکس و ناکِس مِرَه پای تربیون",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "نیست واجب اما، از بعضِ جهات مستحبه",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "یارو لیسانسه و اویم ادبیات و بِزِش",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "مِدی فارسی بِخَنه یک صَفِه از بیخ عربه",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "زندگیما شده سر تا پا دُرُغ راستی مُگُم",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "مُنتها گاه مِگَن مصلحته گاه آدبه",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "توت خوب بیترهاز خرما، خصوص توت مِشد",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "یارو واز جَع مِزِنَه: آی رطبه، ای رطبه",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Comment",
      "Text": "مهر ۱۳۵۰"
    },
