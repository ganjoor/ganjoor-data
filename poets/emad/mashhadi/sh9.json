  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "راستی ای¹ بلبله امشب دیگه محشر مِکِنه",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "ای دفعه‌ی چندمه امشب موژمه² تر مِکِنه",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "مست مسته مخنه مُستنه³ و مِستنه⁴ دل",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "لول لوله پیش گل قمپزاشه در مِکِنه",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "مث⁵ ما افتده چشمش به دوتا عشوه و عور",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "دره خودشه موکوشه، خودشه خکستر⁶ مِکِنه",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "به گمونش مرسه هرچه بگه راس یا دُرغ⁷",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "چشم و گوش بسته یه گل حرفاشه باور مِکِنه",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "نمدنه⁸ او گلیم امشب از ای مست تره",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "دره با ناز و قمیش واز اویم ایر خر مِکِنه",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "چارپن⁹ روز نددن مهلت بیشتر یره‌گر",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "عوض ماچ موچ و حال ناله و نق سر مِکِنه",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "نمدنه خاشخاش گل موسم تیغش رسیده",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "اگه ای دیر بجنبه¹⁰ یکی دیگه مِکِنه",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "نمدنه پن روز دیگه مزنه باد خزون",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "تو گوش باغ و گلر توخ توخ و پریر مِکِنه",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "برگاشم خاک مشه و باد مبره هرجا بخه",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "کم کمک باغره بی‌زینت و زیور مِکِنه",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "بعد پاییز و زمستون میه وازعید و بهار",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "دیگه دنیایه و تکرار مکرر مِکِنه",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "مش عماد حالش اگر خوب بشه شر بد نمِکِنه",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "نه که شر بد نمگه، خوب چپه؟ محشر مِکِنه",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Comment",
      "Text": "واژه‌نامه:"
    },
    {
      "VOrder": 24,
      "Position": "Comment",
      "Text": "۱- ای = این."
    },
    {
      "VOrder": 25,
      "Position": "Comment",
      "Text": "۲- موژمه = مژه‌ام را."
    },
    {
      "VOrder": 26,
      "Position": "Comment",
      "Text": "۳- مُستنه = مستانه."
    },
    {
      "VOrder": 27,
      "Position": "Comment",
      "Text": "۴- مِستنه = می‌ستاند."
    },
    {
      "VOrder": 28,
      "Position": "Comment",
      "Text": "۵- مث = مثل."
    },
    {
      "VOrder": 29,
      "Position": "Comment",
      "Text": "۶- خکستر = خاکستر."
    },
    {
      "VOrder": 30,
      "Position": "Comment",
      "Text": "۷- دُرغ = دروغ."
    },
    {
      "VOrder": 31,
      "Position": "Comment",
      "Text": "۸- نمدنه = نمی‌داند."
    },
    {
      "VOrder": 32,
      "Position": "Comment",
      "Text": "۹- چارپن روز = چهار پنج روز."
    },
    {
      "VOrder": 33,
      "Position": "Comment",
      "Text": "۱۰- بجنبه = بجنبد."
    },
    {
      "VOrder": 34,
      "Position": "Comment",
      "Text": "۱۱- گلر = گل را."
    },
    {
      "VOrder": 35,
      "Position": "Comment",
      "Text": "۱۲- توخ توخ = ریز ریز."
    },
    {
      "VOrder": 36,
      "Position": "Comment",
      "Text": "۱۳- مشه = می‌شود."
    },
    {
      "VOrder": 37,
      "Position": "Comment",
      "Text": "۱۴- بخه = بخواهد."
    },
    {
      "VOrder": 38,
      "Position": "Comment",
      "Text": "۱۵- باغِره = باغ را."
    },
    {
      "VOrder": 39,
      "Position": "Comment",
      "Text": "۱۶- واز = باز."
    },
    {
      "VOrder": 40,
      "Position": "Comment",
      "Text": "۱۷- مش عماد = مخفف مشهدی عماد."
    },
    {
      "VOrder": 41,
      "Position": "Comment",
      "Text": "۱۸- بشه = باشد."
    },
    {
      "VOrder": 42,
      "Position": "Comment",
      "Text": "۱۹- شر = شعر."
    }
  ]
