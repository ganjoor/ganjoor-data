      "Text": "واژه‌نامه:"
    },
    {
      "VOrder": 17,
      "Position": "Comment",
      "Text": "۱- میه = می‌آید."
    },
    {
      "VOrder": 18,
      "Position": "Comment",
      "Text": "۲- واز = باز، دوباره."
    },
    {
      "VOrder": 19,
      "Position": "Comment",
      "Text": "۳- یره = عزیزم، جانم."
    },
    {
      "VOrder": 20,
      "Position": "Comment",
      "Text": "۴- وخه = برخیز."
    },
    {
      "VOrder": 21,
      "Position": "Comment",
      "Text": "۵- مِبِزه = می‌بازد."
    },
    {
      "VOrder": 22,
      "Position": "Comment",
      "Text": "۶- نِدِره = ندارد."
    },
    {
      "VOrder": 23,
      "Position": "Comment",
      "Text": "۷- بِذِره = بگذارد."
    },
    {
      "VOrder": 24,
      "Position": "Comment",
      "Text": "۸- نیس = نیست."
    },
    {
      "VOrder": 25,
      "Position": "Comment",
      "Text": "۹- دوبره = دوباره."
    },
    {
      "VOrder": 26,
      "Position": "Comment",
      "Text": "۱۰- بسی = بیا، نگاه کن."
    },
    {
      "VOrder": 27,
      "Position": "Comment",
      "Text": "۱۱- مِخِنه = می‌خواند."
    },
    {
      "VOrder": 28,
      "Position": "Comment",
      "Text": "۱۲- با مِتِش = با یارش."
    },
    {
      "VOrder": 29,
      "Position": "Comment",
      "Text": "۱۳- بَشه = باشد."
    },
    {
      "VOrder": 30,
      "Position": "Comment",
      "Text": "۱۴- مِذِره = می‌داره، می‌گذارد."
