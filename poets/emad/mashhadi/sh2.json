    {
      "VOrder": 19,
      "Position": "Comment",
      "Text": "واژه‌نامه:"
    },
    {
      "VOrder": 20,
      "Position": "Comment",
      "Text": "۱- مو = من."
    },
    {
      "VOrder": 21,
      "Position": "Comment",
      "Text": "۲- خنه = خانه."
    },
    {
      "VOrder": 22,
      "Position": "Comment",
      "Text": "۳- کلیمه = کلمه."
    },
    {
      "VOrder": 23,
      "Position": "Comment",
      "Text": "۴- بگم = بگویم."
    },
    {
      "VOrder": 24,
      "Position": "Comment",
      "Text": "۵- ایساخ = این‌گونه."
    },
    {
      "VOrder": 25,
      "Position": "Comment",
      "Text": "۶- لکه = به هم فشرده، کوچک."
    },
    {
      "VOrder": 26,
      "Position": "Comment",
      "Text": "۷- مرسه = می‌رسد."
    },
    {
      "VOrder": 27,
      "Position": "Comment",
      "Text": "۸- مزه = می‌گذرد، می‌شود."
    },
    {
      "VOrder": 28,
      "Position": "Comment",
      "Text": "۹- شنه = شانه."
    },
    {
      "VOrder": 29,
      "Position": "Comment",
      "Text": "۱۰- هروخ = هروقت."
    },
    {
      "VOrder": 30,
      "Position": "Comment",
      "Text": "۱۱- لاغلاغو = ماهی‌تابه."
    },
    {
      "VOrder": 31,
      "Position": "Comment",
      "Text": "۱۲- بزو = به او."
    },
    {
      "VOrder": 32,
      "Position": "Comment",
      "Text": "۱۳- دلنگونه = آویزان است."
    }
