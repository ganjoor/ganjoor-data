      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Comment",
      "Text": "واژه‌نامه:"
    },
    {
      "VOrder": 20,
      "Position": "Comment",
      "Text": "۱- یره‌گه = عزیزم، جانم."
    },
    {
      "VOrder": 21,
      "Position": "Comment",
      "Text": "۲- ایَم = این هم."
    },
    {
      "VOrder": 22,
      "Position": "Comment",
      "Text": "۳- بقی = بقیه، دیگران."
    },
    {
      "VOrder": 23,
      "Position": "Comment",
      "Text": "۴- دِرِة = داره، دارد."
    },
    {
      "VOrder": 24,
      "Position": "Comment",
      "Text": "۵- چن = چند."
    },
    {
      "VOrder": 25,
      "Position": "Comment",
      "Text": "۶- بَهنِه‌ی = بهانه."
    },
    {
      "VOrder": 26,
      "Position": "Comment",
      "Text": "۷- مودوَرم = می‌دوزم."
    },
    {
      "VOrder": 27,
      "Position": "Comment",
      "Text": "۸- صبحه = صبح."
    },
    {
      "VOrder": 28,
      "Position": "Comment",
      "Text": "۹- چخت = سقف."
    },
    {
      "VOrder": 29,
      "Position": "Comment",
      "Text": "۱۰- سم = سمت، سو."
    },
    {
      "VOrder": 30,
      "Position": "Comment",
      "Text": "۱۱- ممنه = میمانه، می‌ماند."
    },
    {
      "VOrder": 31,
      "Position": "Comment",
      "Text": "۱۲- جل = وول."
    },
    {
      "VOrder": 32,
      "Position": "Comment",
      "Text": "۱۳- مزنم = می‌زنم."
    },
    {
      "VOrder": 33,
      "Position": "Comment",
      "Text": "۱۴- نمیه = نمی‌آید."
    },
    {
      "VOrder": 34,
      "Position": "Comment",
      "Text": "۱۵- موگومش = می‌گویمش، میگمش."
    },
    {
      "VOrder": 35,
      "Position": "Comment",
      "Text": "۱۶- نِمِگه = نمیگه، نمی‌گوید."
    },
    {
      "VOrder": 36,
      "Position": "Comment",
      "Text": "۱۷- مِزِنه = می‌زند."
    },
    {
      "VOrder": 37,
      "Position": "Comment",
      "Text": "۱۸- مُویه = منه، من هست."
    },
    {
      "VOrder": 38,
      "Position": "Comment",
      "Text": "۱۹- مِکِنه = می‌کند."
    },
    {
      "VOrder": 39,
      "Position": "Comment",
      "Text": "۲۰- اوبه = او هست."
    },
    {
      "VOrder": 40,
      "Position": "Comment",
      "Text": "۲۱- پوشتشه = پشتش را."
    },
    {
      "VOrder": 41,
      "Position": "Comment",
      "Text": "۲۲- کتا = کوتاه."
    }
