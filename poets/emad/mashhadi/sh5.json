      "Position": "Comment",
      "Text": "۱- واز = دوباره."
    },
    {
      "VOrder": 21,
      "Position": "Comment",
      "Text": "۲- ای وار = این‌بار، این مرتبه."
    },
    {
      "VOrder": 22,
      "Position": "Comment",
      "Text": "۳- کوشتی = کشتی."
    },
    {
      "VOrder": 23,
      "Position": "Comment",
      "Text": "۴- خَنَه = خانه."
    },
    {
      "VOrder": 24,
      "Position": "Comment",
      "Text": "۵- مشد = مشهد."
    },
    {
      "VOrder": 25,
      "Position": "Comment",
      "Text": "۶- ورخیز = برخیز، پاشو."
    },
    {
      "VOrder": 26,
      "Position": "Comment",
      "Text": "۷- یره‌گه = عزیزم، جانم، یارم."
    },
    {
      "VOrder": 27,
      "Position": "Comment",
      "Text": "۸- اوسنه = افسانه."
    },
    {
      "VOrder": 28,
      "Position": "Comment",
      "Text": "۹- دِرُم = دارم."
    },
    {
      "VOrder": 29,
      "Position": "Comment",
      "Text": "۱۰- جهندم = جهنم."
    },
    {
      "VOrder": 30,
      "Position": "Comment",
      "Text": "۱۱- پوک = سر و صدا."
    },
    {
      "VOrder": 31,
      "Position": "Comment",
      "Text": "۱۲- نِمتِنه = نمی‌تواند."
    },
    {
      "VOrder": 32,
      "Position": "Comment",
      "Text": "۱۳- موکوشه = می‌کشد."
    },
    {
      "VOrder": 33,
      "Position": "Comment",
      "Text": "۱۴- ای ساخ = این‌طور."
    },
