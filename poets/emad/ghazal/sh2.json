      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "ما را وجود مِی شد و تشخیص می‌دهند",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
