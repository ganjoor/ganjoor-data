      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "بیچاره آن دلی که شود مبتلای عشق",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
