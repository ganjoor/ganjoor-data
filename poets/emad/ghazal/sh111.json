    {
      "VOrder": 1,
      "Position": "Comment",
      "Text": "در رثای نازنین از دست رفته"
    },
    {
      "VOrder": 2,
      "Position": "Comment",
      "Text": "زنده‌یاد مهدی اخوان‌ثالث م - امید"
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ز سفر نامده رفتی به سفر بار دگر",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "سفری کش نبود دولت دیدار دگر",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "حیف رفتی و ندیدم رخ دلجوی تو را",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "کی توان دید چو تو یار دگر، بار دگر",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "پرکشیدی به سوی توس و نگفتی که به ری",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "چه کند کُنج قفس بی تو گرفتار دگر",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "چیست این مرگ که چون مرد در این پردهٔ هول",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "رفت، عنوان دگر باید و مقدار دگر",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "تن بی‌جان ز چه قدرش شود از زنده فزون",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "سردی گور دهد گرمی بازار دگر",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "این چه رازی است که اندیشه به گردش نرسد",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "خاک در خاک رود باز به تکرار دگر",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "ور کسی خواست کز این رشته گره بگشاید",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "سرّی افزود به اسرار ز پندار دگر",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "«هر دم از درد بنالم که فلک هر ساعت",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "کندم قصد دل زار به آزار دگر»",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "«باز گویم نه در این مرحله حافظ تنهاست",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "غرقه گشتند در این بادیه بسیار دگر»",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "ارغنون ساز فلک، راهزن اهل هنر",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "ارغنون ساز مرا برد به گلزار دگر",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "ای گل آتش شب‌های زمستان عماد",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "ماند جاوید ز داغ تو به دل خار دگر",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
