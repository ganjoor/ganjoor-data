      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "تا از این خواب نسازند دگر بیدارم",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
