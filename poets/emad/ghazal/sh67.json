      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "در چمنزار تو چون آهوی وحشی بچرند",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
