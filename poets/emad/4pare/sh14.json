  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "قطع کردند برق ما را باز",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "که خدا قطع عیششان مکناد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "گرچه تاریک گشته کلبهٔ ما",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "خانهٔ برقیان فروزان باد",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 5,
      "Position": "CenteredVerse1",
      "Text": "",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "قطع کردند برق ما را باز",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "چون ندادم وجوه آن دو سه ماه",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "کاهلی هم نبوده بی‌تأثیر",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "مفلسی بوده گرچه اصل گناه",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 10,
      "Position": "CenteredVerse1",
      "Text": "",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "بارها قطع و وصل شد این برق",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "گر نوشتم که «باز» باشد راست",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "گرچه گویند فقر نیست گناه",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "نکنی باور این سخن که خطاست",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 15,
      "Position": "CenteredVerse1",
      "Text": "",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "بس گنه‌ها ز فقر می‌زاید",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "امتحان را دو شب گرسنه بمان",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "تا نه دانش بماندت نی دین",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "نه امام و پیغمبر و یزدان",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 20,
      "Position": "CenteredVerse1",
      "Text": "",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "این غرض روشن است و دیگر نیست",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "احتیاجی به حجّت آوردن",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "غنچه‌ای را دو روز آب مده",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "بنگرش نرم نرم پژمردن",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 25,
      "Position": "CenteredVerse1",
      "Text": "",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "آن که را هست آب و ملکی چند",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "چه نیازش که نغز گوید و راست",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "همه گویند: وای از این همه علم",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "گر مثل گفت: دوغ هست ز ماست",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 30,
      "Position": "CenteredVerse1",
      "Text": "",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "آستین کهنه‌ای چو من به مثل",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "گر غزل همچو خواجه ساز کند",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "از پی رایگان شنیدن آن",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "خواجه با پشت چشم ناز کند",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 35,
      "Position": "CenteredVerse1",
      "Text": "",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "با چنین خلق زندگی کردن",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "نیست جز رنج‌های روح‌گداز",
