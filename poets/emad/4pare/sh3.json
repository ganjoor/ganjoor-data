  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "حیف است با جوانیِ کوته چو شام وصل",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "بار دگر وفای تو را امتحان کنم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "با بی‌وفاتر از تو کسی گر شوم دچار",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "بهتر که باز یاد تو نامهربان کنم",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 5,
      "Position": "CenteredVerse1",
      "Text": "",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "پیچیده در حریر فراموشی این خیال",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "ای خفته بر سریر هوس خواب دیده‌ای",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "گر باز در چمن من و خود را خموش و مست",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "در نور جاودانه مهتاب دیده‌ای",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 10,
      "Position": "CenteredVerse1",
      "Text": "",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "آری شگفت بلهوسا خواب بوده است",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "گر باز دیده‌ای من و خود در کنار هم",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "آن باغ دلگشا که تو دیدی شبی بسوخت",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "دیگر نمی‌کشیم در آن انتظار هم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 15,
      "Position": "CenteredVerse1",
      "Text": "",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "چشمان پر فروغ تو دیگر ز یاد رفت",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "ابری سیاه آمد و گم شد ستاره‌ها",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "آمیخت یاد سینه‌ی پرتو فشان تو",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "در آسمان خاطره با ابرپاره‌ها",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 20,
      "Position": "CenteredVerse1",
      "Text": "",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "دیریست خفته در دل سرد فرامشی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "آن نغمه‌ای که ساخت سرانگشت آرزو",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "نشکسته دست خویش به گردن دگر مبند",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "ای بیمناک برق، ز طوفان سخن مگو",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 25,
      "Position": "CenteredVerse1",
      "Text": "",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "من عاشق خیال دل‌آرای خود شدم",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "این‌قدر هم گمان نکنی زود باورم",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "من مست جام خویشم و سرگرم ساز خویش",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "چندان نیاز نیست به دمساز دیگرم",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 30,
      "Position": "CenteredVerse1",
      "Text": "",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "آیینهٔ جمال دل‌آرای خویش را",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "کز بازتاب پرتو صبح امید و راز",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "می‌کرد خیره دیده‌ٔ زیباپرست من",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "بشکسته‌ای و بیهده گردیده چاره‌ساز",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 35,
      "Position": "CenteredVerse1",
      "Text": "",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "از من جواب خواسته‌ای، بشنو: این جواب",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "دیگر دروغ‌های تو باور نمی‌کنم",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "صد نامه هم اگر بنویسی سخن یکیست",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "«گفتم کنایتی و مکرر نمی‌کنم»",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
