  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "شامگاهی تیره چندی پیش دیدم دخترت را",
      "CoupletIndex": 0,
      "SectionIndex1": 17,
      "SectionIndex2": 19
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "دخترت را، آه آری دختر بی‌مادرت را",
      "CoupletIndex": 0,
      "SectionIndex1": 17,
      "SectionIndex2": 19
    },
    {
      "VOrder": 3,
      "Position": "Single",
      "Text": "چشمن از چشم سیاهت داشت محزون یادگاری",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Right",
      "Text": "دیدمش از دور و چون گشتم از این دیدن ندانم",
      "CoupletIndex": 2,
      "SectionIndex1": 17,
      "SectionIndex2": 20
    },
    {
      "VOrder": 5,
      "Position": "Left",
      "Text": "سوخت عقلم، سوخت صبرم، سوخت جسمم، سوخت جانم",
      "CoupletIndex": 2,
      "SectionIndex1": 17,
      "SectionIndex2": 20
    },
    {
      "VOrder": 6,
      "Position": "Single",
      "Text": "باز سر تا پا وجودم سوخت از دیگر شراری",
      "CoupletIndex": 3,
      "SectionIndex1": 1
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "باز دست حسرت و غم چنگ زد بر دامن دل",
      "CoupletIndex": 4,
      "SectionIndex1": 17,
      "SectionIndex2": 21
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "سوخت از برق نگاهش ریشهٔ جان، خرمن دل",
      "CoupletIndex": 4,
      "SectionIndex1": 17,
      "SectionIndex2": 21
    },
    {
      "VOrder": 9,
      "Position": "Single",
      "Text": "باز اشکی، بر رخ زردی، روان شد از کناری",
      "CoupletIndex": 5,
      "SectionIndex1": 2
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "گفته بودم با تو روزی، زلف کوته نیست زیبا",
      "CoupletIndex": 6,
      "SectionIndex1": 17,
      "SectionIndex2": 22
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "بعد از آن کوته نکردی گیسوی خود را و او را",
      "CoupletIndex": 6,
      "SectionIndex1": 17,
      "SectionIndex2": 22
    },
    {
      "VOrder": 12,
      "Position": "Single",
      "Text": "تا برای خاطر من کرده باشی باز کاری",
      "CoupletIndex": 7,
      "SectionIndex1": 3
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "گیسویش دیدم کمی از دوش پائین‌تر فتاده",
      "CoupletIndex": 8,
      "SectionIndex1": 17,
      "SectionIndex2": 23
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "لیک چون افکار تاریکم به یکدیگر فتاده",
      "CoupletIndex": 8,
      "SectionIndex1": 17,
      "SectionIndex2": 23
    },
    {
      "VOrder": 15,
      "Position": "Single",
      "Text": "کس به دقت شانه زلفش کی کند همچون تو آری",
      "CoupletIndex": 9,
      "SectionIndex1": 4
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "سر بگرداندم که دیگر طاقت دیدن نبودم",
      "CoupletIndex": 10,
      "SectionIndex1": 17,
      "SectionIndex2": 24
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "نام من با همرهش می‌گفت و نامی می‌شنودم",
      "CoupletIndex": 10,
      "SectionIndex1": 17,
      "SectionIndex2": 24
    },
    {
      "VOrder": 18,
      "Position": "Single",
      "Text": "نام مسکینی، سیه‌بختی، پریشان‌روزگاری",
      "CoupletIndex": 11,
      "SectionIndex1": 5
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "گرچه دل می‌خواست از این بیشتر رویش ببیند",
      "CoupletIndex": 12,
      "SectionIndex1": 17,
      "SectionIndex2": 25
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "بر سرش دستی کشد، خار غمش از دل بچیند",
      "CoupletIndex": 12,
      "SectionIndex1": 17,
      "SectionIndex2": 25
    },
    {
      "VOrder": 21,
      "Position": "Single",
      "Text": "لیک بدنامی چو من کی داشت اینسان اختیاری",
      "CoupletIndex": 13,
      "SectionIndex1": 6
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "چند گامی دور گشتم محشری در دل به‌پا شد",
      "CoupletIndex": 14,
      "SectionIndex1": 17,
      "SectionIndex2": 26
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "خود نمی‌دانم که دیگر با دلم آن شب چه‌ها شد",
      "CoupletIndex": 14,
      "SectionIndex1": 17,
      "SectionIndex2": 26
    },
    {
      "VOrder": 24,
      "Position": "Single",
      "Text": "ناگهان در گوشم آمد نالهٔ جانسوز تاری",
      "CoupletIndex": 15,
      "SectionIndex1": 7
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "ناله‌ای جانسوز و دل دیوانه‌کن، محزون و مبهم",
      "CoupletIndex": 16,
      "SectionIndex1": 17,
      "SectionIndex2": 27
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "در خلالش صد هزار افسانهٔ مغشوش و درهم",
      "CoupletIndex": 16,
      "SectionIndex1": 17,
      "SectionIndex2": 27
    },
    {
      "VOrder": 27,
      "Position": "Single",
      "Text": "ناله‌ای پر داستانی، نغمهٔ افسانه‌باری",
      "CoupletIndex": 17,
      "SectionIndex1": 8
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "از نوای تار شام تار عمرم تارتر شد",
      "CoupletIndex": 18,
      "SectionIndex1": 17,
      "SectionIndex2": 28
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "خاطرات، از بخت خواب‌آلوده‌ام بیدارتر شد",
      "CoupletIndex": 18,
      "SectionIndex1": 17,
      "SectionIndex2": 28
    },
    {
      "VOrder": 30,
      "Position": "Single",
      "Text": "گوئیا بربست دل با بی‌قراری‌ها قراری",
      "CoupletIndex": 19,
      "SectionIndex1": 9
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "یادم آمد روز و شب‌هائی که طی می‌شد به کویت",
      "CoupletIndex": 20,
      "SectionIndex1": 17,
      "SectionIndex2": 29
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "گرم عشق، مات لعلت، مست بویت، محو رویت",
      "CoupletIndex": 20,
      "SectionIndex1": 17,
      "SectionIndex2": 29
    },
    {
      "VOrder": 33,
      "Position": "Single",
      "Text": "محو آن روئی که بود از کار خلقت شاهکاری",
      "CoupletIndex": 21,
      "SectionIndex1": 10
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "با زبان شعر می‌گفتم تو را افسانهٔ خود",
      "CoupletIndex": 22,
      "SectionIndex1": 17,
      "SectionIndex2": 30
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "قصهٔ حال پریشان و دل دیوانهٔ خود",
      "CoupletIndex": 22,
      "SectionIndex1": 17,
      "SectionIndex2": 30
    },
    {
      "VOrder": 36,
      "Position": "Single",
      "Text": "با فغان دلفریبی، با نوای دل‌شکاری",
      "CoupletIndex": 23,
      "SectionIndex1": 11
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "با تو بودم رب‌نوع عشق و مستی، با تو بودم",
      "CoupletIndex": 24,
      "SectionIndex1": 17,
      "SectionIndex2": 31
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "با تو بودم ای گل کمیاب هستی، با تو بودم",
      "CoupletIndex": 24,
      "SectionIndex1": 17,
      "SectionIndex2": 31
    },
    {
      "VOrder": 39,
      "Position": "Single",
      "Text": "مغرب پائیز یکسان بود با صبح بهاری",
      "CoupletIndex": 25,
      "SectionIndex1": 12
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "زود رفتنی، زود رفتنی ای گل باغ امیدم",
      "CoupletIndex": 26,
      "SectionIndex1": 17,
      "SectionIndex2": 32
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "تازه می‌گفتم به دل من هم به دلداری رسیدم",
      "CoupletIndex": 26,
      "SectionIndex1": 17,
      "SectionIndex2": 32
    },
    {
      "VOrder": 42,
      "Position": "Single",
      "Text": "تازه باور کرده بودم در جهانم هست یاری",
      "CoupletIndex": 27,
      "SectionIndex1": 13
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "شد دگر بیهوده جانا جستجوی من، کجائی؟",
      "CoupletIndex": 28,
      "SectionIndex1": 17,
      "SectionIndex2": 33
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "آه ای خورشید چرخ آرزوی من کجائی؟",
      "CoupletIndex": 28,
      "SectionIndex1": 17,
      "SectionIndex2": 33
    },
    {
      "VOrder": 45,
      "Position": "Single",
      "Text": "تا تو رفتی تیره‌تر شد روزم از هر شام تاری",
      "CoupletIndex": 29,
      "SectionIndex1": 14
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "آرزویم گرچه بی‌جایست دارم آرزوئی",
      "CoupletIndex": 30,
      "SectionIndex1": 17,
      "SectionIndex2": 34
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "جستجویم گرچه بی‌سود است دارم جستجوئی",
      "CoupletIndex": 30,
      "SectionIndex1": 17,
      "SectionIndex2": 34
    },
    {
      "VOrder": 48,
      "Position": "Single",
      "Text": "انتظارم گرچه بیهوده است دارم انتظاری",
      "CoupletIndex": 31,
      "SectionIndex1": 15
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "باز هم گر می‌توانی گوشهٔ چشمی به ما کن",
      "CoupletIndex": 32,
      "SectionIndex1": 17,
      "SectionIndex2": 35
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "درد بی‌درمان روزافزون ما یک شب دو اکن",
      "CoupletIndex": 32,
      "SectionIndex1": 17,
      "SectionIndex2": 35
    },
    {
      "VOrder": 51,
      "Position": "Single",
      "Text": "تا برآیم زین قفس چون طایر امیدواری",
      "CoupletIndex": 33,
      "SectionIndex1": 16
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "کاش باشد ای گل بی‌خار من روزِ شماری",
      "CoupletIndex": 34,
      "SectionIndex1": 17,
      "SectionIndex2": 36
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "تا بیاویزد به دامان تو دیگر بار خاری",
      "CoupletIndex": 34,
      "SectionIndex1": 17,
      "SectionIndex2": 36
    },
    {
      "VOrder": 54,
      "Position": "Single",
      "Text": "تا به پایت اوفتد شوریده‌بخت شرمساری",
      "CoupletIndex": 35,
      "SectionIndex1": 17
    },
    {
      "VOrder": 55,
