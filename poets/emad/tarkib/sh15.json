      "Text": "در حیرت مات خود فرورفته",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Single",
      "Text": "تا دیدهٔ بازمانده‌ای یابد",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 34,
      "Position": "Single",
      "Text": "غم هر طرفی به جستجو رفته",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Single",
      "Text": "گیتی چو سیاهکار دیوی مست",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 36,
      "Position": "Single",
      "Text": "خاموش به خواب آرزو رفته",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Single",
      "Text": "وز رفتن ماه تا فراز کوه",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Single",
      "Text": "آن تودهٔ سایه‌روشن انبوه",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Single",
      "Text": "از زیر درخت‌ها کشیده قد",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Single",
      "Text": "گردیده، چو رشتهٔ هوس ممتد",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Single",
      "Text": "تا دشت از آن کنار جو رفته",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 42,
      "Position": "Single",
      "Text": "سرگوشی بید و نارون خاموش",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Single",
      "Text": "گلزار به خواب و مرغ شب مدهوش",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 44,
      "Position": "Single",
      "Text": "استاده نسیم و گفتگو رفته",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Single",
      "Text": "ناگاه پرم چو ماهی در شست",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 46,
      "Position": "Single",
      "Text": "از دامن خواب پرشکوهی مست",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Single",
      "Text": "پنداشته دامن وی اندر دست",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 48,
      "Position": "Single",
      "Text": "هر سوی کنم نگه که آیا هست؟",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Single",
      "Text": "بینم غم و درد مانده، او رفته",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 50,
      "Position": "Single",
      "Text": "شادی‌کش و چیره‌دست و پنهان‌گیر",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Single",
      "Text": "خصمی است مرا به نام تنهائی",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 52,
      "Position": "Single",
      "Text": "یادآور آن خدای زیبائی",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Single",
      "Text": "آن آفت عیش و کام و خودرائی",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 54,
      "Position": "Single",
      "Text": "آن آتش خرمن شکیبائی",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Comment",
      "Text": "مشهد اسفندماه ۱۳۲۹"
    }
  ]
}
