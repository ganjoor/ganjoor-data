      "VOrder": 17,
      "Position": "Single",
      "Text": "در باغ جَست از سر دیوار",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Single",
      "Text": "در جستجوی دزد پریشان",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Single",
      "Text": "آهسته سر کشید به هر سوی",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 20,
      "Position": "Single",
      "Text": "بگشود برگ و شاخهٔ اشجار",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Single",
      "Text": "گمگشته بود دزد فراری",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Single",
      "Text": "دیگر نداشت سود تکاپو",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Single",
      "Text": "برگشت پی قرار سوی دشت",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Single",
      "Text": "غمگین نسیم خسته و صبحش",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Single",
      "Text": "بنواخت با تبسم دلجو",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Single",
      "Text": "من گرم سیر این همه بازی",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Single",
      "Text": "از جام صبح و عشق و صفا مست",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 28,
      "Position": "Single",
      "Text": "با بال‌های شعر و جوانی",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Single",
      "Text": "بر هفتم آسمان تمنا",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 30,
      "Position": "Single",
      "Text": "بنهاده پای و رفته دل از دست",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Single",
      "Text": "بر طرف جویبار بزرگی",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 32,
      "Position": "Single",
      "Text": "در باغ آسمانی دلدار",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Single",
      "Text": "در کنار بیدهای موقر",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 34,
      "Position": "Single",
      "Text": "بر سبزه‌های خرم و خندان",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Single",
      "Text": "ره می‌روم شمرده و هموار",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 36,
      "Position": "Single",
      "Text": "در انتظار دیدن یارم",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Single",
      "Text": "آن شاهکارِ دلکش هستی",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Single",
      "Text": "آن سرو باغ عشق و جوانی",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Single",
      "Text": "آن نقش جاویدان دل و جان",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Single",
      "Text": "آن رب‌نوع هستی و مستی",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Single",
      "Text": "باید به گوشه‌ای بنشینم",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 42,
      "Position": "Single",
      "Text": "تا کس مرا به باغ نبیند",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Single",
      "Text": "شوقی مراست لیک که دیگر",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 44,
      "Position": "Single",
      "Text": "خواهم دمی ز پا ننشینم",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Single",
      "Text": "گر چرخ بر سرم بنشیند",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 46,
      "Position": "Single",
      "Text": "یک نقطه، یک سیاهی کمرنگ",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Single",
      "Text": "زان دوره‌ها به چشم درآمد",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 48,
      "Position": "Single",
      "Text": "در نور صبح و سایهٔ اشجار",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Single",
      "Text": "خورشید حسن و پرتو اقبال",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 50,
      "Position": "Single",
      "Text": "آهسته پیش و پیش‌تر آمد",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Single",
      "Text": "اندام دلفریب نگارم",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 52,
      "Position": "Single",
      "Text": "از انتهای باغ مه‌آلود",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Single",
      "Text": "در پردهٔ لطیف سحرگاه",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 54,
      "Position": "Single",
      "Text": "در جامه‌ای مفرح و گلرنگ",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Single",
      "Text": "چون کودکی ز دور عیان بود",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 56,
      "Position": "Single",
      "Text": "در زیر شاخه‌های اقاقی",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Single",
      "Text": "در خش خشی لطیف و فسونبار",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 58,
      "Position": "Single",
      "Text": "در گردنی ظریف و دل‌آویز",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Single",
      "Text": "شد حلقه دستی از سر مستی",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 60,
      "Position": "Single",
      "Text": "لرزان ز شوق و بادهٔ دیدار",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Single",
      "Text": "امروز هم منم که سحر را",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 62,
      "Position": "Single",
      "Text": "اینسان کنم فرسوده به افسوس",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Single",
      "Text": "از پردهٔ سرشک نظاره",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 64,
      "Position": "Single",
      "Text": "خم گشته‌ام به روی گذشته",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Single",
      "Text": "یعنی عصای پیریِ مأیوس",
      "CoupletIndex": 64,
      "SectionIndex1": 0
    },
    {
      "VOrder": 66,
      "Position": "Single",
      "Text": "امروز هم من که سحرگاه",
      "CoupletIndex": 65,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Single",
      "Text": "چونان دو رنگ ماری بیمار",
      "CoupletIndex": 66,
      "SectionIndex1": 0
    },
    {
      "VOrder": 68,
      "Position": "Single",
      "Text": "پیچد به گردن من و خواند",
      "CoupletIndex": 67,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Single",
      "Text": "در گوش جان فسانهٔ جانسوز",
      "CoupletIndex": 68,
      "SectionIndex1": 0
    },
    {
      "VOrder": 70,
      "Position": "Single",
      "Text": "زان روز و روزگار فسونبار",
      "CoupletIndex": 69,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Comment",
      "Text": "مشهد- نهم فروردین ماه ۱۳۳۰"
    }
  ]
}
