  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ای نازنین دردانه، ای جانانه جانم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "ای سود و سودایم، زمینم، آسمانم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ای دختر شب‌ها و دمساز نهانم",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "آرام جانم، هستی‌ام، ورد زبانم",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 5,
      "Position": "CenteredVerse1",
      "Text": "ای جان شیرینم، امیدم، آرزویم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 8
    },
    {
      "VOrder": 6,
      "Position": "CenteredVerse2",
      "Text": "زین پس دگر با تست وز تو گفتگویم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 8
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "دیشب که در مستی تو را هم‌راز گشتم",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "از هر رهی جز راه عشقت بازگشتم",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "ای قمری‌یک تا با تو هم‌آواز گشتم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "با عشق خفتم، با خدا دمساز گشتم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 11,
      "Position": "CenteredVerse1",
      "Text": "آری جهان دیگر برای من تویی تو",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 9
    },
    {
      "VOrder": 12,
      "Position": "CenteredVerse2",
      "Text": "گر با وفا باشی خدای من تویی تو",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 9
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "عمری درِ دل بر نکویان بسته بودم",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "از عشق، یعنی زندگی خسته بودم",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "در زندگی با مردگان پیوسته بودم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "پیمانهٔ امید را بشکسته بودم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 17,
      "Position": "CenteredVerse1",
      "Text": "آوخ مگر بی‌عشق و بی‌سودا توان زیست",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 10
    },
    {
      "VOrder": 18,
      "Position": "CenteredVerse2",
      "Text": "در این سیه دنیا مگر تنها توان زیست",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "با عشق و می چون زندگی دشوار باشد",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "بی‌این دو هستی دیو مردم‌خوار باشد",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "بی‌عشق از هستی دلم بیزار باشد",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "زندان و رنج و محنت و آزار باشد",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 23,
      "Position": "CenteredVerse1",
      "Text": "با گردش چشمی اگر گشت زمان نیست",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 11
    },
    {
      "VOrder": 24,
      "Position": "CenteredVerse2",
      "Text": "آزار جان بیدلان باشد، جهان نیست",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 11
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "امشب به یاد چشم تو ساغر گرفتم",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "من مرده بودم، زندگی از سر گرفتم",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "با یاد رویت جای در بستر گرفتم",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "با آرزویت سر ز بستر برگرفتم",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 29,
      "Position": "CenteredVerse1",
      "Text": "دیگر کشیدن بار هستی می‌توانم",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 12
    },
    {
      "VOrder": 30,
      "Position": "CenteredVerse2",
      "Text": "خوش آمدی، خوش آمدی، جانانه جانم",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 12
    }
