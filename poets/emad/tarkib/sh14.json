    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "آمیزد انتظار شکرخنده‌ات به شرم",
      "CoupletIndex": 21,
      "SectionIndex1": 8,
      "SectionIndex2": 24
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "خواهی که تا ز خویش بخوانم ترانه‌ای",
      "CoupletIndex": 22,
      "SectionIndex1": 8,
      "SectionIndex2": 25
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "آهسته لب گشایی و شاعر‌شکار و گرم",
      "CoupletIndex": 22,
      "SectionIndex1": 8,
      "SectionIndex2": 25
    },
    {
      "VOrder": 40,
      "Position": "Single",
      "Text": "چون نی فغان کشم به نوائی حزین و نرم",
      "CoupletIndex": 23,
      "SectionIndex1": 7
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "بس صبح‌ها دمید و بسی شام‌ها رسید",
      "CoupletIndex": 24,
      "SectionIndex1": 8,
      "SectionIndex2": 26
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "زین صبح دلفریب نرفته است رنگ و رو",
      "CoupletIndex": 24,
      "SectionIndex1": 8,
      "SectionIndex2": 26
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "با پیرهن به بازی و با من به گفتگو",
      "CoupletIndex": 25,
      "SectionIndex1": 8,
      "SectionIndex2": 27
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "با چهره‌ای گشاده‌تر از صبح آرزو",
      "CoupletIndex": 25,
      "SectionIndex1": 8,
      "SectionIndex2": 27
    },
    {
      "VOrder": 45,
      "Position": "Single",
      "Text": "بینم تو را نشسته هنوز آن کنار جو",
      "CoupletIndex": 26,
      "SectionIndex1": 8
    },
    {
      "VOrder": 46,
      "Position": "Comment",
      "Text": "اسفند ۱۳۲۹"
    }
  ]
