  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Comment",
      "Text": "مرگ بهتر که دوست در بر غیر"
    },
    {
      "VOrder": 2,
      "Position": "Comment",
      "Text": "مرگ بهتر که یار دور از یار"
    },
    {
      "VOrder": 3,
      "Position": "Single",
      "Text": "شب فروهشته بود چادر خویش",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Single",
      "Text": "چادر رازپوش افسونبار",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Single",
      "Text": "تارش از وهم و پودش از پندار",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Single",
      "Text": "خیمهٔ بهت و پردهٔ اسرار",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Single",
      "Text": "راه گم کرده بود گویی ماه",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Single",
      "Text": "در پس ابرهای تیره و تار",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Single",
      "Text": "شبهی در دل بیابانی",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Single",
      "Text": "راه می‌رفت یکه و تنها",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Single",
      "Text": "بر کمر بسته بود نان جوی",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Single",
      "Text": "چوبی اندر کفش به جای عصا",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Single",
      "Text": "دشنه‌ای جای داده زیر قبا",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Single",
      "Text": "خرد می‌کرد و می‌گذشت ز دشت",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Single",
      "Text": "کفش‌هائی بزرگ و ناهنجار",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Single",
      "Text": "در سر راه خویش هر خس و خار",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Single",
      "Text": "راه می‌رفت گرم و بی‌تردید",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Single",
      "Text": "اندر آن شام تار «شاه‌غلام»",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Single",
      "Text": "تک و تنها میان ظلمت دشت",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 20,
      "Position": "Single",
      "Text": "سایه‌ای هم نبود همراهش",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Single",
      "Text": "بس شب افشانده بود گرد ظلام",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Single",
      "Text": "شعله‌ای چند، کورسوی زنان",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Single",
      "Text": "بود از خانه‌های ده پیدا",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Single",
      "Text": "ده «گُر»، جای ثانی زهرا",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Single",
      "Text": "راه می‌رفت گرم و بی‌تردید",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Single",
      "Text": "در دل تنگش آتش مرموز",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Single",
      "Text": "آتشی جانگداز و طاقت‌سوز",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 28,
      "Position": "Single",
      "Text": "گیسوی یار بود در کف غیر",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Single",
      "Text": "وای بر او که زنده بود هنوز",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 30,
      "Position": "Single",
      "Text": "هست این سومین شبی که غلام",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Single",
      "Text": "گشته از هرچه در جهان نومید",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 32,
      "Position": "Single",
      "Text": "این سه شب راستی چه‌ها که کشید",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Single",
      "Text": "او به دختر عموی زیبایش",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 34,
      "Position": "Single",
      "Text": "از همان دور کودکی دل داد",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Single",
      "Text": "گفت زهرا، چو لب به حرف گشاد",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 36,
      "Position": "Single",
      "Text": "تا که بگشاد چشم، زهرا دید",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Single",
      "Text": "دیده‌اش پر جمال او افتاد",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Single",
      "Text": "چه بسا روزها که بر تل و کوه",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Single",
      "Text": "چه بسا شام‌ها که در دل دشت",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Single",
      "Text": "با مه نازنین خود می‌گشت",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Single",
      "Text": "آه آن روزها گذشت، گذشت",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 42,
      "Position": "Single",
      "Text": "یاد آن روزها که با گل خویش",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Single",
      "Text": "خوش و خندان میان صحرا بود",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 44,
      "Position": "Single",
      "Text": "یاد آن شام‌ها که در کف او",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Single",
      "Text": "طرهٔ پر شکنج زهرا بود",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 46,
      "Position": "Single",
      "Text": "یاد آن روزها که بر لب جوی",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Single",
      "Text": "با گل ناز خویش تنها بود",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 48,
      "Position": "Single",
      "Text": "یاد آن شب که عکس ماه در آب",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Single",
      "Text": "بود و نقشی شگرف و زیبا بود",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 50,
      "Position": "Single",
      "Text": "گرچه زهرا بدان اشارت کرد",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Single",
      "Text": "دیده نگرفت از آن جمال، غلام",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 52,
      "Position": "Single",
      "Text": "با تماشای آن به از گل و ماه",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Single",
      "Text": "راستی ماه بی‌تماشا بود",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 54,
      "Position": "Single",
      "Text": "راه می‌رفت و یاد می‌آورد",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Single",
      "Text": "لحظاتی که رفته بود ز دست",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 56,
      "Position": "Single",
      "Text": "جام عیشی که روزگار شکست",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Single",
      "Text": "رشتهٔ الفتی که چرخ گسست",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 58,
      "Position": "Single",
      "Text": "یادش آمد ز اولین بوسه",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Single",
      "Text": "یادش آمد ز اولین اظهار",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 60,
      "Position": "Single",
      "Text": "یادش آمد ز آخرین دیدار",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Single",
      "Text": "هر دمش خون به جوش می‌آمد",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 62,
      "Position": "Single",
      "Text": "هستی‌اش در خروش می‌آمد",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Single",
      "Text": "چار مه می‌گذشت از آن شب قدر",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 64,
      "Position": "Single",
      "Text": "که درآمد به عقد او دلدار",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Single",
      "Text": "آن پریچهر شوخ شیرین‌کار",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 66,
      "Position": "Single",
      "Text": "آن شکربار لعل گندم‌گون",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Single",
      "Text": "آن دلارا نگار افسونکار",
      "CoupletIndex": 64,
      "SectionIndex1": 0
    },
    {
      "VOrder": 68,
      "Position": "Single",
      "Text": "آوخ آوخ چه شد که در یک دم",
      "CoupletIndex": 65,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Single",
      "Text": "کاخ امید و آرزویش سوخت",
      "CoupletIndex": 66,
      "SectionIndex1": 0
    },
    {
      "VOrder": 70,
      "Position": "Single",
      "Text": "آه، این شعله از کجا افروخت؟",
      "CoupletIndex": 67,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Single",
      "Text": "سوخت کاخ امید او گردون",
      "CoupletIndex": 68,
      "SectionIndex1": 0
    },
    {
      "VOrder": 72,
      "Position": "Single",
      "Text": "هستی‌اش را به رایگان بفروخت",
      "CoupletIndex": 69,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Single",
      "Text": "داستانی شگفت پیش آمد",
      "CoupletIndex": 70,
      "SectionIndex1": 0
    },
    {
      "VOrder": 74,
      "Position": "Single",
      "Text": "ماجرائی که عقل حیران ماند",
      "CoupletIndex": 71,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Single",
      "Text": "رفته بود آب آورد زهرا",
      "CoupletIndex": 72,
      "SectionIndex1": 0
    },
    {
      "VOrder": 76,
      "Position": "Single",
      "Text": "اسبی از دور گرد می‌افشاند",
      "CoupletIndex": 73,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Single",
      "Text": "خان ده «گر» رسید و او را دید",
      "CoupletIndex": 74,
      "SectionIndex1": 0
    },
    {
      "VOrder": 78,
      "Position": "Single",
      "Text": "اسب خود سوی دخترک گرداند",
      "CoupletIndex": 75,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Single",
      "Text": "جست پایین ز اسب و زهرا را",
      "CoupletIndex": 76,
      "SectionIndex1": 0
    },
    {
      "VOrder": 80,
      "Position": "Single",
      "Text": "بگرفت و به ترک خویش نشاند",
      "CoupletIndex": 77,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Single",
      "Text": "تا که آمد به خویشتن زهرا",
      "CoupletIndex": 78,
      "SectionIndex1": 0
    },
    {
      "VOrder": 82,
      "Position": "Single",
      "Text": "پیش از آنی که برکشد فریاد",
      "CoupletIndex": 79,
      "SectionIndex1": 0
    },
    {
      "VOrder": 83,
      "Position": "Single",
      "Text": "اسب سرکش برفت همچون باد",
      "CoupletIndex": 80,
      "SectionIndex1": 0
    },
    {
      "VOrder": 84,
      "Position": "Single",
      "Text": "به همین سادگی، به چالاکی",
      "CoupletIndex": 81,
      "SectionIndex1": 0
    },
    {
      "VOrder": 85,
      "Position": "Single",
      "Text": "خان ده «گر» ربود یار غلام",
      "CoupletIndex": 82,
      "SectionIndex1": 0
    },
    {
      "VOrder": 86,
      "Position": "Single",
      "Text": "آنکه چندین تفنگ «برنو» داشت",
      "CoupletIndex": 83,
      "SectionIndex1": 0
    },
    {
      "VOrder": 87,
      "Position": "Single",
      "Text": "آنکه بود او ز دزدهای بنام",
      "CoupletIndex": 84,
      "SectionIndex1": 0
    },
    {
      "VOrder": 88,
      "Position": "Single",
      "Text": "شب فروهشته بود چادر خویش",
      "CoupletIndex": 85,
      "SectionIndex1": 0
    },
    {
      "VOrder": 89,
      "Position": "Single",
      "Text": "چادر رازپوش افسونبار",
      "CoupletIndex": 86,
      "SectionIndex1": 0
    },
    {
      "VOrder": 90,
      "Position": "Single",
      "Text": "تارش از وهم و پودش از پندار",
      "CoupletIndex": 87,
      "SectionIndex1": 0
    },
    {
      "VOrder": 91,
      "Position": "Single",
      "Text": "رهرو ما به ده رسید و نشست",
      "CoupletIndex": 88,
      "SectionIndex1": 0
    },
    {
      "VOrder": 92,
      "Position": "Single",
      "Text": "لحظه‌ای در کنار یک دیوار",
      "CoupletIndex": 89,
      "SectionIndex1": 0
    },
    {
      "VOrder": 93,
      "Position": "Single",
      "Text": "پای جوئی بزرگ و زمزمه‌ساز",
      "CoupletIndex": 90,
      "SectionIndex1": 0
    },
    {
      "VOrder": 94,
      "Position": "Single",
      "Text": "چند مشتی زد آب بر رخسار",
      "CoupletIndex": 91,
      "SectionIndex1": 0
    },
    {
      "VOrder": 95,
      "Position": "Single",
      "Text": "کوچه‌باغی گرفت و شد سوی ده",
      "CoupletIndex": 92,
      "SectionIndex1": 0
    },
    {
      "VOrder": 96,
      "Position": "Single",
      "Text": "دستهٔ دشنه را فشاری داد",
      "CoupletIndex": 93,
      "SectionIndex1": 0
    },
    {
      "VOrder": 97,
      "Position": "Single",
      "Text": "شال از سر گرفت و باز نهاد",
      "CoupletIndex": 94,
      "SectionIndex1": 0
    },
    {
      "VOrder": 98,
      "Position": "Single",
      "Text": "شد ز دیوار باغ خان بالا",
      "CoupletIndex": 95,
      "SectionIndex1": 0
    },
    {
      "VOrder": 99,
      "Position": "Single",
      "Text": "نرم و آهسته، لیک بی‌پروا",
      "CoupletIndex": 96,
      "SectionIndex1": 0
    },
    {
      "VOrder": 100,
      "Position": "Single",
      "Text": "خورده بود انتقام پروایش",
      "CoupletIndex": 97,
      "SectionIndex1": 0
    },
    {
      "VOrder": 101,
      "Position": "Single",
      "Text": "بود آن نوجوان عاشق را",
      "CoupletIndex": 98,
      "SectionIndex1": 0
    },
    {
      "VOrder": 102,
      "Position": "Single",
      "Text": "هرچه جز انتقام بی‌معنا",
      "CoupletIndex": 99,
      "SectionIndex1": 0
    },
    {
      "VOrder": 103,
      "Position": "Single",
      "Text": "باغ آرام بود و تیره و تار",
      "CoupletIndex": 100,
      "SectionIndex1": 0
    },
    {
      "VOrder": 104,
      "Position": "Single",
      "Text": "وندر آن برگ هم نمی‌جنید",
      "CoupletIndex": 101,
      "SectionIndex1": 0
    },
    {
      "VOrder": 105,
      "Position": "Single",
      "Text": "کورسوی چراغی از سوئی",
      "CoupletIndex": 102,
      "SectionIndex1": 0
    },
    {
      "VOrder": 106,
      "Position": "Single",
      "Text": "جانب خود غلام را بکشید",
      "CoupletIndex": 103,
      "SectionIndex1": 0
    },
    {
      "VOrder": 107,
      "Position": "Single",
      "Text": "اسب خان بسته بود یک گوشه",
      "CoupletIndex": 104,
      "SectionIndex1": 0
    },
    {
      "VOrder": 108,
      "Position": "Single",
      "Text": "همه سر تا دمش چو برف سفید",
      "CoupletIndex": 105,
      "SectionIndex1": 0
    },
    {
      "VOrder": 109,
      "Position": "Single",
      "Text": "شیهه‌ای برکشید و شاه غلام",
      "CoupletIndex": 106,
      "SectionIndex1": 0
    },
    {
      "VOrder": 110,
      "Position": "Single",
      "Text": "لحظه‌ای چند ماند در تردید",
      "CoupletIndex": 107,
      "SectionIndex1": 0
    },
    {
      "VOrder": 111,
      "Position": "Single",
      "Text": "عاقبت رفت و زین و برگش کرد",
      "CoupletIndex": 108,
      "SectionIndex1": 0
    },
    {
      "VOrder": 112,
      "Position": "Single",
      "Text": "پی افسار لحظه‌ای گردید",
      "CoupletIndex": 109,
      "SectionIndex1": 0
    },
    {
      "VOrder": 113,
      "Position": "Single",
      "Text": "جُست آخر لگام و زد به سرش",
      "CoupletIndex": 110,
      "SectionIndex1": 0
    },
    {
      "VOrder": 114,
      "Position": "Single",
      "Text": "با دلی گرمِِ انتقام و امید",
      "CoupletIndex": 111,
      "SectionIndex1": 0
    },
    {
      "VOrder": 115,
      "Position": "Single",
      "Text": "رفت آن سو که کورسوی چراغ",
      "CoupletIndex": 112,
      "SectionIndex1": 0
    },
    {
      "VOrder": 116,
      "Position": "Single",
      "Text": "لرز، لرزان ز دور پیدا بود",
      "CoupletIndex": 113,
      "SectionIndex1": 0
    },
    {
      "VOrder": 117,
      "Position": "Single",
      "Text": "رفته بودند جملگی در خواب",
      "CoupletIndex": 114,
      "SectionIndex1": 0
    },
    {
      "VOrder": 118,
      "Position": "Single",
      "Text": "آنکه بیدار بود، زهرا بود",
      "CoupletIndex": 115,
      "SectionIndex1": 0
    },
    {
      "VOrder": 119,
      "Position": "Single",
      "Text": "چهره‌اش زیر آن شمع ضعیف",
      "CoupletIndex": 116,
      "SectionIndex1": 0
    },
    {
      "VOrder": 120,
      "Position": "Single",
      "Text": "بیش از همیشه زیبا بود",
      "CoupletIndex": 117,
      "SectionIndex1": 0
    },
    {
      "VOrder": 121,
      "Position": "Single",
      "Text": "گرچه پیشانی شکستهٔ او",
      "CoupletIndex": 118,
      "SectionIndex1": 0
    },
    {
      "VOrder": 122,
      "Position": "Single",
      "Text": "حاکی از جور خان والا بود",
      "CoupletIndex": 119,
      "SectionIndex1": 0
    },
    {
      "VOrder": 123,
      "Position": "Single",
      "Text": "گونه‌اش گرچه بود خون‌آلود",
      "CoupletIndex": 120,
      "SectionIndex1": 0
    },
    {
      "VOrder": 124,
      "Position": "Single",
      "Text": "نگهش گرچه روح‌فرسا بود",
      "CoupletIndex": 121,
      "SectionIndex1": 0
    },
    {
      "VOrder": 125,
      "Position": "Single",
      "Text": "باز هم هرچه بود در رخ او",
      "CoupletIndex": 122,
      "SectionIndex1": 0
    },
    {
      "VOrder": 126,
      "Position": "Single",
      "Text": "حالتی از قیاس بالا بود",
      "CoupletIndex": 123,
      "SectionIndex1": 0
    },
    {
      "VOrder": 127,
      "Position": "Single",
      "Text": "نرم، ناخن‌ها به در نواخت غلام",
      "CoupletIndex": 124,
      "SectionIndex1": 0
    },
    {
      "VOrder": 128,
      "Position": "Single",
      "Text": "خورد زهرا تکان و سر برداشت",
      "CoupletIndex": 125,
      "SectionIndex1": 0
    },
    {
      "VOrder": 129,
      "Position": "Single",
      "Text": "ریخت بر سینه زلف پُرشکنش",
      "CoupletIndex": 126,
      "SectionIndex1": 0
    },
    {
      "VOrder": 130,
      "Position": "Single",
      "Text": "لرزشی اوفتاد بر بدنش",
      "CoupletIndex": 127,
      "SectionIndex1": 0
    },
    {
      "VOrder": 131,
      "Position": "Single",
      "Text": "جست از جا و عقل و هوش گماشت",
      "CoupletIndex": 128,
      "SectionIndex1": 0
    },
    {
      "VOrder": 132,
      "Position": "Single",
      "Text": "دید چیزی که خواب می‌پنداشت",
      "CoupletIndex": 129,
      "SectionIndex1": 0
    },
    {
      "VOrder": 133,
      "Position": "Single",
      "Text": "دست دلدار را کشید غلام",
      "CoupletIndex": 130,
      "SectionIndex1": 0
    },
    {
      "VOrder": 134,
      "Position": "Single",
      "Text": "برد و بر اسب خان سوارش کرد",
      "CoupletIndex": 131,
      "SectionIndex1": 0
    },
    {
      "VOrder": 135,
      "Position": "Single",
      "Text": "در منزل گشود و دشنهٔ خویش",
      "CoupletIndex": 132,
      "SectionIndex1": 0
    },
    {
      "VOrder": 136,
      "Position": "Single",
      "Text": "از میان قبا برون آورد",
      "CoupletIndex": 133,
      "SectionIndex1": 0
    },
    {
      "VOrder": 137,
      "Position": "Single",
      "Text": "کرد زهرا یقین که شاه غلام",
      "CoupletIndex": 134,
      "SectionIndex1": 0
    },
    {
      "VOrder": 138,
      "Position": "Single",
      "Text": "می‌رود کار خان تمام کند",
      "CoupletIndex": 135,
      "SectionIndex1": 0
    },
    {
      "VOrder": 139,
      "Position": "Single",
      "Text": "سال‌ها خورد و خواب و آسایش",
      "CoupletIndex": 136,
      "SectionIndex1": 0
    },
    {
      "VOrder": 140,
      "Position": "Single",
      "Text": "بر خود و دیگران حرام کند",
      "CoupletIndex": 137,
      "SectionIndex1": 0
    },
    {
      "VOrder": 141,
      "Position": "Single",
      "Text": "هرچه زهرا کشید دامن او",
      "CoupletIndex": 138,
      "SectionIndex1": 0
    },
    {
      "VOrder": 142,
      "Position": "Single",
      "Text": "هرچه آهسته التماسش کرد",
      "CoupletIndex": 139,
      "SectionIndex1": 0
    },
    {
      "VOrder": 143,
      "Position": "Single",
      "Text": "هرچه گفتش: غلام جان برگرد،",
      "CoupletIndex": 140,
      "SectionIndex1": 0
    },
    {
      "VOrder": 144,
      "Position": "Single",
      "Text": "قصهٔ مشت بود و آهن سرد",
      "CoupletIndex": 141,
      "SectionIndex1": 0
    },
    {
      "VOrder": 145,
      "Position": "Single",
      "Text": "شب فروهشته بود چادر خویش",
      "CoupletIndex": 142,
      "SectionIndex1": 0
    },
    {
      "VOrder": 146,
      "Position": "Single",
      "Text": "چادر رازپوش افسونبار",
      "CoupletIndex": 143,
      "SectionIndex1": 0
    },
    {
      "VOrder": 147,
      "Position": "Single",
      "Text": "تارش از وهم و پودش از پندار",
      "CoupletIndex": 144,
      "SectionIndex1": 0
    },
