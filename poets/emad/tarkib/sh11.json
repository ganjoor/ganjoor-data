  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "نیمی از شب عمرم، طی نگشته شد خاموش،",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "شمع آرزوی من",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "جرعه‌ای نپیموده، زد سپهر سنگ‌انداز،",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "سنگ بر سبوی من",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "دست برده نابرده، خوان عمر را بگرفت،",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "لقمه در گلوی من",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 7,
      "Position": "CenteredVerse1",
      "Text": "هرچه می‌خورم باده، هرچه می‌کنم مستی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 9
    },
    {
      "VOrder": 8,
      "Position": "CenteredVerse2",
      "Text": "بینم ای غم جانکاه، باز در دلم هستی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 9
    },
    {
      "VOrder": 9,
      "Position": "CenteredVerse1",
      "Text": "این جوانی ما بود، تا چه زاید از پیری",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 10
    },
    {
      "VOrder": 10,
      "Position": "CenteredVerse2",
      "Text": "این بلندی ما بود، خاک بر سر پستی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 10
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "در میان حسرت‌ها، راه گلشنی جستم،",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "گلشنی تماشائی",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "رنگ عشق و هستی داشت، باغ لطف و مستی بود،",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "جلوه‌گاه زیبائی",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "خیره ماندم و حیرت، چنگ زد گریبانم،",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "زان همه دلارائی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 17,
      "Position": "CenteredVerse1",
      "Text": "تا دلم به خویش آمد، باغ شوره‌زاری بود",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 11
    },
    {
      "VOrder": 18,
      "Position": "CenteredVerse2",
      "Text": "زان همه نکوئی‌ها، کاش یادگاری بود",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 11
    },
    {
      "VOrder": 19,
      "Position": "CenteredVerse1",
      "Text": "آنچنان خزان بگرفت، حسن وی که شک بردم",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 12
    },
    {
      "VOrder": 20,
      "Position": "CenteredVerse2",
      "Text": "کاندرین چمن روزی، جلوهٔ بهاری بود",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 12
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "ای خدای زیبائی، ای خدای زیبائی،",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "وه چه سنگدل بودی",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "ای جهان بی‌معنی، ای جهان بی‌معنی،",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "جز غمم نیفزودی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "ای طبیعت نادان، ای طبیعت نادان،",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "جان من بفرسودی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 27,
      "Position": "CenteredVerse1",
      "Text": "ای ستمگر غافل، پشت صبر بشکستی",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 13
    },
    {
      "VOrder": 28,
      "Position": "CenteredVerse2",
      "Text": "رشتهٔ مرا با خویش، خویشتن چو بگسستی",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 13
    },
    {
      "VOrder": 29,
      "Position": "CenteredVerse1",
      "Text": "بلهوس چه می‌خواهی؟ از چو من پریشانی",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 14
    },
    {
      "VOrder": 30,
      "Position": "CenteredVerse2",
      "Text": "کودکی تو یا مستی؟ نیستی تو یا هستی؟",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 14
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "دل بهانه می‌گیرد، نازنین کجا رفتی؟",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "سوختم ز تنهائی",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "زین غمی که من دارم، بی‌تو عاقبت کارم،",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "می‌کشد به رسوائی",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "آفتاب عمر من، زود رخ نهان کردی،",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "از عماد سودائی",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 37,
      "Position": "CenteredVerse1",
      "Text": "چون تو دیگری باید تا دل از غم آساید",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 15
    },
    {
      "VOrder": 38,
      "Position": "CenteredVerse2",
      "Text": "لیک مادر گیتی، چون تو کی دگر زاید",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 15
    },
    {
      "VOrder": 39,
      "Position": "CenteredVerse1",
      "Text": "ای عروس احلامم، ای ونوس ناکامم",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 16
    },
    {
      "VOrder": 40,
      "Position": "CenteredVerse2",
      "Text": "می‌کنم عروسی‌ها، مرگ اگر زره آید",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 16
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "شیشه‌ای دگر بگشا، ای عماد سودانی،",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "لب ز گفتگو بربند",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "چون چنار آتش زن خویش را که چرخ پست،",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "بیخ آرزو برکند",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "بی‌امید و بی‌دلدار چاره چیست جز مستی،",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "شو به خودکشی خرسند",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 47,
      "Position": "CenteredVerse1",
      "Text": "ماهتاب زد برخیز، باز باده در خود ریز",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 17
    },
    {
      "VOrder": 48,
      "Position": "CenteredVerse2",
      "Text": "چاک زن گریبان را، مست در جنون آویز",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 17
    },
    {
      "VOrder": 49,
      "Position": "CenteredVerse1",
      "Text": "اشک ریز در ساغر، غم نگار در دفتر",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 18
    },
    {
      "VOrder": 50,
      "Position": "CenteredVerse2",
      "Text": "باز وصل و هجران را مست شو به هم آمیز",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 18
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "باز مست و دیوانه، سر به کوه و صحرا نه،",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "باز پاره کن زنجیر",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "باز در بیابانی نیمشب درآی از پای،",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "بیقرار و از جان سیر",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "باز در سکوت دشت دردناک و حزن‌انگیز،",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "این ترانه از سر گیر",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 57,
      "Position": "CenteredVerse1",
      "Text": "هرچه می‌خورم باده، هرچه می‌کنم مستی",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 19
    },
    {
      "VOrder": 58,
      "Position": "CenteredVerse2",
      "Text": "بینم ای غم جانکاه باز در دلم هستی",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 19
    },
    {
      "VOrder": 59,
      "Position": "CenteredVerse1",
      "Text": "این جوانی ما بود تا چه زاید از پیری",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 20
    },
    {
      "VOrder": 60,
      "Position": "CenteredVerse2",
      "Text": "این بلندی ما بود خاک بر سر پستی",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
