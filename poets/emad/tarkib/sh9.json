      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 45,
      "Position": "CenteredVerse1",
      "Text": "عاقبت گرچه رهائی است مرا زین دام",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 14
    },
    {
      "VOrder": 46,
      "Position": "CenteredVerse2",
      "Text": "می‌شود عمر تمام",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 14
    },
    {
      "VOrder": 47,
      "Position": "CenteredVerse1",
      "Text": "بیش از این درد کشیدن نتوان",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 15
    },
    {
      "VOrder": 48,
      "Position": "CenteredVerse2",
      "Text": "کاش با آه برون آید جان",
