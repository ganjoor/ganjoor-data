      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "رهسپارم به سر خاک تو ای عاشق مست",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "اشک و آه است و غم و ناله مرا حاصل عمر",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "چه کنم دشمن آزاده بود گیتی پست",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "داشتم یاری و عشقی اگرم هیچ نبود",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "وای کاین رشتهٔ امید دلم نیز گسست",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "به جز از اشک ندارم که نثار تو کنم",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "دولتم نیز تو بودی که برفتی از دست",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 57,
      "Position": "CenteredVerse1",
      "Text": "قدر این دولت بیدار کنون می‌دانم",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 16
    },
    {
      "VOrder": 58,
      "Position": "CenteredVerse2",
      "Text": "به لب آمد جانم",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 16
    },
    {
      "VOrder": 59,
      "Position": "CenteredVerse1",
      "Text": "دگر امشب ره جان خواهم زد",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 17
    },
    {
      "VOrder": 60,
      "Position": "CenteredVerse2",
      "Text": "طعنه بر کار جهان خواهم زد",
