  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "آخرین روز برات است و منم راهسپار",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "به سوی کعبهٔ آمال خود و مدفن یار",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "بار اول بود اکنون که پس از چندین ماه",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "می‌روم با دل خونین به سر خاک نگار",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "سوی آن خاک که بردند و سپردند آنجا",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "یک جهان عشق و وفا، مهر و ادب، حسن و وقار",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "مردم دیده‌ام از داغ غمش خفته به خون",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "افق خاطر از هجر رخش تیره و تار",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 9,
      "Position": "CenteredVerse1",
      "Text": "در دلم معرکه‌ای کرده به پا خاطره‌ها",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 8
    },
    {
      "VOrder": 10,
      "Position": "CenteredVerse2",
      "Text": "نالهٔ آب و صبا",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 8
    },
    {
      "VOrder": 11,
      "Position": "CenteredVerse1",
      "Text": "ای خدا دل بود این، آهن نیست",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 9
    },
    {
      "VOrder": 12,
      "Position": "CenteredVerse2",
      "Text": "دگرم طاقت جان دادن نیست",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 9
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "گرچه خرداد بود، برگ فرو ریزد باد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "شاید از آنکه مرا خاطره‌ای آرد یاد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "یادم آرد ز غروبی که به باغی چو بهشت",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "در برش بودم و از فکر دو عالم آزاد",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "باد می‌زد به درختان و به ما گل می‌ریخت",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "هر دو از صحبت هم چون گل و می خرم و شاد",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "صحنه‌هائی است مرا یاد که حق دارم اگر",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "«بزنم هر نفس از دست فراقش فریاد»",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 21,
      "Position": "CenteredVerse1",
      "Text": "یا کنون سر بشکافم به سر سنگ مزار",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 10
    },
    {
      "VOrder": 22,
      "Position": "CenteredVerse2",
      "Text": "بر سر تربت یار",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 10
    },
    {
      "VOrder": 23,
      "Position": "CenteredVerse1",
      "Text": "و چه افسانهٔ جانسوزی بود",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 11
    },
    {
      "VOrder": 24,
      "Position": "CenteredVerse2",
      "Text": "کی مرا فکر چنین روزی بود",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 11
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "این همان یار وفاپیشهٔ زیبای من است؟",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "این همان عاشق شوریدهٔ شیدای من است؟",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "این همان منبع الهام دل خون شده است",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "این همان مظهر ابهام و معمای من است؟",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "این همان چشمهٔ خورشید جهان‌افروز است",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "این همان کوکب رخشندهٔ شب‌های من است؟",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "اینکه خفته است در این کوه همان شیرین است",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "اینکه گمگشته در این بادیه لیلای من است؟",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 33,
      "Position": "CenteredVerse1",
      "Text": "ای صبا ده خبرش کآمده مجنون پریش",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 12
    },
    {
      "VOrder": 34,
      "Position": "CenteredVerse2",
      "Text": "بنگر عاشق خویش",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 12
    },
    {
      "VOrder": 35,
      "Position": "CenteredVerse1",
      "Text": "خیز، دیوانه و دردش بنگر",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 13
    },
    {
      "VOrder": 36,
      "Position": "CenteredVerse2",
      "Text": "آهِ سرد و رخ زردش بنگر",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 13
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "به کجا رفته‌ای «ای خاک درت تاج سرم»؟",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "بی‌تکلف ز غم هجر تو خون شد جگرم",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "کاش آتش زنم از آه خود این پردهٔ راز",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "تا خبردار کنندت ز غم پرده‌درم",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "آنکه آراسته بر ساحت گردون مه و مهر",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "کاش رحم آورد ای مه به شب بی‌سحرم",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "این منم رهسپر تربت ای یار عزیز",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "کاش این داغ به سوی تو کند رهسپرم",
