  "Verses": [
    {
      "VOrder": 1,
      "Position": "Comment",
      "Text": "عرض ارادتی به خواجه‌ی بزرگ:"
    },
    {
      "VOrder": 2,
      "Position": "Comment",
      "Text": "از صدای سخن عشق ندیدم خوش‌تر"
    },
    {
      "VOrder": 3,
      "Position": "Comment",
      "Text": "یادگاری که در این گنبد دوار بماند"
    },
    {
      "VOrder": 4,
      "Position": "Comment",
      "Text": "(حافظ)"
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "ای مردم چشم صفا را روشنایی",
      "CoupletIndex": 0,
      "SectionIndex1": 4,
      "SectionIndex2": 6
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "ای غربت جان را نسیم آشنایی",
      "CoupletIndex": 0,
      "SectionIndex1": 4,
      "SectionIndex2": 6
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "ای پارسی قندت بلای پارسایی",
      "CoupletIndex": 1,
      "SectionIndex1": 4,
      "SectionIndex2": 7
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "ای برق خرمن‌سوز زهّاد ریایی",
      "CoupletIndex": 1,
      "SectionIndex1": 4,
      "SectionIndex2": 7
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "ای کرده در عرش غزل الحق خدایی",
      "CoupletIndex": 2,
      "SectionIndex1": 4,
      "SectionIndex2": 8
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "کی جز تو کس نازد به شولای گدایی",
      "CoupletIndex": 2,
      "SectionIndex1": 4,
      "SectionIndex2": 8
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "با خشت زیر سر کی کرد آن کبریایی",
      "CoupletIndex": 3,
      "SectionIndex1": 4,
      "SectionIndex2": 9
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "ای خرقه جایی در گرو، دفتر به جایی",
      "CoupletIndex": 3,
      "SectionIndex1": 4,
      "SectionIndex2": 9
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "از فقر و خواب امن و فرش بوربایی",
      "CoupletIndex": 4,
      "SectionIndex1": 4,
      "SectionIndex2": 10
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "گویی چنان کز سکه افتد پادشایی",
      "CoupletIndex": 4,
      "SectionIndex1": 4,
      "SectionIndex2": 10
    },
    {
      "VOrder": 15,
      "Position": "Single",
      "Text": "ای خوش‌ترین افغان در این بیدر کجایی",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "ای از نوای دلکشت دل مست و جان مست",
      "CoupletIndex": 6,
      "SectionIndex1": 4,
      "SectionIndex2": 11
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "ای کرده زین رطل گران چرخ گران مست",
      "CoupletIndex": 6,
      "SectionIndex1": 4,
      "SectionIndex2": 11
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "ای ز شمیم ساغرت هفت آسمان مست",
      "CoupletIndex": 7,
      "SectionIndex1": 4,
      "SectionIndex2": 12
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "ای کرده زین آب حیات این خاکدان مست",
      "CoupletIndex": 7,
      "SectionIndex1": 4,
      "SectionIndex2": 12
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "هوش از تو مدهوش و زمین مست و زمان مست",
      "CoupletIndex": 8,
      "SectionIndex1": 4,
      "SectionIndex2": 13
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "صوفی و شیخ و زاهد و پیر و جوان مست",
