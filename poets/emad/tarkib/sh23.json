      "SectionIndex1": 4,
      "SectionIndex2": 13
    },
    {
      "VOrder": 22,
      "Position": "Single",
      "Text": "جادوی گیتی خیره زین قدرت‌نمایی",
      "CoupletIndex": 9,
      "SectionIndex1": 1
    },
    {
      "VOrder": 23,
      "Position": "Single",
      "Text": "زان دم که ساز این ساز عاشق ساز کردی",
      "CoupletIndex": 10,
      "SectionIndex1": 1
    },
    {
      "VOrder": 24,
      "Position": "Single",
      "Text": "گوش فلک زین نغمه پرآواز کردی",
      "CoupletIndex": 11,
      "SectionIndex1": 1
    },
    {
      "VOrder": 25,
      "Position": "Single",
      "Text": "پیر خرد را با جنون دمساز کردی",
      "CoupletIndex": 12,
      "SectionIndex1": 1
    },
    {
      "VOrder": 26,
      "Position": "Single",
      "Text": "زان قصه کاندر گوشه‌ٔ شیراز کردی",
      "CoupletIndex": 13,
      "SectionIndex1": 1
    },
    {
      "VOrder": 27,
      "Position": "Single",
      "Text": "تا حشر گیتی مست از این شهناز کردی",
      "CoupletIndex": 14,
      "SectionIndex1": 1
    },
    {
      "VOrder": 28,
      "Position": "Single",
      "Text": "پایان ندارد آنچه تو آغاز کردی",
      "CoupletIndex": 15,
      "SectionIndex1": 1
    },
    {
      "VOrder": 29,
      "Position": "Single",
      "Text": "اعجاز کردی، راستی اعجاز کردی",
      "CoupletIndex": 16,
      "SectionIndex1": 1
    },
    {
      "VOrder": 30,
      "Position": "Single",
      "Text": "صد داستان دارد چنین دستانسرایی",
      "CoupletIndex": 17,
      "SectionIndex1": 1
    },
    {
      "VOrder": 31,
      "Position": "Single",
      "Text": "پر شد جهان از نعره‌ٔ مستانه‌ٔ تو",
      "CoupletIndex": 18,
      "SectionIndex1": 1
    },
    {
      "VOrder": 32,
      "Position": "Single",
