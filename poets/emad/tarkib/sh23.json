      "CoupletIndex": 19,
      "SectionIndex1": 1
    },
    {
      "VOrder": 33,
      "Position": "Single",
      "Text": "هرکس نصیبی برده از میخانه‌ٔ تو",
      "CoupletIndex": 20,
      "SectionIndex1": 1
    },
    {
      "VOrder": 34,
      "Position": "Single",
      "Text": "شعر تو را بخشیده جان جانانه‌ٔ تو",
      "CoupletIndex": 21,
      "SectionIndex1": 1
    },
    {
      "VOrder": 35,
      "Position": "Single",
      "Text": "ای سینه‌ٔ صاحبدلان کاشانه‌ٔ تو",
      "CoupletIndex": 22,
      "SectionIndex1": 1
    },
    {
      "VOrder": 36,
      "Position": "Single",
      "Text": "ای شمع جان بیدلان پروانه‌ٔ تو",
      "CoupletIndex": 23,
      "SectionIndex1": 1
    },
    {
      "VOrder": 37,
      "Position": "Single",
      "Text": "ای قصه‌ٔ دلدادگان افسانه‌ٔ تو",
      "CoupletIndex": 24,
      "SectionIndex1": 1
    },
    {
      "VOrder": 38,
      "Position": "Single",
      "Text": "ای برده دل‌ها با نوای بی‌نوایی",
      "CoupletIndex": 25,
      "SectionIndex1": 1
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "ای شعر تو شیرین‌تر از عشق و جوانی",
      "CoupletIndex": 26,
      "SectionIndex1": 4,
      "SectionIndex2": 14
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "دلکش‌ترین گلبانگ باغ زندگانی",
      "CoupletIndex": 26,
      "SectionIndex1": 4,
