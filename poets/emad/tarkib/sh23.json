      "SectionIndex1": 3
    },
    {
      "VOrder": 60,
      "Position": "Single",
      "Text": "ای نام تو از ننگ، وای ننگ تو از نام",
      "CoupletIndex": 40,
      "SectionIndex1": 3
    },
    {
      "VOrder": 61,
      "Position": "Single",
      "Text": "نادیده خوش‌تر از تو مرغی چشم این دام",
      "CoupletIndex": 41,
      "SectionIndex1": 3
    },
    {
      "VOrder": 62,
      "Position": "Single",
      "Text": "ای نغمه‌ٔ تو ایمن از تصریف ایام",
      "CoupletIndex": 42,
      "SectionIndex1": 3
    },
    {
      "VOrder": 63,
      "Position": "Single",
      "Text": "ای مشعل روشنگر این جاودان شام",
      "CoupletIndex": 43,
      "SectionIndex1": 3
    },
    {
      "VOrder": 64,
      "Position": "Single",
      "Text": "ای برده عطر و نور عطار و سنایی",
      "CoupletIndex": 44,
      "SectionIndex1": 3
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "آوخ چه‌ها دیدی تو در آن قرن پر شور",
      "CoupletIndex": 45,
      "SectionIndex1": 4,
      "SectionIndex2": 21
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "قرنی که می‌کردند فرزندان پدر کور",
      "CoupletIndex": 45,
      "SectionIndex1": 4,
      "SectionIndex2": 21
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "قرن ریا، قرن ستم، قرن زر و زور",
      "CoupletIndex": 46,
      "SectionIndex1": 4,
      "SectionIndex2": 22
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "و آن محتسب، وان حد برای آب انگور",
      "CoupletIndex": 46,
      "SectionIndex1": 4,
      "SectionIndex2": 22
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "هر روز یک سلطان و یک آئین و دستور",
      "CoupletIndex": 47,
      "SectionIndex1": 4,
      "SectionIndex2": 23
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "آن داده داد مهر و مردی شاه منصور",
      "CoupletIndex": 47,
      "SectionIndex1": 4,
      "SectionIndex2": 23
    },
    {
