  "Verses": [
    {
      "VOrder": 1,
      "Position": "Comment",
      "Text": "در سوگ دوست و همشهری عزیزم"
    },
    {
      "VOrder": 2,
      "Position": "Comment",
      "Text": "شاعر خلّاق و نویسندهٔ گرانقدر،"
    },
    {
      "VOrder": 3,
      "Position": "Comment",
      "Text": "زنده یاد اخوان ثالث، مهدی نازنینم"
    },
    {
      "VOrder": 4,
      "Position": "Single",
      "Text": "باز داغی تازه دارد دل",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Single",
      "Text": "درد بی‌اندازه دارد دل",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Single",
      "Text": "رفت پیر قصه‌گو، آن همدم دیرین",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Single",
      "Text": "آن که همچون قصه‌هایش بود گاهی تلخ و گه شیرین",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Single",
      "Text": "از غم‌آباد دلش، از درد و فریاد دلش می‌گفت",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Single",
      "Text": "گرچه باغ آتش او گونه گون گل داشت",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Single",
      "Text": "در زمستان بذر نو می‌کاشت",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Single",
      "Text": "شد نو آیین شعر جاسوزش",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Single",
      "Text": "نُقل هر مجلس",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Single",
      "Text": "نَقل هر محفل",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Single",
      "Text": "راست باشد این که می‌گویند",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Single",
      "Text": "چون سخن از دل برآید می‌نشیند لاجرم بر دل",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Single",
      "Text": "گرچه عمرش بود غم، غم ضرب در غم بود",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Single",
      "Text": "گرچه می در آتشین کامش چنان زهر هلاهل بود",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Single",
      "Text": "گرچه افسردش دل و جانش ز غم فرسود",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Single",
      "Text": "گرچه گاهی کوه و دریایی ز غم‌ها بود",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 20,
      "Position": "Single",
      "Text": "زندگی در چشم او بازیچه و پندار و شوخی بود",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Single",
      "Text": "وین عجب کو بر همین بازیچه عاشق بود",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Single",
      "Text": "هم در آخر دؤر",
