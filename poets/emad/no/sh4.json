      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Single",
      "Text": "به این بیدادخانه هشته باشم گام",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Single",
      "Text": "گناهی آنچنان موحش که کوتاه است",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Single",
      "Text": "پی پاداش آن عمر همه رنج مرا، ایام",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Single",
      "Text": "وگرنه چیست آخر موجب یک عمر غم خوردن؟",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Single",
      "Text": "به نام زندگانی دم بدم مردن؟",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Single",
      "Text": "چرا ننهاده‌ام یک شب سر بی غصه بر بالین؟",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Single",
      "Text": "چرا آخر، چرا آخر؟",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Single",
      "Text": "چه می‌گویم، چه می‌پرسم؟",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Single",
      "Text": "شگفتا از که می‌پرسم؟",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Single",
      "Text": "مگر گوشی بوَد تا بشنود ای داد فریادم",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Single",
      "Text": "تفو بر هرچه قانون، هرچه یاسا، هرچه آیین است",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Single",
      "Text": "دگر دل خست و جان افسرد و تن فرسود",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Single",
      "Text": "شگفت افسانه‌ی تلخی، شگفت افسانه‌ی پوچی",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 20,
      "Position": "Single",
      "Text": "که از آغاز تا انجام ماتم بود",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Single",
      "Text": "همه غم بود و غم، غم بود و غم، غم ضرب در غم بود",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Single",
      "Text": "مگو عمر و مگو هستی، مگو مِی نوشی و مستی",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Single",
      "Text": "لبالب جامی از زهر هلاهل بود",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Single",
      "Text": "نه اغراق است و شعر، این حسب حالی از من و دل بود",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Single",
      "Text": "گناهی کرده‌ام شاید که خود آن را نمی‌دانم",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Single",
      "Text": "گناهی کرده‌ام شاید که در خاطر نمی‌آرم",
      "CoupletIndex": 25,
