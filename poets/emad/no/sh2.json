      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Single",
      "Text": "تو کیستی که بهر یک دو روز کرّ و فر",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
