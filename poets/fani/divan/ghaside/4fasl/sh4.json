      "Position": "Left",
      "Text": "درا به خرگه و آتش فروز از می ناب",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "نمونه بهر مشمع نمود قوس قزح",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "پی لفافه خرگاه آسمان ز سحاب",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "اگر نه ابر لفافست بهر خرگه چرخ",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "ز تار قطره چرا هر طرف کشید طناب",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "ز بسکه سیم فشان گشت ابر سیمابی",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "ز سیم برف زمین شد چو قلزم سیماب",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "ز بحر دی اگرت آرزو بود در عیش",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "بیا و کشتی دریای لعل را دریاب",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "شهیست گلخنی از شعله وز خاکستر",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "که هست آن یکش الطایی این دگر سنجاب",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "به سوی مغرب نارد شدن ز مشرق مهر",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "اگر نیفکند از ابر پل به روی خلاب",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "درامدن به رکابست و بردن سرما",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "در فنا شده گویا به پای خلق رکاب",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "هوا خزیده ز گرما در آهنین گنبد",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "به روی آب که یخ بسته قبهای حباب",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "مگو حباب که از شدت برودت دی",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "چو فرش سیم شده سطح مهره گرداب",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "فروغ عارض خوبان به گاه یخماله",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "بود چو بر فلک آب رنگ نور شهاب",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "چو بوم شعله شود پر زنان ز شدت برد",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "ز گال وار درو اوفتند خیل غراب",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "ز بس بیاض که بر چشمها رسید از برف",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "بسان سرمه عزیز آمده سواد تراب",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "مگوی سرمه که چون مشک ناب خاک سیاه",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "بزیر پرده کافور گون شده نایاب",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "ز پرده بین که سرشتست عنکبوت آسا",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "که در دهانش همه تار سیم گشته لعاب",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "به لرزه جثه مفلس ز شوق آتش تیز",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "مشابه دل مخمور از هوای شراب",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "شده چو جرز اصم گوش مفلسان ز سماع",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "که دو کتف شده بر رهگذار گوش حجاب",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "به جسم شخص تحرک نمانده جز لرزه",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "چو میت متحرک ز قدرت وهاب",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "در آب ماهی بی حس چو میخ رفته به خاک",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "به خاک مار فتاده بسان بسته طناب",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "گذشته چون ملخ از پشت هر طرف زانو",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "هر آنکه بوده بهم دست سای همچو ذباب",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "چو دیده شعله به رنگ پر ملخ جسته",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "درو بسان ملخ کرده خویش را پر تاب",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "درون حلقه چشم اشک بسته چون عینک",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "ولی به چشم ازان نی فروغ کسب و نه تاب",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "ز باد قاتل دی مرده آتش زردشت",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "که گشته از دم عیسیش زندگی نایاب",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "درین زمان که ز سوراخ سوزنی صرصر",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "چنان وزد که شود زو بنای عمر خراب",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "چو نار خانه طلب کن گرفته روزن او",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "درو چو دانه اش اخگر چو آب او می ناب",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "مغنیی و حریفی و ساقی دلکش",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "کزین سه چار نیاید عدد فزون به حساب",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "نشاط کن که مغنی ادا کند این شعر",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "بیاد مجلس شاهنشه رفیع جناب",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "که ای ز عارض و لب گاه میل بزم شراب",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "در آب ساخته آتش عیان در آتش آب",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "به غیر روی و دهانت ندیده کس ذره",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "درون دایره آفتاب عالمتاب",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "گه خرام قدت گو بیا معاینه بین",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "هر آن کسی که ندیدست عمر را به شتاب",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "نقاب مانع نور رخ تو نیست که نیست",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "چهار پرده گردون بافتاب حجاب",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "کشم خیال ترا رشتهای جان بسته",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "ز بهر وصل همینم مرتب است اسباب",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "چو راه چشم ببستم به پاره های جگر",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "درون خیال رخت مانده بود و بیرون خواب",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "به بوی وصل نهد رو به درگهت فانی",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "چنانکه اهل عبادت به گوشه محراب",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "میسر ار شودم رو به درگه شاهی",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "نهم که کحل مرا دست خاکش از همه باب",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "به کلک صنع ابوالغازیش لقب گشته",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "لقب که گفته قضا کان احسن الالقاب",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "نجوم کوکبه سلطان حسین دریادل",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "که بحر رفعت او را فلک شدست حباب",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "سپهر چتر معلاش را به ته سایه",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "چرا که قبه او گشته مهر عالمتاب",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "نجوم رخش سبگپاش را به نعل سیام",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "چرا که پویه او را سپهر گشته تراب",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "زهی به پایه رفعت ترا مکان جایی",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "که لا مکانش چو تحت الثرا شده به حساب",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "خهی بذوره حشمت ترا محل اوجی",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "که عرش گشته به خاک حضیض او نایاب",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "سمند عزم ترا سرعت آنچنانکه بطو",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "نموده چرخ سریعش چنانکه خربه خلاب",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "رکاب حلم ترا آن ثبات کندر چشم",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 86,
      "Position": "Left",
      "Text": "نموده ارض کرانش چو آسمان بشتاب",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "ز دست جود تو شد بحر و کان چنان خالی",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "که کوه توده خاشاک گشته بحر سراب",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "ز لطف عام تو گر نیک و بد جهان منعم",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "که کس سوال نیابد به صد هزار جواب",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 91,
      "Position": "Right",
      "Text": "نسیم گلشن خلق تو چون وزید به روح",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 92,
      "Position": "Left",
      "Text": "دم مسیح نموده چو دود نار عذاب",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 93,
      "Position": "Right",
      "Text": "شرار شعله قهرت چو جسته جرم سپهر",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 94,
      "Position": "Left",
      "Text": "هزار برق بلا کرده بر زمین پرتاب",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 95,
      "Position": "Right",
      "Text": "شده ز تیغ تو ویران عمارت تن خصم",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 96,
      "Position": "Left",
      "Text": "شود چنانکه عمارت ز آب تیز خراب",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 97,
      "Position": "Right",
      "Text": "دل عدوت ز پیکان ناوکت مرده",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 98,
      "Position": "Left",
      "Text": "چنانکه شعله نار کهن ز قطره آب",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 99,
      "Position": "Right",
      "Text": "ز سهم تیر تو فتح هزار حصن حصین",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 100,
      "Position": "Left",
      "Text": "بلی غمام ز باران نموده فتح الباب",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 101,
      "Position": "Right",
      "Text": "پی فزونی عشرت به بزم حشمت تو",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 102,
      "Position": "Left",
      "Text": "که آن ز مد کمانچه است یا نوای رباب",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 103,
      "Position": "Right",
      "Text": "فلک ز گیسوی ناهید بندد آنرا موی",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 104,
      "Position": "Left",
      "Text": "قضا ز پر ملایک باید دهد مضراب",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 105,
      "Position": "Right",
      "Text": "سپهر قدر تو بحری که بهر غرقه خصم",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 106,
      "Position": "Left",
      "Text": "بود هزار چو گردون دایرش گرداب",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 107,
      "Position": "Right",
      "Text": "دران زمان که ز باد فتن غبار بلا",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 108,
      "Position": "Left",
      "Text": "کشد نقاب به رخسار مهر عالمتاب",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 109,
      "Position": "Right",
      "Text": "غریو کوس دغا آن قیامت اندازد",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 110,
      "Position": "Left",
      "Text": "که بگسلند ز هم اشتران چرخ طناب",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 111,
      "Position": "Right",
      "Text": "دو صف بهیأت دو کوه آهن از پی قتل",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 112,
      "Position": "Left",
      "Text": "که رسته در وی از تیغ و نیزه صورت غاب",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 113,
      "Position": "Right",
      "Text": "پی شکار تذرو حیات و طوطی روح",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 114,
      "Position": "Left",
      "Text": "پرد خدنگ ز زاغ کمان به بال عقاب",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 115,
      "Position": "Right",
      "Text": "درم بسکه ملک عدم رسد از گرز",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 116,
      "Position": "Left",
      "Text": "چو بر بشیزه جوشن زنند چون ضراب",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 117,
      "Position": "Right",
      "Text": "بسان تیغ همه از فواد خون لیسند",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 118,
      "Position": "Left",
      "Text": "چنانکه گاه غذا از جگر زبان ذباب",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 119,
      "Position": "Right",
      "Text": "چو حمله جانب خصم آوری در آن ساعت",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 120,
      "Position": "Left",
      "Text": "کشیده تیغ ز ظل لوای فتح مآب",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 121,
      "Position": "Right",
      "Text": "چنان ز جا رود از صد مه تو صف عدو",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 122,
      "Position": "Left",
      "Text": "که کوه خار و خس از پیش تندرو سیلاب",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 123,
      "Position": "Right",
      "Text": "وزد نسیم ظفر بر لوای منصورت",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 124,
      "Position": "Left",
      "Text": "بهر طرف که توجه کنی برای صواب",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 125,
      "Position": "Right",
      "Text": "ظفر پناه سپاه ترا بهر جمله",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 126,
      "Position": "Left",
      "Text": "ندای فتح مبین بشنود ز غیب خطاب",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 127,
      "Position": "Right",
      "Text": "ز رزمگه چو بایوان بزم رانی رخش",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    },
    {
      "VOrder": 128,
      "Position": "Left",
      "Text": "هزار کسری و کیخسروت روان به رکاب",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    },
    {
      "VOrder": 129,
      "Position": "Right",
      "Text": "درون قصر فلک رفعت جهان آرا",
      "CoupletIndex": 64,
      "SectionIndex1": 0
    },
    {
      "VOrder": 130,
      "Position": "Left",
      "Text": "نهاده بزم کیانی کنی چو میل شراب",
      "CoupletIndex": 64,
      "SectionIndex1": 0
    },
    {
      "VOrder": 131,
      "Position": "Right",
      "Text": "یقین که در خور آن رزم باشد این بزمت",
      "CoupletIndex": 65,
      "SectionIndex1": 0
    },
    {
      "VOrder": 132,
      "Position": "Left",
      "Text": "که دور چرخ ندیدست مثل هر دو به خواب",
      "CoupletIndex": 65,
      "SectionIndex1": 0
    },
    {
      "VOrder": 133,
      "Position": "Right",
      "Text": "به سعی هر چه ز شاهان گرفته باشی ملک",
      "CoupletIndex": 66,
      "SectionIndex1": 0
    },
    {
      "VOrder": 134,
      "Position": "Left",
      "Text": "کنی عطای گدایان به مدح بی اطناب",
      "CoupletIndex": 66,
      "SectionIndex1": 0
    },
    {
      "VOrder": 135,
      "Position": "Right",
      "Text": "همیشه تا به شتا پوشد ابر کافوری",
      "CoupletIndex": 67,
      "SectionIndex1": 0
    },
    {
      "VOrder": 136,
      "Position": "Left",
      "Text": "ز برف پره کافور گون به جرم تراب",
      "CoupletIndex": 67,
      "SectionIndex1": 0
    },
    {
      "VOrder": 137,
      "Position": "Right",
      "Text": "به مجلس می کافور طبع مشکین عطر",
      "CoupletIndex": 68,
      "SectionIndex1": 0
    },
    {
      "VOrder": 138,
      "Position": "Left",
      "Text": "به عیش باد مقوی به رنگ لعل مذاب",
      "CoupletIndex": 68,
      "SectionIndex1": 0
    },
    {
      "VOrder": 139,
      "Position": "Right",
      "Text": "هزار بار جوانمردیت چو برمک و طی",
      "CoupletIndex": 69,
      "SectionIndex1": 0
    },
    {
      "VOrder": 140,
      "Position": "Left",
      "Text": "هزار سال جوان بختیت چو عهد شباب",
      "CoupletIndex": 69,
      "SectionIndex1": 0
    }
  ]
}
