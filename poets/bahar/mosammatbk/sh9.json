      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "کالبد مستنیر و جان ممثل",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "راه بدی را یکی فروخته مشعل",
