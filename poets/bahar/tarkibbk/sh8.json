      "RhymeLetters": "اب",
      "PlainText": "شادمان بنگرم دل احباب\r\nبه علی و آله الانجاب",
      "HtmlText": "\u003Cdiv class=\u0022b2\u0022 id=\u0022bn1\u0022\u003E\u003Cp\u003Eشادمان بنگرم دل احباب\u003C/p\u003E\r\n\u003Cp\u003Eبه علی و آله الانجاب\u003C/p\u003E\u003C/div\u003E",
      "CoupletsCount": 1
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ای شب قدر و ای خزانهٔ اجر",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "و سلام علیک حتی‌الفجر",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "رخ خوبت بناکنندهٔ وصل",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "سر زلفت فناکنندهٔ هجر",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "دل پاکت زلال چشمهٔ فیض",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "دم صبحت کلید مخزن اجر",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 7,
      "Position": "CenteredVerse1",
      "Text": "نور بخشی و رنج کاهی تو",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "SectionIndex3": 11
    },
    {
      "VOrder": 8,
      "Position": "CenteredVerse2",
      "Text": "بهتر ار صدهزار ماهی تو",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "SectionIndex3": 11
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "شدم از فرقتت بتاب‌، ای شب",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "ازمن خسته رخ متاب ای شب",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "مطلع دیده‌ام ز دیدن تو",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "شده پرنور آفتاب ای شب",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "وصلت‌ای‌شب‌به‌من‌شده‌است‌حلال",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "گشته برمن حرام خواب ای شب",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 15,
      "Position": "CenteredVerse1",
      "Text": "عجبا للمحب کیف ینام",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "SectionIndex3": 12
    },
    {
      "VOrder": 16,
      "Position": "CenteredVerse2",
      "Text": "کل نوم علی المحب حرام",
