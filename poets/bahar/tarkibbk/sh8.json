      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "SectionIndex3": 12
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "داشتم در دل ای شب طناز",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "آرزوی تو در شبان دراز",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "هجرت امشب کشیده پرده به روی",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "وصلت‌امشب گشاده چهره به ناز",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "فخرت‌این بس به‌روزهاکه شدی",
