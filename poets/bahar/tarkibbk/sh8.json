      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 23,
      "Position": "CenteredVerse1",
      "Text": "پادشاه صفا و سیر و سلوک",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "SectionIndex3": 13
    },
    {
      "VOrder": 24,
      "Position": "CenteredVerse2",
      "Text": "بوالحسن مالک‌الرقاب ملوک",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "SectionIndex3": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "آن که بدرالبدور ایقان است",
