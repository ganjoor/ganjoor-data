      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "در شریعت قبول حضرت او",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "هست فرعی که اصل ایمانست",
