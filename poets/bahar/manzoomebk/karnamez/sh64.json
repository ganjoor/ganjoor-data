      "CoupletSummary": "هوش مصنوعی: او با نیروی خود زمین را شکافت تا ریشه‌های لاله و نسرین آسیب دیدند."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "تا خورد بیخ لاله و نسرین",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "و آمدی زان شیارهاش پدید",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: تو از آن شکاف‌ها بیرون آمدی، کرم‌هايی نرم و لطیف با رنگ‌های زرد و سفید."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "کرم‌هایی لطیف‌، زرد و سفید",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "بلبلان رزق خویش می‌خوردند",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "CoupletSummary": "هوش مصنوعی: پرندگان عاشق گل‌ها، غذای خود را می‌خوردند و همه دور هم بر روی خوک صبحانه می‌خوردند."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "همه بر خوک چاشت می‌کردند",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "جاهلانی که گشته‌اند عزیز",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17,
      "CoupletSummary": "هوش مصنوعی: افرادی که نادان هستند و به جایگاه و ارزش رسیده‌اند، نه به خاطر شایستگی خود، بلکه به خاطر ترفندها و کارهای غیر اخلاقی."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "نه به‌حق بل به نیش و ناخن تیز",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "پیششان مرغکان ترانه کنند",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18,
      "CoupletSummary": "هوش مصنوعی: پرندگان در حضور آن‌ها آواز می‌خوانند، تا این‌که تدبیری برای تأمین آب و دانه‌ای بیندیشند."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "تا که تدبیر آب و دانه کنند",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "خوک نادان به لاله‌زار اندر",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19,
      "CoupletSummary": "هوش مصنوعی: خوک نادان در میان گل‌ها و لاله‌ها در حال زیر و رو کردن زمین است."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "مرزها را نموده زیر و زبر",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "لقمه‌هایی کلان برانگیزد",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20,
      "CoupletSummary": "هوش مصنوعی: لقمه‌های بزرگ ممکن است باعث شود که تکه‌های کوچک‌تری از آن بریزد."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "خرده‌هایی از آن فرو ریزد",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "مرغکان خرده‌هاش چینه کنند",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21,
      "CoupletSummary": "هوش مصنوعی: پرنده‌ها تکه‌های کوچک غذا را جمع‌آوری می‌کنند و به خاطر فرزندانشان خرج می‌کنند."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "وز پی کودکان هزینه کنند",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "نغمه‌خوانان به بوی چینه چمان",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22,
      "CoupletSummary": "هوش مصنوعی: خوانندگان با عطر خوش چمن به مدح و ستایش بزرگ‌منشان می‌پردازند."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "نغمه‌هاشان مدیح محتشمان",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "حمقا آن به ریش می‌گیرند",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23,
      "CoupletSummary": "هوش مصنوعی: احمق‌ها این کار را به عنوان شوخی می‌گیرند و از ویژگی‌های خاص خود بر خود می‌بالند."
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "وز کرامات خویش می‌گیرند",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "لیک غافل که جز چرندی نیست",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24,
      "CoupletSummary": "هوش مصنوعی: اما غافل نباش که غیر از افسوس و تمسخر، چیز دیگری وجود ندارد."
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "غیر افسوس و ریشخندی نیست",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    }
  ]
}
