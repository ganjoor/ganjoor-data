      "VOrder": 24,
      "Position": "Left",
      "Text": "جل و افسار خر طلاکردند",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "همه عراده‌ها به خر بستند",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: همهٔ ارابه‌ها را به خر بستند و بر سم خرها نعل نقره و طلا زدند."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "به خران نعل سیم وزربستند",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "رابضان سربسر فقیر شدند",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: مهترها و نگهبانان اسب همگی تهی‌دست شدند، ولی خربنده‌ها به ثروت و مقام رسیدند."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "لیک خربندگان امیر شدند",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "چون توجه نشد ز اسب‌، دگر",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "CoupletSummary": "هوش مصنوعی: چون دیگر کسی به اسب توجه نکرد، به برکت رواج خر، اسب از میان رفت."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "اسب معدوم شد به دولت خر",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "کار در دست خادم و خواجه",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17,
      "CoupletSummary": "هوش مصنوعی: کار کشور به دست خادمان و خواجگان حرم افتاده بود و شاه سرگرم خرهای نر و ماده بود."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "شاه سرگرم نرخر و ماچه",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "هرچه خر بد به شهر آوردند",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18,
      "CoupletSummary": "هوش مصنوعی: هرچه خر بود به شهر آوردند و اسب‌ها را به روستاها فرستادند."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "اسب‌ها را به روستا بردند",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "مردم روستا سوار شدند",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19,
      "CoupletSummary": "هوش مصنوعی: روستاییان سوار اسب شدند و صاحب شکوه و قدرت گشتند."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "صاحب فر و اقتدار شدند",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "چون که خود را بر اسب‌ها دیدند",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20,
      "CoupletSummary": "هوش مصنوعی: وقتی خود را سوار بر اسب یافتند، آمادهٔ شورش و سرکشی شدند."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "راه یاغی گری بسیجیدند",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "لشگری گرد شد از آن مردان",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21,
      "CoupletSummary": "هوش مصنوعی: از آن مردان سپاهی گرد آمد که نامشان «دستهٔ کلاه‌زردان» بود."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "نامشان دستهٔ کُله زردان",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "گشت معروف در همه کشور",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22,
      "CoupletSummary": "هوش مصنوعی: در سراسر کشور این سخن بر سر زبان‌ها افتاد که «لینگ‌تی» شاه خران و پادشاهی نادان است."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "«‌لینگ‌تی‌» هست پادشاهی خر",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "حمله بردند بر شه و سپهش",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23,
      "CoupletSummary": "هوش مصنوعی: به شاه و سپاهش حمله کردند و سرانجام او را خوار و شکست‌خورده کردند."
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "عاقبت پست شد سر و کله اش",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "گشت سرگشته پادشاه خران",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24,
      "CoupletSummary": "هوش مصنوعی: پادشاه خران آواره و درمانده شد و کشورش به دست دیگران افتاد."
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "ملکش افتاد درکف دگران",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "خواه در روم گیر خواه به چین",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25,
      "CoupletSummary": "هوش مصنوعی: چه در روم چه در چین، نتیجهٔ نادانی و خرصفتی جز این نیست."
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "خرخری را نتیجه نیست جز این",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    }
  ]
}
