      "VOrder": 26,
      "Position": "Left",
      "Text": "رود ازبیم دوزخ از سر زن",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "زن به مردان دلیر باشد و چیر",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: زن در برابر مردان گستاخ و چیره است و حتی در برابر خدا نیز جسور و گستاخ است."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "بر خدا نیز هست چیر و دلیر",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "لابه وآه و اشگ و زاری او",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "CoupletSummary": "هوش مصنوعی: التماس و آه و اشک و زاری او همه‌جا سلاح کارساز اوست."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "هست هرجا سلاح کاری او",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "کار با این سلاح برنده",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17,
      "CoupletSummary": "هوش مصنوعی: او با این سلاح بُرنده هم با خدا و هم با بندگان خدا کار خود را پیش می‌برد."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "می کند با خدا و با بنده",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "زن خدا را ز جنس نر داند",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18,
      "CoupletSummary": "هوش مصنوعی: زن خدا را از جنس مرد می‌پندارد و گمان می‌کند که التماس و زاری در دل او اثر می‌کند."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "در دلش لابه را اثر داند",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "زن که با شوی خودوفا نکند",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19,
      "CoupletSummary": "هوش مصنوعی: زنی که به شوهر خود وفادار نباشد، از خدا هم شرم نمی‌کند."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "از خدا نیز هم حیا نکند",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "علم‌های خیالی و نقلی",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20,
      "CoupletSummary": "هوش مصنوعی: زن دانش‌های خیالی و نقلی را دوست دارد، نه دانش‌هایی را که بر اندیشه و عقل استوارند."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "دوست دارد، نه فکری و عقلی",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "زن دانا اگر بود مغرور",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21,
      "CoupletSummary": "هوش مصنوعی: نخستین گونه زنی که می‌توان به او امید داشت زن داناست؛ اگر چه مغرور باشد، شاید از خیانت به دور باشد."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "شاید ار باشد از خیانت دور",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "دگر آن زن که آزموده بود",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22,
      "CoupletSummary": "هوش مصنوعی: گونهٔ دوم زنی است که تجربه‌دیده باشد و داستان‌ها و سرگذشت‌های بسیار شنیده باشد."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "داستان‌ها بسی شنوده بود",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "سوم‌آن‌زن که‌هست‌شوهردوست",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23,
      "CoupletSummary": "هوش مصنوعی: گونهٔ سوم زنی است که شوهرش را دوست دارد و شوهرش نیز دلباختهٔ اوست."
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "شوهرش نیز دل‌سپردهٔ اوست",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "چون‌ازین‌بگذری‌به‌دست‌قضاست",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24,
      "CoupletSummary": "هوش مصنوعی: جز این سه گونه، باقی به دست تقدیر است و پند و اندرز و گفت‌وگو بی‌فایده است."
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "یند و اندرز و قیل‌و قال‌، هباست",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    }
  ]
}
