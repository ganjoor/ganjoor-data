      "Position": "Left",
      "Text": "گفت با شیدسپ کای پیر عزیز",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "این دو دختر را جمالی بیمرست",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "یا پری خود ز آدمی زیباتر است",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 5,
      "Position": "CenteredVerse1",
      "Text": "همچو من بنگر تو نیز",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "گفت شیدسپ ای جهان را روشنی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "دور باش از فکرت اهریمنی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "این نگار و نقش دیو رهزن است",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "و آب و رنگ خامهٔ اهریمن است",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 10,
      "Position": "CenteredVerse1",
      "Text": "در حقیقت نیست چیز",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "نقش بیرون از فرشته یادگار",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "وز درون دیوند و دیوی نابکار",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "این نکورویان تمامی از برون",
