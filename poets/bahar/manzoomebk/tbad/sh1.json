      "Text": "سر بسر بشنو ز من",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "این‌ حکایت‌ از کتاب و نامه نیست",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "وین سخن‌ها از زبان خامه نیست",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 9,
      "Position": "CenteredVerse1",
      "Text": "عشق می گوید سخن",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "دفتر راز طبیعت خوی تست",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "رمز هستی در سواد موی تست",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 12,
      "Position": "CenteredVerse1",
      "Text": "روی گیتی سوی تست",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "مرد را تنها تویی یار قدیم",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "هم‌یناهی‌، هم شریکی‌، هم ندیم",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 15,
      "Position": "CenteredVerse1",
      "Text": "هم رفیق ممتحن",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "گر طبیعت پیکری گیرد همی",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "پیکری غیر ازتو نپذیرد همی",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 18,
      "Position": "CenteredVerse1",
      "Text": "نقش تو گیرد همی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "ای طبیعت را نمودار کمال",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "در تحول‌، در تغیر، در جمال",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 21,
      "Position": "CenteredVerse1",
      "Text": "در قوانین و سنن",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "گه چو سطح آب صافی بی‌غبار",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "گاه چون اعماق مرموز بحار",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 24,
      "Position": "CenteredVerse1",
      "Text": "مبهم و تاریک و تار",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "گاه چون آیینه اسرارت عیان",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "گه نهان چون شانه با سیصد زبان",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 27,
      "Position": "CenteredVerse1",
      "Text": "در دو زلف پر شکن",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "گه به زنجیر شرافت پای‌بند",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "چون‌ فرشته‌ پاک‌ و چون گردون‌ بلند",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 30,
      "Position": "CenteredVerse1",
      "Text": "چون ستاره ارجمند",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "گه ز شهوت اوفتاده در خلاب",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "گشته‌ چون‌ مار و وزغ در منجلاب",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 33,
      "Position": "CenteredVerse1",
      "Text": "پای تا سر غوطه‌زن",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "گه گشاده بهر بلع خاص و عام",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "همچو آتشخانهٔ نمرود، کام",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 36,
      "Position": "CenteredVerse1",
      "Text": "گه شده برد و سلام",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "گاه گفته بهر طفلی شیرخوار",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "ترک قوم وترک شهر و ترک یار",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 39,
      "Position": "CenteredVerse1",
      "Text": "جسته در کوهی وطن",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "گاه موسی‌زاده‌، گاهی سامری",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "گاه کوبیده در جادوگری",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 42,
      "Position": "CenteredVerse1",
      "Text": "گه در پیغمبری",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "گه بریده گردن یحیی به‌زار",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "گه مسیحا پرورنده درکنار",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 45,
      "Position": "CenteredVerse1",
      "Text": "اینت پر اسرار زن",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "گاه ‌چون ‌جفت ‌اتابک شوی ‌خواه",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "دست ‌شسته ‌بهر جفت‌ از تاج وگاه",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 48,
      "Position": "CenteredVerse1",
      "Text": "برده در کاشان پناه",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "گاه چون دخت اتابک بی‌وفا",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "کرده خود را در ره شهوت فنا",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 51,
      "Position": "CenteredVerse1",
      "Text": "زشت نام و شوم تن",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "گاه «کلیوپاتره‌» و گاهی «‌همای‌»",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "گاه‌ «‌استر» گشته‌ دخت‌ «‌مردخای‌»",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 54,
      "Position": "CenteredVerse1",
      "Text": "گه شده زرتشت زای",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "گاه چون «کردیه‌» پوشیده زره",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "بر زره بربسته چون مردان گره",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 57,
      "Position": "CenteredVerse1",
      "Text": "گشته مردی صف‌شکن",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "مختلف طبعی نه‌ای بر یک نمط",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "داری از افراط تا تفریط خط",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 60,
      "Position": "CenteredVerse1",
      "Text": "نیستی‌ حد وسط",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "گاه‌ خوب‌ خوبی‌ و گه زشت زشت",
      "CoupletIndex": 40,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "یا به چاه ویل‌، یا صدر بهشت",
      "CoupletIndex": 40,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 63,
      "Position": "CenteredVerse1",
      "Text": ".................................",
      "CoupletIndex": 41,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    }
  ]
}
