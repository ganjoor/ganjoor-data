      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "دیو آزش بنگرید از زیر چشم",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "جمله دیوان در برش زانو زدند",
