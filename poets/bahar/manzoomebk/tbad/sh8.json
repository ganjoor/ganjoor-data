      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "خند خندان با دو چشمان اریب",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "خودی از فیروزه بر سر شاهوار",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "تکمهٔ زر بر قبای زرنگار",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 5,
      "Position": "CenteredVerse1",
      "Text": "همره یکدسته دیب",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "جملگی زیبارخ و آراسته",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "رخ ز دوده‌، گیسوان پیراسته",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "هدیه‌ها و لوحه‌ها بر روی دست",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "دو کنیزک با دو چشم نیم‌مست",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 10,
      "Position": "CenteredVerse1",
      "Text": "برده از دل‌ها شکیب",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "برنهاد آن هدیه‌ها در پیشگاه",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "پس زمین بوسید پیش پادشاه",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "زان سپس آن نامه‌ها را برگشاد",
