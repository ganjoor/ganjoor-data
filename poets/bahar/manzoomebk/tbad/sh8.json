      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 15,
      "Position": "CenteredVerse1",
      "Text": "با عباراتی عجیب",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "پس یکایک نامه‌ها را برگرفت",
