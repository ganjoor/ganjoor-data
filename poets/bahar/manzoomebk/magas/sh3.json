      "SectionIndex3": 16,
      "SectionIndex4": 20
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "خلقتش از ربمی‌ و از ربمنی است",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 16,
      "SectionIndex4": 20
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "پاک زی و خانهٔ خود پاک دار",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "SectionIndex3": 16,
      "SectionIndex4": 21
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "تا مگس از خان تو گیرد فرار",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "SectionIndex3": 16,
      "SectionIndex4": 21
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "گر همه خلق این عمل آسان کنند",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 16,
      "SectionIndex4": 22
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "ریشه‌اش از کشور ایران کنند",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 16,
      "SectionIndex4": 22
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "کشور ایران شود آباد و پاک",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 16,
      "SectionIndex4": 23
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "می‌شود این جانور از بن هلاک",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 16,
      "SectionIndex4": 23
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "چون‌مگس‌ازکشور ماگشت دور",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "SectionIndex3": 16,
      "SectionIndex4": 24
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "باگل وخاک وطن آغشت نور",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "SectionIndex3": 16,
      "SectionIndex4": 24
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "خرمگس از پاکی کشور پرید",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "SectionIndex3": 16,
      "SectionIndex4": 25
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "رشتهٔ بی‌باکی کافر برید",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "SectionIndex3": 16,
      "SectionIndex4": 25
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "بهجت و نورانیت آید به کار",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "SectionIndex3": 16,
      "SectionIndex4": 26
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "صحت و انسانیت آید به‌بار",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "SectionIndex3": 16,
      "SectionIndex4": 26
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "صحت و انسانیت از خاصیت",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "SectionIndex3": 16,
      "SectionIndex4": 27
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "دانش و دین آرد و حسن نیت",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "SectionIndex3": 16,
      "SectionIndex4": 27
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "دانش و دین چون درکشور زنند",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "SectionIndex3": 16,
      "SectionIndex4": 28
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "لشکر شیطان در دیگر زنند",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "SectionIndex3": 16,
      "SectionIndex4": 28
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "وین مگس از لشکر شیطان بود",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "SectionIndex3": 16,
      "SectionIndex4": 29
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "کشتن و تاراندنش آسان بود",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "SectionIndex3": 16,
      "SectionIndex4": 29
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "ای پسر، این گفتهٔ نغز بهار",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "SectionIndex3": 16,
      "SectionIndex4": 30
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "بشنو و برآن دل و همت کمار",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "SectionIndex3": 16,
      "SectionIndex4": 30
    }
  ]
}
