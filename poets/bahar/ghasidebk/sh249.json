  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "آنچه در دورهٔ ناصری",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در دوران ناصرالدین شاه، بسیاری از مردان و زنان بدون توجه و به صورت سطحی جان خود را از دست دادند."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "مرد و زن کشته شد سرسری",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "آن به عنوان لامذهبی",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: این فرد به عنوان یک شخص بی‌دینی شناخته می‌شود و آن فرد دیگر به عنوان یک پیرو مکتب بابی."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "این به عنوان بابیگری",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "آن به عنوان جمهوریت",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: این یک تشبیه است به دو مفهوم مهم؛ یکی از آنها به معنای نمایندگی و دیگر به معنای علم و دانش. در واقع، این دو به نوعی مکمل یکدیگر هستند و هر کدام بر اهمیت خاص خود تأکید دارند. نخستین مفهوم به توانایی هدایت و مدیریت جامعه اشاره دارد و دومی به ارزش‌های علمی و پژوهشی."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "این به عنوان دانشوری",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "وانچه ‌شد کشته در چند شهر",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر چیزی که در چندین شهر کشته شده، میان شیخی و بالاسری وجود دارد."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "بین شیخی و بالاسری",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "شد ز نو تازه در عهد ما",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در زمان ما، جنایت‌ها و دشمنی‌ها دوباره آغاز شده و تازگی یافته‌اند."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "آن جنایات و کین‌گستری",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "دورهٔ پهلوی تازه کرد",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دوران پهلوی به تازگی عادت‌های دورهٔ ناصر را ادامه داد."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "عادت دورهٔ ناصری",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "نام مردم نهد بلشویک",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در این زمان، افرادی که به بلشویک‌ها مرتبط هستند، به دشمنان بی‌اساسی تبدیل شده‌اند که به دیگران اتهام می‌زنند."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "این زمان دشمن مفتری",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "بلکه زان دوره بگذشت هم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: این دوره به پایان رسیده و اکنون مشخص شده است که زمان بربریت فرا رسیده است."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "شد عیان دورهٔ بربری",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "آخر نام هرکس که بود",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آخر نام هر شخصی که باشد، کافی است که قاضی و داور باشد."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "کاف‌، کافی بود داوری",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "بلشویک است و یار لنین",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بلشویک‌ها و یاران لنین مخالف سرمایه‌داری و رفتارهای قلدری هستند."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "خصم سرمایه و قلدری",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "بایدش بی‌محابا بکشت",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: برای حفظ امنیت، باید بی‌هیچ ترسی او را از بین ببرد."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "از ره امنیت‌پروری",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "جمله ماندند باز از عمل",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: همه از کارهایی که تاجر، کاسب و مشتری انجام می‌دهند، بازمانده‌اند."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "تاجر و کاسب و مشتری",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "زارع از زارعی کاسب از",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: کشاورز از تلاش و زحمت خود بهره می‌برد و کارگر نیز از کارش روزی می‌گیرد. تاجر هم از تجارت و خرید و فروش سود می‌برد."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "کاسبی تاجر از تاجری",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "لیک شاعر نماند از عمل",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: شاعر به خاطر کارهایش نمی‌تواند از عواقب آن بگریزد و در حقیقت، شاعری او را به چالشی نیز می‌کشد."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "هم به زندان کند شاعری",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Comment",
      "Text": "*",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 30,
      "Position": "Comment",
      "Text": "*",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "وان نفاقی که بُد پیش ازین",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: این دوگانگی و ریاکاری که قبلاً در بین مردم یک کشور رواج داشت."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "پیشهٔ مردم کشوری",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "حیدری دشمن نعمتی",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: این جمله به تقابل و تضاد بین حیدر (که معمولاً به علی ابن ابی‌طالب اشاره دارد) و دشمنان او اشاره دارد. به این معناست که حیدر به عنوان یک نیروی قوی و نیکو برای مؤمنان و عدالت‌طلبان محسوب می‌شود، در حالی که دشمنان او نیز به عنوان موانع و مشکلاتی برای او و پیروانش به شمار می‌آیند. در واقع، این جمله نشان‌دهنده رابطه‌ای متقابل و تعاملی بین حیدر و دشمنانش است."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "نعمتی دشمن حیدری",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "این زمان تازه گشت آن نفاق",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در این زمان، نفاق و دوگانگی در ایران به خاطر بدخویی و ناپاکی به وجود آمده است."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "اندر ایران ز بدگوهری",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "دولتی دشمن ملتی",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: حکومتی که با ملتی درگیری دارد، دشمنی با کشوری دارد که ارتش آن کشور نیز دشمن اوست."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "کشوری دشمن لشکری",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "بربدی صبر باید همی",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر بر بدی صبر نکنی، ممکن است خداوند بدتری برایت مقدر کند."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "ورنه یزدان دهد بدتری",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "خود خورد خویشتن را ستم",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: نمی‌توان با ظلم و ستم مقابله کرد، مگر با دفع کردن آزار و ظلم از خود."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "دفع ظالم کند برسری ",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "در شداید هویدا شود",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در شرایط سخت و دشوار، ارزش و طبیعت واقعی افراد نمایان می‌شود."
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "گوهر مردم گوهری",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "روز سختی نمایان شود",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در روزهای دشوار، مردان بزرگ و دلیر خود را نشان می‌دهند و توانایی‌هایشان را به نمایش می‌گذارند."
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "شیرمردی و کنداوری",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "آنکه در بستر خز خزد",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آن کسی که در روزهای سخت و دشواری قرار دارد، باید از تجربه‌ی خوشحالی و آرامش در زمان‌های خوشبختی استفاده کند تا این روزهای سخت را راحت‌تر بگذراند."
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "روز سختی شود بستری",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "ای شکم گرسنه‌، غم مدار",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای شکم گرسنه، نگران ضعف و لاغری خود نباش."
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "از ضعیفی و از لاغری",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "هست در فاقه بس رازها",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در دل فقر و تنگدستی، رازهای بسیاری نهفته است که تو از آن‌ها بی‌خبری و فقط در اشک‌هایم می‌توانی آن‌ها را حس کنی."
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "کان ندانی در اشکم پری",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "شیر نر چون گرسنه شود",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: وقتی شیر نر گرسنه می‌شود، بیشتر تلاش می‌کند تا شکار کند."
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "بیشتر می‌کند صفدری",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "کارها آید از گرسنه",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: کارهای بزرگی از انسان نیازمند و گرسنه برمی‌آید که در شرایط سخت و دشوار قرار دارد."
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "معجزاتی است در مضطری",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "محنت فاقه کمتر بود",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: درد و رنج فقر در دنیا کمتر از آسیب‌های ناشی از پرخوری است."
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "در جهان ز آفت پرخوری",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "آدمی چون گرسنه شود",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: وقتی که انسان گرسنه می‌شود، به وسوسه‌ها و خطرات کثیری دچار می‌شود."
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "گردد اندر مهالک جری",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "مردمان گفته‌اند این مثل",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: مردم گفته‌اند که هر کسی به خاطر نان، حتی جان خود را نیز فدا می‌کند."
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "هرکه از نان پس‌، از جان بری",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "مرد دانا چو شد گرسنه",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: مردی که داناست، وقتی گرسنه می‌شود، به فکر می‌افتد و فراتر از نیاز خود اندیشه می‌کند."
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "جنبدش هوش پیغمبری",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "ای زبردست بیدادگر",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای ظالم چقدر دیگر می‌خواهی ستم و ظلم کنی؟"
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "چند ازین جور و استمگری",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "جنبش مردم گرسنه است",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: حرکت و شورش مردمی که کمبود خوراک دارند همانند صدای خشم و قدرت اسکندر، بزرگ و کوبنده است."
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "غرش کوس اسکندری",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "کینه تیغی است زنگارگون",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: کینه مانند یک تیغ زنگ‌زده است که باعث می‌شود انسان را به فقر و درماندگی بیندازد و از ارزش وجودی او کم کند."
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "فقر سازد ورا جوهری",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "ظلمش آرد برون از نیام",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ظلم او باعث می‌شود که نافرمانی و بی‌عدالتی به وضوح نمایان شود. رخدادهای ناعادلانه را همچون طوفانی خارج از کنترل به نمایش می‌گذارد."
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "اینت باد افره و داوری",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    }
  ]
}
