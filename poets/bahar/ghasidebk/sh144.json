  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "باز به پا کرد نوبهار سرادق",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "بلبل آمد خطیب و قمری ناطق",
