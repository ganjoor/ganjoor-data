      "Text": "بر ما دوزخ و بهشت یکیست",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "که به هرجا رضای او طلبیم",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
