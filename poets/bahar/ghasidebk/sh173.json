      "Position": "Left",
      "Text": "اهل گیتی تنند و ما عصبیم",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "انجلاء قلوب را، صیقل",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "ارتقاء نفوس را سببیم",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
