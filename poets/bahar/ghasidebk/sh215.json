    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "چون برگذرد باد فرودین",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "صد چین و شکنج افکند نسیم",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: نسیمِ خوش‌بوی آن از رشک، صد چین و شکن بر چهرهٔ مشک چین می‌اندازد؛ یعنی بوی گل‌های شیراز از مشک چین برتر است."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "از رشک‌، برابر وی مشک چین",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "زی بقعت کوهی یکی برای",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به زیارتگاه بابا کوهی برو که آن بقعه همچون بهشت برین است."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "کان بقعه بهبشی بود برین",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "بر ساحت بردی ببر سلام‌",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به محلهٔ بردی سلام برسان، زیرا نامش یادآور «خنکی و سلامت» است و جایی دلنشین است؛ با واژه‌های «برد» و «سلام» بازی کرده است."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "کآن برد و سلامیست دلنشین",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "وز چشمهٔ زنگیش نوش کن",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از آب چشمهٔ زنگی بنوش تا گویی شکر و عسل نوشیده‌ای."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "تا شکر نوشی و انگبین",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "بگذر سحری زی سه آسیا",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: سحرگاه به سه‌آسیاب برو و از آنجا طلوع خورشید را بر کوه و آب تماشا کن."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "زآنجا به کُه خور بر آببین‌",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "کز عکس گل و لاله و سمن",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: زیرا از بازتاب رنگ گل و لاله و یاسمن، خورشید با شرمساری از زمین برمی‌آید."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "شرمنده برآید خور از زمین",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "بر مسجد ویران عمرولیث",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بر مسجد کهن و ویران عمرو لیث چهره بساي، چرا که بنایی کهن و ستوده است."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "رخ‌سای که پیریست بافرین",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "رخ سای بر آن فرخ آستان",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چهره بر آن آستانهٔ فرخنده بگذار و غبار کهنه را با آستین از آن پاک کن."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "بزدای ازو گرد باستین",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "قرآن‌کده‌اش را درون صحن",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: خانهٔ قرآنِ درون صحن آن مسجد را با چشمی آشنا به قرآن و معنای آن تماشا کن."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "با دیدهٔ قرآن‌شناس بین",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "بر مرقد سعدی بسای چهر",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بر آرامگاه سعدی چهره بساي و بر خاک خواجو پیشانی بگذار."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "بر تربت خواجو بنه جبین",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "کن یاد سرکوی شاه شیخ",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به خاطر دل غمگین حافظ، کوی شاه شیخ ابواسحاق را یاد کن؛ همان پادشاهی که حافظ دوستش داشت و بر او اندوه خورد."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "از بهر دل حافظ غمین",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "شو تربت خونینش را بجوی",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: برو و گور خونین او را بجوی و خار و خاشاک را از روی آن پاک کن."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "وآن خاروخس از تربتش بچین",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "آن دولت مستعجلش نگر",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به آن فرمانروایی زودگذرش بنگر و بر گور ویرانه‌اش بنشین؛ اشاره به سخن حافظ که دولت او را «مستعجل» خواند."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "بر تربت وبرانه‌اش نشین",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "جو تربت منصور شاه را",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: گور شاه منصور را بجوی که به دست آن سمرقندی ملعون کشته شد."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "مقتول سمرقندی لعین",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "گر تربت او یافتی‌، بروب",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر گور او را یافتی، خاک راهش را با گیسوی حوریان بروب؛ یعنی با نهایت احترام آن را پاکیزه کن."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "خاک رهش از زلف حور عین",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "بر مدفن شه شیخ برنویس",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بر آرامگاه شاه شیخ بنویس که این گور پادشاهی راستین است."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "کاین مدفن شاهیست راستین",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "بر تربت منصور بر نگار",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بر گور شاه منصور نقش کن که این آرامگاه شیری خشمگین و دلاور است."
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "کاین تربت شیریست‌ خشمگین",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "زانجا به سوی حافظیه شو",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از آنجا به حافظیه برو و مشتی از خاک آن سرزمین برگیر."
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "زان خطه کفی خاک برگزین",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "و آن خاک به‌ سر کن که ای دریغ",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آن خاک را به نشانهٔ سوگ بر سر بریز و بگو: دریغا، حافظ و آن طبع دلنشینش کجاست؟"
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "کو حافظ و آن طبع دلنشین",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "زی تربت خواجو برای هان",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به آرامگاه خواجو برو و بر گور اهلی شیرازی ناله کن."
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "بر مدفن اهلی بنال هین",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "بر مرقد بسحاق کن گذر",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از کنار آرامگاه بسحاق اطعمه بگذر و از خاک او ریزه‌های هنر را برچین."
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "ربزهٔ هنر از خاک او بچین",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "بر خواجهٔ «‌داهدار» ده درود",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به آرامگاه خواجه داهدار درود بفرست و از خاک آن سرزمین یاری معنوی بخواه."
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "همت طلب از خاک آن زمین",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "در مسجد بردی ز مکتبی‌",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در مسجد بردی، سخنان دلنشین مکتبی شیرازی را بشنو و به یاد آور."
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "بنیوش سخن‌های نازنین",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "جو توشهٔ راه از شه چراغ",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از آرامگاه شاه‌چراغ برای راه خود توشه بطلب، زیرا گویی در آنجا هر دو جهان به خاک سپرده شده است."
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "کانجا دو جهان بنگری دفین",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    }
  ]
}
