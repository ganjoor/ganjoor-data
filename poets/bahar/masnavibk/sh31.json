  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "خداوند هنر، استاد بهزاد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: خداوند هنر، استاد بهزاد، کسی است که آثارش با قلمش به وجود آمده و نبوغ او در خلق تصاویر قابل تحسین است."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "که نقش از خامهٔ بهزاد به زاد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "حسین رادکِش بهزاد نام است",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: حسین رادکِش بهزاد، شخصیتی است که کمال‌الدین بهزاد به عنوان خدمتکار او شناخته می‌شود."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "کمال‌الدین بهزادش غلام است",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "اگر بود او نخست‌،‌ این هست اول",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: اگر او وجود داشته باشد، این نخستین است و اگر او به کمال رسیده باشد، این کامل‌ترین است."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "اگر بود او کمال‌، این هست اکمل",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "به رنگ‌آمیزی‌ از خورشید ییش‌ است",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: این جمله به این معناست که رنگ‌هایی که به کار می‌روند، نشانه‌ای از زمان غروب خورشید و آفتاب عصر هستند."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "به‌معنی‌آفتاب‌عصر خویش است",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "به صورت شادی و غم می‌نماید",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: شادی و غم به وضوح در چهره ظاهر می‌شوند و احساسات عمیق انسان را به تصویر می‌کشند."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "غم و شادی مجسم می‌نماید",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "به سحرانگیزی کلک گهرخیز",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: زیبایی و جاذبه‌ای که در دنیای طبیعی وجود دارد، روح و جان انسان را تحت تأثیر قرار می‌دهد و به آن طراوت و زیبایی می‌بخشد."
    },
    {
      "VOrder": 12,
      "Position": "Left",
