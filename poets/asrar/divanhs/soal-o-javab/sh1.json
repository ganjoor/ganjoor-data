      "VOrder": 9,
      "Position": "Right",
      "Text": "هم کنوز ورموز سر وجود",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "در نهاد تو کردگار نهاد",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "گر تو و چون توئی نبود مراد",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "ننمودی خدای خلق ایجاد",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "چیست اقرار فضل تو ایمان",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "کیست انکار امر توالحاد",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "چون کلید خزائن دانش",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "بر کف قدرت تو قادر داد",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "سر این نکته را بیان فرما",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "تا شود قلب مستمندان شاد",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "در سه جاموت دادهاند نشان",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "عارفان طریق را ارشاد",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "زان یکی ذاتی است و آندیگر",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "اضطراری است در جمیع عباد",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "واندگر هست اختیاری شخص",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "کو بتاراج زندگانی داد",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "زندهٔ مرده چون تو اندزیست",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "مردهٔ زنده چون کند دلشاد",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "ور خمولی گزیند و عزلت",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "هستی خویش را دهد بر باد",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "حکمت و عفت و شجاعت و عدل",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "همه افتد ز کار همچو جماد",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "شهوتی گر نبود عفت نیست",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "کافرار نیست بهر چیست جهاد",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "ور رضا بر قضای ربانی",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "داد گوید هر آنچه بادا باد",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "قوت اطفال و کسب رزق حلال",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "امر فرمود سید امجاد",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "ور بتحصیل رزق پردازد",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "در میان گروه بی بنیاد",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "روز و شب صاحبان نحوت و آز",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "فارغش کی کنند از الحاد",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "مرده با زندگان بخل و حسد",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "کی تواند نمود او اسعاد",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "نیست ما را چو چشم دل روشن",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "صد نماید بچشم ما آحاد",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "راه باریک و دور و ویرانست",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "شب تاریک و کور مادرزاد",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "گر ز برهان عقلی و نقلی",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "راه مقصود را کنی ارشاد",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "در دو عالم خدای هر دو جهان",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "قدرت افزون کند و قرب زیاد",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "لیک منظوم میرود مسئول",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "گر کنی ز التفات خود انشاد",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "بعد ماو شما بعمر دراز",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "نفع گیرند اهل علم و سداد",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Paragraph",
      "Text": "روحی فداک کمترین درباب حدیث موتوا قبل ان تموتواحیران و سرگردانم",
      "CoupletIndex": 27
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "ما بدین مقصد عالی نتوانیم رسید",
      "CoupletIndex": 28,
      "SectionIndex1": 1
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "هم مگر لطف شما پیش نهد گامی چند",
      "CoupletIndex": 28,
      "SectionIndex1": 1
    },
    {
      "VOrder": 58,
      "Position": "Paragraph",
      "Text": "چشم بصیرت کور و راه مقصود دور مگر بهدایت هادی طریق سعادت در این ورطهٔ هلاکت جانی بسلامت بیرون برده از چاه ضلالت بدر آئیم و ببرهان عقلی و نقلی آن صاحب دانش و بینش ناسوران سوختگان آتش حسرت مرهم پذیر شود چون استدعا از بندگان عالی چنان بود که چند کلمه منظوم مرقوم فرمایند از این جهت گستاخی شد جواب سئوال منظوم استدعا نمودم و تا بحال نظم و غزلی معروض نشده این هم از التفات سرکار است.",
      "CoupletIndex": 29
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "ما چو نائیم و نوا از ما ز تست",
      "CoupletIndex": 30,
      "SectionIndex1": 2
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "ما چو کوهیم و صدا در ماز تست",
      "CoupletIndex": 30,
      "SectionIndex1": 2
    },
    {
      "VOrder": 61,
      "Position": "Paragraph",
      "Text": "و اگر در سئوآل خبط و خطائی شده باشد باصلاح آن کوشیده",
      "CoupletIndex": 31
    },
    {
      "VOrder": 62,
      "Position": "Right",
      "Text": "من هیچم و کم ز هیچ هم بسیاری",
      "CoupletIndex": 32,
      "SectionIndex1": 3
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "از هیچ و کم از هیچ نیاید کاری",
      "CoupletIndex": 32,
      "SectionIndex1": 3
    },
    {
      "VOrder": 64,
      "Position": "Paragraph",
      "Text": "جواب و سئوال هر دو از سرکار است (ای دعا از تو و اجابت هم ز تو) والسلام علیکم و رحمة اللّه و برکاته",
      "CoupletIndex": 33
    }
  ]
}
