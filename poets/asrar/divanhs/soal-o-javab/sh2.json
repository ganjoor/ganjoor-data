      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "موت اخضر مرقع اندوزیست",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "در زنی چون دراعهٔ زهاد",
