      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 64,
      "Position": "Right",
      "Text": "زندهٔ مرده مردهٔ جهل است",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 65,
      "Position": "Left",
      "Text": "بی خبر از خدا و راه رشاد",
