      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "در ریاضات یا شروط رشاد",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "این سحابی است یمطر الحکمه",
