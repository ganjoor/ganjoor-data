  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "بتی را که بودم بدو روزگاری",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "جدا دارد از من بد آموزگاری",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "نداند غم و درد هجران یاران",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "جز آن کازموده است هجران یاری",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
