  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "همیشه بد بود اندوه و درد فرقت یار",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "بتر بوقت گل و صبح روزگار بهار",
