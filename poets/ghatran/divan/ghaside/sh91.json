      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "کنونکه باد بهاری کنار پر گل کرد",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
