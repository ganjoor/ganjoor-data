  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "بنام خداوند کون و مکان",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "خداوند روزی ده مهربان",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "خدایی که جان و خرد آفرید",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "به فرمان او شد جهان‌ها پدید",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
