      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "تا تو در عالمی و از عالم",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "نیک و بد بی شمار می بینی",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
