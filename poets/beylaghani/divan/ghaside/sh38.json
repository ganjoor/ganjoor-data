  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "مرا که کار غم عشق یار خواهد بود",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "بیا بگو که ازین به چه کار خواهد بود؟",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "نه من نه یار اگر در میان وصل و فراق",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "مرا بجز غم او غمگسار خواهد بود",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "چه می خورم غم وصلی که روز دولت او؟",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "چو شمع یکشبه ناپایدار خواهد بود",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
