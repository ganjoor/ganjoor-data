      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "مایه رحمتست سایه تو",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
