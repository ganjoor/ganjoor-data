      "VOrder": 16,
      "Position": "Right",
      "Text": "ایدل تو همه برگ عیش سازی",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "زان کار تو جز بینوا نباشد",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "جان میدهی آنرا من ندانم",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "کو باشد یار تو یا نباشد",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "عاشق شده تن فرا بلا ده",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "کاین عشق بتان بی بلا نباشد",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "ایدوست روا داری اینکه هرگز",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "یک حاجتم از تو روا نباشد",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "صد وعده که دادی یکی وفا کن",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "یا با رخ نیکو وفا نباشد",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "بر زلف تو رشک آیدم از انروی",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "کز روی تو یکدم جدا نباشد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "خواهی که نباشدبشهر فتنه",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "آن روی نهان دار تا نباشد",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "خنده مزن ایجان زگریه من",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "کاین لایق آنخوش لقا نباشد",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "ا زخنده شنیدی که دل بمیرد",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "زانست که گل را بقا نباشد",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "بیگانه مشو چون دلست و جانست",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "بیگانه چنین آشنا نباشد",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "یک بوسه بده خونبهایم آْخر",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "هر چند مرا خونبها نباشد",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "جز جور مکن گر کنی که انصاف",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "در سنت خوبان روا نباشد",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "گفتی که مخورغم که من ترایم",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "این دولت دانم مرا نباشد",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "روی تو تمنای مقبلانست",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "شایسته چون من گدا نباشد",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "وصل تو چو شعر رشید دینست",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "کو محرم هر ناسزا نباشد",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "رادی که بجز بهر خدمت او",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "گردون خمیده دوتا نباشد",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "بحری که نکوتر زگفته او",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "الا سخن انبیا نباشد",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "چون خط شریفش نگار نبود",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "چون طبع لطیفش هوا نباشد",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "چون رای وی از روشنی و رفعت",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "خورشید بوسط السما نیاشد",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "زان داد سخن میدهد که در شعر",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "قادر تر ازو پادشا نباشد",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "وقتی که کند عقل حل اشکال",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "جز رای ویش مقتدا نباشد",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "ای آنکه ببالای مدحت تو",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "از کسوه دانش قبا نباشد",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 60,
      "Position": "Right",
      "Text": "چون لفظ تو آب حیات نبود",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "چون خلق تو باد صبا نباشد",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 62,
      "Position": "Right",
      "Text": "چون تو یدبیضا نمائی از کلک",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "ناموس کلیم و عصا نباشد",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 64,
      "Position": "Right",
      "Text": "از روی شرف جز زخاکپایت",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 65,
      "Position": "Left",
      "Text": "در چشم خرد توتیا نباشد",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 66,
      "Position": "Right",
      "Text": "بی سایه کلک تو نیست علمی",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 67,
      "Position": "Left",
      "Text": "چون گنج که بی اژدها نباشد",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 68,
      "Position": "Right",
      "Text": "گر گویم بحری محال نبود",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 69,
      "Position": "Left",
      "Text": "ور گویم ابری خطا نباشد",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 70,
      "Position": "Right",
      "Text": "کاین چون تو بوقت سخن نبارد",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 71,
      "Position": "Left",
      "Text": "وان چون تو بگاه سخا نباشد",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 72,
      "Position": "Right",
      "Text": "جز شعر تو خواندن حلال نبود",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 73,
      "Position": "Left",
      "Text": "جز مدح تو گفتن روا نباشد",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 74,
      "Position": "Right",
      "Text": "نزدیک من آن یک قصیده تو",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 75,
      "Position": "Left",
      "Text": "ملکی است که آنرا فنا نباشد",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 76,
      "Position": "Right",
      "Text": "جاوید بماناد صیت فضلت",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 77,
      "Position": "Left",
      "Text": "دردست من الادعا نباشد",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 78,
      "Position": "Right",
      "Text": "آری بعا اقتصار باید",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 79,
      "Position": "Left",
      "Text": "چون قوت مدح و ثنا نباشد",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    }
  ]
}
