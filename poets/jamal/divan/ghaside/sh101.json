  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ای محرم خانه محرم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای کسی که محرمِ راز خانهٔ حرامِ خدا شده‌ای و برای کعبهٔ بزرگ جامهٔ احرام پوشیده‌ای."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "وی محرم کعبه معظم",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ای در همه چیزها موفق",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای کسی که در همه چیز کامیاب و در همه کارها پیشگام و برتری."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "وی در همه کارها مقدم",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "ای نهضت عزم مردوارت",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای کسی که حرکت و سفرِ برخاسته از ارادهٔ مردانه‌ات از هر آمیزهٔ ریا پاک و بی‌عیب است."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "از شایبه ریا مسلم",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "ای عزم تو در نفاذ و سرعت",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ارادهٔ تو در نافذ بودن و شتاب، همتای قضای حتمی و بازگشت‌ناپذیر الهی شده است."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "گشته دوم قضای مبرم",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "گردون نکند توهم فتح",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر کاری که تو بر آن عزم کنی، فلک حتی گمانِ شکستن و گشودنِ آن را به خود راه نمی‌دهد؛ یعنی عزم تو را کسی نمی‌تواند بشکند."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "عزمی که شود ترا مصمم",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "یکجذبه ز جذبه های رحمان",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: یکی از کشش‌های الهی تو را از هر دو جهان جدا کرد و به سوی خدا برد."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "بربود ترا ز هر دو عالم",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "توفیق چنین عجب نباشد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چنین توفیقی شگفت نیست، زیرا در تو بخت و اقبال با خرد همراه شده است."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "چوندولت گشت با خرد ضم",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "چون بهر ادای این فریضه",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هنگامی که برای به‌جا آوردن فریضهٔ حج پایت را محکم در رکاب نهادی و به راه افتادی،"
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "شد پای تو در رکاب محکم",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "بر بسته میان برای سختی",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: کمر به تحمل سختی‌های سفر بستی و وسایل خوشی و عیش را درهم شکستی و کنار گذاشتی."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "واسباب طرب شکسته بر هم",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "توفیق ترارفیق و همراه",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: توفیق الهی یار و همراه تو بود و جبرئیل هم‌نشین و همدم تو."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "جبریل تر اندیم و همدم",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "بربسته قضا ز طره حور",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تقدیر از گیسوی حوریان بر نیزه و درفش تو پرچم بسته بود."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "بر نیزه و بیرق تو پرچم",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "طی کرده منازل پیاپی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: منزل‌های راه را پیاپی پیمودی و جرعه‌جرعه رنج و تلخی سفر را پیوسته نوشیدی."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "بس کرده تجرع دمادم",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "در هر و سه گام پنج شش بار",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در هر دو سه گامِ راه چندین بار ماجرایی چون داستان هفت‌خوان رستم، یعنی خطر و سختی، پیش می‌آمد."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "ده قصه هفتخوان رستم",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "میگفت ملک که اوست تحقیق",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: فرشته می‌گفت که به راستی او در سیرت و صورت همچون ابراهیم ادهم، زاهد نامدار، است."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "از سیرت و صورت ابن ادهم",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "از شوق مواقف مقدس",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از شوقِ رسیدن به جایگاه‌های مقدس حج و از عشقِ دیدار مکان‌های گرامی،"
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "و ز عشق مشاهد مکرم",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "دل کرده فدای درد و جان نیز",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دل و جان را فدای درد این راه کردی و زر و حتی سرت را در این راه نثار کردی."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "زر کرده نثار راه و سرهم",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
