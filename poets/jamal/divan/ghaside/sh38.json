      "Position": "Left",
      "Text": "گر لب لعل آن پسر یابد",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "چرخ باروی همچو خورشیدش",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
