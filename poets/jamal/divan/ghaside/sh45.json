    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "جان شیرین نهند برکف دست",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: جان عزیز را آمادهٔ فدا کردن در دست می‌گیرند و از یاد یار و دیار دست می‌کشند."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "بس حدیث دیار و یار کنند",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "کاخ و کاشانه راکنند وداع",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: با کاخ و خانهٔ خود خداحافظی می‌کنند و در میان بیابان آرام می‌گیرند."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "در دل بادیه قرا ر کنند",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "سهم ان راههای مردم خوار",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ترس آن راه‌های هولناک و آدم‌کُش را در برابر امید خود ناچیز می‌شمارند."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "پیش چشم امید خوار کنند",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "جان و جاه و سر و زر اندازند",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: جان و مقام و سر و مال را فدا می‌کنند و هزینهٔ این راه را از همین چهار چیز می‌پردازند."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "خرج آن راه از ین چهار کنند",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "هرکجا عشق لایزال آمد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر جا عشق جاودان پدید آید، سر و مال دیگر ارزشی ندارد."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "سر وزر را چه اعتبار کنند",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "دیده از هر چه هست بردوزند",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چشم از همهٔ موجودات می‌بندند تا چنین سعادتی را به دست آورند."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "تا چنین دولتی شکار کنند",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "تکیه گه بر حضیض کوه زنند",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در دامنهٔ کوه تکیه می‌دهند و در شکاف غار جای پا می‌گیرند."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "پای گه در شکاف غار کنند",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "بالش پر زسنگ خاره نهند",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بالش خود را از سنگ سخت می‌سازند و بسترشان را با نوک خار به جای گل می‌آرایند."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "بستر گل زنوک خارکنند",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "گله از عندلیب و از طوطی",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در بیابان به جای بلبل و طوطی با شترمرغ و سوسمار همدم می‌شوند و درد دل می‌کنند."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "باشتر مرغ و سوسمار کنند",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "بر امید وصال خانه دوست",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به امید رسیدن به خانهٔ دوست، یعنی کعبه، زهر را شربتی گوارا می‌شمارند."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "شربت زهر خوشگوار کنند",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "از بزرگان عجب نباشد اگر",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: شگفت نیست اگر بزرگان کارهای بزرگ و شایسته انجام دهند."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "کار های بزرگوار کنند",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "مقبلانرا چو وحی باشد رای",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: نیک‌بختان چون رأیشان مانند وحی درست است، همهٔ اندیشه‌هایشان را محکم و استوار می‌کنند."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "همه اندیشه استوار کنند",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "پس برهنه شوند چون شمشیر",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آن‌گاه مانند شمشیر برهنه می‌شوند، یعنی جامهٔ احرام می‌پوشند، تا با نفس خود بجنگند."
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "تا که بانفس کار زار کنند",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "جان روحانیان قدسی را",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هنگام گفتن لبیک، با اخلاص خود جان فرشتگان پاک را شرمنده می‌کنند."
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "وقت لبیک شرمسار کنند",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "چیست رمی الجمار نزد خرد",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: رمی جمرات در نگاه عقل چیست؟ این است که نفس امّاره را سنگسار کنند."
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "نفس اماره سنگسار کنند",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "چون بموقف رسند از پس شوط",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چون پس از طواف به موقف (عرفات) می‌رسند، چنان می‌گریند که سنگ‌های آن راه را هم به گریه می‌اندازند."
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "سنگ آن راه اشکبار کنند",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "دستهای نیاز وقت دعا",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: حاجیان هنگام دعا دست‌های نیازشان را مانند برگ پنجه‌مانند درخت چنار گشوده به سوی آسمان بالا می‌برند."
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "راست چون پنجه چنار کنند",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "چون عروس حرم کند جلوه",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: وقتی کعبه مانند عروس حرم جلوه می‌کند، حاجیان جان شیرین خود را بر او نثار می‌کنند."
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "جان شیرین براو نثار کنند",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "سقف مرفوع و خانه معمور",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آسمانِ برافراشته و بیت‌المعمور، یعنی ساکنان آسمان و فرشتگان، همگی در جوار کعبه منزل می‌گزینند؛ گویی آسمان و خانهٔ آسمانی نیز همسایهٔ این خانه‌اند."
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "همه سکنی در آن جوار کنند",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "وز پی بوس خال رخسارش",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: برای بوسیدن خال رخسار این عروس، یعنی حجرالاسود، سر و جان خود را فدا می‌کنند."
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "سر فشانند و جانسپار کنند",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "خواجه لالای حجره بینی",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در آنجا خواجه‌ای سیاه‌چهره و نگهبان حجره می‌بینی، یعنی حجرالاسود، که مردم به دیدارش افتخار می‌کنند."
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "که بدیدارش افتخار کنند",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "شب و مشک و سواد دیده زدل",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: شب و مشک و سیاهی چشم از روی دل، رنگ جامهٔ سیاه او را نشان و شعار خود می‌سازند."
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "کسوت او همی شعار کنند",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "خلفا جامه و سلاطین چتر",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: خلیفگان جامهٔ سیاه خود و پادشاهان چتر سیاهشان را از همان رنگ به عاریت گرفته‌اند."
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "همه زان رنگ مستعار کنند",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "حبشی صورتی که سلطانان",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: او حبشی‌چهره‌ای است که پادشاهان هزار بار دستش را می‌بوسند؛ اشاره به بوسیدن حجرالاسود."
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "دست بوسش هزار بارکنند",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "آن سبه جامه میر حاجب بار",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: او آن سیاه‌جامهٔ امیرِ پرده‌داران است که او را فرمانروای سرای بار و بارگاه می‌کنند."
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "کش امیر سرای بار کنند",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "سیر نادیده هیچ چهره وصل",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: حاجیان هنوز از دیدن چهرهٔ وصال سیر نشده، باید مرکب جدایی را تیزرو کنند و بازگردند."
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "مرکب هجر راهوار کنند",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "لاجرم از برای محملشان",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ناچار برای کجاوهٔ آنان، ناقة‌الله، یعنی شتر مقدس، را به قطار می‌بندند؛ یعنی بازگشتشان با حرمت و تأیید الهی است."
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "ناقه الله بر قطار کنند",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "ملاء عرش از سرادق حفظ",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: فرشتگان عرش از سراپردهٔ نگاهبانی الهی گرداگرد حاجیان خندق و دیوار می‌کشند و آنان را حفظ می‌کنند."
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "گردشان خندق و حصار کنند",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "مرتبتشان ز چرخ بگذارند",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: مقام حاجیان را از آسمان برتر می‌برند و بزرگی و سروریشان را هزار برابر می‌کنند."
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "خواجگیشان یکی هزار کنند",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "هر غباری که در فضای هوا",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر گردی که حاجیان پیاده یا سواره در فضا برمی‌انگیزند،"
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "گر پیاده و گر سوار کنند",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "روشنان فلک برای شرف",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ستارگان روشن آسمان برای کسب شرف، از آن گرد سرمهٔ خاکستری برای چشم خود می‌سازند."
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "کحل اغبر ازان غبار کنند",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "حور خلخال ناقه حجاج",
      "CoupletIndex": 40,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: حوریان بهشتی برای شرف و افتخار، خلخال شتران حاجیان را گوشوارهٔ خود می‌کنند."
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "بهر تشریف گوشوار کنند",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "زانسپس سالکان راه خدای",
      "CoupletIndex": 41,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: پس از آن، رهروان راه خدا وقتی رو به قبله آرام می‌گیرند و قرار می‌یابند،"
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "چون سوی قبله پاقرار کنند",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "اولا نام صاعد مسعود",
      "CoupletIndex": 42,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: نخست نام ممدوح، صاعدِ خجسته، را تعویذ بازوی روزگار می‌سازند تا جهان را از گزند نگه دارد."
    },
    {
      "VOrder": 86,
      "Position": "Left",
      "Text": "حرز بازوی روزگار کنند",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "شرح اخلاق او حدی سازند",
      "CoupletIndex": 43,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هنگامی که حاجیان بر شتران مهار می‌زنند و راه می‌افتند، شرح خوی‌های نیک او را آواز شتربانی خود می‌کنند."
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "حاج چون بر شتر مهار کنند",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "ساکنان صوامع ملکوت",
      "CoupletIndex": 44,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: عابدان صومعه‌های عالم ملکوت، یعنی فرشتگان، تنها به دعای او بسنده می‌کنند."
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "بر دعای وی اقتصار کنند",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 91,
      "Position": "Right",
      "Text": "ذکر باقیش بر صحیفه روز",
      "CoupletIndex": 45,
      "SectionIndex1": 0,
