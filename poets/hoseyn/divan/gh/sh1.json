      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "آن شهسوار بر سر میدان عاشقی",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "جولان کند که از همه عالم شود جدا",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "مهمیز شوق چون بزند بر براق عشق",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "از سدره نطع سازد و از عرش متکا",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "از کام عشق بگذر و راه رضا سپر",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "زیرا که از رضا همه حاجت شود روا",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "چون تو مراد خویش بدلبر گذاشتی",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "هر دم هزار گونه مرادت دهد عطا",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "سیراب شد چنانکه دگر تشنگی ندید",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "هر کس که راه یافت بسرچشمه رضا",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "گر آرزوی شاهی ملک رضا کنی",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "پیوسته باش بنده درگاه مرتضی",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "سردار دین احمد و سردار دار فضل",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "سالار اهل ملت و سلطان اصفیا",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    }
  ]
}
