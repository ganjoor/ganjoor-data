      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Paragraph",
      "Text": "این یاقوت سیراب که از درج طبع لطیف آن نصرت ایابست درج افتاد.",
      "CoupletIndex": 5
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "ز دین و ز دنیا مرادم توئی",
      "CoupletIndex": 6,
      "SectionIndex1": 1
    },
    {
