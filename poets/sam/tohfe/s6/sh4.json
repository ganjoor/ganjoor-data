      "VOrder": 7,
      "Position": "Left",
      "Text": "کی وا شود آن غنچه که از شاخ جدا شد",
      "CoupletIndex": 3,
      "SectionIndex1": 13,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "جهان کهنه خلقی را به دل داغ هوس مانده",
      "CoupletIndex": 4,
      "SectionIndex1": 13,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "بیا ساقی که این ویرانه از بسیار کس مانده",
      "CoupletIndex": 4,
      "SectionIndex1": 13,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "وارسته‌ای کجاست که راه عدم رویم",
      "CoupletIndex": 5,
      "SectionIndex1": 13,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "با یکدگر چو سایه قدم در قدم رویم",
      "CoupletIndex": 5,
      "SectionIndex1": 13,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Right",
      "Text": "بر ما چه میکشی قلم رد به ملک عشق",
      "CoupletIndex": 6,
      "SectionIndex1": 13,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Left",
      "Text": "ما خود کمینه جور کش این قلمرویم",
      "CoupletIndex": 6,
      "SectionIndex1": 13,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "من بودم و رقیب که آن مه سلام کرد",
      "CoupletIndex": 7,
      "SectionIndex1": 13,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "مردم ز غم که آه، کرا احترام کرد",
      "CoupletIndex": 7,
      "SectionIndex1": 13,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "هر جا بتان به جامه گلگون نشسته‌اند",
      "CoupletIndex": 8,
      "SectionIndex1": 13,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "تا گردن از فراغ تو در خون نشسته‌اند",
      "CoupletIndex": 8,
      "SectionIndex1": 13,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "رحمی که عاشقان همه شب بی مه رخت",
      "CoupletIndex": 9,
      "SectionIndex1": 13,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "تا روز چشم بر مه گردون نشسته‌اند",
      "CoupletIndex": 9,
      "SectionIndex1": 13,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "خوش آن مجلس که آنجا توبه خود چون کنم ظاهر",
      "CoupletIndex": 10,
      "SectionIndex1": 13,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "مرا ساقی گریبان گیرد و می در گلو ریزد",
      "CoupletIndex": 10,
      "SectionIndex1": 13,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "خوش آنکه خواب کنم زیر پای او آنسان",
      "CoupletIndex": 11,
      "SectionIndex1": 13,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "که چون دراز کند پا به روی ما برسد",
      "CoupletIndex": 11,
      "SectionIndex1": 13,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Paragraph",
      "Text": "این رباعی او بسیار خوب واقع شده:",
      "CoupletIndex": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "گر در غم عشق استوار آید دل",
      "CoupletIndex": 13,
      "SectionIndex1": 1
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "بر مرکب آرزو سوار آید دل",
      "CoupletIndex": 13,
      "SectionIndex1": 1
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "گر دل نبود کجا وطن سازد عشق",
      "CoupletIndex": 14,
      "SectionIndex1": 1
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "ور عشق نباشد بچه کار آید دل",
      "CoupletIndex": 14,
      "SectionIndex1": 1
    }
  ]
}
