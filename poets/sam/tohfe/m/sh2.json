  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "بر رای فضیلت آرای سالکان مسالک انصاف و ناهجان مناهج دور از تعصب و اعتساف، مخفی نخواهد بود که در خلال احوال این طبقه خیرمآل اگر احیانا یکی از مخالفان دین و دولت را مذکور سازد و خامه تلبین آئین بتقریر حال شقاوت مآل ایشان پردازد نه پایه ی دین را از آن اختلالی است، و نه چهره ی دولت را از آن گرد ملالی، چه، در قرآن مجید موصوف بصفت « و لا رطب و لا یابس الا فی کتاب مبین » سوره قل هو الله احد با تبت یدا ابی لهب، قرین است و سیر انبیای کرام علیهم التحیه و السلام،با ذکر عصیان و طغیان جبابره و فراعنه همنشین، بل غرض از ایراد حکایت آن جماعت تاریخ است نه شمول عطوفت و عنایت .",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "نکته : محجوب نماند که در این نسخه هر جا که صاحب قرآن مغفور مذکور میگردد مراد حضرت شاه ماضی است و هر جا که حضرت صاحب قرآن مرقوم میشود غرض حضرت شاه عالم پناه گیتی ستانی است که بمقتضای ذکر اللسطان تنزل الامان تذکار ایشان ملتزم امانی و آمال و سرمایه سعادت و اقبال دو جهانی است.",
      "CoupletIndex": 1
    },
    {
      "VOrder": 4,
      "Position": "Right",
      "Text": "دلش بنور یقین از دریچه امروز",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Left",
      "Text": "همه مشاهد احوال عالم بالاست",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Paragraph",
      "Text": "اعنی سلطان سلاطین پناه، شهنشاه ملایک سپاه، فلک رتبت سپهر اقتدار، گردون بسطت خورشید آثار.",
      "CoupletIndex": 3
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "آن فلک رتبه ای که ناطقه را",
      "CoupletIndex": 4,
      "SectionIndex1": 1
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "نیست در وصف او توانائی",
      "CoupletIndex": 4,
      "SectionIndex1": 1
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "آنکه منشور دولت او را",
      "CoupletIndex": 5,
      "SectionIndex1": 1
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "ماه نو کرده است طغرائی",
      "CoupletIndex": 5,
      "SectionIndex1": 1
    },
    {
      "VOrder": 12,
      "Position": "Paragraph",
      "Text": "ثمره شجره طیبه و مصدر اسم همایونش بطریق رمز و ایما کلام معجز نظام طه ما انزلنا اصلها ثابت و فرعها فی السماء طهماسب",
      "CoupletIndex": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "در جهانی و از جهان بیشی",
      "CoupletIndex": 7,
      "SectionIndex1": 2,
      "SectionIndex2": 4
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "همچو معنی که در بیان باشد",
      "CoupletIndex": 7,
      "SectionIndex1": 2,
      "SectionIndex2": 4
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "زیر این نه رواق مینا فام",
      "CoupletIndex": 8,
      "SectionIndex1": 2,
      "SectionIndex2": 5
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "چون شود گفته این همایون نام",
      "CoupletIndex": 8,
      "SectionIndex1": 2,
      "SectionIndex2": 5
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "آید از هر یکی بجای صدا",
      "CoupletIndex": 9,
      "SectionIndex1": 2,
      "SectionIndex2": 6
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "خلدالله ملکه ابدا",
      "CoupletIndex": 9,
      "SectionIndex1": 2,
      "SectionIndex2": 6
    },
    {
      "VOrder": 19,
      "Position": "Paragraph",
      "Text": "مصرع : آن به که بر دعای تو ختم سخن کنم:",
      "CoupletIndex": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "نه دعائی که شاعرانه بود",
      "CoupletIndex": 11,
      "SectionIndex1": 3,
      "SectionIndex2": 5
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "وز ره صدق بر کرانه بود",
      "CoupletIndex": 11,
      "SectionIndex1": 3,
      "SectionIndex2": 5
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "بل دعائی قرین صدق و صفا",
      "CoupletIndex": 12,
      "SectionIndex1": 3,
      "SectionIndex2": 6
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "مشتمل بر مصالح دو سرا",
      "CoupletIndex": 12,
      "SectionIndex1": 3,
      "SectionIndex2": 6
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "هم در او جاه و حشمت دنیی",
      "CoupletIndex": 13,
      "SectionIndex1": 3,
      "SectionIndex2": 7
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "هم در او عز و دولت عقبی",
      "CoupletIndex": 13,
      "SectionIndex1": 3,
      "SectionIndex2": 7
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "سر نهم بزمین عجز و نیاز",
      "CoupletIndex": 14,
      "SectionIndex1": 3,
      "SectionIndex2": 8
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "کای خدا، کار او بلطف بساز",
      "CoupletIndex": 14,
      "SectionIndex1": 3,
      "SectionIndex2": 8
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "عدل را در دلش چنان جا کن",
      "CoupletIndex": 15,
      "SectionIndex1": 3,
      "SectionIndex2": 9
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "که نراند برون ز عدل سخن",
      "CoupletIndex": 15,
      "SectionIndex1": 3,
      "SectionIndex2": 9
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "شرع را، پیشوای حکمش دار",
      "CoupletIndex": 16,
      "SectionIndex1": 3,
      "SectionIndex2": 10
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "حکم او را، ز شرع دار مدار",
      "CoupletIndex": 16,
      "SectionIndex1": 3,
      "SectionIndex2": 10
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "تا بود در جهان بقا امکان",
      "CoupletIndex": 17,
      "SectionIndex1": 3,
      "SectionIndex2": 11
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "باقیش دار شاه و شاه نشان",
      "CoupletIndex": 17,
      "SectionIndex1": 3,
      "SectionIndex2": 11
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "دولتش را در این سرای امید",
      "CoupletIndex": 18,
      "SectionIndex1": 3,
      "SectionIndex2": 12
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "ساز تخم سعادت جاوید",
      "CoupletIndex": 18,
      "SectionIndex1": 3,
      "SectionIndex2": 12
    },
    {
      "VOrder": 37,
      "Position": "Paragraph",
      "Text": "بی تکلف ورد دولتخواهان همیشه این دعاست :",
      "CoupletIndex": 19
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "من نگویم که این و آنش ده",
      "CoupletIndex": 20,
      "SectionIndex1": 4
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "گویم آنش بده که آنش به",
      "CoupletIndex": 20,
      "SectionIndex1": 4
    },
    {
      "VOrder": 40,
      "Position": "Paragraph",
      "Text": "و الحمد الله علی التوفیق",
      "CoupletIndex": 21
    }
  ]
}
