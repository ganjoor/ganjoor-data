      "VOrder": 46,
      "Position": "Left",
      "Text": "مرا در خرمن هستی زن آتش",
      "CoupletIndex": 25,
      "SectionIndex1": 6,
      "SectionIndex2": 8
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "که چون سوزم بدوزخ نبودم کار",
      "CoupletIndex": 26,
      "SectionIndex1": 6,
      "SectionIndex2": 9
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "که خاکستر نسوزد کس دگر بار",
      "CoupletIndex": 26,
      "SectionIndex1": 6,
      "SectionIndex2": 9
    },
    {
      "VOrder": 49,
      "Position": "Paragraph",
      "Text": "این چند بیت در خطاب عاشق با شمع نیز از آن کتابست :",
      "CoupletIndex": 27
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "تو را چون من در این دیر غم انجام",
      "CoupletIndex": 28,
      "SectionIndex1": 7,
      "SectionIndex2": 9
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "مگر دادی است از بیداد ایام",
      "CoupletIndex": 28,
      "SectionIndex1": 7,
      "SectionIndex2": 9
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "که می بینم دلت ز آنسان مشوش",
      "CoupletIndex": 29,
      "SectionIndex1": 7,
      "SectionIndex2": 10
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "بجای خاک بر سر کرده آتش",
      "CoupletIndex": 29,
      "SectionIndex1": 7,
      "SectionIndex2": 10
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "تو گر داری ز شب تا صبحدم سوز",
      "CoupletIndex": 30,
      "SectionIndex1": 7,
      "SectionIndex2": 11
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "من بیچاره میسوزم شب و روز",
      "CoupletIndex": 30,
      "SectionIndex1": 7,
      "SectionIndex2": 11
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "تو را از گردش چرخ جفا کیش",
      "CoupletIndex": 31,
      "SectionIndex1": 7,
      "SectionIndex2": 12
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "چو من بس عقده ی مشکل بود پیش",
      "CoupletIndex": 31,
      "SectionIndex1": 7,
      "SectionIndex2": 12
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "که از تاب غمت می باید افروخت",
      "CoupletIndex": 32,
      "SectionIndex1": 7,
      "SectionIndex2": 13
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "چو من تا زنده ای می بایدت سوخت",
      "CoupletIndex": 32,
      "SectionIndex1": 7,
      "SectionIndex2": 13
    },
    {
      "VOrder": 60,
      "Position": "Right",
      "Text": "توئی آنمرغ آتش خوار خونخوار",
      "CoupletIndex": 33,
      "SectionIndex1": 7,
      "SectionIndex2": 14
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "کاز آتش خوردنت سرخست منقار",
      "CoupletIndex": 33,
      "SectionIndex1": 7,
      "SectionIndex2": 14
    },
    {
      "VOrder": 62,
      "Position": "Right",
      "Text": "بصد خون دلت دور زمانه",
      "CoupletIndex": 34,
      "SectionIndex1": 7,
      "SectionIndex2": 15
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "دهد، از قطره ی اشک، آب و دانه",
      "CoupletIndex": 34,
      "SectionIndex1": 7,
      "SectionIndex2": 15
    },
    {
      "VOrder": 64,
      "Position": "Right",
      "Text": "بآتش زنده ای همچون سمندر",
      "CoupletIndex": 35,
      "SectionIndex1": 7,
      "SectionIndex2": 16
    },
    {
      "VOrder": 65,
      "Position": "Left",
      "Text": "مگر آب حیات، توست، آذر؟",
      "CoupletIndex": 35,
      "SectionIndex1": 7,
      "SectionIndex2": 16
    },
    {
      "VOrder": 66,
      "Position": "Paragraph",
      "Text": "این دو بیت نیز در صفت بهاران از آن کتابست :",
      "CoupletIndex": 36
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "دهان غنچه گل شبنم آمیز",
      "CoupletIndex": 37,
      "SectionIndex1": 8,
      "SectionIndex2": 10
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "لبش از خنده شیرین شکر ریز",
      "CoupletIndex": 37,
      "SectionIndex1": 8,
      "SectionIndex2": 10
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "ز دلکش غنچه های ناگشوده",
      "CoupletIndex": 38,
      "SectionIndex1": 8,
      "SectionIndex2": 11
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "هزاران سبزه ی گلگون نموده",
      "CoupletIndex": 38,
      "SectionIndex1": 8,
      "SectionIndex2": 11
    },
    {
      "VOrder": 71,
      "Position": "Paragraph",
      "Text": "اشعار خوب او بسیار است و زیاده از این موجب اطناب میشود این چهار بیت هم از اوست :",
      "CoupletIndex": 39
    },
    {
      "VOrder": 72,
      "Position": "Right",
      "Text": "برآی ای جان ز تن بهر نثار اکنون که یار آمد",
      "CoupletIndex": 40,
      "SectionIndex1": 9,
      "SectionIndex2": 19
    },
    {
      "VOrder": 73,
      "Position": "Left",
      "Text": "اگر در عاشقی روزی، مرا خواهی بکار آمد",
      "CoupletIndex": 40,
      "SectionIndex1": 9,
      "SectionIndex2": 19
    },
    {
      "VOrder": 74,
      "Position": "Right",
      "Text": "دل دیوانه ام از یار جدا میگردد",
      "CoupletIndex": 41,
      "SectionIndex1": 24,
      "SectionIndex2": 25
    },
    {
      "VOrder": 75,
      "Position": "Left",
      "Text": "کس ندانست که دیوانه کجا میگردد",
      "CoupletIndex": 41,
      "SectionIndex1": 24,
      "SectionIndex2": 25
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "در عشق تو گر چنین حزین خواهم بود",
      "CoupletIndex": 42,
      "SectionIndex1": 22,
      "SectionIndex2": 23
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "رسوای زمانه بعد از این خواهم بود",
      "CoupletIndex": 42,
      "SectionIndex1": 22,
      "SectionIndex2": 23
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "دلدار اگر توئی، چنان خواهم شد",
      "CoupletIndex": 43,
      "SectionIndex1": 17,
      "SectionIndex2": 18
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "دلداده اگر منم، چنین خواهم بود",
      "CoupletIndex": 43,
      "SectionIndex1": 17,
      "SectionIndex2": 18
    }
  ]
}
