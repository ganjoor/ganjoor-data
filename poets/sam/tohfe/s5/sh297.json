      "Text": "هر سوی که یک نگاه میکرد",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "صد عاشق بیدل آه میکرد",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "لعل لبش، آب زندگانی",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "گفتار، حیات جاودانی",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "برگرد لبش خط چو ریحان",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "خضر است و کنار آب حیوان",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "خطش که دمیده گرد رخسار",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "مانند بنفشه است و گلزار",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "تا بر گل تازه مشک تر ریخت",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "صد فتنه ز هر طرف برانگیخت",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "آن گوی ذقن کسی که دیده",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "چون گوی دمی نیارمیده",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "صدره پی گوی آن زنخدان",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "پشت مه بدرگشته چو گان",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    }
  ]
}
