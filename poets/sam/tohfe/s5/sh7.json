      "VOrder": 24,
      "Position": "Right",
      "Text": "بآب میکده دست و دل از متاع غرور",
      "CoupletIndex": 8,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "رواق مدرسه گر سر نگون شود سهل است",
      "CoupletIndex": 8,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "قصور میکده ی عشق را مبادا قصور",
      "CoupletIndex": 9,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "بنای مدرسه از جنس عالی و دانی",
      "CoupletIndex": 9,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "خراب گشت، خرابات همچنان معمور",
      "CoupletIndex": 10,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "می مغانه که مرد افکن است و تو به شکن",
      "CoupletIndex": 10,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "چنان بدور تو از شیخ و شاب برده شعور",
      "CoupletIndex": 11,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "که زاهدان سحر خیز بر نمیخیزند",
      "CoupletIndex": 11,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "بجای حی علی گردمند نفخه صور",
      "CoupletIndex": 12,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "غریق نعمت گیتی ز ذوق بی خبر است",
      "CoupletIndex": 12,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "گسست رابطه ی تار و پود لیل و نهار",
      "CoupletIndex": 13,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "اگر کری بود این کره ی کشیده عنان",
      "CoupletIndex": 13,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "وگر مجره قوی حلقه ایست حلق فشار",
      "CoupletIndex": 14,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "کمند توست که پیچیده در گلوی سپهر",
      "CoupletIndex": 14,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "سمند توست که بر چیده است ناف و زهار",
      "CoupletIndex": 15,
      "SectionIndex1": 1,
      "SectionIndex2": 14
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "تو را سواره به بین گواگر ندیده کسی",
      "CoupletIndex": 15,
      "SectionIndex1": 1,
      "SectionIndex2": 14
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "که آفتاب بود ثابت آسمان سیار",
      "CoupletIndex": 16,
      "SectionIndex1": 1,
      "SectionIndex2": 15
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "تبارک الله از آن آسمان برق عنان",
      "CoupletIndex": 16,
      "SectionIndex1": 1,
      "SectionIndex2": 15
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "تبارک الله از این برق آسمان رفتار",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 16
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "علی الدوام بود چون سپهر در حرکت",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 16
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "ولی نه چون حرکات سپهر ناهموار",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 17
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "چنان ز عدل تو عالم باعتدال آمد",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 17
    },
    {
      "VOrder": 49,
      "Position": "Paragraph",
      "Text": "این چند بیت بطریق غزل از جمله اشعار اوست :",
      "CoupletIndex": 19
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "دامان ناز بر زده راه که میزنی",
      "CoupletIndex": 20,
      "SectionIndex1": 2,
      "SectionIndex2": 4
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "تا بخاطر باشد ای بد عهد پیمان منت",
      "CoupletIndex": 20,
      "SectionIndex1": 2,
      "SectionIndex2": 4
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "بسته بر انگشت باید رشته جان منت",
      "CoupletIndex": 21,
      "SectionIndex1": 2,
      "SectionIndex2": 5
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "کس را نه بینم روز غم جز سایه در پهلوی خود",
      "CoupletIndex": 21,
      "SectionIndex1": 2,
      "SectionIndex2": 5
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "آنهم چو بینم سوی او گرداند از من روی خود",
      "CoupletIndex": 22,
      "SectionIndex1": 2,
      "SectionIndex2": 6
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "کاج گردون از سرم بیرون برد سودای تو",
      "CoupletIndex": 22,
      "SectionIndex1": 2,
      "SectionIndex2": 6
    },
    {
      "VOrder": 59,
      "Position": "Paragraph",
      "Text": "این دو رباعی هم از اوست :",
      "CoupletIndex": 23
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "دیدار تو بهر عاشق زار تو، به",
      "CoupletIndex": 24,
      "SectionIndex1": 3,
      "SectionIndex2": 5
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "به، بر سر بیمار فرستادی لیک",
      "CoupletIndex": 24,
      "SectionIndex1": 3,
      "SectionIndex2": 5
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "آن سیب ذقن بدست بیمار تو، به",
      "CoupletIndex": 25,
      "SectionIndex1": 3,
      "SectionIndex2": 6
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "شب قصه هجران جگر سوز کنم",
      "CoupletIndex": 25,
      "SectionIndex1": 3,
      "SectionIndex2": 6
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "روز آرزوی وصل دل افروز کنم",
      "CoupletIndex": 26,
      "SectionIndex1": 3,
      "SectionIndex2": 7
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "القصه که بی تو من بصد خون جگر",
      "CoupletIndex": 26,
      "SectionIndex1": 3,
      "SectionIndex2": 7
    },
    {
      "VOrder": 69,
      "Position": "Paragraph",
      "Text": "مثنوی گفته فاما نا تمام ماند این دو بیت از آنجاست :",
      "CoupletIndex": 27
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "کآیینه غبار گیرد از آه",
      "CoupletIndex": 28,
      "SectionIndex1": 4
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "این طرفه که آه صبحگاهی",
      "CoupletIndex": 28,
      "SectionIndex1": 4
    }
  ]
}
