      "Text": "شاهی که سر چرخ برین خاک در اوست",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "در تمشیت کار قضا کارگر اوست",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "اوراق فلک دفتر فضل و هنر اوست",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "ایجاد بشر پرتو فیض نظر اوست",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "بحریست که ارواح ائمه گهر اوست",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "نخلیست که توفیق ولایت ثمر اوست",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 42,
      "Position": "CenteredVerse1",
      "Text": "هیهات که از نخل دگر این ثمر آید",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "ای ذره از خاک درت طینت آدم",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "وز دولت پابوس تو آن خاک مکرم",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "تشریف امامت بوجود تو مسلم",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "ذات تو بمجموعه موجود مقدم",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "ای بنیه عالم بتولای تو محکم",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "تا هست ز عالم اثر بنیه بعالم",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 49,
      "Position": "CenteredVerse1",
      "Text": "مشکل که وجودی ز تو پاکیزه تر آید",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "شاها تو همانی که برین صفحه ایام",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "در اول حال از تو رقم شد خط اسلام",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "پیش از تو ز اسلام نمی برد کسی نام",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "حالا که جهان یافته با شرع تو آرام",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "گر جمعی پریشان سیه نامه بد نام",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "خواهد که این صبح بتزویر شود شام",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 56,
      "Position": "CenteredVerse1",
      "Text": "مپسند که تذویر چنین معتبر آید",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "با تیغ دو سر قصد سر اهل خطا کن",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "سر متصل از تن بسر تیغ جدا کن",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "درد دل شوریده ما بین و دوا کن",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "از لطف تو هر کام که داریم روا کن",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "در کار عدو قاعده صبر رها کن",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "در رهگذر شرع خود اندیشه ما کن",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 63,
      "Position": "CenteredVerse1",
      "Text": "مگذار که خاری بسر رهگذر آید",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 64,
      "Position": "Right",
      "Text": "شاها اثر دوستیست رونق دین است",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 65,
      "Position": "Left",
      "Text": "خوش آنکه درین دوستی از اهل یقین است",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 66,
      "Position": "Right",
      "Text": "هر کس که درت را ز غلامان کمین است",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 67,
      "Position": "Left",
      "Text": "در انجمن اهل وفا صدر نشین است",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 68,
      "Position": "Right",
      "Text": "مداحی تو کار فضولی حزین است",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 69,
      "Position": "Left",
      "Text": "حقا که چنین بوده و آغاز چنین است",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 70,
      "Position": "CenteredVerse1",
      "Text": "تا بلبل طبعش بفصاحت بسر آید",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    }
  ]
}
