      "CoupletSummary": "هوش مصنوعی: اگر روزی دیدار محبت و انتظار میسر نیست، پس چرا در آتش شوق و عشق همیشه بسوزیم؟"
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "در آتش شوق چند سوزی",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "کارم همه ناز و دل‌ربایی‌ست",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: من تمام کارم ناز و دل‌ربایی است و رسم و روال من در این دنیا وفا نداشتن است."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "رسمم چو زمانه بی‌وفایی‌ست",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "پروای رعایتت ندارم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: من نگران نیستم که به چه توجهی داری و احساس نمی‌کنم که مورد توجه خاصی قرار دارم."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "در چشم عنایتت ندارم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "یاری و وفا نبینی از من",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: از من هیچ خیری نداشته باشی و جز بدی و ناراحتی چیزی نخواهی دید."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "جز جور و جفا نبینی از من",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "هرگز نشوی ز وصل من شاد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: هرگز از نزدیکی و پیوند من شاد نخواهی شد و از غم و اندوه من نیز آزاد نخواهی گشت."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "وز بند غمم نگردی آزاد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "زین باغ مراد گل نچینی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: از این باغ آرزوها نخواهی توانست گلی بچینی و بر این شاخه امید نخواهی دید."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "زین شاخ امید بر نبینی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "از شوق من ار فغان برآری",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: اگر از سر شوق برای من فریاد بزنی، من از فریاد و ناله خود را رها می‌کنم."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "من فارغم از فغان و زاری",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "همواره قرین درد می‌باش",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: همیشه با درد همراه هستی و در حال ناله و افسوس زدن هستی."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "با ناله و آه سرد می‌باش",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "پیوسته چو شمع مجلس‌افروز",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: همواره مانند شمعی که مجلس را روشن می‌کند، از شعله‌ی اشتیاق درونم می‌سوزم."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "از آتش اشتیاق می‌سوز",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "گر جامه دری ز شوق چون گل",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: اگر شوق‌زده مانند گل لباس بپوشی و اگر مانند بلبل آواز سر دهی، "
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "ور نعره زنی بسان بلبل",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "وز دیده چو ابر نوبهاری",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: اگر از چشمانم مانند باران بهاری اشک بریزد، این اشک‌ها همچون طغیانی از سیلاب خواهند بود."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "سیلاب سرشک اگر بباری",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    }
  ]
}
