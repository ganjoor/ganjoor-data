      "VOrder": 6,
      "Position": "Left",
      "Text": "وین زهر هلاهل از چه نوشی",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "آتش چه زنی به خرمن خویش",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: چرا به خرمن زندگی خودت آتش می‌زنی؟ هیچ‌کس مانند تو دشمن خودش نباشد."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "کس چون تو مباد دشمن خویش",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "جز درد دل و غمت چه حاصل",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: از این اندیشهٔ نادرست و خیال بیهوده جز درد دل و غم چه بهره‌ای می‌بری؟"
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "زین فکر کج و خیال باطل",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "با شاه گدا نگشت هم‌دوش",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: هرگز گدا با پادشاه هم‌شانه و برابر نشده و گیاه ناچیز با سرو بلند هم‌آغوش نگشته است."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "با سرو گیا نشد هم‌آغوش",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "هست آرزوی توای مهوس",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: ای هوسباز، آرزوی تو مانند خیال گنج در سر مردی تهی‌دست است."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "اندیشۀ گنج و مرد مفلس",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "عنقا نشود به هر بهانه",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: سیمرغ به هیچ بهانه‌ای با زاغ و زغن در یک آشیانه نمی‌نشیند."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "با زاغ و زغن هم‌آشیانه",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "دور است ز راه آشنایی",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: طاووس و خانهٔ روستایی هیچ آشنایی و تناسبی با هم ندارند."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "طاووس و سرای روستایی",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "با دانۀ در و عقد گوهر",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: مهرهٔ بی‌ارزش هرگز با مروارید و گردن‌بند گوهر برابر نمی‌شود."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "خرمهره کجا شود برابر",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "تو چون مگسی و ما هماییم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: تو مانند مگسی و ما مانند هماییم؛ ببین تو کجایی و ما کجا."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "آیا تو کجا و ما کجاییم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "هرچند پی وصال پویی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: هر اندازه در پی وصال بدوی و هر چه در جست‌وجوی مژدهٔ وصل باشی،"
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "هرچند نوید وصل جویی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "هرگز نرسد نویدی از مات",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: هرگز از ما مژدهٔ وصلی به تو نمی‌رسد؛ این امید بسیار دور و ناممکن است."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "هیهات ازین امید هیهات",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    }
  ]
}
