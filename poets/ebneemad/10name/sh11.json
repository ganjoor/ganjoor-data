    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "از چهرۀ زرد و اشک غماز",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "اکنون چه کنم چه چاره سازم",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: اکنون که رازم از پرده بیرون افتاده، نمی‌دانم چه کنم و چه چاره‌ای بیندیشم."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "کز پرده برون فتاد رازم",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "از عشق تو بی‌قرارم ای دوست",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: ای دوست، از عشق تو آرام و قرار ندارم و کسی نیست که به فریادم برسد."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "فریادرسی ندارم ای دوست",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "رحم آر که بی‌دل و اسیرم",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: بر من رحم کن که دل از دست داده و گرفتار توام و جز لطف تو یاوری ندارم."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "جز لطف تو نیست دستگیرم",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "تا طاقت صبر کردنم بود",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: تا زمانی که توان صبر کردن و تحمل غم و اندوه را داشتم،"
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "تاب غم و غصه خوردنم بود",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "خوردم غم عشق و صبر کردم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: غم عشق را تحمل کردم و صبوری نمودم و هیچ‌کس از درد من باخبر نشد."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "و آگاه نشد کسی ز دردم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "صبرم چو نماند در فراقت",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: اما اکنون که در دوری تو صبرم تمام شده و اشتیاقم به تو از حد گذشته است،"
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "وز حد بگذشت اشتیاقت",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "نزدیک تو ای مه دل‌افروز",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: ای معشوق ماه‌روی دل‌افروز، این نامه را با دلی سوزان برای تو نوشتم."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "این نامه نوشتم از سر سوز",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "شرح غم خویش با تو گفتم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: در این نامه شرح غم خود و حال دل زخمی‌ام را برایت بازگفتم."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "حال دل ریش با تو گفتم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "باشد که چو حال من بدانی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: امید است که وقتی از حال من آگاه شدی، از سر وفا و مهربانی،"
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "از روی وفا و مهربانی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "سر با من خسته‌دل درآری",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: به من دل‌خسته توجه کنی و با وصال خود مرا به آرزویم برسانی."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "کامم ز وصال خود برآری",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    }
  ]
