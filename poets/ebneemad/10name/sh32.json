  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "چون باد نسیم نوبهاری",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: وقتی باد نسیم بهاری آن‌همه ناتوانی و بی‌قراری عاشق را دید،"
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "دید آن همه عجز بی‌قراری",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "دانست که نیست احتمالش",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: فهمید که عاشق دیگر تاب تحمل ندارد و دلش برای حال پریشان و شکستهٔ او سوخت."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "دل سوخت بران شکسته حالش",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "آمد سوی آن نگار بدعهد",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: پس نزد آن معشوق پیمان‌شکن آمد و با کوشش بسیار پیغام عاشق را به او رساند."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "بگزارد پیام او به صد جهد",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "گفتش به طریق نکته‌دانی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: با زبانی سنجیده و نکته‌دانانه به معشوق گفت: ای کسی که وصال تو مایهٔ اصلی زندگی است،"
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "کای وصل تو اصل زندگانی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "چون خسته و تشنه در بیابان",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: اگر تشنه‌ای خسته در بیابان جان بدهد، آب حیات دیگر چه سودی برایش دارد؟ یعنی کمک پس از مرگ بی‌فایده است."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "جان داد چه سودش آب حیوان",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
