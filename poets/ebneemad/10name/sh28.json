      "Position": "Left",
      "Text": "اصل تو حیوة جاودان است",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "خونین‌دلم از غمت چو لاله",
