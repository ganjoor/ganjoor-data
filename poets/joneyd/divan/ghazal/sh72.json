      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "که مرد مجلس ایشان نه طالب جاه است",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
