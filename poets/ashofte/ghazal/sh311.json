      "HtmlText": "\u003Cdiv class=\u0022b\u0022 id=\u0022bn1\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eشده غواص به عمان مدیح حیدر\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eتا برآرم ز صدف لؤلؤ لالا گستاخ\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E",
      "CoupletsCount": 1
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "پرده بگرفت زرخ آن گل رعنا گستاخ",
      "CoupletIndex": 0,
      "SectionIndex1": 1,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "نغمه برداشت زدل بلبل شیدا گستاخ",
      "CoupletIndex": 0,
      "SectionIndex1": 1,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "بت پرستان مگر از زشتی ما باخبر است",
      "CoupletIndex": 1,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "که زرخ پرده کشید آن بت زیبا گستاخ",
      "CoupletIndex": 1,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "آتش طور بود چهره اش دیده عبث",
      "CoupletIndex": 2,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "بهر دیدار چرائی بتماشا گستاخ",
      "CoupletIndex": 2,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "زاهدان دار بپا کرده بقتل عاشق",
      "CoupletIndex": 3,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "چون یهودان شده در کشتن عیسی گستاخ",
      "CoupletIndex": 3,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "گفتم ای طوطی خط بر چه زنی بر لب گفت",
      "CoupletIndex": 4,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "هست بر تنک شکر مرغ شکرخا گستاخ",
      "CoupletIndex": 4,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "لب شیرین نفسی بر لب آشفته بنه",
      "CoupletIndex": 5,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "که شکر بشکنهد این طوطی گویا گستاخ",
      "CoupletIndex": 5,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "آب خضر و دم عیسی بخرابات بجوی",
      "CoupletIndex": 6,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "که در آن خانه نشد خضر و مسیحا گستاخ",
      "CoupletIndex": 6,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "من زجنس دگرم نیستم از عالم خاک",
      "CoupletIndex": 7,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "ماهیم میزنم از شوق بدریا گستاخ",
      "CoupletIndex": 7,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "نیستم شب پره آخر که گریزم از مهر",
      "CoupletIndex": 8,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "دوختم دیده بخورشید چو حربا گستاخ",
      "CoupletIndex": 8,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "نه توئی اهرمن ایزلف و رخش بال ملک",
      "CoupletIndex": 9,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "بر سر بال فرشته چو نهی پا گستاخ",
      "CoupletIndex": 9,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "قدمت خدمت آن باده فروش از لیست",
      "CoupletIndex": 10,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "که کنون آدم و نوحند در آنجا گستاخ",
      "CoupletIndex": 10,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "عکسی ای ساقی توحید بیفکن در جام",
      "CoupletIndex": 11,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "تا بنوشم زطرب ساغر صهبا گستاخ",
      "CoupletIndex": 11,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "شده غواص به عمان مدیح حیدر",
      "CoupletIndex": 12,
      "SectionIndex1": 1,
      "SectionIndex2": 14
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "تا برآرم ز صدف لؤلؤ لالا گستاخ",
      "CoupletIndex": 12,
      "SectionIndex1": 1,
      "SectionIndex2": 14
    }
  ]
