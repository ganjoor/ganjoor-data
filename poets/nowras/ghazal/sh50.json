      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "چون رگ یاقوت موج ناله‌ی بلبل شود",
      "CoupletIndex": 3,
      "SectionIndex1": 0
