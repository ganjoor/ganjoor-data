      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "آدمی گویا ندارد عالم آسودگی",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
