      "Text": "کند بنیاد مرا چون سیل بی زنهار یار",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "کرده کسب این ماجرا از چرخ کج رفتار یار",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
