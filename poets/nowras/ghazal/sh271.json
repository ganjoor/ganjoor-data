      "Position": "Right",
      "Text": "فزاید هوش را کیفیت آن",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "قماش نشاه ام صهبا ندارد",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
