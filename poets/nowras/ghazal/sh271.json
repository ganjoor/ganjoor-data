      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "مکن از تنگ چشمان لطف باور",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "که مرواید جز دریا ندارد",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
