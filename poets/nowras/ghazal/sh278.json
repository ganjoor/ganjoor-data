      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "شبنم شرمش ز مهر حسن عالم‌سوزتر",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "گردش چشمش ز دور چرخ پرنیرنگ‌تر",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "در گداز شیشهٔ صبر از نگه چالاک‌تر",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "در قمار دلبری از ناز زرین‌چنگ‌تر",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "از برهمن رخ نتابد بت به آن سنگین‌دلی",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
