      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "از نگاه گرم لطف‌آمیز او گشتم کباب",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "می‌شود سوزنده‌تر آتش چو شد بی‌رنگ‌تر",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "گر کمر بندد مرا اقبال لطفش می‌کشم",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "از نزاکت در بر آن موی میان را تنگ‌تر",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
