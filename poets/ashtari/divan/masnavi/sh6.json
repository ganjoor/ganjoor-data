      "Text": "من دل به نگاه دوست بسته",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "عهد همه غیر او شکسته",
