      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "کو تا به بیند آنکه لبالب شود مدام",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
