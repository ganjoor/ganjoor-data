      "HtmlText": "\u003Cdiv class=\u0022b2\u0022 id=\u0022bn1\u0022\u003E\u003Cp\u003Eنشود جور ما بدینسان جور\u003C/p\u003E\r\n\u003Cp\u003Eمیکنم کارت عاقبت با زور\u003C/p\u003E\u003C/div\u003E",
      "CoupletsCount": 1
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "چاره کار من بریدن ازوست",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "کاینچنین عشق با چو او نه نکوست",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "چند دلبر جفا کند، من صبر",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "آخر این دل مگر ز آهن و روست",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "آنکه رویش بود چو قرص قمر",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "آنکه مویش چو نافه آهوست",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "با حریفان سفله یار و شفیق",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "با رفیقان پاکباز عدوست",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "شمع جمع جماعتی بد نام",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "شاهد بزم مردمی بدخوست",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "سخت با شیشه دلم چون سنگ",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "سنگ اغیار را بسان سبوست",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "من دهم جان او دهد دشنام",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "ایخدا سنگ پاست این یا روست",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "ای صبا گو بدان پری رخسار",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "که نه نیکوست این جفا، یا دوست!",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 17,
      "Position": "CenteredVerse1",
      "Text": "چند سوزی مرا در آتش تیز",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "SectionIndex3": 5
    },
    {
      "VOrder": 18,
      "Position": "CenteredVerse2",
      "Text": "با همه یار و با منی بستیز",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "SectionIndex3": 5
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "ای بت سرو قد سیمین ساق",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "ای جهانی بدیدنت مشتاق",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "گونه در دست زلف پرشکنت",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "مثل سیب سرخ و دست چلاق",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "چند از پشت در کنی جلوه",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "قدمی نه ز لطف توی اطاق",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "تا شوم با تو یار یکساعت",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "طاقتم گشته از جدائی طاق",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "مژده وصل میدهی که بشوق",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "متحمل شویم بار فراق",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "رفته باشد ز دست، مار زده",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "از عراق آورند تا تریاق",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "دیگران خفته در کنار تو مست",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "ما در این گوشه میمکیم سماق",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 33,
      "Position": "CenteredVerse1",
      "Text": "نشود جور ما بدینسان جور",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "SectionIndex3": 6
    },
    {
      "VOrder": 34,
      "Position": "CenteredVerse2",
      "Text": "میکنم کارت عاقبت با زور",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "SectionIndex3": 6
    }
  ]
}
