      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "بسیار کتاب بود و یک حرف نبود",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "یک قطره درون آنهمه ظرف نبود",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "رفتم بر شیخ و گفتم ای مایه زهد",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "ز اسرار ازل چگونه آگاه شدی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 11,
      "Position": "CenteredVerse1",
      "Text": "خندید و ز کبر گفت: در سایه زهد",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 12,
      "Position": "Right",
      "Text": "بر صوفی خرقه پوش آوردم روی",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 13,
      "Position": "Left",
      "Text": "گفتم که ز سر حق مرا حرفی گوی",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "کوبید بهم دستی و هوئی زد و گفت",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "در خرقه من به بین و اسرار بجوی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "رفتم به نیاز بر در باده فروش",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "گفتم تو چه دانی ز ازل گفت خموش",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "از خم به سبو کرد شرابی لب تلخ",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "فرمود که این بگیر و بردار و بنوش",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "سرمست شدم ز جسم و جان دور شدم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "با بال خیال تا نشابور شدم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "بر تربت خیام دو صد بوسه زدم",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "دیدم نوری که خیره زان نور شدم",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "گفتم به ادب: که ای تو جانرا معبود",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "زین خلقت بیهوده چه باشد مقصود",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "جامی دگر از شراب نابم پیمود",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "وانگه بزبان حال با من فرمود:",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "«اسرار ازل را نه تو دانی و نه من",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "وین حل معما نه تو خوانی و نه من »",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "«خود در پس پرده گفتگوی من و تست",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "چون پرده برافتد نه تو مانی و نه من »",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    }
  ]
}
