    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "بود آن دم هزاران در هزاران",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "به از من کینه ج وی نامداران",
