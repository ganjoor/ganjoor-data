  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "هنون چون رفت گام چند از پیش",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "نکو اندیشه مرد آن همت اندیش",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "در آن روزی که بهر جنگ راون",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
