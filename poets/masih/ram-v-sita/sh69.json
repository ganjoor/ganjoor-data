  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "شنو اح وال خود ز آغاز و انجام",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "پریزادی که بودش انجنی نام",
