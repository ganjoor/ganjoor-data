      "Text": "چو لچمن کار اندرجت چنان ساخت",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "سرش را پیش پای رام انداخت",
      "CoupletIndex": 29,
