  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "شبی چو حلقهٔ گیسوی لعبتان چگل",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "سواد دیدهٔ پر نور و نوردیدهٔ دل",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "شبی چو زلف نگار از نسیم غالیه بو",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "شبی چو روز وصال از نشاط مستعجل",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
