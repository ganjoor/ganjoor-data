      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "کرد از نخست غرقه به خون چون زبان شمع",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
