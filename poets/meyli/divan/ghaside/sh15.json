      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "آسان رهی به پیش من ناتوان نهاد",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "تا بر زبان نیاورم آزار دل ازو",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "اوّل به عشوه بند مرا بر زبان نهاد",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "سرگشتهٔ در تو ز پا خویش را فکند",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
