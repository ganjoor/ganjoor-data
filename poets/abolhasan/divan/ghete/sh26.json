    {
      "Index": 0,
      "Number": 1,
      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": "الم",
      "PlainText": "ای آن که ز ناله میکنی منع\r\nزنهار مده دگر ملالم\r\nانصاف نداری و مروت\r\nیا نیستت آگهی ز حالم\r\nبلبل با گل نشسته ناله\r\nمن دور ز دلبرم ننالم",
