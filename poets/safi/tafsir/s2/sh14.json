      "VOrder": 12,
      "Position": "Left",
      "Text": "نی به نفی صدق ز ارباب نیاز",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "جملگی گفتند پاکی مر تو راست",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "ما ندانیم آنچه میدانی تو راست",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "جز که آموزی تو بر ما ای علیم",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "دانشی که هم علیمی هم حکیم",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "این شهادت بود زآن کاندر حضور",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "خویش را دیدند در عین قصور",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "زآن کمالی کاندر انسان حق نهاد",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "بر ملایک اطلاع از پیش داد",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "وآنگه ایشان از تخلّف دم زدند",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "دم به نفی از رتبۀ آدم زدند",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "هست یعنی حق منزّه ای جواد",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "زینکه اندر فعل او باشد فساد",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "بودشان آگاهی از این کز حدود",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "نیستشان دیگر ترقی در وجود",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Paragraph",
      "Text": "« در بیان قصۀ ملایک و اعتراف آنها به عجز خود که لا عِلْم لَنا »",
      "CoupletIndex": 14
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "لاجرم گفتند، لا عِلْمَ لَنا",
      "CoupletIndex": 15,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "غیر آن کآموخت بر ما، رب ما",
      "CoupletIndex": 15,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "یعنی آنچه لازم ایجاد ماست",
      "CoupletIndex": 16,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "باعث بینائی و بنیاد ماست",
      "CoupletIndex": 16,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "زآن به آدم گفت خلاّق بشر",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "سویشان از نام هاشان ده خبر",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "گفت أنْبِئْهُم نه عَلَّمهُم که تا",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "علمشان گردد سبب بر اجتبا",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "کازدیاد علم و عرفان و ادب",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "هست در معنی ترقی را سبب",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "شه تو را گر زر دهد قارون شوی",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "ور خبر از گنج ، کی افزون شوی؟",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "زآنچه خود داری تو را آگاه کرد",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "باید از این نیز شکر شاه کرد",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "کاین هم اکرامی از آن آزاده است",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "داده ای باشد کز اول داده است",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "هیچ کس جز داد او چیزی نداشت",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "خود نبُد چیز ی و تمییزی نداشت",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "خاک کِبوَد تا شناسد خدمتش",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "گشت اینسان تا تو دانی قدرتش",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "داد آدم پس خبر زآن نامها",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "یعنی از آن رتبه ها و اکرامها",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "گفت آیا من نگفتم بی ز ریب",
      "CoupletIndex": 26,
      "SectionIndex1": 1,
      "SectionIndex2": 14
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "کز شما داناترم بر علم غیب",
      "CoupletIndex": 26,
      "SectionIndex1": 1,
      "SectionIndex2": 14
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "اعلمم بر غیبِ ارض و آسمان",
      "CoupletIndex": 27,
      "SectionIndex1": 1,
      "SectionIndex2": 15
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "وآنچه دارید از عیان و از نهان",
      "CoupletIndex": 27,
      "SectionIndex1": 1,
      "SectionIndex2": 15
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "کآن بود عرفان و حب مستتر",
      "CoupletIndex": 28,
      "SectionIndex1": 1,
      "SectionIndex2": 16
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "وآن ودیعه بود در ذات بشر",
      "CoupletIndex": 28,
      "SectionIndex1": 1,
      "SectionIndex2": 16
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "بر سبیل علم ، او را اختیار",
      "CoupletIndex": 29,
      "SectionIndex1": 1,
      "SectionIndex2": 17
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "کرد بهر اصطفی پروردگار",
      "CoupletIndex": 29,
      "SectionIndex1": 1,
      "SectionIndex2": 17
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "زاصطفایش بود آگه ذوالجلال",
      "CoupletIndex": 30,
      "SectionIndex1": 1,
      "SectionIndex2": 18
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "وآن ملایک را نبود این احتمال",
      "CoupletIndex": 30,
      "SectionIndex1": 1,
      "SectionIndex2": 18
    },
    {
      "VOrder": 60,
      "Position": "Right",
      "Text": "زآن ره آدم را به کَرّمنا ستود",
      "CoupletIndex": 31,
      "SectionIndex1": 1,
      "SectionIndex2": 19
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "وین فضیلت ثابت اندر علم بود",
      "CoupletIndex": 31,
      "SectionIndex1": 1,
      "SectionIndex2": 19
    },
    {
      "VOrder": 62,
      "Position": "Right",
      "Text": "گفت من داناترم بر آن امور",
      "CoupletIndex": 32,
      "SectionIndex1": 1,
      "SectionIndex2": 20
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "از شما یعنی بر آن ظلم و قصور",
      "CoupletIndex": 32,
      "SectionIndex1": 1,
      "SectionIndex2": 20
    },
    {
      "VOrder": 64,
      "Position": "Right",
      "Text": "وان شرور، و آن فضولی، وان فساد",
      "CoupletIndex": 33,
      "SectionIndex1": 1,
      "SectionIndex2": 21
    },
    {
      "VOrder": 65,
      "Position": "Left",
      "Text": "کآدمی را بود مخفی در نهاد",
      "CoupletIndex": 33,
      "SectionIndex1": 1,
      "SectionIndex2": 21
    },
    {
      "VOrder": 66,
      "Position": "Right",
      "Text": "این ز مَا تُبدُون عیان شد یک به یک",
      "CoupletIndex": 34,
      "SectionIndex1": 1,
      "SectionIndex2": 22
    },
    {
      "VOrder": 67,
      "Position": "Left",
      "Text": "معنی مَا تَکْتُمُون قدس ملک",
      "CoupletIndex": 34,
      "SectionIndex1": 1,
      "SectionIndex2": 22
    },
    {
      "VOrder": 68,
      "Position": "Right",
      "Text": "قدس و رجحان و شرافت مکتتم",
      "CoupletIndex": 35,
      "SectionIndex1": 1,
      "SectionIndex2": 23
    },
    {
      "VOrder": 69,
      "Position": "Left",
      "Text": "در ملک بود و نشد افزون و کم",
      "CoupletIndex": 35,
      "SectionIndex1": 1,
      "SectionIndex2": 23
    },
    {
      "VOrder": 70,
      "Position": "Right",
      "Text": "ثابتند اندر کمال خود مدام",
      "CoupletIndex": 36,
      "SectionIndex1": 1,
      "SectionIndex2": 24
    },
    {
      "VOrder": 71,
      "Position": "Left",
      "Text": "سالم از ضعف و ضلالت والسلام",
      "CoupletIndex": 36,
      "SectionIndex1": 1,
      "SectionIndex2": 24
    }
  ]
}
