  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "وَ إِذِ اِبْتَلیٰ إِبْرٰاهِیمَ رَبُّهُ بِکَلِمٰاتٍ فَأَتَمَّهُنَّ قٰالَ إِنِّی جٰاعِلُکَ لِلنّٰاسِ إِمٰاماً قٰالَ وَ مِنْ ذُرِّیَّتِی قٰالَ لاٰ یَنٰالُ عَهْدِی اَلظّٰالِمِینَ (۱۲۴)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "و هنگامی که آزمود ابراهیم را پروردگارش بسخنان پس تمام کرد آنها را گفت بدرستی که من گرداننده‌ام تو را برای مردم پیشوا گفت و از نسل من گفت نمی‌رسد عهد من ستمکاران را (۱۲۴)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "وآن زمان که آزموده شد خلیل",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "یعنی ابراهیم از رب جلیل",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "بر کلامی چند بس کرد آن تمام",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "گفت، گردانم به خلقانت امام",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "گفت، هست این بهر فرزندان من؟",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "گفت، نی ظالم ندارد این فطن",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "بعضی از ذریّه ات ظالم شوند",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "بر صفات و سنّت تو نگروند",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "عهد من هرگز به ظالم کی رسد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "کی نسیم فرودین بر دی رسد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
