      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "لَیْسَ عَلَیْکَ هُدٰاهُمْ وَ لٰکِنَّ اَللّٰهَ یَهْدِی مَنْ یَشٰاءُ وَ مٰا تُنْفِقُوا مِنْ خَیْرٍ فَلِأَنْفُسِکُمْ وَ مٰا تُنْفِقُونَ إِلاَّ اِبْتِغٰاءَ وَجْهِ اَللّٰهِ وَ مٰا تُنْفِقُوا مِنْ خَیْرٍ یُوَفَّ إِلَیْکُمْ وَ أَنْتُمْ لاٰ تُظْلَمُونَ (۲۷۲) لِلْفُقَرٰاءِ اَلَّذِینَ أُحْصِرُوا فِی سَبِیلِ اَللّٰهِ لاٰ یَسْتَطِیعُونَ ضَرْباً فِی اَلْأَرْضِ یَحْسَبُهُمُ اَلْجٰاهِلُ أَغْنِیٰاءَ مِنَ اَلتَّعَفُّفِ تَعْرِفُهُمْ بِسِیمٰاهُمْ لاٰ یَسْئَلُونَ اَلنّٰاسَ إِلْحٰافاً وَ مٰا تُنْفِقُوا مِنْ خَیْرٍ فَإِنَّ اَللّٰهَ بِهِ عَلِیمٌ (۲۷۳)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "نیست بر تو هدایتشان و لیکن خدا راه می‌نماید آن را که خواهد و آنچه را که انفاق می‌کنید از مالی پس باشد از برای خودهامان و انفاق نمی‌کنید مگر از برای طلب رضای خدا و آنچه را انفاق می‌کنید از مالی بتمام داده می‌شود بشما و شما ستمدیده نشوید (۲۷۲) از برای درویشانیست که باز داشته شده‌اند در راه خدا که توانایی ندارند سیر کردنی در زمین می‌پندار ایشان را نادان بحال ایشان توانگران از عفت گزینی می‌شناسی ایشان را بعلامتشان سؤال نمی‌کنند از مردمان بابرام و آنچه را انفاق می‌کنید از مالی پس خدا بآن دانا است (۲۷۳)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "از تو جبری نیستشان بر راه راست",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "لیک حق هادی است هر کس را که خواست",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "در مقام صدقه یعنی عرض دین",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "نیست بر مسکین روا از مؤمنین",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "وین نباشد جز ز روی اختیار",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "کلفت است آن گر شود بر خلق بار",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "از شما اعطاست بر مسکین و بس",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "تا ز حق توفیق چبود بهر کس",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "مشرکی از مسلمی از اقرباء",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "خواست چیزی ، کرد آن مسلم اِباء",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "گفت ایمان آوری گر بر رسول",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "بر تو احسان را به جان دارم قبول",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "آورم حقّ قرابت را بجا",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "ور نه احسان نیست بر مشرک روا",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "آمد این آیت که دین تحمیل نیست",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "وقت صدقه عرض دین تجلیل نیست",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "می کنید انفاق گر چیزی ز خیر",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "کرده اید آن بهر خود نی بهر غیر",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "نیست آن انفاق بر اهل سؤال",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "جز کز او خوشنود گردد ذوالجلال",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "حق نه بهر دین به کس روزی دهد",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "نی به ترک شرک فیروزی دهد",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "نعمت دنیا به خلقان عام کرد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "بر مسلمان و مجوس اکرام کرد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "ای خدا ما را به نیکی راه ده",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "بر رضای خود دلِ آگاه ده",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "ما ندانیم آنچه حقّ بندگی است",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "حاصل و محصولمان شرمندگی است",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "تو به ما آموز آنچه از ما سزاست",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "کن هم اصلاح ار عملها بر خطاست",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "ما که ایم و چیست استحقاق ما",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "تا که باشد جود ما و انفاق ما",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "آنچه از خیر آورید انفاق و برّ",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "بر شما گردد تمام از جهر و سرّ",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "هم ز منع آنکه باشد ظلم و غم",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "هیچ ناید بر شما وارد ستم",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "آنکه هِشت انفاق را مظلوم اوست",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "که ز پاداش و جزا ء محروم اوست",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "بر فقیرانی که دارند امتناع",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "در طریق حق ز کسب و انتفاع",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "نیستشان هیچ استطاعت بر سفر",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "بهر تحصیل معاش مختصر",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "ظنّ جهال این بود کآن قوم صاف",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "اغنیاء باشند از فرط عفاف",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "حال خود دارند پنهان از انام",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "تو به سیما می شناسی آن کرام",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "نیستشان از مردمان روی سؤال",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "نی به گفتار و نه از آثار و حال",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "نیستشان ابرام در خواهش ز کس",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "نی که بی ابرام دارند این هوس",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "بلکه چشم از غیر حق پوشیده اند",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "جام استغناء ز حق نوشیده اند",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "هر چه از نیکی به درویشان کنید",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "وز ولاء، انفاق بر ایشان کنید",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "حق بر آن داناست هم پاداش نیک",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "هست بر خلق از خدای بی شریک",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    }
  ]
}
