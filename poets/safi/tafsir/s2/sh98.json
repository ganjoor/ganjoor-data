      "HtmlText": "\u003Cdiv class=\u0022b\u0022 id=\u0022bn1\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eعارفان از کار او بردند پی\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eبر رموز معرفت و اسرار وی\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E",
      "CoupletsCount": 1
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "وَ مِنَ اَلنّٰاسِ مَنْ یَشْرِی نَفْسَهُ اِبْتِغٰاءَ مَرْضٰاتِ اَللّٰهِ وَ اَللّٰهُ رَؤُفٌ بِالْعِبٰادِ (۲۰۷)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "و از مردمان آنکه می‌فروشد خودش را برای جستن خشنودی خدا و خدا مهربانست بر بندگان (۲۰۷)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "هم کسی از مردمان باشد که او",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "می فروشد نفس خود را مو به مو",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "تا مگر جوید رضای ذوالجلال",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "زین رضا جویی بود خیر الرجال",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "این نشان شیر مردان حق است",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "که از ایشان کار دین با رونق است",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "افکند خصم ار خیو بر رویشان",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "منقلب هرگز نگردد خویشان",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "ترک میل خود کنند از عقل چست",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "تا رضای دوست بتوانند جست",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "جای احمد (ص) آن رسول مقتدی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "خفته اند از بهر حفظش بر فدی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "ای ملایک بر چنین مردان مرد",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "سجده ها از روی عشق آرید و درد",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "این چنین مردی رئوف و عادل است",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "حیدر شیرافکن دریا دل است",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "روز هیجاء پشت او دشمن ندید",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "وز نهیبش زهره ها بر تن درید",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "پس خدا شاید که باشد مهربان",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "بر عبادی این چنین پاکیزه جان",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "گفت حق با جبرئیل آیا شما",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "جان خود سازید بر دیگر فدا",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "گفت نبود در ملایک این وداد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "گفت حق پس در زمین بینید شاد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "مر علی (ع) بر جای احمد (ص) خفته است",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "ترک جان بر حفظ احمد (ص) گفته است",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "بر زمین از آسمان آرید رو",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "فضل آمد تا نکو بینید از او",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "تا ببینید از چه معنی بوالبشر",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "گشت مسجود ملایک سر به سر",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "تا ببینید از چه رو آدم سر است",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "آفرینش چون صدف، او گوهر است",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "تا ببینید آن رموز مختفی",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "که نهان می بود در ذات صفی",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "وآنکه گفتم با شما اندر زمین",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "خلق خواهم کرد خلقی ز آب و طین",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "مر شما گفتید این سفکِ دِماست",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "دور از اندیشه و آراء ماست",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "بی خبر بودید کاینسان آدمی",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "خواهد آمد در زمین صاحب دمی",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "صد هزار ار خلق ریزد خونشان",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "عالم و آدم شود محزونشان",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "تا به حشر ، این خلق عالم سر به سر",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "خونشان ریزد ز تیغ یکدگر",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "سهل باشد گر چنین آدم یکی",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "در جهان پیدا شود دور از شکی",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "بر زمین آرید رو وز من سلام",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "بر علی (ع) گویید با صد احترام",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "او مرا اندر زمین باشد ولیّ",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "گشت ظاهر از علی(ع) ذات علی",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "هم بدینسان است رسم و راه عشق",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "تا ابد گر محرمی بر شاه عشق",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "جان و سر را تا نسازی خاک عشق",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "کی چو احمد (ص) بگذری ز افلاک عشق",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "فقر خواهی شیوة تسلیم گیر",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "از علی(ع) رسم فناء تعلیم گیر",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "عارفان از کار او بردند پی",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "بر رموز معرفت و اسرار وی",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    }
  ]
}
