      "Text": "حٰافِظُوا عَلَی اَلصَّلَوٰاتِ وَ اَلصَّلاٰةِ اَلْوُسْطیٰ وَ قُومُوا لِلّٰهِ قٰانِتِینَ (۲۳۸) فَإِنْ خِفْتُمْ فَرِجٰالاً أَوْ رُکْبٰاناً فَإِذٰا أَمِنْتُمْ فَاذْکُرُوا اَللّٰهَ کَمٰا عَلَّمَکُمْ مٰا لَمْ تَکُونُوا تَعْلَمُونَ (۲۳۹) وَ اَلَّذِینَ یُتَوَفَّوْنَ مِنْکُمْ وَ یَذَرُونَ أَزْوٰاجاً وَصِیَّةً لِأَزْوٰاجِهِمْ مَتٰاعاً إِلَی اَلْحَوْلِ غَیْرَ إِخْرٰاجٍ فَإِنْ خَرَجْنَ فَلاٰ جُنٰاحَ عَلَیْکُمْ فِی مٰا فَعَلْنَ فِی أَنْفُسِهِنَّ مِنْ مَعْرُوفٍ وَ اَللّٰهُ عَزِیزٌ حَکِیمٌ (۲۴۰) وَ لِلْمُطَلَّقٰاتِ مَتٰاعٌ بِالْمَعْرُوفِ حَقًّا عَلَی اَلْمُتَّقِینَ (۲۴۱) کَذٰلِکَ یُبَیِّنُ اَللّٰهُ لَکُمْ آیٰاتِهِ لَعَلَّکُمْ تَعْقِلُونَ (۲۴۲)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "نگاهداری کنید بر نمازها و نماز میانه و برپا شوید برای خدا دست‌به‌دعابرداشتگان (۲۳۸) پس اگر ترسیدید پس پیادگان و سواران پس چون ایمن شدید پس یاد بیارید خدا را هم چنان که آموخت شما را آنچه که نبودید که بدانید (۲۳۹) و آن کسانی که وفات می‌کنند از شما و وا می‌گذارند جفتها را وصیتی مر جفتهاشان را بهرۀ تا سال بدون بیرون کردن پس اگر بیرون روند پس نیست باکی بر شما در آنچه کردند در خودشان از نیکی و خدا غالب درست کردار است (۲۴۰) و مر طلاق داده شدها را بهره‌ایست بنیکی براستی بر پرهیزکاران (۲۴۱) همچنین ظاهر می‌کند خدا برای شما آیتهایش را تا شاید شما دریابید بعقل (۲۴۲)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "« در ببیان نماز پنجگانه خاصه نماز وسطی »",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Right",
      "Text": "حفظ باید کرد آداب نماز",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Left",
      "Text": "خاصه وسطی را که دارد امتیاز",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "هم به پا باشید حق را قانتین",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "ایستید اعنی به فرمانش چنین",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "قولها در وسط باشد مختلف",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "تا به قول خاص کبود معترف",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "وسط باشد نزد صوفی ذکر قلب",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "که از او انواع غفلت هاست سلب",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Right",
      "Text": "جمعه را دارند اهل ذکر پاس",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Left",
      "Text": "شد در او جمعیت فکر و حواس",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "وآن نماز وسط در نصف النهار",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "مکنی از جمعیت است و وصل یار",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "وسط از آن گفتند کاشیاء هر کدام",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "چون رسند اندر وسط گردند تام",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "همچو شمس اندر میان آسمان",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "یا قمر در نیمۀ هر مه عیان",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "آن نماز وسط هم در اعتدال",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "خاص باشد تام هم عند الکمال",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "ور بترسید از قعود و از قیام",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "راجل و راکب نمایید اهتمام",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "یعنی ار در ره بود خوف و خطر",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "از برای قائمین اندر سفر",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "یا پیاده یا سواره بر فرس",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "راکع و ساجد شویدش هر نفس",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "در صفات و ذات او گردید مات",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "حق به تحقیق این بود اندر صلات",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "پس چو باز ایمن شوید اندر مکان",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "ذکر او گویید با قلب و لسان",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "همچنان که بر شما آموخت باز",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "آنچه را دانا نبودید از نیاز",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "وآن کسانی که بمیرند از شما",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "جفتها مانند ز ایشان در سرا",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "پس وصیّت مینمایند آن رجال",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "که بماند زن به خانه تا به سال",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "نفقه و کسوه بگیرد بی ستم",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "خارج از مسکن نگردد یک قدم",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "پس اگر رفتند بیرون زآن خروج",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "بر شما نبود گناهی در فروج",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "زآنچه کردند آن زمان بر نفس خود",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "وآن بود معروف و خوش نی زشت و بد",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "حق عزیز است اعنی او را عجز نیست",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "قدرتش بر کلّ اشیاء مستوی است",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "هم حکیم است آنچه یعنی در صدور",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "آید از وی، نیست هیچ او را قصور",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "حکمت حق کرد چون صورت قبول",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "شد کتاب و شرع و احکام عقول",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "بود هر جا حکم او بر حکمتی",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "کز رهی وارد نیامد علتی",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "تا تو دانی حکمت ناموس را",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "یابی از عقل آیت محسوس را",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "هست نسوان مطلّق را متاع",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "بهره و برخورد نیکو و انتفاع",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "آنچه معروف است و حق بر متقین",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "احتیاط این است نزد شرع و دین",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "می کند آیات خود را حق بیان",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "مر بیابید آن به نور عقل و جان",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    }
  ]
}
