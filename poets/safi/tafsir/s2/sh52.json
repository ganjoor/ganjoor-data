  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "مٰا نَنْسَخْ مِنْ آیَةٍ أَوْ نُنْسِهٰا نَأْتِ بِخَیْرٍ مِنْهٰا أَوْ مِثْلِهٰا أَ لَمْ تَعْلَمْ أَنَّ اَللّٰهَ عَلیٰ کُلِّ شَیْ‌ءٍ قَدِیرٌ (۱۰۶)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "آنچه منسوخ کنیم از آیتی یا ترک کنیم آن را بیاریم بهتر از آن یا مانند آن را آیا نمی‌دانی که خدا بر هر چیزی توانا است (۱۰۶)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "آنچه شد منسوخ ز آیت بیش و کم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "یا که ترک ، آریم بهتر باز هم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "زآن نکوتر یا که مثلش را عیان",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "آوریم از بهر اصلاح و نشان",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "یا ندانی اینکه داناییم ما",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "بر هر آن چیزی تواناییم ما",
