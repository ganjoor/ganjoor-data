      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "یا به تاریکی چراغ آورده است",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "یا رهاندستت به وقتی از خطر",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "یا زمانی بود با تو همسفر",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "یا طبیب آورده در بیماریت",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "یا به کاری کرده وقتی یاریت",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "حب او را میدهی بر دل قرار",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "ذکر احسانش کنی لیل و نهار",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "گرچه دانی بود بر خیر او سبب",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "نیست قادر کس به چیزی غیر رب",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "آنکه یک خیرش تو را موجود کرد",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "از عدم آورد و بود از جود کرد",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "گر که آری خیر او را در قلم",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "هست بیش از برگ و باران دم به دم",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "نطفه بودی دادت از آن رتبه نقل",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "تا رساندت بر کمال و علم و عقل",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "آن عطاهایی که داد از فضل و داد",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "کافرم گر یک دم آوردی به یاد",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "جای شکر آن همه اکرام و خیر",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "حب او دادی گرفتی حب غیر",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "بر غلامت گر تو یک احسان کنی",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "مشرک ار شد ترک او آسان کنی",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "نان تو خورد و به غیر انداخت مهر",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "رانی اش کو را نبینی روی و چهر",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "نه به او جان داده ای و نه وجود",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "نه ز غیب آورده ایش اندر شهود",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "نه ز نطفه برده ای او را به عقل",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "نز کمالش داده ای صد گونه نقل",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "نی ز آفاتش یکی بی گاه و گاه",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "بوده ای هرگز به عمر او را پناه",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "نی خبر داری که چون از سانحات",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "رسته است و از کجا دارد حیات",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "چشم داری خدمت از وی روز و شب",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "دیر خیزد می کنی بر وی غضب",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "جز تو می خواهی نداند مهتری",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "وز تو بهر دل سپردن بهتری",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "پس ز مولایی که معبود تو است",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "باعث جان، بانی بودِ تو است",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "در وجود آوردت از کتم عدم",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "با شئوناتی که ناید در قلم",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "هم شوی راجع به سوی او یقین",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "عاجز و مسکین و محتاج و غبین",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "دل نهی بر غیر ، بس باشد عجب",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "همچنان که بست باید دل به رب",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "یا ندانی هر چه را داری تو دوست",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "چون برافتد پرده، معبود تو اوست",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "گاه معبود تو باشد جاه و مال",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "گاه اسب و استر و اهل و عیال",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "وآن کسان که با خدا باشند دوست",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "کرده بیرون حب غیر، از مغز و پوست",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "غیر حق بینند کی چیزی که او",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "پیششان محبوب باشد یا عدو",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    }
  ]
}
