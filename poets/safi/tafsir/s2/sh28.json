      "VOrder": 36,
      "Position": "Left",
      "Text": "کآید از حق بهر سالک دم به دم",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "وآن ریاح رحمت و نفحات ذات",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
