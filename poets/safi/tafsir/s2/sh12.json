      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "وَ إِذْ قٰالَ رَبُّکَ لِلْمَلاٰئِکَةِ إِنِّی جٰاعِلٌ فِی اَلْأَرْضِ خَلِیفَةً قٰالُوا أَ تَجْعَلُ فِیهٰا مَنْ یُفْسِدُ فِیهٰا وَ یَسْفِکُ اَلدِّمٰاءَ وَ نَحْنُ نُسَبِّحُ بِحَمْدِکَ وَ نُقَدِّسُ لَکَ قٰالَ إِنِّی أَعْلَمُ مٰا لاٰ تَعْلَمُونَ (۳۰)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "و چون گفت پروردگارت مر فرشتگان را بدرستی که من پدید آورنده او در زمین جانشین، گفتند آیا می‌گردانی در زمین کسی را که کند در آن و بریزد خونها را و ما بپاکی مشغولیم بحمد تو و تنزیه کنیم مر تو را؟ گفت بدرستی که من داناترم آنچه را که نمی‌دانید (۳۰)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "« در تحقیق خلیفة الله و بیان حقیقت آن »",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Right",
      "Text": "با ملایک گفت پس پروردگار",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Left",
      "Text": "در زمین سازم خلیفه استوار",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "عرشیان گفتند این باشد فساد",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "در زمین سَفک دِمَآء است این نه داد",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "ما به تسبیح و به حمدت یک دلیم",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "ذات پاکت را گواه کاملیم",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "گفت می دانم من آن چیزی که نیست",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "بر شما معلوم و آن سرّ خفی است",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Right",
      "Text": "اعتبار آن را به حال خویش کن",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Left",
      "Text": "اندکی در نفس خود تفتیش کن",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "هستی اندر غیب، غیبِ غیبِ تو است",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "یعنی اندر روح ، پاک از عیب تو است",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "ماورای غیبِ غیب استت وجود",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "پس به غیبِ غیب قلب ذی عهود",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "پس به غیب نفس که ادنی غیب توست",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "وآن سماء دُنیئی لا ریب توست",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "بر جوارح ظاهر آید زآن غیوب",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "کوست نفس و قلب و روح بی کروب",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "از جوارح قول و فعلی شد پدید",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "وآن بود کفر و شهادت را کلید",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "گشت اطوار جوارح بیش و کم",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "جمله ز ابدایی و تکوینی اَعَم",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "از مقامات وجود آثار تو",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "تا چه باشد ضبط در انبار تو",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "بر خلیفه قول رب العالمین",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "کز بشر سازم هویدا در زمین",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "این بُوَد کو بود آگه آدمی",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "نسخۀ جامع بود در همدمی",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "مندرج در وی دو کون آمد به عین",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "جامع است او بر تمام عالمین",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "هم به افعال بهیمی مؤتلف",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "هم به اوصاف الهی متّصف",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "جامع اخلاق ربانی بود",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "هم در او اوصاف نفسانی بود",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "بود انکار ملایک بهر آن",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "که نمی دیدند ز آدم سرّ جان",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "مطلع بودن از مادون خویش",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "نی ز فوق رتبۀ افزون خویش",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "زو نمی دیدند جز سَفک و ضرر",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "کز غضب وز شهوت آید در بشر",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "وآن ضروری بود بهر این وجود",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "روح تا سازد در این هیکل ورود",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "کی ملک زین جسم ظلمانی اثر",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "بیند الاّ اختلاف و شور و شرّ",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "بیخبر زآن رتبه کو نورانی است",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "جنبۀ اللّهی و سبحانی است",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "علّم الاسماست جنبۀ عالی اش",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "که نماید بر ملایک والی اش",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "حیث حیوانی است آن جنبۀ خسیس",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "که زند از دانه ای راهش بلیس",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "عرشیان دیدند زو فرج و گلو",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "بیخبر از وجۀ اللّهی او",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "کآن ز عقل و از ملایک فوق بود",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "بند جانش عشق زرین طوق بود",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "عشق خاص آدم و جان وی است",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "عقل را کی اندر آن خلوت پی است",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    }
  ]
}
