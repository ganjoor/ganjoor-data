  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "یٰا أَیُّهَا اَلَّذِینَ آمَنُوا کُتِبَ عَلَیْکُمُ اَلْقِصٰاصُ فِی اَلْقَتْلیٰ اَلْحُرُّ بِالْحُرِّ وَ اَلْعَبْدُ بِالْعَبْدِ وَ اَلْأُنْثیٰ بِالْأُنْثیٰ فَمَنْ عُفِیَ لَهُ مِنْ أَخِیهِ شَیْ‌ءٌ فَاتِّبٰاعٌ بِالْمَعْرُوفِ وَ أَدٰاءٌ إِلَیْهِ بِإِحْسٰانٍ ذٰلِکَ تَخْفِیفٌ مِنْ رَبِّکُمْ وَ رَحْمَةٌ فَمَنِ اِعْتَدیٰ بَعْدَ ذٰلِکَ فَلَهُ عَذٰابٌ أَلِیمٌ (۱۷۸)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "ای آنان که گرویدید نوشته شد بر شما قصاص در کشتها آزاد بآزاد بنده ببنده و زن بزن پس هر که در گذشت مر او از برادرش چیزی پس از پی رفتنی است بنیکی و ادا کردن بسوی او بنیکی این سبک کردنی است از پروردگارتان و رحمت پس هر که درگذشت از حد بعد از این پس برای اوست عذاب پر درد (۱۷۸)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "« در بیان قتل و قصاص »",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Right",
      "Text": "ای گروه مؤمنان از عام و خاص",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Left",
      "Text": "بر شما بنوشته شد حکم قصاص",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "«کُتِب «یعنی بر شما گردید فرض",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "همچو بهر سطح و طول و عمق و عرض",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "مر قصاص آن لازم کونیت است",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "ظلّی از اضلال عدل حضرت است",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "بر ازاله و نفی عدوانی که آن",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "مر سبوعی قوّه را باشد نشان",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Right",
      "Text": "چون تصرّف کرد حق در عبد خویش",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Left",
      "Text": "تا کند در خویش فانی از خودیش",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "می دهد از حرّ روحش در عوض",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "محض بخشش روح بهتر بی مرض",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "هم نماید عبد قلبش را بدل",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "حق به قلبی بی کدورت بی علل",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "گیرد از اثنای نفسش نقص حال",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "موهبت را تا دهد بر وی کمال",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "زین مقاصت که کند با بنده حق",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "ساخت بر اعظم حیاتش مستحق",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "آن حیات عارفان است و خواص",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "کز پی هر کُشتنی باشد قصاص",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "نفس حیوان را بکُش تا کم شود",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "پس ز حیوانی رهد آدم شود",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "همچنین فرض است در تبدیل و نقل",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "کُشتن آدم پی احیای عقل",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "عاقلان کُشتند زآن بهر نشان",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "آدمی را که نبودش نور جان",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "آدمیّت نی همین گوش و سر است",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "آدم است آن کز دو عالم برتر است",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "مرده از هر رتبه، وز نور حیات",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "هست او را تا مقام جمع ذات",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "صورت آن نزد اهل معرفت",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "حکم عدل اندر قصاص است و دیت",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "پس هر آنکه شیئی از وجه وجیه",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "عفو کرده شد مر او را از اخیه",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
