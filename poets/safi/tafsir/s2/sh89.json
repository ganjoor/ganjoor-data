  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "کُتِبَ عَلَیْکُمْ إِذٰا حَضَرَ أَحَدَکُمُ اَلْمَوْتُ إِنْ تَرَکَ خَیْراً اَلْوَصِیَّةُ لِلْوٰالِدَیْنِ وَ اَلْأَقْرَبِینَ بِالْمَعْرُوفِ حَقًّا عَلَی اَلْمُتَّقِینَ (۱۸۰)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "نوشته شد بر شما چون حاضر شود یکی از شما را مرگ اگر وا گذارید مالی را به نیکی وصیت کردن برای پدر و مادر و نزدیکی بنیکی سزاوار بودن بر پرهیزکاران (۱۸۰)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "« در بیان وصیات و تأکید در عمل کردن به آن »",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Right",
      "Text": "شد نوشته بر شما هنگام فوت",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Left",
      "Text": "از شما چون شد یکی حاضر به موت",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "مر وصیّت مانده گر مالی بجا",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "زو به سوی والدین و اقربا",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "زآنچه معروف است و حق بر متقین",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "که نباشد جمع آن از جور و کین",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "گر شده جمع آن به ظلم آن بی خرد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "شاید ار گردد بر آن مظلوم رد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Right",
      "Text": "لیک باشد گر معیّن، قدر آن",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Left",
      "Text": "که به خواری اخذ کرده است از فلان",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "مال معروف آن بود کز عدل و داد",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "جمع گردد نی به ظلم و کین، زیاد",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "هست معروف آنکه روز داوری",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "وزر نبود تا از آن گردی بری",
