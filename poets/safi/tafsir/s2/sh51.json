      "VOrder": 9,
      "Position": "Right",
      "Text": "همچنین آن مشرکان زشت فن",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "که پرستند از تبه کاری وثَن",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "خیر توحید از کجا دارند دوست",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "بر شما کآن بس عزیز و بس نکوست",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "او پرستد از غلط مصنوع خود",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "حق پرستان را کجا گیرد به ودّ",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "با موحّد دوست کی شد مشرکی",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "یا به خیرش همدل آید اندکی",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "هر که را خواهد خدا بر وجه خاص",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "میدهد بر رحمت خود اختصاص",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "آنکه خاکی را کند درّ یتیم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "هست بیشک صاحب فضل عظیم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Paragraph",
      "Text": "« در بیان فضل عام بر خاص »",
      "CoupletIndex": 11
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "بس شکال آید در اینجا کز چه بود",
      "CoupletIndex": 12,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "فضل او مخصوص در بذل وجود",
      "CoupletIndex": 12,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "چون همه بودند رهن خلقتش",
      "CoupletIndex": 13,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "از چه شد مخصوص فضل و رحمتش",
      "CoupletIndex": 13,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "دارد این معنی وجوه بیشمار",
      "CoupletIndex": 14,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "زآن دو وجهش را نگارم ز اختصار",
      "CoupletIndex": 14,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "هست یک وجه آنکه فضل خاص خویش",
      "CoupletIndex": 15,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "کرده حق موقوف طاعت ها ز پیش",
      "CoupletIndex": 15,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "بر نداری تا حجاب طاعتش",
      "CoupletIndex": 16,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "نیستی مختص به فضل و رحمتش",
      "CoupletIndex": 16,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "فضل او و طاعت ما در سبل",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "لازم و ملزوم شد چون طیب و گل",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "فضل، افزونی بود اندر لغت",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "وآن فزاید ز ازدیاد معرفت",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "فضل او اول تو را موجود کرد",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "در ازل نابود بودی، بود کرد",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "در جهان پیش از تقاضای طلب",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "کرد هستت، وینت اول فضل رب",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "فضل دیگر آنکه دارد اختصاص",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "هست موقوف آن به اخلاص خواص",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "تا نیفزایی تو بر اکمال خویش",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "او نیفزاید بر آن افضال بیش",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "نکته ای دیگر نهان در « من یشَآء » است",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 14
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "کاختصاص آن را دهد کو خویش خواست",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 14
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "چون ارادة خود نهی و آن سو شوی",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 15
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "واقف از سرّ ارادة او شوی",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 15
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "یعنی از نفی ارادة خویشتن",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 16
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "خود شوی عین ارادة ذوالمنن",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 16
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "خواهد او آن را که آن خاص وی است",
      "CoupletIndex": 26,
      "SectionIndex1": 1,
      "SectionIndex2": 17
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "غرقِ بحر عشق و اخلاص وی است",
      "CoupletIndex": 26,
      "SectionIndex1": 1,
      "SectionIndex2": 17
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "از ارادة خود هر آن کو فانی است",
      "CoupletIndex": 27,
      "SectionIndex1": 1,
      "SectionIndex2": 18
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "فضل را بالاختصاص ارزانی است",
      "CoupletIndex": 27,
      "SectionIndex1": 1,
      "SectionIndex2": 18
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "وجه دیگر کآن بسی باشد ادق",
      "CoupletIndex": 28,
      "SectionIndex1": 1,
      "SectionIndex2": 19
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "عین ذات شیء باشد فضل حق",
      "CoupletIndex": 28,
      "SectionIndex1": 1,
      "SectionIndex2": 19
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "آفتاب اندر کمال ذات خویش",
      "CoupletIndex": 29,
      "SectionIndex1": 1,
      "SectionIndex2": 20
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "هست مختص بر همه ذرّات خویش",
      "CoupletIndex": 29,
      "SectionIndex1": 1,
      "SectionIndex2": 20
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "اختصاصی که به شمس آن ذات داشت",
      "CoupletIndex": 30,
      "SectionIndex1": 1,
      "SectionIndex2": 21
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "هم بِذّاته بر همه ذرّات داشت",
      "CoupletIndex": 30,
      "SectionIndex1": 1,
      "SectionIndex2": 21
    },
    {
      "VOrder": 60,
      "Position": "Right",
      "Text": "جز که ذرّه بی ز وجه انتساب",
      "CoupletIndex": 31,
      "SectionIndex1": 1,
      "SectionIndex2": 22
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "در نمود اندک تر است از آفتاب",
      "CoupletIndex": 31,
      "SectionIndex1": 1,
      "SectionIndex2": 22
    },
    {
      "VOrder": 62,
      "Position": "Right",
      "Text": "لاجرم نوری کز او خورشید یافت",
      "CoupletIndex": 32,
      "SectionIndex1": 1,
      "SectionIndex2": 23
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "ذرّه ای زآن کی توان بر ذرّه تافت",
      "CoupletIndex": 32,
      "SectionIndex1": 1,
      "SectionIndex2": 23
    },
    {
      "VOrder": 64,
      "Position": "Right",
      "Text": "همچنین آبی کز او دریا گرفت",
      "CoupletIndex": 33,
      "SectionIndex1": 1,
      "SectionIndex2": 24
    },
    {
      "VOrder": 65,
      "Position": "Left",
      "Text": "کی به ظرف قطره هرگز جا گرفت",
      "CoupletIndex": 33,
      "SectionIndex1": 1,
      "SectionIndex2": 24
    },
    {
      "VOrder": 66,
      "Position": "Right",
      "Text": "جز که راه او به دریا وا شود",
      "CoupletIndex": 34,
      "SectionIndex1": 1,
      "SectionIndex2": 25
    },
    {
      "VOrder": 67,
      "Position": "Left",
      "Text": "قطرگی بگذارد و دریا شود",
      "CoupletIndex": 34,
      "SectionIndex1": 1,
      "SectionIndex2": 25
    },
    {
      "VOrder": 68,
      "Position": "Right",
      "Text": "وجه اول بر مذاق عام و خاص",
      "CoupletIndex": 35,
      "SectionIndex1": 1,
      "SectionIndex2": 26
    },
    {
      "VOrder": 69,
      "Position": "Left",
      "Text": "هست الیق گرچه دارد اختصاص",
      "CoupletIndex": 35,
      "SectionIndex1": 1,
      "SectionIndex2": 26
    },
    {
      "VOrder": 70,
      "Position": "Right",
      "Text": "وجه ثانی خاص اهل وحدت است",
      "CoupletIndex": 36,
      "SectionIndex1": 1,
      "SectionIndex2": 27
    },
    {
      "VOrder": 71,
      "Position": "Left",
      "Text": "فهم آن نی هر کسی را قسمت است",
      "CoupletIndex": 36,
      "SectionIndex1": 1,
      "SectionIndex2": 27
    },
    {
      "VOrder": 72,
      "Position": "Right",
      "Text": "آن کسی فهمد که در توحید تام",
      "CoupletIndex": 37,
      "SectionIndex1": 1,
      "SectionIndex2": 28
    },
    {
      "VOrder": 73,
      "Position": "Left",
      "Text": "گشته مطلق فهمش از ادراک عام",
      "CoupletIndex": 37,
      "SectionIndex1": 1,
      "SectionIndex2": 28
    },
    {
      "VOrder": 74,
      "Position": "Right",
      "Text": "چیست عقل پشّه و فهم ذباب",
      "CoupletIndex": 38,
      "SectionIndex1": 1,
      "SectionIndex2": 29
    },
    {
      "VOrder": 75,
      "Position": "Left",
      "Text": "پیش عقل و فهم شاهین و عقاب",
      "CoupletIndex": 38,
      "SectionIndex1": 1,
      "SectionIndex2": 29
    },
    {
      "VOrder": 76,
      "Position": "Right",
      "Text": "فهم شاهین پیش عنقا هم علیل",
      "CoupletIndex": 39,
      "SectionIndex1": 1,
      "SectionIndex2": 30
    },
    {
      "VOrder": 77,
      "Position": "Left",
      "Text": "این چنین دان عقلها تا جبرئیل",
      "CoupletIndex": 39,
      "SectionIndex1": 1,
      "SectionIndex2": 30
    }
  ]
}
