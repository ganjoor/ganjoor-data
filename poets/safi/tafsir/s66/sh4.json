      "Text": "جای خود دید او به جنّت در زمن",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "گفته بُد فرعونِ دون از کینه اش",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "سنگ بگذارند روی سینه اش",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "پیش از آن کو را رسد بر سینه سنگ",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "رفته بُد روحش به جنّت بی درنگ",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "باز مریم دخت عمران کو نگاه",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "دامن خود داشت از فحش و گناه",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "پس دمیدم اندر او از روح خویش",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "بارور شد بر مسیح خوب کیش",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "داشت باور گفته های رب خود",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "آنچه دادش وعده جبریل از ولد",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "داشت هم تصدیق بر جمله کتاب",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "هم بُد از فرمانبران در هر حساب",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "خواستم شرحی ز فضل فاطمه (س)",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "در بیان آرم به خیر خاتمه",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "لب گزیدم مرتضای (ع) رشک ناک",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "کو برون است از شمار خلق و پاک",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "او ز افراد خلایق فرد بود",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "نیست جفت او را که جفت مرد بود",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    }
  ]
}
