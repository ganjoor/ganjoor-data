      "Text": "یٰا أَیُّهَا اَلَّذِینَ آمَنُوا تُوبُوا إِلَی اَللّٰهِ تَوْبَةً نَصُوحاً عَسیٰ رَبُّکُمْ أَنْ یُکَفِّرَ عَنْکُمْ سَیِّئٰاتِکُمْ وَ یُدْخِلَکُمْ جَنّٰاتٍ تَجْرِی مِنْ تَحْتِهَا اَلْأَنْهٰارُ یَوْمَ لاٰ یُخْزِی اَللّٰهُ اَلنَّبِیَّ وَ اَلَّذِینَ آمَنُوا مَعَهُ نُورُهُمْ یَسْعیٰ بَیْنَ أَیْدِیهِمْ وَ بِأَیْمٰانِهِمْ یَقُولُونَ رَبَّنٰا أَتْمِمْ لَنٰا نُورَنٰا وَ اِغْفِرْ لَنٰا إِنَّکَ عَلیٰ کُلِّ شَیْ‌ءٍ قَدِیرٌ (۸) یٰا أَیُّهَا اَلنَّبِیُّ جٰاهِدِ اَلْکُفّٰارَ وَ اَلْمُنٰافِقِینَ وَ اُغْلُظْ عَلَیْهِمْ وَ مَأْوٰاهُمْ جَهَنَّمُ وَ بِئْسَ اَلْمَصِیرُ (۹)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "ای آنان که ایمان آورده‌اید توبه نمائید بسوی خدا بازگشتی خالص شاید پروردگار شما درگذرد از شما گناهان شما را و داخل کند شما را بهشتهایی که می‌رود از زیر آنها نهرها روزی که خار نسازد خدا پیغمبر را و آنان که گرویدند با او نور ایشان می‌رود میانه دستهای ایشان و بیمینهایشان می‌گویند پروردگار ما تمام برای ما نور ما و بیامرز ما را بدرستی که تو بر هر چیز توانایی (۸) ای پیغمبر جهاد کن با کفار و منافقان و سخت بگیر بر ایشان و جایگاهشان دوزخ است و بد بازگشتی است (۹)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "مؤمنان تُوبُواْ إلَی االلهِ بالوضوح",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "توبۀ خاص اعنی آن توبۀ نصوح",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "مر نصوح است از نصاحت جامه را",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "که به هم دوزند ثوب عامه را",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "یعنی آن توبه که از خرق گناه",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "نُصح یابد جامۀ تقوی به گاه",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "شاید ار هم از نصیحت باشد آن",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "مر به نفس خویش و نفس دیگران",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "شاید از این توبه مر پروردگار",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "از شما پوشد گناهان بیشمار",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "واندر آرد در بهشت پر نوا",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "که بود جاری ز زیرش نهرها",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "اندر آن روزی که رسوایی پدید",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "ناورد حق بر رسولی بی ندید",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "وآن کسان کز اهل ایمان با وی اند",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "در اطاعت با خدا محکم پی اند",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "می شتابد نورشان از پیش رو",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "هم به دست راست ایشان را نکو",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "ربّنا گویند أتْمِم نَورَنَا",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "تا رویم از ره به منزل هر کجا",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "هم بیامرز از گنه کن پاکمان",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "چون تویی قادر به هر چیز از نشان",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "ای پیمبر کن تو با کفار جنگ",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "با منافق سیرتان هم بی درنگ",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "خود درشتی کن به ایشان در قتال",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "دوزخ ایشان راست مأوی بی سئوال",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "بد بود بر کافران آن جایگاه",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "بازگشتی ناپسند و نابخواه",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    }
  ]
}
