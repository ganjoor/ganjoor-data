  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "فَلاٰ صَدَّقَ وَ لاٰ صَلّٰی (۳۱) وَ لٰکِنْ کَذَّبَ وَ تَوَلّٰی (۳۲) ثُمَّ ذَهَبَ إِلیٰ أَهْلِهِ یَتَمَطّٰی (۳۳) أَوْلیٰ لَکَ فَأَوْلیٰ (۳۴) ثُمَّ أَوْلیٰ لَکَ فَأَوْلیٰ (۳۵) أَ یَحْسَبُ اَلْإِنْسٰانُ أَنْ یُتْرَکَ سُدیً (۳۶) أَ لَمْ یَکُ نُطْفَةً مِنْ مَنِیٍّ یُمْنیٰ (۳۷) ثُمَّ کٰانَ عَلَقَةً فَخَلَقَ فَسَوّٰی (۳۸) فَجَعَلَ مِنْهُ اَلزَّوْجَیْنِ اَلذَّکَرَ وَ اَلْأُنْثیٰ (۳۹) أَ لَیْسَ ذٰلِکَ بِقٰادِرٍ عَلیٰ أَنْ یُحْیِیَ اَلْمَوْتیٰ (۴۰)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "پس نه تصدیق نموده نه نماز گذارد (۳۱) و لیکن تکذیب نمود و روی گردانید (۳۲) پس رفت بسوی کسانش بتکبر می‌رفت (۳۳) سزاوارتر است ترا پس سزاوارتر (۳۴) پس سزاوارتر است مر ترا پس سزاوارتر (۳۵) آیا می‌پندارد انسان که وا گذاشته خواهد شد مهمل (۳۶) آیا نبود نطفه از منی که ریخته شود (۳۷) پس بود خون بسته پس آفرید پس راست کرد (۳۸) پس گردانید از آن دو جفت مذکر و مؤنث (۳۹) آیا نیست آن توانا بر اینکه زنده گرداند مردگان را (۴۰)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "پس نیاورد آدمی یعنی عدی",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "بر پیمبر یا به قرآن از بدی",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "هم دگر نگذاشت از واجب نماز",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "لیک بر تکذیب از حق گشت باز",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "سوی اهلش رفت پس از رهگذار",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "با خرامیدن ز روی افتخار",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "پس تو را ای کافر دشمن سزاست",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "در جهان، قهر و هلاکت کز خداست",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "پس سزاوار است رنج از بعد موت",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "هول حشرت پس سزد وآن نیست فوت",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "پس سزاوارت به غایت دوزخ است",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "هر کجا تا دوزخت بند و فخ است",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "آدمی پندارد آیا که شود",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "وانهاده مُهمل این کی می بود",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "قطرة آبی نبود آیا که او",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "از منی کاندر رحم ریزد فرو",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "بسته خونی بُد پس بدو تقدیر کرد",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "پس زمانی بهر او خلاّق فرد",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "آفرید اندر رحم یا عضوهاش",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "راست پس فرمود هر عضوی به جاش",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "پس بگرداند از منی یا ز آدمی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "خود دو صنف از ماده و نر او همی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "پس توانا نیست آیا که حیات",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "بخشد او بر مردگان بعد از ممات",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "قادر است البته ذات لم یزل",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "بر اعاده در مجازات عمل",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    }
  ]
}
