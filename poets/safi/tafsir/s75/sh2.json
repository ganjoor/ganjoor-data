      "VOrder": 8,
      "Position": "Left",
      "Text": "تا مبادا آن رود از یاد تو",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "هست بر ما جمع آن اندر دلت",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "تا نباشد حفظ قرآن مشکلت",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "پس چو خوانیم آن به نطق جبرئیل",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "پیروی کن خواندنش را ای خلیل",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "پس شود بر ما که آن روشن شود",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "بر تو آن معنی کز او مشکل بود",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "ره مده بر دل که گردد از تو فوت",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "چیزی از قرآن چو بشنیدی به صوت",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "این چنین نبود که پندارید نیست",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "بعد مردن حشر و نشری کآن ز چیست",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "زآن در این قرآن نیندیشید هیچ",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "ناورید اعنی تدبّر در بسیج",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "دوست بل دارید دنیا را جمیع",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "که بسی باشد زوال آن سریع",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "دست خود از آخرت دارید باز",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "کآن بود باقی نه چون دنیا به ساز",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "رویها روزی که تازه و خرم است",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "ناظر اندر روی خوبش هر دم است",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Paragraph",
      "Text": "« جذبه »",
      "CoupletIndex": 14
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "رفتم از خود شد چو ذکر روی او",
      "CoupletIndex": 15,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "خوی خود هِشتم گرفتم خوی او",
      "CoupletIndex": 15,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "خود فکندن یا گرفتن کار نیست",
      "CoupletIndex": 16,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "تا دویی باقی است سویش بار نیست",
      "CoupletIndex": 16,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "پرده بندد تا تو اندر پرده ای",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "پرده هِشتی یار جان پرورده ای",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "آنکه داند خویش را در کوی او",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "روی او نبود که بیند روی او",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "رویها باشند هم دیگر تُرش",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "اندر آن روز از خلاف روی خوش",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "خود تو ای بیننده پنداری که آن",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "کرده خواهد شد بدو رنجی گران",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "آن چنان رنجی که مهرة پشت او",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "بشکند از هیبت آن رو به رو",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "آن چنان نبود که بتوان مِهر بست",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "بر جهان وز آخرت غافل نشست",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "روح آن دم که رسد بر استخوان",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "کوست بر بالای سینه بر عیان",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "پس کسان محتضر گویند کیست",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "که کند افسون کنون این حال چیست",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "کیست یعنی آنکه بنماید علاج",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "ز ادویه یا ادعیه رنج مزاج",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "محتضر را پس یقین گردد فراق",
      "CoupletIndex": 26,
      "SectionIndex1": 1,
      "SectionIndex2": 14
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "ساق او پیچد ز جان کندن به ساق",
      "CoupletIndex": 26,
      "SectionIndex1": 1,
      "SectionIndex2": 14
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "آن زمان ماند عمل رفت اشتغال",
      "CoupletIndex": 27,
      "SectionIndex1": 1,
      "SectionIndex2": 15
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "می رود مال از میان ماند وبال",
      "CoupletIndex": 27,
      "SectionIndex1": 1,
      "SectionIndex2": 15
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "هست سوی ربّت آن روز از ملاء",
      "CoupletIndex": 28,
      "SectionIndex1": 1,
      "SectionIndex2": 16
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "موضع راندن به هنگام جزاء",
      "CoupletIndex": 28,
      "SectionIndex1": 1,
      "SectionIndex2": 16
    }
  ]
}
