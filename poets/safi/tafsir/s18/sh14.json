      "Position": "Right",
      "Text": "پس اراده کردم از امر خدا",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "تا کنم معیوب خود آن فُلک را",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "زآنکه باشد پادشاهی در عقب",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "غاصب و جبّار و بیرحم و ادب",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "مینماید غصب هر جا کشتی ای است",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "کآن بود نو یا که هیچش عیب نیست",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "کردم آن معیوب تا یابد امان",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "از شرور غاصبان و ظالمان",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "صاحبان آن به کلی ناامید",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "هم نگردند از معاش و از نوید",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "وآن غلام کشته گشته پس بُد او",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "خود شقی و والدینش بس نکو",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "پس بترسیدیم کایشان را رسد",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "کفر و طغیان از وجود آن ولد",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "خواستیم آن پس که حق بدهد عوض",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "نیکتر ز او آن دو را دور از مرض",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "بهتر از روی زکا و رحم و رفق",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "کون او با نظم کون آید به وفق",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "این قدر باشد به فهم عامه خوب",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "آگه از باقی است علام الغیوب",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "حکم شرع این نیست کاری اشتباه",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "کز چه کُشت او آن پسر را بیگناه",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "گفته بود او خود که می ناید به راست",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "امر من با شرع و ظاهر وآن بجاست",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "اصلش آن باشد که نقاش ار زُدود",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "نقش خود را عیب نبود در وجود",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "وآن جدار، اما بود از دو یتیم",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "زیر آن گنجی است پنهان ای کلیم",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "بُد پدرشان مرد نیکی از خواص",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "گنج دارد بر یتیمان اختصاص",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "گر که می افتاد مانا این جدار",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "میشد از زیرش مگر گنج آشکار",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "خلق می بردند مال کودکان",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "خواست پس پروردگار آن را نهان",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "تا رسند آن هر دو بر رشد و تمیز",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "گنج را یابند بی حرف و ستیز",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "زآن سبب کردم من این دیوار راست",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "تا بدانی رمز امری کز خداست",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 54,
      "Position": "Paragraph",
      "Text": "« تأویل عرفانی حکایت »",
      "CoupletIndex": 28
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "آن سفینه تن بود کو را شکست",
      "CoupletIndex": 29,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "در ریاضت تا ز شرّ نفس رست",
      "CoupletIndex": 29,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "نفس باشد غاصب فُلک بدن",
      "CoupletIndex": 30,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "از ریاضت تن رهد زو بی سخن",
      "CoupletIndex": 30,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "کُشتن نفس است قتل آن غلام",
      "CoupletIndex": 31,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "کار قلب از قتل او گردد به کام",
      "CoupletIndex": 31,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "شرح آن هر جا مکرر گفته ایم",
      "CoupletIndex": 32,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "درّ معنی بس مفصل سُفته ایم",
      "CoupletIndex": 32,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "هست نفس مطمئنه آن جدار",
      "CoupletIndex": 33,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "کآن پس از اماره گردد با تو یار",
      "CoupletIndex": 33,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "او چو گردد کُشته این ظاهر شود",
      "CoupletIndex": 34,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "مستقیم از خضر صاحب سرّ شود",
      "CoupletIndex": 34,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "زآنکه گردد از ریاضات زیاد",
      "CoupletIndex": 35,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "بی ز حرکت، بی ز قوّت، چون جماد",
      "CoupletIndex": 35,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "رَسته چون از قوه های طبع پاک",
      "CoupletIndex": 36,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "هست نزدیک آنکه تا گردد هلاک",
      "CoupletIndex": 36,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "حال او را کرده تعبیر از سند",
      "CoupletIndex": 37,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "بر جداری کو به افتادن رسد",
      "CoupletIndex": 37,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "پس نماید دست خضر آن را قوی",
      "CoupletIndex": 38,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "بر کمالات و صفات معنوی",
      "CoupletIndex": 38,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "این اشارت بس بود در این مقام",
      "CoupletIndex": 39,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "هست در تفسیر شرحش بالتمام",
      "CoupletIndex": 39,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    }
  ]
}
