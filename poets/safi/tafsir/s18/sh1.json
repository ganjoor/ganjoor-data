    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "شرح آن گفتیم از پیش ای رفیق",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "گر به یادت باشد آن شرح دقیق",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "اندر اینجا کرده حمد ذات خویش",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "از ره تفصیل در آیات خویش",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "جامعِ آن، احمد(ص) کامل دم است",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "ز آفرینش اقدم است و اکرم است",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "تا نماید حمد او بی اعوجاج",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "نیست یعنی سوی غیرش احتیاج",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "تا نبیند غیر او را در نهج",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "تا که آید ز استقامت بر عوج",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "قَیِّما لِّیُنذِرَ بَأسا شَدِید",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "مِّن لَّدُنهُ وَ یُبشِرَ بِالعَبِید",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "مستقیم و معتدل از انحراف",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "دور ز افراط و ز تفریط خلاف",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "بیم ده بر کافران از نزد خود",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "هم مبشر مؤمنان را تا ابد",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "الَّذِینَ یَعمَلُونَ الصالِحَات",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "مزدشان نیکوست بالحق از جهات",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "مر مقیمند اندر آن اجر از سند",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "در ثبوت ماکِثین فِیه أبَد",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "بیم وآنان را دهد که گفته اند",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "حق گرفته هیچ فرزند از پسند",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "هیچشان علمی بدین گفتار نیست",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "کس نه ز آباشان بدین گفتار زیست",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "یعنی آباشان هم این از نا به اهل",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "از ره بی دانشی گفتند و جهل",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "بس بزرگ است این کلام بی سکون",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "کز دهانشان بر غلط آید برون",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "این نمی گویند الاّ بر دروغ",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "نیست بر گفتار کج گویان فروغ",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "پس همانا خود تو در فعل و مهم",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "بَاخِعنَّفسَکَ عَلَی آثَارِهِم",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "حسرت و اندُه خوری از حالشان",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "سخت گیری بر خود از اقوالشان",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "ناورند ایمان اگر بر این حدیث",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "پس مخور غم چند بر دونی خبیث",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "ما بگ رداندیم بر ارض آنچه هست",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "زینتی اهل زمین را در نشست",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "از جماد و هم ز حیوان و نبات",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "یا که ز اهل علم و اوتاد و ثقات",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "تا نماییم آزمایش در محل",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "که از ایشان کیست بهتر در عمل",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "آزماییم اعنی اهل ارض را",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "بر وجود اولیاء و اصفیا",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "تا که با حق در عمل یک روتر است",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "در عیان و در نهان نیکوفر است",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "بازگرداننده ایم این قصر و گاه",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "که تو بینی هم زمینی بی گیاه",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "یعنی اینها جمله گردد خاک و پست",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "دل بر آنها جز که نادانی نبست",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "شهرها یکجا شود زیر و زبر",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "وین بناها جمله خاک رهگذر",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "صورت خوبان و زلف مهوشان",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "خاک گردد می نماند زآن نشان",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    }
  ]
}
