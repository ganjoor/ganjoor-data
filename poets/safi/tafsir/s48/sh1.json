  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "بسم االله الرحمن الرحیم",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "إنّٰا فَتَحْنٰا لَکَ فَتْحاً مُبِیناً (۱) لِیَغْفِرَ لَکَ اَللّٰهُ مٰا تَقَدَّمَ مِنْ ذَنْبِکَ وَ مٰا تَأَخَّرَ وَ یُتِمَّ نِعْمَتَهُ عَلَیْکَ وَ یَهْدِیَکَ صِرٰاطاً مُسْتَقِیماً (۲) وَ یَنْصُرَکَ اَللّٰهُ نَصْراً عَزِیزاً (۳) هُوَ اَلَّذِی أَنْزَلَ اَلسَّکِینَةَ فِی قُلُوبِ اَلْمُؤْمِنِینَ لِیَزْدٰادُوا إِیمٰاناً مَعَ إِیمٰانِهِمْ وَ لِلّٰهِ جُنُودُ اَلسَّمٰاوٰاتِ وَ اَلْأَرْضِ وَ کٰانَ اَللّٰهُ عَلِیماً حَکِیماً (۴)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "بنام خدای بخشندۀ مهربان",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Paragraph",
      "Text": "بدرستی که ما قرار فیروزی دادیم برای تو قرار فیروزی دادنی (۱) تا بیامرزد مر ترا خدا آنچه افتاد از گناهت و آنچه پس افتاد و تمام گرداند نعمتش را بر تو و هدایت کند ترا براهی راست (۲) و یاری کند ترا خدا یاری کردنی با عزت (۳) اوست آنکه فرو فرستاد آرام را در دلهای مؤمنان تا بیفزاید گرویدنی را با گرویدنشان و مر خدا راست لشکرهای آسمانها و زمین و باشد خدا دانای درست کردار (۴)",
      "CoupletIndex": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "سوره الفتح است بگشا باب دل",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "گوش کن اسرار جان ز ارباب دل",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "ما گشودیم ای رسول پاک دین",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "مر تو را بگشودنی ظاهر به دین",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "بعد کشف قلب باشد کشف روح",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
