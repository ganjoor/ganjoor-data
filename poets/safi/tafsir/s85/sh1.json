  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "بسم االله الرحمن الرحیم",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "وَ اَلسَّمٰاءِ ذٰاتِ اَلْبُرُوجِ (۱) وَ اَلْیَوْمِ اَلْمَوْعُودِ (۲) وَ شٰاهِدٍ وَ مَشْهُودٍ (۳) قُتِلَ أَصْحٰابُ اَلْأُخْدُودِ (۴) اَلنّٰارِ ذٰاتِ اَلْوَقُودِ (۵) إِذْ هُمْ عَلَیْهٰا قُعُودٌ (۶) وَ هُمْ عَلیٰ مٰا یَفْعَلُونَ بِالْمُؤْمِنِینَ شُهُودٌ (۷) وَ مٰا نَقَمُوا مِنْهُمْ إِلاّٰ أَنْ یُؤْمِنُوا بِاللّٰهِ اَلْعَزِیزِ اَلْحَمِیدِ (۸) اَلَّذِی لَهُ مُلْکُ اَلسَّمٰاوٰاتِ وَ اَلْأَرْضِ وَ اَللّٰهُ عَلیٰ کُلِّ شَیْ‌ءٍ شَهِیدٌ (۹) إِنَّ اَلَّذِینَ فَتَنُوا اَلْمُؤْمِنِینَ وَ اَلْمُؤْمِنٰاتِ ثُمَّ لَمْ یَتُوبُوا فَلَهُمْ عَذٰابُ جَهَنَّمَ وَ لَهُمْ عَذٰابُ اَلْحَرِیقِ (۱۰)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "بنام خدای بخشاینده مهربان",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Paragraph",
      "Text": "بآسمان صاحب برجها (۱) و روز وعده کرده شده (۲) و شاهد و مشهود (۳) کشته شدند اصحاب شکافها در زمین (۴) آن آتش صاحب مایه برافروختگی (۵) هنگامی که ایشان بودند بر آنها نشستگان (۶) و ایشان بودند بر آنچه می‌کردند بمؤمنان حاضران (۷) و دشمن نداشتند از ایشان جز آنکه ایمان آوردند بخدای غالب ستوده (۸) آنکه مر او راست پادشاهی آسمانها و زمین و خداست بر همه چیز شاهد (۹) بدرستی که آنان که مبتلا بعقوبت کردند مردان باایمان و زنان با ایمان را پس بازگشت نکردند پس مر ایشان‌راست عذاب دوزخ و مر ایشان‌راست عذاب سوزنده (۱۰)",
      "CoupletIndex": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "وَالسمَآءٍ ذَاتِ الْبُرُوج اعنی قسم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
