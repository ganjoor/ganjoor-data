      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "قُلْ لِلْمُؤْمِنِینَ یَغُضُّوا مِنْ أَبْصٰارِهِمْ وَ یَحْفَظُوا فُرُوجَهُمْ ذٰلِکَ أَزْکیٰ لَهُمْ إِنَّ اَللّٰهَ خَبِیرٌ بِمٰا یَصْنَعُونَ (۳۰) وَ قُلْ لِلْمُؤْمِنٰاتِ یَغْضُضْنَ مِنْ أَبْصٰارِهِنَّ وَ یَحْفَظْنَ فُرُوجَهُنَّ وَ لاٰ یُبْدِینَ زِینَتَهُنَّ إِلاّٰ مٰا ظَهَرَ مِنْهٰا وَ لْیَضْرِبْنَ بِخُمُرِهِنَّ عَلیٰ جُیُوبِهِنَّ وَ لاٰ یُبْدِینَ زِینَتَهُنَّ إِلاّٰ لِبُعُولَتِهِنَّ أَوْ آبٰائِهِنَّ أَوْ آبٰاءِ بُعُولَتِهِنَّ أَوْ أَبْنٰائِهِنَّ أَوْ أَبْنٰاءِ بُعُولَتِهِنَّ أَوْ إِخْوٰانِهِنَّ أَوْ بَنِی إِخْوٰانِهِنَّ أَوْ بَنِی أَخَوٰاتِهِنَّ أَوْ نِسٰائِهِنَّ أَوْ مٰا مَلَکَتْ أَیْمٰانُهُنَّ أَوِ اَلتّٰابِعِینَ غَیْرِ أُولِی اَلْإِرْبَةِ مِنَ اَلرِّجٰالِ أَوِ اَلطِّفْلِ اَلَّذِینَ لَمْ یَظْهَرُوا عَلیٰ عَوْرٰاتِ اَلنِّسٰاءِ وَ لاٰ یَضْرِبْنَ بِأَرْجُلِهِنَّ لِیُعْلَمَ مٰا یُخْفِینَ مِنْ زِینَتِهِنَّ وَ تُوبُوا إِلَی اَللّٰهِ جَمِیعاً أَیُّهَا اَلْمُؤْمِنُونَ لَعَلَّکُمْ تُفْلِحُونَ (۳۱)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "بگو مر مؤمنان را که فرو گیرند دیده‌هاشان را و نگاهدارند عورتهاشان را آن پاکیزه‌تر است برای ایشان بدرستی که خدا آگاه است بآنچه می‌کنید (۳۰) و بگو مر زنان با ایمان را که فرو گیرند دیده‌هاشان را و نگاه دارند عورتهاشان را و ظاهر نسازند پیرایۀ خود را مگر آنچه آشکار آمد از آن و باید که فروگذارند مقنعه‌هاشان را بر گریبانهاشان و ظاهر نسازند پیرایه خود را مگر برای شوهرانشان یا پدرانشان یا پدران شوهرشان یا پسرانشان یا پسران شوهرانشان یا برادرانشان یا پسران برادرانشان یا پسران خواهرانشان یا زنانشان یا آنچه را مالک باشد یمینهاشان یا پیروان غیر صاحبان حاجت از مردمان یا کودکان که اطلاع نیافته‌اند بر عورتهای زنان و نباید که بزنند بپاهاشان تا دانسته شود آنچه پنهان می‌دارند از پیرایه‌شان و بازگشت کنید بسوی خدا همه ای مؤمنان باشد که شما رستگار شوید (۳۱)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ای محمّد (ص) باز گو با مردمان",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "چشم تا پوشند از نامحرمان",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "فرج های خود نگهدارند هم",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "از زناء و از لواط از بیش و کم",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "این است بهتر بهر ایشان در پسند",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "حق خبیر است از هر آنچه می کنند",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "هم بگو تا چشم پوشند آن زنان",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "از رجال غیر محرم در زمان",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "زینت خود هم نسازند آشکار",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "جز هر آنچه نیست ممکن استتار",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "همچو چادر یا که کفش و روی بند",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "باشد ار ظاهر، نباشد ناپسند",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "گفته اند ارباب فقه از موقعش",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "باشد از زینت مراد از موضعش",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "ور نه نبود دیدن زینت حرام",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "وین بود معلوم و ثابت در کلام",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "بر زنند و برگذارند آن زمان",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "مقنعه باید به گردنها عیان",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "تا شود پوشیده ز ایشان بعد روی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "گردن و موی و بناگوش و گلوی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "ظاهر آن زینت نسازند از بدن",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "جز ز بهر شوهران خویشتن",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "یا پدر یا خود پدر شوهر به نام",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "یا پسرها یا پسر شوهر تمام",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "یا برادر هیچ اگر او را بود",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "یا پسرهای برادرهای خود",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "یا پسرهایی که هست از خواهرش",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "یا زنی هم کیش اگر باشد برش",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "آن زنان یعنی که هم دین وی اند",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "حافظ اسرار و آئین وی اند",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "دستها را آنچه را مالک شده است",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "از کنیزان کافره یا حق پرست",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "نزد بعضی شد اعم ملک یمین",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "از اِماء و از عبید اندر یقین",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "موضع زینت بر ایشان گر پدید",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "شد همانا نیست زآن منع شدید",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "این است رأی عایشه هم شافعی",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "نیست نزد بوحنیفه واقعی",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "نکند او تجویز یعنی این چنین",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "گرچه محبوب است و عنّین عبد هین",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "موضع ار پوشد ز عبد اندر خور است",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "هم امامیه بر این وین اشهر است",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "پیروان که غیر محتاجند باز",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "بر زنان از پیری و عمر دراز",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "کودکان هم که ندارند اطلاع",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "هیچ بر عورات نسوان وز جماع",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "نی زنند آن پای ها هم بر زمین",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "تا که زینت ها نگردد مستبین",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "بر زمین یعنی روند آهسته پس",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "تا نگردد خفیه ها معلوم کس",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "تا نیابد نار شهوت اشتعال",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "از صدای آن حلل اندر رجال",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "مؤمنان تُوبُواْ إلَی االله جَمِیع",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "گر شما باشید منقاد و مطیع",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "بازگشت آرید سوی کردگار",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "تا شما گردید شاید رستگار",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    }
  ]
}
