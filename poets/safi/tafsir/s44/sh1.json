      "Position": "Right",
      "Text": "در زمان قحط در قوم مُضِر",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "که بُدند ایشان به کفر و کین مُصِر",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "از زمین برخاست دودی این چنین",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "خواستند از احمد (ص) کامل یقین",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "کز دعایت گر شود رفع این عذاب",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "بر تو ایمان آوریم از شیخ و شاب",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "او دعاء فرمود کای پروردگار",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "تو ز ما بردار رنج و اضطرار",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "بر تو ما پروردگارا مؤمنیم",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "بر کمال لطف و قهرت موقنیم",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "هم بود مروی که این دود و دخان",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "خیزد از پیش از قیامت ناگهان",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "مردمان را می رود در چشم و گوش",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "خلق زآن گردند دور از تاب و هوش",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "از دعاء سازد بلاء را مرتفع",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "اوست بر اسرار اشیاء مطلع",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "بر ملایک بدهد آن ربّ البشر",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "آن دم از أنَّی لَهُمُ الذِّکْرَی خبر",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    }
  ]
}
