      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "می بیایند آن زمان صف بعد صف",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "دوزخ آورده شود آن روز گاه",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "آدم آرد یاد آن روز از گناه",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "فائده ذکر است او را از کجا",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "یا که نفع پند بگرفتن هلا",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "گوید او ای کاشکی که من ز پیش",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "می فرستادم در اینجا بهر خویش",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "فعل نیکی در حیات دنیوی",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "یا که از بهر حیات اخروی",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "پس در آن روز ایچ نکند با حساب",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "چون عذاب او کسی را کس عذاب",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "بند هم نکند کسی را کس چنان",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "کو نماید بند اندر آن زمان",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "ای چنان نفسی که باشی ممتحن",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "جسته ای آرام اندر ذکر من",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "فارغ و مستغنی ای از کل ناس",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "شا کر نعمت بُدی، نی ناسپاس",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "باز گرد اعنی به سوی رب خویش",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "راضیه و مرضیه با تکریم بیش",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "پس درآی اندر عباد اکرمم",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "هم درآی اندر بهشت بی غمم",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    }
  ]
}
