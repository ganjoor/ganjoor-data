  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "وَ هُوَ اَلَّذِی یُرْسِلُ اَلرِّیٰاحَ بُشْراً بَیْنَ یَدَیْ رَحْمَتِهِ حَتّٰی إِذٰا أَقَلَّتْ سَحٰاباً ثِقٰالاً سُقْنٰاهُ لِبَلَدٍ مَیِّتٍ فَأَنْزَلْنٰا بِهِ اَلْمٰاءَ فَأَخْرَجْنٰا بِهِ مِنْ کُلِّ اَلثَّمَرٰاتِ کَذٰلِکَ نُخْرِجُ اَلْمَوْتیٰ لَعَلَّکُمْ تَذَکَّرُونَ (۵۷) وَ اَلْبَلَدُ اَلطَّیِّبُ یَخْرُجُ نَبٰاتُهُ بِإِذْنِ رَبِّهِ وَ اَلَّذِی خَبُثَ لاٰ یَخْرُجُ إِلاّٰ نَکِداً کَذٰلِکَ نُصَرِّفُ اَلْآیٰاتِ لِقَوْمٍ یَشْکُرُونَ (۵۸)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "و اوست که می‌فرستد بادها را بشارت‌دهندگان میان دو دست رحمتش تا چون بردارد ابر گران بار را برانیم آن را از برای بلدی مرده پس فرو فرستیم بآن آب را پس بیرون آوریم بآن از همه ثمرها همچنین بیرون نمی‌آوریم مردگان را باشد که شما پند گیرید (۵۷) و بلد پاکیزه بیرون می‌آید رستنیهایش باذن پروردگارش و آنچه پلید شد بیرون نمی‌آید مگر اندک بیفایده همچنین می‌گردانیم آیتها را از برای گروهی که شکر می‌کنند (۵۸)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "اوست آن کس که فرستد بادها",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "مژده بر رحمت دهد ز امدادها",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "پیش از آنکه بر زمین ریزد مطر",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "بادها بدهند از باران خبر",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "بادها تا چون به خود گیرند بر",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "ابرهایی که گرانند از مطر",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "هر چه باشد ابر از باران ثقیل",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "حمل آن بر بادها باشد قلیل",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "ابر را رانیم اندر اهتزاز",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
