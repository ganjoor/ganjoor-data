      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "وآن به فهم آرید گر دانشورید",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "هر زمین پاک و شایسته که آن",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
