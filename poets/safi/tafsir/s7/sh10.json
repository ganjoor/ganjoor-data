      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "و یاد کن لوط را هنگامی که گفت قومش را آیا می‌کنید کار زشت را پیشی نگرفته شما را بآن هیچ یک از جهانیان (۸۰) به درستی که شما هر آینه می‌آیید مردان را از روی شهوت از غیر زنان بلکه شمائید گروه اسراف‌کاران (۸۱) و نبود جواب قومش مگر آنکه گفتند بیرون کنید ایشان را از قریه خودتان که آنها مردمانند که پاک می‌شمارند خود را (۸۲) پس نجات دادیم او را و کسانش را غیر از زنش را که بود از باقی‌ماندگان بهلاکت (۸۳) و بارانیدیم بر ایشان بارانی پس بنگر چگونه بود انجام کار گناهکاران (۸۴)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "« در بیان ذکر قوم لوط علیه السلام »",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Right",
      "Text": "آمدیم اندر بیان قوم لوط",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Left",
      "Text": "تا نباشی بر نشان قوم لوط",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "قوم خود را چونکه گفت او از خرد",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "ناید آیا ننگتان زین فعل بد",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "این چنین فحشاء کنید آیا شما",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "واندر آیید از ره فحش از ملا",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "خود بر آن نگرفته پیشی هیچ کس",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "ز اهل عالم تا کس آیدشان ز پس",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Right",
      "Text": "خود شما آیید آیا از هوی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Left",
      "Text": "یعنی از شهوت به مردان بی نسا",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "این به توبیخ است ابلغ چون زنان",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "بهر تزویجند و نسل اندر جهان",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "ترک آنها کردن از بهر وصال",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "جمع گشتن با رجال آمد ضلال",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "بل شما هستید قومی مسرفین",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "گشته فعل دیوتان عادت چنین",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "می نبود اهل سدوما را جواب",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "سوی لوط اندر برابر زین خطاب",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "جز که گفتندی به هم جنسان ز قهر",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "أخْرِجُو مِنْ قَریَة یعنی ز شهر",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "لوط را بیرون کنید از دیه خویش",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "طعنه چون بر ما زند در دین و کیش",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "با بنات و پیروانِ او کنون",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "از زمین خود کنید او را برون",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "زآنکه آن مردم از این فعل نژند",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "کارهند و دعوی پاکی کنند",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "لوط را دادیم با اهلش نجات",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "جز زن لوط آنکه بود از مشرکات",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "او نشد با لوط بیرون از دیار",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "ماند برجا چونکه بُد با قوم یار",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "پس بباراندیم ایشان را به سر",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "سنگها ناگاه بر سان مطر",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "پس نگر پایان کار مجرمین",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "وآن جزاء کز حق رسد در یوم دین",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "با سروشی چند آمد جبرئیل",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "گشت مهمان در سرای آن خلیل",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "بهر ایشان کرد او حاضر طعام",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "که مگر آمد مسافر در مقام",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "چون نخوردند او شد اندر اضطراب",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "زآنکه بود این از خصومت فتح باب",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "جبرئیلش گفت ما نه از مردمیم",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "بلکه فوق از آسمان و انجمیم",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "بهر نفی قوم لوط اندر زمین",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "آمدیم از جانب دیّان دین",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "بود واجب تا تو زآن یابی خبر",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "زآنکه از حق پیشوایی بر بشر",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "پس روان گشتند زآنجا پیش لوط",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "تا برند ا ز فرّ خود تشویش لوط",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "مر ورا گفتند با اهلت برون",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "رو کنون کاین قریه گردد سرنگون",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "هفت قریه بود و کَند آنها تمام",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "جبرئیل از امر خلاّق الانام",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "صبح چون شد جمله بُد زیر و زبر",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "زنده ای در وی نبُد از جانور",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    }
  ]
}
