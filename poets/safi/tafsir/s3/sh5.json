      "Text": "قُلْ أَ أُنَبِّئُکُمْ بِخَیْرٍ مِنْ ذٰلِکُمْ لِلَّذِینَ اِتَّقَوْا عِنْدَ رَبِّهِمْ جَنّٰاتٌ تَجْرِی مِنْ تَحْتِهَا اَلْأَنْهٰارُ خٰالِدِینَ فِیهٰا وَ أَزْوٰاجٌ مُطَهَّرَةٌ وَ رِضْوٰانٌ مِنَ اَللّٰهِ وَ اَللّٰهُ بَصِیرٌ بِالْعِبٰادِ (۱۵) اَلَّذِینَ یَقُولُونَ رَبَّنٰا إِنَّنٰا آمَنّٰا فَاغْفِرْ لَنٰا ذُنُوبَنٰا وَ قِنٰا عَذٰابَ اَلنّٰارِ (۱۶) اَلصّٰابِرِینَ وَ اَلصّٰادِقِینَ وَ اَلْقٰانِتِینَ وَ اَلْمُنْفِقِینَ وَ اَلْمُسْتَغْفِرِینَ بِالْأَسْحٰارِ (۱۷)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "بگو آیا خبر دهم شما را به بهتر از آنتان از برای آنها که پرهیز کردند نزد پروردگارشان بهشتهایی است که می‌رود از زیرشان نهرها جاودانیان در آن و جفتان پاکیزه و خشنودی از خدا و خدا بیناست ببندگان (۱۵) آنان که می‌گویند ای پروردگار ما بدرستی که ما گرویدیم پس بیامرز ما را گناهان ما و نگاهدار ما را از عذاب آتش (۱۶) شکیبایان و راستگویان و فرمان‌برداران و نفقه‌کنندگان و آمرزش خواهندگان در سحرگاهان (۱۷)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "گو کنم آیا شما را من خبر",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "از نکویی های نیکان در سیر",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "آن کسانی کز خدا دارند خوف",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "روحشان بر حسن دین باشد به طوف",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "هستشان از رب، بهشت و شهرها",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "جاری اندر زیر هر یک نهرها",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "هست آن جنّات اخلاق و صفات",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "نهرهای جاری آمد واردات",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "وآن کسان باشند جاوید اندر او",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "جفتهای پاک و حالات نکو",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "هست رضوانشان ز حق ، یعنی رضاست",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "آنکه بینا بر عباد اندر خفاست",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "ربّنا گویند آن قوم از ادب",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "کاهل ایمانیم و آمرزش طلب",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "ده به آمرزش ره ، ای غفارمان",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "هم نگهدار از عذاب نارمان",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "صابرین و صادقینند آن گروه",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "که نیایند از اطاعت بر ستوه",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "صابر اندر امر و نهی کردگار",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "راستگو در فعل و ترک از اختیار",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "قائمند و دائم اندر بندگی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "می دهند اموال خود در زندگی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "مالها بهر رضای حق دهند",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "تا که دین را قوّت و رونق دهند",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "اندر اسحارند آمرزش طلب",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "هر دم افزایند بر عشق و ادب",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "از ذنوب هستی خود لا شوند",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "باقی اندر هستی مولی شوند",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    }
  ]
}
