      "Text": "وَ لاٰ تَهِنُوا وَ لاٰ تَحْزَنُوا وَ أَنْتُمُ اَلْأَعْلَوْنَ إِنْ کُنْتُمْ مُؤْمِنِینَ (۱۳۹) إِنْ یَمْسَسْکُمْ قَرْحٌ فَقَدْ مَسَّ اَلْقَوْمَ قَرْحٌ مِثْلُهُ وَ تِلْکَ اَلْأَیّٰامُ نُدٰاوِلُهٰا بَیْنَ اَلنّٰاسِ وَ لِیَعْلَمَ اَللّٰهُ اَلَّذِینَ آمَنُوا وَ یَتَّخِذَ مِنْکُمْ شُهَدٰاءَ وَ اَللّٰهُ لاٰ یُحِبُّ اَلظّٰالِمِینَ (۱۴۰) وَ لِیُمَحِّصَ اَللّٰهُ اَلَّذِینَ آمَنُوا وَ یَمْحَقَ اَلْکٰافِرِینَ (۱۴۱) أَمْ حَسِبْتُمْ أَنْ تَدْخُلُوا اَلْجَنَّةَ وَ لَمّٰا یَعْلَمِ اَللّٰهُ اَلَّذِینَ جٰاهَدُوا مِنْکُمْ وَ یَعْلَمَ اَلصّٰابِرِینَ (۱۴۲) وَ لَقَدْ کُنْتُمْ تَمَنَّوْنَ اَلْمَوْتَ مِنْ قَبْلِ أَنْ تَلْقَوْهُ فَقَدْ رَأَیْتُمُوهُ وَ أَنْتُمْ تَنْظُرُونَ (۱۴۳)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "و سست مشوید و اندوهگین نگردید و شما برترانید اگر باشید گروندگان (۱۳۹) اگر مس کند شما را جراحتی پس بدرستی که مس کرد قوم را جراحتی مانند آن و این روزها می‌گردانیمشان بنوبت میان مردمان از برای آنکه بداند خدا آنان را که ایمان آوردند و بگیرد از شما گواهان و خدا دوست ندارد ستمکاران را (۱۴۰) و از برای آنان که خالص کند خدا آنان را که ایمان آوردند و بکاهد کافران را (۱۴۱) آیا پنداشتند که داخل مشوید بهشت را و هنوز جدا نکرده باشد خدا آنها را که مجاهده کردند از شما یا آنکه بداند صبرکنندگان را (۱۴۲) و بدرستی که بودید آرزو می‌کردید مرگ را پیش از آنکه ملاقات کنید او را پس بحقیقت دیدید او را و شما نظر می‌کردید (۱۴۳)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "گر شما گشتید سست و خسته دل",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "هم بر ایشان خستگی شد متصل",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "این شما را بر مثال آن نمود",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "لیک این در دین و آن در کفر بود",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "می بگردانیم اینسان روزها",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "بین مردم در زحیر و سوزها",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "از وجوه مصلحتها و حکم",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "تا جدا از فربهی گردد ورم",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "وجه هر یک داند آن دانای راز",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "تا که را باشد در ایمان امتیاز",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "تا عمل ها ز امتحان آید پدید",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "پاکها ممتاز گردند از پلید",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "از شما در فعلتان گیرد گواه",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "خالص آید زر ز آتش یا سیاه",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Paragraph",
      "Text": "« در بیان غزوۀ احد »",
      "CoupletIndex": 9
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "در اُحد آمد شما را یک شکست",
      "CoupletIndex": 10,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "یک شکستی کز پی اش صد فتح هست",
      "CoupletIndex": 10,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "آن شکست از امتحان دوست بود",
      "CoupletIndex": 11,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "مغزها را امتیاز از پوست بود",
      "CoupletIndex": 11,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "تا که کرد از راه ایمان بذل روح",
      "CoupletIndex": 12,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "یا که شد بند غنیمت در فتوح",
      "CoupletIndex": 12,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "در حقیقت بود آن هم فتح و نصر",
      "CoupletIndex": 13,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "تا موحد باشد اندر حول حصر",
      "CoupletIndex": 13,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "از شکستی گر شوید اندوهناک",
      "CoupletIndex": 14,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "پس چسان از غش درآید زرّ پاک",
      "CoupletIndex": 14,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "کی موحد بند موت است و حیات",
      "CoupletIndex": 15,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "یا شکست از فتح داند در ثبات",
      "CoupletIndex": 15,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "ظلم بر عاشق بود دلدار او",
      "CoupletIndex": 16,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "گر نه ممتازش کند ز اغیار او",
      "CoupletIndex": 16,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "وآن شود ممتاز اندر امتحان",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "کو غنیمت جو بود یا جان فشان",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "آنکه جز محبوب جوید دوست نیست",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "هم به خود ظالم تر از وی گو تو کیست",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "ظالمین را او کجا گیرد به دوست",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "آنکه از خود بگذرد محبوب اوست",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "مؤمنان را حق کند پاکیزه جان",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "هم بکاهد کافران را ز امتحان",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "یا که پندارید داخل در بهشت",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 14
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "بی تمایز میشوید از خوب و زشت",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 14
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "از شما ننموده آنان را جدا",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 15
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "که به حق کردند مال و جان فدا",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 15
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "مر خودیّت را نهادند از وداد",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 16
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "بذل جان کردند بر حق در جهاد",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 16
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "داند او تا کیست اندر دین صبور",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 17
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "از خدا باشد شکیبا در امور",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 17
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "موت را بودید دائم خواستگار",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 18
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "پیش از آن کاسبابش آید آشکار",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 18
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "بعد جنگ بَدرتان بود آرزو",
      "CoupletIndex": 26,
      "SectionIndex1": 1,
      "SectionIndex2": 19
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "کشتن و مردن به پیش روی او",
      "CoupletIndex": 26,
      "SectionIndex1": 1,
      "SectionIndex2": 19
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "شد چو پیدا در اُحد آثار موت",
      "CoupletIndex": 27,
      "SectionIndex1": 1,
      "SectionIndex2": 20
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "منزجر گشتید از دیدار موت",
      "CoupletIndex": 27,
      "SectionIndex1": 1,
      "SectionIndex2": 20
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "مینمودید از عجب بر وی نگاه",
      "CoupletIndex": 28,
      "SectionIndex1": 1,
      "SectionIndex2": 21
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "وین شما را بُد به تمکین اشتباه",
      "CoupletIndex": 28,
      "SectionIndex1": 1,
      "SectionIndex2": 21
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "هست تمکین در شهود حق ثبوت",
      "CoupletIndex": 29,
      "SectionIndex1": 1,
      "SectionIndex2": 22
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "هم شدن فانی به ذات لایموت",
      "CoupletIndex": 29,
      "SectionIndex1": 1,
      "SectionIndex2": 22
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "تا هنوزت هست در افعال سیر",
      "CoupletIndex": 30,
      "SectionIndex1": 1,
      "SectionIndex2": 23
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "بند تلوینی و مستشهد به غیر",
      "CoupletIndex": 30,
      "SectionIndex1": 1,
      "SectionIndex2": 23
    }
  ]
}
