  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "وَإِذۡ أَخَذَ ٱللَّهُ مِیثَٰقَ ٱلنَّبِیِّۧنَ لَمَآ ءَاتَیۡتُکُم مِّن کِتَٰبࣲ وَحِکۡمَةࣲ ثُمَّ جَآءَکُمۡ رَسُولࣱ مُّصَدِّقࣱ لِّمَا مَعَکُمۡ لَتُؤۡمِنُنَّ بِهِۦ وَلَتَنصُرُنَّهُۥۚ قَالَ ءَأَقۡرَرۡتُمۡ وَأَخَذۡتُمۡ عَلَیٰ ذَٰلِکُمۡ إِصۡرِیۖ قَالُوٓاْ أَقۡرَرۡنَاۚ قَالَ فَٱشۡهَدُواْ وَأَنَا۠ مَعَکُم مِّنَ ٱلشَّٰهِدِینَ (۸۱) فَمَن تَوَلَّیٰ بَعۡدَ ذَٰلِکَ فَأُوْلَٰٓئِکَ هُمُ ٱلۡفَٰسِقُونَ (۸۲)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "و هنگامی که گرفت خدا پیمان پیغمبران را که آنچه دادم شما را از کتاب و حکمت پس آمد شما را رسولی تصدیق‌کننده هر آنچه را با شماست هر آینه ایمان خواهید آورد البته باو و هر آینه یاری او کنید البته گفت آیا اقرار کردید و گرفتید بر آنتان پیمان مرا گفتند اقرار کردیم که گفتند پس گواه باشید و من با شما از گواهانم (۸۱) پس هر که رو بگرداند پس از آن پس آن گروه ایشانند نافرمانان (۸۲)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "« در بیان اخذ میثاق حق از پیغمبران و تحقیق عهد که بر دو قسم است »",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Right",
      "Text": "در ازل میثاق توحید از سران",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Left",
      "Text": "حق گرفت اعنی که از پیغمبران",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "بر خلایق عام این میثاق بود",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "لیک خاص انبیاء ز اشفاق بود",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
