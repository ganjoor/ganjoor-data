  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "زُیِّنَ لِلنّٰاسِ حُبُّ اَلشَّهَوٰاتِ مِنَ اَلنِّسٰاءِ وَ اَلْبَنِینَ وَ اَلْقَنٰاطِیرِ اَلْمُقَنْطَرَةِ مِنَ اَلذَّهَبِ وَ اَلْفِضَّةِ وَ اَلْخَیْلِ‌ اَلْمُسَوَّمَةِ وَ اَلْأَنْعٰامِ وَ اَلْحَرْثِ ذٰلِکَ مَتٰاعُ اَلْحَیٰاةِ اَلدُّنْیٰا وَ اَللّٰهُ عِنْدَهُ حُسْنُ اَلْمَآبِ (۱۴)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "آراسته شد از برای مردمان دوستی خواهشها از زنان و پسران و مالهای بسیار تحصیل کرده شده از طلا و نقره و اسبان نشاندار و شتر و گاو و گوسفند و زراعت آن متاع زندگانی دنیاست و خدا نزدش خوبی بازگشت است (۱۴)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "« در بیان دوستی مردمان زنان و اولاد خود را و جمع مال و منال دنیوی که آن مانع حیات معنوی است »",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Right",
      "Text": "یافت زینت مردمان را آن و این",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Left",
      "Text": "حبّ شهوات از نساء و از بنین",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "بودشان با آرزو پیوندها",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "از تعلق با زن و فرزندها",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "وز قَنَاطِیرِ مُقَنْطَر که ز طمع",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "مالها بر یکدگر گردید جمع",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "وز طلا و نقره و اَنعام و خیل",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "کشتزاران که بر آن دل راست میل",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5
