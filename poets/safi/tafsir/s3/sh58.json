      "Position": "Left",
      "Text": "آورید اندر عذاب و انتقام",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "سد نمایید آن ثغوری را که او",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "بر شما داخل شود یعنی عدو",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Paragraph",
      "Text": "« در فضیلت علی علیه السلام »",
      "CoupletIndex": 9
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "چون علی (ع) کو در نبرد و عزم و صبر",
      "CoupletIndex": 10,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "زهره و دل، خون نمود از شیر و ببر",
      "CoupletIndex": 10,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "روز هیجاء بود ثابت همچو کوه",
      "CoupletIndex": 11,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "بود لرزان هر که میدید آن شکوه",
      "CoupletIndex": 11,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "سخت و ثابت همچو سدّ آهنین",
      "CoupletIndex": 12,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "آسمانی کرده جا بر پشت زین",
      "CoupletIndex": 12,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "هر کسی گفت آدم است این یا جبال",
      "CoupletIndex": 13,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "کوه و دریا با که آمد در قتال",
      "CoupletIndex": 13,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "هر که می دید آن مهابت وآن شکیب",
      "CoupletIndex": 14,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "گفت آمد نوبت نهب و نهیب",
      "CoupletIndex": 14,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "همچنین اندر نبرد اژدها",
      "CoupletIndex": 15,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "یعنی اندر کشتن نفس و هوی",
      "CoupletIndex": 15,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "نفس در میدان او چون گرد بود",
      "CoupletIndex": 16,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "نی که او را در مقابل مرد بود",
      "CoupletIndex": 16,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "پهلوانی را به وقتی در برش",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "بر زمین افکند تا بُرّد سرش",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "کرد او کاری که باشد عیب مرد",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "بحر خشم مرتضای جوش کرد",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "حلم پیش آورد و کرد او را رها",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "زآن غزا شد در نبرد اژدها",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "ره چنین آموخت بر مردان کار",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "فخرها را تا تو بشناسی ز عار",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "صبر آنسان کرد در جنگ و جهاد",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 14
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "ربط قالب را به قلب این گونه داد",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 14
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "وجه دیگر گویمت در صبر و ربط",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 15
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "نیک دریاب آن ز دل بی سهو و خبط",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 15
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "اصبِرُواْ یعنی که با نفس شریر",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 16
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "صبر کن می باش در جنگش دلیر",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 16
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "صَابِرُواْ یعنی مراقب شو به دل",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 17
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "از پی تسلیم امرش متصل",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 17
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "رَابِطُواْ یعنی به قطع ماسوی",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 18
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "قطرة خود وصل کن بر بحر لا",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 18
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "وَاتَّقُواْ الله یعنی اسرار وجود",
      "CoupletIndex": 26,
      "SectionIndex1": 1,
      "SectionIndex2": 19
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "کن نهان از عامه چون یابی شهود",
      "CoupletIndex": 26,
      "SectionIndex1": 1,
      "SectionIndex2": 19
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "رستگاری ترک هستی گفتن است",
      "CoupletIndex": 27,
      "SectionIndex1": 1,
      "SectionIndex2": 20
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "راز حق دانستن و بنهفتن است",
      "CoupletIndex": 27,
      "SectionIndex1": 1,
      "SectionIndex2": 20
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "آنچه را شد بر تو کشف آن را بپوش",
      "CoupletIndex": 28,
      "SectionIndex1": 1,
      "SectionIndex2": 21
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "وز بیانش بر خلایق شو خموش",
      "CoupletIndex": 28,
      "SectionIndex1": 1,
      "SectionIndex2": 21
    }
  ]
}
