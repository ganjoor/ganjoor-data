  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "قُلِ اَللّٰهُمَّ مٰالِکَ اَلْمُلْکِ تُؤْتِی اَلْمُلْکَ مَنْ تَشٰاءُ وَ تَنْزِعُ اَلْمُلْکَ مِمَّنْ تَشٰاءُ وَ تُعِزُّ مَنْ تَشٰاءُ وَ تُذِلُّ مَنْ تَشٰاءُ بِیَدِکَ اَلْخَیْرُ إِنَّکَ عَلیٰ کُلِّ شَیْ‌ءٍ قَدِیرٌ (۲۶) تُولِجُ اَللَّیْلَ فِی اَلنَّهٰارِ وَ تُولِجُ اَلنَّهٰارَ فِی اَللَّیْلِ وَ تُخْرِجُ اَلْحَیَّ مِنَ اَلْمَیِّتِ وَ تُخْرِجُ اَلْمَیِّتَ مِنَ اَلْحَیِّ وَ تَرْزُقُ مَنْ تَشٰاءُ بِغَیْرِ حِسٰابٍ (۲۷)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "بگو بار خدایا ای متصرف پادشاهی که می‌دهی پادشاهی را بآنکه می‌خواهی و می‌گیری پادشاهی را از آنکه می‌خواهی و عزیز می‌کنی آن را که می‌خواهی و خوار می‌گردانی آن را که می‌خواهی بدست تو است خوبی بدرستی که تو بر همه چیزی توانایی (۲۶) در می‌آوری شب را در روز و در می‌آوری روز را در شب و بیرون می‌آوری زنده را از مرده و بیرون می‌آوری مرده را از زنده و روزی می‌دهی آن را که می‌خواهی بی‌شمار (۲۷)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "گو تویی ای آنکه بخشی تاج و گاه",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "بر تمام ملک هستی پادشاه",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "شاه آن باشد که هست از مشیتش",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "جان اشیاء در احاطۀ قدرتش",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "هر که را خواهی دهی ملک جهان",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "هم چو خواهی گیری از وی در زمان",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "تَنزِع اعنی مُلک دنیا وآنچه هست",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "منتقل زو گردد از دستی به دست",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "مُلک مُلک توست بر هر کس سزاست",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "بعضی از آن را دهی تا وقت خواست",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "باز گیری زو دهی بر دیگری",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "منتهی چون شد به دُم جوید سری",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "یافت عزّت آنکه یاری از تو جُست",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "دید ذلت آنکه خودبین گشت و سست",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "هر که را دانی به عزّت قابلش",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "در ولای خود کنی صاحبدلش",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "ظاهر و باطن عزیز از حق شود",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "وآنکه خودبین، خوار و بی رونق شود",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "پس به ذلت در خور آمد در وجود",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "مقتضی بود آنچه آمد در نمود",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "هست بر وفق اراده و مشیّتت",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "عزّت و ذلت به دست قدرتت",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "قادری بر منع و بر اعطاء تمام",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "بر هر آنچه آید از هستی به نام",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "منع و اعطاء، قبض و بسط و خفض و رفع",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "رنج و راحت، موت و احیاء، ضرّ و نفع",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "اندر اشیاء برقرار از واجب است",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "کو به فعل خود بر اشیاء غالب است",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "در بهاران از نسیم فرودین",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "باغها شد پر شکوفه و یاسمین",
