      "HtmlText": "\u003Cdiv class=\u0022b\u0022 id=\u0022bn1\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eکی شود در نزد ربّ العالمین\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eضایع و نابود اجر مؤمنین\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E",
      "CoupletsCount": 1
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "وَ لِیَعْلَمَ اَلَّذِینَ نٰافَقُوا وَ قِیلَ لَهُمْ تَعٰالَوْا قٰاتِلُوا فِی سَبِیلِ اَللّٰهِ أَوِ اِدْفَعُوا قٰالُوا لَوْ نَعْلَمُ قِتٰالاً لاَتَّبَعْنٰاکُمْ هُمْ لِلْکُفْرِ یَوْمَئِذٍ أَقْرَبُ مِنْهُمْ لِلْإِیمٰانِ یَقُولُونَ بِأَفْوٰاهِهِمْ مٰا لَیْسَ فِی قُلُوبِهِمْ وَ اَللّٰهُ أَعْلَمُ بِمٰا یَکْتُمُونَ (۱۶۷) اَلَّذِینَ قٰالُوا لِإِخْوٰانِهِمْ وَ قَعَدُوا لَوْ أَطٰاعُونٰا مٰا قُتِلُوا قُلْ فَادْرَؤُا عَنْ أَنْفُسِکُمُ اَلْمَوْتَ إِنْ کُنْتُمْ صٰادِقِینَ (۱۶۸) وَ لاٰ تَحْسَبَنَّ اَلَّذِینَ قُتِلُوا فِی سَبِیلِ اَللّٰهِ أَمْوٰاتاً بَلْ أَحْیٰاءٌ عِنْدَ رَبِّهِمْ یُرْزَقُونَ (۱۶۹) فَرِحِینَ بِمٰا آتٰاهُمُ اَللّٰهُ مِنْ فَضْلِهِ وَ یَسْتَبْشِرُونَ بِالَّذِینَ لَمْ یَلْحَقُوا بِهِمْ مِنْ خَلْفِهِمْ أَلاّٰ خَوْفٌ عَلَیْهِمْ وَ لاٰ هُمْ یَحْزَنُونَ (۱۷۰) یَسْتَبْشِرُونَ بِنِعْمَةٍ مِنَ اَللّٰهِ وَ فَضْلٍ وَ أَنَّ اَللّٰهَ لاٰ یُضِیعُ أَجْرَ اَلْمُؤْمِنِینَ (۱۷۱)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "و تا بداند آنان را که نفاق کردند و گفته شد مر ایشان را که بیائید کارزار کنید در راه خدا یا دفع کنید گفتند اگر می‌دانستیم کارزار کردن هر آینه متابعت می‌کردیم شما را آنها مر کفر را آن روز نزدیکتر بودند از ایشان مر ایمان را می‌گفتند بدهنهاشان آنچه نیست در دلهاشان و خدا داناتر است بآنچه پوشیده می‌دارند (۱۶۷) آنکه گفتند مر برادرانشان را و نشستند اگر اطاعت ما می‌کردند کشته نمی‌شدند بگو پس دفع کنید از خودهاتان مرگ را اگر هستید راستگویان (۱۶۸) و مپندارید البته آنان را که کشته شدند در راه خدا مردگان بلکه زندگانند نزد پروردگارشان روزی داده می‌شوند (۱۶۹) شادمانانند بآنچه دادشان خدا از فضل خود و شادمانی می‌کنند بکسانی که ملحق نشده‌اند بایشان از بعد ایشان اینکه نیست خوفی بر ایشان و نه ایشان اندوهناک شوند (۱۷۰) شادمانی می‌کنند یعنی از خدا و فضلی و بدرستی که خدا ضایع نمی‌کند مرد گروندگان را (۱۷۱)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "تا بداند کآن دورویان آشکار",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "گفته شد کآیند چون در کارزار",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "یا کنید از دشمنان سدّ ثغور",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "یا نماییدش ز حد خویش دور",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "یعنی اندر راه حق کوشید سخت",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "یا محمّد(ص) را برون بندید رخت",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "بعد از آن، کو را به خود دادید راه",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "باشد این سستی دگر عیب و گناه",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "می بگفتند ار بُدیم آگه ز حال",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "که کنند آن مشرکین آخر قتال",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "پیروی کردیم ما هم با شما",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "در قتال آن جماعت بی خطا",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "سوی کفر آن رو ز ایشان اقربند",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "تا به ایمان گرچه صاحب مذهبند",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "بر زبان گویند چیزی را که نیست",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "هیچشان در قلب و حق داند که چیست",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "این نباشد غیر عذری در مهم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "حق بود دانا به سِر مکتتم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "آنکه میگفتند با اخوان خود",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "قاعد و فارغ ز حال نیک و بد",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "بردی از فرمان ما در کارزار",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "کی شدندی کُشته آن مردان کار",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "بازگو دارید گر گویید راست",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "موت را از نفس خود که امر خداست",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "می نپندار آنکه اندر راه حق",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "کُشته گشتند از عهود ماسبق",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "مرده اند ایشان که نزد کردگار",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "زنده بل باشند و از حق رزق خوار",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "شاد و خُرسند از فزونی ها که داد",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "حق بر ایشان چون بر آن بود اعتماد",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "همچنین مستبشر از آل و تبار",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "که کنند از بعد ایشان کارزار",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "گر نه با ایشان به فیضی ملحقند",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "در قتال مشرکین یار حقند",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "ور به ایشان نوبتی ملحق شوند",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "همچو ایشان رهن فضل حق شوند",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "بیند ار کس در حضور کردگار",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "می کنند آل و تبارش کارزار",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "مرحبا گوید خداشان در قتال",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "شادی او بنگر از ابناء و آل",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "نیستشان از قتل و غارت، ترس و غم",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "یا که شد از قلزمی یک قطره کم",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "او چه غم دارد که دنیا سر به سر",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "شد ز سیلاب فناء زیر و زبر",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "یا چه خوف از آنکه فرزندان او",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "میشوند از فضل حق مهمان او",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "میشوند اعنی به فرمان رسول",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "در ره حق کشته بی نقص و نکول",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "ور که هم مانند چندی در جهان",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "در معاش است او کفیل آن مهان",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "شاد آن کش حق بود یار و ولیّ",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "وز حقش مرآت جان شد صیقلی",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "جانش دائم در حریم حق به طوف",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "چیست او را در دو عالم حزن و خوف",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "شادمان از نعمت و فضل خدا",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "کآن ندارد در فزونی انتها",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "کی شود در نزد ربّ العالمین",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "ضایع و نابود اجر مؤمنین",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    }
  ]
}
