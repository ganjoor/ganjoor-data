  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "هُنٰالِکَ دَعٰا زَکَرِیّٰا رَبَّهُ قٰالَ رَبِّ هَبْ لِی مِنْ لَدُنْکَ ذُرِّیَّةً طَیِّبَةً إِنَّکَ سَمِیعُ اَلدُّعٰاءِ (۳۸) فَنٰادَتْهُ اَلْمَلاٰئِکَةُ وَ هُوَ قٰائِمٌ یُصَلِّی فِی اَلْمِحْرٰابِ أَنَّ اَللّٰهَ یُبَشِّرُکَ بِیَحْییٰ مُصَدِّقاً بِکَلِمَةٍ مِنَ اَللّٰهِ وَ سَیِّداً وَ حَصُوراً وَ نَبِیًّا مِنَ اَلصّٰالِحِینَ (۳۹)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "در آنجا خواند زکریا پروردگارش را گفت ای پروردگار من ببخش مرا از نزدت فرزندی پاکیزه بدرستی که تو شنوندۀ دعائی (۳۸) پس ندا کردندش فرشتگان و او ایستاده بود نماز می‌کرد در محراب بدرستی که خدا مژده می‌دهد ترا بیحیی تصدیق کنندۀ بکلمۀ از خدا و مهتر و بازدارنده نفس از شهوتها و پیغمبری از شایستگان (۳۹)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "چون زکریا دید اندر انحصار",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "آن خلاف عادت آنجا آشکار",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "میوه های صیفی اندر فصل دی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "از عنایات خدا در پیش وی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "گفت یا رب ده به من ذریّتی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "کو ز من بر خلق باشد آیتی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "در جوانی زو نشد فرزند و آل",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "این ز خود می دید در پیری محال",
