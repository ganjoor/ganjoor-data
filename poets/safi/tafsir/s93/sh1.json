  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "بسم االله الرحمن الرحیم",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "وَ اَلضُّحیٰ (۱) وَ اَللَّیْلِ إِذٰا سَجیٰ (۲) مٰا وَدَّعَکَ رَبُّکَ وَ مٰا قَلیٰ (۳) وَ لَلْآخِرَةُ خَیْرٌ لَکَ مِنَ اَلْأُولیٰ (۴) وَ لَسَوْفَ یُعْطِیکَ رَبُّکَ فَتَرْضیٰ (۵) أَ لَمْ یَجِدْکَ یَتِیماً فَآویٰ (۶) وَ وَجَدَکَ ضَالاًّ فَهَدیٰ (۷) وَ وَجَدَکَ عٰائِلاً فَأَغْنیٰ (۸) فَأَمَّا اَلْیَتِیمَ فَلاٰ تَقْهَرْ (۹) وَ أَمَّا اَلسّٰائِلَ فَلاٰ تَنْهَرْ (۱۰) وَ أَمّٰا بِنِعْمَةِ رَبِّکَ فَحَدِّثْ (۱۱)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "بنام خدای بخشاینده مهربان",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Paragraph",
      "Text": "بچاشتگاه (۱) و شب چون آرام گیرد (۲) که وا بگذاشت ترا پروردگارت و غضب نکرد (۳) و هر آینه آن جهان بهتر است مر ترا از این جهان (۴) و هر آینه بزودی خواهد داد ترا پروردگارت پس خوشنود کردی (۵) آیا نیافت ترا یتیم پس جایگاه داد (۶) و یافت ترا کم پس هدایت نمود (۷) و یافت ترا بیخبر عیالمند پس توانگر ساخت (۸) پس اما یتیم را پس قهر مکن (۹) و اما سؤال کننده را پس زجر مکن (۱۰) و اما بنعمت پروردگارت پس اخبار کن (۱۱)",
      "CoupletIndex": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "می خورد سوگند حق بر چاشتگاه",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "چونکه نور خود فزاید از اِله",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "هم به شب سوگند که آرام و قرار",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "می بیاید تیرگی در روزگار",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "حق تو را نگذاشت باز ای بوالوفاء",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "هیچ هم نگرفت دشمن در خفاء",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "مر تو را بهتر بود دیگر سرای",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "زین سرای پر ز اندوه و عنای",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "زود باشد که کند ربّت عطاء",
