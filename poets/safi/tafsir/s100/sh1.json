      "VOrder": 4,
      "Position": "Paragraph",
      "Text": "برونده‌ها با آواز نفس زدن نفس زدنی (۱) پس آتش بر آرنده‌ها آتش بر آوردنی (۲) پس آنها که وسیله غارت شوند در صبح (۳) پس برانگیختند بآن غبار را (۴) پس در میان درآمدند بآن جماعتی را (۵) بدرستی که انسانست مر پروردگارش را ناسپاس (۶) و بدرستی که او بر آن هر آینه شاهد است (۷) و بدرستی که او برای دوستی مال هر آینه سخت است (۸) آیا پس نمی‌داند که چون برانگیخته شود در گورهاست (۹) و تمیز کرده شود آنچه در سینه‌هاست (۱۰) بدرستی که پروردگارشان بایشان روز چنین آگاه است (۱۱)",
      "CoupletIndex": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "قومی از اعراب کردند اجتماع",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "در زمین رمله از بهر نزاع",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "تا شبیخون بر مدینه آورند",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "یا به جیش مسلمین از ناپسند",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "چون رسید از ره به سیّد این خبر",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "سویشان کرد او علی (ع) را ره سپر",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "شد روان رزم آزمایی صد مصاف",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "با گروهی سوی ارباب خلاف",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "غزوة ذات السلاسل باشد این",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "که به زنجیر آمدند آن مشرکین",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "ره به شب میرفت و پنهان بود روز",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "تا رسید آن شیر حق بر جیش یوز",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "صبحگاهی تاخت بر ایشان ز راه",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "برق بین تا چون کند با مشت کاه",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "کار نامد حیله و تدبیرشان",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "شیر حق بکشید در زنجیرشان",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "کُشت ز ایشان فرقه ای را در نبرد",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "فرقه ای را هم به آهن بند کرد",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "چونکه برگشتند رودی بُد عظیم",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "و آب طغیان داشت شد لشکر مقیم",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "تا که آب اندک شود بتوان عبور",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "بر مدینه نامد اخبار از مرور",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "آن دورویان از نشان بی فروغ",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "منتشر کردند اخبار دروغ",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "تنگدل شد زآن خبرها مصطفی (ص)",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "جبرئیل این آیت آورد از خدا",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "که به اسبان دونده مر قسم",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "که زنند ایشان نفس در تاخت هم",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "پس قسم بر آن که آتشها ز سنگ",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "زیر سُم آرند بیرون بی درنگ",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "هم به آن اسبان غارت گر قسم",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "که به خصم آرند رو در صبح دم",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "قصد از اسبان، سواران سرند",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "که به صبح از جیش اعداء صفدرند",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "پس غباری در کنار آن گروه",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "صبحگاه انگیختندی از وجوه",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "آمدندی پس به صبح اندر میان",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "مر گروهی را به قهر از دشمنان",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "این جواب است از قسم که آدمی",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "رب خود را ناسپاس است او همی",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "چون دورویانی که از خُبث نهان",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "افکنند ارجوفه ها در مردمان",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "مر کَنُود است آنکه او ندهد عطا",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "می خورد تنها زند مر بنده را",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "آنکه ضارب بر غلام است و کنیز",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "و اهل او را می مخر بر یک پشیز",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "حق بود بر بخل و کفرانش گواه",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "بر خود است او یا گُوَه در حشرگاه",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "هم به تحقیق آنکه اندر حبّ مال",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "سخت باشد آدمی از سوء حال",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "پس نداند منبعث آیا شود",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "آنچه باشد در فتور از نیک و بد",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "جمع گردانیده گردد هم به جا",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "آنچه باشد مختفی در سینه ها",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "روز حشر اندر مجازات کبیر",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "رب ایشان است بر ایشان خبیر",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    }
  ]
}
