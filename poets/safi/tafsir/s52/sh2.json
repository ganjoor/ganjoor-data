      "Text": "حرف لغوی یا گناهی بهرشان",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "دور ایشان خادمان اندر طواف",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "از پسرهای نکو رو، بی خلاف",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "در صفاء و در صباحت هر طرف",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "همچو مروارید پنهان در صدف",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "بعضی از ایشان به بعض آرند رو",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "می بپرسند از عملهای نکو",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "که شده است او این سعادت را سبب",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "وجه آن را می کنند از هم طلب",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "در میان اهل خود گویند ما",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "مشفقین بودیم و ترسان از خدا",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "حق به ما منّت نهاد از این رسوم",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "خود نگهمان داشت از نار سموم",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "پیش از این بودیم کز وجه خلوص",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "می پرستیدیم او را با نصوص",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "بس نکوکار است او بر بندگان",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "در دو عالم فیض بخش و مهربان",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    }
  ]
}
