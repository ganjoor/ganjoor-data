      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "حاصل آنکه می خورد ربّ الکرم",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "خود بر این اشیاء مذکوره قسم",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "که عذاب کردگارت واقع است",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "کز شئونش ما لَهُ مِن دَافِع است",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "اندر آن روزی که یابد اضطراب",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "آسمان آن اضطراب بی حساب",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "می زند بر دور خود پیوسته موج",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "گه چو کشتی در حضیض و گه به اوج",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "هم روان گردند از جا کوه ها",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "چون هباء پَرکَنده بر روی هوا",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "وای پس آن روز بر آن بی فروغ",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "داشتی کو قول حق را بر دروغ",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "آن کسان کاندر شروع باطلند",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "حق به بازی بشمرند و غافلند",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "دفع کرده کافران سوی جحیم",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "می شوند آن روز دفعی بس وخیم",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "هَذِهِ النَّارُ الَّتُی کُنتُم بِهَا",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "که بدان تکذیب کردید از عمی",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "این بود آیا که جادو در نشان",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "یا که کورید و نمی بینید آن",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "وحی حق را سحر می پنداشتید",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "این همان سحر است گر دارید دید",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "نک به دوزخ اندر آیید از شتاب",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "صبر پس باید کنید اندر عذاب",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "صبر یا نکنید یکسان بر شماست",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "صبر و بی صبری مفر نی زین بلاست",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "غیر از این نبود جزاء داده شوید",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "بر هر آنچه می نمودید آن پدید",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    }
  ]
}
