      "Text": "فَذَکِّرْ فَمٰا أَنْتَ بِنِعْمَةِ رَبِّکَ بِکٰاهِنٍ وَ لاٰ مَجْنُونٍ (۲۹) أَمْ یَقُولُونَ شٰاعِرٌ نَتَرَبَّصُ بِهِ رَیْبَ اَلْمَنُونِ (۳۰) قُلْ تَرَبَّصُوا فَإِنِّی مَعَکُمْ مِنَ اَلْمُتَرَبِّصِینَ (۳۱) أَمْ تَأْمُرُهُمْ أَحْلاٰمُهُمْ بِهٰذٰا أَمْ هُمْ قَوْمٌ طٰاغُونَ (۳۲) أَمْ یَقُولُونَ تَقَوَّلَهُ بَلْ لاٰ یُؤْمِنُونَ (۳۳) فَلْیَأْتُوا بِحَدِیثٍ مِثْلِهِ إِنْ کٰانُوا صٰادِقِینَ (۳۴) أَمْ خُلِقُوا مِنْ غَیْرِ شَیْ‌ءٍ أَمْ هُمُ اَلْخٰالِقُونَ (۳۵) أَمْ خَلَقُوا اَلسَّمٰاوٰاتِ وَ اَلْأَرْضَ بَلْ لاٰ یُوقِنُونَ (۳۶) أَمْ عِنْدَهُمْ خَزٰائِنُ رَبِّکَ أَمْ هُمُ اَلْمُصَیْطِرُونَ (۳۷) أَمْ لَهُمْ سُلَّمٌ یَسْتَمِعُونَ فِیهِ فَلْیَأْتِ مُسْتَمِعُهُمْ بِسُلْطٰانٍ مُبِینٍ (۳۸) أَمْ لَهُ اَلْبَنٰاتُ وَ لَکُمُ اَلْبَنُونَ (۳۹) أَمْ تَسْئَلُهُمْ أَجْراً فَهُمْ مِنْ مَغْرَمٍ مُثْقَلُونَ (۴۰)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "پس پند ده پس نیستی تو بنعمة پروردگارت غیب گوی بدون وحی و نه دیوانه (۲۹) بلکه می‌گویند شاعریست که انتظار می‌بریم باو حادثه روزگار را (۳۰) بگو منتظر باشید پس بدرستی که من با شما از منتظرانم (۳۱) یا امر می‌کند ایشان را خودهاشان باین یا ایشانند گروهی زیاده روان (۳۲) یا می‌گویند بر بافت آن را بلکه ایمان نمی‌آوردند (۳۳) پس باید بیاورند کلامی مانند آن اگر هستید راستگویان (۳۴) یا آفریده شدند از غیر چیزی یا ایشانند آفرینندگان (۳۵) یا آفریدند آسمانها و زمین را بلکه یقین نمی‌کنند (۳۶) یا نزد ایشانند خزینهای پروردگار تو یا ایشانند تسلط دارندگان (۳۷) یا مر ایشان‌راست نردبانی که گوش می‌کنند در آن پس باید که بیاورد شنونده ایشان حجتی واضح (۳۸) یا مر او راست دختران و مر شما راست پسران (۳۹) یا می‌خواهی از ایشان مزدی پس ایشانند از التزام نادان ناحقی گرانبارشدگان (۴۰)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "پند ده پس ای رسول محترم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "باش هم در کار خود ثابت قدم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "نیستی بر نعمت پروردگار",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "کاهن و مجنون تو ای کامل عیار",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "نعمت حق بر تو وحی صادق است",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "وآن نه بر لغو و کهانت لایق است",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "می بگویند اوست شاعر در فنون",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "منتظر باشیمش از رَیبَ الْمَنُون",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "بر وی اعنی حادثات روزگار",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "در رسد یا موت داریم انتظار",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "گو شما باشید مانا منتظر",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "نکبت و مرگ مرا در جهر و سرّ",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "با شما پس من بر اینم استوار",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "دارم اعنی بر هلاکت انتظار",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "بل نماید امر ایشان را چنین",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "عقلهای خام شوریده به این",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "بر تناقض باشد اعنی قولشان",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "نیست هیچ از عقل اندر حولشان",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "زآنکه از نفی خرد باشد جنون",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "شاعر و کاهن بود عقلش فزون",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "بلکه ایشانند از ره گشتگان",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "قومی از حد و ز خرد بگذشتگان",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "بلکه گویند این گروه بی خرد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "بافته است این را محمّد (ص) پیش خود",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "بلکه ایمان می نیارند این فرق",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "قولشان اندر تقوّل نیست حق",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "گر تقوّل باشد این، پس آورند",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "مثل قرآن خود کلامی ارجمند",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "راست گر گویند و دارند این شناخت",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "که چو قرآن می توان اقوال ساخت",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "گشته اند آیا که خلق از غیر چیز",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "یعنی از بی باعثی اندر تمیز",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "خالقی یعنی ندارند این رمه",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "یا که بر بازیچه شد خلق این همه",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "یا به مانند جمادات و حجر",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "خلق بی مادر شدستند و پدر",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "یا که ایشان آفرینندة خودند",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "خود نگهدار خود و زنده خودند",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "آفریدستند آیا این چنین",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "یا که ایشان این سماوات و زمین",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "بلکه می نایند ایشان بر یقین",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "آفریده تا که اشیاء را چنین",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "نزد ایشان است آیا برقرار",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "گنجهای فضل آن پروردگار",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "تا دهند آن را که خواهند از عطا",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "کیست یا دانند بر رحمت سزا",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "غالبند آیا بر اشیاء در ظهور",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "تا کنند از علم، تدبیر امور",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "سُلَّم آیا هستشان تا برنهند",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "بر سماء، قول ملک تا بشنوند",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "مستمعشان باید آرد بی ز ریب",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "حجتی بر صدق سمع خود ز غیب",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "هست آیا مر خدا را دختران",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "هم پسرها مر شما را چو اختران",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "خواهی آیا اجر و مزدی زین گروه",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "تو به تبلیغ رسالت از وجوه",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "ز التزام آن، چنان تاوان شوند",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "پس گرانبار این کج اندیشان شوند",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    }
  ]
}
