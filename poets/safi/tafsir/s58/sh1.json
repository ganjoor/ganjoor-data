  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "بسم االله الرحمن الرحیم",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "قَدْ سَمِعَ اَللّٰهُ قَوْلَ اَلَّتِی تُجٰادِلُکَ فِی زَوْجِهٰا وَ تَشْتَکِی إِلَی اَللّٰهِ وَ اَللّٰهُ یَسْمَعُ تَحٰاوُرَکُمٰا إِنَّ اَللّٰهَ سَمِیعٌ بَصِیرٌ (۱) اَلَّذِینَ یُظٰاهِرُونَ مِنْکُمْ مِنْ نِسٰائِهِمْ مٰا هُنَّ أُمَّهٰاتِهِمْ إِنْ أُمَّهٰاتُهُمْ إِلاَّ اَللاّٰئِی وَلَدْنَهُمْ وَ إِنَّهُمْ لَیَقُولُونَ مُنْکَراً مِنَ اَلْقَوْلِ وَ زُوراً وَ إِنَّ اَللّٰهَ لَعَفُوٌّ غَفُورٌ (۲)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "بنام خدای بخشندۀ مهربان",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Paragraph",
      "Text": "بتحقیق شنید خدا گفتن آن زنی که مجادله می‌کرد با تو در زوجش و شکایت می‌برد بخدا و خدا می‌شنید گفتگوی شما را بدرستی که خدا شنوای بیناست (۱) آنان که اظهار کنند از شما از زنانشان نیستند آنها مادران ایشان نباشند مادران ایشان جز آن زنانی که زادند آنها را و ایشان می‌گویند ناپسندی از گفتار و دروغی و بدرستی که خداست درگذرنده آمرزنده (۲)",
      "CoupletIndex": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "کرد مردی زوجۀ خود را ظهار",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "زن شکایت کرد با فخر کبار",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "گفت پیغمبر شدی بر وی حرام",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "واندر این معنی مکرر شد کلام",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "زن بسی می بود زآن ره تنگدل",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "عرض حال خویش کردی متصل",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "در نبی پس شد پدید آثار وحی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "جبرئیلش بود آن دم یار وحی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "پس تلاوت کرد این آیات را",
