      "VOrder": 11,
      "Position": "Right",
      "Text": "دور گردد جَنبشان از خوابگاه",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "رب خود را چون بخوانندی به گاه",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "از ره خوف اعنی از خوف غضب",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "یا که از امید رحمت در سبب",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "این است حال شبروان ذو فنون",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "که به ذکر آیند از بستر برون",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "وآنچه روزی ما به ایشان داده ایم",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "می کنند انفاق از طبع کریم",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "پس نداند نفسی آنچه در خفا",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "هستشان از روشنیِ دیده ها",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "اجرشان داند خدای لم یزل",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "بر جزای آنچه کردند از عمل",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Paragraph",
      "Text": "« در بیان امتیاز مؤمن از فاسق »",
      "CoupletIndex": 12
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "پس بود آیا کسی کو مؤمن است",
      "CoupletIndex": 13,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "چون کسی کو فاسق و ناموقن است",
      "CoupletIndex": 13,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "نیستند ایشان برابر در جزا",
      "CoupletIndex": 14,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "چون موحد باشد آن مشرک کجا",
      "CoupletIndex": 14,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "مؤمنان که کرده اند اعمال نیک",
      "CoupletIndex": 15,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "پس مر ایشان راست جنّتها و لیک",
      "CoupletIndex": 15,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "بوستانها کوست در واقع مقر",
      "CoupletIndex": 16,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "وز حق ایشان را چو مهمان ماحَضَر",
      "CoupletIndex": 16,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "بر جزای کرده های نیکشان",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "بر چنان جنّت کند نزدیکشان",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "فاسقان اما که هم از راه دین",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "می برون رفتند سوی کفر و کین",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "پس مر ایشان راست آتش جایگاه",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "بر جزای کفر و طغیان و گناه",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "هر قدر خواهند زآن بیرون روند",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "باز برگردانده در آتش شوند",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "بر جهنم هر دم ایشان را ایاب",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "هست وَقِیلَ لَهُم ذُوقُواْ عَذَاب",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "آتشی که بودتان تکذیب از آن",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "چونکه می کردند وصفش را بیان",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "می چشانیم از عذابی کوست زود",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "جز عذاب اکبر از روی خلود",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "رنج ادنی، قتل و اُسر و غارت است",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 14
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "رنج اکبر، دوزخ پُر آفت است",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 14
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "شاید ایشان بر خدا راجع شوند",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 15
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "مابقی بر حکم حق تابع شوند",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 15
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "کیست ظالم تر از آن کس در سند",
      "CoupletIndex": 26,
      "SectionIndex1": 1,
      "SectionIndex2": 16
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "پند داده گو به آیتها شود",
      "CoupletIndex": 26,
      "SectionIndex1": 1,
      "SectionIndex2": 16
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "پس کند اعراض از آن اندر مقام",
      "CoupletIndex": 27,
      "SectionIndex1": 1,
      "SectionIndex2": 17
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "ما کِشیم از مشرکان خود انتقام",
      "CoupletIndex": 27,
      "SectionIndex1": 1,
      "SectionIndex2": 17
    }
  ]
}
