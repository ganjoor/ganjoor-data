      "Text": "إِنْ یَثْقَفُوکُمْ یَکُونُوا لَکُمْ أَعْدٰاءً وَ یَبْسُطُوا إِلَیْکُمْ أَیْدِیَهُمْ وَ أَلْسِنَتَهُمْ بِالسُّوءِ وَ وَدُّوا لَوْ تَکْفُرُونَ (۲) لَنْ تَنْفَعَکُمْ أَرْحٰامُکُمْ وَ لاٰ أَوْلاٰدُکُمْ یَوْمَ اَلْقِیٰامَةِ یَفْصِلُ بَیْنَکُمْ وَ اَللّٰهُ بِمٰا تَعْمَلُونَ بَصِیرٌ (۳) قَدْ کٰانَتْ لَکُمْ أُسْوَةٌ حَسَنَةٌ فِی إِبْرٰاهِیمَ وَ اَلَّذِینَ مَعَهُ إِذْ قٰالُوا لِقَوْمِهِمْ إِنّٰا بُرَآؤُا مِنْکُمْ وَ مِمّٰا تَعْبُدُونَ مِنْ دُونِ اَللّٰهِ کَفَرْنٰا بِکُمْ وَ بَدٰا بَیْنَنٰا وَ بَیْنَکُمُ اَلْعَدٰاوَةُ وَ اَلْبَغْضٰاءُ أَبَداً حَتّٰی تُؤْمِنُوا بِاللّٰهِ وَحْدَهُ إِلاّٰ قَوْلَ إِبْرٰاهِیمَ لِأَبِیهِ لَأَسْتَغْفِرَنَّ لَکَ وَ مٰا أَمْلِکُ لَکَ مِنَ اَللّٰهِ مِنْ شَیْ‌ءٍ رَبَّنٰا عَلَیْکَ تَوَکَّلْنٰا وَ إِلَیْکَ أَنَبْنٰا وَ إِلَیْکَ اَلْمَصِیرُ (۴) رَبَّنٰا لاٰ تَجْعَلْنٰا فِتْنَةً لِلَّذِینَ کَفَرُوا وَ اِغْفِرْ لَنٰا رَبَّنٰا إِنَّکَ أَنْتَ اَلْعَزِیزُ اَلْحَکِیمُ (۵) لَقَدْ کٰانَ لَکُمْ فِیهِمْ أُسْوَةٌ حَسَنَةٌ لِمَنْ کٰانَ یَرْجُوا اَللّٰهَ وَ اَلْیَوْمَ اَلْآخِرَ وَ مَنْ یَتَوَلَّ فَإِنَّ اَللّٰهَ هُوَ اَلْغَنِیُّ اَلْحَمِیدُ (۶) عَسَی اَللّٰهُ أَنْ یَجْعَلَ بَیْنَکُمْ وَ بَیْنَ اَلَّذِینَ عٰادَیْتُمْ مِنْهُمْ مَوَدَّةً وَ اَللّٰهُ قَدِیرٌ وَ اَللّٰهُ غَفُورٌ رَحِیمٌ (۷)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "اگر یابند شما را باشند مر شما را دشمنان و گشایند بشما دستهاشان و زبانهاشان ببدی و آرزو کردند کاش کافر بودندی (۲) سودی ندهد هرگز شما را رحمتهاتان و نه فرزندانتان روز قیامت جدایی می‌اندازد میانتان و خداست بآنچه می‌کنید بینا (۳) بتحقیق که باشد مر شما را اقتدای نیکو در ابراهیم و آنان که بودند با او هنگامی که گفتند مر قومشان را بدرستی که بیزاریم از شما و از آنچه می‌پرستید از غیر خدا انکار ورزیدیم بشما و پدید آمد میانه ما و میانه شما دشمنی و کینه‌ورزی همیشه تا که ایمان آرید بخدا تنهاست او مگر گفتن ابراهیم مر پدرش را که هر آینه آمرزش خواهم من برای تو و مالک نیستم ترا از خدا هیچ چیز پروردگار ما بر تو توکل کردیم و بسوی تو بازگشت نمودیم و بسوی تست بازگشت (۴) پروردگار ما مگردان ما را فتنه برای آنان که کافر شدند و بیامرز ما را پروردگار ما بدرستی که تویی عزیز حکیم (۵) بتحقیق که باشد مر شما را اقتدای نیکو مر کسی را که هست امیدواری بخدا و روز بازپسین و آنکه روی گرداند پس بدرستی که خدا اوست بینیاز ستوده (۶) شاید که خدا بگرداند میانه شما و میانه آنان که دشمن داشتید از ایشان دوستی و خدا تواناست و خدا آمرزنده مهربان است (۷)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "مشرکان یابندتان گر در گذر",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "بر شما یابند یعنی گر ظفر",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "مر شما را دشمنانند و عنود",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "ندهد القای مودّت هیچ سود",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "برگشایند از کمین، دست و زبان",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "سویتان بر قتل و دشنام از عیان",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "دوست می دارند گر کافر شوید",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "سوی دین سابق خود هم روید",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "دشمن آن چیزی که باشد خوب تر",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "خواهد از خصمش کند معیوب تر",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "خوبتر از دین نباشد هیچ چیز",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "دشمن آن بیشتر باشند نیز",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "نفع کی ارحام و فرزندانتان",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "بر شما هرگز دهند آسانتان",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "بهر فرزندان مودّت با عدو",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "تا کنید آن را به نفعی نیست رو",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "حق جدایی افکند در رستخیز",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "بینتان باشید کز هم رو گریز",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "حق بدانچه می کنید از ناگزیر",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "از عناد و دوستی باشد بصیر",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "هست در ترک موالات عدو",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "مر شما را خصلت و خُلقی نکو",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "اندر ابراهیم بود آن وصف نیک",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "وآنکه با او بود در خصلت شریک",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "قوم خود را چونکه گفتند از شما",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "وآنچه بپرستید بیزاریم ما",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "جز خدا کو را پرستیدن رواست",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "نگرویم آن را که معبود شماست",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "دشمنی و بغض کز قلب است و دست",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "بین ما شد ظاهر و پیوسته است",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "تا که ایمان در خدا آرید و بس",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "کو بود یکتا و با او نیست کس",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "غیر قولی را که ابراهیم گفت",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "مر پدر را از تلطّف در نهفت",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "خواهم از بهر تو آمرزش ز حق",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "گر بری کردی ز کیش این فرق",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "از عذاب حق بنتوانم نکو",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "کز تو سازم دفع چیزی یک تسو",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "باقی ار مانی به شرک اعنی چنین",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "نیست استغفار بهر مشرکین",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "زآنکه مشرک را نیامرزد خدا",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "پس به ایمان مر تو را گویم دعا",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "حاصل آنکه چون براهیم غیور",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "از عدوی حق بری باشید و دور",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "گفت با اصحابش ای پروردگار",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "ما توکل بر تو کردیم استوار",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "هم به سویت بازگشتیم از رجا",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "بر تو باشد بازگشت ماسوی",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "می مگردان فتنه ای رب مجید",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "خود تو ما را بر کسی کو نگروید",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "یعنی ایشان را مکن غالب به ما",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "تا شود آن آزمایش و ابتلا",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "تا نگویند ار بُدند ایشان به حق",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "کی اسیر ما شدندی با غلق",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "ده به ما آمرزش ای پروردگار",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "چون تویی خود غالب و دانا به کار",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "خود شما را خصلتی باشد حسن",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "اندر ابراهیم و قومش بی سخن",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "آنکه را کو بر خدا دارد امید",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "هم به روز آخر از وعد و وعید",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "وآنکه رو گرداند از این اقتدا",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "دوستی با دشمنان آرد بجا",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "پس خداوند او غنی است و حمید",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "بی نیاز، استوده ز افعال عبید",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "هست امید آنکه گرداند خدا",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "در میان آن جماعت با شما",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "که شماشان دشمن از دین داشتید",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "آن مودّت که نمی پنداشتید",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "حق به هر کاری است قادر بالعیان",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 36
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "هم حق است آمرزگار و مهربان",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 36
    },
    {
      "VOrder": 73,
