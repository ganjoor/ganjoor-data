      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "یٰا أَیُّهَا اَلَّذِینَ آمَنُوا لاٰ تَتَّخِذُوا عَدُوِّی وَ عَدُوَّکُمْ أَوْلِیٰاءَ تُلْقُونَ إِلَیْهِمْ بِالْمَوَدَّةِ وَ قَدْ کَفَرُوا بِمٰا جٰاءَکُمْ مِنَ اَلْحَقِّ یُخْرِجُونَ اَلرَّسُولَ وَ إِیّٰاکُمْ أَنْ تُؤْمِنُوا بِاللّٰهِ رَبِّکُمْ إِنْ کُنْتُمْ خَرَجْتُمْ جِهٰاداً فِی سَبِیلِی وَ اِبْتِغٰاءَ مَرْضٰاتِی تُسِرُّونَ إِلَیْهِمْ بِالْمَوَدَّةِ وَ أَنَا أَعْلَمُ بِمٰا أَخْفَیْتُمْ وَ مٰا أَعْلَنْتُمْ وَ مَنْ یَفْعَلْهُ مِنْکُمْ فَقَدْ ضَلَّ سَوٰاءَ اَلسَّبِیلِ (۱)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "بنام خداوند بخشاینده مهربان",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Paragraph",
      "Text": "ای آن کسانی که ایمان آوردید مگیرید دشمن مرا و دشمن خودتان را دوستان می‌فرستید بسوی ایشان بدوستی و بتحقیق کافر شدند بآنچه آمد شما را از حق بیرون می‌کنند رسول را و شما را که بیرون می‌آرید بخدا پروردگارتان گر هستید که بیرون می‌آید برای جهاد کردن در راه من و جستن رضای من پنهانی می‌فرستید بسوی ایشان بدوستی و من داناترم بآنچه پنهان می‌کنید و آنچه آشکار می‌کنید و آنچه می‌کند آن را از شما پس بتحقیق که گم شد از میان راه (۱)",
      "CoupletIndex": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "باشد این سورة مودّت و امتحان",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "کآورم از فضل باری در بیان",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "می مگیرید ای گروه مؤمنان",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "دوستان از بهر خویش از دشمنان",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "آنکه باشد با شما و من عدو",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "کی به هرگز با شما شد دوست او",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "بر مدینه آمد از یثرب زنی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "کو مغنیّه بُد و اینش فنی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "بعد قصۀ بدر و بودش ساره نام",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "پس از او پرسید سلطان انام",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "آمدی کاسلام آری گفت نی",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "آمدم بهر لباس و خوردنی",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "رفع چون گردید عریانی و جوع",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "باز خواهم کرد بر مکه رجوع",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "گفت پیغمبر چه شد کز مکیان",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "با تغنّی جامه نگرفتی و نان",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "گفت بعد از واقعۀ بدر از فسوس",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "کس نکردی بر غناء میل از نفوس",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "پس به او دادند جامه و راحله",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "آل عبد المطلب بی فاصله",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "داد خاطب نامی او هم جامه ای",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "بر وی بنوشت پنهان نامه ای",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "سوی اهل مکه کآید مصطفی",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "سویتان البته از بهر غزا",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "پس شما باشید حاضر بهر جنگ",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "تا سلاح آرید از هر جا به چنگ",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "زین خبر شد احمد (ص) از وحی جلیل",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "پس علی (ع) را ساخت با جمعی گسیل",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "تا ستاند نامه را از ساره باز",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "زن نمود از آن اِباء و احتراز",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "پس بگشتند آن متاعش را تمام",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "نامه زآن پیدا نشد با اهتمام",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "کرد تهدید او بکشتن دیگرش",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "نامه بیرون کرد از موی سرش",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "در مدینه باز با نامه شدند",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "سوی مسجد جمع با عامه شدند",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "تا خبر یابند از تفصیل آن",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "تا چه بنوشت و که بنوشت آن چنان",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "گفت پیغمبر هر آن کرد این خلاف",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "باید او تا خود نماید اعتراف",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "ور نه من رسوا کنم در محضرش",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "معترف گردید خاطب در برش",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "گفت باالله این نکردم از نفاق",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "بلکه تدبیری بُد این دو ر از سیاق",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "چون مهاجر هر یکی دارند بس",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "از عشیره و اقرباء در مکه کس",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "من ندارم هیچ کس را تا کند",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "اهل بیتم را ز بدخواهان مدد",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "خواستم بر مکیان حقی ز من",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "ثابت از این نامه آید بی سخن",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "تا رعایت ز اهل و اولادم کنند",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "نی که از جا بیخ و بنیادم کَنند",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "کرد تصدیقش پیمبر زین کلام",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "آمد این آیت پس از ربّ الانام",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "دوستی را می کنید القاء شما",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "سوی ایشان که نی اند اهل ولا",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "وآنگهی که کافرانند آن فرق",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "آنچه را که بر شما آمد ز حق",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "می کنند از مکه اخراج رسول",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "هم شما را بهر ایمان و قبول",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "بگرویدستید زآنکه بر خدا",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "که بود پروردگار او بر شما",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "خود شما گیرید ایشان را به دوست",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "کز شما خواهند تا بکشند پوست",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "گر شما هستید کز بهر جهاد",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "آمدید از خانه بیرون با سداد",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "تا کنید از جان به راه من قتال",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "هم رضای من بجویید از کمال",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "سویشان پس می فرستید از نهان",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 36
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "دوستی را از کتابت ناگهان",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 36
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "از شما داناترم من بر عبید",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "SectionIndex2": 37
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "آنچه پنهان از مودّت می کنید",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "SectionIndex2": 37
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "وآنچه می سازید ظاهر ز اعتذار",
      "CoupletIndex": 40,
      "SectionIndex1": 0,
      "SectionIndex2": 38
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "آگهم من بر نهان و آشکار",
      "CoupletIndex": 40,
      "SectionIndex1": 0,
      "SectionIndex2": 38
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "میکند هر کس که این کار از شما",
      "CoupletIndex": 41,
      "SectionIndex1": 0,
      "SectionIndex2": 39
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "گشته گُم راهش، رود ره بر خطا",
      "CoupletIndex": 41,
      "SectionIndex1": 0,
      "SectionIndex2": 39
    }
  ]
}
