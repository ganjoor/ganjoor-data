      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "جمله محتاجید بر وی هر نفس",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "گر ز امر او بگردانید رو",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "جایتان قوم دگر را آرد او",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "تا بر ایشان رونق و روزی دهد",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "نصر و نیرو فتح و فیروزی دهد",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "زآن جماعت دین خود ظاهر کند",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "بر جهانشان غالب و قاهر کند",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "پس نباشد آن جماعت چون شما",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "بلکه سخت و ثابتند اندر ولا",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "زو بپرسیدند کایشان کیستند",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "گفت غیر از قوم سلمان نیستند",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "یعنی اهل فارس باشند آن گروه",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "که از ایشان دین حق یابد شکوه",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "زین بیان قصد اصفهان و فارس نیست",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "بلکه توحید و مقام معنوی است",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "بود سلمان رسته از آب و گل او",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "داشت جا در شهر منّا یکدل او",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "همچو او آیند یعنی در سلوک",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "رهنوردان قویدل از ملوک",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "دورة دیگر که دور اولیاست",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "کار مردان بر مراد و مدعاست",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "مال چبود تا که در پیمان دهند",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "چیست جان تا گویم آسان جان دهند",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "در طریق ار با صفی همره شوی",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "زآن دیار و اهل آن آگه شوی",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    }
  ]
}
