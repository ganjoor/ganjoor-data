      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "فَلاٰ أُقْسِمُ بِمَوٰاقِعِ اَلنُّجُومِ (۷۵) وَ إِنَّهُ لَقَسَمٌ لَوْ تَعْلَمُونَ عَظِیمٌ (۷۶) إِنَّهُ لَقُرْآنٌ کَرِیمٌ (۷۷) فِی کِتٰابٍ مَکْنُونٍ (۷۸) لاٰ یَمَسُّهُ إِلاَّ اَلْمُطَهَّرُونَ (۷۹) تَنْزِیلٌ مِنْ رَبِّ اَلْعٰالَمِینَ (۸۰) أَ فَبِهٰذَا اَلْحَدِیثِ أَنْتُمْ مُدْهِنُونَ (۸۱) وَ تَجْعَلُونَ رِزْقَکُمْ أَنَّکُمْ تُکَذِّبُونَ (۸۲) فَلَوْ لاٰ إِذٰا بَلَغَتِ اَلْحُلْقُومَ (۸۳) وَ أَنْتُمْ حِینَئِذٍ تَنْظُرُونَ (۸۴) وَ نَحْنُ أَقْرَبُ إِلَیْهِ مِنْکُمْ وَ لٰکِنْ لاٰ تُبْصِرُونَ (۸۵) فَلَوْ لاٰ إِنْ کُنْتُمْ غَیْرَ مَدِینِینَ (۸۶) تَرْجِعُونَهٰا إِنْ کُنْتُمْ صٰادِقِینَ (۸۷) فَأَمّٰا إِنْ کٰانَ مِنَ اَلْمُقَرَّبِینَ (۸۸) فَرَوْحٌ وَ رَیْحٰانٌ وَ جَنَّةُ نَعِیمٍ (۸۹) وَ أَمّٰا إِنْ کٰانَ مِنْ أَصْحٰابِ اَلْیَمِینِ (۹۰) فَسَلاٰمٌ لَکَ مِنْ أَصْحٰابِ اَلْیَمِینِ (۹۱) وَ أَمّٰا إِنْ کٰانَ مِنَ اَلْمُکَذِّبِینَ اَلضّٰالِّینَ (۹۲) فَنُزُلٌ مِنْ حَمِیمٍ (۹۳) وَ تَصْلِیَةُ جَحِیمٍ (۹۴) إِنَّ هٰذٰا لَهُوَ حَقُّ اَلْیَقِینِ (۹۵) فَسَبِّحْ بِاسْمِ رَبِّکَ اَلْعَظِیمِ (۹۶)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "پس سوگند یاد می‌کنم بمنازل ستاره‌ها (۷۵) و بدرستی که آن سوگندیست اگر دانید بزرگ (۷۶) بدرستی که آن قرآنیست گرامی (۷۷) در کتابی مسطور (۷۸) مس نمی‌کند آن را مگر پاک‌گردیده‌شدگان (۷۹) فرو فرستادنیست از پروردگار جهانیان (۸۰) آیا پس باین کلام شما مداهنه می‌کنید (۸۱) و می‌گردانید روزی‌تان را بدرستی که شما تکذیب می‌نمائید (۸۲) پس چرا وقتی که می‌رسد بحنجر (۸۳) و شما در آن وقت می‌نگرید (۸۴) و ما نزدیکتریم بسوی او از شما و لکن نمی‌بینید (۸۵) پس چرا اگر هستید غیر غیرداده‌شوندگان (۸۶) برگردانیدش اگر هستید راست‌گویان (۸۷) پس اگر باشد از نزدیک‌شدگان (۸۸) پس راحتی است و روزی و بهشت با نعمت (۸۹) و اما اگر باشد از یاران دست راست (۹۰) پس سلام مر ترا از یاران دست راست (۹۱) و اما اگر باشد از تکذیب‌کنندگان گمراهان (۹۲) بس مایۀ میهمانیست از آب جوشان (۹۳) و در آوردن در دوزخ (۹۴) و بدرستی که آن هر آینه آنست حق یقین (۹۵) پس تسبیح گوی بنام پروردگارت که بزرگ است (۹۶)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "پس خورم سوگند بر وقت نجوم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "یا غروب اختران اندر هجوم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "اتصال نفس احمد(ص) باشد آن",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "خود به روح القدس در حال عیان",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "واندر آن وقت است غیبت از حواس",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "روح گردد فارغ از غوغای ناس",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "گر بدانید این است سوگندی عظیم",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "کآنچه خواند او هست قرآنی کریم",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "ز احمد (ص) اعنی آنچه کردید استماع",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "هست قرآنی کثیر الانتفاع",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "در کتابی وآن بود پوشیده ضبط",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "لوح محفوظ اعنی اندر نظم و ربط",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "مَس ورا نکنند جز پاکیزگان",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "جز ملایک کس نداند یعنی آن",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "یا نگردند آگه از تأویل وی",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "جز خواص و عارفان نیک پی",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "گشته آن نازل ز ربّ العالمین",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "پس تهاون می کنید آیا بر این",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "می بگردانید بهرة خویش از او",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "اینکه تکذیبش کنید از سوء خو",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "پس چرا چون می رسد جان بر گلو",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "وقت مردن بنگرید از پشت و رو",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "همچنان که مردم حیرت زده",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "بر گلو جانشان ز وحشت آمده",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "ما به او باشیم بس نزدیکتر",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "از شما لیکن نبینید از بصر",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "پس نه اید ار جز جزاء داده شده",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "یا که مقهور و ذلیلان آمده",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "باز روح محتضر را بر جسد",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "راست گر گویید گردانید خود",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "محتضر پس باشد اما گر به جا",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "خود ز نزدیکان درگاه خدا",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "یعنی از آن سابقان از سه گروه",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "او ز مردن می نیاید بر ستوه",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "پس مر او را باشد از ریحان و روح",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "راحت و هم رزق خوشبو در فتوح",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "رحمتی کاندوه از او زایل کند",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "دم به دم بر مردنش مایل کند",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "هم دگر باشد مر او را وقت مرگ",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "بوستانی پر نعیم از ساز و برگ",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "باشد اما ور که ز اصحاب یمین",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "سالم است از خوف و مکروه این یقین",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "پس تو را باشد ز اهل دست راست",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "آن سلامی کاهل دست راست، راست",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "بر تو باشد ای محمّد(ص) یا سلام",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "خود ز اصحاب یمین در هر مقام",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "شاد و ایمن باش کایشان سالمند",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "با تنعم در بهشت از مُنعِمند",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "هست حال محتضر یعنی نکو",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "بر تو بس باشد سلام از روح او",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "باشد اما اهل تکذیب ار که او",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "وز گروه گمرهان بی گفتگو",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "پیشکش پس باشد او را از حمیم",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "واندر آوردن در آتش در جحیم",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "آنچه در این سوره شد ذکر این چنین",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "إنَّ هَذَا لَهُوَ حَقُّ الْیَقِین",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "پس نما تسبیح ربّت صبح و شام",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "کوست اعظم در صفات و ذات و نام",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    }
  ]
}
