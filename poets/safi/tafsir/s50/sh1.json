  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "بسم االله الرحمن الرحیم",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "ق وَ اَلْقُرْآنِ اَلْمَجِیدِ (۱) بَلْ عَجِبُوا أَنْ جٰاءَهُمْ مُنْذِرٌ مِنْهُمْ فَقٰالَ اَلْکٰافِرُونَ هٰذٰا شَیْ‌ءٌ عَجِیبٌ (۲) أَ إِذٰا مِتْنٰا وَ کُنّٰا تُرٰاباً ذٰلِکَ رَجْعٌ بَعِیدٌ (۳) قَدْ عَلِمْنٰا مٰا تَنْقُصُ اَلْأَرْضُ مِنْهُمْ وَ عِنْدَنٰا کِتٰابٌ حَفِیظٌ (۴) بَلْ کَذَّبُوا بِالْحَقِّ لَمّٰا جٰاءَهُمْ فَهُمْ فِی أَمْرٍ مَرِیجٍ (۵) أَ فَلَمْ یَنْظُرُوا إِلَی اَلسَّمٰاءِ فَوْقَهُمْ کَیْفَ بَنَیْنٰاهٰا وَ زَیَّنّٰاهٰا وَ مٰا لَهٰا مِنْ فُرُوجٍ (۶) وَ اَلْأَرْضَ مَدَدْنٰاهٰا وَ أَلْقَیْنٰا فِیهٰا رَوٰاسِیَ وَ أَنْبَتْنٰا فِیهٰا مِنْ کُلِّ زَوْجٍ بَهِیجٍ (۷) تَبْصِرَةً وَ ذِکْریٰ لِکُلِّ عَبْدٍ مُنِیبٍ (۸)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "بنام خداوند بخشاینده مهربان",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Paragraph",
      "Text": "بقرآن بزرگوار (۱) بلکه عجب داشتند که آمد ایشان را بیم‌کننده از ایشان پس گفتند کافران که این چیزیست عجیب (۲) آیا چون بمیریم و بشویم خاک آن بازگشتی است دور (۳) بتحقیق دانسته‌ایم آنچه ناقص می‌کند زمین از ایشان و نزد ماست کتابی نگاهدارنده (۴) بلکه تکذیب نمودند حق را چون آمد ایشان را پس ایشانند در امری مضطرب (۵) آیا پس ننگریستند بآسمان بالای ایشان که چگونه بنا کرده‌ایم آن را و آراسته‌ایم آن را و نیست مر آن را هیچ از شکافها (۶) و زمین کشش دادیم آن را و افکندیم در آن کوه‌های استوار و رویانیدیم در آن از هر صنفی خوش آینده (۷) برای بینایی و پند مر هر بنده بازگشت‌کننده (۸)",
      "CoupletIndex": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "قاف قلب خاتم آمد ز انبساط",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "کوست کوه قاف و ارض آن را محاط",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "بر محیط ماسوی یعنی قسم",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "یا قوام امر و جریان قلم",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "یا به قول محکم حکم بلند",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "هم به قرآن مجید ارجمند",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "بل عجب کردند قومی مشتبه",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "کآمد ایشان را از ایشان بیم ده",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "کافران گفتند بس باشد عجیب",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "این بیان یا این رسالت زین حبیب",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "أ اذَا مِتْنَا وَ کُنَّا تُرَاب",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "ذَلِکَ رَجعُ بَعِید اندر ایاب",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "بعد از آن یعنی که خاک اندر شویم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "زنده ما خود نوبت دیگر شویم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "ما بدانیم آنچه گرداند زمین",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "ناقص از ایشان ز لحم و عظم هین",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "نزد ما باشد کتابی کاندر او",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "ثبت باشد حال اشیاء مو به مو",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "بلکه ایشان بر غلط هِشتند سُم",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "کَذَّبُواْ بِالْحَقِّ لَما جَآءَهُم",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "پس بوند این قوم در کاری مرِیج",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "فاسد و شوریده ز آثاری مرِیج",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "ننگرند آیا که بر سوی سماء",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "فوقشان کردیم تا چون ما بناء",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "هم ورا آراستیم از اختران",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "هیچ می نبود شکافی اندر آن",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "هم کشیدیم این زمین را برقرار",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "کوهها در وی فکندیم استوار",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "هم نبات از وی برویاندیم ما",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "از هر آن صنفی چنین بهجت فزا",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "بر نظر کردن ز عبرت زین عجیب",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "تا نماید یاد از او عبد منیب",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    }
  ]
