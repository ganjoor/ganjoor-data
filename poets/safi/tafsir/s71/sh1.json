  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "بسم االله الرحمن الرحیم",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "إِنّٰا أَرْسَلْنٰا نُوحاً إِلیٰ قَوْمِهِ أَنْ أَنْذِرْ قَوْمَکَ مِنْ قَبْلِ أَنْ یَأْتِیَهُمْ عَذٰابٌ أَلِیمٌ (۱) قٰالَ یٰا قَوْمِ إِنِّی لَکُمْ نَذِیرٌ مُبِینٌ (۲) أَنِ اُعْبُدُوا اَللّٰهَ وَ اِتَّقُوهُ وَ أَطِیعُونِ (۳) یَغْفِرْ لَکُمْ مِنْ ذُنُوبِکُمْ وَ یُؤَخِّرْکُمْ إِلیٰ أَجَلٍ مُسَمًّی إِنَّ أَجَلَ اَللّٰهِ إِذٰا جٰاءَ لاٰ یُؤَخَّرُ لَوْ کُنْتُمْ تَعْلَمُونَ (۴) قٰالَ رَبِّ إِنِّی دَعَوْتُ قَوْمِی لَیْلاً وَ نَهٰاراً (۵) فَلَمْ یَزِدْهُمْ دُعٰائِی إِلاّٰ فِرٰاراً (۶) وَ إِنِّی کُلَّمٰا دَعَوْتُهُمْ لِتَغْفِرَ لَهُمْ جَعَلُوا أَصٰابِعَهُمْ فِی آذٰانِهِمْ وَ اِسْتَغْشَوْا ثِیٰابَهُمْ وَ أَصَرُّوا وَ اِسْتَکْبَرُوا اِسْتِکْبٰاراً (۷) ثُمَّ إِنِّی دَعَوْتُهُمْ جِهٰاراً (۸) ثُمَّ إِنِّی أَعْلَنْتُ لَهُمْ وَ أَسْرَرْتُ لَهُمْ إِسْرٰاراً (۹) فَقُلْتُ اِسْتَغْفِرُوا رَبَّکُمْ إِنَّهُ کٰانَ غَفّٰاراً (۱۰) یُرْسِلِ اَلسَّمٰاءَ عَلَیْکُمْ مِدْرٰاراً (۱۱) وَ یُمْدِدْکُمْ بِأَمْوٰالٍ وَ بَنِینَ وَ یَجْعَلْ لَکُمْ جَنّٰاتٍ وَ یَجْعَلْ لَکُمْ أَنْهٰاراً (۱۲)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "بنام خداوند بخشاینده مهربان",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Paragraph",
      "Text": "بدرستی که ما فرستادیم نوح را بسوی گروهش آنکه بترسان گروه خود را پیش از آنکه بیاید ایشان را عذاب دردناک (۱) گفت ای گروه من بدرستی که من مر شما را ترسانده هستم ظاهر (۲) آنکه بندگی کنید خدا را و بپرهیزید از او و اطاعت کنید مرا (۳) بیامرزد مر شما را از گناهان شما و پس اندازد شما را تا مدتی نام برده شده بدرستی که وقتی که مقرر داشت خدا هرگاه آمد پس نمی‌افتند اگر بودید که می‌دانید (۴) گفت پروردگارا بدرستی که خواندم ایشان را شب و روز (۵) پس میفزود ایشان را خواندن من مگر گریختن (۶) و بدرستی که من هرگاه خواندم ایشان را تا آنکه در گذری از ایشان گردانیدند انگشتهاشان را در گوشهای خود و بسر کشیدند جامه‌هاشان را و اصرار کردند و سرکشی کردند سرکشی کردنی (۷) پس بدرستی که خواندم ایشان را بآوازی بلند (۸) پس بدرستی که آشکارا گفتم ایشان را و پنهان گفتم ایشان را پنهان (۹) پس گفتم آمرزش خواهید از پروردگار خود بدرستی که بوده است آمرزنده (۱۰) می‌فرستد آسمان را بر ایشان پی‌بپی باران (۱۱) و مدد می‌کند شما را بمال‌ها و پسران و قرار می‌دهد برای شما بهشتها و می‌گرداند برای شما نهرها (۱۲)",
      "CoupletIndex": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "ما فرستادیم نوح (ع) نیک خو",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "سوی قومش آل قابیل عدو",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "آنکه قوم خویش را می کن تو بیم",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "پیش از آن کآید عذابی بس الیم",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "گفت ای قومم شما را از خدا",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "من نذیری آشکارم بی خطا",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "اینکه بپرستید بر یکتایی اش",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "وَاتَّقُوهُ وَأطِیعُون بندهوش",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "تا بیامرزد شما را از ذنوب",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "غافری آن کوست علام الغیوب",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "باز پس دارد عقوبت هایتان",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "تا به وقتی نام برده گشته آن",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "زآنکه آن مدت که تقدیر است زو",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "چونکه آید پس نیفتد نیم مو",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "گر شما هستید کز فکر و نظر",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "می بدانید ایچ امر از خیر و شرّ",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "سالها با قوم بودش بحث و رد",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "شرح آن را پیش گفتیم از سند",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "گفت ای پروردگارم با نسق",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "روز و شب این قوم را خواندم به حق",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "پس نیفزود ایچ ایشان را به کار",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "از دعاء و خواندن من جز فرار",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "هر زمان خواندم به توحید این رمه",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "تا تو ایشان را بیامرزی همه",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "اندر آوردند انگشتان به گوش",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "جامه ها بر سر کشیدند این وحوش",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "هم شدند ایشان به فکر خود مُصر",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "سرکشی کردند اندر جهر و سرّ",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "پس نمودم دعوت ایشان را بلند",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "آشکارا چند دادم وعظ و پند",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "هم بخواندم من به پنهانی و راز",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "تا مگر آرند ایمان خفیه باز",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "گفتم آمرزش پس از پروردگار",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "می بخواهید اوست چون آمرزگار",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "تا که باران او فرستد بر شما",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "پی به پی باران ریزان از سما",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "هم کند امداد بر مال و بنین",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "بر شما از فضل خود جان آفرین",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "هم دهد جنّات پر دخل و ثمر",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "جویهای جاری از هر رهگذر",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "این صفی از خود نگوید گفته اند",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "شد ز استغفار رفع هر گزند",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "هر غمی کآید به پیشت ای فقیر",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "دامن حق رو به استغفار گیر",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "شد در ایّام عُمَر قحطی شدید",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "او به استسقاء برون شد با امید",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "بر دعائی هیچ او نگشود لب",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "غیر استغفار بر درگاه رب",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "پس بگفتندش که ای میر عطاء",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "چون در استسقاء نکردی تو دعاء",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "گفت خواندم آنچه باران را بناست",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "خواند پس این آیه که اصل مدعاست",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    }
  ]
}
