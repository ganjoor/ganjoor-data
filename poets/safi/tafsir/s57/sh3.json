      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "روزی که بینی مردمان باایمان و زنان باایمان که می‌شتابند نورشان میانه دستهاشان و بجانب راستشان بشارت شما امروز بهشتهاییست که می‌رود از زیر آنها نهرها جاودانیان در آنها این است کامیابی بزرگ (۱۲) روزی که گویند مردان با نفاق و زنان با نفاق مر آنان را که ایمان آوردند نظر کنید بما تا اقتباس نمائیم از نور شما گفته شد که برگردید بقفاتان پس بجویند نوری پس کشیده شد میانشان دیواری که مر او راست دری که باطنش در آنست رحمت و ظاهرش از پیش آنست عذاب (۱۳) ندا کنند ایشان را که آیا نبودیم با شما گویند آری و لیکن شما فریفتید شما خودهاتان را و انتظار بردید و شک آوردید و فریب داد شما را فریب دهنده آرزوها تا آمد امر خدا و فریب داد شما را بخدا فریب دهنده (۱۴) پس آن روز گرفته نشود از شما فدایی و نه از آنان که کافر شدند جایگاه شماست آتش آن اولاست بشما و بد است آن بازگشت (۱۵) آیا نرسید وقت مر آنان را که ایمان آوردند که مایل است دلهاشان برای ذکر خدا و آنچه نازل شد از حق و نباشد چون کسانی که داده شدند کتاب را از پیش پس دراز شد بر ایشان زمان پس سخت دلهاشان و بسیاری از ایشان فاسقانند (۱۶)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "اندر آن روزی که بینی بر صراط",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "مؤمنات و مؤمنین را ز انبساط",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "نور ایشان پیش روی و دست راست",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "میرودشان با شتاب از هر کجاست",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "گوید ایشان را فرشته از خدا",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "مژده امروز است جنّت بر شما",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "که رود مر جوی ها از زیر آن",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "وین بود فوزی بزرگ و جاودان",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "وآن منافق پیشگان از مرد و زن",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "مؤمنان را می بگویند آن زمن",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "انظُرُونَا نَقتَبِس مِن نُّورِکُم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "زآنکه ما بر تیرگی هِشتیم سُم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "گفته ایشان را شود گردید باز",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "در جهان، وز روشنی گیرید ساز",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "پس جداری بینشان گردد زده",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "در بطون او را دری بر فایده",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "واندر او رحمت ز بهر مؤمنان",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "کاندر آیند اوست در جنب جنان",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "وز برونِ آن دورویان بی حساب",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "جنب دوزخ هم ز نزد آن عذاب",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "مؤمنان را می بخوانند از وجع",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "با شما آیا نه ما بودیم مع",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "مؤمنان گویند آری آن زمن",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "لیک افکندید خود را در فتن",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "نفس های خویشتن را از نفاق",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "اندر افکندید در رنج و شقاق",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "می کشیدید انتظار از هر زمان",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "بر مصائب بر رسول و مؤمنان",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "در نبوّت شک نمودید از رسول",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "آرزوتان کرد مغرور از فضول",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "تا که آمد امر حق بر قبض روح",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "یا که بر تعذیبتان با این شروح",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "دادتان دیو فریبنده فریب",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "بر خدا کو بخشد از رحمت نصیب",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "پس گرفته فدیه امروز از شما",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "می نگردد هم ز کفار دغا",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "جای ایشان و شما در آتش است",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "وین شما را بس سزاوار و خوش است",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "درخور آمد بر شما بِئْسَ الْمَصِیر",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "بد بود در باز گشت بُد اسیر",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "نامد آیا وقت آنکه مؤمنان",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "قلبشان خاشع شود بر ذکر هان",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "نرم گردد ترسد از ذکر خدا",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "قلبهای رفته از غفلت ز جا",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "کرده نازل آنچه را از قول حق",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "یعنی این قرآن با نظم و نسق",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "لَا یَکُونُواْ کَالَّذِینَ أوتُواْ الْکِتَاب",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "پیش از این یعنی یهود پر عتاب",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "پس بر ایشان چون زمان آمد دراز",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "سخت شد دلهای ایشان در مجاز",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "اکثری گشتند ز ایشان فاسقون",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "ز امر حق رفتند از غفلت برون",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    }
  ]
}
