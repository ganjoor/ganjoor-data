      "VOrder": 7,
      "Position": "Left",
      "Text": "قول معروف است نیک اندر مقال",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "نیک با ایشان کنید اعنی کلام",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "تا از آن خوشدل شوند و شادکام",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "هست عام این حکم در هر موردی",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "بین قرائن را اگر خود بخردی",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Right",
      "Text": "نسبتش گر شد به مجنون و یتیم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Left",
      "Text": "بر ولیّ باشد خطاب مستقیم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "همچنین در هر مقام و هر محل",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "از قرینه فهم کن حکم اجل",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "مر یتیمان را نمایید امتحان",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "بر بلوغ اندر نکاحی بالعیان",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "رشدی ار یابید ز ایشان در فروغ",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "یعنی اندر عقل ز آثار بلوغ",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "پس کنید اموالشان را واگذار",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "بی ز اسراف و خیانت و اعتذار",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "هم نگیرید اندر آن پیشی یکی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "پیشتر از رشد یعنی اندکی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "کاندر این شوب طمع یا حیله ای است",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "ور نه پیش از رشد دادن، قصد چیست",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "تا ز بی عقلی کند مالش تلف",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "گرچه باشد آن صبی، خوب و خلف",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "آن ولی باشد ز مال ار بی نیاز",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "نیست بر مال یتیمش دیده باز",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "باید آن را واگذارد بالتمام",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "پیشه سازد عفت اندر این مقام",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "آن ولی ور هست محتاج و فقیر",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "قدر حاجت باشد از وی ناگزیر",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "گر خورد چیزی بر او نبود حرج",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "فرض گیرد تا رسد بر وی فرج",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "دارد این آیت دلالت که ولی",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "نیست بیحق، نی که گردد ممتلی",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "حقّ او باشد به اندازة کفاف",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "نی فزونتر کآن بود دور از عفاف",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "خرجش افزون باشد از مالی که هست",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "زآن یتیم بی پدر او را به دست",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "گوید از مال تو دیگر هیچ نیست",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "مال تو صد بود و خرج من دویست",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "گشته آن در فقه تعیین با سند",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "رو بپرس ار خواهی آن را حد و سد",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "مالشان را ور که می سازید رد",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "شاهدان گیرید تا باشد سند",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "تا که نکشد بر نزاع و قال و قیل",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "هم نگردد بر مهماتش کفیل",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "ور به ناچاری شود گیرد گواه",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "زآنکه واقع گردد اینجا اشتباه",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "میتوان گفتن که آن مال و منال",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "جمله را خرج تو کردم چند سال",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "پس گواهی گیرد از جمعی قریب",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "حق تعالی هم گواه است و حسیب",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    }
  ]
}
