  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "یَسْتَفْتُونَکَ قُلِ اَللّٰهُ یُفْتِیکُمْ فِی اَلْکَلاٰلَةِ إِنِ اِمْرُؤٌ هَلَکَ لَیْسَ لَهُ وَلَدٌ وَ لَهُ أُخْتٌ فَلَهٰا نِصْفُ مٰا تَرَکَ وَ هُوَ یَرِثُهٰا إِنْ لَمْ یَکُنْ لَهٰا وَلَدٌ فَإِنْ کٰانَتَا اِثْنَتَیْنِ فَلَهُمَا اَلثُّلُثٰانِ مِمّٰا تَرَکَ وَ إِنْ کٰانُوا إِخْوَةً رِجٰالاً وَ نِسٰاءً فَلِلذَّکَرِ مِثْلُ حَظِّ اَلْأُنْثَیَیْنِ یُبَیِّنُ اَللّٰهُ لَکُمْ أَنْ تَضِلُّوا وَ اَللّٰهُ بِکُلِّ شَیْ‌ءٍ عَلِیمٌ (۱۷۶)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "فتوی می‌پرستند از تو بگو خدا فتوی می‌دهد شما را در کلاله اگر مردی بمیرد که نباشد مر او را فرزندی و مر او را خواهری باشد پس مر او راست نیمه آنچه گذاشته و او میراث می‌برد از او اگر نباشد مر او را فرزندی پس اگر باشند دو تا پس مر آنها راست دو ثلث از آنچه گذاشته و اگر باشند برادران مردان و زنان پس مر مرد راست مانند بهره دو زن بیان می‌کند خدا از برای شما مبادا که گمراه شوید و خدا بهمه چیزی دانا (۱۷۶)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "« در بیان میراث کُلاله »",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Right",
      "Text": "جابر انصار شد بیمار او",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Left",
      "Text": "بر عیادت شد رسول نیک خو",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "گفت جابر، مال دارم من به عین",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "نه ولد باشد مرا نه والدین",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "لیک دارم هفت خواهر یا که بیش",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "چون کنم قسمت بر ایشان مال خویش",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "این چنین کس را کُلاله خوانده اند",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "وز پی وجهش سخنها رانده اند",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Right",
      "Text": "از تو پرسم خواهم ار نصفت کنم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Left",
      "Text": "چون بر ایشان مال خود قسمت کنم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "آمد آیت کز تو استفتاء کنند",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "از کُلاله تا که آن اجرا کنند",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "گو به ایشان می دهد فتوی خدا",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "قسمت میراث را بر مدعا",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "گر یکی مردی بمیرد بیولد",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "خواهری وز والدین او را بود",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "یا که تنها با شد آن اُخت از پدر",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "پس ز نصف مال باشد بهره ور",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "همچنین بر عکس گر نبود ولد",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "مال خواهر بر برادر میرسد",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "خواهرانش ور دو میباشند مرد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "پس دو ثلث از بهر ایشان فرض کرد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "ور کُلالاتند افزونتر به عین",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "هم رجال و هم نساء از والدین",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "یا که تنها از پدر نزد فطن",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "بهره مرد است مانند دو زن",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "مرد را قسمت دو شد زن را یکی",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "این یقین است ار نباشی در شکی",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "مینماید حق بیان اندر کتاب",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "بر شما حکم مواریث از صواب",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "گم نگردد تا ره این روشن ره است",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "بر شما هم حق ز هر چیز آگه است",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "اول این سوره گفت او بهر حد",
