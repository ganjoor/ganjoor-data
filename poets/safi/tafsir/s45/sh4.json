      "HtmlText": "\u003Cdiv class=\u0022b\u0022 id=\u0022bn1\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eهیچ نبود شک و ریبی در آن\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eلیک نادانند اکثر مردمان\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E",
      "CoupletsCount": 1
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "وَ خَلَقَ اَللّٰهُ اَلسَّمٰاوٰاتِ وَ اَلْأَرْضَ بِالْحَقِّ وَ لِتُجْزیٰ کُلُّ نَفْسٍ بِمٰا کَسَبَتْ وَ هُمْ لاٰ یُظْلَمُونَ (۲۲) أَ فَرَأَیْتَ مَنِ اِتَّخَذَ إِلٰهَهُ هَوٰاهُ وَ أَضَلَّهُ اَللّٰهُ عَلیٰ عِلْمٍ وَ خَتَمَ عَلیٰ سَمْعِهِ وَ قَلْبِهِ وَ جَعَلَ عَلیٰ بَصَرِهِ غِشٰاوَةً فَمَنْ یَهْدِیهِ مِنْ بَعْدِ اَللّٰهِ أَ فَلاٰ تَذَکَّرُونَ (۲۳) وَ قٰالُوا مٰا هِیَ إِلاّٰ حَیٰاتُنَا اَلدُّنْیٰا نَمُوتُ وَ نَحْیٰا وَ مٰا یُهْلِکُنٰا إِلاَّ اَلدَّهْرُ وَ مٰا لَهُمْ بِذٰلِکَ مِنْ عِلْمٍ إِنْ هُمْ إِلاّٰ یَظُنُّونَ (۲۴) وَ إِذٰا تُتْلیٰ عَلَیْهِمْ آیٰاتُنٰا بَیِّنٰاتٍ مٰا کٰانَ حُجَّتَهُمْ إِلاّٰ أَنْ قٰالُوا اِئْتُوا بِآبٰائِنٰا إِنْ کُنْتُمْ صٰادِقِینَ (۲۵) قُلِ اَللّٰهُ یُحْیِیکُمْ ثُمَّ یُمِیتُکُمْ ثُمَّ یَجْمَعُکُمْ إِلیٰ یَوْمِ اَلْقِیٰامَةِ لاٰ رَیْبَ فِیهِ وَ لٰکِنَّ أَکْثَرَ اَلنّٰاسِ لاٰ یَعْلَمُونَ (۲۶)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "و آفرید خدا آسمانها و زمین را براستی و تا جزا داده شود هر نفسی بآنچه کسب کرد و ایشان ستم کرده نشوند (۲۲) آیا پس دیدی آن را که گرفت الهش را خواهشش و اضلال کرد خدا بر علمی و مهر نهاد بر گوشش و دلش و گردانید بر چشمش پرده پس که هدایت می‌کند او را از بعد خدا آیا پس پند نمی‌گیرید (۲۳) و گفتند نیست آن جز زندگانی در دنیا که می‌میریم و زنده می‌شویم و هلاک نمی‌کند ما را مگر دهر و نیست مر ایشان را بآن هیچ دانشی نیستند ایشان مگر که گمان می‌کنند (۲۴) و چون خوانده شود بر ایشان آیتهای ما که روشن است باشد دلیل ایشان جز آنکه گویند بیاورید پدران ما را اگر هستید راستگویان (۲۵) بگو خدا زنده کند شما را پس بمیراند شما را پس جمع می‌کند شما را تا روز قیامت نیست شکی در آن و لیکن بیشترین مردمان نمی‌دانند (۲۶)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "حق تعالی این سماوات و زمین",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "کرده خلق از راستی وز عدل هین",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "مقتضای عدل آن باشد که فرق",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "بنهد او مابین مخلص و اهل زرق",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "تا که هر نفسی از او یابد جزا",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "بر هر آنچه کرده کسب از فعلها",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "نی ستم دیده شوند اندر حساب",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "مردمان اندر ثواب و در عِقاب",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "هست مروی از سعید بن جبیر",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "بود عزّی سنگ اسپیدی به سیر",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "می پرستیدند آن را مشرکان",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "بهتر از آن چیزی ار گشتی عیان",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "ترک عزّی می نمودند آن حشر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "می پرستیدند آن شیئی دگر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "حق به پیغمبر چنین گفت از شگفت",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "می نبینی آن کس آیا که گرفت",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "از هوای نفس خود معبود را",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "هیچ نشناسد زیان و سود را",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "در ضلالت وانهاد آن را خدا",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "بر چنان دانش که بودش ز ابتدا",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "مُهر بنهادش به گوش و دل ز خشم",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "پوششی گرداند هم او را به چشم",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "معنی مُهری که حق بر دل نهاد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "پیش از این گفتیم گر داری به یاد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "کیست پس آنکه نماید ره بر او",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "بعد از آنکه حق نماید ره نکو",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "پند نپذیرید آیا پس شما",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "پند چبود، دوری از نفس و هوی",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "نیست گفتند آن خسیسان غوی",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "زندگانی جز حیات دنیوی",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "می بمیریم و دگر زنده شویم",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "یعنی از اُم باز زاینده شویم",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "چون نماید شخصی از دنیا گذر",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "زاده گردد دیگری با زیب و فر",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "حاصل آنکه نیست بعد از موت تن",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "زندگانیِ دگرمان بی سخن",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "هم فنا ما را نسازد غیر دهر",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "بر مرور از جام او نوشیم زهر",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "دور گیتی قابض ارواح ماست",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "نی ملک قابض نه امری از خداست",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "نیست اینها در هلاک ما دلیل",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "بلکه دهر است و طبیعت خود اصیل",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "زین طبیعت مذهبان در عصر ما",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "همچنین هستند بیش از حصر ما",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "نیست ایشان را بر این گفتارها",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "دانشی الاّ که از پندارها",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "بر گمان خویش گویند این مقال",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "نی که از برهان و علمی و انتقال",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "خوانده گردد چونکه آیت های ما",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "ظاهر ایشان را ز حجت های ما",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "در مقابل نیست ایشان را دلیل",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "جز که گویند از طریق قال و قیل",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "آورید آباء ما را رو به رو",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "هیچ اگر باشید حق و راستگو",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "گو شما را در بطون اُمهات",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "زنده سازد خالق کامل صفات",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "پس بمیراند شما را لاکلام",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "ثُم یَجمَعُکُم إلَی یَومِ الْقِیَام",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "هیچ نبود شک و ریبی در آن",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "لیک نادانند اکثر مردمان",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    }
  ]
}
