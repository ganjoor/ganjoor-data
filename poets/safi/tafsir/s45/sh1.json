  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "بسم االله الرحمن الرحیم",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "حم (۱) تَنْزِیلُ اَلْکِتٰابِ مِنَ اَللّٰهِ اَلْعَزِیزِ اَلْحَکِیمِ (۲) إِنَّ فِی اَلسَّمٰاوٰاتِ وَ اَلْأَرْضِ لَآیٰاتٍ لِلْمُؤْمِنِینَ (۳) وَ فِی خَلْقِکُمْ وَ مٰا یَبُثُّ مِنْ دٰابَّةٍ آیٰاتٌ لِقَوْمٍ یُوقِنُونَ (۴) وَ اِخْتِلاٰفِ اَللَّیْلِ وَ اَلنَّهٰارِ وَ مٰا أَنْزَلَ اَللّٰهُ مِنَ اَلسَّمٰاءِ مِنْ رِزْقٍ فَأَحْیٰا بِهِ اَلْأَرْضَ بَعْدَ مَوْتِهٰا وَ تَصْرِیفِ اَلرِّیٰاحِ آیٰاتٌ لِقَوْمٍ یَعْقِلُونَ (۵) تِلْکَ آیٰاتُ اَللّٰهِ نَتْلُوهٰا عَلَیْکَ بِالْحَقِّ فَبِأَیِّ حَدِیثٍ بَعْدَ اَللّٰهِ وَ آیٰاتِهِ یُؤْمِنُونَ (۶) وَیْلٌ لِکُلِّ أَفّٰاکٍ أَثِیمٍ (۷) یَسْمَعُ آیٰاتِ اَللّٰهِ تُتْلیٰ عَلَیْهِ ثُمَّ یُصِرُّ مُسْتَکْبِراً کَأَنْ لَمْ یَسْمَعْهٰا فَبَشِّرْهُ بِعَذٰابٍ أَلِیمٍ (۸) وَ إِذٰا عَلِمَ مِنْ آیٰاتِنٰا شَیْئاً اِتَّخَذَهٰا هُزُواً أُولٰئِکَ لَهُمْ عَذٰابٌ مُهِینٌ (۹) مِنْ وَرٰائِهِمْ جَهَنَّمُ وَ لاٰ یُغْنِی عَنْهُمْ مٰا کَسَبُوا شَیْئاً وَ لاٰ مَا اِتَّخَذُوا مِنْ دُونِ اَللّٰهِ أَوْلِیٰاءَ وَ لَهُمْ عَذٰابٌ عَظِیمٌ (۱۰)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "بنام خداوند بخشاینده مهربان",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Paragraph",
      "Text": "حم (۱) فرو فرستادن کتاب است از خدای غالب درست کردار (۲) بدرستی که در آسمانها و زمین هر آینه آیتهاست مر گروندگان را (۳) و در آفرینش شما و در آنچه می‌پراکند از جنبنده آیتهاست برای گروهی که یقین می‌کنند (۴) و اختلاف شب و روز و آنچه فرو فرستاد خدا از آسمان از روزی پس زنده گردانید بآن زمین را بعد از مردنش و گردانیدن بادها آیتهاست برای گروهی که می‌یابند بعقل (۵) این آیتهای خداست که می‌خوانیم آن را بر تو براستی پس بکدام سخن بعد از خدا و آیتهایش می‌گروند (۶) وای بر هر دروغگوی گنهکاری (۷) می‌شنود آیتهای خدا را که خوانده می‌شود بر او پس اصرار می‌ورزد سرکشی‌کنان که گویا نشنیده آن را پس مژده ده او را بعذابی دردناک (۸) و چون بداند از آیتهای ما چیزی را می‌گیرد آن را باستهزا آن گروه مر ایشان‌راست عذابی خوارکننده (۹) از پیش رویشان دوزخست و کفایت نمی‌کند از ایشان آنچه کسب کردند چیزی را و نه آنچه گرفتند از غیر خدا دوستان و مر ایشان‌راست عذابی بزرگ (۱۰)",
      "CoupletIndex": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "حق به مرآت محمّد (ص) در خطاب",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "جلوه گر شد کرد تنزیل کتاب",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "باشد این تنزیلِ صدقِ استوار",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "از خدای غالب استوده کار",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "در سماوات از نجوم پر شکوه",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "در زمین ز اشجار و حیوان، بحر و کوه",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "از جماد و زنده، بار و رستنی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "مؤمنان را شد نشانها ز ایمنی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "واندر ایجاد شما از ابتداء",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "در شئون مختلف تا انتهاء",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "از تغیّر وز تجدد هر زمان",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "وآنچه پَرکَنده است از جنبندگان",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "ز اختلاف جنس و شکل و نفع و نام",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "هست آیات اهل ایقان را تمام",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "و اختلافاتی که هست از روز و شب",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "هر یک آید یکدگر را در عقب",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "وآنچه نازل ز آسمان کرد از اثر",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "یا ز ابر از رزقها یعنی مطر",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "مر زمین را زنده بعد از مردگی",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "کرد و بعد از خشکی و افسردگی",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "بادها را می بگردانید هم",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "مختلف از بهر نعمت یا نقم",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "نوبت رحمت شمال است و صباء",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "وقت نقمت ها دَبور است و وباء",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "هر یک آیت بر کمال قدرت است",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "نزد آنان کز خردشان قسمت است",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "این نشانیهای قدرت از خداست",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "بر تو خوانیم آن به حق یعنی به راست",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "یا که آیت های قرآن است این",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "پس به وی گر نگروند این مشرکین",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "بر چه قولی بعد آیات خدا",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "آورند ایمان نمایند اقتدا",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "ویل یعنی جای پر از خون و ریم",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "هست مانا بهر أفَّاکٍ أثِیم",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "کاشنود آیات حق را چون بر او",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "خوانده گردد زآن بگردانید رو",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "پس کند اصرار بر کفر و عناد",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "هست گردنکش ز خلاّق العباد",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "هرگز آن را گوییا نشنیده وی",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "ده بشارت بر عذابش پی به پی",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "چون بداند چیزی از آیات ما",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "گیرد آن را ریشخند اندر ملا",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "هست بهر فرقۀ مستهزئین",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "خوار سازندة عذابی یوم دین",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "دوزخ است از پیش رو وز پشتشان",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "یعنی اندر این جهان و آن جهان",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "می ندارد باز چیزی از عذاب",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "زآن کسان مالی که کردند اکتساب",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "هم نه آنچه که فرا بگرفته اند",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "دوستان از غیر حق اندر پسند",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "هستشان از حق عذابی بس عظیم",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "حاصل از کونینشان باشد جحیم",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    }
  ]
}
