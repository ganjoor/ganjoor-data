      "Text": "وَ لَقَدْ أَرْسَلْنٰا مُوسیٰ بِآیٰاتِنٰا وَ سُلْطٰانٍ مُبِینٍ (۲۳) إِلیٰ فِرْعَوْنَ وَ هٰامٰانَ وَ قٰارُونَ فَقٰالُوا سٰاحِرٌ کَذّٰابٌ (۲۴) فَلَمّٰا جٰاءَهُمْ بِالْحَقِّ مِنْ عِنْدِنٰا قٰالُوا اُقْتُلُوا أَبْنٰاءَ اَلَّذِینَ آمَنُوا مَعَهُ وَ اِسْتَحْیُوا نِسٰاءَهُمْ وَ مٰا کَیْدُ اَلْکٰافِرِینَ إِلاّٰ فِی ضَلاٰلٍ (۲۵) وَ قٰالَ فِرْعَوْنُ ذَرُونِی أَقْتُلْ مُوسیٰ وَ لْیَدْعُ رَبَّهُ إِنِّی أَخٰافُ أَنْ یُبَدِّلَ‌ دِینَکُمْ أَوْ أَنْ یُظْهِرَ فِی اَلْأَرْضِ اَلْفَسٰادَ (۲۶) وَ قٰالَ مُوسیٰ إِنِّی عُذْتُ بِرَبِّی وَ رَبِّکُمْ مِنْ کُلِّ مُتَکَبِّرٍ لاٰ یُؤْمِنُ بِیَوْمِ اَلْحِسٰابِ (۲۷) وَ قٰالَ رَجُلٌ مُؤْمِنٌ مِنْ آلِ فِرْعَوْنَ یَکْتُمُ إِیمٰانَهُ أَ تَقْتُلُونَ رَجُلاً أَنْ یَقُولَ رَبِّیَ اَللّٰهُ وَ قَدْ جٰاءَکُمْ بِالْبَیِّنٰاتِ مِنْ رَبِّکُمْ وَ إِنْ یَکُ کٰاذِباً فَعَلَیْهِ کَذِبُهُ وَ إِنْ یَکُ صٰادِقاً یُصِبْکُمْ بَعْضُ اَلَّذِی یَعِدُکُمْ إِنَّ اَللّٰهَ لاٰ یَهْدِی مَنْ هُوَ مُسْرِفٌ کَذّٰابٌ (۲۸) یٰا قَوْمِ لَکُمُ اَلْمُلْکُ اَلْیَوْمَ ظٰاهِرِینَ فِی اَلْأَرْضِ فَمَنْ یَنْصُرُنٰا مِنْ بَأْسِ اَللّٰهِ إِنْ جٰاءَنٰا قٰالَ فِرْعَوْنُ مٰا أُرِیکُمْ إِلاّٰ مٰا أَریٰ وَ مٰا أَهْدِیکُمْ إِلاّٰ سَبِیلَ اَلرَّشٰادِ (۲۹)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "و بتحقیق فرستادیم موسی را با آیتهای ما و حجتی روشن (۲۳) بسوی فرعون و هامان و قارون پس گفتند ساحری است بسیار دروغگو (۲۴) پس چون آورد ایشان را حق از نزد ما گفتند بکشید پسران آنان که گرویدند باو و زنده گذارید زنان ایشان را و نیست حیله کافران مگر در گمراهی (۲۵) و گفت فرعون بگذارید مرا که بکشم موسی را و باید که بخواند پروردگارش را بدرستی که من می‌ترسم که بدل کند دین شما را یا آنکه بظهور آورد در زمین تباهی را (۲۶) و گفت موسی بدرستی که من پناه می‌برم بپروردگارم و پروردگار شما از هر تکبرکننده که نمی‌گرود بروز شمار (۲۷) و گفت مردی گرونده از کسان فرعون که پنهان می‌داشت ایمان خود را آیا می‌کشید مردی را که می‌گوید پروردگار من خداست و بتحقیق آورده است شما را بینتها از پروردگارتان و اگر باشد دروغگوی پس بر اوست دروغش و اگر باشد راستگوی برسد شما را برخی از آنچه وعده می‌دهید شما را بدرستی که خدا هدایت نمی‌کند کسی را که اوست اسراف‌کننده دروغگو (۲۸) ای جماعت مر شما راست پادشاهی امروز غالبان در زمین پس کیست که یاری کند ما را از عذاب خدا اگر آید ما را گفت فرعون که نمی‌نمایم شما را جز آنچه می‌بینم و هدایت نمی‌کنم شما را مگر راه راستی (۲۹)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ما فرستادیم موسی را یقین",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "با نشانی ها و سلطان مبین",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "جانب فرعون مردود شریر",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "هم دگر قارون و هامان وزیر",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "اختصاص این سه تن اندر بیان",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "هست ز افزونی کفر از دیگران",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "پس بگفتند او بود در ادعا",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "ساحری کذّاب نه از راه خدا",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "پس چو آورد آن گُره را دین راست",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "او ز نزد ما که از ما بر سزاست",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "می بگفتند آن جماعت اُقتُلُواْ",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "جمله أبنَا الَّذِینَ آمَنُواْ",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "زنده بگذارید زن هاشان به حال",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "نیست کید کافران جز در ضلال",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "گفت مر فرعون سرکش با حشم",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "واگذاریدم که موسی را کُشم",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "گو بخواند رب خود را از فنش",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "تا مرا مانع شود از کشتنش",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "من بترسم کو ره دیگر زند",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "دین و آئین شما مبدل کند",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "یا شود در ارض ما ظاهر فساد",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "چونکه گردد تابعان او زیاد",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "گفت موسی من به رب خود پناه",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "از هر آن گردنکشی گیرم به گاه",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "آنکه بر یوم حساب او نگرود",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "تا که دفع شرّ او از من شود",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "زین مباشید ای گروه من ملول",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "نیست او قادر به قتلم در قبول",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "بر خدای خویش و بر رب شما",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "من پناه آورده ام زین ماجرا",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "گفت مردی ز آل فرعون عنود",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "که نهان ایمان او از قوم بود",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "قصد قتل مردی آیا می کنید",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "زآنکه گوید رَبِّیَ االلهُ یا عبید",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "یعنی ای مردم خدای ما یکی است",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "کی کند شک گر کسی را مُدرکی است",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "وآنگهی کآورده است او بیّنات",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "از خدای خود شما ر ا از جهات",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "پس اگر گوید دروغ از بهر اوست",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "مر وبال کذبش این بی گفتگوست",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "ور که باشد راستگو بعضی رسد",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "بر شما پس زآنچه وعده می دهد",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "راه ننماید حق از حد گشته را",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "کاذبِ از راهِ دین بگذشته را",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "ای گروه مَنْ لَکُمُ الْمُلْکُ یَوم",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "غالب اندر مصر بر موسی و قوم",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "کیست پس آن کو دهد یاری به ما",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "از عذاب و بأس حق إن جاءنا",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "گِرد امری پس نگردید از گمان",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "که زوال ملکتان باشد در آن",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "گفت پس فرعون مر حزبیل را",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "مَآ أرِیکُم قَومِی إلَّا مَآ أرَی",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "بر شما نبوم به راهی من دلیل",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "جز که بینم اندر آن خیری جمیل",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "بر شما ننمایم الاّ راه راست",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "وآن هلاک موسی صاحب عصاست",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "گر نگردد کُشته او در رهگذر",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "این زمین اندر فساد است و خطر",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    }
  ]
}
