      "Text": "اَللّٰهُ اَلَّذِی جَعَلَ لَکُمُ اَلْأَنْعٰامَ لِتَرْکَبُوا مِنْهٰا وَ مِنْهٰا تَأْکُلُونَ (۷۹) وَ لَکُمْ فِیهٰا مَنٰافِعُ وَ لِتَبْلُغُوا عَلَیْهٰا حٰاجَةً فِی صُدُورِکُمْ وَ عَلَیْهٰا وَ عَلَی اَلْفُلْکِ تُحْمَلُونَ (۸۰) وَ یُرِیکُمْ آیٰاتِهِ فَأَیَّ آیٰاتِ اَللّٰهِ تُنْکِرُونَ (۸۱) أَ فَلَمْ یَسِیرُوا فِی اَلْأَرْضِ فَیَنْظُرُوا کَیْفَ کٰانَ عٰاقِبَةُ اَلَّذِینَ مِنْ قَبْلِهِمْ کٰانُوا أَکْثَرَ مِنْهُمْ وَ أَشَدَّ قُوَّةً وَ آثٰاراً فِی اَلْأَرْضِ فَمٰا أَغْنیٰ عَنْهُمْ مٰا کٰانُوا یَکْسِبُونَ (۸۲) فَلَمّٰا جٰاءَتْهُمْ رُسُلُهُمْ‌ بِالْبَیِّنٰاتِ فَرِحُوا بِمٰا عِنْدَهُمْ مِنَ اَلْعِلْمِ وَ حٰاقَ بِهِمْ مٰا کٰانُوا بِهِ یَسْتَهْزِؤُنَ (۸۳) فَلَمّٰا رَأَوْا بَأْسَنٰا قٰالُوا آمَنّٰا بِاللّٰهِ وَحْدَهُ وَ کَفَرْنٰا بِمٰا کُنّٰا بِهِ مُشْرِکِینَ (۸۴) فَلَمْ یَکُ یَنْفَعُهُمْ إِیمٰانُهُمْ لَمّٰا رَأَوْا بَأْسَنٰا سُنَّتَ اَللّٰهِ اَلَّتِی قَدْ خَلَتْ فِی عِبٰادِهِ وَ خَسِرَ هُنٰالِکَ اَلْکٰافِرُونَ (۸۵)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "خداست آنکه گردانید برای شما چهارپایان را تا سوار شوید برخی از آنها را و برخی از آنها را بخورید (۷۹) و مر شما راست در آنها منفعتها و تا برسید بر سواری آنها بحاجتی که باشد در سینه‌هاتان و بر آنها و بر کشتی بار کرده می‌شوید (۸۰) و می‌نماید شما را آیتهایش پس بکدام آیات خدا انکار می‌کنید (۸۱) آیا پس نرفتند در زمین پس بنگرند چگونه بود انجام آنان که بودند از پیش ایشان بودند بیشتر از ایشان و سخت‌تر از راه توانایی و اثرها در زمین پس کفایت نکرد از ایشان آنچه بودند کسب می‌کردند (۸۲) پس چون آمد ایشان را رسولانشان با حجتها شاد شدند بآنچه بودند نزد ایشان از دانش و احاطه کرد بایشان آنچه بودند بآن استهزا می‌کردند (۸۳) پس چون دیدند عذاب ما را گفتند گرویدیم بخدا تنها و کافر شدیم بآنچه بودیم بآن مشرکان (۸۴) پس نباشد که سود دهد ایشان را ایمانشان چون دیدند عذاب ما را دستور خدا که بحقیقت گذشت در بندگانش و زیان کردند آنجا کافران (۸۵)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "حق کسی باشد که اَنعام آفرید",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "بر شما تا نفعها زآنها برید",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "تَرْکَبُواْ مِنْهَا وَمّنْهَا تَأکُلُون",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "سودها باشد شما را زآن فزون",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "تا رسید اندر سفرها کوست دور",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "سوی حاجت ها که هست اندر صدور",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "هم بر آنها هم به کشتی ها سوار",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "سوی بحر و برّ شوید اندر گذار",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "بر شما آیات خود سازد پدید",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "بر کدام از آیت االله منکرید",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "بر تجارت در یمن یا ارض شام",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "منکران آیا نرفتند از مقام",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "تا چگونه بوده بینند از سفر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "آخر آنان که بوده پیشتر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "اکثر از ایشان بُدند اندر عدد",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "هم ز روی قوّت و آثار اشد",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "دفع پس ز ایشان نکرد ایچ آن عذاب",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "آنچه کردند از تمکن اکتساب",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "پس به هنگامی که آمدشان رسل",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "با نشان معجزات از جزء و کل",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "شاد گشتندی به آنچه نزدشان",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "بُد ز دانش هم ز گفتار و بیان",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "پس گرفتید آن رسولان را حقیر",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "هم به دانش هم به آیات کثیر",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "فلسفه بوده است یا طب آن علوم",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "هندسه هم یا طبایع یا نجوم",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "ز اهل یونان گر حکیمی می شنید",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "نام وحی، او روی در هم می کشید",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "همچنین از ذکر آیات و رسل",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "لنگ می شد پایشان نزدیک پل",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "زین سخنها زیر هِشتندی دو گوش",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "یعنی این باور ندارد مرد هوش",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "کارشان بر انبیا تحقیر بود",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "سنگ را افسردگی ز اکسیر بود",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "هم در این ایّام گیرد فلسفی",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "گوش خویش از ذکر تفسیر صفی",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "گو بمان در جهل و انکار ای حکیم",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "کی به پروای تو اند اهل نعیم",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "خنده می کردند اندر امر و نهی",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "بر کلام انبیا و حکم و وحی",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "پس فرو بگرفتشان در آزمون",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "حکم ما کَانُواْ بِهِ یَستَهزِؤُن",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "یافتند از بأس ما چون آگهی",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "بالعیان گفتند امَنَّا بِهِ",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "بر خدایی کو بود یکتا به ذات",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "کرده ارسال رسل با بیّنات",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "کافریم اینک به آن چیزی که ما",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "زآن بُدیم از پیش کافر بر خدا",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "پس نبُد کایمانشان سودی دهد",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "چونکه دیدند آن عذاب بی ز حد",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "سنت االله گشته جاری در اصول",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "که نباشد وقت یأس ایمان قبول",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "آن طریقه که نهاد او در عباد",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "کافران خسران نمودند از عناد",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "مرغ بی هنگام را شاید که پَر",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "برکنندش یا برندش زود سر",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    }
  ]
}
