      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "أَ لَمْ تَرَ إِلَی اَلَّذِینَ یُجٰادِلُونَ فِی آیٰاتِ اَللّٰهِ أَنّٰی یُصْرَفُونَ (۶۹) اَلَّذِینَ کَذَّبُوا بِالْکِتٰابِ وَ بِمٰا أَرْسَلْنٰا بِهِ رُسُلَنٰا فَسَوْفَ یَعْلَمُونَ (۷۰) إِذِ اَلْأَغْلاٰلُ فِی أَعْنٰاقِهِمْ وَ اَلسَّلاٰسِلُ یُسْحَبُونَ (۷۱) فِی اَلْحَمِیمِ ثُمَّ فِی اَلنّٰارِ یُسْجَرُونَ (۷۲) ثُمَّ قِیلَ لَهُمْ أَیْنَ مٰا کُنْتُمْ تُشْرِکُونَ (۷۳) مِنْ دُونِ اَللّٰهِ قٰالُوا ضَلُّوا عَنّٰا بَلْ لَمْ‌ نَکُنْ نَدْعُوا مِنْ قَبْلُ شَیْئاً کَذٰلِکَ یُضِلُّ اَللّٰهُ اَلْکٰافِرِینَ (۷۴) ذٰلِکُمْ بِمٰا کُنْتُمْ تَفْرَحُونَ فِی اَلْأَرْضِ بِغَیْرِ اَلْحَقِّ وَ بِمٰا کُنْتُمْ تَمْرَحُونَ (۷۵) اُدْخُلُوا أَبْوٰابَ جَهَنَّمَ خٰالِدِینَ فِیهٰا فَبِئْسَ مَثْوَی اَلْمُتَکَبِّرِینَ (۷۶) فَاصْبِرْ إِنَّ وَعْدَ اَللّٰهِ حَقٌّ فَإِمّٰا نُرِیَنَّکَ بَعْضَ اَلَّذِی نَعِدُهُمْ أَوْ نَتَوَفَّیَنَّکَ فَإِلَیْنٰا یُرْجَعُونَ (۷۷) وَ لَقَدْ أَرْسَلْنٰا رُسُلاً مِنْ قَبْلِکَ مِنْهُمْ مَنْ قَصَصْنٰا عَلَیْکَ وَ مِنْهُمْ مَنْ لَمْ نَقْصُصْ عَلَیْکَ وَ مٰا کٰانَ لِرَسُولٍ أَنْ یَأْتِیَ بِآیَةٍ إِلاّٰ بِإِذْنِ اَللّٰهِ فَإِذٰا جٰاءَ أَمْرُ اَللّٰهِ قُضِیَ بِالْحَقِّ وَ خَسِرَ هُنٰالِکَ اَلْمُبْطِلُونَ (۷۸)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "آیا ندیدی بسوی آنان که منازعه می‌کنند در آیتهای خدا که بکجا برگردانیده می‌شوند (۶۹) آنان که تکذیب نمودند کتاب را و آنچه را فرستادیم بآن رسولانمان را پس زود باشد که بدانند (۷۰) هنگامی که غلهاست در گردنهای ایشان و زنجیرها کشیده می‌شوند (۷۱) در آب گرم پس در آتش انداخته می‌شوند (۷۲) پس گفته شود مر ایشان را کجاست بودید که شریک می‌ساختید (۷۳) از غیر خدا گفتند گم شدند از ما بلکه نبودیم که می‌خواندیم از پیش چیزی را همچنین اضلال می‌کند خدا کافران را (۷۴) آن بسبب آنست که بودید شادمانی می‌کردید در زمین بناحق و بسبب آنچه بودید که می‌نازیدید (۷۵) داخل شوید در درهای دوزخ جاودانیان در آن پس بد است مقام تکبرکنندگان (۷۶) پس صبر کن بدرستی که وعده خدا حق است پس یا می‌نمائیم ترا برخی از آنچه وعده می‌دهیم ایشان را یا متوفی می‌سازیم ترا پس بسوی ما بازگردانیده می‌شوند (۷۷) و بتحقیق فرستادیم رسولانی را پیش از تو از ایشان کس است که خواندیم قصه ایشان را بر تو از ایشان کسی است که نخواندیم بر تو و نسزد مر رسولی را که بیاورد آیتی مگر باذن خدا پس چون بیاید فرمان خدا حکم کرده شود بحق و زیان می‌کنند آنجا باطل‌کیشان (۷۸)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ننگری آیا بر ایشان که جدل",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "اندر آیات االله آرند از دغل",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "تا چسان گردانده ایشان میشوند",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "بر علاوه کآیتی را نگروند",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "داشتند ایشان همانا بر دروغ",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "هم رسول و هم کتاب با فروغ",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "وآنچه را که بر رسولان داده ایم",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "بهر آن بر خلق بفرستاده ایم",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "وحی و تنزیل است و حکم آن در نظام",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "زود پس باشد که دانند آن تمام",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "چونکه در اعناقشان غلها نهیم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "وَالسلَسِلُ یُسحَبُونَ فِی الْحَمِییم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "پس شوند ایشان در آتش سوخته",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "آتشی ز اخلاق بد افروخته",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "پس بگویند آن ملایک، چون شدند",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "آن خدایانتان که غیر از حق بُدند",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "می بگویند آن کسان، گشتند گم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "آن همه افسانه بود و اُشتلم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "بلکه ظاهر شد نبودند ایچ چیز",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "ما غلط پنداشتیم از بی تمیز",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "لَّم نَکُن نَّدعُواْ إلَی مِن قَبلُ شَیء",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "بودمان اندر گمان اینگونه کی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "کافران را واگذارد حق چنین",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "پس ملایکشان بگویند از کمین",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "این عذاب امروزتان گردید فرض",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "شاد چون بودید در دنیا به ارض",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "غیر حق می بودتان آن انبساط",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "وآنچه می کردید در دنیا نشاط",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "از وقوع رنج و کُرهی بر رسل",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "می شکفتید استماعش را چو گل",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "مؤمنان را دل شود ز اندوه آب",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "چونکه خوانند آن بلایا در کتاب",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "بارالهی شادی ما در جهان",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "کن بدان سان که تو باشی شاد از آن",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "نی کز آن شادی تو باشی نارضا",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "بر تو زآن گیرم پناه ای ذوالعطا",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "نک درآیید اندر ابواب جحیم",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "واندر آن باشید جاویدان مقیم",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "بس بد است آرامگاه سرکشان",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "از خصال بد که بودند اندر آن",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "پس تو می کن صبر بر جور فرق",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "ای پیمبر إنَّ وَعدَ االلهِ حَق",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "پس نماییم ار تو را بعضی از آن",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "که بر ایشان وعده دادیم آن چنان",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "یا بمیرانیمت ار زآن پیشتر",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "پس به ما گردند باز ایشان دگر",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "ما فرستادیم بر نام و نشان",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "پیشتر از تو بسی پیغمبران",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "بعضی از ایشان بوند آنها که ما",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "بر تو فرمودیم قصه هر کجا",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "بعض دیگر را نخواندستیم هم",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "قصۀ ایشان تو را از بیش و کم",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "می نبد پیغمبری را در نسق",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "کآیتی آرد بدون اذن حق",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "پس چو آمد امر حق حکمی به راست",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "میشود بین دو قوم این بر سزاست",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "مؤمنانند آن دو قوم و کافران",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "و اهل بطلان می کنند آنجا زیان",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    }
  ]
}
