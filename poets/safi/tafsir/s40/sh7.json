      "HtmlText": "\u003Cdiv class=\u0022b\u0022 id=\u0022bn1\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eوآن عذاب حسرت است و انفعال\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eیا ندم کافزاید او بر سوء حال\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E",
      "CoupletsCount": 1
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "یٰا قَوْمِ إِنَّمٰا هٰذِهِ اَلْحَیٰاةُ اَلدُّنْیٰا مَتٰاعٌ وَ إِنَّ اَلْآخِرَةَ هِیَ دٰارُ اَلْقَرٰارِ (۳۹) مَنْ عَمِلَ سَیِّئَةً فَلاٰ یُجْزیٰ‌ إِلاّٰ مِثْلَهٰا وَ مَنْ عَمِلَ صٰالِحاً مِنْ ذَکَرٍ أَوْ أُنْثیٰ وَ هُوَ مُؤْمِنٌ فَأُولٰئِکَ یَدْخُلُونَ اَلْجَنَّةَ یُرْزَقُونَ فِیهٰا بِغَیْرِ حِسٰابٍ (۴۰) وَ یٰا قَوْمِ مٰا لِی أَدْعُوکُمْ إِلَی اَلنَّجٰاةِ وَ تَدْعُونَنِی إِلَی اَلنّٰارِ (۴۱) تَدْعُونَنِی لِأَکْفُرَ بِاللّٰهِ وَ أُشْرِکَ بِهِ مٰا لَیْسَ لِی بِهِ عِلْمٌ وَ أَنَا أَدْعُوکُمْ إِلَی اَلْعَزِیزِ اَلْغَفّٰارِ (۴۲) لاٰ جَرَمَ أَنَّمٰا تَدْعُونَنِی إِلَیْهِ لَیْسَ لَهُ دَعْوَةٌ فِی اَلدُّنْیٰا وَ لاٰ فِی اَلْآخِرَةِ وَ أَنَّ مَرَدَّنٰا إِلَی اَللّٰهِ وَ أَنَّ اَلْمُسْرِفِینَ هُمْ أَصْحٰابُ اَلنّٰارِ (۴۳) فَسَتَذْکُرُونَ مٰا أَقُولُ لَکُمْ وَ أُفَوِّضُ أَمْرِی إِلَی اَللّٰهِ إِنَّ اَللّٰهَ بَصِیرٌ بِالْعِبٰادِ (۴۴) فَوَقٰاهُ اَللّٰهُ سَیِّئٰاتِ مٰا مَکَرُوا وَ حٰاقَ بِآلِ فِرْعَوْنَ سُوءُ اَلْعَذٰابِ (۴۵) اَلنّٰارُ یُعْرَضُونَ عَلَیْهٰا غُدُوًّا وَ عَشِیًّا وَ یَوْمَ تَقُومُ اَلسّٰاعَةُ أَدْخِلُوا آلَ فِرْعَوْنَ أَشَدَّ اَلْعَذٰابِ (۴۶)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "ای جماعت جز این نیست که این زندگانی دنیا مایه اندک تعیشی است و بدرستی که آخرت آنست سرای آرام (۳۹) آنکه کرد بدی را پس جزا داده نمی‌شود مگر مانندش و آنکه کرد کاری شایسته از مذکر یا مؤنث و او گر گرونده است پس آنها داخل می‌شوند در بهشت روزی داده می‌شوند در آن بیشمار (۴۰) و ای جماعت چیست مرا که می‌خوانم شما را بسوی نجات و می‌خوانید مرا بسوی آتش (۴۱) می‌خوانید مرا که کافر شوم بخدا و شریک سازم باو آنچه نیست مرا بآن دانشی و من می‌خوانم شما را بسوی خدا غالب آمرزنده (۴۲) ناچار است که آنچه می‌خوانید مرا بسوی آن نیست مر او را خواندنی در دنیا و نه در آخرت و اینکه بازگشت ما بسوی خداست و اینکه اسراف‌کنندگان ایشانند اهل آتش (۴۳) پس بزودی یاد خواهید کرد آنچه می‌گویم مر شما را و باز می‌گذارم کاری را بخدا بدرستی که خدا بیناست ببندگان (۴۴) پس نگهداشت او را خدا از بدیهای آنچه اندیشیدند و احاطه کرد بکسان فرعون بدی عقوبت (۴۵) آتش عرض کرده می‌شوند بر آن بامداد و شبانگاه و روزی که قایم شود قیامت و داخل کنید کسان فرعون را در سخت‌ترین عقوبت (۴۶)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ای گروهِ من، جز این نبود که هست",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "زندگی این جهان برخورد پست",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "این متاعی اندک اندر اعتبار",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "وآن سرای آخرت دارالقرار",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "هر که کاری بد کند پاداش آن",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "پس نباشد جز که مثلش در جهان",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "وآنکه کرد او کار نیک از مرد و زن",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "وآنکه او مؤمن بود بی مکر و فن",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "آن گُره پس داخل اندر جنّتند",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "رزق داده بی حساب از حضرتند",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "قوم از گفتار حزبیل آن چنان",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "فهم ایمان کرد هر کس در بیان",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "پس زبانها گشت بر طعنش دراز",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "داشتی کز دین خود دست از چه باز",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "دین موسی را نمودی اختیار",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "گشتی از فرعون و دینش برکنار",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "گفت او یَاقَومِ مَالِی یا ثقات",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "اینکه می خوانم شما را بر نجات",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "پس شما خوانید سوی آتشم",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "وین بود خواندن ز دیو سرکشم",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "می بخوانیدم که تا من بر خدا",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "کافر و مشرک شوم بر ناروا",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "با خدا آرم شریک آن را که نیست",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "مر مرا علمی به اصل آن، که چیست",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "یا نی ام دانا بر آنکه جز خدا",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "می تواند بود مع بودی بجا",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "من همی خوانم شما را از قرار",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "بر خدای غالب آمرزگار",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "ثابت است این کآنچه خوانیدم بر آن",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "نیست او را خواندنی در دو جهان",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "دعوت فرعون را یا از خدا",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "استجابت نیست در هر مدعا",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "این است حق که بازگشت ما تمام",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "جمله باشد سوی خلاّق الانام",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "وآن ز حد خویش بیرون رفتگان",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "جملگی اصحابِ نارند از نشان",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "زود باشد پس که تا آرید یاد",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "آنچه من گویم شما را از وداد",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "واگذارم کار خود را من به حق",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "کوست بینا بر عباد و ماخَلَق",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "پس نگاهش داشت حق از بد سیر",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "وز بدی مکر ایشان سر به سر",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "زآنکه قصد قتل او فرعون کرد",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "چونکه او آگه بُد از ایمان مرد",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "کرد پس حزبیل بر کوه ی فرار",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "کوه گشت از امر حق بر وی حصار",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "هر که رفت آنجا به قصد قتل وی",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "از حقش سوءالعذاب آمد ز پی",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "حاقَ بأل اعنی که بر فوعونیان",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "می رسید از حق عذابی ناگهان",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "غرق باشد یا مراد از حَاقَ بأل",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "که به بحر آن جمله گشتند از ضلال",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "نار از سوءالعذاب آمد بَدل",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "که بر ایشا ن عرضه گشت اندر محل",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "نار دوزخ یا بر ایشان صبح و شام",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "دارد اندر سوزش خویش اهتمام",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "اندر آیید آل فرعون از خبر",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "در قیامت بر عذابی سخت تر",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "وآن عذاب حسرت است و انفعال",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "یا ندم کافزاید او بر سوء حال",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    }
  ]
