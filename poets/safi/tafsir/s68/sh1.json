      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "زآنچه شد بنوشته با کِلک از دوات",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "آنچه بنگارندگانِ این صور",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "می نویسند از قلم زیر و زبر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "هست آن باز ار به تن داری روان",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "صورت اشیاء و ماهیّات آن",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "نیستی دیوانه ای فخر کبار",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "تو به نعمت های آن پروردگار",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "آن چنان که بر تو این نسبت دهند",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "احمق و دیوانه و مجنون چند",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "آنکه در عقل و نبوّت خاتم است",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "عقل او گویند بی عقلان کم است",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "مر تو را اجری است بی منّت ز کس",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "در نبوّت یعنی از حق است و بس",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "نیست غیری در وصولش واسطه",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "تا بود منّت تو را از رابطه",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "خود تو بر خُلق بزرگی ای رسول",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "که کنی از قومت این ایذا قبول",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "هست اندر حسن خُلق افزون سخن",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "با تو گویم بعضی از آن جمله من",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "گفته بعضی خُلق این باشد به چشم",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "که کند خشم ار کست نایی به خشم",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "گفته منصور این است که، بر نیک و بد",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "بنگری از چشم حق نه از چشم خود",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "بس دقیق است، این کلام عام نیست",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "هست بهر پخته، بهر خام نیست",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "لیک می گوید صفی شو منتقل",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "هست خُلق ادراکت ار شد معتدل",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "وآن میسّر نیست بهر هیچ کس",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "جز که بندد دست وسواس و هوس",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "بستن آن هم بود دور از گمان",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "جز که آید پای عشق اندر میان",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "چونکه آمد عشق هر فکری که هست",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "دان که از شهر حواس او بار بست",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "او نخواهد جز رضای یار خویش",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "فارغ است از راحت و آزار خویش",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "پس نکرد او فعلی آن محبوب کرد",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "کرد محبوب ار که کاری خوب کرد",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "این لسان دیگری بُد نک سخن",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "گویم از قانون تفسیر ای حَسن",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "خُلق نیک این است گر داری محل",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "وصف تو بر وصف حق گردد بَدل",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "متصف چون بر صفات حق شدی",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "رستی از قید خودی مطلق شدی",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "آن نه خُلق توست دیگر خُلق اوست",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "خُلق او خود هم بزرگ و هم نکوست",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "آب جو وارد چو در قلزم شود",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "موج آن در موج دریا گم شود",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "تا به اصل خُلق باشی منتبه",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "بر تو چیزی زآن نباشد مشتبه",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    }
  ]
}
