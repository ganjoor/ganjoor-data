      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "کش ز چشم بد در اندازد ز پا",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "حق نگاهش داشت از چشم عدو",
