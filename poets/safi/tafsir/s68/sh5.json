  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "وَ إِنْ یَکٰادُ اَلَّذِینَ کَفَرُوا لَیُزْلِقُونَکَ بِأَبْصٰارِهِمْ لَمّٰا سَمِعُوا اَلذِّکْرَ وَ یَقُولُونَ إِنَّهُ لَمَجْنُونٌ (۵۱) وَ مٰا هُوَ إِلاّٰ ذِکْرٌ لِلْعٰالَمِینَ (۵۲)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "بدرستی که نزدیک بود آنان که کافر شدند هر آینه بزنند ترا بچشمهایشان چون شنیدند ذکر را و می‌گویند اینکه او دیوانه است (۵۱) و نیست او مگر پندی مر جهانیان را (۵۲)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "مرد بد چشمی بُد از قوم اسد",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "مردمان را داد رنج از چشم بد",
