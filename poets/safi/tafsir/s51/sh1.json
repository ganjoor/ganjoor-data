    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "زآنکه آید در عیان و در عیون",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "خود شما ای اهل مکه بی خلاف",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "جملگی دارید در قول اختلاف",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "گاه خوانید این نبی را شاعرش",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "کاهن و مجنون و گاهی ساحرش",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "هر که شد مصروف ز احمد (ص) با کتاب",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "گشته برگردیده ز ایمان بی حساب",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "کُشته خَرَّاصُون شدستند از دروغ",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "که بود تخمینشان دور از فروغ",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "کرده یعنی لعنت ایشان را خدا",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "کز گمان گفتند بر حق افترا",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "آن کسان باشند در جهلی فرو",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "غافلان از امر و نهی حکم او",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "بر سبیل سخریت پرسند هین",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "از نبیّین، کی بود تا یوم دین",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "باشد آن روزی که در آتش حریق",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "میشوند از خصلت خویش این فریق",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "سوزش خود را چشید این است چون",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "الَّذُی کُنتُم بِهِ تَستَعجِلُون",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    }
  ]
}
