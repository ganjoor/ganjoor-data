      "Text": "وَ اَلسَّمٰاءَ بَنَیْنٰاهٰا بِأَیْدٍ وَ إِنّٰا لَمُوسِعُونَ (۴۷) وَ اَلْأَرْضَ فَرَشْنٰاهٰا فَنِعْمَ اَلْمٰاهِدُونَ (۴۸) وَ مِنْ کُلِّ شَیْ‌ءٍ خَلَقْنٰا زَوْجَیْنِ لَعَلَّکُمْ تَذَکَّرُونَ (۴۹) فَفِرُّوا إِلَی اَللّٰهِ إِنِّی لَکُمْ مِنْهُ نَذِیرٌ مُبِینٌ (۵۰) وَ لاٰ تَجْعَلُوا مَعَ اَللّٰهِ إِلٰهاً آخَرَ إِنِّی لَکُمْ مِنْهُ نَذِیرٌ مُبِینٌ (۵۱) کَذٰلِکَ مٰا أَتَی اَلَّذِینَ مِنْ قَبْلِهِمْ مِنْ رَسُولٍ إِلاّٰ قٰالُوا سٰاحِرٌ أَوْ مَجْنُونٌ (۵۲) أَ تَوٰاصَوْا بِهِ بَلْ هُمْ قَوْمٌ طٰاغُونَ (۵۳) فَتَوَلَّ عَنْهُمْ فَمٰا أَنْتَ بِمَلُومٍ (۵۴) وَ ذَکِّرْ فَإِنَّ اَلذِّکْریٰ تَنْفَعُ اَلْمُؤْمِنِینَ (۵۵)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "و آسمان بنا کردیمش بقوت بدرستی که مائیم وسعت‌دهندگان (۴۷) و زمین گستردیم آن را پس خوب گسترانندگانیم (۴۸) و از هر چیزی آفریدیم دو صنف باشد که شما پند گیرید (۴۹) پس بگریزید بسوی خدا بدرستی که من مر شما را از او بیم‌کننده آشکارا (۵۰) و مگردانید با خدا الهی دیگر بدرستی که من مر شما را از او بیم‌کننده آشکارم (۵۱) همچنین نباید به آنانکه پیش از ایشان بودند هیچ رسولی مگر گفتند جادوگر است یا دیوانه (۵۲) آیا وصیت یکدیگر کردند بآن بلکه ایشانند گروهی زیاده‌روندگان (۵۳) پس اعراض کن از ایشان پس نباشی تو ملامت کرده شده (۵۴) و پند ده پس بدرستی که پند سود می‌دهد مؤمنان را (۵۵)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "بعد ذکر انبیاء و قومشان",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "حق ز قدرتهای خود سازد بیان",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "چرخ را کردیم از قوّت بنا",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "بر بنای آن تواناییم ما",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "یا به چیزی اوسع از وی در وجود",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "یا دهد وسعت به رزق اندر نمود",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "هم زمین را گستراندیم این چنین",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "بر صلاح بندگان خود یقین",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "گستراننده نکو ماییم پس",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "قادر اندر هر عمل ماییم و بس",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "وآن کنیم از بهر اصلاح بشر",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "نی که ما را هیچ از آن باشد ثمر",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "آفریدیم از هر آن چیزی دو جفت",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "پند تا گیرید مانا در نهفت",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "پس به سوی حق کنید از خود فرار",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "من شما را زو دهم بیم آشکار",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "همچنین نامد بدیشان از رسول",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "پیش از ایشان جز که گفتند از فضول",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "کاین مگر جادوست یا دیوانه ای",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "قول حق را ساختند افسانه ای",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "مر وصیّت کرده اند آیا به این",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "سابقین بر لاحقین از کفر و کین",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "بلکه خود ایشان به طغیان اندرند",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "رفته از فرمان برون، کین آورند",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "پس بگردان روی از این ننگین فرق",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "پس نه ای تو بر ملامت نزد حق",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "پند ده مر اهل ایمان را که پند",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "نفع بخشد مؤمنان را در پسند",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    }
  ]
}
