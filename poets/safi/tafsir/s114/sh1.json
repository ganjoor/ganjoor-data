  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "بسم االله الرحمن الرحیم",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "قُلْ أَعُوذُ بِرَبِّ اَلنّٰاسِ (۱) مَلِکِ اَلنّٰاسِ (۲) إِلٰهِ اَلنّٰاسِ (۳) مِنْ شَرِّ اَلْوَسْوٰاسِ اَلْخَنّٰاسِ (۴) اَلَّذِی یُوَسْوِسُ فِی صُدُورِ اَلنّٰاسِ (۵) مِنَ اَلْجِنَّةِ وَ اَلنّٰاسِ (۶)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "بنام خداوند بخشاینده مهربان",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Paragraph",
      "Text": "بگو ای محمد پناه می‌برم بپروردگار آدمیان (۱) پادشاه آدمیان (۲) خدای آدمیان (۳) از بدی دیو و وسوسه کننده خناس (۴) آنکه وسوسه می‌کند وسوسه می‌کند در سینه‌های مردمان (۵) از جن و آدمیان (۶)",
      "CoupletIndex": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "گو که می گیرم پناه از هر زیان",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "باز بر پروردگار مردمان",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
