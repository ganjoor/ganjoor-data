      "Text": "وَ مٰا تَفَرَّقُوا إِلاّٰ مِنْ بَعْدِ مٰا جٰاءَهُمُ اَلْعِلْمُ بَغْیاً بَیْنَهُمْ وَ لَوْ لاٰ کَلِمَةٌ سَبَقَتْ مِنْ رَبِّکَ إِلیٰ أَجَلٍ مُسَمًّی لَقُضِیَ بَیْنَهُمْ وَ إِنَّ اَلَّذِینَ أُورِثُوا اَلْکِتٰابَ مِنْ بَعْدِهِمْ لَفِی شَکٍّ مِنْهُ مُرِیبٍ (۱۴) فَلِذٰلِکَ فَادْعُ وَ اِسْتَقِمْ کَمٰا أُمِرْتَ وَ لاٰ تَتَّبِعْ أَهْوٰاءَهُمْ وَ قُلْ آمَنْتُ بِمٰا أَنْزَلَ اَللّٰهُ مِنْ کِتٰابٍ وَ أُمِرْتُ لِأَعْدِلَ بَیْنَکُمُ اَللّٰهُ رَبُّنٰا وَ رَبُّکُمْ لَنٰا أَعْمٰالُنٰا وَ لَکُمْ أَعْمٰالُکُمْ لاٰ حُجَّةَ بَیْنَنٰا وَ بَیْنَکُمُ اَللّٰهُ یَجْمَعُ بَیْنَنٰا وَ إِلَیْهِ اَلْمَصِیرُ (۱۵) وَ اَلَّذِینَ یُحَاجُّونَ فِی اَللّٰهِ مِنْ بَعْدِ مٰا اُسْتُجِیبَ لَهُ حُجَّتُهُمْ دٰاحِضَةٌ عِنْدَ رَبِّهِمْ وَ عَلَیْهِمْ غَضَبٌ وَ لَهُمْ عَذٰابٌ شَدِیدٌ (۱۶)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "و متفرق نشدند مگر پس از آنچه آمد ایشان را دانش از راه ستمی که بود میانشان و اگر نبود کلمه که پیش رفته از پروردگارت تا مدتی نام برده شده هر آینه حکم کرده شده بود میانشان و بدرستی که آنان که بمیراث داده شدند کتاب را از بعد ایشان هر آینه در شکی‌اند از آن بگمان اندازنده (۱۴) پس برای آن پس بخوان و ثابت باش چنان که فرموده شد و پیروی مکن مرادهای ایشان را و بگوی گرویدم بآنچه فرو فرستاد خدا از کتاب و فرموده شدم که عدالت کنم میان شما خداست پروردگار ما و پروردگار شما مر ما راست کردار ما و مر شما راست کردارتان نیست خصومتی میان ما و میان شما خدا جمع می‌کند میان ما و بسوی او بازگشت (۱۵) و آنان که خصومت می‌کنند در خدا از بعد آنکه اجابت کرده شد مر او را حجت ایشان باطل است نزد پروردگارشان و بر ایشانست غضبی و مر ایشان‌راست عذابی سخت (۱۶)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "می پراکنده نگشتند آن فرق",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "جز ز بعد از علم کآمدشان ز حق",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "بر کتاب و بر رسل از عینشان",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "وین بُد از جبر و ستم مابینشان",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "یعنی از دانستگی بر مرسلین",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "اُمّتان را بود حقد و کبر و کین",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "همچنین دانسته گشتند از رسول",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "مر جدا این مشرکان ناقبول",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "گر نبُد سبقت گرفته مر کلام",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "از خدا تا وقت آنکه برده نام",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "حکم کرده می شدی مابینشان",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "از عذابی سخت و بد بر عینشان",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "وآن کسان که داده گشتند از کتاب",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "از پس بگذشتگان در انتساب",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "قصد از ایشانند ترسا و یهود",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "یا که کفار قریش اندر نمود",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "کآمد این قرآن پس از چندین کتاب",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "بهر ایشان وز عطاء بگشود باب",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "پس در آن کردند شک با شدتی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "آن چنان شکی که بود از ریبتی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "پس به این تقریب فَادعُ وَاستَقِم",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "آنچه را باشی تو مأمور از مهم",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "باش ثابت یعنی اندر دعوتت",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "هم به هر حکمی رسد هر نوبتت",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "هم مکن تو پیروی ز اهوائشان",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "وآنچه خوانندت بر آن ز آرایشان",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "مشرکان گفتند بدهیمت یقین",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "مال و دختر گر که برگردی ز دین",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "آمد آیت کاین مقالات است خام",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "تو به دعوت باش یکدل بر انام",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "بگرویدستم بگو من بر صواب",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "آنچه را حق کرده نازل از کتاب",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "همچنین مأمورم از ربّ الکرم",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "بر سویّه بینتان باشم حکم",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "آن خدا کو خالق اشیاء همه است",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "آفرینندة شما و ما همه است",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "هست ما را مر جزای کرده ها",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "هم شما بینید از کرده جزا",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "می نماند از قوّت حق زآیتی",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "خصمیی مابین ما یا حجتی",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "ظاهر است و غالب اعنی ذوالجلال",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "در سخن نبود خصومت را مجال",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "زین سپس دیگر کس ار کرد احتجاج",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "آن نباشد جز عناد و جز لجاج",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "بین ما را جمع حق خواهد نمود",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "سوی او برگشت خواهد بود زود",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "حجت اندر حق کسانی که کنند",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "زو اجابت کرده زآن پس که شدند",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "در ازل کردند توحیدش قبول",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "یا یهودان پیش از آن کآید رسول",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "بر وی از نعت و صفت مؤمن بُدند",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "سر ز تمکینش چو آمد وازدند",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "حجت ایشان را مگر در نزد رب",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "باطل است و هست بر ایشان غضب",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "هم عذابی باشد ایشان را شدید",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "شد به جنگ بدر آثارش پدید",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    }
  ]
}
