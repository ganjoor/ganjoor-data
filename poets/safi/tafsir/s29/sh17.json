      "Text": "وَ مٰا هٰذِهِ اَلْحَیٰاةُ اَلدُّنْیٰا إِلاّٰ لَهْوٌ وَ لَعِبٌ وَ إِنَّ اَلدّٰارَ اَلْآخِرَةَ لَهِیَ اَلْحَیَوٰانُ لَوْ کٰانُوا یَعْلَمُونَ (۶۴) فَإِذٰا رَکِبُوا فِی اَلْفُلْکِ دَعَوُا اَللّٰهَ مُخْلِصِینَ لَهُ اَلدِّینَ فَلَمّٰا نَجّٰاهُمْ إِلَی اَلْبَرِّ إِذٰا هُمْ یُشْرِکُونَ (۶۵) لِیَکْفُرُوا بِمٰا آتَیْنٰاهُمْ وَ لِیَتَمَتَّعُوا فَسَوْفَ یَعْلَمُونَ (۶۶) أَ وَ لَمْ یَرَوْا أَنّٰا جَعَلْنٰا حَرَماً آمِناً وَ یُتَخَطَّفُ اَلنّٰاسُ مِنْ حَوْلِهِمْ أَ فَبِالْبٰاطِلِ یُؤْمِنُونَ وَ بِنِعْمَةِ اَللّٰهِ یَکْفُرُونَ (۶۷) وَ مَنْ أَظْلَمُ مِمَّنِ اِفْتَریٰ عَلَی اَللّٰهِ کَذِباً أَوْ کَذَّبَ بِالْحَقِّ لَمّٰا جٰاءَهُ أَ لَیْسَ فِی جَهَنَّمَ مَثْویً لِلْکٰافِرِینَ (۶۸) وَ اَلَّذِینَ جٰاهَدُوا فِینٰا لَنَهْدِیَنَّهُمْ سُبُلَنٰا وَ إِنَّ اَللّٰهَ لَمَعَ اَلْمُحْسِنِینَ (۶۹)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "و نیست این زندگانی دنیا جز هزل و بازی و بدرستی که سرای بازپسین هر آینه آنست سرای زندگانی اگر باشند که بدانند (۶۴) پس چون سوار شوند در کشتی بخوانند خدا را بیغش دارندگان برای او دین را پس چون نجات داد ایشان را بسوی دشت آن‌گاه ایشان شرک می‌آورند (۶۵) تا کفران ورزند بآنچه دادیم ایشان را و تا کامیاب شوند پس بزودی خواهند دانست (۶۶) آیا ندیدند که ما گردانیدیم حرمی را امن و ربوده می‌شوند مردمان از پیرامونشان آیا پس بباطل می‌گروند و بنعمت خدا کفران می‌ورزند (۶۷) و کیست ستمکارتر از آنکه بست بر خدا دروغ را یا تکذیب کرد حق را چون آمد او را آیا نیست در دوزخ جای اقامت برای کافران (۶۸) و آنان که مجاهده کردند در ما هر آینه هدایت می‌کنیم ایشان را راههای خود را و بدرستی که خدا هر آینه با نیکوکارانست (۶۹)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "این حیات دنیوی بی خبط و سهو",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "نیست نیک ار بنگری جز لعب و لهو",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "دار دیگر زندگانی را سزاست",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "ملک باقی گر بدانند آن سراست",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "پس چو در کشتی شوند ایشان سوار",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "می بخوانند آن خدا را ز اضطرار",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "کشتی از موج افتد اندر پیچ و تاب",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "مخلصند او را به دین از اضطراب",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "در نظر آن دم نه بت نه بت گر است",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "دستها بر درگه حق یکسر است",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "زآنکه برهاننده را دانند حق",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "نی دگر کس را ز کل ماخَلَق",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "پس چو برهاند خداشا ن زآن خطر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "یعنی از بحر آوردشان سوی برّ",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "آن زمان آرند شرک از خوی خویش",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "آن چنان که بودشان عادت ز پیش",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "تا به داده ما از آن کافر شوند",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "مجتمع گردند چون هم بهره مند",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "برخورند اعنی به اجماع آن کسان",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "از پرستش خود بر اصنام و بتان",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "جای شکر آرند شرک و کافری",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "زود پس آگه شوند از بد سری",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "می ندیدند ایچ آیا مکیان",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "اینکه گرداندیم ما خود بهرشان",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "مکه را یعنی به امنیّت حرم",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "تا در آن باشند ایمن از ستم",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "وآنکه از دورش ربوده می شوند",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "مردمان یعنی که ایشان را کُشند",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "قتل و غارت اندر اطراف حرم",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "هست بیش از آنکه آید در قلم",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "و اهل آن باشند در مهد امان",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "نیستشان بیمی ز آفات جهان",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "پس به باطل هیچ آیا بگروند",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "هم به نعمتهای حق کافر شوند",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "کیست ظالم تر از آن کو بر خدا",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "مر دروغی بست از واقع جدا",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "یا کند تکذیب حق یعنی رسول",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "یا که قرآن کآمد او را در نزول",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "نیست آیا در جهنم جایگاه",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "کافران را که غلط کردند راه",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "وآن کسان که کوشش اندر دین ما",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "می نمایند از خلوصی نه از ریا",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "روز و شب بیدار و پنهان در جهاد",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "با عدو باشند از صدق و شداد",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "در مصاف دشمنان باشند مرد",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "همچنین با نفس سرکش در نبرد",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "ما هدایتشان کنیم اندر سبل",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "بر جهات خیر خویش از جزء و کل",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "راه های معرفتشان یا عیان",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "میکنیم آنسان که ره بر کاروان",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "یا هر آن کوشش کند بر راه راست",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "ما رسانیمش به مقصودی که خواست",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "حق بود با محسنین در کل حال",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "عارفان رهرو نیکو خصال",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "محسن است آن کس که حقش رهنماست",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "حق بود با آنکه هم او با خداست",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    }
  ]
}
