      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "اِقْرَأْ بِاسْمِ رَبِّکَ اَلَّذِی خَلَقَ (۱) خَلَقَ اَلْإِنْسٰانَ مِنْ عَلَقٍ (۲) اِقْرَأْ وَ رَبُّکَ اَلْأَکْرَمُ (۳) اَلَّذِی عَلَّمَ‌ بِالْقَلَمِ (۴) عَلَّمَ اَلْإِنْسٰانَ مٰا لَمْ یَعْلَمْ (۵) کَلاّٰ إِنَّ اَلْإِنْسٰانَ لَیَطْغیٰ (۶) أَنْ رَآهُ اِسْتَغْنیٰ (۷) إِنَّ إِلیٰ رَبِّکَ اَلرُّجْعیٰ (۸) أَ رَأَیْتَ اَلَّذِی یَنْهیٰ (۹) عَبْداً إِذٰا صَلّٰی (۱۰) أَ رَأَیْتَ إِنْ کٰانَ عَلَی اَلْهُدیٰ (۱۱) أَوْ أَمَرَ بِالتَّقْویٰ (۱۲) أَ رَأَیْتَ إِنْ کَذَّبَ وَ تَوَلّٰی (۱۳) أَ لَمْ یَعْلَمْ بِأَنَّ اَللّٰهَ یَریٰ (۱۴) کَلاّٰ لَئِنْ لَمْ یَنْتَهِ لَنَسْفَعاً بِالنّٰاصِیَةِ (۱۵) نٰاصِیَةٍ کٰاذِبَةٍ خٰاطِئَةٍ (۱۶) فَلْیَدْعُ نٰادِیَهُ (۱۷) سَنَدْعُ اَلزَّبٰانِیَةَ (۱۸) کَلاّٰ لاٰ تُطِعْهُ وَ اُسْجُدْ وَ اِقْتَرِبْ (۱۹)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "بنام خداوند بخشاینده مهربان",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Paragraph",
      "Text": "بخوان بنام پروردگارت که آفرید (۱) آفرید انسان را از خون بسته (۲) بخوان پروردگار تو است کریم‌تر (۳) آنکه تعلیم نوشتن بقلم (۴) آموزانید انسان را آنچه نمی‌دانست (۵) حقا بدرستی که انسان عصیان می‌ورزد (۶) به اینکه دید خود را که بی‌نیاز شد (۷) بدرستی که بسوی پروردگار تو است بازگشت (۸) آیا دیدی کسی را که منع کند (۹) بنده را چون نماز کند (۱۰) آیا دیدی که اگر بود بر هدایت (۱۱) یا امر کرد بپرهیزکاری (۱۲) آیا دیدی که اگر تکذیب کرد و روی گردانید (۱۳) آیا ندانست که خدا می‌بیند (۱۴) نه چنانست هر آینه اگر با نایستد خواهم گرفت البته کسانشان بموی پیشانی (۱۵) پیشانی دروغگوی خطاکار (۱۶) پس باید که بخواند اهل مجلسش را (۱۷) زود باشد بخوانیم زبانیه را (۱۸) نه چنانست فرمان مبر او را و سجده کن و نزدیک شو (۱۹)",
      "CoupletIndex": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "آیتی کاول رسید از رب دین",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "بود اِقرَأ بِاسمِ رَبِّک بالیقین",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "نام ربّت را بخوان ای مصطفی (ص)",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "آن خدایی کآفرید او چیزها",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "خلقت انسان ز خون بسته کرد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "عضوهایش پس به هم پیوسته کرد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "روزی اندر غار حرا بُد رسول",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "کرد بر وی جبرئیل از حق نزول",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "گفت برخوان گفت خواننده نی ام",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "جبرئیلش برفشرد آن دم به هم",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "گشت بی طاقت شد اندر خانه باز",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "تب گرفتش خفت بر جا ز اهتزاز",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "بار دیگر جبرئیل آمد فرود",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "آیت دیگر بر او آورد زود",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "رفت پیش ورقة بن نوفل او",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "با خدیجه زوجۀ پاکیزه خو",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "گفت آن حالات را با وی همه",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "گفت تو پیغمبری بی واهمه",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "حاصل آنکه اول آیت بود این",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "که بر او آمد ز ربّ العالمین",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "می بخوان تو ای پیمبر نام حق",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "آنکه خلق آدمی کرد از علق",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "آمد این آیت نخستین بر رسول",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "زآنکه خلقت اصل باشد بر عقول",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "تا بداند آدمی که لایقش",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "هست و واجب بندگی خالقش",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "رب اکرم را بخوان که با قلم",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "مر نوشتن را بیاموزند هم",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "می بیاموزاند آدم را تمام",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "آنچه را که می ندانست از مهام",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "الحق انسان است طاغی بر خدا",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "چونکه خود را دید ذی قدر و عنا",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "هست سوی رب تو بی معذرت",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "بازگشت جمله اندر آخرت",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "بینی آیا آنکه دارد هیچ باز",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "بندة ما را که باشد در نماز",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "بینی ای ناهی تو آیا که بود",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "بندة ما گر که بر راه رشد",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "امر بر تقوی نماید یا نماز",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "می توان او را چگونه داشت باز",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "بینی آیا آنکه تکذیب ار کند",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "یا که رو گرداند آن بوجهل رد",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "مستحق بر چه عذابی گردد او",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "هم بدینسان هر مکذب هر عدو",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "این ندانسته است آیا از عمی",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "که بود بینا به قصد او خدا",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "باید او از نهی تا باز ایستد",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "ایستد ور نی که باز آن بی خرد",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "موی پیشانی او گیریم هم",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "بر کشیمش سوی دوزخ وآن الم",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "ناصیۀ آن کاذب خاطی که باز",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "داردت ز آداب و تقوی و نماز",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "پس بباید اهل خود را خواند او",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "زود خوانیم آن زبانه بر عدو",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "آن زبانه دوزخ پر قهر و نار",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "تا کشد او را به دوزخ ز اضطرار",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "آن چنان نبود که گفت آن محتجب",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "تو مبر فرمانش وَاسجُد وَاقتَرِب",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    }
  ]
}
