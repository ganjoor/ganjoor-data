      "Text": "فَإِنْ یَصْبِرُوا فَالنّٰارُ مَثْویً لَهُمْ وَ إِنْ یَسْتَعْتِبُوا فَمٰا هُمْ مِنَ اَلْمُعْتَبِینَ (۲۴) وَ قَیَّضْنٰا لَهُمْ قُرَنٰاءَ فَزَیَّنُوا لَهُمْ مٰا بَیْنَ أَیْدِیهِمْ وَ مٰا خَلْفَهُمْ وَ حَقَّ عَلَیْهِمُ اَلْقَوْلُ فِی أُمَمٍ قَدْ خَلَتْ مِنْ قَبْلِهِمْ مِنَ اَلْجِنِّ وَ اَلْإِنْسِ إِنَّهُمْ کٰانُوا خٰاسِرِینَ (۲۵) وَ قٰالَ اَلَّذِینَ کَفَرُوا لاٰ تَسْمَعُوا لِهٰذَا اَلْقُرْآنِ وَ اِلْغَوْا فِیهِ لَعَلَّکُمْ تَغْلِبُونَ (۲۶) فَلَنُذِیقَنَّ اَلَّذِینَ کَفَرُوا عَذٰاباً شَدِیداً وَ لَنَجْزِیَنَّهُمْ أَسْوَأَ اَلَّذِی کٰانُوا یَعْمَلُونَ (۲۷) ذٰلِکَ جَزٰاءُ أَعْدٰاءِ اَللّٰهِ اَلنّٰارُ لَهُمْ فِیهٰا دٰارُ اَلْخُلْدِ جَزٰاءً بِمٰا کٰانُوا بِآیٰاتِنٰا یَجْحَدُونَ (۲۸) وَ قٰالَ اَلَّذِینَ کَفَرُوا رَبَّنٰا أَرِنَا اَلَّذَیْنِ أَضَلاّٰنٰا مِنَ اَلْجِنِّ وَ اَلْإِنْسِ نَجْعَلْهُمٰا تَحْتَ أَقْدٰامِنٰا لِیَکُونٰا مِنَ اَلْأَسْفَلِینَ (۲۹)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "پس اگر صبر کنند پس آتش مقام است مر ایشان را و اگر طلب خوشنودی کنند پس نباشند از عذر پذیرفته‌شدگان (۲۴) و بر گماشتیم برای ایشان رفیقان پس آرایش دادند مر ایشان را آنچه بودند میانه دستهاشان و آنچه بود پس سرشان و ثابت شد بر ایشان سخن در امتانی که بحقیقت گذشتند پیش از ایشان از جن و انس بدرستی که ایشان بودند زیانکاران (۲۵) و گفتند آنان که کافر شدند مشنوید مر این قرآن را و هرزه درآیی کنید در آن باشد که شما غالب شوید (۲۶) پس هر آینه می‌چشانیم البته آنان را که کافر شدند عذابی سخت و هر آینه جزا دهیمشان بدترین آنچه بودند که می‌کردند (۲۷) اینست جزای دشمنان خدا آتش مر ایشان‌راست در آن سرای جاودانی پاداشی بسبب آنچه بودند آیتهای ما را انکار می‌کردند (۲۸) و گفتند آنان که کافر شدند پروردگار ما بنمای ما را آن دو کسرا که گمراه کردند ما را از جن و انس تا بگردانیم آن دو را در زیر قدمهامان تا باشید ما را از فروتران (۲۹)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "پس شکیبایی کنند از کافران",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "جایشان پس دوزخ آمد بی گمان",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "ور کنند از حق تمنّای رضا",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "تا شود خوشنود از ایشان خدا",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "یا که گردد باز از خشم و عتاب",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "نیست ایشان را اجابت زآن جناب",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "از قضاء کردیم تقدیر این چنین",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "مشرکان را دوستان و همنشین",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "وآن شیاطین بهرشان آراستند",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "ز امتعۀ دنیا که خود می خواستند",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "بَینَ أیدِیهِم متاع دنیوی است",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "خَلْفَهُم بعد از امور اخروی است",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "همنشینان این بود وسواسشان",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "چونکه بنشینند با اجناسشان",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "که ببین این همسرانت را چسان",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "در ترفع برگذشتند از کسان",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "صاحب ملکند و مال و گنج و زر",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "تو چو مرغی مانده ای بی بال و پر",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "آخرت را دیده کس کی برملا",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "گفته اند این مفلسان بی نوا",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "تا بدین افسانه های بی فروغ",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "عقل مردم را بدزدند از دروغ",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "بودشان بر سر هوای برتری",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "این کند باور جز از دانش بری",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "ور که باشد دارِ دیگر هم به جا",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "این شقوقاتش بود صدق از کجا",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "قول پس واجب بر ایشان گشت و حق",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "قول یعنی آن عذاب با غلق",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "وآنگهی بودند امتها ز پیش",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "از پری و آدمی زین قوم بیش",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "مستحق گشتند ایشان بر عذاب",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "هست خسران، کافران را بی حساب",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "مشرکان گفتند در بیت الحرام",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "یکدگر را گوش ندهید این کلام",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "خواند اعنی چونکه قرآن مصطفی",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "نشنوید و افکنید اقوالها",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "در میان خواندنش یعنی سخن",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "افکنید از لغو و یاوه آن زمن",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "هم به تقلیدش ز هر جانب شوید",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "تا شما شاید بر او غالب شوید",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "پس چشانیم آن کسان را بر مزید",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "ما عذابی سخت زآن کفر شدید",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "هم جزاء بدهیمشان بدتر جزا",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "زآنچه کردند از عملها ناسزا",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "آن عذاب سخت روز بدر بود",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "بدترش در آخرت خواهد نمود",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "آن جزاء اعداء حق را آتش است",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "جان در آنشان جاودان آتش کش است",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "زآن سبب که دائم از جهل و عمی",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "بودشان انکار بر آیات ما",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "آن کسان گویند که کافر شدند",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "چونکه وارد در جهنم آمدند",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "کآن دو کس را ای خدا از انس و جان",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "وا نما کردند کآن گمراهمان",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "تا بگردانیمشان در زیر گام",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "ما لگدکوب آن چنان در انتقام",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "تا که باشند از گروه أسفَلِین",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "یا در اسفل رتبۀ دوزخ مکین",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    }
  ]
}
