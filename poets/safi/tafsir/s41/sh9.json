      "Position": "Right",
      "Text": "مر فرو بگرفته علم و قدرتش",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 62,
      "Position": "Left",
