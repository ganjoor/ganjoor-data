    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "قصد از آفاق و انفس شد فتوح",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "کاهل دین را باشد اندر جسم و روح",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "در عیان فتح اقالیم و بلاد",
