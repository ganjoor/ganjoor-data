      "Text": "منکشف حق پرده های راز کرد",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "بابها بر اهل معنی باز کرد",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "باز بر سیمرغ جان شد راه قاف",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "عالم از گرد هوا گردید صاف",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "نیست آیا مر تو را کافی اِله",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "هست ربّت مر به هر چیزی گواه",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "می بدانید اینکه در شکّند و ریب",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "از لقاء رب خویش از نقص و عیب",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "هم بدانید اینکه حق سبحانهُ",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "کرده بر اشیاء احاطه علم او",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
