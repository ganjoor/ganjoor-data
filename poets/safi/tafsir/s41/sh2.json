      "HtmlText": "\u003Cdiv class=\u0022b\u0022 id=\u0022bn1\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eزآنکه می باشید بر مانند ما\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eآدمی هم شکل و هم پیوند ما\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E",
      "CoupletsCount": 1
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "وَ جَعَلَ فِیهٰا رَوٰاسِیَ مِنْ فَوْقِهٰا وَ بٰارَکَ فِیهٰا وَ قَدَّرَ فِیهٰا أَقْوٰاتَهٰا فِی أَرْبَعَةِ أَیّٰامٍ سَوٰاءً لِلسّٰائِلِینَ (۱۰) ثُمَّ اِسْتَویٰ إِلَی اَلسَّمٰاءِ وَ هِیَ دُخٰانٌ فَقٰالَ لَهٰا وَ لِلْأَرْضِ اِئْتِیٰا طَوْعاً أَوْ کَرْهاً قٰالَتٰا أَتَیْنٰا طٰائِعِینَ (۱۱) فَقَضٰاهُنَّ سَبْعَ سَمٰاوٰاتٍ فِی یَوْمَیْنِ وَ أَوْحیٰ فِی کُلِّ سَمٰاءٍ أَمْرَهٰا وَ زَیَّنَّا اَلسَّمٰاءَ اَلدُّنْیٰا بِمَصٰابِیحَ وَ حِفْظاً ذٰلِکَ تَقْدِیرُ اَلْعَزِیزِ اَلْعَلِیمِ (۱۲) فَإِنْ أَعْرَضُوا فَقُلْ أَنْذَرْتُکُمْ صٰاعِقَةً مِثْلَ صٰاعِقَةِ عٰادٍ وَ ثَمُودَ (۱۳) إِذْ جٰاءَتْهُمُ اَلرُّسُلُ مِنْ بَیْنِ أَیْدِیهِمْ وَ مِنْ خَلْفِهِمْ أَلاّٰ تَعْبُدُوا إِلاَّ اَللّٰهَ قٰالُوا لَوْ شٰاءَ رَبُّنٰا لَأَنْزَلَ مَلاٰئِکَةً فَإِنّٰا بِمٰا أُرْسِلْتُمْ بِهِ کٰافِرُونَ (۱۴)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "و گردانید در آن کوه‌های استوار از بالای آن و برکت داد در آن و تقریر کرد در آن خوردنیهای آن را در چهار روز مساوی برای خواهندگان (۱۰) پس پرداخت بآسمان و آن بود دودی پس گفت مر آن را و مر زمین را که بیائید خواه یا ناخواه گفتند آمدیم فرمان‌برداران (۱۱) پس قرار داد آنها را هفت آسمان در دو روز و وحی کرد در هر آسمان کاران را و آراسته کردیم آسمان دنیا را بچراغها و محافظتی اینست قرارداد خدای غالب دانا (۱۲) پس اگر روی گردانیدند پس بگوئیم دادم شما را صاعقه مثل صاعقه عاد و ثمود (۱۳) هنگامی که آمد ایشان را رسولان از میان دستهاشان و از پس سرشان که نپرستید مگر خدا را گفتند اگر خواسته بود پروردگار ما فرستاده بود ملائکه را پس بدرستی که ما بآنچه فرستاده شدید بآن کافرانیم (۱۴)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "هم ز فوقش کوه های مرتفع",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "راست کرد ار هست هوشت مجتمع",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "زآنکه ارض و کوه نزد امتیاز",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "وضع اثقال است بر اثقال باز",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "زین کند عبرت مگر ذی مُدرکی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "نیست کش در آفریننده شکی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "هر دو محتاجند این کوه و زمین",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "بر نگهداری که هست اقوی یقین",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "داد برکت کوه ها را برقرار",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "از معادن، وز منابع بی شمار",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "یا بود راجع ضمیران بر زمین",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "برکت ارض است یعنی این چنین",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "کرد تقدیر اندر آن ارزاق را",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "در چهار ایّام مر انفاق را",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "ز اوست کیفیّات اربع مر مراد",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "یا عناصر در مزاج و در مراد",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "هر مرکب یابد از وی لاعلاج",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "بالسویه اعتدال و امتزاج",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "هست یکسان آن ز بهر سائلین",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "هر که مرزوق است یعنی در زمین",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "قصد پس فرمود خلق آسمان",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "وآن بخاری بود و دودی در عیان",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "پس بگفت ارض و سماء را ائتِیَا",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "طَوعاً أوکَرْهاً به امر و اذن ما",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "هر دو گفتند آسمان و هم زمین",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "خالق خود را أتَینَا طآئِعِین",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "قصد از این ائتیان و امتثال",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "این دو را تکوین ذات است از مقال",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "کرد پس هفت آسمان را محکم او",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "در دو یوم اعنی دو حیث اعظم او",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "ماده است و صورت آن در حکم عقل",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "وحی هر یک را نمود امرش به نقل",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "کرد یعنی وحی بر هر آسمان",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "چیست تا کارش ز رفتار و نشان",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "آسمان اولین کو اقرب است",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "در صفاء و در لطافت اغلب است",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "مر مصابیحش چنین آراستیم",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "صاف و پر زیبش چنین می خواستیم",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "یعنی این استارگان کاندر فراغ",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "می درخشند از فلک همچون چراغ",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "شرح این را گفته ایم از پیشتر",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "از مکرر رو به تکرار نظر",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "هم نگه ما داشتیم از آفتش",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "وز شیاطین در کمال رفعتش",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "این است تقدیر اعنی اندازه ز حق",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "غالب و دانا به وضع ماخَلَق",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "پس کنند اعراض گر از ناعقه",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "پس بگو أنذَرتُکُم عَنْ صَاعِقَه",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "همچو بر عاد و ثمود اندر سبل",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "و آمده بود آنکه ایشان را رسل",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "هم ز پیش و هم ز پشت آن گروه",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "پند دادند از جوانب وز وجوه",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "آنکه نپرستید چیزی جز خدا",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "قوم گفت ار خواستی خود رب ما",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "تا که نپرستیم چیزی بی ز شک",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "می فرستادی به نزد ما ملک",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "پس به چیزی که فرستاده شدید",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "ما به آن می نگرویم از هر وعید",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "زآنکه می باشید بر مانند ما",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "آدمی هم شکل و هم پیوند ما",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    }
  ]
}
