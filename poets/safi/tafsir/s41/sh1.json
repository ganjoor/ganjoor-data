      "VOrder": 52,
      "Position": "Left",
      "Text": "پاک سازد مالها را از عیوب",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "همچنین توحید باری چون زکات",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "پاک سازد نفس را از ترّهات",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "لا اله الاّ االله ار گویی یکی",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "نفس مغشوشت شود پاک و زکی",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "می نمودند اهل شرک اطعام حاج",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "لیک نی بر مؤمنان در احتیاج",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "وآن کسان کآورده اند ایمان به حق",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "کرده اند اعمال نیکو بر نسق",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "اجرشان باشد بدون منّتی",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "یا بدون انقطاع از نوبتی",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "نگروید آیا شما می گو به قوم",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "آنکه را خلق زمین کرد او دو یوم",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "وآن دو یوم است امر و قول اندر نظر",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "هم دگر یوم قضاء، یوم قدر",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "صورت است و ماده، یا قصد از آن",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "اندر این دو شکل ارض آمد عیان",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "اول است اجزای ارضیه تمام",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "صورت نوعیه ثانی ز انتظام",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "بهر او همتا و اشباه آورید",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "اوست ربّ العالمین کاین آفرید",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    }
  ]
}
