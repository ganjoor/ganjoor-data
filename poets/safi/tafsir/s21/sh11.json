      "VOrder": 34,
      "Position": "Right",
      "Text": "یازده بگذشته بود او را ز سال",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 14
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "نامد این حکمش موافق در فعال",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 14
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "شد به دار الشرع و مر داوود را",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 15
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "گفت بهتر زین توان کرد این قضا",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 15
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "ایلیا را باز هل این گوسفند",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 16
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "تا شود از پشم و شیرش بهره مند",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 16
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "هم به یوحنا سپار آن باغ زود",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 17
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "تا رساند بر همان حالی که بود",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 17
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "پس کند تسلیم آن بر ایلیا",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 18
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "زو ستاند باغ خود را برملا",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 18
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "تا که بی بهره نمانند ایچ یک",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 19
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "گفت داوودش که االله مَعَک",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 19
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "حکم این باشد که گفتی پس نمود",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 20
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "حکم بر ایشان چنان کو گفته بود",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 20
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "زین قضیه بر رسولش ذوا لجلال",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 21
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "داد از بهر حکومت انتقال",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 21
    }
  ]
}
