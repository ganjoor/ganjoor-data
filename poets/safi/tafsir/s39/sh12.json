      "Text": "وَ نُفِخَ فِی اَلصُّورِ فَصَعِقَ مَنْ فِی اَلسَّمٰاوٰاتِ وَ مَنْ فِی اَلْأَرْضِ إِلاّٰ مَنْ شٰاءَ اَللّٰهُ ثُمَّ نُفِخَ فِیهِ أُخْریٰ فَإِذٰا هُمْ قِیٰامٌ یَنْظُرُونَ (۶۸) وَ أَشْرَقَتِ اَلْأَرْضُ بِنُورِ رَبِّهٰا وَ وُضِعَ اَلْکِتٰابُ وَ جِیءَ بِالنَّبِیِّینَ وَ اَلشُّهَدٰاءِ وَ قُضِیَ بَیْنَهُمْ بِالْحَقِّ وَ هُمْ لاٰ یُظْلَمُونَ (۶۹) وَ وُفِّیَتْ کُلُّ نَفْسٍ مٰا عَمِلَتْ وَ هُوَ أَعْلَمُ بِمٰا یَفْعَلُونَ (۷۰) وَ سِیقَ اَلَّذِینَ کَفَرُوا إِلیٰ جَهَنَّمَ زُمَراً حَتّٰی إِذٰا جٰاؤُهٰا فُتِحَتْ أَبْوٰابُهٰا وَ قٰالَ لَهُمْ خَزَنَتُهٰا أَ لَمْ یَأْتِکُمْ رُسُلٌ مِنْکُمْ یَتْلُونَ عَلَیْکُمْ آیٰاتِ رَبِّکُمْ وَ یُنْذِرُونَکُمْ لِقٰاءَ یَوْمِکُمْ هٰذٰا قٰالُوا بَلیٰ وَ لٰکِنْ حَقَّتْ کَلِمَةُ اَلْعَذٰابِ عَلَی اَلْکٰافِرِینَ (۷۱) قِیلَ اُدْخُلُوا أَبْوٰابَ جَهَنَّمَ خٰالِدِینَ فِیهٰا فَبِئْسَ مَثْوَی اَلْمُتَکَبِّرِینَ (۷۲)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "و دمیده شد در صور پس بیهوش شد آنکه بود در آسمانها و آنکه بود در زمین جز آنکه خواست خدا پس دمیده شد در آن دیگر پس آن‌گاه ایشانند ایستادگان که می‌نگرند (۶۸) و روشن شد زمین بنور پروردگارش و نهاده شد کتاب و آورده شدند پیغمبران و شهیدان و حکم کرده شد میانشان براستی و ایشان ظلم کرده نمی‌شوند (۶۹) و تمام داده شد هر نفسی آنچه را کرده بود و اوست داناتر بآنچه می‌کنند (۷۰) و رانده شدند آنان که کافر شدند بسوی دوزخ فوج فوج تا چون آمدند آن را گشوده شد درهایش و گفتند مر ایشان را خازنانش آیا نیامد شما را رسولانی از شما که می‌خواندند بر شما آیتهای پروردگارمان را و بیم می‌کردند شما را ملاقات روزتان این گفتند آری و لیکن لازم آمد سخن عقوبت بر کافران گفته شد (۷۱) که داخل شوید در درهای دوزخ جاودانیان در آن پس بد است مقام تکبرکنندگان (۷۲)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "هم دمیده می شود در صور دم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "نفخۀ صَعِق از سرافیل اُمم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "یعنی امّتهای اعصار و دهور",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "فانی اول دم شوند از نفخ صور",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "جملگی مدهوش گردند از کمین",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "هر که اندر آسمان است و زمین",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "غیر آنان را که می خواهد خدا",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "یعنی آن چار از ملایک ز اعتلا",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "پس به عزرائیل (ع) گوید گیر نک",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "جان میکائیل (ع) و اسرافیل(ع) یک",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "چون بگیرد گوید او را خود بمیر",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "در زمان میرد ز امرش ناگزیر",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "پس خطاب آید ز خلاّق جلیل",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "زنده دیگر کیست گوید جبرئیل",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "ایها الباقی بقای وجه ذات",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "هم دگر جبریل (ع) فانی از جهات",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "دائم و باقی تویی ز اجلال خویش",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "میّت و فانی منم در حال خویش",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "پس خطاب آید که جز حق زنده کیست",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "جبرئیلا چاره هیچ از موت نیست",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "پس نماید سجده جبریل امین",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "جان کند تسلیم بر جان آفرین",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "رتبه ای نبود به جا جز ذات او",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "کلّ شیء هالک الاّ وجهه",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "عارفان گویند من شاء االله است",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "خاص بر اهل بقایش کآگه است",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "زنده ایشان را کند سلطان جود",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "بعد موت اعنی فنای فی الوجود",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "در قیامت پس نمیرند آن گروه",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "دفعۀ دیگر به وجهی از وجوه",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "زآنکه ایشان را به او باشد حیات",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "فانی اند از نفس های بی ثبات",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "از مقام نفس و قلب و روح و عقل",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "می کند اندر فناء پیوسته نقل",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "تا شوند از رتبه ها فانی تمام",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "پس به او گردند باقی والسلام",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "نفخۀ دیگر پس اندر صور باز",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "هم دمیده می شود در امتیاز",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "پس به ناگه زنده گردند آن تمام",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "فَإذَا هُم یَنْظُرُون اندر قیام",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "واله و مبهوت اندر انتظار",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "تا چه با ایشان کنند از اختیار",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "أشْرَقَتِ الأرضُ بِنُوِر رَبِّهَا",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "ارضِ حشر از عدل گردد پر بها",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "نفس یابد بر عدالت اتصاف",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "ظل شمس وحدت است آن بی خلاف",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "وضع گردد نامه ها بهر حساب",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "لوح محفوظ آن بود نامش کتاب",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "انبیاء را هم بیارند آن زمان",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "بهر الزام حجج بر امّتان",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "وآن شهیدان که گواه صادقند",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "وآن ملک یا کشتگان عاشقند",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "حکم کرده پس شود در آزمون",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "بَینَهُم بِالْحَقِّ وَهُم لَایُظْلَمُون",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "داده هر نفسی شود او را تمام",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "مر جزای آنچه کرده است آن مقام",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "اوست دانا بر هر آنچه می کنند",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "بندگانش از پسند و ناپسند",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "رانده از عنف و مذلت سوی نار",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "بر زُمَر کردند کفار از قرار",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "مر زُمَر یعنی گروه اندر گروه",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "فوج فوج و فرقه فرقه با ستوه",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "تا به دوزخ چون در آیند از نزول",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "بابها بگشوده گردد بر دخول",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "خازنان گویند آیا بر شما",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "از شما نامد رسولی رهنما",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "بر شما تا خواند آیت های رب",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "وز چنین روزی بترساند عجب",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "می بگویند آمد آری بر صواب",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 36
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "لیک واجب قول حق شد بر عذاب",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 36
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "هست یعنی واجب آن بر کافران",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 37
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "گفته ایشان را شود پس کاین زمان",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 37
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "اندر آیید از در دوزخ به راه",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 38
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "بد بود گردنکشان را جایگاه",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 38
    }
  ]
}
