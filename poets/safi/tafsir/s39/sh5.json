      "HtmlText": "\u003Cdiv class=\u0022b\u0022 id=\u0022bn1\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eوین دو همدستند با هم در سلوک\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eهمچو خور قمّاع ظلمات شکوک\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E",
      "CoupletsCount": 1
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "أَ فَمَنْ حَقَّ عَلَیْهِ کَلِمَةُ اَلْعَذٰابِ أَ فَأَنْتَ تُنْقِذُ مَنْ فِی اَلنّٰارِ (۱۹) لٰکِنِ اَلَّذِینَ اِتَّقَوْا رَبَّهُمْ لَهُمْ غُرَفٌ مِنْ فَوْقِهٰا غُرَفٌ مَبْنِیَّةٌ تَجْرِی مِنْ تَحْتِهَا اَلْأَنْهٰارُ وَعْدَ اَللّٰهِ لاٰ یُخْلِفُ اَللّٰهُ اَلْمِیعٰادَ (۲۰) أَ لَمْ تَرَ أَنَّ اَللّٰهَ أَنْزَلَ مِنَ اَلسَّمٰاءِ مٰاءً فَسَلَکَهُ یَنٰابِیعَ فِی اَلْأَرْضِ ثُمَّ یُخْرِجُ بِهِ زَرْعاً مُخْتَلِفاً أَلْوٰانُهُ ثُمَّ یَهِیجُ فَتَرٰاهُ مُصْفَرًّا ثُمَّ یَجْعَلُهُ حُطٰاماً إِنَّ فِی ذٰلِکَ لَذِکْریٰ لِأُولِی اَلْأَلْبٰابِ (۲۱) أَ فَمَنْ شَرَحَ اَللّٰهُ صَدْرَهُ‌ لِلْإِسْلاٰمِ فَهُوَ عَلیٰ نُورٍ مِنْ رَبِّهِ فَوَیْلٌ لِلْقٰاسِیَةِ قُلُوبُهُمْ مِنْ ذِکْرِ اَللّٰهِ أُولٰئِکَ فِی ضَلاٰلٍ مُبِینٍ (۲۲)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "آیا پس آنکه لازم شد بر او سخن عذاب آیا پس تو نجات می‌دهی آن را که باشد در آتش (۱۹) لیکن آنان که ترسیدند از پروردگارشان برای ایشانست غرفه‌هایی که از بالای آنهاست غرفه‌هائیست بنا کرده شده که می‌رود از زیر آنها نهرها وعده دادن خدا خلاف نمی‌کند خدا وعده را (۲۰) آیا نه بینی که خدا فرو فرستاد از آسمان آب را پس روان گردانید آن را چشمه‌ها در زمین پس بیرون آورد بآن کشتی را که مختلف است اصنافش پس خشک می‌شود پس بینی آن را زرد شده پس می‌گرداند آن را شکسته ریزها بدرستی که در آن هر آینه پندیست مر صاحبان خردها را (۲۱) آیا پس کسی که گشادگی داد خدا سینه‌اش را برای اسلام پس اوست بر نوری از پروردگارش پس وای بر آنان که سخت است دلهای ایشان از یاد خدا آنهااند در گمراهی روشن (۲۲)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "آن کسی آیا که واجب شد بر او",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "قول تهدید عذاب ایضاً له",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "پس تو آیا می رهانی ز آتشش",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "کرده چون دست قضاء آتش کشش",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "لیک پرهیزندگان را از شرف",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "غرفه ها مبنی بود فوق غُرَف",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "آن کسانی کز خدا ترسنده اند",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "سال و مه در بندگی پاینده اند",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "جاری ایشان را ز زیر غرفه ها",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "باشد انهاری روان از طرفه ها",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "این است وعدة حق که داده بی شمار",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "خلف نکند وعدة خود کردگار",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "نازل آیا می نبینی اینکه کرد",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "آب را از آسمان خلاّق فرد",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "پس به کاریز و ینابیع این چنین",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "اندر آورد آب را از قعر زمین",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "پس برون زآن آب آرد کشتزار",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "رنگهایش مختلف بیش از هزار",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "یا مراد از مختلف الوانهُ",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "باشد آن اصناف و اجناس نکو",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "چون برنج و گندم و هم ماش و جو",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "میوه ها از هر قبیلی نو به نو",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "میشود خشک آن پس از سبزی دگر",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "بینی آن را پس تو زرد اندر نظر",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "پس بگرداند مر آن را ریز ریز",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "اندر این پندی است بر اهل تمیز",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "پس کسی آیا که بگشاده خدای",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "صدر و قلبش را به اسلام از عطای",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "یا وسیله قوة ادراک و عقل",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "وز دلیل و حجت و برهان و نقل",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "یا که از محض عنایت در قرار",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "وآن بود پس نوری از پروردگار",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "یا که او از نور حق روشن دل است",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "شرح صدر از نور حقش حاصل است",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "هست چون آن کس که باشد سینه اش",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "تنگ و تاریک و سیاه آیینه اش",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "بر قلوب قاسیه پس ویل و وای",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "کآن نباشد روشن از ذکر خدای",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "در ضلالی آشکارند این گروه",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "که بود دلهایشان از سنگ و کوه",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "ذکر باشد یاد علام الغیوب",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "که حق آن را داده نسبت بر قلوب",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "هر که معرض شد ز فکر و راه فکر",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "باب قلبش را ببندد حق ز ذکر",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "صورت فکر است گر داری حضور",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "وجه نور االله فی کل الدهور",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "نی که هر وجهی بود رخسار شه",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "لعل را باید شناسی از شبه",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "دست دیو نفس بند، ار واصفی",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "از سلیمان حشمتی یا آصفی",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "آن سلیمان صورت پیغمبر است",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "آصف اندر ره ولیّ رهبر است",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "از مضلات ار به حق جویی پناه",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "با الله ار هیچت برد دیوی ز راه",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "رهبر از تفسیر من دانی که کیست",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "شرح قرآن زآنکه تفسیر صفی است",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "هادی خلقان بود قرآن و بس",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "یا که صاحب سینۀ کامل نفس",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "وین دو همدستند با هم در سلوک",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "همچو خور قمّاع ظلمات شکوک",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    }
  ]
}
