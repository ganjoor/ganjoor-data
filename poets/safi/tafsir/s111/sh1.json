  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "بسم االله الرحمن الرحیم",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "تَبَّتْ یَدٰا أَبِی لَهَبٍ وَ تَبَّ (۱) مٰا أَغْنیٰ عَنْهُ مٰالُهُ وَ مٰا کَسَبَ (۲) سَیَصْلیٰ نٰاراً ذٰاتَ لَهَبٍ (۳) وَ اِمْرَأَتُهُ حَمّٰالَةَ اَلْحَطَبِ (۴) فِی جِیدِهٰا حَبْلٌ مِنْ مَسَدٍ (۵)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "بنام خداوند بخشایندۀ مهربان",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Paragraph",
      "Text": "شکسته باد دو دست ابی لهب که خواست سنگ به پیغمبر زند (۱) دفع نکند از او مال او و آنچه کسب کرده (۲) زود باشد که در آید آتش را خداوند زبانه (۳) و زن او که بردارنده هیمه است (۴) در گردن او ریسمانیست از کیف خرما (۵)",
      "CoupletIndex": 3
    },
