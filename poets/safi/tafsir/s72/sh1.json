      "Position": "Left",
      "Text": "نه زن او گیرد نه فرزند از پسند",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "جاهل و نادان ما یعنی بلیس",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "بر خدا گوید سخنها آن خسیس",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "آن سخنهایی که بگذشته ز حد",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "بدهد اعنی نسبت جفت و ولد",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "انس و جن را خود گمان کردیم ما",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "می نگویند ایچ کذبی بر خدا",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "لاجرم می گفت هر چه آن سفیه",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "بودمان باور که باشد آن وجیه",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "چون شنیدیم آن کلام با فروغ",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "یافتیم آن بر خدا بسته دروغ",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 29,
