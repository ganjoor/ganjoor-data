  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "بسم االله الرحمن الرحیم",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "قُلْ أُوحِیَ إِلَیَّ أَنَّهُ اِسْتَمَعَ نَفَرٌ مِنَ اَلْجِنِّ فَقٰالُوا إِنّٰا سَمِعْنٰا قُرْآناً عَجَباً (۱) یَهْدِی إِلَی اَلرُّشْدِ فَآمَنّٰا بِهِ وَ لَنْ نُشْرِکَ بِرَبِّنٰا أَحَداً (۲) وَ أَنَّهُ تَعٰالیٰ جَدُّ رَبِّنٰا مَا اِتَّخَذَ صٰاحِبَةً وَ لاٰ وَلَداً (۳) وَ أَنَّهُ کٰانَ یَقُولُ سَفِیهُنٰا عَلَی اَللّٰهِ شَطَطاً (۴) وَ أَنّٰا ظَنَنّٰا أَنْ لَنْ تَقُولَ اَلْإِنْسُ وَ اَلْجِنُّ عَلَی اَللّٰهِ کَذِباً (۵) وَ أَنَّهُ کٰانَ رِجٰالٌ مِنَ اَلْإِنْسِ یَعُوذُونَ بِرِجٰالٍ مِنَ اَلْجِنِّ فَزٰادُوهُمْ رَهَقاً (۶) وَ أَنَّهُمْ ظَنُّوا کَمٰا ظَنَنْتُمْ أَنْ لَنْ یَبْعَثَ اَللّٰهُ أَحَداً (۷)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "بنام خدای بخشاینده مهربان",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Paragraph",
      "Text": "بگو وحی کرده شد بسوی من که شنیدند طایفه از جن پس گفتند بدرستی که شنیدیم قرآن را عجب (۱) که هدایت نمود بسوی راستی پس گردیدیم باو و شریک نگردانیدیم بپروردگار خود احدی را (۲) و آنکه بلند است عظمتشان پروردگار ما نگرفت زنی را و نه فرزندی (۳) و بدرستی که بود که می‌گفت کم خرد ما بر خدا سخن دور از صواب (۴) و بدرستی که ما گمان کردیم که نگویند هرگز انس و جن بر خدا دروغ (۵) و بدرستی که او بودند مردانی از انس که پناه می‌بردند بمردانی از جن پس افزود ایشان را طغیان (۶) و بدرستی که گمان کردند هم چنان که گمان کردید آنکه بر نخواهد انگیزانید خدا احدی را (۷)",
      "CoupletIndex": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "گو محمّد (ص) وحی از حق شد به من",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "اینکه بشنیدند قرآن بی سخن",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "زیر نخله چند تن از جنّیان",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "هفت تن بودند یا نُه بی گمان",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "کرده ایم از پیش ما تحقیق جن",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "چیست تا آن گر بر آنی مطمئن",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "قوم خود را پس بگفتند از طلب",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "اینکه بشنیدیم ما قولی عجب",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "ره به سوی رشد بنماید نکو",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "پس خود آوردیم ما ایمان به او",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "شرک ما ناریم بر پروردگار",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "بر یکی ز اصنام زین پس ز اختیار",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
