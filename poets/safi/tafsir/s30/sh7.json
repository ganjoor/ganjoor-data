  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "فَأَقِمْ وَجْهَکَ لِلدِّینِ حَنِیفاً فِطْرَتَ اَللّٰهِ اَلَّتِی فَطَرَ اَلنّٰاسَ عَلَیْهٰا لاٰ تَبْدِیلَ لِخَلْقِ اَللّٰهِ ذٰلِکَ اَلدِّینُ اَلْقَیِّمُ وَ لٰکِنَّ أَکْثَرَ اَلنّٰاسِ لاٰ یَعْلَمُونَ (۳۰)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "پس راست گردان رویت را برای دین حق‌گرای آفرینش خدا را که آفرید خلق را بر آن نیست تغییری مر آفرینش خدا را اینست آن دین راست و درست و لیکن بیشترین مردمان نمی‌دانند (۳۰)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "روی خود پس راست گردان بهر دین",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "یک جهت در کل ادیان بالیقین",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "وآن به وفق فطرت است از کردگار",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "خلقتان کرد او به دین استوار",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "خلق مفطورند بر دین الست",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "که بدند از روی فطرت حق پرست",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "بازشان بر فطرت از نهی تمام",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "هست بر توحیدشان میل و مقام",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "همچنان که عقل در آدم نهاد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "دین عقلی اندر ایشان هم نهاد",
