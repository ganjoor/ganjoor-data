      "VOrder": 13,
      "Position": "Left",
      "Text": "وین کمال صنع باشد زآن قلم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "نیک گردی گر در این معنی دقیق",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "قدرت صانع بیابی ای رفیق",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "این نه کار طبع باشد یا مزاج",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "گر در ادراکت نباشد اعوجاج",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "بل طبیعت فعل او بر ضد این",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "باشد اندر نزد عقل خورده بین",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "از عناصر و از مزاج مؤتلف",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "کی پدید آید شئون مختلف",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "اختلاف ار هم پدید آید یکی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "در مقامی نیست غیر از اندکی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "نی بدینسان اختلاف بی ز حد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "که در آن افتد به حیرانی خرد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "این نیاید در وقوع ار ناظری",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "جز ز خلاقی حکیم قادری",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "هم دگر ز آیات او خواب شماست",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "در شب و روز و در این راحت قواست",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "هم شما را در مقام جستجو",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "جستن روزی ز بخشش های او",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "در شب اعنی استراحت شد قوا",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "روزتان تحصیل رزق است از خدا",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "واندر این باشد دلالت ها عیان",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "بهر قومی کاشنوند از گوش جان",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "وز علامتهای صنعش هر کجا",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "برق باشد که نماید بر شما",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "بر مسافر ز اوست خوف صاعقه",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "طمع باران بر مقیم از بارقه",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "می فرستد آب را از آسمان",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "ارض مرده زنده پس سازد بدان",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "اندر این باشد نشانها بی قصور",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "بهر ارباب تعقل در ظهور",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "وز نشان های توانایی او",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "بر فعال ممکنه در جستجو",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "این بود کاستاده است ارض و سما",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "ز امر او بی اُستن و آلت بپا",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "وین ز قدرت های او یک قدرت است",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "حافظ هر ممکنی در نسبت است",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "پس بخواند چون شما را خواندنی",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "از زمین آیید بیرون هر تنی",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "أخْرُجواْ یا أیها الْموتَی تمام",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "از قبور آیید بیرون لاکلام",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    }
  ]
}
