  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "بسم االله الرحمن الرحیم",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "وَ اَلْعَصْرِ (۱) إِنَّ اَلْإِنْسٰانَ لَفِی خُسْرٍ (۲) إِلاَّ اَلَّذِینَ آمَنُوا وَ عَمِلُوا اَلصّٰالِحٰاتِ وَ تَوٰاصَوْا بِالْحَقِّ‌ وَ تَوٰاصَوْا بِالصَّبْرِ (۳)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "بنام خداوند بخشاینده مهربان",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Paragraph",
      "Text": "بطرف آخر روز (۱) بدرستی که انسان هر آینه در زیان کاریست (۲) مگر آنان که ایمان آوردند و کردند کارهای شایسته وصیت بیکدیگر نمودند براستی و وصیت نمودند بشکیبایی (۳)",
      "CoupletIndex": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "هم قسم بر عصر یعنی بر زمان",
