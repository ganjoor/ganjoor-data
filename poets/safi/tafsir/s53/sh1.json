  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "بسم االله الرحمن الرحیم",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "وَ اَلنَّجْمِ إِذٰا هَویٰ (۱) مٰا ضَلَّ صٰاحِبُکُمْ وَ مٰا غَویٰ (۲) وَ مٰا یَنْطِقُ عَنِ اَلْهَویٰ (۳) إِنْ هُوَ إِلاّٰ وَحْیٌ یُوحیٰ (۴)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "بنام خداوند بخشاینده مهربان",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Paragraph",
      "Text": "بستاره چون فرو شود (۱) یا بر آید یا فرو افتد که گمراه نشد صاحب شما و براه باطل نرفت (۲) و سخن نمی‌کند از خواهش نفس (۳) نیست آن مگر وحی که وحی کرده می‌شود (۴)",
      "CoupletIndex": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "می خورد سوگند علام الغیوب",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "بر ستاره چونکه بنماید غروب",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "وآن وجود کامل است اندر فنا",
