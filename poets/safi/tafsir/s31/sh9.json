      "Text": "یٰا أَیُّهَا اَلنّٰاسُ اِتَّقُوا رَبَّکُمْ وَ اِخْشَوْا یَوْماً لاٰ یَجْزِی وٰالِدٌ عَنْ وَلَدِهِ وَ لاٰ مَوْلُودٌ هُوَ جٰازٍ عَنْ وٰالِدِهِ شَیْئاً إِنَّ وَعْدَ اَللّٰهِ حَقٌّ فَلاٰ تَغُرَّنَّکُمُ اَلْحَیٰاةُ اَلدُّنْیٰا وَ لاٰ یَغُرَّنَّکُمْ بِاللّٰهِ اَلْغَرُورُ (۳۳) إِنَّ اَللّٰهَ عِنْدَهُ عِلْمُ اَلسّٰاعَةِ وَ یُنَزِّلُ اَلْغَیْثَ وَ یَعْلَمُ مٰا فِی اَلْأَرْحٰامِ وَ مٰا تَدْرِی نَفْسٌ مٰا ذٰا تَکْسِبُ غَداً وَ مٰا تَدْرِی نَفْسٌ بِأَیِّ أَرْضٍ تَمُوتُ إِنَّ اَللّٰهَ عَلِیمٌ خَبِیرٌ (۳۴)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "ای مردمان بپرهیزید از پروردگارتان و بترسید از روزی که کفایت نکند پدری از فرزندش و نه‌زاده شدۀ او کفایت‌کننده است از پدرش چیزی را بدرستی که وعدۀ خدا حق است پس نباید که فریب دهد شما را زندگانی دنیا و نباید که فریب دهد شما را بخدا آن فریب‌دهنده (۳۳) بدرستی که خدا نزد اوست علم قیامت و فرو می‌فرستد باران را و می‌داند آنچه در رحمهاست و نمی‌داند هیچ نفسی که چه کسب می‌کند فردا و نمی‌داند هیچ نفسی که بکدام زمین می‌میرد بدرستی که خداست دانای آگاه (۳۴)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ای گروه مردم از پروردگار",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "می بپرهیزید و ترسید آشکار",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "آن چنان روزی که والد از ولد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "دفع نکند هیچ چیزی کش رسد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "هم نه فرزند از پدر در رستخیز",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "می تواند مر قضاء کرد ایچ چیز",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "راست باشد در ثواب و در عِقاب",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "وعدة پروردگار اندر حساب",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "پس حیات دنیوی باید فریب",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "مر شما را ندهد از بهر ه و نصیب",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "هم نباید تا کند مغرورتان",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "دیو بفریبنده بر حق ناگهان",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "گفت مردی از عرب کز پنج چیز",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "ای پیمبر کن مرا آگاه نیز",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "کی مطر بارد، شود کی رستخیز",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "زن چه زاید گر که دانی از تمیز",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "هم مرا فردا چه فعلی ز اقتضاست",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "مدفنم دیگر بگو کآخر کجاست",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "آمد این آیت که باشد نزد حق",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "علم ساعت، علم بعد و ماسَبَق",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "می فرستد بارش او در هر مکان",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "وآنچه در ارحام باشد داند آن",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "می نداند نفس تا فردا چه چیز",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "می نماید کسب از وجه تمیز",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "هم نداند هیچ نفسی از عباد",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "هست موتش در چه ارضی از بلاد",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "حق بود دانا و آگاه از تمام",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "نیست چیزی خارج از علمش به نام",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    }
  ]
}
