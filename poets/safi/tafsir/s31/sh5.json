      "Text": "وَ إِذْ قٰالَ لُقْمٰانُ لاِبْنِهِ وَ هُوَ یَعِظُهُ یٰا بُنَیَّ لاٰ تُشْرِکْ بِاللّٰهِ إِنَّ اَلشِّرْکَ لَظُلْمٌ عَظِیمٌ (۱۳) وَ وَصَّیْنَا اَلْإِنْسٰانَ بِوٰالِدَیْهِ حَمَلَتْهُ أُمُّهُ وَهْناً عَلیٰ وَهْنٍ وَ فِصٰالُهُ فِی عٰامَیْنِ أَنِ اُشْکُرْ لِی وَ لِوٰالِدَیْکَ إِلَیَّ اَلْمَصِیرُ (۱۴) وَ إِنْ جٰاهَدٰاکَ عَلیٰ أَنْ تُشْرِکَ بِی مٰا لَیْسَ لَکَ بِهِ عِلْمٌ فَلاٰ تُطِعْهُمٰا وَ صٰاحِبْهُمٰا فِی اَلدُّنْیٰا مَعْرُوفاً وَ اِتَّبِعْ سَبِیلَ مَنْ أَنٰابَ إِلَیَّ ثُمَّ إِلَیَّ مَرْجِعُکُمْ فَأُنَبِّئُکُمْ بِمٰا کُنْتُمْ تَعْمَلُونَ (۱۵) یٰا بُنَیَّ إِنَّهٰا إِنْ تَکُ مِثْقٰالَ حَبَّةٍ مِنْ خَرْدَلٍ فَتَکُنْ فِی صَخْرَةٍ أَوْ فِی اَلسَّمٰاوٰاتِ أَوْ فِی اَلْأَرْضِ یَأْتِ بِهَا اَللّٰهُ إِنَّ اَللّٰهَ لَطِیفٌ خَبِیرٌ (۱۶) یٰا بُنَیَّ أَقِمِ اَلصَّلاٰةَ وَ أْمُرْ بِالْمَعْرُوفِ وَ اِنْهَ عَنِ اَلْمُنْکَرِ وَ اِصْبِرْ عَلیٰ مٰا أَصٰابَکَ إِنَّ ذٰلِکَ مِنْ عَزْمِ اَلْأُمُورِ (۱۷) وَ لاٰ تُصَعِّرْ خَدَّکَ لِلنّٰاسِ وَ لاٰ تَمْشِ فِی اَلْأَرْضِ مَرَحاً إِنَّ اَللّٰهَ لاٰ یُحِبُّ کُلَّ مُخْتٰالٍ فَخُورٍ (۱۸) وَ اِقْصِدْ فِی مَشْیِکَ وَ اُغْضُضْ مِنْ صَوْتِکَ إِنَّ أَنْکَرَ اَلْأَصْوٰاتِ لَصَوْتُ اَلْحَمِیرِ (۱۹)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "و هنگامی که گفت لقمان مر پسرش را و او پند می‌دادش ای پسرک من شرک میار بخدا بدرستی که شرک هر آینه ظلمی بزرگ (۱۳) و وصیت کردیم انسان را در باب خوبی کردن بوالدینش برداشت او را مادرش سست شدنی بر سست شدنی و بریدنش از شیر باشد در دو سال که شکر کن مر مرا و والدینت را بسوی من است بازگشت (۱۴) و اگر بگوشش خواهند که باز دارند ترا از آنکه شریک گردانی با من آنچه نیست ترا بآن دانش پس اطاعت مکن آن دو را و همراهی کن هر دو را در دنیا بخوبی و پیروی کن راه آنکه بازگشت کرد بسوی من پس بسوی منست بازگشت شما پس خبر دهم شما را بآنچه بودید که می‌کردید (۱۵) ای پسرک من بدرستی که آن اگر باشد مقدار دانه از خردل پس بوده باشد در گران سنگی یا در آسمانها یا در زمین می‌آرد آن را خدا بدرستی که خدا باریک بین آگاه است (۱۶) ای پسرک من بر پای دار نماز را و امر کن بمعروف و نهی کن از منکر و صبر کن بر آنچه رسید ترا بدرستی که آن از کارهائیست که سهل نباید انگاشت (۱۷) و مگردان بتکبر رویت را برای مردمان و راه مرو در زمین از روی افتخار بدرستی که خدا دوست نمی‌دارد خرامنده نازش دارنده را (۱۸) و میانه گزین در رفتارت و باز کم کن از آوازت بدرستی که ناخوش‌ترین آوازها هر آینه آواز خرانست (۱۹)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "« در بیان پند دادن لقمان(ع) مر پسر را »",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Right",
      "Text": "یاد کن چون گفت لقمان با پسر",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Left",
      "Text": "پند او می داد چون در خیر و شرّ",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "بر خدا تو شرک ناور یا بُنَی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "شرک چون ظلمی بزرگ آمد به وی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "هست این یک پند کافی گر یکی",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "باشد آگاه از معانی اندکی",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "هست هر چیز اندر این یک پند او",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "گر تویی در عقل، هم پیوند او",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Right",
      "Text": "هم وصیّت آدمی را ما به عین",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Left",
      "Text": "کرده ایم از نیکویی بر والدین",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "حمل کرد او را به شفقت مادرش",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "سستی ای بُد فوق سستی ز اخترش",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "باز بگرفتن ز شیر استش دو سال",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "شکر تا گویی مرا در کل حال",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "همچنین شکر پدر هم مادرت",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "سوی من برگشت باشد دیگرت",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "ور که بر شرکت به من کوشش کنند",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "آنچه را علمی بر آنت نیست چند",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "یعنی از تقلید نه از برهان تام",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "بل به نفی شرک، برهان شد تمام",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "پس مبر فرمانشان واندر جهان",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "باش با ایشان به صحبت رایگان",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "پیروی کن راه آن کس را به دین",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "کش بود برگشت سوی من یقین",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "او به توحید و به اخلاص عمل",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "باز بر حق گشته یعنی بی خلل",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "پس به من باشد شما را بازگشت",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "پس کنم آگاهتان از سرگذشت",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "زآنچه یعنی کرده اید اندر سند",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "در جهان با والدین از نیک و بد",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "از وصیّتهای لقمان بر پسر",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "حق تعالی می دهد دیگر خبر",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "ای پسر گر آدمی را در جهان",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "قدر خردل خصلتی باشد نهان",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "زیر سنگی در سماوات و زمین",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "آورد اندر حساب آن را یقین",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "زآنکه حق باریک دان است و خبیر",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "بر هر آن موجودی از بالا و زیر",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "دار در وقت ای پسر برپا نماز",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "کن به نیکی امر و از زشت احتراز",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "باش در رنج و مشقت ها صبور",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "إنَّ ذَلِکَ کُلَّ مِنْ عَزْمِ الْأمُور",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "یعنی اندر کارها عزم خداست",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "چاره نبود زآنچه در حکم قضاست",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "می مگردان روی خویش از مردمان",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "کاین است فعل اهل کبر اندر نشان",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "ره مرو در ارض از روی نشاط",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "شاد و بخرامنده یعنی ز انبساط",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "این نباشد جز که از عُجب و غرور",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "لَا یُحِب کُلَّ مُخْتَالٍ فَخُور",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "شو به رفتارت میان رو بر جمیع",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "در ره اعنی نه بطیء و نه سریع",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "صوت خود کوته کن و آور به زیر",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "أنکَرَ الْأصوَاتِ لَصَوتُ الْحَمِیر",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "صوت خر را چون که بردارد، شنو",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "کآن ز بهر شهوت است و کاه و جو",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    }
  ]
}
