      "Text": "أَ لَمْ تَرَوْا أَنَّ اَللّٰهَ سَخَّرَ لَکُمْ مٰا فِی اَلسَّمٰاوٰاتِ وَ مٰا فِی اَلْأَرْضِ وَ أَسْبَغَ عَلَیْکُمْ نِعَمَهُ ظٰاهِرَةً وَ بٰاطِنَةً وَ مِنَ اَلنّٰاسِ مَنْ یُجٰادِلُ فِی اَللّٰهِ بِغَیْرِ عِلْمٍ وَ لاٰ هُدیً وَ لاٰ کِتٰابٍ مُنِیرٍ (۲۰) وَ إِذٰا قِیلَ لَهُمُ اِتَّبِعُوا مٰا أَنْزَلَ اَللّٰهُ قٰالُوا بَلْ نَتَّبِعُ مٰا وَجَدْنٰا عَلَیْهِ آبٰاءَنٰا أَ وَ لَوْ کٰانَ اَلشَّیْطٰانُ یَدْعُوهُمْ إِلیٰ عَذٰابِ اَلسَّعِیرِ (۲۱) وَ مَنْ یُسْلِمْ وَجْهَهُ إِلَی اَللّٰهِ وَ هُوَ مُحْسِنٌ فَقَدِ اِسْتَمْسَکَ بِالْعُرْوَةِ اَلْوُثْقیٰ وَ إِلَی اَللّٰهِ عٰاقِبَةُ اَلْأُمُورِ (۲۲) وَ مَنْ کَفَرَ فَلاٰ یَحْزُنْکَ کُفْرُهُ إِلَیْنٰا مَرْجِعُهُمْ فَنُنَبِّئُهُمْ بِمٰا عَمِلُوا إِنَّ اَللّٰهَ عَلِیمٌ بِذٰاتِ اَلصُّدُورِ (۲۳) نُمَتِّعُهُمْ قَلِیلاً ثُمَّ نَضْطَرُّهُمْ إِلیٰ عَذٰابٍ غَلِیظٍ (۲۴)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "آیا ندید که خدا رام کرد برای شما آنچه در آسمانها و آنچه در زمین است و تمام گردانید بر شما نعمتهایش را ظاهری و باطنی و از مردمان کسی است که مجادله می‌کند در خدا بدون دانش و نه هدایتی و نه کتابی روشن کننده (۲۰) و چون گفته شود مر ایشان را که پیروی کنید آنچه فرو فرستاد خدا گویند بلکه پیروی می‌کنیم آنچه را یافتیم بر آن پدران خود را یاد اگر چه بوده باشد دیو رجیم که می‌خواند ایشان را بسوی عذاب آتش سوزان (۲۱) و کسی که باخلاص می‌آورد رویش را بسوی خدا و اوست نیکوکار پس بدرستی که چنگ در زد بدستگیره محکم و بسوی خداست انجام کارها (۲۲) و کسی که کفر ورزید پس نباید که غمگین سازد ترا کفرش بسوی ما بازگشت ایشان پس خبر خواهم داد ایشان را بآنچه کردند بدرستی که خدا داناست به سرّ این سینه‌ها (۲۳) کامیاب می‌گردانیمشان اندکی پس مجبور می‌سازیمشان بسوی عذاب سخت (۲۴)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "مردمان آیا نبینند اینکه رام",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "کرده از بهر شما ربّ الانام",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "آنچه باشد در سماوات و زمین",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "ز آفتاب و ماه و بحر و برّ چنین",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Paragraph",
      "Text": "« در بیان ذکر نعمتهای ظاهر و باطن خداوندی »",
      "CoupletIndex": 4
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "بر شما فرمود نعمت ها تمام",
      "CoupletIndex": 5,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "ظاهر و باطن به هر نام و مقام",
      "CoupletIndex": 5,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "نعمت ظاهر بود رزق و حیات",
      "CoupletIndex": 6,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "صحت و امنیّت و عیش و ثبات",
      "CoupletIndex": 6,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 12,
      "Position": "Right",
      "Text": "ملک و مال و خانه و جفت و ولد",
      "CoupletIndex": 7,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 13,
      "Position": "Left",
      "Text": "عزّت و آسودگی اندر بلد",
      "CoupletIndex": 7,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "نعمت باطن، کمال و عقل و دین",
      "CoupletIndex": 8,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "علم و ایمان و امانت با یقین",
      "CoupletIndex": 8,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "عدل و انصاف و مروت با عباد",
      "CoupletIndex": 9,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "جود و احسان، خُلق نیکو در نهاد",
      "CoupletIndex": 9,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "بهتر از هر خصلتی عشق خداست",
      "CoupletIndex": 10,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "کآن سرآمد بر تمام وصف هاست",
      "CoupletIndex": 10,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "عشق حق گر باشدت باقی بهل",
      "CoupletIndex": 11,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "که شود زو هر خصالی معتدل",
      "CoupletIndex": 11,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "بر عنایت وآن بود موقوف و بس",
      "CoupletIndex": 12,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "بخشد آن را گر خدا خواهد به کس",
      "CoupletIndex": 12,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "شرح این معنی برون است از بیان",
      "CoupletIndex": 13,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "گر بگویم سوزدم کلک و زبان",
      "CoupletIndex": 13,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "نک شنو تفسیر جای خود ز عشق",
      "CoupletIndex": 14,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "گویمت بر مدعای خود ز عشق",
      "CoupletIndex": 14,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "باشد از مردم کسی کو در مقال",
      "CoupletIndex": 15,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "می نماید در کتاب حق جدال",
      "CoupletIndex": 15,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "بی ز دانش کز دلیلی مستفاد",
      "CoupletIndex": 16,
      "SectionIndex1": 1,
      "SectionIndex2": 14
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "باشد آن وز رهنمایی ذی رشاد",
      "CoupletIndex": 16,
      "SectionIndex1": 1,
      "SectionIndex2": 14
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "هم نه از روی کتاب روشنی",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 15
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "بل به محض جهل و تقلید و فنی",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 15
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "پیروی گویندشان چون خود کنید",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 16
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "زآنچه بفرستاده خلاّق مجید",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 16
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "پیروی گویند بل ز آباء کنیم",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 17
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "زآنچه ایشان را بر آن ما یافتیم",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 17
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "دیو آیا خواند ایشان را اگر",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 18
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "بر عذاب دوزخ و نار سقر",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 18
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "پیروی آیا مر ایشان را رواست",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 19
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "زآنچه آن مبنی به تقلید و هواست",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 19
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "وآنکه امر خود نماید واگذار",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 20
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "از ره تسلیم بر پروردگار",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 20
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "وآنگهی نیکو بود کردار او",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 21
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "هم نکو در راه دین رفتار او",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 21
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "پس زده چنگ او به دستاویز سخت",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 22
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "از عنایت باشد این یا حُسن بخت",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 22
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "کارها انجام آن سوی خداست",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 23
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "ختم بر وی قبل و بعد ماسواست",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 23
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "وآنکه کافر شد مباد اندُه خوری",
      "CoupletIndex": 26,
      "SectionIndex1": 1,
      "SectionIndex2": 24
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "تو ز کفرش گر نماید کافری",
      "CoupletIndex": 26,
      "SectionIndex1": 1,
      "SectionIndex2": 24
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "سوی ما خواهند کردن بازگشت",
      "CoupletIndex": 27,
      "SectionIndex1": 1,
      "SectionIndex2": 25
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "پس خبرشان بدهم از آنچه گذشت",
      "CoupletIndex": 27,
      "SectionIndex1": 1,
      "SectionIndex2": 25
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "بر هر آنچه کرده اند اعنی جزاء",
      "CoupletIndex": 28,
      "SectionIndex1": 1,
      "SectionIndex2": 26
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "بدهم ایشان را به وجه اقتضاء",
      "CoupletIndex": 28,
      "SectionIndex1": 1,
      "SectionIndex2": 26
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "زآنکه حق داناست بر سرّ صدور",
      "CoupletIndex": 29,
      "SectionIndex1": 1,
      "SectionIndex2": 27
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "تا چه اندر سینه ها دارد خطور",
      "CoupletIndex": 29,
      "SectionIndex1": 1,
      "SectionIndex2": 27
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "از جهان بدهیمشان بهره قلیل",
      "CoupletIndex": 30,
      "SectionIndex1": 1,
      "SectionIndex2": 28
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "بازشان سازیم مضطر در سبیل",
      "CoupletIndex": 30,
      "SectionIndex1": 1,
      "SectionIndex2": 28
    },
    {
      "VOrder": 60,
      "Position": "Right",
      "Text": "بر عذابی بس غلیظ اعنی گران",
      "CoupletIndex": 31,
      "SectionIndex1": 1,
      "SectionIndex2": 29
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "همچو جرم ثقلها اندر نشان",
      "CoupletIndex": 31,
      "SectionIndex1": 1,
      "SectionIndex2": 29
    }
  ]
}
