  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "بسم االله الرحمن الرحیم",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "الم (۱) تِلْکَ آیٰاتُ اَلْکِتٰابِ اَلْحَکِیمِ (۲) هُدیً وَ رَحْمَةً لِلْمُحْسِنِینَ (۳) اَلَّذِینَ یُقِیمُونَ اَلصَّلاٰةَ وَ یُؤْتُونَ اَلزَّکٰاةَ وَ هُمْ بِالْآخِرَةِ هُمْ یُوقِنُونَ (۴) أُولٰئِکَ عَلیٰ هُدیً مِنْ رَبِّهِمْ وَ أُولٰئِکَ هُمُ اَلْمُفْلِحُونَ (۵)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "بنام خدای بخشندۀ مهربان",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Paragraph",
      "Text": "الم (۱) اینست آیتهای آن کتاب محکم (۲) هدایت و رحمت از برای نیکوکاران (۳) آنان که بر پای می‌دارند نماز را و می‌دهند زکات را و ایشان بآخرت ایشانند که یقین می‌کنند (۴) آنانند بر هدایت از پروردگارشان و آنها ایشانند رستگاران (۵)",
      "CoupletIndex": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "از الف وز لام و میم آن ذوالمنن",
