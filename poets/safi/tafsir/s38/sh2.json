    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "وَ اِنْطَلَقَ اَلْمَلَأُ مِنْهُمْ أَنِ اِمْشُوا وَ اِصْبِرُوا عَلیٰ آلِهَتِکُمْ إِنَّ هٰذٰا لَشَیْ‌ءٌ یُرٰادُ (۶) مٰا سَمِعْنٰا بِهٰذٰا فِی اَلْمِلَّةِ اَلْآخِرَةِ إِنْ هٰذٰا إِلاَّ اِخْتِلاٰقٌ (۷) أَ أُنْزِلَ عَلَیْهِ اَلذِّکْرُ مِنْ بَیْنِنٰا بَلْ هُمْ فِی شَکٍّ مِنْ ذِکْرِی بَلْ لَمّٰا یَذُوقُوا عَذٰابِ (۸) أَمْ عِنْدَهُمْ خَزٰائِنُ رَحْمَةِ رَبِّکَ اَلْعَزِیزِ اَلْوَهّٰابِ (۹) أَمْ لَهُمْ مُلْکُ اَلسَّمٰاوٰاتِ وَ اَلْأَرْضِ وَ مٰا بَیْنَهُمٰا فَلْیَرْتَقُوا فِی اَلْأَسْبٰابِ (۱۰) جُنْدٌ مٰا هُنٰالِکَ مَهْزُومٌ مِنَ اَلْأَحْزٰابِ (۱۱) کَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍ وَ عٰادٌ وَ فِرْعَوْنُ ذُو اَلْأَوْتٰادِ (۱۲) وَ ثَمُودُ وَ قَوْمُ لُوطٍ وَ أَصْحٰابُ اَلْأَیْکَةِ أُولٰئِکَ اَلْأَحْزٰابُ (۱۳) إِنْ کُلٌّ إِلاّٰ کَذَّبَ اَلرُّسُلَ فَحَقَّ عِقٰابِ (۱۴) وَ مٰا یَنْظُرُ هٰؤُلاٰءِ إِلاّٰ صَیْحَةً وٰاحِدَةً مٰا لَهٰا مِنْ فَوٰاقٍ (۱۵) وَ قٰالُوا رَبَّنٰا عَجِّلْ لَنٰا قِطَّنٰا قَبْلَ یَوْمِ اَلْحِسٰابِ (۱۶)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "و رفتند آن جمع از ایشان که بروید و شکیبایی ورزید بر الهانتان بدرستی که هر آینه چیزیست که خواسته می‌شود (۶) نشنیدیم ما این را در کیش آخرین نیست این جز دروغ ساختنی (۷) آیا فرو فرستاده شد بر او ذکر از میان ما بلکه ایشانند در شک از ذکر من بلکه هنوز نچشیده‌اند عذاب مرا (۸) آیا نزد ایشانست خزاین رحمت پروردگارت که غالب بخشاینده است (۹) آیا مر ایشان‌راست پادشاهی آسمانها و زمین و آنچه میان آنهاست پس باید که بالا روند در سببها (۱۰) لشکری‌اند آنجا شکسته شده از طایفه‌های دشمن (۱۱) تکذیب کردند پیش از ایشان قوم نوح و عاد و فرعون صاحب میخها (۱۲) و ثمود و قوم لوط و اهل ای که آنها بودند طایفه‌های دشمن (۱۳) نبودند همه جز که تکذیب نمودند رسولان را پس لازم شد عقوبت من (۱۴) و انتظار نمی‌برند آنها جز فریادی واحد که نیست مر آن را هیچ زیستنی (۱۵) و گفتند پروردگار ما زود بده مر ما را حصه ما را پیش از روز شمار (۱۶)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "پس روان گشتند و گفتند از غلو",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "بر خدایانتان أنِ امشُواْ وَاصبِرُواْ",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "این است چیزی حادث و آراسته",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "بهر ما دهر این نوائب خواسته",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "یا بود مقصود از شَیء یُرَاد",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "اینکه او دارد اراده بر فساد",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "ما ز ملتها بنَشنیدیم این",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "در بیان حتی ز دین آخرین",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "دین عیسی هم که آخر ملت است",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "بر ثلاثه نی به وحدانیّت است",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "نیست این توحید کو د ریافته",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "جز که از پیش خود آن بر بافته",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "گشته قرآن نازل اندر جستجو",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "از میان ما قریش آیا بر او",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "زآنکه خود را از شرف که داشتند",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "اشرف از وی باز می پنداشتند",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "پس کتاب ار می شدی نازل ز حق",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "از چه بر اشرف نیامد زین فرق",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "بل نه آن باشد که گویند از ستم",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "که محمّد (ص) بافته است آن را به هم",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "بلکه در شکّند ایشان از کتاب",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "اینکه باشد از من آن وحی و خطاب",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "غالباً باشد ز حقد انکارشان",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "وز خلاف معتقد گفتارشان",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "نی چشیدستند بل ایشان هنوز",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "آن عذاب من که باشد کفر سوز",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "نزد ایشان است آیا برقرار",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "مخزن بخشایش پروردگار",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "آن خدای غالب بخشنده، کو",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "هر چه خواهد، هر که را بخشد نکو",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "یا که شاهیِ زمین و آسمان",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "وآنچه مابین است باشد زین کسان",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "پس بیاید تا به بالا بر روند",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "در معارج تا به عرش اندر شوند",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "نظم عالم تا دهند ایشان ز کل",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "وحی بفرستند و آیات و رسل",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "وآنکه ایشانند جُندی بی ز قدر",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "منهدم، بشکسته ایشان روز بدر",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "از قبیل آن گُره که بی درنگ",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "با رسولان خدا کردند جنگ",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "نیست این تکذیب مخصوص توهین",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "پیش هم کردند تکذیب این چنین",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "قوم نوح و عاد و فرعون، آنکه بود",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "صاحب اوتاد، هم قوم ثمود",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "قوم لوط اصحاب ایکه از خبر",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "می نبودند آن جماعت سر به سر",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "جز که می کردند تکذیب رسل",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "زآن معذّب آمدند از جزء و کل",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "بر سزایش بود ایشان را عِقاب",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "گشت واجب بهرشان از ما عذاب",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "این جماعت هیچ نکشند انتظار",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "جز که یک فریاد را بر انحصار",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "نیست آن ی ک صیحه را هیچ از فَوَاق",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "واقع آ ن البته گردد در سیاق",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "گفته بود آن شه که مشرک را دهند",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "نامه اش بر دست چپ ناسودمند",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "قوم گفتی رَبنَا عَجِّل لَّنَا",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "قِطَّنَا قَبلَ الْحِسَاب اندر بنا",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "ای خدا بشتاب اندر آن وعید",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "که دهد بر ما محمّد (ص) بر شدید",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    }
  ]
