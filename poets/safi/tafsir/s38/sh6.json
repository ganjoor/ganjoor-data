    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "هم بُرید از جمله گردن در مقام",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "کرد قربان اسبها را بالتمام",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "بعض را باشد بر این فعل اعتراض",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "کز چه کُشت او بی زبانان ز انقباض",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "گر تصدّق کرده باشد او خیول",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "نیست بحثی وارد او را در اصول",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "دوست تر چون بوده اسبان نزد او",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "کرد آنها را تصدّق بی غلو",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "فرقه ای گویند هم ز ارباب لب",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "داغ کرد او پا و گردنشان ز حب",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "گفته بعضی شمس را او کرد رد",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "تا به وقت آرد بجا طاعات خود",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "داند این را هم خدا کو قادر است",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "شمس بر تعظیم امرش حاضر است",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "گفته اند اهل روایات این کلام",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "که سلیمان داشت صد زن در مقام",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "گفت خواهم ز اختلاط این زنان",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "صد پسر بدهد مرا حق یک زمان",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "تا به راه حق کنند ایشان جهاد",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "پس نیاورد ایچ استثنا به یاد",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "پس نگشت آبستن از آنها به ساز",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "جز یکی کآورد طفل مرده باز",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "گفت زآن رو حق تعالی کآن چنان",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "ما سلیمان را نمودیم امتحان",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "برفکندیم آن جسد بر تخت او",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "گشت پس باز او به حق و آورد رو",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "آن پسر یا بوده بر سن شباب",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "از فُجاء مُرد او به تخت آن جناب",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "قصۀ انگشتر و دیو آنچه هست",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "که مهی عفریت بر جایش نشست",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "قصه های قصه خوانان است و بس",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "آن نگوید جز که دیوی پر هوس",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "حاصل آنکه امتحان شد در بلا",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "اصل و علت جمله را داند خدا",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    }
  ]
}
