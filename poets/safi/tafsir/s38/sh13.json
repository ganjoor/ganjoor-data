      "Text": "قٰالَ یٰا إِبْلِیسُ مٰا مَنَعَکَ أَنْ تَسْجُدَ لِمٰا خَلَقْتُ بِیَدَیَّ أَسْتَکْبَرْتَ أَمْ کُنْتَ مِنَ اَلْعٰالِینَ (۷۵) قٰالَ أَنَا خَیْرٌ مِنْهُ خَلَقْتَنِی مِنْ نٰارٍ وَ خَلَقْتَهُ مِنْ طِینٍ (۷۶) قٰالَ فَاخْرُجْ مِنْهٰا فَإِنَّکَ رَجِیمٌ (۷۷) وَ إِنَّ عَلَیْکَ لَعْنَتِی إِلیٰ یَوْمِ اَلدِّینِ (۷۸) قٰالَ رَبِّ فَأَنْظِرْنِی إِلیٰ یَوْمِ یُبْعَثُونَ (۷۹) قٰالَ فَإِنَّکَ مِنَ اَلْمُنْظَرِینَ (۸۰) إِلیٰ یَوْمِ اَلْوَقْتِ اَلْمَعْلُومِ (۸۱) قٰالَ فَبِعِزَّتِکَ لَأُغْوِیَنَّهُمْ أَجْمَعِینَ (۸۲) إِلاّٰ عِبٰادَکَ مِنْهُمُ اَلْمُخْلَصِینَ (۸۳) قٰالَ فَالْحَقُّ وَ اَلْحَقَّ أَقُولُ (۸۴) لَأَمْلَأَنَّ جَهَنَّمَ مِنْکَ وَ مِمَّنْ تَبِعَکَ مِنْهُمْ أَجْمَعِینَ (۸۵) قُلْ مٰا أَسْئَلُکُمْ عَلَیْهِ مِنْ أَجْرٍ وَ مٰا أَنَا مِنَ اَلْمُتَکَلِّفِینَ (۸۶) إِنْ هُوَ إِلاّٰ ذِکْرٌ لِلْعٰالَمِینَ (۸۷) وَ لَتَعْلَمُنَّ نَبَأَهُ بَعْدَ حِینٍ (۸۸)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "گفت ای ابلیس چه باز داشت ترا از آنکه سجده کنی مر آنچه را آفریدم بدو دست قدرتم تکبر کردی یا بودی از بلندمرتبگان (۷۵) گفت من بهترم از او آفریدی مرا از آتش و آفریدی او را از گل (۷۶) گفت پس بیرون رو از آن پس بدرستی که تویی رانده شده (۷۷) و بدرستی که بر تو است لعنت من تا روز جزا (۷۸) گفت پروردگار من پس مهلت ده مرا تا روزی که برانگیخته شوند (۷۹) گفت پس بدرستی که تویی از مهلت داده‌شدگان (۸۰) تا روزان وقت معلوم (۸۱) گفت پس بعزت تو که هر آینه گمراه خواهم کرد ایشان را همه (۸۲) جز بندگان ترا از ایشان که خالص‌کرده‌شدگانند (۸۳) گفت پس درست است و راستست می‌گویم (۸۴) که هر آینه پر خواهم کرد دوزخ را از تو و از کسی که پیروی کند ترا از ایشان همگی (۸۵) بگو نمی‌خواهم از شما بر آن هیچ مزدی و نیستم من از بر خود بستگان (۸۶) نیست آن مگر پندی مر جهانیان را (۸۷) و هر آینه خواهید دانست خبرش را پس از هنگامی (۸۸)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "گفت حقش کای بلیس از سجده باز",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "کرد چه منعت که ناوردی نیاز",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "آنچه را که آفریدم محض خیر",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "خود به دست قدرتم بی ربط غیر",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "کردی استکبار، آیا سر شدی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "خویش راجح یافتی کافر شدی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "یا ز عالینی که محو آن فرقه اند",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "اندر انوار جمالم غرقه اند",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "بی خبر باشند از خود در شهود",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "نیست تکلیفی بر ایشان در سجود",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "آن گروه از رتبه ها عالیستند",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "از عقول و از ملایک نیستند",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "این دم استکبار کردی یا ز پیش",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "بودی از مستکبران از ظنّ خویش",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "گفت زو من بهتر اندر خلقتم",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "غالب اندر لطف و نورانیّتم",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "من ز آتش گشته ام خلق، او ز طین",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "خود تو ما را آفریدی این چنین",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "اول تفسیر این تحقیق را",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "کرده ام رو در نگر توفیق را",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "گفت شو دور از بهشت و آسمان",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "یا از آن خلقت که فخرت بُد بدان",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "زآنکه تو از راندگان حضرتی",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "مانده از اقبال و دور از رحمتی",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "بر تو باشد لعنتم تا یوم دین",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "پس چو شد مردود ربّ العالمین",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "گفت ای پروردگار از نیّتم",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "تا به یَومِ یُبعَثُون ده مهلتم",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "گفت حق باشی تو پس از منظرین",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "تا به یوم وقت معلوم از یقین",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "گفت پس بر عزّتت بی اشتباه",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "می برم اولاد آدم را ز راه",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "جز عباد تو ز فرزندان او",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "که ز شرک و رجس پاکند و نکو",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "یعنی آنانکه به وصف عصمتند",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "از قبایح در پناه حضرتند",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "گفت حق فَالْحَقُّ وَالْحَقَّ أقُول",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "از تو دوزخ را کنم پر بی نکول",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "یعنی از جنس تو و آنان کز انام",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "پیروت باشند ایشان بالتمام",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "ای محمّد (ص) گو به اهل مکه من",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "از شما مزدی نخواهم زین سخن",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "هم نی ام من آنکه چیزی را به خویش",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "بر تکلّف بندم از اندازه بیش",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "چون کسانی کز تصنع می کنند",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "ظاهر از خود آنچه را در آن نیند",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "نیست قرآن جز که پندی از خدا",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "بر تمام جن و انس اندر هدا",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "این خبر را می بدانید از یقین",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "یعنی این گفتار قرآن بَعدَ حِین",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "یعنی اندر وقت موت و روز حشر",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "یا ظهور دین حق یعنی که بدر",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "زندگان و مردگان بی امتناع",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "زین خبر یابند جمله اطلاع",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "زندگان از ذوالفقار جان شکر",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "مردگان از قهر خلاّق البشر",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    }
  ]
}
