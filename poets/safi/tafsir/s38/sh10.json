      "Position": "Left",
      "Text": "که شدیم اینسان ز اضلالش به تاب",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "این چنین گویند با هم در مقال",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "چیست ما را که نبینیم آن رجال",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "که ز اشرار آن کسان را در جهان",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "می شمردیم و نمی بود آن چنان",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "می گرفتیم آن کسان را ریشخند",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "نیستند آیا به دوزخ در گزند",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "یا از ایشان کرده میل آن دیده ها",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "که نبینیم ایچ یک را ما به جا",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "یا بود قصد اینکه نفکندیم چشم",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "سوی ایشان از تکبّر یا که خشم",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "پس به تحقیق و یقین از اضطرار",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "ذَلِکَ لَحَقٌّ تَخَاصُمُ أهلِ نَّار",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    }
  ]
}
