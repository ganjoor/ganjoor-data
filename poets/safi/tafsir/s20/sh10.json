      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "گفت قوم آیند اینک بر اثر",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "من شدم بهر رضایت پیشتر",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "مر که این تعجیل در راه طلب",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "زود بر خوشنودیت گردد سبب",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "سرعت اندر امتثال امر دوست",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "موجب خوشنودی و تعظیم اوست",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "گفت پس در فتنه افکندیم ما",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "بعد بیرون رفتنت قوم تو را",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "یعنی ایشان را نمودیم امتحان",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "طاعت گوساله را بر ناگهان",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "سامری آن جمله را گمراه کرد",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "جز قلیلی را از آن مردان مرد",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "شرح گاو و سامری را در فساد",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "گفته ایم از پیش گر داری به یاد",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "گشت پس موسی به سوی قوم باز",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "خشمناک، اندوهگین، با احتراز",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "بیشتر اندوه او زین که مباد",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "باز ناگردند قوم از ارتداد",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "قوم را گفت از ملامت وز عتاب",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "بر خطاء رفتید آیا از صواب",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "وعده آیا بر شما پروردگار",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "می نداد از نیکویی ها بی شمار",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "وعدة حق ور ندیدید از شهود",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "راست بود و هم وفاء بر آن نمود",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "شد دراز آیا زمانم بر شما",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "زآنچه دادم وعده از صدق و صفا",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "گشت یعنی بیشتر از اربعین",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "که شما را وعده دادم من بر این",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "بر شما یا خواستید آید فرود",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "خشم حق زین فعل زشت بد نمود",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "پس شما کردید بر وعدم خلاف",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "اندر افکندید در قوم اختلاف",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "عابدان عجل گفتند از قرار",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "خلف وعده بُد نه از ما ز اختیار",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "لیک چون برداشتیم از قبطیان",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "وقت بیرون آمدن باری گران",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "زآنچه بگرفتیم ما بر عاریت",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "از حلل ز ایشان به اخذ اندر نیت",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "پس درافکندیم اندر آتش آن",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "سامری پس هم فکند آن را عیان",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "بهر ایشان پس برون آورد او",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "کالبد کو راست صوتی در گلو",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "پس بگفتند این خداوند شماست",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "هم خدای موسی صاحب عصاست",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 60,
      "Position": "Right",
      "Text": "کرد موسی پس فراموش او ز رب",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "رفت سوی طور او را در طلب",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 62,
      "Position": "Right",
      "Text": "گشت یعنی گمره و رفت از خطا",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "از خدای خویش بر دیگر خدا",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 64,
      "Position": "Right",
      "Text": "عابدان عِجل را پس ذوالجلال",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 65,
      "Position": "Left",
      "Text": "حجتی آورده لازم در مقال",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 66,
      "Position": "Right",
      "Text": "پس نمی بینید آیا در خطاب",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 67,
      "Position": "Left",
      "Text": "سویشان راجع نگردد زو جواب",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 68,
      "Position": "Right",
      "Text": "نیست مالک ضرّ و نفعی را به جا",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 69,
      "Position": "Left",
      "Text": "میپرستند از چه پس گوساله را",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    }
  ]
}
