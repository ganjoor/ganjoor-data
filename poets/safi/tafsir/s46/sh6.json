      "Text": "وَ لَقَدْ مَکَّنّٰاهُمْ فِیمٰا إِنْ مَکَّنّٰاکُمْ فِیهِ وَ جَعَلْنٰا لَهُمْ سَمْعاً وَ أَبْصٰاراً وَ أَفْئِدَةً فَمٰا أَغْنیٰ عَنْهُمْ سَمْعُهُمْ وَ لاٰ أَبْصٰارُهُمْ وَ لاٰ أَفْئِدَتُهُمْ مِنْ شَیْ‌ءٍ إِذْ کٰانُوا یَجْحَدُونَ بِآیٰاتِ اَللّٰهِ وَ حٰاقَ بِهِمْ مٰا کٰانُوا بِهِ یَسْتَهْزِؤُنَ (۲۶) وَ لَقَدْ أَهْلَکْنٰا مٰا حَوْلَکُمْ مِنَ اَلْقُریٰ وَ صَرَّفْنَا اَلْآیٰاتِ لَعَلَّهُمْ یَرْجِعُونَ (۲۷) فَلَوْ لاٰ نَصَرَهُمُ اَلَّذِینَ اِتَّخَذُوا مِنْ دُونِ اَللّٰهِ قُرْبٰاناً آلِهَةً بَلْ ضَلُّوا عَنْهُمْ وَ ذٰلِکَ إِفْکُهُمْ وَ مٰا کٰانُوا یَفْتَرُونَ (۲۸)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "و بحقیقت تمکن دادیم ایشان را در آنچه تمکن ندادیم شما را در آن و گردانیدیم مر ایشان را کوش و دیدها و دلها پس کفایت نکرد از ایشان گوششان و نه چشمهاشان و نه دلهاشان هیچ چیز چون بودند که انکار می‌ورزیدند بآیتهای خدا و احاطه کرد بایشان آنچه بودند که بآن استهزا می‌کردند (۲۶) و بتحقیق هلاک گردانیدیم آنچه را پیرامون شماست از قریه‌ها و مکرر آوردیم آیتها را باشد که ایشان بازگشت کنند (۲۷) پس چرا یاری نکردند ایشان را آنان که گرفتند از غیر خدا وسیله تقرب که الهانند بلکه کم شدند از ایشان و اینست دروغشان و آنچه را بودند که برمی‌بافتند (۲۸)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ما ندادیم آن تمکن بر شما",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "که به قوم عاد خود دادیم ما",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "گوش و چشم و قلب گرداندیمشان",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "تا ببینند و بیابند از نشان",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "چشم و گوش و قلب ز ایشان پس نداشت",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "باز چیزی زآنچه بر ایشان گماشت",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "دفع ز ایشان می نکرد اعنی عذاب",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "بودشان بر لغو اعضاء در ذهاب",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "بود بر تقلید قول و کارشان",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "هم به آیات خدا انکارشان",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "هم به گِرد آورد ایشان را عیان",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "آنچه می کردند استهزاء به آن",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "وآنچه گرداگردشان بود از قری",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "ما تبه کردیمشان ملک و سرای",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "ما به جد گردانده بودیم از رشد",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "اندر ایشان جمله آیت های خود",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "تا مگر گردند باز از کفر خویش",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "رو کنند از گمرهی بر دین و کیش",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "نصرت ایشان را نکردند از چه پس",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "آنکه می بگرفته بودند از هوس",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "دون حق بهر تقرّب بر خدا",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "خود اِلهان دگر محض هوی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "بلکه گم گشتند ز ایشان بر شتاب",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "وقت محنت یعنی انزال عذاب",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "وین دروغی بود ز ایشان و اجتراء",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "آنچه می کردند بر آن افتراء",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "یعنی آنکه ما تقرّب سوی حق",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "زین بتان جوییم خود از ماخَلَق",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    }
  ]
}
