  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "وَ إِذْ صَرَفْنٰا إِلَیْکَ نَفَراً مِنَ اَلْجِنِّ یَسْتَمِعُونَ اَلْقُرْآنَ فَلَمّٰا حَضَرُوهُ قٰالُوا أَنْصِتُوا فَلَمّٰا قُضِیَ وَلَّوْا إِلیٰ قَوْمِهِمْ مُنْذِرِینَ (۲۹) قٰالُوا یٰا قَوْمَنٰا إِنّٰا سَمِعْنٰا کِتٰاباً أُنْزِلَ مِنْ بَعْدِ مُوسیٰ مُصَدِّقاً لِمٰا بَیْنَ یَدَیْهِ یَهْدِی إِلَی اَلْحَقِّ وَ إِلیٰ طَرِیقٍ مُسْتَقِیمٍ (۳۰) یٰا قَوْمَنٰا أَجِیبُوا دٰاعِیَ اَللّٰهِ وَ آمِنُوا بِهِ یَغْفِرْ لَکُمْ مِنْ ذُنُوبِکُمْ وَ یُجِرْکُمْ مِنْ عَذٰابٍ أَلِیمٍ (۳۱) وَ مَنْ لاٰ یُجِبْ دٰاعِیَ اَللّٰهِ فَلَیْسَ بِمُعْجِزٍ فِی اَلْأَرْضِ وَ لَیْسَ لَهُ مِنْ دُونِهِ أَوْلِیٰاءُ أُولٰئِکَ فِی ضَلاٰلٍ مُبِینٍ (۳۲)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "و هنگامی که گردانیدیم بسوی تو جماعتی را از جن که می‌شنیدند قرآن را پس چون حاضر شدند آن را گفتند خاموش باشید پس چون گذارده شد برگشتند بسوی قومشان بیم‌کنندگان (۲۹) گفتند ای قوم ما بدرستی که ما شنیدیم کتابی را که فرو فرستاده شد از موسی تصدیق‌کننده مر آنچه را باشد میانه دو دستش هدایت می‌کند بسوی حق و براه راست (۳۰) ای قوم ما اجابت کنید خواننده خدا را و ایمان آورید باو تا بیامرزد شما را از گناهانتان و برهاند شما را از عذاب پر درد (۳۱) و آنکه اجابت نکند خوانندۀ خدا را پس نیست عاجزکننده در زمین و نیست مر او را از جز او یاوران آنهااند در گمراهی آشکار (۳۲)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "« در بیان آنکه وجود جن به نصّ قرآن ثابت است اما نه به قسمی که شیادان گویند و عوام الناس اعتقاد کرده اند »",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Right",
      "Text": "یاد کن کردیم سویت منصرف",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Left",
      "Text": "چونکه قومی را ز جن هم معترف",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "هست در تحقیقِ جن، بس گفتگو",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "نیست حاجت لیک بر تحقیق او",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "نصّ بود مکفی ز تأویل حکیم",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "هم ندارد زآن اِباء عقل سلیم",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "دیده اند ارباب کشف اندر شهود",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "هم به نصّ انبیاء دارد وجود",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Right",
      "Text": "با وجود نصّ و گفتار وفی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Left",
      "Text": "نیست لازم ذکر قول فلسفی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "خلق اشیاء کرده آن کو خود تمام",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "هم خبر داده است از جن در کلام",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "ای بسا محسوس کاندر موردش",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "نیست کس زو مطلع جز موجدش",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "تا چه جای شیء نامحسوس کآن",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "ناید اندر دید کس فاش و عیان",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "لیک عاقل زین بیان اندیشه کرد",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "که توان جن را کس اندر شیشه کرد",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "یا کسی بهر فریب عامه اش",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "رام سازد در طلسم و نامه اش",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "محترق یا عنصرش ز آتش کند",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "تا چو مصروعش ببیند غش کند",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "با عزایم یا کسی خواند برش",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "یا به قاروره کند خاکسترش",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "یا که سنگ اندازد اندر خانه ای",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "این تو گر باور کنی دیوانه ای",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "جنی است آن کس که گوید از شگفت",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "آن فلان مجنون به شیشه جن گرفت",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "گیردش جن کز خرد معذور ماند",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "وز نشان آدمیّت دور ماند",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "شرح آیت گو که ماندیم از کلام",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "نیست سود از ذکر مجنونان خام",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "ای پیمبر یاد کن سوی تو میل",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "جنّیان را داد حق چون وقت لیل",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "چونکه قرآن را نمودند استماع",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "حاضر آن ساعت شدندت بی صداع",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "یکدگر را پس بگفتند أنصِتُواْ",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "بشنوید اندر خموشی صوت او",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "واگذارید این هجوم و همهمه",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "قول حق است این نیوشید آن همه",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "حق سخن گوید کنون بدهید گوش",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "جن و انس این نشنود الاّ به هوش",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "پس چو قرآن خوانده شد مؤمن شدند",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "منذرین بر قوم خویش از جن شدند",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "باز چون گشتند گفتند از شتاب",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "ای گروه جن شنیدیم آن کتاب",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "که پس از موسی ز حق نازل شده",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "حکم سابق را مصدّق آمده",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "آنچه زو بوده است پیش از جزء و کل",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "مر مصدّق از کتاب و از رسل",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "سوی حق از لفظ و معنی رهنماست",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "بر صراط مستقیم و راه راست",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "ای گروه ما أجِیبُواْ بالقبول",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "داعی حق را که آن باشد رسول",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "آورید ایمان به وی و اذعان کنید",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "طاعت و تصدیق او از جان کنید",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 60,
      "Position": "Right",
      "Text": "تا حق آمرزد گناهان شما",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "هم رهاند از عذاب پر عنا",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 62,
      "Position": "Right",
      "Text": "داعی حق را اجابت هر نکرد",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "حق تعالی را از این مضطر نکرد",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 64,
      "Position": "Right",
      "Text": "نیست او عاجز کنندة حق یقین",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 65,
      "Position": "Left",
      "Text": "نی پناهی از عذابش در زمین",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 66,
