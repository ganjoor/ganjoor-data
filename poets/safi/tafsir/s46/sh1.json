      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "حم (۱) تَنْزِیلُ اَلْکِتٰابِ مِنَ اَللّٰهِ اَلْعَزِیزِ اَلْحَکِیمِ (۲) مٰا خَلَقْنَا اَلسَّمٰاوٰاتِ وَ اَلْأَرْضَ وَ مٰا بَیْنَهُمٰا إِلاّٰ بِالْحَقِّ وَ أَجَلٍ مُسَمًّی وَ اَلَّذِینَ کَفَرُوا عَمّٰا أُنْذِرُوا مُعْرِضُونَ (۳) قُلْ أَ رَأَیْتُمْ مٰا تَدْعُونَ مِنْ دُونِ اَللّٰهِ أَرُونِی مٰا ذٰا خَلَقُوا مِنَ اَلْأَرْضِ أَمْ لَهُمْ شِرْکٌ فِی اَلسَّمٰاوٰاتِ اِئْتُونِی بِکِتٰابٍ مِنْ قَبْلِ هٰذٰا أَوْ أَثٰارَةٍ مِنْ عِلْمٍ إِنْ کُنْتُمْ صٰادِقِینَ (۴) وَ مَنْ أَضَلُّ مِمَّنْ یَدْعُوا مِنْ دُونِ اَللّٰهِ مَنْ لاٰ یَسْتَجِیبُ لَهُ‌ إِلیٰ یَوْمِ اَلْقِیٰامَةِ وَ هُمْ عَنْ دُعٰائِهِمْ غٰافِلُونَ (۵) وَ إِذٰا حُشِرَ اَلنّٰاسُ کٰانُوا لَهُمْ أَعْدٰاءً وَ کٰانُوا بِعِبٰادَتِهِمْ کٰافِرِینَ (۶) وَ إِذٰا تُتْلیٰ عَلَیْهِمْ آیٰاتُنٰا بَیِّنٰاتٍ قٰالَ اَلَّذِینَ کَفَرُوا لِلْحَقِّ لَمّٰا جٰاءَهُمْ هٰذٰا سِحْرٌ مُبِینٌ (۷) أَمْ یَقُولُونَ اِفْتَرٰاهُ قُلْ إِنِ اِفْتَرَیْتُهُ فَلاٰ تَمْلِکُونَ لِی مِنَ اَللّٰهِ شَیْئاً هُوَ أَعْلَمُ بِمٰا تُفِیضُونَ فِیهِ کَفیٰ بِهِ شَهِیداً بَیْنِی وَ بَیْنَکُمْ وَ هُوَ اَلْغَفُورُ اَلرَّحِیمُ (۸)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "بنام خداوند بخشایندۀ مهربان",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Paragraph",
      "Text": "حم (۱) فرو فرستادن کتابست از خدای عزیز درست کار (۲) نیافریدیم آسمانها و زمین را و آنچه میان آن دوتاست مگر بحق و مدتی نام برده شده و آنان که کافر شدند از آنچه بیم کرده شدند اعراض‌کنندگان (۳) بگو خبر دهید از آنچه می‌خوانید از جز خدا بنمائید مرا که چه چیز آفریدند از زمین یا مر ایشان‌راست شرکتی در آسمانها بیارید مرا کتابی پیش از این یا بازمانده از دانش اگر هستید راستگویان (۴) و کیست گمراه‌تر از آنکه می‌خواند از جز خدا آن را که اجابت نمی‌کند مر او را تا روز قیامت و آنها از خواندن ایشان بیخبرانند (۵) و چون حشر کرده شدند مردمان باشند مر ایشان را دشمنان و باشند بپرستش ایشان انکارکنندگان (۶) و چون خوانده شود بر ایشان آیتهای ما که روشن است گویند آنان که کافر شدند مر حق را چون آمد ایشان را این سحریست آشکار (۷) بلکه می‌گویند بدروغ بست آن را بگو اگر دروغ بستم آن را پس مالک نمی‌باشند مر از خدا چیزی او داناتر است بآنچه سخن می‌کنید در آن کافی باشد او گواه میانه من و میانه شما و اوست آمرزنده مهربان (۸)",
      "CoupletIndex": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "شد حق از نطق محمّد (ص) در خطاب",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "از پی تنزیل آیات و کتاب",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "خود فرستاد این کتاب استوار",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "آن خدای غالب استوده کار",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "نافریدیم این سماوات و زمین",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "وآنچه باشد در میان آن و این",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "از تمام ممکنات و ماخَلَق",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "جز به حکمت، جز به صحت، جز به حق",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "تا زمانی نام برده که به آن",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "منتهی گردد مقادیر و زمان",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "کافر آن کو گشت عَمآ أنْذِرُواْ",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "مُعرِضُون یعنی بگرداندند رو",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "گو که می بینید این آیا شما",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "می پرستید آنچه را غیر از خدا",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "چیزی از آن وانماییدم به فرض",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "کآفریدستند از اجزاء ارض",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "یا که ایشان راست شرکت از گمان",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "در سماوات اعنی اندر خلق آن",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "بر من آرید آن کتابی را به دین",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "کآمده باشد شما را پیش از این",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "یا که آثاری ز علم ار با شماست",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "گر در این دعوی شما گویید راست",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "یعنی ار دارید برهان و دلیل",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "آورید از علم افزون یا قلیل",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "یعنی اندر بت پرستی خود شما",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "گر دلیلی هست آرید آن به ما",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "لیک زآن گمراه تر که خواند او",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "غیر حق آن را که اندر جستجو",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "تا قیامت خوانَدش گر در خطاب",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "زآن دعای او نگردد مستجاب",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "وز دعاهاشان بتان بس غافلند",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "که بر آنها در تضرّع مایلند",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "حشر روزی که شوند این مردمان",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "دشمنانند این جماعت را بتان",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "حق به نطق آرد مر ایشان را به چند",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "تا بر اپرستندگان کافر شوند",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "خوانده چون گردد بر ایشان برملا",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "با نشان روشن آیتهای ما",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "کافران حق را که آمدشان چنین",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "می بگویند این بود سحری مبین",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "زین عجب تر أم یَقُولُونَ افتَرَاه",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "بافته است آن را نه کآمد از اِله",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "گو که گر من افتراء بندم به حق",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "پس منم خود بر عذابش مستحق",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "پس شما قادر به تقریبی ز من",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "هیچ نبوید از عذاب ذوالمنن",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "گر به فرض از بهر اشفاق شما",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "بر خدا بندم بدینسان افترا",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "تا که معبودان باطل را کنید",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "ترک و رو بر خالق یکتا نهید",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "پس چو نازل او کند بر من عذاب",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "نی به دفعش قادرید از هیچ باب",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "پس مرا این افتراء بستن چه سود",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "بهر چند از عاجزان بی وجود",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "اوست داناتر بر آنچه می کنید",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "خوض در آن طعن قرآن را پدید",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "هم گواهی را میان ما بس اوست",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "که غفور و مهربان بر هر کس اوست",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    }
  ]
}
