      "Text": "وَ وَصَّیْنَا اَلْإِنْسٰانَ بِوٰالِدَیْهِ إِحْسٰاناً حَمَلَتْهُ أُمُّهُ کُرْهاً وَ وَضَعَتْهُ کُرْهاً وَ حَمْلُهُ وَ فِصٰالُهُ ثَلاٰثُونَ شَهْراً حَتّٰی إِذٰا بَلَغَ أَشُدَّهُ وَ بَلَغَ أَرْبَعِینَ سَنَةً قٰالَ رَبِّ أَوْزِعْنِی أَنْ أَشْکُرَ نِعْمَتَکَ اَلَّتِی أَنْعَمْتَ عَلَیَّ وَ عَلیٰ وٰالِدَیَّ وَ أَنْ أَعْمَلَ صٰالِحاً تَرْضٰاهُ وَ أَصْلِحْ لِی فِی ذُرِّیَّتِی إِنِّی تُبْتُ إِلَیْکَ وَ إِنِّی مِنَ اَلْمُسْلِمِینَ (۱۵) أُولٰئِکَ اَلَّذِینَ نَتَقَبَّلُ عَنْهُمْ أَحْسَنَ مٰا عَمِلُوا وَ نَتَجٰاوَزُ عَنْ سَیِّئٰاتِهِمْ فِی أَصْحٰابِ اَلْجَنَّةِ وَعْدَ اَلصِّدْقِ اَلَّذِی کٰانُوا یُوعَدُونَ (۱۶)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "و وصیت نمودیم انسان را بوالدینش خوبی کردن برداشت او را مادرش بدشواری و بنهادش بدشواری و حملش و بریدنش از شیر سی ماه است تا چون رسید تواناییش و رسید بچهل سال گفت پروردگار من در دل من انداز که شکر کنم نعمت ترا که انعام کردی بر من و بر والدینم و اینکه بکنم کار شایسته را که پسندی آن را و شایستگی ده مرا در اولادم بدرستی که من بازگشت نمودم بسوی تو و بدرستی که منم از منقادان (۱۵) آنها آنانند که می‌پذیریم از ایشان بهترین آنچه کردند و در می‌گذریم از بدیهای ایشان باشند در اهل بهشت وعده راستی که بودند وعده داده می‌شدند (۱۶)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "هم وصیّت کرده ایم از فرض عین",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "کآدمی نیکی کند بر والدین",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "مادرش چون حملش از سختی نمود",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "هم نهاد او را به سختی آنچه بود",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "حمل او تا گیردش از شیر باز",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "سی مَه است از حکم آن دانای راز",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "تا رسید از کودکی از روی نقل",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "بر کمال قوّت و ادراک و عقل",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "چون رسد او بر چهل سال از قرار",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "گوید از شأنش که ای پروردگار",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "کن مرا از بخشش بی علتت",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "مولع و ملهم به شکر نعمتت",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "زآنچه بر من کردی اِنعام از کرم",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "همچنین بر والدینم دم به دم",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "هم شوم ملهم به کردار نکو",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "موجب خوشنودیّت تا باشد او",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "بر صلاح آور مر ا از نیّتم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "جاری آن را ساز در ذریّتم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "بر تو گشتم باز ز اشیاء جهان",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "هم تو را باشم ز گردن هِشتگان",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "آن گروهند آنکه نیکوتر عمل",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "گردد از ایشان قبول لم یزل",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "درگذشته هم شود ز اجرامشان",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "بر نکویی ثبت گردد نامشان",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "در میان اهل جنّت که خدای",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "وعده داد از راستیشان بر عطای",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "وعده ای که وعده داده می شدند",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "بر بهشت عدن و جای ارجمند",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    }
  ]
}
