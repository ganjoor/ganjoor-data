  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "ثُمَّ إِنَّهُمْ لَصٰالُوا اَلْجَحِیمِ (۱۶) ثُمَّ یُقٰالُ هٰذَا اَلَّذِی کُنْتُمْ بِهِ تُکَذِّبُونَ (۱۷) کَلاّٰ إِنَّ کِتٰابَ اَلْأَبْرٰارِ لَفِی عِلِّیِّینَ (۱۸) وَ مٰا أَدْرٰاکَ مٰا عِلِّیُّونَ (۱۹) کِتٰابٌ مَرْقُومٌ (۲۰) یَشْهَدُهُ اَلْمُقَرَّبُونَ (۲۱) إِنَّ اَلْأَبْرٰارَ لَفِی نَعِیمٍ (۲۲) عَلَی اَلْأَرٰائِکِ یَنْظُرُونَ (۲۳) تَعْرِفُ فِی وُجُوهِهِمْ نَضْرَةَ اَلنَّعِیمِ (۲۴) یُسْقَوْنَ مِنْ رَحِیقٍ مَخْتُومٍ (۲۵) خِتٰامُهُ مِسْکٌ وَ فِی ذٰلِکَ فَلْیَتَنٰافَسِ اَلْمُتَنٰافِسُونَ (۲۶) وَ مِزٰاجُهُ مِنْ تَسْنِیمٍ (۲۷) عَیْناً یَشْرَبُ بِهَا اَلْمُقَرَّبُونَ (۲۸)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "پس بدرستی که ایشان در آیندگانند در دوزخ (۱۶) پس گفته شود اینست که بودید آن را تکذیب می‌کردند (۱۷) حقا بدرستی که نامه نیکوکاران هر آینه در علیین است (۱۸) و چه چیز دانا کرد ترا که چیست علیین (۱۹) نامه‌ایست رقم کرده شده (۲۰) که گواه می‌شوند آن را مقربان (۲۱) بدرستی که نیکوکارانند هر آینه در نعیم (۲۲) بر سریرها نظاره می‌کنند (۲۳) می‌یابی در رویهایشان تازگی بهشت (۲۴) آشامانیده می‌شوند از صاف شراب مهر شده (۲۵) که مهر پذیرش مشک است و در آن پس باید رغبت کنند رغبت‌کنندگان (۲۶) و مزاجش از نسیم است (۲۷) چشمه‌ایست که می‌آشامند از آن نزدیک‌کردگان (۲۸)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "پس به دوزخ اندر آیند آن کسان",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "پس به ایشان گفته گردد آن زمان",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "این عذابی باشد آنکه خود شما",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "بودتان تکذیب از آن اندر ملا",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "نامۀ ابرار هم حقاً که هست",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "در به علیّینِ اعلی، نی به پست",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "تو چه دانی آنکه علیّون کجاست",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "نامۀ مرقوم روشن کز خداست",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "می شوند افرشتگان حاضر بدان",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "که مقرّب گشتگانند از نشان",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "جمله ابرارند ز امر ذوالکرم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "بر ارائک در بهشت پر نعم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "بنگرند ایشان بر آنچه شادمان",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "می شوند از دیدنش اندر جنان",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "می شناسی خود تو در آن روی ها",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "تازگی های نعیم جان فزا",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "می بنوشند از شراب بی ز غش",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "کوست مختوم از ختام مشک خوش",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "باید اندر این شراب و این شئون",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "رغبتِ رغبت کنان باشد فزون",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "هر کند او ترک خمر اندر جهان",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "حق چشاند از رحیقش در جنان",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "آن شراب خالص اندر امتزاج",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "باشد از تَسنِیم خود او را مزاج",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "چشمۀ تَسنِیم کاندر انتساب",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "اهل قرب از آن همی نوشند آب",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    }
  ]
}
