      "VOrder": 17,
      "Position": "Left",
      "Text": "کافری کردی چو بر آئین ستم",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "گفت موسی کردم آن قتل آن زمان",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "که بُدم در زعم تو از گمرهان",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "قتل او بُد در حقیقت بر صواب",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "گرچه بنمود آن خطاء بر شیخ و شاب",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "قتل او هم قصد من اصلا نبود",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "بل زدم مشتی و مُرد آن بی وجود",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "یا که گمره بودم اعنی بی خبر",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "زآنکه از مشتی بمیرد جانور",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "از شما بگریختم پس لاکلام",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "زآنکه ترسیدم ز قتل و انتقام",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "پس به من بخشید ربّم بعد از آن",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "حکم و گرداندم ز بفرستادگان",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "داد یعنی علم و فهم و حکمتم",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "پس فرستاد این چنین بر دعوتم",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "نعمتی کز وی نهی منّت به من",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "زآن سبب بُد که گرفتی از محن",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "آل اسرائیل را بر بندگی",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "کردی اخذ مالشان در زندگی",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "خوارشان کردی فکندی در تعب",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "کُشتی اولاد نبیّین بی سبب",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "زآن مرا حق در سرای تو فکند",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "در تلافی تا ز من یابی گزند",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "گر نمی کردی تو تعبید از جفا",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "از رجال و از نساء قوم مرا",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "مر مرا کردند قومم تربیت",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "بر تو کی محتاج بودم زین جهت",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "آنچه پس نزد تو بر من نعمت است",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "نیست نعمت بلکه رنج و نقمت است",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "قوم من کردی ذلیل از نقمتی",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "پس نهی منّت به من در نعمتی",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "یاد آری نیکیای کآن بُد بَدی",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "وز خیانت های خود غافل شدی",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "کآن بود تعبید اسرائیلیان",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "هیچ ناری زآنچه کردی در بیان",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "مال ما بگرفتی آنچه بود تو",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "پس به خرج صاحبش کردی دو جو",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "می نبود از حسن ذات و گوهرم",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "کس مربّی بر من الاّ مادرم",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "کی تو بودستی مربّی مر مرا",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "مال خود خوردم به خانۀ دیگرا",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "هم نه از پستان بد خوردم لبن",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "تا که شرک آرم به ذات ذوالمنن",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 60,
      "Position": "Right",
      "Text": "آنکه بگرفتی تو بهرم دایه ای",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "مادر من بود نی همسایه ای",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 62,
      "Position": "Right",
      "Text": "آن قدر هم حقّ تو آرم بجا",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "که شوی خواهم ز کفر و کین رها",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 64,
      "Position": "Right",
      "Text": "حقّ آنکه بوده ام در خانه ات",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 65,
      "Position": "Left",
      "Text": "میبرم بر گلشن از ویرانه ات",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 66,
      "Position": "Right",
      "Text": "بر بهای کهنه ات بدهم نوی",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 67,
      "Position": "Left",
      "Text": "حقّ دیگر نیستت بر من جوی",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 68,
      "Position": "Right",
      "Text": "چون جواب خویش فرعون عنید",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 69,
      "Position": "Left",
      "Text": "زآنچه بر وی طعن می زد زو شنید",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 70,
      "Position": "Right",
      "Text": "گفت برگو چیست ربّ العالمین",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 71,
      "Position": "Left",
      "Text": "که تو زو پیغمبری در این زمین",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    }
  ]
}
