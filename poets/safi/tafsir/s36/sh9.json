      "Position": "Left",
      "Text": "نی که باشند آگه از اسرار او",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "جز قلیلی کز حقایق آگهند",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "از عرب یا از عجم، اهل رهند",
