      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "گوش کن لِّیُنذِرَ مَن کَانَ حَیّ",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
