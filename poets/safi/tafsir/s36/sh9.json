      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "هستشان در چارپایان سودها",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "هم ز آشامیدنی از دوغ و شیر",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "شکر آیا پس نگویند از ضمیر",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "هم گرفتند اله غیر از خدا",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "بر امید یاری اندر کارها",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "وآن بتان یاری بنتوانند داد",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "چند آید یاری از سنگ و جماد",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "بت پرستان بل بتان را ناصرند",
