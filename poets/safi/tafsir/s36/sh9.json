      "Text": "تا عجم بر فهم قرآن پی برند",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "بل عرب هم انتفاع از وی برند",
