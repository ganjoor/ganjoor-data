      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "یٰا أَیُّهَا اَلَّذِینَ آمَنُوا لاٰ تُقَدِّمُوا بَیْنَ یَدَیِ اَللّٰهِ وَ رَسُولِهِ وَ اِتَّقُوا اَللّٰهَ إِنَّ اَللّٰهَ سَمِیعٌ عَلِیمٌ (۱) یٰا أَیُّهَا اَلَّذِینَ آمَنُوا لاٰ تَرْفَعُوا أَصْوٰاتَکُمْ فَوْقَ صَوْتِ اَلنَّبِیِّ وَ لاٰ تَجْهَرُوا لَهُ بِالْقَوْلِ کَجَهْرِ بَعْضِکُمْ لِبَعْضٍ أَنْ تَحْبَطَ أَعْمٰالُکُمْ وَ أَنْتُمْ لاٰ تَشْعُرُونَ (۲) إِنَّ اَلَّذِینَ یَغُضُّونَ أَصْوٰاتَهُمْ عِنْدَ رَسُولِ اَللّٰهِ أُولٰئِکَ اَلَّذِینَ اِمْتَحَنَ اَللّٰهُ قُلُوبَهُمْ لِلتَّقْویٰ لَهُمْ مَغْفِرَةٌ وَ أَجْرٌ عَظِیمٌ (۳) إِنَّ اَلَّذِینَ یُنٰادُونَکَ مِنْ وَرٰاءِ‌ اَلْحُجُرٰاتِ أَکْثَرُهُمْ لاٰ یَعْقِلُونَ (۴) وَ لَوْ أَنَّهُمْ صَبَرُوا حَتّٰی تَخْرُجَ إِلَیْهِمْ لَکٰانَ خَیْراً لَهُمْ وَ اَللّٰهُ غَفُورٌ رَحِیمٌ (۵)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "بنام خداوند بخشاینده مهربان",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Paragraph",
      "Text": "ای آن کسانی که ایمان آوردید پیشی گیرید میانه دو دست خدا و رسولش و بترسید از خدا بدرستی که خدا شنوای داناست (۱) ای آنان که ایمان آوردید بلند مسازید آوازهاتان را بالای آواز پیغمبر و نه بلند خطاب کنید مر او را در گفتار چون بلند گفتن برخی از شما مر برخی را که ناچیز شود کردارهاتان و شما نمی‌دانید (۲) بدرستی که آنان که پست می‌سازند آوازهاشان را نزد رسول خدا آنها آنانند که آزمود خدا دلهاشان را برای پرهیزکاری برای ایشانست آمرزش و مزدی بزرگ (۳) بدرستی که آنان که ندا می‌کنند ترا از پشت حجرها اکثر ایشان نمی‌یابند بعقل (۴) و اگر ایشان صبر کنند تا بیرون آیی با ایشان هر آینه باشد بهتر برای ایشان خدا آمرزنده مهربانست (۵)",
      "CoupletIndex": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "ای گروه مؤمنان و اهل قبول",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "در هر آن امر از خدا و از رسول",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "بر شما نبود که تا پیشی کنید",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "خودسری و فکرت اندیشی کنید",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "این بود دور از موالات و ادب",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "که تقدّم بر نبی (ص) جویید و رب",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "اندر این آیت سببها بر نزول",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "گفته اند ارباب تفسیر و اصول",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "زآن یکی که از پیمبر گر کسی",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "پرسشی می کرد اندر مجلسی",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "پیش از آن کآید پیمبر در خطاب",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "می نمود اقدام هر کس بر جواب",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "یا که پیش از مصطفی (ص) در کارها",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "رأی می دادند از گفتارها",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "لیک این حکم است عام اندر سبب",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "سبقت از شاهان بود دور از ادب",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "می بترسید از خدا اندر حضور",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "تا از او گیرید سبقت در امور",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "او بود شنوا و دانا هر زمان",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "بر مقال و بر فعال بندگان",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "مؤمنان لَاتَرْفَعُواْ أصوتَکُم",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "فوق آواز پیمبر ز اُشتلم",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "همچنین لَا تَجهَرُوا بِالْقَولِ لَه",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "همچو خواندن بعض را بعضی به ره",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "می زند فریاد از راه و دکان",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "کای فلان تا آیمت بر جا بمان",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "این بود دور از نشان تربیت",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "مردمی را نیست این خُلق و صفت",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "می زدند در کوچه اعرابش صدا",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "کای محمّد(ص) من فلان شیخم درا",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "این بود در عامه هم زشت و نژند",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "تا چه جای خاصگان ارجمند",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "گر عزیزی را ز پشت خانه اش",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "کس بخواند، خواند او دیوانه اش",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "تا چه جای شهریار و سروری",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "یا امام و رهبر و پیغمبری",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "نام او هم بر لب آوردن خطاست",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "جز به توقیر و تعظّم وین سخاست",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "زآن عملهاتان شود نابود و فوت",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "از خلاف رسم یعنی رفع صوت",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "نیستید آگاه و دلتان غافل است",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "زینکه اعمال شما زین باطل است",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "وآن کسان که صوت خود سازند نرم",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "نزد پیغمبر مگر ز آزرم و شرم",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "این گروهند آنکه آن خلاّق جان",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "کرده دلهاشان به تقوی امتحان",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "هستشان آمرزش و اجری عظیم",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "در دو دنیا از ره امید و بیم",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "آن کسان که می کنند ایشان ندا",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "مر نبی را از برون حجره ها",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "اکثری ادراکشان ز ایشان کم است",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "کی بهائم را نشان آدم است",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "گر شکیبایی نمودند اندکی",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "سویشان آیی تو بیرون تا یکی",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "بهر ایشان بود بهتر کت ندا",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "برزنند ایشان ز بیرون سرا",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "حق بود آمرزگار و مهربان",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "بر کسی کو توبه کرد از فعل آن",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    }
  ]
}
