      "Text": "یٰا أَیُّهَا اَلَّذِینَ آمَنُوا اِتَّقُوا اَللّٰهَ وَ لْتَنْظُرْ نَفْسٌ مٰا قَدَّمَتْ لِغَدٍ وَ اِتَّقُوا اَللّٰهَ إِنَّ اَللّٰهَ خَبِیرٌ بِمٰا تَعْمَلُونَ (۱۸) وَ لاٰ تَکُونُوا کَالَّذِینَ نَسُوا اَللّٰهَ فَأَنْسٰاهُمْ أَنْفُسَهُمْ أُولٰئِکَ هُمُ اَلْفٰاسِقُونَ (۱۹) لاٰ یَسْتَوِی أَصْحٰابُ اَلنّٰارِ وَ أَصْحٰابُ اَلْجَنَّةِ أَصْحٰابُ اَلْجَنَّةِ هُمُ اَلْفٰائِزُونَ (۲۰)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "ای آن کسانی که ایمان آوردید بپرهیزید از خدا و باید بنگرد نفسی که چه پیش فرستاد برای فردا و بپرهیزید خدا را بدرستی که خدا بیناست بآنچه می‌کنید (۱۸) و نباشند چون آنان که فراموش نمودند خدا را پس فراموش گردانید بر آنها خودهاشان را آنهایند آنها فاسقان (۱۹) یکسان نیستند اهل آتش و اهل بهشت اهل بهشتند ایشان کامیابان (۲۰)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ای گروه کاهل ایمانید بس",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "می بترسید از خدا در هر نفس",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "هر کسی باید کند در خود نظر",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "تا چه بفرستاده پیش از خیر و شرّ",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "بهر فردای قیامت گر که آن",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "هست طاعت شکر حق گوید به جان",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "ور که عصیان است پس باید کند",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "توبه و تقوی ز فعل زشتِ بد",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "باید او البته پرهیزد مدام",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "از عقوبت های خلاّق الانام",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "او بود دانا بر آنچه می کنید",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "پس چو داند او به نیکی ره زنید",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "هست تقوای نخستین از عوام",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "وآن دوم مخصوص خاصان و کرام",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "هست تقوای عوام از ناپسند",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "وآنچه اندر شرع زشت است و نژند",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "لیک تقوای خواص از ماسواست",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "و اجتناب از هر چه مادون خداست",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "همچو آنان می مباشید ایچ بس",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "که فراموش از خدا کردند بس",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "پس فراموش از نفوس خویشتن",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "ساختشان پروردگار ذوالمنن",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "یا چو بردند از گنه حق را زیاد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "توبه بُرد از یادشان ربّ العباد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "این گروه از فاسقانند از یقین",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "رفته بیرون از حدود و حکم دین",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "نیست یکسان اهل جنّت و اهل نار",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "از جحیمند اهل جنّت رستگار",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    }
  ]
}
