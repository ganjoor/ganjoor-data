      "Position": "Left",
      "Text": "که از آن خواهی کثیر اندر عوض",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "می دهی اندک که تا گیری تو بیش",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "این کند جز طامعی غافل ز خویش",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "تو به امید عوض چیزی مده",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "در عبادت هم به حق منّت منه",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "صبر کن بر جود خلق از هر قرار",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "از پی خوشنودی پروردگار",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "پس دمیده چون شود در صور دم",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "پس بود آن وقت و روز پر نقم",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "از برای کافران یَوم عَسِیر",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "هم به جز بر اهل حق غَیرُ یَسِیر",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "نُقِرَ فِی النَّاقُور گر فهمت رسد",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "انتزاع روح باشد از جسد",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "تو مرا بگذار با آنکه وحید",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "آفریدم مر ورا یعنی ولید",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "یا وحید است او به شرّ و شیطنت",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "یا وحید القوم بود او را سمت",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "گفته اند او بوده فرزند زنا",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "تا چه باشد اصل آن داند خدا",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "من ندارم این به موجودی پسند",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "نقل قول است ار بود نیک، ار نژند",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "شرح آیت گویمت، گوید خدا",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "دادم او را مال ممدود از نما",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "هم پسرها که به نزد او تمام",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "هر زمان بودند حاضر در مقام",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "هم بگستردم ورا گستردنی",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "از بساط و جاه و لبس و خوردنی",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "بس طمع دارد که تا من ز اعتماد",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "مر عطیّاتم کنم بر وی زیاد",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "این چنین نبود که می پندارد او",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "بندمش بل باب نعمت را بر او",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "کوست بر آیات ما استیزه گر",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "بر صعودش می رسانم زودتر",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "مر صعود آن عقبه ای ز آتش بود",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "که پس از عمری عنود آنجا رسد",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "چون به بالایش رسد افتد به زیر",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "مشرک و ظالم بود زآن ناگزیر",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    }
  ]
}
