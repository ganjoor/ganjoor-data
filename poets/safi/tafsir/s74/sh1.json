  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "بسم االله الرحمن الرحیم",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "یٰا أَیُّهَا اَلْمُدَّثِّرُ (۱) قُمْ فَأَنْذِرْ (۲) وَ رَبَّکَ فَکَبِّرْ (۳) وَ ثِیٰابَکَ فَطَهِّرْ (۴) وَ اَلرُّجْزَ فَاهْجُرْ (۵) وَ لاٰ تَمْنُنْ تَسْتَکْثِرُ (۶) وَ لِرَبِّکَ فَاصْبِرْ (۷) فَإِذٰا نُقِرَ فِی اَلنّٰاقُورِ (۸) فَذٰلِکَ یَوْمَئِذٍ یَوْمٌ عَسِیرٌ (۹) عَلَی اَلْکٰافِرِینَ غَیْرُ یَسِیرٍ (۱۰) ذَرْنِی وَ مَنْ خَلَقْتُ وَحِیداً (۱۱) وَ جَعَلْتُ لَهُ مٰالاً مَمْدُوداً (۱۲) وَ بَنِینَ شُهُوداً (۱۳) وَ مَهَّدْتُ لَهُ تَمْهِیداً (۱۴) ثُمَّ یَطْمَعُ أَنْ أَزِیدَ (۱۵) کَلاّٰ إِنَّهُ کٰانَ لِآیٰاتِنٰا عَنِیداً (۱۶) سَأُرْهِقُهُ صَعُوداً (۱۷)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "بنام خداوند بخشاینده مهربان",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Paragraph",
      "Text": "ای جامه بر خود پیچیده (۱) برخیز پس بیم ده (۲) و پروردگارت را پس بزرگی یاد کن (۳) و جامه‌ات را پس پاک کن (۴) و پلیدی را پس اجتناب کن (۵) و اعطا مکن که عوض بیشتر خواهی (۶) و برای پروردگارت پس صبر کن (۷) پس چون دمیده شود در صور (۸) پس اینست آن روز روزی دشوار (۹) بر کافران غیر آسان (۱۰) واگذار مرا و آن را که آفریدم تنها (۱۱) و گردانیدم برای او مالی فراوان (۱۲) و پسران حاضر (۱۳) و سامان دادم برای او سامان دادنی (۱۴) پس طمع دارد که زیاد کنم (۱۵) نه چنین است بدرستی که او باشد مر آیتهای ما را منکر (۱۶) خواهیم گرفتیمش در بلندی (۱۷)",
