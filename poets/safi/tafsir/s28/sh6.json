      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "فَخَرَجَ مِنْهٰا خٰائِفاً یَتَرَقَّبُ قٰالَ رَبِّ نَجِّنِی مِنَ اَلْقَوْمِ اَلظّٰالِمِینَ (۲۱) وَ لَمّٰا تَوَجَّهَ تِلْقٰاءَ مَدْیَنَ قٰالَ عَسیٰ رَبِّی أَنْ یَهْدِیَنِی سَوٰاءَ اَلسَّبِیلِ (۲۲) وَ لَمّٰا وَرَدَ مٰاءَ مَدْیَنَ وَجَدَ عَلَیْهِ أُمَّةً مِنَ اَلنّٰاسِ یَسْقُونَ وَ وَجَدَ مِنْ دُونِهِمُ اِمْرَأَتَیْنِ تَذُودٰانِ قٰالَ مٰا خَطْبُکُمٰا قٰالَتٰا لاٰ نَسْقِی حَتّٰی یُصْدِرَ اَلرِّعٰاءُ وَ أَبُونٰا شَیْخٌ کَبِیرٌ (۲۳) فَسَقیٰ لَهُمٰا ثُمَّ تَوَلّٰی إِلَی اَلظِّلِّ فَقٰالَ رَبِّ إِنِّی لِمٰا أَنْزَلْتَ إِلَیَّ مِنْ خَیْرٍ فَقِیرٌ (۲۴)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "پس بیرون رفت از آن ترسان که مترصد می‌بود و گفت ای پروردگار من برهان مرا از گروه ستمکاران (۲۱) و چون متوجه شد بسوی مدین گفت شاید که پروردگار من که هدایت کند مرا میان راه (۲۲) و چون وارد شد بآب مدین یافت بر آن گروهی را از مردمان که آب می‌دادند مواشی خود را و یافت از فرود ایشان دو زن را منع می‌کردند گفت چیست کار شما گفتند آب نمی‌دهیم تا آنکه باز کردند شبانان و پدر ما پیریست بزرگ (۲۳) پس آب داد برای آن دو پس برگشت بسوی سایه پس گفت پروردگار من بدرستی که من برای آنچه فرو فرستادی بر من از خیر محتاجم (۲۴)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "« در بیان فرار کردن حضرت موسی(ع) از مصر و رسیدن بر سر آب مدین و دیدن دختران شعیب(ع) را بر سر آب »",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Right",
      "Text": "پس برون از شهر شد بی راحله",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Left",
      "Text": "گرسنه، تنها بدون قافله",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "بود خائف داشت در ره انتظار",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "کز پی اش آیند گفت ای کردگار",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "ده نجاتم از گروه ظالمین",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "در پناه خود نگهدارم چنین",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "پس روان شد سوی مدین او ز راه",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "ره نماید شایدم گفتا اِله",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Right",
      "Text": "از سه ره کآمد به پیشش بی غلط",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Left",
      "Text": "او سوا کرد اختیار اعنی وسط",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "زآن دو ره رفتند آنها کز عقب",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "مر ورا بودند ساعی در طلب",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "داشت حق مستور ز ایشان راه راست",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "کز وسط می رفت و حق اینگونه خواست",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "شد به مدین، هشت منزل بوده آن",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "تا به مصر و خارج از فرعونیان",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "آمد او بر آب مدین در ورود",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "وآن چهی اندر کنار شهر بود",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "یافت قومی را ز مردم کز شتاب",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "مر مواشی را همی دادند آب",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "بر کناری دید از مردم دو زن",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "گوسفندان داشته دور آن دو تن",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "تا نیایند آن رمه نزدیک آب",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "یافت ایشان را به عفت در حجاب",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "رفت موسی کرد از ایشان سؤال",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "چیست تا مطلوبتان زین اشتغال",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "گوسفندان دور می دارید ز آب",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "در رمه تا در نریزند از شتاب",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "می بگفتند آب ندهیم این رمه",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "تا که فارغ می نگردند آن همه",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "پس بماند هر چه فاضل ز آبشان",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "بر مواشی ما دهیم از بعد آن",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "هستمان پیر کهنسالی پدر",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "نیست قادر تا خود آید در گذر",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "بالضروره خواهران آییم ما",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "تا که بدهیم آب مر اغنام را",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "با شبانان گفت موسی کز چه باب",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "این زنان را زودتر ندهید آب",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "آب ما گفتند ندهیم ار به گاه",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "تو توانی دلو را برکش ز چاه",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "آب می ده این دو زن را زودتر",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "این به استهزا ء بگفتند آن حشر",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "زآنکه بود آن کار ده مرد قوی",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "غیرت آمد در نهاد موسوی",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "برکشید آن دلو بر چُستی ز چاه",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "داد آب اغنام نسوان را به گاه",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "کرد پس بر سایۀ نخلی رجوع",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "از حرارت یا که از طغیان جوع",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "گفت پس یا رب ز نیکی ناگزیر",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "آنچه بفرستی به محتاج فقیر",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "از تو میخواهم که محتاجم بر آن",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "خوردنی را گرچه باشد نیم نان",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "دختران را دید در خانه پدر",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "آمدند امروز از ره زودتر",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "زآن سبب پرسید ، گفتند آنچه بود",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "گفت آریدش کنون در خانه زود",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    }
  ]
}
