      "VOrder": 12,
      "Position": "Left",
      "Text": "غیر او را نی پرستند آن مهان",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "قلب عارف طاهر از تعظیم غیر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "جز خدایش ناید اندر یاد و سیر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "طاهر ارواح محبّان زآنکه باز",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "چشمشان گردد به جز بر دلنواز",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "طاهر است اسرار ارباب شهود",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "از توجه جز به سلطان وجود",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "مر موحد را بوَد طاهر خفا",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "زآنکه چیزی غیر حق بیند به جا",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "سین اشارت باشد ار دانی به سرّ",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "اهل حق دارند سرّش مستتر",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "عاصیان را یافت آن کو سرّ ذات",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "داند آن سلطان جان، بخشد نجات",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "سرّ صوفی را گرت اندیشه است",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "داند آن کو با صفی هم ریشه است",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "سرّ دیگر هست و سودای دگر",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "داند آن کو را ز تن کندند سَر",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "آن کجا گوید، کجا داند صفی",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "سرّ مخفی گو بماند مختفی",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "میم اگر دانی مراد از منّت است",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "کش به خلقان در نوا و نعمت است",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "منّت دیگر به اهل عشق از اوست",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "داند آن کو را به دل بگرفت دوست",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "بر صفی منّت بدین تفسیر هِشت",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "بر زبانش نطق و این تقریر هِشت",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "تا به نظم آرد کتابش را تمام",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "بود خاص این نعمت از ربّ الانام",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "گر زبان دانی و بشناسی سخن",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "خاص دانی منّتش بر جان من",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "واگذار آن را که ز اغراض و حسد",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "گشته فاسد دانش و دین و خرد",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "نارد این تفسیر را او در نظر",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "غیر شعر و شاعری پا تا به سر",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "پس بمان کو در جهالت تا ابد",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "همچنین در بخل و انکار و حسد",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "گفت این سوره است ز آیت های دین",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "از کتاب مستطاب مستبین",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "بر تو خوانیم از خبر چیزی که هست",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "بالحق از موسی و از فرعون پست",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "مر گروهی را که بر حق مؤمنند",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "بر خبرها کز حق آید موقنند",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "اینکه فرعون از ره استمگری",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "جست اندر ارض مصر او برتری",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "دو گروه از سبطیان و قبطیان",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "ساخت اهل مصر را او در عیان",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "یک گُره را کرد مغلوب و ضعیف",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "زآل یعقوب از وضیع و از شریف",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "کُشتی ابناشان، وی از حُمقی که داشت",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "وآن زنانشان جمله باقی می گذاشت",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "کاهنان گفتند ز ایشان یک نفر",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "می کند ملک تو را زیر و زبر",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "کُشتی ابناء را نگیرد تا کِهی",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "پای از ایشان بر فنای او شهی",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "احمق از آن بُد که گر آن کاهنان",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "راست گفتند آنچه گفتند از نشان",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "کُشتن بسیار دفع آن فساد",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "کی نمودی هیچ ناورد این به یاد",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "بود او از مفسدین ما خواستیم",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "تا بر آن مستضعفین منّت نهیم",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "که شدند اندر زمین مصر خوار",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "زیر دست قبطیان بد شعار",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "پیشوایانشان نمودیم آن چنان",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 36
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "وارث مال و مکان قبطیان",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 36
    }
  ]
}
