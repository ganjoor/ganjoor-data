      "PlainText": "بیخبر بودند ایشان کآن ولد\r\nآتش اندر خانمان او زند",
      "HtmlText": "\u003Cdiv class=\u0022b\u0022 id=\u0022bn1\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eبیخبر بودند ایشان کآن ولد\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eآتش اندر خانمان او زند\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E",
      "CoupletsCount": 1
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "وَ نُمَکِّنَ لَهُمْ فِی اَلْأَرْضِ وَ نُرِیَ فِرْعَوْنَ وَ هٰامٰانَ وَ جُنُودَهُمٰا مِنْهُمْ مٰا کٰانُوا یَحْذَرُونَ (۶) وَ أَوْحَیْنٰا إِلیٰ أُمِّ مُوسیٰ أَنْ أَرْضِعِیهِ فَإِذٰا خِفْتِ عَلَیْهِ فَأَلْقِیهِ فِی اَلْیَمِّ وَ لاٰ تَخٰافِی وَ لاٰ تَحْزَنِی إِنّٰا رَادُّوهُ إِلَیْکِ وَ جٰاعِلُوهُ مِنَ اَلْمُرْسَلِینَ (۷) فَالْتَقَطَهُ آلُ فِرْعَوْنَ لِیَکُونَ لَهُمْ عَدُوًّا وَ حَزَناً إِنَّ فِرْعَوْنَ وَ هٰامٰانَ وَ جُنُودَهُمٰا کٰانُوا خٰاطِئِینَ (۸) وَ قٰالَتِ اِمْرَأَتُ فِرْعَوْنَ قُرَّتُ عَیْنٍ لِی وَ لَکَ لاٰ تَقْتُلُوهُ عَسیٰ أَنْ یَنْفَعَنٰا أَوْ نَتَّخِذَهُ وَلَداً وَ هُمْ لاٰ یَشْعُرُونَ (۹)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "و تمکین دهیم مر ایشان را در زمین و بنمائیم فرعون را و هامان را و لشگرهای آن دو را از ایشان آنچه بودند که بیم می‌داشتند (۶) و وحی کردیم بمادر موسی که شیر ده او را پس چون بترسی بر او پس بیندازش در دریا و مترس و اندوهگین مشو بدرستی که ما باز گرداننده‌ایم او را بسوی تو و گردانیده‌ایم او را از مرسلان (۷) پس برگرفتند او را کسان فرعون تا باشد مر ایشان را دشمنی و اندوهی بدرستی که فرعون و هامان و لشکرهای آن دو بودند خطاکاران (۸) و گفت زن فرعون آسایش چشم است مر مرا و مر تو را نکشید او را شاید که نفع دهد ما را یا برگیریمش فرزند و ایشان نمی‌دانستند (۹)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "جایشان بدهیم ما اندر زمین",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "تا که بر فرعون بنماییم این",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "هم به هامان و به لشکرهایشان",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "آنچه ز ایشان بُد حذر در رایشان",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "وآن به وقتی بُد که می گشتند غرق",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "هیچشان سودی نداد آن مکر و زرق",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "دید در خواب او که ناری برفروخت",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "قصر و باغش زآن شرار تفته سوخت",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "جُست از دانشوران تعبیر این",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "خواب او کردند تعبیر این چنین",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "که ز اسرائیلیان در این بلد",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "زاده خواهد گشت مانا یک ولد",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "که شود ملک تو زو زیر و زبر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "نک بود نزدیک کآید آن پسر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "پس امیری کرد تعیین آن عنود",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "تا کُشد هر طفل کآید در وجود",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "یعنی از ابناء اسرائیلیان",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "کودکی برجا نماند آن زمان",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "مادر موسی چو گشت او حامله",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "حمل خود میکرد پنهان یک دله",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "چون تولد یافت موسایِ وفی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "داشتند آن را ز هر کس مختفی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "تا که پی بردند از آن فرعونیان",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "آمدند اندر سرایش ناگهان",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Paragraph",
      "Text": "« در تنور افکندن موسی(ع) را مادرش »",
      "CoupletIndex": 14
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "در تنور افکندش از خوف او ز دوش",
      "CoupletIndex": 15,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "وین نبود الاّ زالهام سروش",
      "CoupletIndex": 15,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "هیچ طفلی را ندیدند آن رمه",
      "CoupletIndex": 16,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "بازگشتند از سرای او همه",
      "CoupletIndex": 16,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "وحی پس کردیم سوی مادرش",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "که به خُفیه شیر ده شو یاورش",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "پس چو می ترسی بر او از مرد و زن",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "پس ورا در بحر نیل اندر فکن",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "می مترس از آنکه او گردد هلاک",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "در فراقش هم مباش اندوهناک",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "زآنکه بازش بر تو ما سازیم رد",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "کردهایم از مرسلینش با رشد",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 40,
      "Position": "Paragraph",
      "Text": "« به دریا افکندن موسی(ع) را مادرش و گرفتن آل فرعون »",
      "CoupletIndex": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "پس فکند او را به دریا در زمان",
      "CoupletIndex": 22,
      "SectionIndex1": 2,
      "SectionIndex2": 4
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "آل فرعونش گرفتند از مکان",
      "CoupletIndex": 22,
      "SectionIndex1": 2,
      "SectionIndex2": 4
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "بوده باشد تا مر آنها را عدو",
      "CoupletIndex": 23,
      "SectionIndex1": 2,
      "SectionIndex2": 5
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "بر فزاید حزنشان پیوسته او",
      "CoupletIndex": 23,
      "SectionIndex1": 2,
      "SectionIndex2": 5
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "زآنکه آن فرعون و هامان و جنود",
      "CoupletIndex": 24,
      "SectionIndex1": 2,
      "SectionIndex2": 6
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "از خطاء کُشتند هر طفلی که بود",
      "CoupletIndex": 24,
      "SectionIndex1": 2,
      "SectionIndex2": 6
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "یا به هر چیزی بُدند از خاطئین",
      "CoupletIndex": 25,
      "SectionIndex1": 2,
      "SectionIndex2": 7
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "چون نبُدشان عقل و ایمانی متین",
      "CoupletIndex": 25,
      "SectionIndex1": 2,
      "SectionIndex2": 7
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "زوجۀ فرعون گفت او را ببر",
      "CoupletIndex": 26,
      "SectionIndex1": 2,
      "SectionIndex2": 8
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "بر من و تو نور چشم است این پسر",
      "CoupletIndex": 26,
      "SectionIndex1": 2,
      "SectionIndex2": 8
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "مر ورا نکشید شاید کانتفاع",
      "CoupletIndex": 27,
      "SectionIndex1": 2,
      "SectionIndex2": 9
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "باشد از وی بهر ما بی امتناع",
      "CoupletIndex": 27,
      "SectionIndex1": 2,
      "SectionIndex2": 9
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "قتل او نارید یعنی در نظر",
      "CoupletIndex": 28,
      "SectionIndex1": 2,
      "SectionIndex2": 10
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "کز چه از کُشتن رها گشت این پسر",
      "CoupletIndex": 28,
      "SectionIndex1": 2,
      "SectionIndex2": 10
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "زآنکه فرعون اوفتاد اندر گمان",
      "CoupletIndex": 29,
      "SectionIndex1": 2,
      "SectionIndex2": 11
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "تا مبادا آنکه دید او باشد آن",
      "CoupletIndex": 29,
      "SectionIndex1": 2,
      "SectionIndex2": 11
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "آسیه زآن گفت زین فکرت درا",
      "CoupletIndex": 30,
      "SectionIndex1": 2,
      "SectionIndex2": 12
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "تا که باشد یار، یا فرزند ما",
      "CoupletIndex": 30,
      "SectionIndex1": 2,
      "SectionIndex2": 12
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "زآنکه فرزندی نبودش هیچ او",
      "CoupletIndex": 31,
      "SectionIndex1": 2,
      "SectionIndex2": 13
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "گفت گیریمش به فرزندی نکو",
      "CoupletIndex": 31,
      "SectionIndex1": 2,
      "SectionIndex2": 13
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "بیخبر بودند ایشان کآن ولد",
      "CoupletIndex": 32,
      "SectionIndex1": 2,
      "SectionIndex2": 14
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "آتش اندر خانمان او زند",
      "CoupletIndex": 32,
      "SectionIndex1": 2,
      "SectionIndex2": 14
    }
  ]
}
