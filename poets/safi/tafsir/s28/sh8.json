      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "فَلَمّٰا قَضیٰ مُوسَی اَلْأَجَلَ وَ سٰارَ بِأَهْلِهِ آنَسَ مِنْ جٰانِبِ اَلطُّورِ نٰاراً قٰالَ لِأَهْلِهِ اُمْکُثُوا إِنِّی آنَسْتُ نٰاراً لَعَلِّی آتِیکُمْ مِنْهٰا بِخَبَرٍ أَوْ جَذْوَةٍ مِنَ اَلنّٰارِ لَعَلَّکُمْ تَصْطَلُونَ (۲۹) فَلَمّٰا أَتٰاهٰا نُودِیَ مِنْ شٰاطِئِ اَلْوٰادِ اَلْأَیْمَنِ فِی اَلْبُقْعَةِ اَلْمُبٰارَکَةِ مِنَ اَلشَّجَرَةِ أَنْ یٰا مُوسیٰ إِنِّی أَنَا اَللّٰهُ رَبُّ اَلْعٰالَمِینَ (۳۰) وَ أَنْ أَلْقِ عَصٰاکَ فَلَمّٰا رَآهٰا تَهْتَزُّ کَأَنَّهٰا جَانٌّ وَلّٰی مُدْبِراً وَ لَمْ یُعَقِّبْ یٰا مُوسیٰ أَقْبِلْ وَ لاٰ تَخَفْ إِنَّکَ مِنَ اَلْآمِنِینَ (۳۱)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "پس چون بپایان رسانید موسی آن مدت را و روان شد با اهلش دید از جانب طور آتشی را گفت مر اهلش را که درنگ نمائید بدرستی که من دیدم آتشی را شاید که آورم بشما از آن خبری یا گیرانیده شعله از آتش باشد که شما گرم شوید (۲۹) پس چون آمد آن را ندا کرده شد از کناران وادی که جانب راست بود در قطعه زمینی برکت داده شده از آن درخت که ای موسی بدرستی که من منم خدا که پروردگار جهانیانم (۳۰) و آنکه بیند عصایت را پس چون دید آن را که حرکت می‌کرد گویا آن بود مار باریکی برگشت باز پس رونده و رجوع نکرد ای موسی بیا و مترس بدرستی که تویی از ایمنان (۳۱)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "« در بیان دیدن موسی(ع) آتش طور را »",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Right",
      "Text": "پس چو موسی هِشت مدت را تمام",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Left",
      "Text": "یافت رخصت از شعیب نیک نام",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "تا رود بر مصر نزد مادرش",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "هم برادر و اقرباء و خواهرش",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "یا که می شد سوی بیت المقدس آن",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "از ابی عبد الله است این در بیان",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "برد اهل و مال خویش آن نیک مرد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "همره خود پس شبی تاریک و سرد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Right",
      "Text": "راه گم شد وضع حمل زن رسید",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Left",
      "Text": "وآن رمه از برف و سرما می رمید",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "می نجست از سنگ و آهن هیچ نار",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "ماند حیران سخت بر وی گشت کار",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "آتشی از جانب طور او بدید",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "گفت اهلش را درنگ اینجا کنید",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "آتشی دیدم از آن شاید خبر",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "بر شما آرم ز ره یابم اثر",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "زآن کسان که نزد آتش واقفند",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "ره بپرسم گر که بر ره عارفند",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "بر شما یا ز آتش آرم پاره ای",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "گرم تا گردید اندر چاره ای",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "پس چو آمد شد نداء کرده خود او",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "از یمین وادی اندر جستجو",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "در مکانی بس مبارک بود شاط",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "شد نداء کرده در آن خرّم بساط",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "از درختی کآن به وادی رُسته بود",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "بود عوسج یا که عناب از نمود",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "زو نداء آمد به موسی این چنین",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "من حقم، پروردگار عالمین",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "شرح آن بگذشت پیش از چند و چون",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "نیست بر تکرارمان حاجت کنون",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "ور کسی گوید که تکرار از چه باب",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "کرده حق این داستان را در کتاب",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "چند وجه آن راست از روی کلام",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "سرّ اصلی را خدا داند تمام",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "زآن یک این باشد که دارد هر سخن",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "ربط بر قول دگر اندر علن",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "همچنان که گفته اند اندر امور",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "مال مظلومی ببرد آن کس به زور",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "بازگویی بهر صاحب استماع",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "داشت آن مظلوم با ظالم نزاع",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "بر سر مالی که برد از وی چنان",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "نیست زین تکرار چاره در بیان",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "چونکه گویند این نزاع از بهر چیست",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "گویی آن جز بهر مال برده نیست",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "باز در جای دگر گویی که شاه",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "دادِ مظلومان دهد بی اشتباه",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "همچو آن مظلوم کو را رو به رو",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "خواست، وز ظالم گرفت اموال او",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "باشد این تکرار ثالث در کلام",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "بازگویی نیست ظالم را دوام",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "همچو آن ظالم که آن مظلوم را",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "رنجه کرد افکند ظلم او را ز پا",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "مال او برد آبروی او بریخت",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "رشتۀ کارش از آن، از هم گسیخت",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "پس مکرر در مکرر شد کلام",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "جمله هم برجا بُد ار فهمی مقام",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 60,
      "Position": "Right",
      "Text": "نی که خارج از فصاحت باشد آن",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "این نیابد جز دقیقی نکته دان",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 62,
      "Position": "Right",
      "Text": "وجه دیگر آنکه در انذار و پند",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "هست تکرار از خردمندان پسند",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 64,
      "Position": "Right",
      "Text": "چون کلامی را مکرر گفت شاه",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 65,
      "Position": "Left",
      "Text": "وقعش افزاید به دل بر اهل جاه",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 66,
      "Position": "Right",
      "Text": "چند وجه دیگر است اندر کلام",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 67,
      "Position": "Left",
      "Text": "مانم از تفسیر گر گویم تمام",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 68,
      "Position": "Right",
      "Text": "از خدا آن دم به موسی شد ندا",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 69,
      "Position": "Left",
      "Text": "که بیفکن ای کلیم از کف عصا",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 70,
      "Position": "Right",
      "Text": "پس چو موسی درفکند آن را ز کف",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 71,
      "Position": "Left",
      "Text": "گشت ماری می دوید از هر طرف",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 72,
      "Position": "Right",
      "Text": "بود در سرعت به سان تیره مار",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 36
    },
    {
      "VOrder": 73,
      "Position": "Left",
      "Text": "لیک در جثه چو ثعبان بی قرار",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 36
    },
    {
      "VOrder": 74,
      "Position": "Right",
      "Text": "منهزم شد موسی از دیدار او",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 37
    },
    {
      "VOrder": 75,
      "Position": "Left",
      "Text": "پشت کرد و باز ناگرداند رو",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 37
    },
    {
      "VOrder": 76,
      "Position": "Right",
      "Text": "موسیا پیش آ، مترس از حیّه هین",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "SectionIndex2": 38
    },
    {
      "VOrder": 77,
      "Position": "Left",
      "Text": "چونکه می باشی تو نیز از آمنین",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "SectionIndex2": 38
    }
  ]
}
