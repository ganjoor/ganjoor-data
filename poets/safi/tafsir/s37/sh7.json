      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "إِذْ جٰاءَ رَبَّهُ بِقَلْبٍ سَلِیمٍ (۸۴) إِذْ قٰالَ لِأَبِیهِ وَ قَوْمِهِ مٰا ذٰا تَعْبُدُونَ (۸۵) أَ إِفْکاً آلِهَةً دُونَ اَللّٰهِ تُرِیدُونَ (۸۶) فَمٰا ظَنُّکُمْ بِرَبِّ اَلْعٰالَمِینَ (۸۷) فَنَظَرَ نَظْرَةً فِی اَلنُّجُومِ (۸۸) فَقٰالَ إِنِّی سَقِیمٌ (۸۹) فَتَوَلَّوْا عَنْهُ مُدْبِرِینَ (۹۰) فَرٰاغَ إِلیٰ آلِهَتِهِمْ فَقٰالَ أَ لاٰ تَأْکُلُونَ (۹۱) مٰا لَکُمْ لاٰ تَنْطِقُونَ (۹۲) فَرٰاغَ عَلَیْهِمْ ضَرْباً بِالْیَمِینِ (۹۳) فَأَقْبَلُوا إِلَیْهِ یَزِفُّونَ (۹۴) قٰالَ أَ تَعْبُدُونَ مٰا تَنْحِتُونَ (۹۵) وَ اَللّٰهُ خَلَقَکُمْ وَ مٰا تَعْمَلُونَ (۹۶) قٰالُوا اِبْنُوا لَهُ بُنْیٰاناً فَأَلْقُوهُ فِی اَلْجَحِیمِ (۹۷) فَأَرٰادُوا بِهِ کَیْداً فَجَعَلْنٰاهُمُ اَلْأَسْفَلِینَ (۹۸)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "وقتی که آمد پروردگارش را با دلی درست (۸۴) چون گفت مر پدرش را و قومش را که چه چیز است آنکه می‌پرستید (۸۵) آیا از راه دروغ الهان غیر خدا می‌خواهید (۸۶) پس چیست گمان شما بپروردگار جهانیان (۸۷) پس نگریست نگریستنی در نجوم (۸۸) پس گفت بدرستی که من بیمارم (۸۹) پس اعراض کردند از او پشت‌کنندگان (۹۰) پس بچاره‌جویی رفت بسوی الهانشان پس گفت آیا چرا نمی‌خورید (۹۱) چیست مر شما را که سخن نمی‌گوئید (۹۲) پس رفت بر ایشان زدنی بدست راست (۹۳) پس رو آوردند سوی او می‌شتافتند (۹۴) گفت آیا می‌پرستید آنچه را می‌تراشید (۹۵) و خدا آفرید شما را و آنچه را می‌سازید (۹۶) گفتند بنا کنید برای او بنائی پس بیندازید او را در آتش بسیار شعله‌ور انبوه (۹۷) پس خواستند باو چارۀ پس کردیمشان پائینیان (۹۸)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "« در بیان شکستن حضرت ابراهیم(ع) اصنام را و در آتش افکندن نمرود آن حضرت را و بَرد و سلام شدن آتش بر وی »",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Right",
      "Text": "یاد کن آمد چو ابراهیم خوش",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Left",
      "Text": "رب خود را با دلی خالی ز غش",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "چونکه گفت او با پدر و اقوام خویش",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "چیست اینکه می پرستیدش به بیش",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "از دروغ آیا خدایان غیر حق",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "خود اراده می کنید از ماخَلَق",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "پس گمانتان چیست بر پروردگار",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "که جز او را می پرستید از شعار",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Right",
      "Text": "از چه جنس او را کنید اعنی گمان",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Left",
      "Text": "که نماییدش مماثل با بتان",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "پس بگفتندش که امروز است عید",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "تو بیا با ما به صحراء بهر دید",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "پس نظر کرد او به حیرت در نجوم",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "یا که بر نجم زمین از آن رسوم",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "شد به فکر از قوم و افعال قبیح",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "گفت من زینها سقیمم نی صحیح",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "یعنی این استارگان را هست اُفول",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "کی پرستد آفلی جز گیج و گول",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "با شما نتوانم آمد یک قدم",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "باشد از اهل هوی اندر سقم",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "یا که باشد قلب و روح من علیل",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "زآنچه دارد دورم از قرب خلیل",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "یا تنم باشد به رنج از این قیاس",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "که بوند این مشرکان زو ناشناس",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "حاصل اینکه گفت دارم رنج و درد",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "کی توانم با شما شد رهنورد",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "روی گر دان پس شدند از وی به راه",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "از سرا رفتند سوی عیدگاه",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "ماند ابراهیم تنها در زمان",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "پس به خفیه شد روان سوی بتان",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "گفت خو ر آیا شما را نیست چون",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "گفت دیگر مَا لَکُم لَاتَنطِقُون",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "پس به پنهانی بر ایشان زد تبر",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "بِالْیَمِین بشکستشان اندام و سر",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "بِالْیَمِین یعنی که خورده بُد قسم",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "کآن بتان را بشکند روزی ز هم",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "جز بت اعظم که بر دوشش تبر",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "هِشت یعنی کرده او این شور و شر",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "آمدند از عیدگه چون قوم باز",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "جانب بتخانه رف تند از نیاز",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "آن عمل دیدند گفتند این فتن",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "کار ابراهیم باشد بی سخن",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "پس به سویش رو نمودند از شتاب",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "سوی نمرودش ببردند از عتاب",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "شرح آن را پیش گفتیم از مقال",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "پس به او کردند آغاز جدال",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "گفت آیا می پرستید از فساد",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "آنچه را خود می تراشید از جماد",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "مر شما را آفریده است آن خدا",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "وآنچه می سازید خود با دستها",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "گشت پس نمرود ملزم با خواص",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "شبهه لیکن تا کند بر عام و خاص",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "مر بناء گفتند بنیانی کنید",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "بهر هیزم پس به نارش افکنید",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "خواستند از بهر او کیدی دگر",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "پس بگرداندیمشان بر زیرتر",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 60,
      "Position": "Right",
      "Text": "ساختیم اعنی که باطل مکرشان",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "شد گلستان نار پر تاب و دخان",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    }
  ]
}
