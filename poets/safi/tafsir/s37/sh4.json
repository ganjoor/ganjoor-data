      "HtmlText": "\u003Cdiv class=\u0022b\u0022 id=\u0022bn1\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eپس ز بهر مثل این باید عمل\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eعاملان را باشد اندر هر محل\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E",
      "CoupletsCount": 1
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "إِلاّٰ عِبٰادَ اَللّٰهِ اَلْمُخْلَصِینَ (۴۰) أُولٰئِکَ لَهُمْ رِزْقٌ مَعْلُومٌ (۴۱) فَوٰاکِهُ وَ هُمْ مُکْرَمُونَ (۴۲) فِی جَنّٰاتِ‌ اَلنَّعِیمِ (۴۳) عَلیٰ سُرُرٍ مُتَقٰابِلِینَ (۴۴) یُطٰافُ عَلَیْهِمْ بِکَأْسٍ مِنْ مَعِینٍ (۴۵) بَیْضٰاءَ لَذَّةٍ لِلشّٰارِبِینَ (۴۶) لاٰ فِیهٰا غَوْلٌ وَ لاٰ هُمْ عَنْهٰا یُنْزَفُونَ (۴۷) وَ عِنْدَهُمْ قٰاصِرٰاتُ اَلطَّرْفِ عِینٌ (۴۸) کَأَنَّهُنَّ بَیْضٌ مَکْنُونٌ (۴۹) فَأَقْبَلَ بَعْضُهُمْ عَلیٰ بَعْضٍ یَتَسٰاءَلُونَ (۵۰) قٰالَ قٰائِلٌ مِنْهُمْ إِنِّی کٰانَ لِی قَرِینٌ (۵۱) یَقُولُ أَ إِنَّکَ لَمِنَ اَلْمُصَدِّقِینَ (۵۲) أَ إِذٰا مِتْنٰا وَ کُنّٰا تُرٰاباً وَ عِظٰاماً أَ إِنّٰا لَمَدِینُونَ (۵۳) قٰالَ هَلْ أَنْتُمْ مُطَّلِعُونَ (۵۴) فَاطَّلَعَ فَرَآهُ فِی سَوٰاءِ اَلْجَحِیمِ (۵۵) قٰالَ تَاللّٰهِ إِنْ کِدْتَ لَتُرْدِینِ (۵۶) وَ لَوْ لاٰ نِعْمَةُ رَبِّی لَکُنْتُ مِنَ اَلْمُحْضَرِینَ (۵۷) أَ فَمٰا نَحْنُ بِمَیِّتِینَ (۵۸) إِلاّٰ مَوْتَتَنَا اَلْأُولیٰ وَ مٰا نَحْنُ بِمُعَذَّبِینَ (۵۹) إِنَّ هٰذٰا لَهُوَ اَلْفَوْزُ اَلْعَظِیمُ (۶۰) لِمِثْلِ هٰذٰا فَلْیَعْمَلِ اَلْعٰامِلُونَ (۶۱)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "مگر بندگان خدا که خالص‌کرده‌شدگانند (۴۰) آنها مر ایشان‌راست روزی معلوم (۴۱) میوه‌ها و ایشانند گرامی‌داشتگان (۴۲) در بهشتهای با ناز و نعمت (۴۳) بر تختهای روی بروی یکدیگر (۴۴) بگردش درآورده می‌شود بر ایشان پیاله از شراب جاری (۴۵) سفید که لذت است مر آشامندگان را (۴۶) نه در آنست فسادی و نه ایشان از آن مست می‌شوند (۴۷) و نزد ایشانست زنان فرو هشته چشم فراخ حدقه (۴۸) گویا ایشان بیضهای شترمرغ در ساتر نگهداشته‌اند (۴۹) پس روی آورند بعضیشان بر بعضی می‌پرسند از یکدیگر (۵۰) گفت گوینده از ایشان بدرستی که بود مرا هم‌نشینی (۵۱) که می‌گفت آیا تو هر آینه از تصدیق‌کنندگانی (۵۲) که آیا چون بمیریم و بشویم خاکی و استخوانهایی آیا مائیم هر آینه جزاداده‌شدگان (۵۳) گفت آیا شمائید فرو نگرندگان (۵۴) پس فرا نگریست پس دید او را در میانه دوزخ (۵۵) گفت بخدا که هر آینه نزدیک بود که هلاک گردانی مرا (۵۶) و اگر نبود نعمت پروردگارم هر آینه بودم از احضارکرده‌شدگان (۵۷) آیا پس نباشیم ما مردگان (۵۸) جز مردنمان نخست و نباشیم ما عذاب‌کرده‌شدگان (۵۹) بدرستی که اینست هر آینه آن کامیابی بزرگ (۶۰) برای مثل این پس باید بکنند کنندگان (۶۱)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "جز عباد االله مخلص کاین گروه",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "رزق معلوم استشان نیک از وجوه",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "رزق دانسته شده آن میوه هاست",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "که به هر دم لذتی آن را جداست",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "حظّ معنی ز آکل آن عاید شود",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "نی که از آن قوّتی زاید شود",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "مُکْرَمُونند آن جماعت بی ز بیم",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "در بهشت بی زوال پر نعیم",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "متکی بر تختها با صد مراد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "رو به روی یکدگر بنشسته شاد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "هست در گردش ز دست حور عین",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "هر دم ایشان را بِکَأسٍ مِّن معِین",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "باشد آن خمری گوارا و سفید",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "لذت آشامندگان را زآن مزید",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "خود فساد و آفتی نبود بر آن",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "سستی ای نارد بر آشامندگان",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "عِندَهُم وَ قَاصِرَاتُ الطَّرْفِ عِین",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "کَأنَّهُنَّ بَیض مکْنُونٌ مکین",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "کرده بر تخم شتر مرغ او شبیه",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "روی حوران از دو وجه بس وجیه",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "زآن یکی کاندک به زردی مایل است",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "وآن صباحت را نشانی کامل است",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "وجه دیگر که شتر مرغ از تمام",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "بیضه را پوشد به زیر پر مدام",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "روی خود پوشند هم حوران چنین",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "از عفاف اندر دو زلف عنبرین",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "رو به بعض آرند بعضی بی ملال",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "می کنند از حال یکدیگر سئوال",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "زآنچه حقشان کرده اکرام آن دگر",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "صاحب خود را دهد از آن خبر",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "گوید آن گوینده ای ز ایشان که من",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "در جهان بودم قرینی بد سخن",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "که بُد او خود منکر بعث و نشور",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "داشتی ز احسان مرا پیوسته دور",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "سرزنش می کرد و می گفت او عیان",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "که تویی آیا ز باور کردگان",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "چونکه ما آیا بمیریم و شویم",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "خاک ناچیزی و یا عظم رمیم",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "بعد از آن آیا جزاء داده دگر",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "ما شویم، از عقل دور است این خبر",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "با رفیقان گوید او آیا شما",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "آگهید از وی که باشد در کجا",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "یا که این گوینده باشد ذوالجلال",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "یا که یک افرشتۀ نیکو خصال",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "پس ببین او را، پس او می بنگرد",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "در میان دوزخش با حال بد",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "گوید او را تااالله این نزدیک بُد",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "که مرا سازی هلاک از گفت خود",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "بخشش حق گر نبودم در نهان",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "با تو می بودم ز حاضر گشتگان",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "نیستیم از مردگان آیا که ما",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "اندر اینجا زنده گشتیم از کجا",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "تو نمی گفتی که جز موت نخست",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "نیست ما را هیچ موت از سخت و سست",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "هم نباشد هیچ بهر ما عذاب",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "هم نه برخیزیم در حشر و حساب",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "این چنین نعمت که بر ما شد عطا",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "رستگاری بزرگ است از خدا",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "پس ز بهر مثل این باید عمل",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "عاملان را باشد اندر هر محل",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    }
  ]
}
