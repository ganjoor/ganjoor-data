      "Text": "تُرْجِی مَنْ تَشٰاءُ مِنْهُنَّ وَ تُؤْوِی إِلَیْکَ مَنْ تَشٰاءُ وَ مَنِ اِبْتَغَیْتَ مِمَّنْ عَزَلْتَ فَلاٰ جُنٰاحَ عَلَیْکَ ذٰلِکَ أَدْنیٰ أَنْ تَقَرَّ أَعْیُنُهُنَّ وَ لاٰ یَحْزَنَّ وَ یَرْضَیْنَ بِمٰا آتَیْتَهُنَّ کُلُّهُنَّ وَ اَللّٰهُ یَعْلَمُ مٰا فِی قُلُوبِکُمْ وَ کٰانَ اَللّٰهُ عَلِیماً حَلِیماً (۵۱) لاٰ یَحِلُّ لَکَ اَلنِّسٰاءُ مِنْ بَعْدُ وَ لاٰ أَنْ تَبَدَّلَ بِهِنَّ مِنْ أَزْوٰاجٍ وَ لَوْ أَعْجَبَکَ حُسْنُهُنَّ إِلاّٰ مٰا مَلَکَتْ یَمِینُکَ وَ کٰانَ اَللّٰهُ عَلیٰ کُلِّ شَیْ‌ءٍ رَقِیباً (۵۲)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "باز پس می‌داری آن را که خواهی از ایشان و جای می‌دهی بسوی خود آن را که می‌خواهی و آن را که خواستی از آنان که عزل کردی پس نیست گناهی بر تو این نزدیکتر است با آنکه آرام گیرد چشمهاشان و غمگین نشوند و خوشنود گردند بآنچه دادی ایشان را همه ایشان و خدا می‌داند آنچه در دلهای شماست و باشد خدا دانای بردبار (۵۱) حلال نمی‌شود مر ترا از نان از بعد و نه اینکه بدل کنی ایشان را بجفتهایی و اگر چه خوش آمده باشد ترا حسنشان جز آنچه مالک شد یمین تو و باشد خدا بر همه چیزی نگهبان (۵۲)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "باز پس داری کنی ترک از نسا",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "هر که را خواهی ز تُرْجِی مَن تَشَآء",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "سوی خود وآن را که خواهی جا دهی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "هم به خود منضم کنی مأوی دهی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "یا دهی آن را که می خواهی طلاق",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "وآنکه را خواهی بمانی در وثاق",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "می کنی بازش به دل جویی طلب",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "آنکه را کردی کناره زو عجب",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "بر تو پس نبود گناهی یا قصور",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "گر به خود نزدیک سازی یا که دور",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "این بود نزدیک تر در هر مقام",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "چشمهاشان تا شود روشن تمام",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "نیستشان اندوه و حزنی، راضیند",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "آنچه بدهیشان بدون چون و چند",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "چونکه دانستند حکمت مستوی است",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "کس به عزلت و ابتغاء مخصوص نیست",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "حق بداند آنچه در قلب شماست",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "چون علیم و بردبار آن ذوالعطاست",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "بعد از این نُه زن تو را نبود حلال",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "مر زنان دیگر اندر اشتغال",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "هم حلال آن نیست تا سازی بَدل",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "بر زن دیگر یکی را در محل",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "حسنشان چند آردت گر در شگفت",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "غیر از این نُه زن دگر نتوان گرفت",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "جز که مالک گشته دستت در نصیب",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "حق به هر چیزی است تا دانی رقیب",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "فرقه ای دانند نسخ این آیه را",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "تا چه باشد اصل آن داند خدا",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    }
  ]
}
