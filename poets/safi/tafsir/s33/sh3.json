  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "اَلنَّبِیُّ أَوْلیٰ بِالْمُؤْمِنِینَ مِنْ أَنْفُسِهِمْ وَ أَزْوٰاجُهُ أُمَّهٰاتُهُمْ وَ أُولُوا اَلْأَرْحٰامِ بَعْضُهُمْ أَوْلیٰ بِبَعْضٍ فِی کِتٰابِ اَللّٰهِ مِنَ اَلْمُؤْمِنِینَ وَ اَلْمُهٰاجِرِینَ إِلاّٰ أَنْ تَفْعَلُوا إِلیٰ أَوْلِیٰائِکُمْ مَعْرُوفاً کٰانَ ذٰلِکَ فِی اَلْکِتٰابِ مَسْطُوراً (۶) وَ إِذْ أَخَذْنٰا مِنَ اَلنَّبِیِّینَ مِیثٰاقَهُمْ وَ مِنْکَ وَ مِنْ نُوحٍ وَ إِبْرٰاهِیمَ وَ مُوسیٰ وَ عِیسَی اِبْنِ مَرْیَمَ وَ أَخَذْنٰا مِنْهُمْ مِیثٰاقاً غَلِیظاً (۷) لِیَسْئَلَ اَلصّٰادِقِینَ عَنْ صِدْقِهِمْ وَ أَعَدَّ لِلْکٰافِرِینَ عَذٰاباً أَلِیماً (۸)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "نبی اولاست بمؤمنان از خودهاشان و جفتهایش مادران ایشانند و صاحبان رحمها بعضیشان اولی باشند ببعضی در کتاب خدا از مؤمنان و مهاجران مگر آنکه بکنید بدوستانتان خوبی را باشد آن در کتاب نوشته شده (۶) و هنگامی که گرفتیم از پیغمبران پیمانشان را و از تو و از نوح و ابراهیم و موسی و عیسی پسر مریم و گرفتیم از ایشان پیمانی سخت (۷) تا بپرسد راستگویان را از راستیشان و آماده کرده از برای کافران عذابی دردناک (۸)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "که نبی اولی بود بر مؤمنان",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "از نفوس مؤمنان در مال و جان",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "هم زنانش اُمّهاتند آنچه هست",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "از ره تحریم بر عالی و پست",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "هم اولوالارحام در میراث ها",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "اولیند از بعض، بعضی ز امر ما",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "هست اندر لوح محفوظ این چنین",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "یا که در قرآن و احکام مبین",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "ز اهل ایمان و ز هجرت کردگان",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "اقربند ارحام ز ایشان در نشان",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "جز وصیّت کرده باشید از عطاء",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "چیزی از مال از برای اولیاء",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "این بود مسطور و ثابت در کتاب",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "علم حق یعنی بر این است از صواب",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "یاد کن چون ما گرفتیم ای رسول",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "از نبیّین عهد ایمان و قبول",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "از تو و از نوح و ابراهیم راد",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "موسی و عیسی ابن مریم در عداد",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "که اولوالعزمید و اندر انبیاء",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "خاص در تأکید میثاق ولاء",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "ما از ایشان جمله بگرفتیم باز",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "عهد و میثاق مؤکّد ز اعتزاز",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "تا بپرسد ز اهل صدق از صدقشان",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "نزد پاس عهد اندر هر نشان",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "کرد بهر کافران آماده هم",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "مر عذابی دردناک و پر نقم",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    }
  ]
}
