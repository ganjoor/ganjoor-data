      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "نگردانیده خدا برای مردی هیچ دو دل در درونش و نگردانیده جفتهای شما را که اظهار می‌کنید از ایشان مادرانتان و نگردانیده پسر خوانده‌های شما را پسرانتان آن گفتار شماست بدهنهاتان و خدا می‌گوید راست و او هدایت می‌کند راه را (۴) بخوانید ایشان را بپدرانشان که آن دوست‌تر است نزد خدا پس اگر پدرانشان را پس برادران شمایند در دین و دوستان شما و نیست بر شما گناهی در آنچه خطا کردید در آن و لیکن آنچه را تعمد کند دلهاتان و باشد خدا آمرزنده مهربان (۵)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "نافریده بهر مردی حق دو دل",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "در درونش بر دو حیث آن مستقل",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "از دلی تا بر حق او کافر شود",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "هم موحد با دل دیگر شود",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "گفته اند این بر مثل فرموده است",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "در عرب یا این مثالی بوده است",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "کآن چنان که نیست دو دل در رجال",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "بهر یک زن هم شد این معنی محال",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "که بود هم جفت کس هم مادرش",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "تا حرام آید از این بر شوهرش",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "حق زنانتان را نگرداند امّهات",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "که ظهار آرید از ایشان در حیات",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "هم پسر خوانده نباشد چون پسر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "عارضی نبود چو اصلی در اثر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "بُد ظهار اندر عرب بالاتفاق",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "هم در آن ایّام در حکم طلاق",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "هم پسر خوانده بُدی میراث بر",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "همچو فرزندان اصلی از پدر",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "گفت حق نبود دو دل در یک درون",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "زوجه هم مادر نگردد از فسون",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "هم پسر خوانده که از دیگر پدر",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "باشد او نبود به واقع او پسر",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "در دهانها این مقالات شماست",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "وآنچه فرماید خدا حق است و راست",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "باشد از کنه امور آگاه او",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "بر طریق حق نماید راه او",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "آمد این در حق زید حارثه",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "این چنین بوده است شرح حادثه",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Paragraph",
      "Text": "« در بیان ذکر حال زید ابن حارثه »",
      "CoupletIndex": 16
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "زید بنده بود از روی خبر",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "مر ورا بخریده بُد خیر البشر",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "بر نبوّت شد چو مبعوث آن رسول",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "کرد اسلام او ز پیغمبر قبول",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "حارثه پس با ابوطالب بگفت",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "گو برادر زاده ات را در نهفت",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "که نماید زید را آزاد او",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "یا که بفروشد به زر بی گفتگو",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "پس پیمبر گفت آسوده است زید",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "هر کجا خواهد رود بی بند و قید",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "او نرفت و نامد از خدمت ملول",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "دوستی بس بود او را با رسول",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "حارثه گفت او نه فرزند من است",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "گفت پیغمبر که دلبند من است",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "من ورا دارم به فرزندی قبول",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "زآن ورا خواندند زید ابن رسول",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "زوجۀ خود را چو زید اندر وثاق",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "داد او از روی ناخواهی طلاق",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "بود زینب بنت جحش اندر به نام",
      "CoupletIndex": 26,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "در نکاح آوردش آن فخر انام",
      "CoupletIndex": 26,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "آن جحودان و منافق پیشگان",
      "CoupletIndex": 27,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "طعنه هر کس می زدی بر وی از آن",
      "CoupletIndex": 27,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "کو زن فرزند آرد در نکاح",
      "CoupletIndex": 28,
      "SectionIndex1": 1,
      "SectionIndex2": 14
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "نهی ما وآنگه کند زین افتضاح",
      "CoupletIndex": 28,
      "SectionIndex1": 1,
      "SectionIndex2": 14
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "گفت حق نبود پسر خوانده پسر",
      "CoupletIndex": 29,
      "SectionIndex1": 1,
      "SectionIndex2": 15
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "لغو باشد این سخنها سر به سر",
      "CoupletIndex": 29,
      "SectionIndex1": 1,
      "SectionIndex2": 15
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "خود شما گویید حرفی از فضول",
      "CoupletIndex": 30,
      "SectionIndex1": 1,
      "SectionIndex2": 16
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "حق تعالی داند اسرار و اصول",
      "CoupletIndex": 30,
      "SectionIndex1": 1,
      "SectionIndex2": 16
    },
    {
      "VOrder": 60,
      "Position": "Right",
      "Text": "بر پدرهاشان اگر خوانید هین",
      "CoupletIndex": 31,
      "SectionIndex1": 1,
      "SectionIndex2": 17
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "راست تر باشد به نزد حق یقین",
      "CoupletIndex": 31,
      "SectionIndex1": 1,
      "SectionIndex2": 17
    },
    {
      "VOrder": 62,
      "Position": "Right",
      "Text": "ور پدرهاشان ندانید این نکوست",
      "CoupletIndex": 32,
      "SectionIndex1": 1,
      "SectionIndex2": 18
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "که به دین خوانیدشان اخوان و دوست",
      "CoupletIndex": 32,
      "SectionIndex1": 1,
      "SectionIndex2": 18
    },
    {
      "VOrder": 64,
      "Position": "Right",
      "Text": "بر شما نبود گناهی زآن خطاء",
      "CoupletIndex": 33,
      "SectionIndex1": 1,
      "SectionIndex2": 19
    },
    {
      "VOrder": 65,
      "Position": "Left",
      "Text": "که از آن جاهل بُدید از ابتداء",
      "CoupletIndex": 33,
      "SectionIndex1": 1,
      "SectionIndex2": 19
    },
    {
      "VOrder": 66,
      "Position": "Right",
      "Text": "زآنکه یعنی زید را از پیش از این",
      "CoupletIndex": 34,
      "SectionIndex1": 1,
      "SectionIndex2": 20
    },
    {
      "VOrder": 67,
      "Position": "Left",
      "Text": "خوانده اید اولاد خیر المرسلین",
      "CoupletIndex": 34,
      "SectionIndex1": 1,
      "SectionIndex2": 20
    },
    {
      "VOrder": 68,
      "Position": "Right",
      "Text": "ور ز نسیان یا که از سبق لسان",
      "CoupletIndex": 35,
      "SectionIndex1": 1,
      "SectionIndex2": 21
    },
    {
      "VOrder": 69,
      "Position": "Left",
      "Text": "بعد از این خوانید جرمی نی در آن",
      "CoupletIndex": 35,
      "SectionIndex1": 1,
      "SectionIndex2": 21
    },
    {
      "VOrder": 70,
      "Position": "Right",
      "Text": "لیک جرم است ار که دلهاتان کند",
      "CoupletIndex": 36,
      "SectionIndex1": 1,
      "SectionIndex2": 22
    },
    {
      "VOrder": 71,
      "Position": "Left",
      "Text": "قصد آنچه نهی اش آمد در سند",
      "CoupletIndex": 36,
      "SectionIndex1": 1,
      "SectionIndex2": 22
    },
    {
      "VOrder": 72,
      "Position": "Right",
      "Text": "حق بود آمرزگار و مهربان",
      "CoupletIndex": 37,
      "SectionIndex1": 1,
      "SectionIndex2": 23
    },
    {
      "VOrder": 73,
      "Position": "Left",
      "Text": "هم به صاحب عمد کآرد توبه آن",
      "CoupletIndex": 37,
      "SectionIndex1": 1,
      "SectionIndex2": 23
    },
    {
      "VOrder": 74,
      "Position": "Right",
      "Text": "در تبوک، امر از نبی شد کز مقر",
      "CoupletIndex": 38,
      "SectionIndex1": 1,
      "SectionIndex2": 24
    },
    {
      "VOrder": 75,
      "Position": "Left",
      "Text": "هر کسی بیرون رود سوی سفر",
      "CoupletIndex": 38,
      "SectionIndex1": 1,
      "SectionIndex2": 24
    },
    {
      "VOrder": 76,
      "Position": "Right",
      "Text": "پاره ای گفتند ما از والدین",
      "CoupletIndex": 39,
      "SectionIndex1": 1,
      "SectionIndex2": 25
    },
    {
      "VOrder": 77,
      "Position": "Left",
      "Text": "اذن گیریم آمد این آیت به عین",
      "CoupletIndex": 39,
      "SectionIndex1": 1,
      "SectionIndex2": 25
    }
  ]
}
