      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "یٰا أَیُّهَا اَلَّذِینَ آمَنُوا إِذٰا نَکَحْتُمُ اَلْمُؤْمِنٰاتِ ثُمَّ طَلَّقْتُمُوهُنَّ مِنْ قَبْلِ أَنْ تَمَسُّوهُنَّ فَمٰا لَکُمْ عَلَیْهِنَّ مِنْ عِدَّةٍ تَعْتَدُّونَهٰا فَمَتِّعُوهُنَّ وَ سَرِّحُوهُنَّ سَرٰاحاً جَمِیلاً (۴۹) یٰا أَیُّهَا اَلنَّبِیُّ إِنّٰا أَحْلَلْنٰا لَکَ أَزْوٰاجَکَ اَللاّٰتِی آتَیْتَ أُجُورَهُنَّ وَ مٰا مَلَکَتْ یَمِینُکَ مِمّٰا أَفٰاءَ اَللّٰهُ عَلَیْکَ وَ بَنٰاتِ عَمِّکَ وَ بَنٰاتِ عَمّٰاتِکَ وَ بَنٰاتِ خٰالِکَ وَ بَنٰاتِ خٰالاٰتِکَ اَللاّٰتِی هٰاجَرْنَ مَعَکَ وَ اِمْرَأَةً مُؤْمِنَةً إِنْ وَهَبَتْ نَفْسَهٰا لِلنَّبِیِّ إِنْ أَرٰادَ اَلنَّبِیُّ أَنْ یَسْتَنْکِحَهٰا خٰالِصَةً لَکَ مِنْ دُونِ اَلْمُؤْمِنِینَ قَدْ عَلِمْنٰا مٰا فَرَضْنٰا عَلَیْهِمْ فِی أَزْوٰاجِهِمْ وَ مٰا مَلَکَتْ أَیْمٰانُهُمْ لِکَیْلاٰ یَکُونَ عَلَیْکَ حَرَجٌ وَ کٰانَ اَللّٰهُ غَفُوراً رَحِیماً (۵۰)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "ای آن کسانی که ایمان آوردید چون نکاح کنید زنان با ایمان را پس طلاق دهید آنان را پیش از آنکه مس کنید ایشان را پس نیست مر شما را بر آنها هیچ عده که بشمار در آرید آن را پس متاعی دهید آنها را و رها کنید ایشان را رها کردنی نیکو (۴۹) ای پیغمبر بدرستی که ما حلال گردانیدیم برای تو جفتهایت را که دادی آنها را مهرهاشان و آنچه را مالک شد یمینت از آنچه غنیمت گردانید خدا بر تو و دختران عمت را و دختران عمه‌هایت را و دختران خالت را و دختران خالهایت را آنان که هجرت گزیدند با تو و زنان با ایمان را اگر بخشد نفسش را مر نبی اگر خواهد پیغمبر که نکاح کند آن را خاص است مر ترا از غیر مؤمنان بتحقیق دانسته‌ایم آنچه را فرض گردانیدیم بر ایشان در جفتهاشان و آنچه مالک شد یمینهاشان تا نبودۀ باشد بر تو تنگ و باشد خدا آمرزنده مهربان (۵۰)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ای گروه مؤمنان چون از صلاح",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "مر زنان را آورید اندر نکاح",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "پس شما بدهید ایشان را طلاق",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "پیش از آنکه مَس کنید اندر سیاق",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "پس بر ایشان مر شما را عدّه نیست",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "تا که بشمارند کآن بر چند و چیست",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "می تواند شد به شوهر در زمان",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "موعدی نبود بر او هیچ از عیان",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "ور که در عقد نکاح او ذکر مَهر",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "می نکرده بایدش هم داد بهر",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "مَتِّعُوهُنَّ دهیدش مُتعه پس",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "چیزی اعنی قدر وسع از مال بس",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "مُتعه در عقدی بود که ذکر مَهر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "می نگشته تا بود معلوم بهر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "ور که گشتی ذکر نصف مَهر را",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "داد باید بر زن از روی رضا",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "سَرِّحُوهُنَّ رها یعنی کنید",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "چونکه ایشان را به نیکی ره زنید",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "بی ز ایذا و ملالت از حرم",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "باید ایشان را برون سازید هم",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "بر تو کردیم ای پیمبر ما حلال",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "جفتهایت کاجرشان دادی ز مال",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "وآنچه را که گشته مالک دست هات",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "وز غنایم بازگردانده خدات",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "دختران عمّ، بنات عمّه ها",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "هم بنات خال و خالات آن تو را",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "شد حلال آنانکه هجرت کرده اند",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "در مدینه با تو و اندر پرده اند",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "نازل این آیت همانا پیش بُد",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "شرط هجرت بعد از آن منسوخ شد",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "اَمّها نی گفته مخطوبۀ رسول",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "چون شدم من یافت این آیت نزول",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "پس به من گفتا تویی بر من حرام",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "چون نکردی هجرت از شهر و مقام",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "نفس خود را ور زنی ز اهل صلاح",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "بر نبی بخشد گر او خواهد نکاح",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "بی ز عقد و مَهر می باشد حلال",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "بر تو آن زن گر که خواهی بی سئوال",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "گر که خالص باشد آن بخشیدنش",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "بر تو یا خاص است و خالص دیدنش",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "این است مخصوص تو غیر از مؤمنین",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "خارج ایشانند از امری چنین",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "شرح این احکام بر وجه وجیه",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "جو به تفصیل از شرایع وز فقیه",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "قصد ما تفسیر اصل آیت است",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "شرح آن در فقه ثبت از حجت است",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "فقه باشد غیر تفسیر کلام",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "اهل فقه آن را شناسد از تمام",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "جمله ما دانسته ایم اندر نشان",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "فرض کردیم آنچه در ازواجشان",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "دستهاشان وآنچه را مالک شده است",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "شرح آن در فقه یکجا آمده است",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "تا حرج نبود تو را اندر نکاح",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "آنچه گیری بر تو می باشد مباح",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "چار زن در عقد بهر امّت است",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "بر تو در ازواج از حق وسعت است",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "حق بود آمرزگار و مهربان",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "زآنچه عسرت باشد آن بر بندگان",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    }
  ]
}
