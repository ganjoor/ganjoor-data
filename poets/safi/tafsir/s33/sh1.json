      "HtmlText": "\u003Cdiv class=\u0022b\u0022 id=\u0022bn1\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eکن توکل بر خدا اندر سبیل\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eبس بود او وَکَفَی بِااللهِ وَکِیل\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E",
      "CoupletsCount": 1
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "بسم االله الرحمن الرحیم",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "یٰا أَیُّهَا اَلنَّبِیُّ اِتَّقِ اَللّٰهَ وَ لاٰ تُطِعِ اَلْکٰافِرِینَ وَ اَلْمُنٰافِقِینَ إِنَّ اَللّٰهَ کٰانَ عَلِیماً حَکِیماً (۱) وَ اِتَّبِعْ مٰا یُوحیٰ إِلَیْکَ مِنْ رَبِّکَ إِنَّ اَللّٰهَ کٰانَ بِمٰا تَعْمَلُونَ خَبِیراً (۲) وَ تَوَکَّلْ عَلَی اَللّٰهِ وَ کَفیٰ بِاللّٰهِ وَکِیلاً (۳)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "بنام خداوند بخشاینده مهربان",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Paragraph",
      "Text": "ای پیغمبر بپرهیز از خدا و اطاعت مکن کافران و منافقان را بدرستی که خدا باشد دانای درست کردار (۱) و پیروی مکن وحی کرده می‌شود بتو از پروردگارت بدرستی که خدا باشد به آنچه می‌کنید آگاه (۲) و توکل کن بر خدا و کافیست خدا کارگزار مهمات (۳)",
      "CoupletIndex": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "بعد بسم االله گشایم باب را",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "در حقایق سورة احزاب را",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "مشرکان گفتند بر لات و منات",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "هل تو ما را ای رسول با ثبات",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "گو بتان هم در قیامت شافعند",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "بهر ما اندر پرستش نافعند",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "هم تو را ما واگذاریم از ولا",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "تا کنی طاعت خدای خویش را",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "این سخن شد بر پیمبر سخت شاق",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "رو به هم بکشید از اهل شقاق",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "گفت او را یک، دورویی بیادب",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "که شنو این حرف ز اشراف عرب",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "واگذار این قوم را بر دین خود",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "باش تو بر کیش و بر آئین خود",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "گفت فاروق ای رسول رشک ناک",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "اذن ده تا سازم ایشان را هلاک",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "گفت نبود نقض عهد از ما درست",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "چون امان دادیمشان اندر نخست",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "آمد آیت کاتَّقِ االله ای نبی",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "سخت و ثابت باش در ره ای نبی",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "می مبر از مشرکان و اهل نفاق",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "هیچ تو فرمان وز ایشان باش طاق",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "حق به گفتار عدو باشد علیم",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "هم بر اصلاح مفاسد او حکیم",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "پیروی کن آنچه از پروردگار",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "بر تو آید وحی در هر فعل و کار",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "زآنکه بر هر چه کنید اندر فعال",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "آگه است آن کردگار ذوالجلال",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "کن توکل بر خدا اندر سبیل",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "بس بود او وَکَفَی بِااللهِ وَکِیل",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    }
  ]
}
