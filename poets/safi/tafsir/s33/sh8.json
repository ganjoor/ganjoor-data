      "VOrder": 26,
      "Position": "Right",
      "Text": "شد سوار از شهر بیرون رفت و گفت",
      "CoupletIndex": 14,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "هر که جانش با عنایت هاست جفت",
      "CoupletIndex": 14,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "ز امر حق باید گذارد وقت عصر",
      "CoupletIndex": 15,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "او نماز اندر قریظه هم به حصر",
      "CoupletIndex": 15,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "شرحش از تاریخ برخوان تا که چیست",
      "CoupletIndex": 16,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "ذکر آن لازم در این تفسیر نیست",
      "CoupletIndex": 16,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "مردهاشان کشته شد زنها اسیر",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "دفع خون فاسد از تن کن بگیر",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "حق تعالی آورد مانا فرود",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "پشت احزاب آنکه کُشتند از یهود",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "عهد پیغمبر شکستند از حسد",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "آمدند اعدای او را بر مدد",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "از قلاع و حصنشان آورد زیر",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "رعبشان افکند در قلب و ضمیر",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "فرقه ای شد کشته یعنی از رجال",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "فرقه ای هم شد اسیر از سوء حال",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "ارض و اموال و دیار آن گروه",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "حق شما را داد میراث از وجوه",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "هم زمینی را که ننهادید گام",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 14
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "مالک آن یا نبودید از مقام",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 14
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "خیبران یا فارس باشد یا که روم",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 15
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "یا زمینی کآن نشد فتح از هجوم",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 15
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "یعنی آن ارضی که اندر فتح باب",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 16
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "خود بنگرفتید با خیل و رکاب",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 16
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "حق توانا باشد او بر کلّ شیء",
      "CoupletIndex": 26,
      "SectionIndex1": 1,
      "SectionIndex2": 17
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "باشد این تسخیر سهل از حکم وی",
      "CoupletIndex": 26,
      "SectionIndex1": 1,
      "SectionIndex2": 17
    }
  ]
}
