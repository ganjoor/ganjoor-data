      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "زنده اندر گور کردی از چه راه",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "من پناه از هر بدی جویم به رب",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "خاصه زآن کآید حق از وی در غضب",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "وآن بود دور از خصال آدمی",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "خصلت دیو و دد است آن خود همی",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 31,
      "Position": "Paragraph",
      "Text": "« مناجات »",
      "CoupletIndex": 17
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "ای خدا ز افعال دیو دل سیاه",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "بر جناب خود صفی را ده پناه",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "گر تو خواهی آدمی را دد کنی",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "باب دانش را به رویش سد کنی",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "بل ز دیو او را کنی بدبخت تر",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "هم ز مار و اژدها دل سخت تر",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "وآن نباشد ای مسبب بی سبب",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "پس پناه از آن سبب گیرم به رب",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "مار و افعی بچۀ خود کی کشد",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "این قدر دارد ز دانایی رشد",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "حق بپرسد زو که ای بدبخت کور",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "از چه کردی زنده دختر را به گور",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "جملگی بگشوده گردد نامه ها",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "از عملها اندر آن هنگامه ها",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "آسمان برکنده آن دم ز امر اوست",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "برکَنند آنسان که از مذبوح پوست",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "دوزخ آن ساعت شود افروخته",
      "CoupletIndex": 26,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "هم ز اهل شرک و ظلم اندوخته",
      "CoupletIndex": 26,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "می شود نزدیک وآن دم که بهشت",
      "CoupletIndex": 27,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "بر هر آن صافی دل روشن سرشت",
      "CoupletIndex": 27,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "می بداند نفس هر کس از بشر",
      "CoupletIndex": 28,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "آنچه حاضر کرده است از خیر و شرّ",
      "CoupletIndex": 28,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    }
  ]
}
