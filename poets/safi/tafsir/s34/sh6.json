      "Text": "فَقٰالُوا رَبَّنٰا بٰاعِدْ بَیْنَ أَسْفٰارِنٰا وَ ظَلَمُوا أَنْفُسَهُمْ فَجَعَلْنٰاهُمْ أَحٰادِیثَ وَ مَزَّقْنٰاهُمْ کُلَّ مُمَزَّقٍ إِنَّ فِی ذٰلِکَ لَآیٰاتٍ لِکُلِّ صَبّٰارٍ شَکُورٍ (۱۹) وَ لَقَدْ صَدَّقَ عَلَیْهِمْ إِبْلِیسُ ظَنَّهُ فَاتَّبَعُوهُ إِلاّٰ فَرِیقاً مِنَ اَلْمُؤْمِنِینَ (۲۰) وَ مٰا کٰانَ لَهُ عَلَیْهِمْ مِنْ سُلْطٰانٍ إِلاّٰ لِنَعْلَمَ مَنْ یُؤْمِنُ بِالْآخِرَةِ مِمَّنْ هُوَ مِنْهٰا فِی شَکٍّ وَ رَبُّکَ عَلیٰ کُلِّ شَیْ‌ءٍ حَفِیظٌ (۲۱)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "پس گفتند پروردگار ما دوری افکن میانه سفرهای ما و ستم کردند بر خودهاشان و گردانیدیمشان حکایتها و پراکنده کردیمشان هر پراکنده کردنی بدرستی که در آن هر آینه آیتهاست مر هر شکیبای شکرگزار (۱۹) و بحقیقت راست گردانید بر ایشان ابلیس گمانش را پس پیروی کردند او را جز پاره از گروندگان (۲۰) و نبود مر او را بر ایشان هیچ تسلطی مگر برای آنکه بدانیم آن را می‌گرود بآخرت از آنکه او از آن در شک است و پروردگار تو بر همه چیز نگهبان است (۲۱)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "پس بگفتند اغنیاشان ربّنا",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "دوری افکن بین منزلهای ما",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "تا که نتواند کند مردی سفر",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "بی ز زاد و راحله هیچ از مقر",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "پس ستم کردند بر خود زین دعا",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "یا که زین کفران نعمت های ما",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "پس بگرداندیمشان تا از عجب",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "هر کسی گوید سخنهاشان به لب",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "شد خراب آن قریه ها اندر زمن",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "که میان شام بود آن تا یمن",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "خلق تا گفتند از ضرب المثل",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "شد سباء را عیش بر عُسرت بَدل",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "پس پراکندیم ایشا ن را چنان",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "که نیاید آن تفرّق در بیان",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "اندر این باشد نشانها بر حضور",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "مر کسی را کوست صبّار و شکور",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "پس بر ایشان ظنّ خود را کرد راست",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "دیو کز بهر بشر این فتنه خواست",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "پیروی کردند او را پس عیان",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "جز گروهی از خواص مؤمنان",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "می نبود او را بر ایشان حجتی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "یا که استیلاء به گاه دعوتی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "جز که دانیم و کنیم او را جدا",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "که بود ایمانش بر دیگر سرا",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "از کسی که باشد از آن در گمان",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "یعنی از حشر و حساب اندر نشان",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "باشد آن پروردگار از فوق و پست",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "مر نگهبان بر هر آن چیزی که هست",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    }
  ]
}
