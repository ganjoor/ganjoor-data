  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "بسم االله الرحمن الرحیم",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "اَلْحَمْدُ لِلّٰهِ اَلَّذِی لَهُ مٰا فِی اَلسَّمٰاوٰاتِ وَ مٰا فِی اَلْأَرْضِ وَ لَهُ اَلْحَمْدُ فِی اَلْآخِرَةِ وَ هُوَ اَلْحَکِیمُ اَلْخَبِیرُ (۱) یَعْلَمُ مٰا یَلِجُ فِی اَلْأَرْضِ وَ مٰا یَخْرُجُ مِنْهٰا وَ مٰا یَنْزِلُ مِنَ اَلسَّمٰاءِ وَ مٰا یَعْرُجُ فِیهٰا وَ هُوَ اَلرَّحِیمُ اَلْغَفُورُ (۲)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "بنام خداوند بخشایندۀ مهربان",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Paragraph",
      "Text": "ستایش مر خدا را که مر او راست آنچه در آسمانها و آنچه در زمین است و مر او راست ستایش در آن جهان و اوست درست کردار آگاه (۱) می‌داند آنچه داخل می‌شود در زمین و آنچه بیرون می‌آید از آن و آنچه فرود می‌آید از آسمان و آنچه عروج می‌کند در آن و اوست مهربان آمرزنده (۲)",
      "CoupletIndex": 3
