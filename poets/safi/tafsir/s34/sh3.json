      "Text": "وَ قٰالَ اَلَّذِینَ کَفَرُوا هَلْ نَدُلُّکُمْ عَلیٰ رَجُلٍ یُنَبِّئُکُمْ إِذٰا مُزِّقْتُمْ کُلَّ مُمَزَّقٍ إِنَّکُمْ لَفِی خَلْقٍ جَدِیدٍ (۷) أَفْتَریٰ عَلَی اَللّٰهِ کَذِباً أَمْ بِهِ جِنَّةٌ بَلِ اَلَّذِینَ لاٰ یُؤْمِنُونَ بِالْآخِرَةِ فِی اَلْعَذٰابِ وَ اَلضَّلاٰلِ اَلْبَعِیدِ (۸) أَ فَلَمْ یَرَوْا إِلیٰ مٰا بَیْنَ أَیْدِیهِمْ وَ مٰا خَلْفَهُمْ مِنَ اَلسَّمٰاءِ وَ اَلْأَرْضِ إِنْ نَشَأْ نَخْسِفْ بِهِمُ اَلْأَرْضَ أَوْ نُسْقِطْ عَلَیْهِمْ کِسَفاً مِنَ اَلسَّمٰاءِ إِنَّ فِی ذٰلِکَ لَآیَةً لِکُلِّ عَبْدٍ مُنِیبٍ (۹)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "و گفتند آنان که کافر شدند آیا دلالت کنیم شما را بر مردی که خبر دهد شما را چون پاره کرده شدید هر پاره کردنی بدرستی که شمائید هر آینه در آفرینش تازه (۷) آیا بست بر خدا دروغی یا باوست جنونی بلکه آنان که ایمان نمی‌آوردند بآخرت باشند در عذاب و گمراهی دور (۸) آیا پس ننگریستند بسوی آنچه باشد میان دستهاشان و آنچه باشد پشت سرشان از آسمان و زمین اگر خواهیم فرو بریم ایشان را بزمین یا فرو اندازیم بر ایشان پاره‌ای از آسمان بدرستی که در آن هر آینه آیتی است مر هر بنده بازگشت کننده (۹)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "وآن کسان گفتند که کافر شدند",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "نه از ره اعلام بلکه از ریشخند",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "سوی مردم ما شویم آیا دلیل",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "خود شما را که خبر داد آن خلیل",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "یا کند ابناء کز بعد هلاک",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "که شوید آن پاره پاره زیر خاک",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "جسمتان یابد تفرّق پس شوید",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "إنَّکُم کُلٌّ لَفِی خَلْقٍ جَدِید",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "آفریده می شوید از نو همه",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "جمع گردد عظم و لحم این رمه",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "بر خدا بندد دروغی یا نه او",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "مر جنونی باشد از این گفتگو",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "جن ورا گیرد کلامی از دروغ",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "می کند القاء به او از بی فروغ",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "بل هر آن کو بر قیامت نگروید",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "در عذاب است و ضلالی بس بعید",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "کافران آیا نمی بینند بس",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "سوی ایشان آنچه پیش است آنچه پس",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "از زمین و آسمان از پشت و رو",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "جملگی بگرفته ایشان را فرو",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "در میان محصور و نتوانند چند",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "تا که از اقطار آن بیرون روند",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "إن نَّشَأ نَخْسِف بِهِم یعنی به خواست",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "بر زمینشان در بریم ای دون به راست",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "یا بر ایشان افکنیم از آسمان",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "قطعه ای، مانند تا در زیر آن",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "عبرتی باشد در این قبل از وقوع",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "بهر عبدی که کند بر حق رجوع",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    }
  ]
}
