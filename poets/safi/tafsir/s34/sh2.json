      "Text": "وَ قٰالَ اَلَّذِینَ کَفَرُوا لاٰ تَأْتِینَا اَلسّٰاعَةُ قُلْ بَلیٰ وَ رَبِّی لَتَأْتِیَنَّکُمْ عٰالِمِ اَلْغَیْبِ لاٰ یَعْزُبُ عَنْهُ مِثْقٰالُ ذَرَّةٍ فِی اَلسَّمٰاوٰاتِ وَ لاٰ فِی اَلْأَرْضِ وَ لاٰ أَصْغَرُ مِنْ ذٰلِکَ وَ لاٰ أَکْبَرُ إِلاّٰ فِی کِتٰابٍ مُبِینٍ (۳) لِیَجْزِیَ اَلَّذِینَ آمَنُوا وَ عَمِلُوا اَلصّٰالِحٰاتِ أُولٰئِکَ لَهُمْ مَغْفِرَةٌ وَ رِزْقٌ کَرِیمٌ (۴) وَ اَلَّذِینَ سَعَوْا فِی آیٰاتِنٰا مُعٰاجِزِینَ أُولٰئِکَ لَهُمْ عَذٰابٌ مِنْ رِجْزٍ أَلِیمٌ (۵) وَ یَرَی اَلَّذِینَ أُوتُوا اَلْعِلْمَ اَلَّذِی أُنْزِلَ إِلَیْکَ مِنْ رَبِّکَ هُوَ اَلْحَقَّ وَ یَهْدِی إِلیٰ صِرٰاطِ اَلْعَزِیزِ اَلْحَمِیدِ (۶)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "و گفتند آنان که کافر شدند نمی‌آید ما را قیامت بگو آری قسم بپروردگار من که هر آینه خواهد آمد شما را که دانای غیب است مستور نمی‌باشد از او مقدار ذره در آسمانها و نه در زمین و نیست خوردتر از آن و نه بزرگ‌تر جز که باشد در کتابی واضح (۳) تا جزا دهد آنان را که ایمان آوردند و کردند کارهای شایسته را آن گروه برای ایشانست آمرزش و روزی خوب (۴) و آنان که شتافتند در آیتهای ما عجزکنندگانشان آن گروه برای ایشانست عذاب از عقوبت پردرد (۵) و می‌بینند آنان که داده شدند علم را که آنچه فرو فرستاده شد بتو از پروردگارت آن حق است و هدایت می‌کند براه خدای غالب ستوده (۶)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "آن کسان گفتند که کافر شدند",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "که به ما ناید قیامت تا به چند",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "گو بَلَی وَ رَبِّی آید بر شما",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "مر قیامت وقت آن داند خدا",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "خورد سوگند آن ابوسفیان به لات",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "که نیاید بعثی از بعد وفات",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "ای محمّد(ص) هم تو بر پروردگار",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "خور قسم کآید قیامت آشکار",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "آن خدای عالم الغیبی کز او",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "نیست پنهان هیچ قدر یک تسو",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "در سماوات و زمین زین خُردتر",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "یا از آن اکبر که آید در نظر",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "جز که مکتوب است در روشن کتاب",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "لوح محفوظ است و آن در انتساب",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "تا جزاء بدهد بر آنکه بگروید",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "کرد هم کردار نیکو بر مزید",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "آن گُره را باشد آمرزش یقین",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "همچنین رزقی کریم از رب دین",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "وآنکه بر ابطال آیت های ما",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "سعی کردند آن کسان از ناروا",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "تا مگر عاجز کنندة ما شوند",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "از الم رنجی بُد ایشان راست چند",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "می بدانند آن کسان که داده شد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "علم ایشان را ز حق و آماده شد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "آنکه سویت نازل از پروردگار",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "آنچه باشد اوست صدق و استوار",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "رهنما باشد به راه آنکه او",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "غالب و استوده است آن بی غلو",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    }
  ]
}
