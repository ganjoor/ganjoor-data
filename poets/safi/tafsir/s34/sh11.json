    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "فکر هم در قول و گفتارم کنید",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "تا بدانید اینکه نبود از جنون",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "هیچ در این یارتان بر آزمون",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "حاصل اینکه در تأمل بر شما",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "حال من روشن شود دور از خطا",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "که بسی از فهم و عقلم بهره مند",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "نیست قولم از جنون و ریشخند",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "بلکه عقل عاقلان پیشم کم است",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "بحرها در باغ فکرم شبنم است",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "نیست الاّ بیم ده او بر شما",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "پیش از آن کآمد عذاب و ابتلا",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "گو، هر آنچه خواستیم از مزد ما",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "در رسالت اوست پس بهر شما",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "نیست مزد دعوتم جز بر اِله",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "کو به هر چیزی است از اشیاء گواه",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "گو که آن پروردگارم بر وجوب",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "یَقذِفُ بِالْحَقِّ عَلَّامُ الْغُیُوب",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "وحی را القاء نماید بی غلق",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "رمیِ باطل می نماید یا به حق",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "گو که آمد حق که قرآن است و دین",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "یا که اسلام و رسول حق جبین",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "نافریند شیئی باطل هیچ چیز",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "یعنی آن ابلیس یا بت بی ستیز",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "هم نبدهد عود چیزی در بسیج",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "نیست او قادر به خلق و بعث هیچ",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "گو اگر گمره شدم نبود جز این",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "که شدم گمره به نفس خود یقین",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "هست بر من مر وبال گمرهی",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "نه به غیر من به نزد آگهی",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "ور روم بر راست راه اندر طلب",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "پس بود وحی آن هدایت را سبب",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "وحی سوی من فرستد رب من",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "که سمیع است و قریب او هر زمن",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "پس چو بینی کافران را ترسناک",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "نزد مرگ و وقت بعث اندر هلاک",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "پس نگردد فوت ز ایشان در گریز",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "آن عذاب پر نهیب هول خیز",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "هم مر ایشان را بگیرند از کمین",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "از مکانی بس قریب اعنی زمین",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "یعنی از روی زمینشان ناگزیر",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "میکشند از قهر و ناخواهی به زیر",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "آن زمان گویند آمَنَّا بِهِ",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "که زمان آخر شد و ره منتهی",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "مر فرا بگرفتن ایمان از کجا",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "باشد ایشان را به سهل از دور جا",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "یعنی ایمان را تناوش کی کنند",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "از مکان دور تا زآن دم زنند",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "وآنگهی که نگرویدند آن کسان",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "بر پیمبر یا به بعث از پیش از آن",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "وآن سخنها می فکندندی به غیب",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "نی ز علمی بلکه از پندار و ریب",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "بود مخفی یعنی آن گفتارها",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "که بِلا یعنی بگفتند از جفا",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "از مکان دور یعنی از گمان",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "نی ز روی دانش و دیدی عیان",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "بین ایشان و آرزوهاشان یقین",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "افتد البته جدایی یوم دین",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "همچنان که این عمل از پیش از این",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "رفت با اشباهشان از مشرکین",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "هیچشان از عقل و جان نبود نصیب",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 36
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "انهم کانوا لفی شک مریب",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 36
    }
  ]
}
