  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "بسم االله الرحمن الرحیم",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "وَ اَلنّٰازِعٰاتِ غَرْقاً (۱) وَ اَلنّٰاشِطٰاتِ نَشْطاً (۲) وَ اَلسّٰابِحٰاتِ سَبْحاً (۳) فَالسّٰابِقٰاتِ سَبْقاً (۴) فَالْمُدَبِّرٰاتِ أَمْراً (۵) یَوْمَ تَرْجُفُ اَلرّٰاجِفَةُ (۶) تَتْبَعُهَا اَلرّٰادِفَةُ (۷) قُلُوبٌ یَوْمَئِذٍ وٰاجِفَةٌ (۸) أَبْصٰارُهٰا خٰاشِعَةٌ (۹) یَقُولُونَ أَ إِنّٰا لَمَرْدُودُونَ فِی اَلْحٰافِرَةِ (۱۰) أَ إِذٰا کُنّٰا عِظٰاماً نَخِرَةً (۱۱) قٰالُوا تِلْکَ إِذاً کَرَّةٌ خٰاسِرَةٌ (۱۲) فَإِنَّمٰا هِیَ زَجْرَةٌ وٰاحِدَةٌ (۱۳) فَإِذٰا هُمْ بِالسّٰاهِرَةِ (۱۴)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "بنام خداوند بخشاینده مهربان",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Paragraph",
      "Text": "بکشندگان کشیدنی متوفی (۱) و بیرون‌کشندگان بیرون‌کشیدنی (۲) و شناکنندگان شناکردنی (۳) پیش‌گیرندگان پیش‌گرفتنی (۴) پس تدبیرکنندگان کار را (۵) روزی که بزلزله درآید بزلزله در آینده (۶) که از پی آید آن را از پی آینده (۷) دلهاست روز چنین لرزان (۸) چشمهاشان فرو رفته (۹) می‌گویند مائیم هر آینه برگردیده‌شوندگان بطریق نخست (۱۰) آیا وقتی که شدیم استخوانهای پوسیده (۱۱) گفتند اینست آن‌گاه بازگشتی با زیان (۱۲) پس جز این نیست که آن فریادیست واحد (۱۳) پس آن‌گاه ایشانند بر روی زمین (۱۴)",
      "CoupletIndex": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "حق خورد سوگند بر بکشندگان",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "که قوی اند و شدید اندر نشان",
