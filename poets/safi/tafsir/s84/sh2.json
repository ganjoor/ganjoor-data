    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "فَلاٰ أُقْسِمُ بِالشَّفَقِ (۱۶) وَ اَللَّیْلِ وَ مٰا وَسَقَ (۱۷) وَ اَلْقَمَرِ إِذَا اِتَّسَقَ (۱۸) لَتَرْکَبُنَّ طَبَقاً عَنْ طَبَقٍ (۱۹) فَمٰا لَهُمْ لاٰ یُؤْمِنُونَ (۲۰) وَ إِذٰا قُرِئَ عَلَیْهِمُ اَلْقُرْآنُ لاٰ یَسْجُدُونَ (۲۱) بَلِ اَلَّذِینَ کَفَرُوا یُکَذِّبُونَ (۲۲) وَ اَللّٰهُ أَعْلَمُ بِمٰا یُوعُونَ (۲۳) فَبَشِّرْهُمْ بِعَذٰابٍ أَلِیمٍ (۲۴) إِلاَّ اَلَّذِینَ آمَنُوا وَ عَمِلُوا اَلصّٰالِحٰاتِ لَهُمْ أَجْرٌ غَیْرُ مَمْنُونٍ (۲۵)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "پس سوگند یاد می‌کنم بشفق (۱۶) و شب و آنچه را جمع آورد (۱۷) و ماه چون تمام شود (۱۸) که هر آینه ارتکاب نمائید حالتی مطابق از حالتی مطابق (۱۹) پس چیست ایشان را که ایمان نمی‌آورید (۲۰) و چون خوانده شود بر ایشان قرآن سجده نمی‌کنند (۲۱) بلکه آنان که کافر شدند تکذیب می‌نمایند (۲۲) و خدا داناتر است بآنچه پنهان می‌دارند در دل (۲۳) پس مژده ده ایشان را بعذابی پر درد (۲۴) لیکن آنان که ایمان آوردند و کردند کارهای شایسته مر ایشان‌راست پاداشی بدون منت (۲۵)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "پس خورم سوگند مانا بر شفق",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "بعد مغرب سرخی است آن بر افق",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "هم به شب سوگند وآنچه می کند",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "جمع تاریکی و هم پوشد به خود",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "آنچه بُد در روز یعنی منتشر",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "شب به خویش آن را بپوشد مستمر",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "هم قسم بر ماه چون گردد تمام",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
