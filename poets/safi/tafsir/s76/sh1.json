  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "بسم االله الرحمن الرحیم",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "هَلْ أَتیٰ عَلَی اَلْإِنْسٰانِ حِینٌ مِنَ اَلدَّهْرِ لَمْ یَکُنْ شَیْئاً مَذْکُوراً (۱) إِنّٰا خَلَقْنَا اَلْإِنْسٰانَ مِنْ نُطْفَةٍ‌ أَمْشٰاجٍ نَبْتَلِیهِ فَجَعَلْنٰاهُ سَمِیعاً بَصِیراً (۲) إِنّٰا هَدَیْنٰاهُ اَلسَّبِیلَ إِمّٰا شٰاکِراً وَ إِمّٰا کَفُوراً (۳) إِنّٰا أَعْتَدْنٰا لِلْکٰافِرِینَ سَلاٰسِلَ وَ أَغْلاٰلاً وَ سَعِیراً (۴) إِنَّ اَلْأَبْرٰارَ یَشْرَبُونَ مِنْ کَأْسٍ کٰانَ مِزٰاجُهٰا کٰافُوراً (۵) عَیْناً یَشْرَبُ بِهٰا عِبٰادُ اَللّٰهِ یُفَجِّرُونَهٰا تَفْجِیراً (۶)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "بنام خدای بخشندۀ مهربان",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Paragraph",
      "Text": "بتحقیق آمد بر انسان وقتی از روزگار که نبود چیزی مذکور (۱) بدرستی که ما آفریدم انسان را از نطفه اخلاط که می‌آزمائیمش پس گردانیدیم او را شنوای بینا (۲) بدرستی که ما هدایت کردیم او را راه را یا شکرگزار و یا ناسپاس (۳) بدرستی که ما آماده کرده‌ایم برای کافران زنجیرها و غلها و آتش سوزان (۴) بدرستی که نیکان می‌آشامند از جامی که باشد مزاجش کافور (۵) چشمه که می‌آشامند از آن بندگان خدا جاری می‌کند آن را جاری کردنی (۶)",
      "CoupletIndex": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "آمد آیا آدمی را بی گمان",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "از زمان غیر محدود این زمان",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "کو نبودی شیئی مذکور اندر آن",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "بود اندر علم یعنی نی عیان",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "خلق کردیم آدمی را ز آبِ کم",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "جزوها کآمیخته بودی به هم",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "آب مرد و زن بُدند آن جزوها",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "یا طباع چارگانه ز اقتضا",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "تا نماییم آزمونش در نمود",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "حال بر حالش بگردانیم زود",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "نقل می بدهیمش از حالی به حال",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "ابتلای اوست در هر انتقال",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "پس بگردانیم شنوا و بصیر",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "مر ورا بر آزمایش ناگزیر",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "تا ببیند، بشنود آیات ما",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "امتحان گردد شود کامل بها",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "راه بنمودیم او را بر شناس",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "تا بود شاکر بدان یا ناسپاس",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "کرده ایم آماده بهر کافران",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "در جزاء زنجیر و غلهای گران",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "و آتش سوزندة افروخته",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "که در آن گردند دائم سوخته",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "می بیاشامند مر ابرار هم",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "جامها از خمر یا کافور ضم",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
