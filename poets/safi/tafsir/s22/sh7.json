      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "بدرستی که آنها که کافر شدند و باز می‌دارند از راه خدا و مسجد الحرام که گردانیدیم آن را برای مردمان که یکسان باشد مقیم در آن و دارد از خارج و کسی که اراده کند در آن بسبب عدول از حق بغیر حق در چشانیم او را از عذاب پر درد (۲۵) و هنگامی که تعیین کردیم برای ابراهیم جای آن خانه که شریک مگردان با من چیزی را و پاک گردان خانه مرا برای طواف‌کنندگان و ایستادگان و راکعان ساجدان (۲۶) و ندا در ده در مردمان بحج تا بیایند ترا پیادگان و بر هر شتری لاغر که آیند از هر راه دوری (۲۷) تا حاضر شوند منافعی که برای ایشانست و یاد کنند نام خدا را در روزهای معلوم بر آنچه روزی کرد ایشان را از زبان بسته شتر و گاو و گوسفند پس بخورید از آنها و بخورانید سختی کشیده درویش را (۲۸)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "آن کسان که بر خدا کافر شدند",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "از ره حق مردمان را ره زدند",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "باز می دارندشان هم در کلام",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "از طواف مسجد و بیت الحرام",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "مسجدی کز بهر مردم ساختیم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "هست یکسان اندر آن باد و مقیم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "یعنی از صحرانشینیان و اهل شهر",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "جمله دارند از طواف کعبه بهر",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "ره ندادن حاج را در خانه ها",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "هست خود مکروه اهل مکه را",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "بلکه باشد نزد عامه آن حرام",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "که شود کس مانع حاج از مقام",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "حکم فاروق معظم شد چنین",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "آن خلیفۀ ثانی اندر ملک دین",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "که نبندند اهل مکه وقت حج",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "بابهای خانه ها را بر نهج",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "تا در آنجا حاجیان منزل کنند",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "نی ز کُره این، بل ز میل دل کنند",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "وآنکه خواهد گردد او از راه هم",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "در زمین مکه ز الحاد و ستم",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "ما چشانیمش عذابی دردناک",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "تا در آن ماند به خسران و هلاک",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "یاد کن کردیم تعیین چونکه ما",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "مر مکان بیت ابراهیم را",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "پس به او گفتیم کای کامل تمیز",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "شرک بر ما می میاور هیچ چیز",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "پاک کن بیتم ز بهر طائفین",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "هم ز بهر قائمینِ این زمین",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "وآن کسان که راکعند و ساجدند",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "در عبودیّت نشان واحدند",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "کن نداء مر مردمان را بهر حج",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "که پیاده یا سواره بی حرج",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "سوی تو آیند از نزدیک و دور",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "طاعت حق را در این دارالحضور",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "مر سواره بر شترهای نزار",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "که به سوی مکه آیند از دیار",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "از ره دور و فراخ از هر طریق",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "می رسند از وجه مِن فَجٍّ عَمِیق",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "بر منافع تا مگر حاضر شوند",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "تائب و مسعود و مستغفر شوند",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "نام حق وز بهر آن کآرند یاد",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "روزهای خاص معلوم آن عباد",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "کآن خو د از ذی الحجه عشر اول است",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "طاعت اندر وی به تحقیق افضل است",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "ذکر حق در وقت نحر افزون کنند",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "ذبح آن بسته زبانان چون کنند",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "که مر ایشان راست روزی از خدای",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "چارپایان زبان بسته به جای",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "کافران قربانی از نام بتان",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "می نمودند و نمی خوردند از آن",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "حق به هم زد آن رسوم باطله",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "که مر ایشان را بر آن بُد مشغله",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "گفت زآنها هم خورید و هم دهید",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "بر هر آن محتاج کش محنت رسید",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    }
  ]
}
