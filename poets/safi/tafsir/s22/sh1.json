      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "یٰا أَیُّهَا اَلنّٰاسُ اِتَّقُوا رَبَّکُمْ إِنَّ زَلْزَلَةَ اَلسّٰاعَةِ شَیْ‌ءٌ عَظِیمٌ (۱) یَوْمَ تَرَوْنَهٰا تَذْهَلُ کُلُّ مُرْضِعَةٍ عَمّٰا أَرْضَعَتْ وَ تَضَعُ کُلُّ ذٰاتِ حَمْلٍ حَمْلَهٰا وَ تَرَی اَلنّٰاسَ سُکٰاریٰ وَ مٰا هُمْ بِسُکٰاریٰ وَ لٰکِنَّ عَذٰابَ اَللّٰهِ شَدِیدٌ (۲) وَ مِنَ اَلنّٰاسِ مَنْ یُجٰادِلُ فِی اَللّٰهِ بِغَیْرِ عِلْمٍ وَ یَتَّبِعُ کُلَّ شَیْطٰانٍ مَرِیدٍ (۳) کُتِبَ عَلَیْهِ أَنَّهُ مَنْ تَوَلاّٰهُ فَأَنَّهُ یُضِلُّهُ وَ یَهْدِیهِ إِلیٰ عَذٰابِ اَلسَّعِیرِ (۴)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "بنام خدای بخشندۀ مهربان",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Paragraph",
      "Text": "ای مردمان بترسید از پروردگارتان بدرستی که زلزله قیامت چیزیست عظیم (۱) روزی که خواهید دید آن را غافل شود هر شیر دهنده از آنچه شیر دادن و می‌گذارد هر صاحب حملی حملش را و می‌بینی مردمان را مستان و نباشند ایشان مستان و لیکن عذاب خدا سخت است (۲) و از مردمان کسی است که مجادله می‌کند در خدا بدون دانش و پیرو می‌شود هر شیطان سرکش را (۳) نوشته شد بر او که کسی که تابع شد او را پس او گمراه می‌کندش و راه می‌نمایدش بسوی عذاب آتش سوزان (۴)",
      "CoupletIndex": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "ای گروه مردمان از مرد و زن",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "می بترسید از خدای خویشتن",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "زآنکه جنبانیدن محشر ز بیم",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "مر زمین را باشد آن شیئی عظیم",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "ارض تن در حشر صغری یکدله",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "افتد اندر اضطراب و زلزله",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "وضع آن را از صفی بشنو کنون",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "کز نهیبش دل بود لبریز خون",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "گر تو بینی یک زمان آن اضطراب",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "عظم و لحمت گردد از اندیشه آب",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "غفلتت لکن بود مانع ز دید",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "زآن نلرزی دم به دم بر خود چو بید",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "چشم تا بر هم زنی شد محشری",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "از پی است این لحظه حشر دیگری",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "با تو گویم یک نشان از محشرش",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "در تو تا هر دم چه باشد کیفرش",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "کبر کردی بر فقیر بینوا",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "یا به چشم اندکش دیدی به جا",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "زود زین اندیشه استغفار کن",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "سهل بر خود کار بس دشوار کن",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "ور نه حاضر باش کز پی محشری است",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "جنبش ارضت ز هول دیگری است",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "خواری و خجلت رسیدت ناگهان",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "که شوی راضی به مرگ خویش از آن",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "باز هم گر می نیابی انتقال",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "نار دیگر یابد از پی اشتعال",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "بر تو آید یک خبر کز وی تنت",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "لرزد و دوزخ شود پیراهنت",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "وآن نه ده باشد، نه صد، نه صد هزار",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "قهر حق را نیست اندازه و شمار",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "این قدر هم گفتم از بهر نمون",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "تا از این اندک بری، ره بر فزون",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "پس ز خود در هر نَفس بر حق گریز",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "بازگرد اندر فقیری از ستیز",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "ای خدا بیچاره تر زآنیم ما",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "که زبان جنبد به کام اندر دعا",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "روی عذر و توبه از تقصیرمان",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "نیست تا خواهیم از قهرت امان",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "خود تو دانی چیست یا رب شأن خاک",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "عجز و ناداری و فقدان و هلاک",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "ایمنی از توست اندر جان و دل",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "نی ز راحت ها که باشد متصل",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "گر تو خواهی روضه را سازی جحیم",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "هم ز دوزخها کنی نور و نعیم",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "در زمینی چون فرستی زلزله",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "صد قیامت حاضر است آنجا هله",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "بنگرید آن روز که مانده است دور",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "مُرضِعه از طفلش از خوف و فتور",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "مانده اعنی قوه غاذیه باز",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "زینکه بر اعضاء رساند برگ و ساز",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "افکند بار از نهیب و ولوله",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "آن زمان هر زن که باشد حامله",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "بینی ای بیننده مردم را چنان",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "که مگر مستند از سکری نهان",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "وآنگهی کایشان نمی باشند مست",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "بلکه داد از هولشان آن حال دست",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "لیک چون باشد عذاب حق شدید",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "می شود آثار مستی زآن پدید",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "هست از مردم کسی کاندر خدا",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "می نماید او جدال از ناروا",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "بی ز دانش وز ره جهل مزید",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "تابع است از کُلَّ شَیطَانٍ مرید",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "نضر حارث با رسول ذوالجلال",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "بود دائم بی ز دانش در جدال",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "کاین کتاب اعنی که قرآن متین",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "نیست جز افسانه های سابقین",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "یا بناتُ االله بوند افرشتگان",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "یا نباشد عود بهر مردگان",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "آمد این آیت که این بحث و جدال",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 36
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "نیست هیچ از دانشی اندر مقال",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 36
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "دیو سرکش را نوشته بهر اوست",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "SectionIndex2": 37
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "اینکه باشد هر که او را یار و دوست",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "SectionIndex2": 37
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "پس نماید گمره او را ناگزیر",
      "CoupletIndex": 40,
      "SectionIndex1": 0,
      "SectionIndex2": 38
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "ره نماید از ضلالش بر سعیر",
      "CoupletIndex": 40,
      "SectionIndex1": 0,
      "SectionIndex2": 38
    }
  ]
}
