  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "بسم االله الرحمن الرحیم",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "إِذَا اَلسَّمٰاءُ اِنْفَطَرَتْ (۱) وَ إِذَا اَلْکَوٰاکِبُ اِنْتَثَرَتْ (۲) وَ إِذَا اَلْبِحٰارُ فُجِّرَتْ (۳) وَ إِذَا اَلْقُبُورُ بُعْثِرَتْ (۴) عَلِمَتْ نَفْسٌ مٰا قَدَّمَتْ وَ أَخَّرَتْ (۵) یٰا أَیُّهَا اَلْإِنْسٰانُ مٰا غَرَّکَ بِرَبِّکَ اَلْکَرِیمِ (۶) اَلَّذِی خَلَقَکَ فَسَوّٰاکَ فَعَدَلَکَ (۷) فِی أَیِّ صُورَةٍ مٰا شٰاءَ رَکَّبَکَ (۸) کَلاّٰ بَلْ تُکَذِّبُونَ بِالدِّینِ (۹) وَ إِنَّ عَلَیْکُمْ لَحٰافِظِینَ (۱۰) کِرٰاماً کٰاتِبِینَ (۱۱) یَعْلَمُونَ مٰا تَفْعَلُونَ (۱۲)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "بنام خدای بخشایندۀ مهربان",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Paragraph",
      "Text": "آن‌گاه که آسمان بشکافد (۱) و آن‌گاه که ستاره‌ها فرو ریزانیده شود (۲) و آن‌گاه که دریاها را بهم داده شود (۳) و آن‌گاه که قبرها زیر و زبر کرده شود (۴) و آن دهر نفسی آنچه را پیش فرستاده و باز پس داشت (۵) ای انسان چه چیز غره کرد ترا به پروردگارت که کریم است (۶) آنکه آفرید ترا پس تمام اجزا گردانید ترا پس اندام دادت (۷) در هر صورتی که خواست بهم آوردت (۸) نه چنین است بلکه تکذیب می‌نماید جزا را (۹) و بدرستی که بر شماست نگهبانان (۱۰) گرامیان نویسندگان (۱۱) می‌دانند آنچه را که می‌کنید (۱۲)",
      "CoupletIndex": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "آن زمان که اشکافته گردد فلک",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "می بریزند این کواکب یک به یک",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "وآن زمان که بحر ها گردد روان",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "گورها زیر و زبر گردد عیان",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "هر کسی داند چه بفرستاده پیش",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "وآنچه از پس هِشته اندک یا که بیش",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "پس خطاب آید که ای آدم چه چیز",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "غرّه بر رب کریمت کرد نیز",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "آن خدایی کآفریدت از عدم",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "راست پس فرمودت از تقدیر هم",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "ساخت اعضایت همه عدل و نکو",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "بر هر آن صورت که خود می خواست او",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "صورت و اعضاء و ترکیبت تمام",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "معتدل آراست از تنظیم تام",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "گر کنی در خلقت خود یک نظر",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "می شناسی داده های دادگر",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "از غرور خویش پس باز ایستید",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "گر ز اصل خویش غافل نیستید",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "آن نباشد کایستید از کبر هین",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "بل بود تکذیبتان بر یوم دین",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "مر شما را از ملایک حافظین",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "در عمل هست از کِرَاماً کَاتِبِین",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "آن بزرگانی که بنویسنده اند",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "نامۀ اعمالتان از چون و چند",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "می بدانند آنچه را که می کنید",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "نیک و بد را می نویسند از پدید",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    }
  ]
}
