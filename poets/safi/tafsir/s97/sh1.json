    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "می نباشد جز سلامت جز سلام",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "نزد تحقیق از کمال سرمدی",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "لیلة القدر است بنیۀ احمدی",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "حال کون احتجابش بالعهود",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "بر مقام قلب از بعد شهود",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "زآنکه ممکن نیست آن انزال خاص",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "جز که در این بیّنه در حال خاص",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "نیست ظاهر قدر آن بر هیچ کس",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "خود شناسد قدر آن احوال و بس",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 37,
      "Position": "Paragraph",
      "Text": "« جذبه »",
      "CoupletIndex": 20
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "جمله اشیاء را در آن حال و صفت",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "می بباید از حقایق معرفت",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "چیست دانی لیلة القدر ای عیار",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "گر شنیدستی نسیم کوی یار",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "شرح آن حال ار نمایم هیچ من",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "منقلب گردم بمانم از سخن",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "خاصه کز یار عزیز آید پیام",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "که امشبت من میهمانم در مقام",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "خانه را خالی کن از بیگانه تو",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "منتظر بنشین به باب خانه تو",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "با تو من گویم چه زین حال عجب",
      "CoupletIndex": 26,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "که فراوان دیده ام این روز و شب",
      "CoupletIndex": 26,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "خانه از غیر ار کنی خالی تمام",
      "CoupletIndex": 27,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "آید آن مهمان غیبت لاکلام",
      "CoupletIndex": 27,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "چونکه آمد کار بر دلخواه توست",
      "CoupletIndex": 28,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "طالع از برج حقیقت ماه توست",
      "CoupletIndex": 28,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "قوّه های عقلی و روحی تمام",
      "CoupletIndex": 29,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "تا به صبحت در درودند و سلام",
      "CoupletIndex": 29,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    }
  ]
}
