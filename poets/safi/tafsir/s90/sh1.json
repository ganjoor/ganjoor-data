      "VOrder": 11,
      "Position": "Right",
      "Text": "یا به ابراهیم کو جد است و اَب",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "مر پیمبر را وز او دارد نسب",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "آفریدیم آدمی را در کَبَد",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "یعنی اندر رنج و سختیِ بی ز حد",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "بعض را هست از قریش آیا گمان",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "که بر او کس نیست قادر در زمان",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "داردش تا باز ز آزار رسول",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "یا که بکشد انتقام از آن فضول",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "در قیامت گوید او کردم هلاک",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "مال دنیا کآمدم زو بیم و باک",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "این چنین پندارد آیا که ورا",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "کس ندیده، دیده است اعنی خدا",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "ما نگرداندیم آیا بهر او",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "زبان و دو چشم و دو لب خود بر او",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "پس نمودیمش طریق خیر و شرّ",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "در نیامد پس به تکلیف او دگر",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "برخلاف نفس رنج اعنی نبرد",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "تا که راه عَقَبَه بتواند سپرد",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "چه تو را دانا نمود از عَقَبَه بیش",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "سختی اش را وآنچه بردارد ز پیش",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "گردنی، کردن رها از بندگی",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "یا طعامی دادن اندر زندگی",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "روزی آنکه باشد آن ذِی مَسغَبَه",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "جوع و سختی در سرا و مصطبه",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "دیر و سخت اعنی به دست آید طعام",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "او خوراند با رضاء و اهتمام",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "بر یتیمی کو بود ذا مَقرَبَه",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "یا فقیری کو بود ذا مَترَبَه",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "اوست خویشاوند و ذی حق در خوراک",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "هِشته زین پهلو ز مسکینی به خاک",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "پس بود او ز اهل ایمان و اهل دین",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "اقتحام عَقبَه کرده است او یقین",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "مر وصیّت کرده اند ایشان به صبر",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "در شدائد یکدگر را نی به جبر",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "یا که اندر نصرت دین خدا",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "یا به طاعت یا تبرّک ناروا",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "هم وصیّت کرده اند از هر جهت",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "بر عطاء و جود و مهر و مرحمت",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "آن گُره باشند اصحاب یمین",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "وآنکه کافر شد به آیات مبین",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "آن گُره باشند اهل مَشْئَمَه",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "جایشان در نار پوشیده همه",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "من ز نَار مؤْصَدَه بر حق پناه",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "می برم یا رب تو زآن دارم نگاه",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    }
  ]
}
