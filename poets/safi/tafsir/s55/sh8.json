  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "فِیهِنَّ خَیْرٰاتٌ حِسٰانٌ (۷۰) فَبِأَیِّ آلاٰءِ رَبِّکُمٰا تُکَذِّبٰانِ (۷۱) حُورٌ مَقْصُورٰاتٌ فِی اَلْخِیٰامِ (۷۲) فَبِأَیِّ آلاٰءِ رَبِّکُمٰا تُکَذِّبٰانِ (۷۳) لَمْ یَطْمِثْهُنَّ إِنْسٌ قَبْلَهُمْ وَ لاٰ جَانٌّ (۷۴) فَبِأَیِّ آلاٰءِ رَبِّکُمٰا تُکَذِّبٰانِ (۷۵) مُتَّکِئِینَ عَلیٰ رَفْرَفٍ خُضْرٍ وَ عَبْقَرِیٍّ حِسٰانٍ (۷۶) فَبِأَیِّ آلاٰءِ رَبِّکُمٰا تُکَذِّبٰانِ (۷۷) تَبٰارَکَ اِسْمُ رَبِّکَ ذِی اَلْجَلاٰلِ وَ اَلْإِکْرٰامِ (۷۸)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "در آنهاست خوب زنان نیکو (۷۰) پس کدام یک از نعمتهای پروردگارتان را تکذیب می‌کنید (۷۱) حوران پرده نشینند در خیمه‌ها (۷۲) پس کدام یک از نعمتهای پروردگارتان را تکذیب می‌کنید (۷۳) مس نکرده ایشان را انسان پیش از ایشان و نه جنی (۷۴) پس کدام یک از نعمتهای پروردگارتان را تکذیب می‌کنید (۷۵) تکیه‌زنندگان بر بالشهای سبز و کار عبقر نیکو (۷۶) پس کدام یک از نعمتهای پروردگارتان را تکذیب می‌کنید (۷۷) افزون آمد نام پروردگار تو که صاحب بزرگی و مکرمت است (۷۸)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "هست در این چار جنّت از زنان",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "کاندر اوصافند خَیرَات حِسَان",
