      "Text": "أَمَّنْ جَعَلَ اَلْأَرْضَ قَرٰاراً وَ جَعَلَ خِلاٰلَهٰا أَنْهٰاراً وَ جَعَلَ لَهٰا رَوٰاسِیَ وَ جَعَلَ بَیْنَ اَلْبَحْرَیْنِ حٰاجِزاً أَ إِلٰهٌ مَعَ اَللّٰهِ بَلْ أَکْثَرُهُمْ لاٰ یَعْلَمُونَ (۶۱) أَمَّنْ یُجِیبُ اَلْمُضْطَرَّ إِذٰا دَعٰاهُ وَ یَکْشِفُ اَلسُّوءَ وَ یَجْعَلُکُمْ خُلَفٰاءَ اَلْأَرْضِ أَ إِلٰهٌ مَعَ اَللّٰهِ قَلِیلاً مٰا تَذَکَّرُونَ (۶۲) أَمَّنْ یَهْدِیکُمْ فِی ظُلُمٰاتِ اَلْبَرِّ وَ اَلْبَحْرِ وَ مَنْ یُرْسِلُ اَلرِّیٰاحَ بُشْراً بَیْنَ یَدَیْ رَحْمَتِهِ أَ إِلٰهٌ مَعَ اَللّٰهِ تَعٰالَی اَللّٰهُ عَمّٰا یُشْرِکُونَ (۶۳) أَمَّنْ یَبْدَؤُا اَلْخَلْقَ ثُمَّ یُعِیدُهُ وَ مَنْ یَرْزُقُکُمْ مِنَ اَلسَّمٰاءِ وَ اَلْأَرْضِ أَ إِلٰهٌ مَعَ اَللّٰهِ قُلْ‌ هٰاتُوا بُرْهٰانَکُمْ إِنْ کُنْتُمْ صٰادِقِینَ (۶۴) قُلْ لاٰ یَعْلَمُ مَنْ فِی اَلسَّمٰاوٰاتِ وَ اَلْأَرْضِ اَلْغَیْبَ إِلاَّ اَللّٰهُ وَ مٰا یَشْعُرُونَ أَیّٰانَ یُبْعَثُونَ (۶۵) بَلِ اِدّٰارَکَ عِلْمُهُمْ فِی اَلْآخِرَةِ بَلْ هُمْ فِی شَکٍّ مِنْهٰا بَلْ هُمْ مِنْهٰا عَمُونَ (۶۶)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "آیا آنکه گردانید زمین را مستقر و گردانید میانش نهرها و گردانید مر آن را کوه‌های ثابت و گردانید میان دو دریا حایلی آیا با خدا خدائیست بلکه اکثر ایشان نمی‌دانند (۶۱) آیا آنکه اجابت می‌کند مضطر را چون بخواند او را و رفع می‌کند بدی را و می‌گرداند شما را جانشینان در زمین آیا الهی با خداست اندکی پند می‌گیرید (۶۲) آیا آنکه راه می‌نماید شما را در تاریکیهای بیابان و دریا و آنکه می‌فرستد بادها را بشارت میان دو دست رحمتش آیا الهی با خداست برتر آمد خدا از آنچه شریک می‌دانند (۶۳) آیا آنکه نخست آفرید خلق را پس اعاده می‌کنندش و آنکه روزی می‌دهد شما را از آسمان و زمین آیا الهی با خداست بگو بیاورید دلیلتان را اگر هستید راستگویان (۶۴) بگو نمی‌دانید آنکه باشد در آسمانها و زمین غیب را مگر خدا و نمی‌دانند که کی برانگیخته می‌شوند (۶۵) بلکه بکمال رسید عملشان در آخرت بلکه ایشانند در شک‌اندازان بلکه ایشانند از آن کوران (۶۶)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "آنکه گرداند این زمین آرامگاه",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "نهرها آورد ز اطرافش به گاه",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "کوهها را ساخت مسمار زمین",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "حاجزی بین دو بحر مستبین",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "کوست بحر شور و شیرین در رسوم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "یا خلیج فارس با دریای روم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "هست هیچ آیا خدایی با خدا",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "بل ندانند اکثر این آثارها",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "کیست آیا که نماید مستجاب",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "خواندن بیچاره را در هیچ باب",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "چون بخواند مر ورا از اضطرار",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "زو کند دفع آنچه باشد ناگوار",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "مضطر آن باشد که از خود ناامید",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "گشته باشد در مهمات شدید",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "همچو بیماری که باشد محتضر",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "یا غریقی بر هلاکت منتظر",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "شسته لوح دل ز نقش ممکنات",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "نیست رویش جز که بر سلطان ذات",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "شیخ داوود یمانی رفته بود",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "بر عیادت خسته ای را خود ز جود",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "گفت کن یا شیخ بهر من دعاء",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "تا دهد حقم ز بیماری شفاء",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "گفت تو میکن دعاء که مضطری",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "نیست حاجت بر دعای دیگری",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "هم بگرداند شما را در زمین",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "از پی پیشینیان مر جانشین",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "مر خدایی باشد آیا با خدا",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "یاد او لیکن کنید اندک شما",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "از شما یا اندکی گیرید پند",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "نیستید از شکر منعم بهره مند",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "رهنما آیا شما را هست کس",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "هیچ در ظلمات برّ و بحر بس",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "وآنکه بهر مژده بفرستد ریاح",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "بیشتر ز انزال رحمت بر صلاح",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "با خدا دیگر خدایی هست نیک",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "برتر است او زآنچه گیرندش شریک",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "بهتر آیا نیست آن خلاّق جود",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "کآفریند وز عدم بدهد وجود",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "پس دهد او را اعاده باز هم",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "در قیامت بعد از آنکه بُد عدم",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "وآنکه بدهد از زمین و آسمان",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "بر شما روزی به اوقات زمان",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "با خدا دیگر خدایی پس کجاست",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "گو دلیل آرید گر گویید راست",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "گو نداند در زمین و آسمان",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "غیب را کس جز خدای غیب دان",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "خود نمی دانند ایشان تا کجا",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "می برانگیزانده گردند از خدا",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "بل رسیده علم ایشان گر که نیک",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "بر وقوع آخرت هر چند لیک",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "در شکند از آن همانا بلکه کور",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "نیستند آگه به تحقیق از نشور",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "علم آن یعنی که بر تقلید نیست",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "حقّ دانش جز عیان و دید نیست",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    }
  ]
}
