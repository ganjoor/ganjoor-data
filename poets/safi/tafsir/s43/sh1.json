    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "حم (۱) وَ اَلْکِتٰابِ اَلْمُبِینِ (۲) إِنّٰا جَعَلْنٰاهُ قُرْآناً عَرَبِیًّا لَعَلَّکُمْ تَعْقِلُونَ (۳) وَ إِنَّهُ فِی أُمِّ اَلْکِتٰابِ لَدَیْنٰا لَعَلِیٌّ حَکِیمٌ (۴) أَ فَنَضْرِبُ عَنْکُمُ اَلذِّکْرَ صَفْحاً أَنْ کُنْتُمْ قَوْماً مُسْرِفِینَ (۵) وَ کَمْ أَرْسَلْنٰا مِنْ نَبِیٍّ فِی اَلْأَوَّلِینَ (۶) وَ مٰا یَأْتِیهِمْ مِنْ نَبِیٍّ إِلاّٰ کٰانُوا بِهِ یَسْتَهْزِؤُنَ (۷) فَأَهْلَکْنٰا أَشَدَّ مِنْهُمْ بَطْشاً وَ مَضیٰ مَثَلُ اَلْأَوَّلِینَ (۸)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "بنام خداوند بخشاینده مهربان",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Paragraph",
      "Text": "حم (۱) قسم بحق کتاب روشن (۲) بدرستی که ما گردانیدیم آن را قرآنی عربی باشد که شما دریابید بعقل (۳) و بدرستی که آن در اصل کتاب نزد ما هر آینه بلند مرتبه با حکم است (۴) آیا پس حم (۱) بگردانیم از شما ذکر را باعراض از بهر آنکه هستید گروهی اسراف‌کاران (۵) و بسیار فرستادیم از پیغمبری در پیشینیان (۶) و نمی‌آمد ایشان را هیچ پیغمبری مگر که بودند بآن استهزا می‌کردند (۷) پس هلاک کردیم سخت‌تر از ایشان را در قوت و گذشت داستان پیشینیان (۸)",
      "CoupletIndex": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "بعد بسم االله الرحمن الرحیم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "میخورد سوگند حق بر حا و میم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "آن حقیقت یعنی اندر انجلا",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "کاولش حق است و آخر مصطفی (ص)",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "یا قسم بر اسمهای احسن است",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "کابتدایش حا و میم این اَبیَن است",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "هم به قرآن مبین مستطاب",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "یعنی این آیات و این روشن کتاب",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "که بیان کردیم بر لفظ عرب",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "تا شما یابید شاید در طلب",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "هست در ام الکتاب او نزد ما",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "بس بزرگ و محکم از نقص و خطا",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "یا که اندر لوح محفوظ مبین",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "هست احکامش به حکمت بس متین",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "ما شما را وا زنیم آیا از آن",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "دورتان سازیم یعنی زین بیان",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "چون شما هستید قومی که ز حد",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "رفته بیرونید و رهتان گشته سد",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "ای بسا کز جنس آن پیغمبران",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "ما فرستادیم در پیشینیان",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "نامد ایشان را رسولی بهر پند",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "جز که می کردند بر او ریشخند",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "پس تبه کردیمشان بر وجه بد",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "در توانایی بُدند ایشان اشد",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "قصۀ پیشینیان بگذشته بس",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "اندر این قرآن به هر جا پیش و پس",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    }
  ]
}
