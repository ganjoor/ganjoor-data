      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "وَ لَمّٰا ضُرِبَ اِبْنُ مَرْیَمَ مَثَلاً إِذٰا قَوْمُکَ مِنْهُ یَصِدُّونَ (۵۷) وَ قٰالُوا أَ آلِهَتُنٰا خَیْرٌ أَمْ هُوَ مٰا ضَرَبُوهُ لَکَ إِلاّٰ جَدَلاً بَلْ هُمْ قَوْمٌ خَصِمُونَ (۵۸) إِنْ هُوَ إِلاّٰ عَبْدٌ أَنْعَمْنٰا عَلَیْهِ وَ جَعَلْنٰاهُ مَثَلاً لِبَنِی إِسْرٰائِیلَ (۵۹) وَ لَوْ نَشٰاءُ لَجَعَلْنٰا مِنْکُمْ مَلاٰئِکَةً فِی اَلْأَرْضِ یَخْلُفُونَ (۶۰) وَ إِنَّهُ لَعِلْمٌ لِلسّٰاعَةِ فَلاٰ تَمْتَرُنَّ بِهٰا وَ اِتَّبِعُونِ هٰذٰا صِرٰاطٌ مُسْتَقِیمٌ (۶۱) وَ لاٰ یَصُدَّنَّکُمُ اَلشَّیْطٰانُ إِنَّهُ لَکُمْ عَدُوٌّ مُبِینٌ (۶۲)",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "و چون زده شد پسر مریم مثلی آن‌گاه قوم تو از آن فریاد برمیآورند (۵۷) و گفتند آیا الهان ما بهترند با او نزدند آن را برای تو جز جدلی بلکه ایشانند گروهی خصومت‌کنندگان (۵۸) نیست او جز بنده که احسان کردیم بر او و گردانیدیم او را مثلی برای بنی اسرائیل (۵۹) و اگر خواهیم هر آینه گردانیم از شما ملائکه را در زمین که جانشین باشند (۶۰) و بدرستی که اوست هر آینه علمی برای قیامت پس شک میار بآن و پیروی کنید مر اینست راه راست (۶۱) و باز ندارد البته شما را شیطان بدرستی که او مر شما راست دشمنی آشکار (۶۲)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "شد زده بر ابن مریم چون مثل",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "که پرستندش نصاری در محل",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "چون مسیح و عابدینش در جحیم",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "جملگی باشند با رنج الیم",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "با الهان گو که ما باشیم هم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "اوست بهتر یا الهان نیست عم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "عیسی ار حَصَب جهنم باشد او",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "گو که ما باشیم هم بی گفتگو",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "می نگفتند این مثل جز بر جدل",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "در خصومت این گُره سختند بل",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "وجه دیگر آنکه چون مدح مسیح",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "مصطفی(ص) میکرد با مریم صریح",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "مشرکان گفتند قصد اوست این",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "که پرستندش چو عیسی از یقین",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "وجه دیگر آنکه روزی با علی (ع)",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "گفت پیغمبر (ص) به گفتار جلی",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "کاندر این امّت تو را باشد مثل",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "همچو عیسی نزد قومش در عمل",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "فرقه ای غالی شدند او را به حق",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "فرقه ای کردند از وی طعن و دق",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "خنده کردند اهل غمز از این کلام",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "کابن عمش گشت پیغمبر مقام",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "آمد این آیت که بر عیسی مثل",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "ابن عمت را زدی چون در محل",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "گفت مشرک گر علی چون عیسی است",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "بهتر از عیسی است بت هم بت پرست",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "نیست عیسی غیر عبدی که بر او",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "کرده ایم اِنعام ما بی گفتگو",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "می بگرداندیم او را ما مثل",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "بهر اسرائیلیان در هر محل",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "قصه ای یعنی که بس باشد غریب",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "نزد آن کو دارد از دانش نصیب",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "بی ز والد کی وجودی پا گرفت",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "وین ز قدرتهای ما نبود شگفت",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "ور که هم خواهیم گردانیم هین",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "از شما افرشتگان اندر زمین",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "تا درآیند از پی هم چون شما",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "این چنین تبدیل سهل آید به ما",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "بر ملایک بنیۀ آدم بَدل",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "ما کنیم این اعجب است اندر مثل",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "اوست آن چیزی که دانسته به آن",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "می شود مانا قیامت ناگهان",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "یعنی اینکه عیسی آمد بی پدر",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "باشد از علم قیامت در اثر",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "زآن حقیقت کس نیابد آگهی",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "جز که گردد محرم سرّ اللهی",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "لیک زین رمزت صفی گوید یکی",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "گر اشارت فهم و صاحب مدرکی",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "دیده باشی خواب چیزی را که روز",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "عین آن واقع شود بی درد و سوز",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "نیست در خواب از طبیعت در شیوع",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "هیچ اسبابی که آن یابد وقوع",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "نور روحت اندک ار لامع شود",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "هر چه بینی عین آن واقع شود",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "آنچه در ملک طبیعت واقع است",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "در حقیقت عین آن بی مانع است",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "هست اسباب الهی غیر از آن",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "که تو بینی در طبیعت زو نشان",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "آن کسی بیند که از تن رسته است",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "جانش از بند طبیعت جسته است",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "چوب گر شد اژدها نبود عجب",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "کآن الهی بود نه از طبع و سبب",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "خارق عادات جمله این چنین",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "باشد ار روشندلی و تیزبین",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "عقلی ار باور نکرد این ساز را",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "گو نفهمد جان احمق راز را",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "در قیامت فهمد آن را لاعلاج",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "باز شد چون پردة طبع و مزاج",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "لَاتَمتَرُنَّ بِهَا یعنی که شک",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 36
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "ناورید اندر قیامت هیچ یک",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 36
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "هم نمایید از رسولم پیروی",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 37
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "این است راه راست نزد معنوی",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 37
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "بازتان باید ندارد دیو گرگ",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 38
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "کآن شما را دشمنی باشد بزرگ",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 38
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "دشمنیِ خود نمود او آشکار",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "SectionIndex2": 39
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "کرده بیرونتان ز جنّت خوار و زار",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "SectionIndex2": 39
    }
  ]
}
