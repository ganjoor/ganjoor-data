  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "بسم االله الرحمن الرحیم",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Paragraph",
      "Text": "لِإِیلاٰفِ قُرَیْشٍ (۱) إِیلاٰفِهِمْ رِحْلَةَ اَلشِّتٰاءِ وَ اَلصَّیْفِ (۲) فَلْیَعْبُدُوا رَبَّ هٰذَا اَلْبَیْتِ (۳) اَلَّذِی أَطْعَمَهُمْ مِنْ جُوعٍ وَ آمَنَهُمْ مِنْ خَوْفٍ (۴)",
      "CoupletIndex": 1
    },
    {
      "VOrder": 3,
      "Position": "Paragraph",
      "Text": "بنام خدای بخشایندۀ مهربان",
      "CoupletIndex": 2
    },
    {
      "VOrder": 4,
      "Position": "Paragraph",
      "Text": "برای الفت عطا کردن بقریش (۱) الفت عطا کردن بایشان در کوچ زمستان و تابستان (۲) پس باید بپرستید پروردگار این خانه را (۳) آنکه سیر طعام کرد ایشان را از گرسنگی و ایمن کرد ایشان را از بیم (۴)",
      "CoupletIndex": 3
