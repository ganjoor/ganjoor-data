      "Position": "Right",
      "Text": "مجمع‌ البحرین‌ اگر دانی‌ دل است‌",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "واندر آن سکنای پیر کامل‌ است‌",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
