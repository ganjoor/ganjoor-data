  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "این‌ سخن‌ بیرون ز وهم‌ است‌ ای پناه",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
