  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "کرد او را بانگ‌ شه‌، کای شیر حق‌",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
