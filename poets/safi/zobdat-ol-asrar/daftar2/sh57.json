  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "یا حسین‌(ع) ای شاه ذو لطف‌ خفی‌",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
