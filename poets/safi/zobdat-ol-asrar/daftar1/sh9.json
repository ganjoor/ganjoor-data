  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "جان چه‌ در دل بر فنا شد زآن سر است‌",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
