  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "مطلع دیوان اسرار قدیم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "هست‌ بسم‌ ﷲ الرّحمن‌ الرّحیم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "آن کتاب‌ ﷲ که‌ گنج‌ حکمت‌است‌",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
