      "Text": "افتتاح او به‌ باب‌ رحمت‌ است‌",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "حق‌ چو چنگ‌ آفرینش‌ کرد ساز",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "باب‌ ایجاد او به‌ رحمت‌ کرد باز",
