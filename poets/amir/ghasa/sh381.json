      "Position": "Right",
      "Text": "ز دست او شگفت آید خرد را",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "جو بارد کلک او بر سیم قطران",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
