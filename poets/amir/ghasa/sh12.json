      "Position": "Left",
      "Text": "چو او به رزم زره پوشد و به بزم قبا",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "به روز رزمش دیبا بِه‌ آید از آهن",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "به روز بزمش آهن بِهْ آید از دیبا",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "گهی ز چشم زند تیر بر دل عُشّاق",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "گهی ز دست زند تیغ بر سر اعدا",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "جو بنگریم همه ساله عالمی باشند",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "ز چشم او به نفیر و زدست او به بلا",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "مکن به سرو و مه آن دلفریب را تشبیه",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "که او جداست به خوبی و سرو و ماه جدا",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "زره نپوشد و جوشن به رزم سرو بلند",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "قدح نگیرد و ساغر به بزم بَدْر سما",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "نه ماه باشد همتای آن نگار و نه سرو",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "جو بزم و رزم‌ کند پیش میر بی‌همتا",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "معین دولت عالی نصیر ملت حقّ",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "که پهلوان ملوک است و سَیِّدُالاُمرا",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "امیر زاده امیری که لشکری باشد",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "به روز رزم سواری ز لشکرش تنها",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "قضا چو نادرهٔ نو پدید خواهد کرد",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "ضمیر او به فِراست سَبَق برد ز قضا",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "به خنجر وکف او هرکه بنگرد بیند",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "مُبَشّری ز ظفر یا مُفَسّری ز سَخا",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "سپهر تا به ابد ننگرد به عین سَخَط",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "ز بهر او نگرد ساعتی به عین رضا",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "ز فر مجلس او آسمان شدست زمین",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "ز نقش رایت او بوستان شدست هوا",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "دلی نماند به مازندران ز هیبت او",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "که هست پیچش و ماز اندر آن زکین و جفا",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "ز هیبت او شیران همی‌گذر نکنند",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "به مرغزاری کاسبان او کنند چَرا",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "وگرگنند گذر چون به داغ او نگرند",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "ز چشم چشمه‌ کنند و ز موی جسم‌ گیا",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "گر آدم از هنرش داشتی به خلد خبر",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "بر او نکردی ابلیس کَید خویش روا",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "وگر ضمیر سلیمان چو رای او بودی",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "نگین ملک نکردی به دست دیو رها",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "وگر سعادت او تافتی بر اسکندر",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "به ظلمت اندر ره یافتی بر آب بقا",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "ایا مروت تو بر فتوت تو دلیل",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "ایا شمایل تو بر فضایل تو گَوا",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "ز رسم توست همه رسم مردمی ظاهر",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "ز اصل توست همه اصل مهتری پیدا",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "ولی ز توست توانگر عدو ز توست هلاک",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "چه مردمی تو که داری صِناعت دریا",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "بُوَد وِفاق تو دروازهٔ حیات ابد",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "بود نِفاق تو دندانهٔ کلید فنا",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "که دید بر هنر تو گذشته باد محال‌؟",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "که دید بر سخن تو نشسته‌گرد خطا؟",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "نمایش هنر توست جهل را مقطع",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "گشایش سخن توست ‌عقل را مبدا",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "هزار بار فزون گفت خسرو ماضی",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "کِه داد دادِ هنر، یک به یک به مجلس ما",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "چنان محل که تورا بود پیس آن خسرو",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "نبود هیچ کسی را ز جملهٔ نُدَما",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "اگر به‌دست فنا بند عمر او بگسست",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "ز بند عمر تو کوتاه باد دست عَنا",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "جهان تو خوش بخور امروز و دل مبند در آنْکْ",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "چگونه بود جهان دی و چون بود فردا",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "چه باک از آنکه‌ گشاید ره جفا دشمن",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "چو بست با تو فلک محضری به شرط وفا",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "اگر چو شیر نهد دشمنی به جنگ تو روی",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "خورد به عاقبت از دست روزگار قفا",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "به نعمت توکه از یکدگر شریفترند",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "عطای تو ز قبول و قبول تو ز عطا",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "معزی آنکه به مدح و ثنا معزالدین",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "عزیز کردش و دادش اَمارت شُعرا",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "به خدمت آمد و ازکارگاه خاطر خویش",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "به بارگاه تو آورد حلهٔ دیبا",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "جه حله باسد ازین به‌که تا زمانه بود",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "نگار او نکند گردش زمانه هَبا",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "همیشه تاکه امامان خبر دهند همی",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "هم از مسیح دعا و هم از کلیم عصا",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "ز تو عصا و قلم جاودانه معجز باد",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "چو ازکلیم عصا و چو از مسیح دعا",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "طرب سریر تورا سجده کرده در مجلس",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "ظفر رکاب تو را بوسه داده در هَیجا",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "بهارخانهٔ چین کرده در بهار و خزان",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 86,
      "Position": "Left",
      "Text": "خجسته بزم تو خُوبان خَلُّخُ و یغما",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "تو ناقد سخن و برکف تو ناقد عقل",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "جه ناقدی که خرد خوانَدَش همی صهبا",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "ز تو فتوت و از مهتران درود و سلام",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "ز تو مروّت و ازکِهتران دعا و ثنا",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 91,
      "Position": "Right",
      "Text": "سه چیز باد تو را جاودان و بی‌پایان",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 92,
      "Position": "Left",
      "Text": "تنِ درست و دلِ شاد و دولتِ برنا",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    }
  ]
}
