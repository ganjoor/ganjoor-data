    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "تار کردی روزگار روشنم",
      "CoupletIndex": 17,
      "SectionIndex1": 3,
      "SectionIndex2": 6
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "واند گر بر فرق سرمیریخت خاک",
      "CoupletIndex": 18,
      "SectionIndex1": 3,
      "SectionIndex2": 7
    },
    {
      "VOrder": 67,
      "Position": "Left",
      "Text": "در عزاداری نموده سینه چاک",
      "CoupletIndex": 18,
      "SectionIndex1": 3,
      "SectionIndex2": 7
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "که مرا برباد دادی دستگاه",
      "CoupletIndex": 19,
      "SectionIndex1": 3,
      "SectionIndex2": 8
    },
    {
      "VOrder": 71,
      "Position": "Left",
      "Text": "مال و فرزند و زنم کردی تباه",
      "CoupletIndex": 19,
      "SectionIndex1": 3,
      "SectionIndex2": 8
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "هردو با هم گشته سرگرم نزاع",
      "CoupletIndex": 20,
      "SectionIndex1": 3,
      "SectionIndex2": 9
    },
    {
      "VOrder": 75,
      "Position": "Left",
      "Text": "تا که خور برداشت از گیتی شعاع",
      "CoupletIndex": 20,
      "SectionIndex1": 3,
      "SectionIndex2": 9
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "این حکایت وصف حالی شد بیان",
      "CoupletIndex": 21,
      "SectionIndex1": 3,
      "SectionIndex2": 10
    },
    {
      "VOrder": 79,
      "Position": "Left",
      "Text": "از برای مردمان این زمان",
      "CoupletIndex": 21,
      "SectionIndex1": 3,
      "SectionIndex2": 10
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "کز شراب فکر باطل روز و شب",
      "CoupletIndex": 22,
      "SectionIndex1": 3,
      "SectionIndex2": 11
    },
    {
      "VOrder": 83,
      "Position": "Left",
      "Text": "مست و لایعقل به لهوند و لعب",
      "CoupletIndex": 22,
      "SectionIndex1": 3,
      "SectionIndex2": 11
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "غافل از سود و زیانش بردوام",
      "CoupletIndex": 23,
      "SectionIndex1": 3,
      "SectionIndex2": 12
    },
    {
      "VOrder": 87,
      "Position": "Left",
      "Text": "دیگ سر در جوش از سودای خام",
      "CoupletIndex": 23,
      "SectionIndex1": 3,
      "SectionIndex2": 12
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "نفس سرکش گشته برایشان سوار",
      "CoupletIndex": 24,
      "SectionIndex1": 3,
      "SectionIndex2": 13
    },
    {
      "VOrder": 91,
      "Position": "Left",
      "Text": "خوش کشیده چون خرانشان زیر بار",
      "CoupletIndex": 24,
      "SectionIndex1": 3,
      "SectionIndex2": 13
    },
    {
      "VOrder": 93,
      "Position": "Right",
      "Text": "با هزاران گیر و دارو دبد به",
      "CoupletIndex": 25,
      "SectionIndex1": 3,
      "SectionIndex2": 14
    },
    {
      "VOrder": 95,
      "Position": "Left",
      "Text": "روغنی گوید که هستم در دبه",
      "CoupletIndex": 25,
      "SectionIndex1": 3,
      "SectionIndex2": 14
    },
    {
      "VOrder": 97,
      "Position": "Right",
      "Text": "تا بجوش آرد از آن دیگ طمع",
      "CoupletIndex": 26,
      "SectionIndex1": 3,
      "SectionIndex2": 15
    },
    {
      "VOrder": 99,
      "Position": "Left",
      "Text": "جمله را سازد بدل حرص مع",
      "CoupletIndex": 26,
      "SectionIndex1": 3,
      "SectionIndex2": 15
    },
    {
      "VOrder": 101,
      "Position": "Right",
      "Text": "پس از آن اندیشه ها زاید بدل",
      "CoupletIndex": 27,
      "SectionIndex1": 3,
      "SectionIndex2": 16
    },
    {
      "VOrder": 103,
      "Position": "Left",
      "Text": "جان و دل گردد اسیر آب و گل",
      "CoupletIndex": 27,
      "SectionIndex1": 3,
      "SectionIndex2": 16
    },
    {
      "VOrder": 105,
      "Position": "Right",
      "Text": "خانه هاسازد پس از وهم و خیال",
      "CoupletIndex": 28,
      "SectionIndex1": 3,
      "SectionIndex2": 17
    },
    {
      "VOrder": 107,
      "Position": "Left",
      "Text": "بر دل و بر جان نهدبار عیال",
      "CoupletIndex": 28,
      "SectionIndex1": 3,
      "SectionIndex2": 17
    },
    {
      "VOrder": 109,
      "Position": "Right",
      "Text": "هر زمانی نوعی نماید جلوه",
      "CoupletIndex": 29,
      "SectionIndex1": 3,
      "SectionIndex2": 18
    },
    {
      "VOrder": 111,
      "Position": "Left",
      "Text": "برسرهر یک گذارد دبه",
      "CoupletIndex": 29,
      "SectionIndex1": 3,
      "SectionIndex2": 18
    },
    {
      "VOrder": 113,
      "Position": "Right",
      "Text": "ناگهان آن دبه افتد بشکند",
      "CoupletIndex": 30,
      "SectionIndex1": 3,
      "SectionIndex2": 19
    },
    {
      "VOrder": 115,
      "Position": "Left",
      "Text": "جمله را بنیاد هستی برکند",
      "CoupletIndex": 30,
      "SectionIndex1": 3,
      "SectionIndex2": 19
    },
    {
      "VOrder": 117,
      "Position": "Right",
      "Text": "خانمان جمله را ویران کند",
      "CoupletIndex": 31,
      "SectionIndex1": 3,
      "SectionIndex2": 20
    },
    {
      "VOrder": 119,
      "Position": "Left",
      "Text": "جان و دل در داغ آن بریان کند",
      "CoupletIndex": 31,
      "SectionIndex1": 3,
      "SectionIndex2": 20
    },
    {
      "VOrder": 121,
      "Position": "Right",
      "Text": "گر تو راهوشیست رو کنجی بمیر",
      "CoupletIndex": 32,
      "SectionIndex1": 3,
      "SectionIndex2": 21
    },
    {
      "VOrder": 123,
      "Position": "Left",
      "Text": "تا توانی دبه اش برسرمگیر",
      "CoupletIndex": 32,
      "SectionIndex1": 3,
      "SectionIndex2": 21
    },
    {
      "VOrder": 125,
      "Position": "Right",
      "Text": "پیش از آن کود به ات بنهد بسر",
      "CoupletIndex": 33,
      "SectionIndex1": 3,
      "SectionIndex2": 22
    },
    {
      "VOrder": 127,
      "Position": "Left",
      "Text": "دبه بشکن بگذر از نفع و ضرر",
      "CoupletIndex": 33,
      "SectionIndex1": 3,
      "SectionIndex2": 22
    },
    {
      "VOrder": 129,
      "Position": "Right",
      "Text": "ایخوش آنکو مرد و این دبه شکست",
      "CoupletIndex": 34,
      "SectionIndex1": 3,
      "SectionIndex2": 23
    },
    {
      "VOrder": 131,
      "Position": "Left",
      "Text": "گشت خاموش و زهر رنجی برست",
      "CoupletIndex": 34,
      "SectionIndex1": 3,
      "SectionIndex2": 23
    },
    {
      "VOrder": 133,
      "Position": "Right",
      "Text": "گرتو هستی مرده با خود دم مزن",
      "CoupletIndex": 35,
      "SectionIndex1": 3,
      "SectionIndex2": 24
    },
    {
      "VOrder": 135,
      "Position": "Left",
      "Text": "تا قدم ننهی به صحرای فتن",
      "CoupletIndex": 35,
      "SectionIndex1": 3,
      "SectionIndex2": 24
    },
    {
      "VOrder": 137,
      "Position": "Right",
      "Text": "مرده کی دارد زبان گفتگو",
      "CoupletIndex": 36,
      "SectionIndex1": 3,
      "SectionIndex2": 25
    },
    {
      "VOrder": 139,
      "Position": "Left",
      "Text": "روزبان از گفتگو کن شستشو",
      "CoupletIndex": 36,
      "SectionIndex1": 3,
      "SectionIndex2": 25
    },
    {
      "VOrder": 141,
      "Position": "Right",
      "Text": "مرده تو گرچه گوئی مرده ام",
      "CoupletIndex": 37,
      "SectionIndex1": 3,
      "SectionIndex2": 26
    },
    {
      "VOrder": 143,
      "Position": "Left",
      "Text": "مرده کی دم زد ز بهر بیش و کم",
      "CoupletIndex": 37,
      "SectionIndex1": 3,
      "SectionIndex2": 26
    },
    {
      "VOrder": 145,
      "Position": "Paragraph",
      "Text": "الهی دبدبه سوار ستمکار نفس را که کوکبه غرور و نخوتست بر ما مگمار و دبه که پیوسته نفس را بجوش آرد و آتش حرص و حسد را بخروش بر سرما مگذار زبان ما را از آنچه زیان است خاموش کن و خیالات رنگارنگ باطل راز دل فراموش تا جز ذکر تو بر زبان نیاریم و جز فکر تو در دل نگذاریم.",
      "CoupletIndex": 38
    }
  ]
}
