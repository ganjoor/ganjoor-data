    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "صف کشیده چاکران در وی هزار",
      "CoupletIndex": 14,
      "SectionIndex1": 2,
      "SectionIndex2": 8
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "گاه سازد بند فرزند و زنت",
      "CoupletIndex": 15,
      "SectionIndex1": 2,
      "SectionIndex2": 9
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "طوق لعنت را نهد بر گردنت",
      "CoupletIndex": 15,
      "SectionIndex1": 2,
      "SectionIndex2": 9
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "گه ز دوزخ گوید و گاه از بهشت",
      "CoupletIndex": 16,
      "SectionIndex1": 2,
      "SectionIndex2": 10
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "گه به کعبه آردت گاهی کنشت",
      "CoupletIndex": 16,
      "SectionIndex1": 2,
      "SectionIndex2": 10
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "گه به شهر و گه به صحرا خواندت",
      "CoupletIndex": 17,
      "SectionIndex1": 2,
      "SectionIndex2": 11
    },
    {
      "VOrder": 65,
      "Position": "Left",
      "Text": "گه به ساحل گه بدریا راندت",
      "CoupletIndex": 17,
      "SectionIndex1": 2,
      "SectionIndex2": 11
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "گه گذارد تاج شاهی برسرت",
      "CoupletIndex": 18,
      "SectionIndex1": 2,
      "SectionIndex2": 12
    },
    {
      "VOrder": 69,
      "Position": "Left",
      "Text": "گه دواند چون گدا برهر درت",
      "CoupletIndex": 18,
      "SectionIndex1": 2,
      "SectionIndex2": 12
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "گه بصلحت آرد و گاهی بجنگ",
      "CoupletIndex": 19,
      "SectionIndex1": 2,
      "SectionIndex2": 13
    },
    {
      "VOrder": 73,
      "Position": "Left",
      "Text": "گه بنامت میکشد گاهی به ننگ",
      "CoupletIndex": 19,
      "SectionIndex1": 2,
      "SectionIndex2": 13
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "گه ز عزت در طمع اندازدت",
      "CoupletIndex": 20,
      "SectionIndex1": 2,
      "SectionIndex2": 14
    },
    {
      "VOrder": 77,
      "Position": "Left",
      "Text": "تا بذلت در طمع مع سازدت",
      "CoupletIndex": 20,
      "SectionIndex1": 2,
      "SectionIndex2": 14
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "هر زمان بنمایدت رنگی دگر",
      "CoupletIndex": 21,
      "SectionIndex1": 2,
      "SectionIndex2": 15
    },
    {
      "VOrder": 81,
      "Position": "Left",
      "Text": "سازد از بهر تو نیرنگی دگر",
      "CoupletIndex": 21,
      "SectionIndex1": 2,
      "SectionIndex2": 15
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "تا نماید فرع را پیش تو اصل",
      "CoupletIndex": 22,
      "SectionIndex1": 2,
      "SectionIndex2": 16
    },
    {
      "VOrder": 85,
      "Position": "Left",
      "Text": "سازدت مهجور از دربار وصل",
      "CoupletIndex": 22,
      "SectionIndex1": 2,
      "SectionIndex2": 16
    },
    {
      "VOrder": 87,
      "Position": "Paragraph",
      "Text": "فرع نمودیست فانی واصل بودیست باقی گر طالب وصلی باصل کوش و از فرع دیده بپوش هندوی نفس را مسلمان کن تا از چنگ نیرنگ برآئی جمعیت افکار مکر را از دل پریشان کن تا از در بیرنگی درآئی",
      "CoupletIndex": 23
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "پای بیرنگی چو آمد در میان",
      "CoupletIndex": 24,
      "SectionIndex1": 3,
      "SectionIndex2": 5
    },
    {
      "VOrder": 91,
      "Position": "Left",
      "Text": "رنگ و نیرنگت همه شد برکران",
      "CoupletIndex": 24,
      "SectionIndex1": 3,
      "SectionIndex2": 5
    },
    {
      "VOrder": 93,
      "Position": "Right",
      "Text": "لیک تا در دل بکاری تخم رنگ",
      "CoupletIndex": 25,
      "SectionIndex1": 3,
      "SectionIndex2": 6
    },
    {
      "VOrder": 95,
      "Position": "Left",
      "Text": "حاصلی جز رنگ کی آری بچنگ",
      "CoupletIndex": 25,
      "SectionIndex1": 3,
      "SectionIndex2": 6
    },
    {
      "VOrder": 97,
      "Position": "Right",
      "Text": "اینهمه رنگ تو اندر کف دلا",
      "CoupletIndex": 26,
      "SectionIndex1": 3,
      "SectionIndex2": 7
    },
    {
      "VOrder": 99,
      "Position": "Left",
      "Text": "یکدو روزی بیش نبود چون حنا",
      "CoupletIndex": 26,
      "SectionIndex1": 3,
      "SectionIndex2": 7
    },
    {
      "VOrder": 101,
      "Position": "Right",
      "Text": "دست و پا رازین حنا کن شستشو",
      "CoupletIndex": 27,
      "SectionIndex1": 3,
      "SectionIndex2": 8
    },
    {
      "VOrder": 103,
      "Position": "Left",
      "Text": "رنگ را بگذار و بیرنگی بجو",
      "CoupletIndex": 27,
      "SectionIndex1": 3,
      "SectionIndex2": 8
    },
    {
      "VOrder": 105,
      "Position": "Right",
      "Text": "تا ز بند هجر آزادت کند",
      "CoupletIndex": 28,
      "SectionIndex1": 3,
      "SectionIndex2": 9
    },
    {
      "VOrder": 107,
      "Position": "Left",
      "Text": "در کمند وصل دلشادت کند",
      "CoupletIndex": 28,
      "SectionIndex1": 3,
      "SectionIndex2": 9
    }
  ]
}
