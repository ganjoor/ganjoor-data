  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "شنیدم یکی از ملوک عجم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
