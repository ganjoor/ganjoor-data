  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "بخیلی شنیدم یکی روز، چاشت",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "بدستار خوان نان، عسل نیز داشت",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "شنید از در خانه آواز پای",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
