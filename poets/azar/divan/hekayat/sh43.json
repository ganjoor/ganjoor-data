  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "شنیدم که طمقاج با داد و دین",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "چو شد دادگر در خراسان زمین",
