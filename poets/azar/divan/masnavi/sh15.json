    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "دل آگاه و لب خامششان",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: دل‌های آگاه و ساکت آن‌ها، باعث آرامش دیگران می‌شود و خوشی‌هایشان را به همه منتقل می‌کند."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "خلق آسوده ز خلق خوششان",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "دور و نزدیک، ازیشان در مهد",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: در هر دو سوی دور و نزدیک، ترک و تاجیک در یک مهد قرار دارند و با یکدیگر عهد و پیمان دارند."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "ترک و تاجیک، بایشان هم عهد",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "خنجر رستمشان، هر دو بمشت",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: خنجر رستم در دست آن‌ها، همان‌قدر است که انگشتان خاتم حاتم را در چنگ دارد."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "خاتم حاتمشان، در انگشت",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "از صفاهان، که ز عامل ویران",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: در صفاهان، مانند ویرانی که عامل آن غم ضحاک باشد، ایران نیز به چنین شرایطی دچار شده بود."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "بود چون از غم ضحاک، ایران",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "تا رهانند از آن گرگ رمه",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: تا وقتی که از دست گرگ (نابهنجاری) نجات پیدا کنیم، مظلومان مجبورند از ظلم و ستم رنج ببرند."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "داد مظلوم کشند از ظلمه",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "با تنی چند ز مردان گزین",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: با چند نفر از مردان شجاع انتخاب کن و هر دو بر روی اسبتان، نشانی از دلیری و شجاعت بزنید."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "هر دو بر رخش جلادت زده زین",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "کرده دست ستم آن گمراه",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: دست ستم و ظلم آن شخص گمراه، بر سر مردم اهل اصفهان کوتاه شده است."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "از سر اهل صفاهان کوتاه",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "چون فلک را سر انصاف نبود",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: چون آسمان عدل و انصاف ندارد، دل اهل دل نیز با او صاف نیست."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "سینه با اهل دلش صاف نبود",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "از تله ساخته آن گرگ یله",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "CoupletSummary": "هوش مصنوعی: یک گرگ که در تله‌اش آزاد شده، مسیرش را به سمت چراگاه گوساله‌ها تغییر می‌دهد."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "داد راهش بچراگاه گله",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "گرگ نه، رو به پیری بمثل",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17,
      "CoupletSummary": "هوش مصنوعی: هرگز مانند گرگ نباش، چرا که در آستانه پیری باید از روباه که بیشتر حیله‌گری می‌کند، یاد بگیری."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "که ز روباه فزون داشت حیل",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "از فسونهاش دو نوخاسته شیر",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18,
      "CoupletSummary": "هوش مصنوعی: زیورهایی که به گردن این دو جوان زیبا آویخته شده، به مانند زنجیری شده است که آن‌ها را به هم پیوند می‌دهد."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "زیور گردنشان شد زنجیر",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "حمله آورد بشیران جوان",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19,
      "CoupletSummary": "هوش مصنوعی: خبر آوران جوان، با حمله‌ای به شدت به زمین کوبیدند که هیچ‌کس نمی‌توانست آن را توصیف کند."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "ستمی کرد که گفتن نتوان",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "سرشان کرد جدا از تنشان",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20,
      "CoupletSummary": "هوش مصنوعی: سرهایشان جدا از بدنشان شده و از زنجیر رها گشته‌اند. گردن‌هایشان آزاد شده است."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "شد ز زنجیر رها گردنشان",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "رفته با آن دو تن پاک سرشت",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21,
      "CoupletSummary": "هوش مصنوعی: به همراه آن دو انسان پاکفطرت، هشت انسان دیگر نیز به سوی هشت بهشت رفته‌اند."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "هشت تن نیز سوی هشت بهشت",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "سر بی افسرشان کرد بقهر",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22,
      "CoupletSummary": "هوش مصنوعی: با غضب و خشمی که داشت، مانند ماه و خورشید، سر بی‌افسران را به هر شهری می‌برد."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "چون مه و مهر روان شهر بشهر",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "بیگنه، کشته شدند آن شهدا",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23,
      "CoupletSummary": "هوش مصنوعی: بی‌گناهی آن شهدا باعث شد که جان خود را از دست بدهند، و همیشه بر آنها رحمت باد."
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "رحمه الله علیهم ابدا",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "خونشان، خون سیاووشان باد",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24,
      "CoupletSummary": "هوش مصنوعی: خون آن‌ها، همچون خون سیاوش باید که هر ساله از زمین بجوشد."
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "همه ساله ز زمین جوشان باد",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "تا نگویند که خون مظلوم",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25,
      "CoupletSummary": "هوش مصنوعی: تا زمانی که نگویند خون کسانی که مظلوم واقع شده‌اند، نادیده گرفته شده و بی‌اهمیت است."
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "شمرد سهل قدیر قیوم",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "زد دو مصرع رقم آن روز آذر",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26,
      "CoupletSummary": "هوش مصنوعی: در روز آذر، دو خط نوشته شده که هر یک از آنها خبر از آن سال به ما می‌دهد."
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "که دهد هر یک از آن سال خبر:",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "دو شهیدند، جهانگیر و رشید",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27,
      "CoupletSummary": "هوش مصنوعی: دو نفر از جوانان شجاع در بهشت جاویدان قرار دارند، یکی با نام جهانگیر و دیگری با نام رشید، که جانشان را در راه آزادی فدا کردند."
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "ببهشتند جوانان شهید(۱۱۹۲ ه.ق)",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    }
  ]
}
