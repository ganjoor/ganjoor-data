  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ای آفتاب آینه دار جمال تو",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای خورشید که زیبایی‌ات در آینه منعکس می‌شود، همانند مشک سیاهی که گرد و غبار خال تو را در بر می‌گیرد."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "مشک سیاه مجمره گردان خال تو",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "صحن سرای دیده بشستم ولی چه سود",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: نگاه و دلم را برای تو پاک کردم، اما چه فایده دارد که هنوز هم هیچ چیز در اینجا نیست که به اندازه تو زیبا باشد."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "کـ‌این گوشه نیست درخور خیل خیال تو",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "در اوج ناز و نعمتی ای پادشاه حسن",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای پادشاه زیبایی، در اوج زیبایی و نعمت خود هستی، ای کاش تا ابد و همیشه چنین بمانی و از بین نروی."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "یا رب مباد تا به قیامت زوال تو",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "مطبوعتر ز نقش تو صورت نبست باز",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هیچ تصویری به زیبایی چهره تو ایجاد نشده است، حتی طغرانویس (خط زیبای فارسی) با ابروهای مشکی تو قابل مقایسه نیست."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "طغرانویس ابروی مشکین مثال تو",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "در چین زلفش ای دل مسکین چگونه‌ای",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در چین‌های زلف او ای دل بی‌چاره چه حالی داری، که باد صبا آشفته و پریشان، داستان تو را برایش روایت کرده است."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "کآشفته گفت باد صبا شرح حال تو",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "برخاست بوی گل ز در آشتی درآی",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: عطر گل به مشام می‌رسد، بیا و وارد شایستگی بهاری جدید شو، صورت خوش یمنی که مقدر شده برای تو."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "ای نوبهار ما رخ فرخنده فال تو",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "تا آسمان ز حلقه به گوشان ما شود",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به آسمان خواهیم رسید، چون زیبایی و جذابیت ابروی تو، همچون هلال، دل‌انگیز است."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "کو عشوه‌ای ز ابروی همچون هلال تو",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "تا پیش بخت بازروم تهنیت کنان",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: باید با خوشحالی و شکرگذاری به سراغ شانس خود برویم و خبر خوشی از آمدن عید وصل تو را بشنویم."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "کو مژده‌ای ز مقدم عید وصال تو",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "این نقطه سیاه که آمد مدار نور",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: این نقطه سیاه که در نور ظاهر شده، نمادی است از تأثیر عمیق و زیبایی چهره‌ات در دنیای فکر و احساس من."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "عکسیست در حدیقه بینش ز خال تو",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "در پیش شاه عرض کدامین جفا کنم",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: نمی‌دانم چگونه باید در حضور شاه از سختی‌های خود بگویم؛ آیا باید درد دل خودم را بیان کنم یا از غم تو بگویم؟"
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "شرح نیازمندی خود یا ملال تو",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "حافظ در این کمند سر سرکشان بسیست",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: حافظ در اینجا اشاره دارد به اینکه او در دام جوانان فریبنده و سرکش افتاده است. از آن‌ها می‌خواهد که به خاطر نادرست‌کاری‌ها و خیالات باطل خود، خود را به زحمت نیندازند، زیرا فرصتی برای آن‌ها وجود ندارد."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "سودای کج مپز که نباشد مجال تو",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    }
  ],
