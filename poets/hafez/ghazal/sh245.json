  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "الا ای طوطیِ گویا‌یِ اسرار!",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای طوطی باهوش و سخنگو، مواظب باش که زبانت هرگز از شیرینی حرف خالی نشود."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "مبادا خالیَت شَکَّر ز مِنقار",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "سَرَت سبز و دلت خوش باد، جاوید",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: سر تو سبز و دل تو شاد باد همیشه که نشان زیبا و خوشی از محبت یار را به نمایش گذاشته‌ای."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "که خوش نقشی نمودی از خطِ یار",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "سخن سربسته گفتی با حریفان",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: با دوستانت به طرز اشاره‌آمیز سخن گفتی، حالا از خدا بخواه تا این راز را برایت روشن کند."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "خدا را زین معما پرده بردار",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "به رویِ ما زن از ساغر گلابی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: برای ما از جام گلاب بریز، ما در رویای شیرین و خواب‌آلودیم، ای خوب بخت بیدار."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "که خواب‌آلوده‌ایم، ای بختِ بیدار!",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "چه رَه بود این که زد در پرده مطرب؟",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چه رازی در این است که مطرب پرده را کنار زده است؟ که در آن حال، مست و هشیار به هم می‌رقصند."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "که می‌رقصند با هم مست و هشیار",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "از آن افیون که ساقی در مِی افکند",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از آن شرابی که ساقی در لیوان می‌ریزد، حریفان نه سَر دارند و نه دستار."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "حریفان را نه سَر مانَد، نه دَستار",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "سِکَندَر را نمی‌بخشند آبی",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: سکندر به خاطر داشتن قدرت و ثروت نمی‌تواند همه چیز را به دست آورد، زیرا دستیابی به برخی چیزها آسان نیست و نمی‌توان با زور و پول همه چیز را خرید."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "به زور و زر مُیَسَّر نیست این کار",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "بیا و حالِ اهلِ درد بشنو",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بیایید و حال کسانی را که در درد و رنج هستند بشنوید، با کلماتی کم اما معنایی عمیق."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "به لفظِ اندک و معنیِ بسیار",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "بُتِ چینی عدویِ دین و دل‌هاست",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: مجسمه‌های چینی دشمن دین و احساسات انسانی هستند. خداوندا، از تو می‌خواهم که دل و عقیده‌ام را حفظ کنی."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "خداوندا دل و دینم نگه دار",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "به مستور‌ان مگو اسرارِ مستی",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به پنهان‌کاران از رازهای مستی نگو، و داستان جان را بر دیوار نگذارش."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "حدیثِ جان مگو با نقشِ دیوار",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "به یُمنِ دولتِ منصور شاهی",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به برکت و لطف حکومت منصور، حافظ در سرایش شعرها نامدار و مشهور شد."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "عَلَم شد حافظ اندر نظمِ اشعار",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "خداوندی به جایِ بندگان کرد",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: خداوند به جای بندگان خود، برتری و مقام بالایی قرار داده است. ای خدا، آن‌ها را از آسیب‌ها و خطرات محفوظ بدار."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "خداوندا ز آفاتش نگه دار",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    }
  ],
