  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "الا ای طوطیِ گویا‌یِ اسرار!",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای طوطی سخنگو که رازها را بازگو می‌کنی، هرگز منقارت از شکر خالی مباد. طوطی می‌تواند کنایه از پیک یا سخنور رازدان باشد."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "مبادا خالیَت شَکَّر ز مِنقار",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "سَرَت سبز و دلت خوش باد، جاوید",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: همیشه سرسبز و شادمان باشی، زیرا از خط یار (سبزهٔ نورستهٔ رخسار یا نوشتهٔ او) تصویر و وصف زیبایی نشان دادی."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "که خوش نقشی نمودی از خطِ یار",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "سخن سربسته گفتی با حریفان",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: با همدمان سخن را پوشیده و رمزآمیز گفتی؛ تو را به خدا از این معما پرده بردار و آن را آشکار بگو."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "خدا را زین معما پرده بردار",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "به رویِ ما زن از ساغر گلابی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای بخت بیدار، از جام گلابی (شرابی) به صورت ما بزن تا بیدار شویم، زیرا ما خواب‌آلوده و غافلیم."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "که خواب‌آلوده‌ایم، ای بختِ بیدار!",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "چه رَه بود این که زد در پرده مطرب؟",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: مطرب این چه آهنگی بود که در ساز نواخت که مست و هشیار همه با هم به رقص آمده‌اند؟"
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "که می‌رقصند با هم مست و هشیار",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "از آن افیون که ساقی در مِی افکند",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ساقی چنان مادهٔ بیهوش‌کننده‌ای در شراب ریخت که همدمان دیگر نه سر بر جای دارند و نه دستار؛ یعنی یکسره از خود بی‌خود شده‌اند."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "حریفان را نه سَر مانَد، نه دَستار",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "سِکَندَر را نمی‌بخشند آبی",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به اسکندر با همهٔ قدرتش جرعه‌ای از آب حیات نمی‌دهند؛ این کار با زور و زر به دست نمی‌آید و موهبتی است بخشیدنی."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "به زور و زر مُیَسَّر نیست این کار",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "بیا و حالِ اهلِ درد بشنو",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بیا و حال دردمندان عشق را بشنو که با سخن کوتاه اما پرمعنا بیان می‌شود."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "به لفظِ اندک و معنیِ بسیار",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "بُتِ چینی عدویِ دین و دل‌هاست",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: معشوق زیباروی چینی دشمن دین و دل‌هاست؛ خدایا دل و دین مرا از او نگه دار."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "خداوندا دل و دینم نگه دار",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "به مستور‌ان مگو اسرارِ مستی",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: رازهای مستی و عشق را به پارسایان پرده‌نشین و ظاهربین مگو؛ سخن جان را با کسی که چون نقش دیوار بی‌جان و بی‌درک است در میان مگذار."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "حدیثِ جان مگو با نقشِ دیوار",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "به یُمنِ دولتِ منصور شاهی",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به برکت دولت و فرمانروایی شاه منصور، حافظ در سرودن شعر نامدار و سرآمد شد."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "عَلَم شد حافظ اندر نظمِ اشعار",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "خداوندی به جایِ بندگان کرد",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: شاه منصور در حق بندگان خود سروری و بخشندگی کرد؛ خدایا او را از آفت‌ها و بلاها حفظ کن."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "خداوندا ز آفاتش نگه دار",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    }
  ],
