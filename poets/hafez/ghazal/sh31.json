  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "آن شبِ قدری که گویند اهلِ خلوت امشب است",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "آن شب قدر که اهل خلوت و عبادت از آن می‌گویند امشب است، خدایا این سعادت از تاثیر کدام کوکب و ستاره است؟"
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "یا رب این تأثیرِ دولت در کدامین کوکب است؟",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "تا به گیسویِ تو دستِ ناسزایان کم رسد",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "برای آنکه دست نالایقان به وصال گیسوی تو نرسد، هر دلی در این شب و هرکس در هر محفل در ذکر یارب یارب است."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "هر دلی از حلقه‌ای در ذکرِ یارب یارب است",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "کشته چاه زنخدان توام کز هر طرف",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "کشته مرده زیبایی چانه و چاه زنخندان تو هستم که در گرد آن چاه و غبغب، هزاران عاشق اسیر گشته‌اند."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "صد هزارش گردنِ جان زیرِ طوقِ غَبغَب است",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "شهسوارِ من که مه آیینه دارِ روی اوست",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "شهسوار و ماه یگانه من که غلام اوست تاج خورشید آسمان، خاک مرکب و اسب اوست."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "تاجِ خورشیدِ بلندش خاکِ نعلِ مَرکَب است",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "عکسِ خِوی بر عارضَش بین کآفتابِ گرم رو",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "ببین قطره‌های عرق و شبنم که بر روی اوست چه زیباست که آفتاب در هوای چشیدن آن گلاب‌، تشنه است و هر روز تب می‌کند."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "در هوایِ آن عَرَق تا هست هر روزش تب است",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "من نخواهم کرد تَرکِ لعلِ یار و جام می",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "من هرگز بوسه لب یار و جام می و مستی را رها نخواهم کرد، ای زاهد مرا معذور بدار که مذهب و کیش من همین است."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "زاهدان معذور داریدم که اینَم مذهب است",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "اندر آن ساعت که بر پشتِ صبا بندند زین",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "در آن ساعت و دم که بر پشت صبا و نسیم سوار می‌شوند چطور می‌توانم همراه سلیمان بتازم وقتی که موری مرکب من است؟"
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "با سلیمان چون برانم من که مورم مرکب است",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "آن که ناوَک بر دلِ من زیرِ چشمی می‌زند",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "آنکه تیر و ناوک غمزه بر دل من پنهانی می‌زند، روزی و غذای جان حافظ را نیز با خنده‌های پنهانی می‌دهد."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "قوتِ جانِ حافظش در خندهٔ زیر لب است",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "آبِ حیوانش ز منقارِ بلاغت می‌چکد",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "آب زندگانی و حیات جاودان از منقار زاغ سیه قلم\u00A0بلاغت من می‌چکد، چشم بد از او دور بادا! چه عالی‌نظر است."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "زاغِ کِلکِ من بنامیزد چه عالی مشرب است",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    }
  ],
