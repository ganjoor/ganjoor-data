  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ای روی ماه‌منظر تو نوبهار حُسن",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای چهره‌ات مانند ماه، بهار زیبایی توست و نشانه‌ها و خط‌های چهره‌ات مرکز و محور زیبایی هستند."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "خال و خط تو مرکز حُسن و مدار حُسن",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "در چشم پرخمار تو پنهان فسون سِحر",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چشم‌های خواب‌آلود تو دارای جادو و سحر است و در زلف‌های بی‌قرار تو زیبایی و آرامش مشاهده می‌شود."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "در زلف بی‌قرار تو پیدا قرار حُسن",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "ماهی نتافت همچو تو از برج نیکویی",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ماهی به آزادی و زیبایی تو نمی‌رسد، چون هیچ درختی به خوش‌اهمی به قامت تو نمی‌رسد."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "سروی نخاست چون قَدَت از جویبار حُسن",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "خرّم شد از ملاحت تو عهد دلبری",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: با زیبایی و دلربایی تو، زندگی خوش و خرم شده است و روزهای خوشی به خاطر لطافت و نرمی تو به وجود آمده است."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "فرّخ شد از لطافت تو روزگار حُسن",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "از دام زلف و دانهٔ خال تو در جهان",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هیچ دل‌پروری در این دنیا باقی نمانده است که به دام زلف و درخشش خال تو نیفتاده باشد و در برابر زیبایی‌ات شکار نشده باشد."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "یک مرغِ دل نماند نگشته شکار حُسن",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "دائم به لطف دایهٔ طبع از میانِ جان",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: همیشه به کمک و لطف طبیعت، تو را با عشق و ناز در کنار زیبایی می‌پرورانم و به زندگی می‌آورم."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "می‌پرورَد به ناز، تو را در کنار حُسن",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "گِرد لبَت بنفشه از آن تازه و تر است",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: گل‌های بنفشه اطراف لب‌های تو به قدری تازه و شاداب هستند که گویی از جویبار زیبایی زندگی می‌نوشند."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "کآب حیات می‌خورَد از جویبار حُسن",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "حافظ طمع برید که بیند نظیر تو",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: حافظ از امید فرار می‌کند، زیرا می‌بیند که در دنیا مانند تو وجود ندارد و زیبایی‌ات تنها در سرزمین زیبایی‌ها می‌درخشد."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "دیّار نیست جز رُخَت اندر دیار حُسن",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    }
  ],
