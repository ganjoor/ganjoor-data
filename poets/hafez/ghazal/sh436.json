  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "آن غالیه‌خط گر سوی ما نامه نوشتی",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "اگر آن یار خوش خط و خوش بو برای ما نامه ای می‌نوشت ، روزگار هم طومار وجود ما را در هم نمی‌پیچید."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "گردون ورق هستی ما درننوشتی",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "هر چند که هجران ثمر وصل برآرد",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هرچند که فراق باعث به ثمر رسیدن میوه ی وصال می شود اما ای کاش خالق هستی هیچوقت تخم هجران را در جهان نمی کاشت."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "دهقان جهان! کاش که این تخم نکِشتی",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "آمرزش نقد است کسی را که در این جا",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هرکس که در این دنیا یاری به زیبایی حوریان بهشتی و سرایی مانند خانه های بهشتی داشته باشد پیش از آنکه از دنیا برود آمرزیده شده است."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "یاری‌ست چو حوری و سرایی چو بهشتی",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "در مصطبهٔ عشق تنعم نتوان کرد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "ایوانِ عشق جای تن‌آسانی و راحتی نیست ، اما حالا که بالش نرم و زر بافت نیست با خشتِ (زیر سر) می سازیم."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "چون بالش زر نیست، بسازیم به خشتی",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "مفروش به باغ ارم و نخوت شداد",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "به خاطر باغ ارم و تکبر شداد بن عاد (وعده و وعید های زاهدان فریبکار) یک شیشه شراب نقد و یار شیرین لب و کنار کشتزار را از دست مده."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "یک شیشه می و نوش‌لبی و لبِ کِشتی",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "تا کی غم دنیای دنی ای دل دانا؟",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "ای صاحب معرفت تا کی میخواهی غم دنیای پست و زبون را بخوری؟ حیف است که زیبا و پاکی چون تو عاشق و اسیر زشت و ناپاکی مانند دنیا شود."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "حیف است ز خوبی که شود عاشق زشتی",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "آلودگی خرقه، خرابی جهان است",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "اگر زاهدان و عابدان آلوده شوند، نه تنها خود را بلکه جهانی را آلوده می کنند؛ کجاست راهروی حقیقی؟ کجاست صاحب معرفتی؟ کجاست شخص پاک طینتی؟"
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "کو راهروی، اهلِ دلی، پاک‌سرشتی؟",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "از دست چرا هِشت سرِ زلف تو حافظ؟",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "ای محبوب، حافظ چرا زلف تو را رها کرد و به وصال تو نرسید؟ تقدیر این چنین رقم زد وگرنه چه می توانست بکند اگر رها نمی کرد؟"
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "تقدیر چنین بود، چه کردی که نهِشتی؟",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    }
  ],
