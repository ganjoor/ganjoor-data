  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "گوهرِ مخزنِ اسرار همان است که بود",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: گوهر نهفته در رازها همان چیزی است که در ظرف عشق و محبت با نشانه و علامت خاصی وجود دارد."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "حُقِّهٔ مِهر بدان مُهر و نشان است که بود",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "عاشقان زُمرهٔ اربابِ امانت باشند",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: عاشقان افرادی هستند که به عهد و امانت وفادارند و بنابراین، چشم‌های پر از محبت و شفاف آن‌ها باید همان باشد که هست."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "لاجرم چشمِ گهربار همان است که بود",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "از صبا پرس که ما را همه شب تا دمِ صبح",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از نسیم صبح بخواه که به من بگوید، در تمام شب تا سپیده دم، رایحه موهای تو تنها همدم جانم بوده است که همیشه کنارم بوده."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "بویِ زلفِ تو همان مونسِ جان است که بود",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "طالب لعل و گهر نیست وگرنه خورشید",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در جستجوی جواهرات و سنگ‌های قیمتی نیستم، زیرا خورشید هنوز هم همانند گذشته به کار در معدن و استخراج معادن ادامه می‌دهد."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "هم‌چُنان در عملِ معدن و کان است که بود",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "کشتهٔ غمزهٔ خود را به زیارت دریاب",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: کسی که بر اثر زیبایی معشوقه‌اش به شدت دچار درد و رنج شده است، حالا به دیدن او بیاید. زیرا این دل نگران و پریشان، همان دل‌مشغولی است که همیشه بوده است."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "زانکه بیچاره همان دل‌نگران است که بود",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "رنگِ خونِ دلِ ما را که نهان می‌داری",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: رنگ غم و اندوه ما را که پنهان می‌کنی، اما در لب‌های سرخ تو به وضوح دیده می‌شود که این احساس وجود دارد."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "همچنان در لبِ لعلِ تو عیان است که بود",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "زلفِ هندویِ تو گفتم که دگر رَه نزند",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: زلف‌های زیبای تو را گفتم که دیگر نمی‌توانم به آن فکر کنم. سال‌ها گذشته و آن‌چه در تو بود همچنان باقی مانده است."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "سال‌ها رفت و بدان سیرت و سان است که بود",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "حافظا بازنما قصه خونابهٔ چشم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای حافظ، دوباره بگو داستان اشک‌هایی را که از چشمانم می‌ریزد، چرا که این چشمه همان آبی است که همیشه جاری بوده است."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "که بر این چشمه همان آبِ روان است که بود",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    }
  ],
