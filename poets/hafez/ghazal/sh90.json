  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ای هدهد صبا به سبا می‌فرستمت",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "ای هدهد پیک صبا تو را به سوی سرزمین سبا می‌فرستم به‌هوش باش که از کجا به کجا می‌روی."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "بنگر که از کجا به کجا می‌فرستمت",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "حیف است طایری چو تو در خاک‌دانِ غم",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "حیف است پرنده‌ای مثل تو در این خاک‌دان غم بمانی‌؛ تو را به سرزمین مهر و وفا می‌فرستم."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "زین جا به آشیانِ وفا می‌فرستمت",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "در راهِ عشق مرحلهٔ قُرب و بُعد نیست",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "در راه و مسلک عشق‌، دوری و نزدیکی وجود ندارد هرجایی باشی تو را می‌بینم و تو را دعا می‌گویم."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "می‌بینمت عیان و دعا می‌فرستمت",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "هر صبح و شام قافله‌ای از دعای خیر",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هر صبح و هر شامگاه کاروانی از دعای خیر و با گفتگو با باد شَمال و باد صبا بسوی تو روانه می‌کنم."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "در صحبتِ شمال و صبا می‌فرستمت",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "تا لشکرِ غمت نکند مُلکِ دل خراب",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "تا لشکر غم و اندوه تو را غمگین و شکسته نکند جان عزیز خود را به نوا به تو تقدیم می‌کنم."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "جانِ عزیزِ خود به نوا می‌فرستمت",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "ای غایب از نظر که شدی هم‌نشین دل",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "ای یار غایب از دیده که در دل جای داری، تو را دعای خیر می‌گویم و به‌تو آفرین می‌فرستم."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "می‌گویمت دعا و ثنا می‌فرستمت",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "در رویِ خود تَفَرُّجِ صُنع خدای کن",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "به رخ زیبای خود بنگر و از آفریده شگفت خدا لذت ببر در این آیینه خدای‌نما که برایت می‌فرستم."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "کآیینهٔ خدای‌نما می‌فرستمت",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "تا مطربان ز شوقِ مَنَت آگهی دهند",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "تا مطربان و خوانندگان با شوق و شور بتوانند عشق مرا برای تو بیان کنند این غزل را آهنگین و با نوا به تو تقدیم می‌کنم."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "قول و غزل به ساز و نوا می‌فرستمت",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "ساقی بیا که هاتفِ غیبم به مژده گفت",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "ای ساقی بیا که سروش غیبی خبری شادی‌آور برایم آورده و به من گفته‌است که با درد بساز که برای تو دوا و درمان می‌فرستم."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "با درد صبر کن که دوا می‌فرستمت",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "حافظ، سرودِ مجلس ما ذکرِ خیرِ توست",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "ای حافظ ذکر خوبی‌های تو شادی‌بخش و سرود مجلس ماست؛ به مجلس ما بیا که برایت اسب و خلعت فرستاده‌ایم."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "بشتاب هان که اسب و قبا می‌فرستمت",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    }
  ],
