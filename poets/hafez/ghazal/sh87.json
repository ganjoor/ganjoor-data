  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "حُسنت به اتفاقِ ملاحت جهان گرفت",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "نمک و ملاحت تو همراه با زیبایی و تناسبت عالم گیر شده،این قضیه روشن کرد که می‌توان با اتحاد جهان را گرفت."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "آری، به اتفاق، جهان می‌توان گرفت",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "افشایِ رازِ خلوتیان خواست کرد شمع",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "شمع قصد کرد که راز خلوت‌نشینان را فاش کند‌، خدای را سپاس که راز دل‌، زبانش را آتش زد."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "شُکرِ خدا، که سِرِ دلش در زبان گرفت",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "زین آتشِ نهفته که در سینهٔ من است",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "خورشید عالم‌تاب‌، شراره‌ای از آتش پنهانی است که از سینه من در آسمان زد."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "خورشید، شعله‌ای‌ست که در آسمان گرفت",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "می‌خواست گُل که دَم زند از رنگ و بویِ دوست",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "گل نیز خواست که با حال و زیبایی خود وصفی از یار من گوید، صبا از غیرت‌، او را خموش کرد."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "از غیرتِ صبا، نفسَش در دهان گرفت",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "آسوده بر کنار چُو پرگار می‌شدم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "چون پرگار (دور از بلای عشق یا دور از حوادث) بر کناره می‌رفتم‌، اما دست روزگار مرا همچون نقطه (پرگار) به میانه کشید."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "دوران، چو نقطه، عاقبتم در میان گرفت",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "آن روز شوقِ ساغرِ مِی، خرمنم بسوخت",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "می نوش و می‌گسار نبودم تا روزی که زیبایی ساقی (که عکسش در جام افتاد یا آتشی که در می بود) آتش در خرمنم زد."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "کآتش زِ عکسِ عارضِ ساقی در آن گرفت",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "خواهم شدن به کویِ مُغان آستین‌فشان",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "شاد و فارغ از همه‌چیز دارم به‌سوی کوی می‌فروشان می‌روم از دست این فتنه‌های فراوان که (امروز) گویی آخرالزمان است."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "زین فتنه‌ها که دامنِ آخرزمان گرفت",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "مِی خور که هر که آخرِ کارِ جهان بِدید",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هرکه دانا است و آخر کار جهان را دید پر از شادی شد و جام‌های می پر و سنگین را تهی کرد."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "از غم سبک برآمد و رَطلِ گران گرفت",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "بر برگِ گُل به خونِ شقایق نوشته‌اند",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "از گل سرخ تا خون شقایق به تو می‌گویند: کسی پخته‌ و داناست که می زلال و ناب ارغوانی گرفت."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "«کآن\u00A0کس که پخته شد، مِیِ چون اَرغَوان گرفت»",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "حافظ چو آبِ لطف ز نظمِ تو می‌چِکد",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "حافظا وقتی که آب لطافت از نظم تو می‌چکد، حسود کی می‌تواند بر شعرت خرده بگیرد؟"
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "حاسِد چگونه نکته تواند بر آن گرفت؟",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    }
  ],
