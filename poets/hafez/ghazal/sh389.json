  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "چو گل هر دم به بویت جامه در تن",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر لحظه به بوی تو مانند گل، لباس خود را چاک می‌کنم و از گردن تا دامن آشکار می‌سازم."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "کنم چاک از گریبان تا به دامن",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "تنت را دید گل گویی که در باغ",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تو مانند گلی هستی که در باغ می‌درخشی و تماشای زیبایی‌ات، مرا به شدت شاداب و مست می‌کند؛ به‌طوری‌که انگار جامه‌ام را از شوق برمی‌دارم و به تو نزدیک می‌شوم."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "چو مستان جامه را بدرید بر تن",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "من از دست غمت مشکل برم جان",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من از غم تو به سختی جان می‌برم، اما تو به راحتی دل مرا از خودت دور کردی."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "ولی دل را تو آسان بردی از من",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "به قول دشمنان برگشتی از دوست",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به گفتهٔ دشمنان، تو به عشق و دوستی پشت کردی، اما هیچ‌کس نمی‌تواند با دوست، دشمنی کند."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "نگردد هیچ کس با دوست دشمن",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "تنت در جامه چون در جام باده",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بدن تو در لباس مانند جام شراب است و دل تو در سینه مثل آهن است که درونش سیم است. این نکته را می‌رساند که ظاهر به زیبایی جام شراب است، ولی درونت مانند آهنی سخت و محکم است."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "دلت در سینه چون در سیم آهن",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "ببار ای شمع اشک از چشم خونین",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای شمع، اشک از چشمان خونینت بریز، زیرا سوزش دل تو به خوبی برای دیگران روشن شده است."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "که شد سوز دلت بر خلق روشن",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "مکن کز سینه‌ام آه جگرسوز",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از سینه‌ام آهی جانسوز برمی‌خیزد که مانند دود از روزنه بیرون می‌آید، پس چنین نکنید که باعث رنجش و آزار من شوید."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "برآید همچو دود از راه روزن",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "دلم را مشکن و در پا مینداز",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دلم را نشکن و زیر پا نگذار که در زلف تو، محل نشستن و آرامش من است."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "که دارد در سر زلف تو مسکن",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "چو دل در زلف تو بسته‌ست حافظ",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چون دل حافظ به زلف تو وابسته است، نباید کار او را با پا از بین ببری."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "بدین سان کار او در پا میفکن",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    }
  ],
