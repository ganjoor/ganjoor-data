  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ما درس سحر در ره میخانه نهادیم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ما در مسیر میخانه، آموزه‌های سحر را قرار دادیم و نتیجه‌ی دعاهای خود را در راه محبوب حقیقی گذاشتیم."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "محصول دعا در ره جانانه نهادیم",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "در خرمن صد زاهد عاقل زند آتش",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "داغ آن آتش که ما بر دل انسان های شیفته و عاشق و از خود بی خود زدیم خرمن وجود صدها زاهد عاقل را می سوزاند و از بین می برد.\u00A0"
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "این داغ که ما بر دل دیوانه نهادیم",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "سلطان ازل گنج غم عشق به ما داد",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: خدای ازلی ما را با درد عشق آشنا کرد تا بتوانیم در این دنیا که پر از ویرانی است، زندگی کنیم."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "تا روی در این منزل ویرانه نهادیم",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "در دل ندهم ره پس از این مهر بتان را",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بعد از این به دل خود اجازه نمی‌دهم که به محبت معشوقان فکر کنم؛ زیرا عشق به لب‌های او را در این خانه بر در قرار داده‌ام."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "مهر لب او بر در این خانه نهادیم",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "در خرقه از این بیش منافق نتوان بود",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در این لباس نمی‌توان به دورغ و نفاق ادامه داد، ما این پایه را بر اساس روش رندانه‌ای که داریم گذاشته‌ایم."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "بنیاد از این شیوه رندانه نهادیم",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "چون می‌رود این کشتی سرگشته که آخر",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: وقتی این کشتی سرگردان به راه خود ادامه می‌دهد، باید بدانیم که در نهایت جان خود را برای آن الماس گرانبها گذاشته‌ایم."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "جان در سر آن گوهر یک دانه نهادیم",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "المنة للَّه که چو ما بی‌دل و دین بود",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: سپاسگزاری خاص خداوند است که کسی را که مانند ما بی‌دل و بی‌دین است، عاقل و فرزانه نامیده‌ایم."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "آن را که لقب عاقل و فرزانه نهادیم",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "قانع به خیالی ز تو بودیم چو حافظ",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ما راضی به خیال تو بودیم، مانند حافظ، اما ای خدای من، چقدر بیچاره و بیگانه‌ایم!"
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "یا رب چه گداهمت و بیگانه نهادیم",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    }
  ],
