  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "زهی خجسته زمانی که یار بازآید",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: خوشا زمانی که یار برگردد، زیرا در آن زمان، غم‌زده‌ها نیز شادابی و خوشحالی را دوباره خواهند یافت."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "به کامِ غمزدگان غمگُسار بازآید",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "به پیشِ خیلِ خیالش کشیدم اَبلقِ چشم",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در میان جمعی که به یاد او هستند، چشمم را به سوی آن چشمان زیبا و رنگی معطوف کردم به امید اینکه آن جوان شجاع و دلیر دوباره برگردد."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "بدان امید که آن شهسوار بازآید",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "اگر نه در خمِ چوگان او رَوَد سَرِ من",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر سر من هم به گردونهٔ بازی چوگان او نیفتد، چیزی نمی‌گویم و نمی‌پرسم که حالا چه سر و کاری به سر خودم پیدا می‌شود."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "ز سر نگویم و سر خود چه کار بازآید",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "مقیم بر سرِ راهش نشسته‌ام چون گرد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من در جاده‌ای که او از آنجا می‌گذرد نشسته‌ام، مانند گردی که بە خاطر هوس و آرزو امیدوارم او دوباره برگردد."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "بدان هوس که بدین رهگذار بازآید",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "دلی که با سرِ زلفین او قراری داد",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دل که به خاطر موهای پردود و کلفت او آرامش پیدا کرده، چنین گمان نکن که آن دل دوباره آرامش پیدا کند."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "گمان مَبَر که بدان دل قرار بازآید",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "چه جورها که کشیدند بلبلان از دی",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بلبلان در فصل دی (زمستان) به خاطر عطر و بوی آن محبوب، چه سختی‌ها و رنج‌ها را تحمل کردند و گمان دارند که دوباره بهار خواهد آمد."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "به بویِ آن که دگر نوبهار بازآید",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "ز نقش بندِ قضا هست امید آن حافظ",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: حافظ به خداوند اشاره می‌کند که با قدرت خود می‌تواند امید به بازگشت محبوبش را زنده کند. او خود را به سرو تشبیه کرده و امید دارد که عشقش دوباره به سراغش می‌آید."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "که همچو سرو به دستم نگار بازآید",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    }
  ],
