  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "حالِ دل با تو گفتنم، هوس است",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "با تو، حرف زدن از حال دل را آرزو دارم. شنیدن خبر دل، آرزوی من است."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "خبرِ دل شِنُفتَنَم، هوس است",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "طَمَعِ خام بین که قِصهٔ فاش",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "امید پوچ را ببین که آرزو دارم، قصّه فاش را از رقیبان پنهان کنم."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "از رقیبان نَهُفتَنَم، هوس است",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "شبِ قدری چنین عزیزِ شریف",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "در شب قدری چنین عزیز و محترم، آررزو دارم تا روز هنگام در کنار تو باشم."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "با تو تا روز خُفتنم، هوس است",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "وه که دُردانه‌ای چنین نازک",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "آه که در شبِ تار، سفتنِ دُردانه‌ای\u00A0چنین\u00A0لطیف، آرزوی من است."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "در شبِ تار سُفتنم، هوس است",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "ای صبا امشبَم مَدَد فرمای",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "ای صبا! امشب مرا یاری کن؛ زیرا در بامدادان، آرزوی شکفتن دارم."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "که سحرگه شکفتنم، هوس است",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "از برای شَرَف به نوُکِ مژه",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "برای احترام و ارزشمندی به تو، حتی اگر فقط با نوک مژه‌ام\u00A0 خاک راهت را جارو کنم ، به دنبال آن می‌روم. این احساس، هوس و آرزوست."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "خاکِ راهِ تو رفتنم، هوس است",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "همچو حافظ به رَغمِ مُدَعیان",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آرزو دارم مانند حافظ، برخلاف میل مدعیان و خرده‌گیران، شعر رندانه بسرایم."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "شعرِ رندانه گفتنم، هوس است",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    }
  ],
