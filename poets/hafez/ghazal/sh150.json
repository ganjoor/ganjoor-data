  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ساقی ار باده از این دست به جام اندازد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "اگر ساقی از چنین باده‌ای در جام بریزد، همه عارفان به\u00A0باده‌گساری\u00A0پیوسته خواهند پرداخت."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "عارفان را همه در شُربِ مُدام اندازد",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ور چُنین زیرِ خَم زلف نهد دانهٔ خال",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "و اگر خال را چنین زیر شکن زلف پنهان کند، بسیاری از لاف‌زنانِ خرد را نیز به دام می‌اندازد."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "ای بسا مرغِ خِرَد را که به دام اندازد",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "ای خوشا دولتِ آن مست که در پایِ حریف",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "خوش به حال مستی که نمی‌داند در پای جانان سر ببازد یا دستار!"
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "سر و دستار نداند که کدام اندازد",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "زاهدِ خام که انکارِ مِی و جام کند",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "اگر زاهد ناپخته [و ناسازگار]–که می و جام را انکار می‌کند–اندکی از باده تازه بنوشد، از خامی درمی‌آید [رستگار می‌شود]."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "پخته گردد چو نظر بر میِ خام اندازد",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "روز در کسبِ هنر کوش که مِی خوردنِ روز",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "روز در آموختن هنر بکوش زیرا باده خوردن در روز، دلی را که چون آینه است دچار زنگار سیاه می‌کند"
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "دلِ چون آینه، در زنگِ ظَلام اندازد",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "آن زمان وقتِ میِ صبح فروغ است که شب",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "آن زمان وقت نوشیدن بادهٔ روشنی بخش بامداد است که شب، پردهٔ سیاه گرداگرد اردوگاه افق می‌کشد."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "گِردِ خَرگاهِ افق پردهٔ شام اندازد",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "باده با محتسبِ شهر ننوشی زنهار",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هشدار که باده با محتسب شهر ننوشی! زیرا باده‌ات را می‌خورد و جامت را می‌شکند."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "بخورد باده‌ات و سنگ به جام اندازد",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "حافظا سر ز کُلَه گوشهٔ خورشید برآر",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "حافظ! اگر بخت قرعهٔ آن ماه شب چهارده را به نام تو زد، بر خود ببال (سر از گوشهٔ کلاه خورشید بیرون بیاور)."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "بختت ار قرعه بدان ماهِ تمام اندازد",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    }
  ],
