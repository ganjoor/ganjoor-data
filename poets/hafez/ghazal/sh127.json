  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "روشنیِ طلعتِ تو ماه ندارد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: زیبایی چهرهٔ تو مانند ماه نیست و در مقایسه با تو، گل هیچ جاذبه و زیوری ندارد."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "پیشِ تو گُل، رونقِ گیاه ندارد",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "گوشهٔ ابرویِ توست منزلِ جانم",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: گوشهٔ ابروی تو، جایی است که جانم به آن تعلق دارد و از این مکان زیباتر و باارزش‌تر، هیچ پادشاهی وجود ندارد."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "خوشتر از این گوشه، پادْشاه ندارد",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "تا چه کُنَد با رخِ تو دودِ دلِ من",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دود دلِ من چه تاثیری بر چهرهٔ زیبای تو می‌گذارد، آیا می‌دانی که آینه توانایی تحمل آه و غم من را ندارد؟"
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "آینه دانی که تابِ آه ندارد",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "شوخیِ نرگس نگر که پیشِ تو بشکفت",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: نرگس به زیبایی و ظرافت خود اشاره می‌کند که در برابر تو به خود می‌بالد و چشم‌های عاشق، بی‌ادبانه و با بی‌پروا به تو نگاه می‌کنند."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "چشمْ دریده، ادب نگاه ندارد",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "دیدم و آن چشمِ دلْ‌سیه که تو داری",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من آن چشم دل‌سیاه تو را دیدم که هیچ‌کس دیگری را نمی‌بیند و به هیچ آشنا توجه نمی‌کند."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "جانبِ هیچ آشنا نگاه ندارد",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "رَطلِ گرانم ده ای مریدِ خرابات",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "رطل‌: جام و پیاله شراب."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "شادیِ شیخی که خانقاه ندارد",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "خون خور و خامُش نشین که آن دلِ نازک",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آرام باش و چیزی نخور که آن دل آسیب‌پذیر، توان شنیدن فریاد و دادخواهی را ندارد."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "طاقتِ فریاد دادخواه ندارد",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "گو برو و آستین به خونِ جگر شوی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر کسی در این مکان و در جوار محبوب حقیقی راه ندارد، باید برود و در دردی عمیق همچون خون جگر فرو رود."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "هر که در این آستانه راه ندارد",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "نی منِ تنها کشم تَطاولِ زلفت",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "تطاول‌: درازدستی‌، جور‌، بیداد."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "کیست که او داغِ آن سیاه ندارد؟",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "حافظ اگر سجدهٔ تو کرد مکن عیب",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر حافظ به خاطر عشقش در برابر تو سجده کند، نباید به او ایراد بگیری چون عاشق بودن در عشق گناه محسوب نمی‌شود، ای معشوق."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "کافرِ عشق ای صنم گناه ندارد",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    }
  ],
