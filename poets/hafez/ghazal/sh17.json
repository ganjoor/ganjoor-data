  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "سینه از آتش دل، در غمِ جانانه بسوخت",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دلِ سوخته از عشق، در غم محبوب به آتش درآمد. آتش‌سوزی در خانه‌ای بود که همچون یک مسکن، همه چیز را سوزاند."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "آتشی بود در این خانه که کاشانه بسوخت",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "تنم از واسطهٔ دوریِ دلبر بگداخت",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تنم به خاطر دوری محبوبم می‌سوزد و جانم از عشق چهره‌ی دلنشینش در آتش می‌سوزد."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "جانم از آتشِ مهرِ رخِ جانانه بسوخت",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "سوزِ دل بین که ز بس آتش اشکم، دلِ شمع",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دلِ من به خاطر درد و رنجی که دارم، مثل شمعی است که در آتش اشک‌هایم می‌سوزد. دیشب، این شمع به خاطر محبتش به من، مشابه پروانه‌ای در آتش سوخت."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "دوش بر من ز سرِ مِهر، چو پروانه بسوخت",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "آشنایی نه غریب است که دلسوزِ من است",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: این شخص آشنا و نزدیک به من است و می‌تواند به احساسات و دردم توجه کند. زیرا من از خودم دور شده‌ام و این احساسات باعث شده که کسی دیگر به خاطر من دچار ناراحتی و سوختن شود."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "چون من از خویش برفتم، دلِ بیگانه بسوخت",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "خرقهٔ زهدِ مرا، آبِ خرابات ببُرد",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "مصرع اول‌: خرقه‌ زاهدی‌ام را به‌گرو در میخانه گذاشتم."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "خانهٔ عقلِ مرا، آتشِ میخانه بسوخت",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "چون پیاله دلم از توبه که کردم بشکست",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: وقتی که دلم از توبه‌ای که کردم شکست، حالتی شبیه به لاله پیدا کرد. در این حال، بدون شراب و جایی برای نوشیدن، دلم به شدت سوخت و نگران شدم."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "همچو لاله، جگرم بی می و خُمخانه بسوخت",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "ماجرا کم کن و بازآ که مرا مردمِ چشم",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "ماجرا و نزاع را پایان بده و باز آی، زیرا که مردم چشم من به شکرانهٔ دیدارت خرقه (زهد) مرا به‌در آورده و سوخته است (و منتظر دیدار دوبارهٔ\u00A0توست)"
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "خرقه از سر به درآورد و به شکرانه بسوخت",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "ترک افسانه بگو حافظ و مِی نوش دمی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "به افسانه بسوخت‌: به داستان (و شنیدن قصه ما) سوخت."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "که نَخُفتیم شب و شمع به افسانه بسوخت",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    }
  ],
