  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "عشقِ تو نهالِ حیرت آمد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: عشق تو نهالی است که از آن حیرت می‌روید، و وصال تو اوج و کمال حیرت است؛ یعنی هرچه به تو نزدیک‌تر شوی، حیران‌تر می‌شوی."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "وصلِ تو کمالِ حیرت آمد",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "بس غرقهٔ حالِ وصل کآخر",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بسیار کسان که در حال وصال غرق بودند، سرانجام باز به حالت حیرت رسیدند؛ یعنی وصال نیز پایان حیرت نیست."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "هم بر سرِ حالِ حیرت آمد",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "یک دل بنما که در رَهِ او",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: یک دل نشانم بده که در راه عشق او، خال حیرت بر چهره‌اش ننشسته باشد؛ یعنی هر دلی که در این راه گام نهاده، نشان حیرت دارد."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "بر چهره نه خالِ حیرت آمد",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "نه وصل بِمانَد و نه واصل",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: جایی که حیرت، حتی در خیال، پدیدار شود، نه وصلی باقی می‌ماند و نه کسی که به وصل رسیده باشد؛ در حیرت، دوگانگی عاشق و معشوق محو می‌شود."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "آنجا که خیالِ حیرت آمد",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "از هر طرفی که گوش کردم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به هر سو که گوش دادم، تنها صدای پرسشی برخاسته از حیرت شنیدم؛ همه در این راه حیران و پرسنده‌اند."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "آوازِ سؤالِ حیرت آمد",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "شد مُنهَزِم از کمالِ عزّت",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: کسی که شکوه و هیبت حیرت بر او فرود آمد، در برابر کمال عزت و بزرگی معشوق شکست خورد و گریخت."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "آن را که جلالِ حیرت آمد",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "سر تا قدمِ وجودِ حافظ",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: سراسر وجود حافظ، از سر تا پا، در عشق به نهالی از حیرت بدل شده است."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "در عشق، نهالِ حیرت آمد",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    }
  ],
