  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "عشقِ تو نهالِ حیرت آمد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: عشق تو مانند درختی است که شگفتی و حیرت به وجود می‌آورد، و پیوستن به تو اوج و حداکثر شگفتی است."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "وصلِ تو کمالِ حیرت آمد",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "بس غرقهٔ حالِ وصل کآخر",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بسیار در حال وصالی غرق شدم تا اینکه در پایان، دوباره به حالت حیرت و سردرگمی رسیدم."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "هم بر سرِ حالِ حیرت آمد",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "یک دل بنما که در رَهِ او",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: یک دل نشان بده که در راه او، بر چهره‌اش نشانه‌ای از حیرت دیده نشود."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "بر چهره نه خالِ حیرت آمد",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "نه وصل بِمانَد و نه واصل",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: نه پیوندی باقی می‌ماند و نه کسی به آنجا می‌رسد، وقتی که فکر حیرت و شگفتی سراسر وجود را فرا بگیرد."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "آنجا که خیالِ حیرت آمد",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "از هر طرفی که گوش کردم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از هر سو که توجه کردم، صدای پرسش‌های شگفت‌انگیز به گوش رسید."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "آوازِ سؤالِ حیرت آمد",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "شد مُنهَزِم از کمالِ عزّت",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: کسی که به اوج عزت و بزرگ‌منشی دست یافته است به شدت تحت تأثیر شگفتی و عظمت قرار می‌گیرد."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "آن را که جلالِ حیرت آمد",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "سر تا قدمِ وجودِ حافظ",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: وجود حافظ در عشق، به اندازه‌ای شگفت‌انگیز و حیرت‌انگیز است که تمام وجودش را در بر می‌گیرد و مثل نهالی پر از عشق، حیرت را به نمایش می‌گذارد."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "در عشق، نهالِ حیرت آمد",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    }
