    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ارغوان جامِ عقیقی به سمن خواهد داد",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
