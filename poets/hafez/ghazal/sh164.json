    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "این تَطاول که کشید از غمِ هجران بلبل",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "تا سراپردهٔ گل نعره‌زنان خواهد شد",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "گر ز مسجد به خرابات شدم خرده مگیر",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "مجلس وعظ دراز است و زمان خواهد شد",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "ای دل ار عشرتِ امروز به فردا فکنی",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "مایهٔ نقدِ بقا را که ضَمان خواهد شد؟",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "ماه شعبان مَنِه از دست قدح، کاین خورشید",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "از نظر تا شبِ عیدِ رمضان خواهد شد",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "گل عزیز است غنیمت شِمُریدَش صحبت",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "که به باغ آمد از این راه و از آن خواهد شد",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "مطربا مجلسِ انس است غزل خوان و سرود",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "چند گویی که چنین رفت و چنان خواهد شد؟",
      "CoupletIndex": 7,
      "SectionIndex1": 0
