  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "چه بودی ار دل آن ماه مهربان بودی؟",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر دل آن ماه مهربان می‌بود، حال و روز ما اینگونه نبود. اگر او به ما محبت می‌کرد، زندگی‌مان بهتر و متفاوت می‌شد."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "که حال ما نه چنین بودی ار چنان بودی",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "بگفتمی که «چه ارزد نسیم طرهٔ دوست؟»",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: گفتم باد ملایم موهای محبوب چه ارزشی دارد؟ اما او در پاسخ گفت که هر رشته موی او هزار جان ارزش دارد."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "گرم به هر سر مویی هزار جان بودی",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "برات خوش‌دلی ما چه کم شدی یا رب",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای کاش خوش‌دل بودن ما صدای کم‌رنگی از خوشی‌های زندگی‌مان بود، خداوندا! اگر او با ما بود، نمی‌دانیم که تا چه اندازه می‌توانستیم در برابر روزگار سخت مقاومت کنیم."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "گرش نشان امان از بد زمان بودی",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "گرَم زمانه سرافراز داشتی و عزیز",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر در روزگار خود مقام و منزلت بلندی داشتی، باید بدانی که ریشه‌ی عزت و آبرویت در خاک این آستان است."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "سریر عزتم آن خاک آستان بودی",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "ز پرده کاش برون آمدی چو قطرهٔ اشک",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: کاش تو از پشت پرده بیرون می‌آمدی مثل قطره اشکی که بر روی چشم‌های ما جاری است."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "که بر دو دیدهٔ ما حکم او روان بودی",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "اگر نه دایرهٔ عشق راه بربستی",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر در عشق راه را نبسته بودی، مثل نقطه‌ای که حافظ در گمراهی قرار دارد، در مرکز دایره‌ای از عشق می‌بودی."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "چو نقطه حافظ سرگشته در میان بودی",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    }
  ],
