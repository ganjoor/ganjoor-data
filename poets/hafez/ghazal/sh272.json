  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "باز آی و دلِ تنگِ مرا مونس جان باش",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بازگرد و همراه دل دل‌شکستهٔ من باش و رازدار این آسیب‌دیدهٔ عشق‌ ورزیده باش."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "وین سوخته را مَحرَمِ اسرارِ نهان باش",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "زآن باده که در میکدهٔ عشق فروشند",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از آن شرابی که در میکدهٔ عشق عرضه می‌شود، به ما دو یا سه لیوان بده و بگو که در حال «رمضان» باش. منظور این است که در حالی که به ما شراب می‌دهی، بر رعایت حرمت ماه رمضان هم تأکید کن."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "ما را دو سه ساغر بده و گو «رمضان باش»",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "در خرقه، چو آتش زدی ای عارفِ سالِک!",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای عارف در راه سیر و سلوک، اگر در دل خود شوق و محبت را شعله‌ور کرده‌ای، تلاش کن تا در جمع رندان و خوش‌گذران جهان، پیشتاز و سرآمد باشی."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "جهدی کن و سرحلقهٔ رندانِ جهان باش",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "دلدار که گفتا به تواَم دل‌نگران است",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دلدار (محبوب) به من گفت که او نگران حال من است، بنابراین بگو که حالا به سرعت به سلامت می‌رسم و تو نگران نباش."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "گو «می‌رسم اینک به سلامت»، نگران باش",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "خون شد دلم از حسرتِ آن لعلِ روان‌بخش",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دل من از حسرت آن لب‌های دل‌چسب و شاداب به شدت غمگین و بی‌قرار است، ای گنجینهٔ عشق! همان‌طور که قبلاً بودی، ادامه بده و به همان شکل باقی بمان."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "ای دُرجِ محبّت! به همان مُهر و نشان باش",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "تا بر دلش از غصه غباری نَنشیند",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای سیلِ سرشک! تا زمانی که غم و اندوه بر دل او ننشیند، نامه‌ها را با شتاب و سرعت بفرست."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "ای سیلِ سرشک! از عقبِ نامه روان باش",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "حافظ که هوس می‌کندش جامِ جهان‌بین",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "حافظ که هوس جام جهان‌بین را کرده‌است؛ به او بگویید در نظر و دید آصف جمشید‌مکان قرار بگیرد (و مورد لطف او واقع شود)"
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "گو «در نظرِ آصفِ جمشید‌مکان باش»",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    }
