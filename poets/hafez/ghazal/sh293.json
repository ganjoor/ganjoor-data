  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "بامدادان که ز خلوتگَهِ کاخِ اِبداع",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: صبح که از خلوتگاه کاخ خلاقیت، شعله‌ای از شمع شرق بر همه جا تابش می‌کند."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "شمعِ خاور فِکَنَد بر همه اطراف شُعاع",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "بَرکَشَد آینه از جِیبِ افق چرخ و در آن",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آینه‌ای که از جیب افق آسمان بیرون می‌آید، چهرهٔ زمین را با هزاران جلوه‌ مختلف در آن نشان می‌دهد."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "بنماید رخِ گیتی به هزاران انواع",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "در زوایایِ طَرَبخانهٔ جمشیدِ فلک",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: زهره (سیارهٔ زهره) در زوایای سرور و خوشی جمشید (مظهر قدرت و شکوه) در آسمان، با نغمهٔ دل‌انگیز ساز فریبنده‌ای می‌نوازد."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "اَرغَنون ساز کُنَد زهره به آهنگِ سَماع",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "چنگ در غُلغُله آید که کجا شد منکر؟",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چنگ در شور و شوقی درمی‌آید و می‌پرسد که کجا رفت آن کسی که منکر لذت‌ها بود؟ جام هم در خنده و خوش‌گذرانی نمایان می‌شود و می‌پرسد که کجا رفت آن کسی که از لذت‌ها جلوگیری می‌کرد؟"
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "جام در قَهقَهه آید که کجا شد مَنّاع؟",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "وضعِ دوران بنگر ساغرِ عِشرت بَر گیر",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: وضع دنیا را نگاه کن و جام خوشی را به دست بگیر، چون در هر شرایطی این بهترین حالت است."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "که به هر حالتی این است بِهینِ اوضاع",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "طُرِّهٔ شاهدِ دنیی همه بند است و فریب",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: زلفِ زیبای محبوب دنیوی همه‌اش مروارید و فریب است و عارفان به خاطر این زیبایی و کمال، نزاع و جدل نمی‌کنند."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "عارفان بر سرِ این رشته نجویند نِزاع",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "عمرِ خسرو طلب ار نفعِ جهان می‌خواهی",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر می‌خواهی به نفع مردم و دنیا عمری شاداب و پربار داشته باشی، باید به شخصیتی مانند خسرو، که بخشنده و نیکوکار است، تکیه کنی."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "که وجودیست عطابخشِ کریمِ نَفّاع",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "مَظهَرِ لطفِ ازل، روشنی چشمِ اَمَل",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دستگاه عطوفت الهی، امیدی که به روشنی و دانایی کمال می‌رسد و الهام‌بخش زندگی است، شاهی شجاع و قدرتمند را به تصویر می‌کشد."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "جامعِ علم و عمل جانِ جهان، شاه شجاع",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    }
  ],
