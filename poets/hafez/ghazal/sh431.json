  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "لبش می‌بوسم و در می‌کشم می",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من لب‌هایش را می‌بوسم و در عمیق می‌کشم. انگار که شرابی از زندگی به دست آورده‌ام."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "به آب زندگانی برده‌ام پی",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "نه رازش می‌توانم گفت با کس",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": ": نه می‌توانم رازهای خود را با کسی در میان بگذارم و نه می‌توانم ببینم او کسی را ملاقات میکند ."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "نه کس را می‌توانم دید با وی",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "لبش می‌بوسد و خون می‌خورد جام",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: او لبانش را می‌بوسد و احساس شوق و لذت می‌کند، وقتی اسبش را می‌بیند، همچون گل از شادی می‌شکفد."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "رخش می‌بیند و گل می‌کند خوی",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "بده جام می و از جم مکن یاد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به تو جام می بده و دیگر به یاد جم نیفت، چرا که نوشیدنی می‌داند که جم کی بوده و چه زمانی وجود داشته است."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "که می‌داند که جم کی بود و کی کی؟",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "بزن در پرده چنگ ای ماه مطرب!",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "مصرع دوم‌: تار و سیم چنگ را بزن و بخراش، تا از آن به جوش و خروش بیایم."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "رگش بخراش تا بخروشم از وی",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "گل از خلوت به باغ آورد مسند",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: گل از تنهایی و دوری به باغ آورده می‌شود و فضای زهد را همانند غنچه‌ای تازه و زیبا آماده می‌کند."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "بساط زهد همچون غنچه کن طی",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "چو چشمش مست را مخمور مگذار",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چشمانش را مانند کسی که مست و مدهوش است، بی‌خود نکن. ای ساقی، به یاد زیبایی لبهایش، می بده."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "به یاد لعلش ای ساقی بده می",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "نجوید جان از آن قالب جدایی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: روح خود را از آن قالب جدا نکن که خونش در رگ و پی وجود دارد."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "که باشد خونِ جامش در رگ و پی",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "زبانت درکِش ای حافظ زمانی",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای حافظ، زبان تو را سرزنش کن و لحظه‌ای به سخنان بی‌زبانان گوش بده تا مثل نی درک و احساس آنها را دریابی."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "حدیث بی‌زبانان بشنو از نی",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    }
  ],
