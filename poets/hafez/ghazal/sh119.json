  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "دلی که غیب‌نمای است و جامِ جم دارد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "دلی که آیینه شاهی گشته‌است و خود جام جم گشته، اگر زمانی خاتم شاهی از او گم شود؛ چه کم دارد و چه غم دارد؟"
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "ز خاتمی که دمی گم شود، چه غم دارد؟",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "به خَطُّ و خالِ گدایان مده خزینهٔ دل",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "گنج دل را به گدایان حیله‌گر مسپار؛ آن‌را به زیبا و شاه‌منشی بده که قدرش را بداند."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "به دستِ شاهوَشی دِه که محترم دارد",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "نه هر درخت تحمّل کند جفایِ خزان",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هر درختی نمی‌تواند سختی پاییز را تحمل کند؛ بندهٔ\u00A0بلند‌نظری و همّت سرو هستم که رهرو این مرام است."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "غلامِ همتِ سروم که این قدم دارد",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "رسید موسمِ آن کز طرب چو نرگسِ مست",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "فصل باده‌نوشی رسید؛ فصلی که می‌گساران با چشم‌های خمار‌، سکه‌هایشان را در پای قدح باده می‌نهند. (شش‌درهم دارد: یعنی هرکس حداقل را دارد و می‌تواند باده بخرد)"
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "نهد به پایِ قدح هر که شش درم دارد",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "زر از بهایِ می اکنون چو گل دریغ مدار",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "اگر از پول و زر برای خریدن باده دریغ کنی، آدم دانا و عاقل تو را به‌صد عیب متهم می‌کند."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "که عقلِ کل به صدت عیب متّهم دارد",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "ز سِرِّ غیب، کس آگاه نیست؛ قصّه مخوان",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "درباره سرّ غیب و رازهای غیب حرف مزن و قصه مگو؛ کیست که می‌تواند ادعا کند که بدان راز، آگاه گشته است؟"
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "کدام مَحرمِ دل ره در این حرم دارد؟",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "دلم که لافِ تَجَرُّد زدی، کنون صد شغل",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "من که هزار لاف از «تجرّد» می‌زدم از وقتی که عطر زلف تو را شنیده‌ام، صد دلبستگی پیدا کرده‌ام. (تجرّد و شغل از اصطلاحات صوفیانه است)"
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "به بویِ زلفِ تو با بادِ صبحدم دارد",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "مرادِ دل ز که پرسم؟ که نیست دلداری",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "از چه‌کسی آرزو و مراد دلم را بخواهم؟ زیرا دلدار و محرمی نیست که فهیم و آگاه باشد و سخاوتمند."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "که جلوهٔ نظر و شیوهٔ کرم دارد",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "ز جَیبِ خرقهٔ حافظ چه طَرف بِتوان بست",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "از حافظ چه سود می‌رسد؟ زیرا ما خدا طلبیدیم و او بتی زیبارو دارد!"
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "که ما صمد طلبیدیم و او صَنم دارد",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    }
  ],
