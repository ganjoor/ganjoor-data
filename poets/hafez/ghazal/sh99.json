  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "دلِ من در هوایِ روی فرخ",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دل من به خاطر دیدن چهره زیبای فَرّخ به شدت ناآرام و پریشان است، مانند موی فَرّخ که به هم ریخته است."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "بُوَد آشفته همچون مویِ فرخ",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "به جز هندویِ زلفش هیچ کس نیست",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به جز معشوق با زلف‌های هندی‌اش، هیچ کس دیگر از زیبایی و نعمت‌های چهره‌ی شاداب و خرم برخوردار نیست."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "که برخوردار شد از روی فرخ",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "سیاهی نیکبخت است آن که دائم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آن کسی که همیشه همراه و همدل انسان خوشبختی باشد، در واقع خوشبختی را به همراه خود می‌آورد."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "بُوَد هم‌راز و هم‌زانوی فرخ",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "شود چون بید لرزان سروِ آزاد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر بید نرم و لرزان، قامت روبه‌رو را ببیند، مانند سرو آزاد به لرزه می‌افتد."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "اگر بیند قدِ دلجویِ فَرُّخ",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "بده ساقی شرابِ ارغوانی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به من شراب قرمز رنگی بده تا یادآور زیبایی چشم‌های نرگس enchanting باشد."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "به یادِ نرگسِ جادوی فَرُّخ",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "دو تا شد قامتم همچون کمانی",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: قامتم به اندازه یک کمان شده و از غم دائمی، شبیه به ابروی کسی که زیباست، خمیده و افتاده است."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "ز غم پیوسته چون ابروی فرخ",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "نسیم مُشک تاتاری خجل کرد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: نسیم عطر تاتاری شرمنده شد از بوی خوش زلف‌های عطری فرخ."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "شمیم زلف عَنبربوی فرخ",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "اگر میلِ دلِ هر کس به جایی‌ست",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر هر کس بخواهد به جایی برود، دل من هم به سمت خوشی و خوشبختی میل دارد."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "بُوَد میلِ دلِ من سوی فرخ",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "غلامِ همتِ آنم که باشد",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من از کسانی هستم که در اراده و تلاش مثل حافظ، بنده و تسلیم در برابر کسی مثل هندو فرخ (یا خوشبخت) هستم."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "چو حافظ بنده و هندوی فرخ",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    }
  ],
