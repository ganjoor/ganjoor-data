  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "دلِ من در هوایِ روی فرخ",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دل من در آرزوی دیدن چهرهٔ فرخ، مانند موی پریشان او آشفته و بی‌قرار است."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "بُوَد آشفته همچون مویِ فرخ",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "به جز هندویِ زلفش هیچ کس نیست",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هیچ‌کس جز زلف سیاه او، که مانند غلامی هندو بر چهره‌اش افتاده، از دیدن و لمس روی فرخ بهره نبرده است."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "که برخوردار شد از روی فرخ",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "سیاهی نیکبخت است آن که دائم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آن سیاه‌رو، یعنی زلف یا خال سیاه، خوشبخت است، زیرا همیشه همراز فرخ است و در کنار او می‌نشیند."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "بُوَد هم‌راز و هم‌زانوی فرخ",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "شود چون بید لرزان سروِ آزاد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر سرو آزاد قامت دل‌نواز فرخ را ببیند، از شرم و حیرت مانند بید به لرزه می‌افتد."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "اگر بیند قدِ دلجویِ فَرُّخ",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "بده ساقی شرابِ ارغوانی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای ساقی، به یاد چشم افسونگر فرخ که مانند نرگس است، شراب سرخ‌رنگ به من بده."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "به یادِ نرگسِ جادوی فَرُّخ",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "دو تا شد قامتم همچون کمانی",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از غمی که پیوسته با من است، قامتم مانند کمان خم شده است؛ همچون ابروی فرخ که کمانی و پیوسته است."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "ز غم پیوسته چون ابروی فرخ",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "نسیم مُشک تاتاری خجل کرد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بوی خوش زلف عنبرین فرخ، نسیم مشک تاتار را شرمنده کرده است."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "شمیم زلف عَنبربوی فرخ",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "اگر میلِ دلِ هر کس به جایی‌ست",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر دل هر کسی به سویی و به کسی گرایش دارد، دل من تنها به سوی فرخ میل دارد."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "بُوَد میلِ دلِ من سوی فرخ",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "غلامِ همتِ آنم که باشد",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من بندهٔ همت کسی هستم که مانند حافظ، غلام و بندهٔ فرخ باشد."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "چو حافظ بنده و هندوی فرخ",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    }
  ],
