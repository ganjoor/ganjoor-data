  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "آن یار کز او خانهٔ ما جایِ پَری بود",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "آن محبوبی که با حضورش خانهٔ ما همچون جایگاه فرشتگان و پریان شده بود، از سر تا پا زیبا و بی‌عیب و نقص بود."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "سر تا قدمش چون پَری از عیب بَری بود",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "دل گفت فروکش کنم این شهر به بویش",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "دلم خیال کرد که به امید حضور و بوی خوش محبوب، در این شهر اقامت می‌کنم و زندگی‌ام را با او می‌گذرانم؛ اما بیچاره نمی‌دانست که محبوب قصد سفر دارد و ماندنی نیست."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "بیچاره ندانست که یارش سفری بود",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "تنها نه ز رازِ دلِ من پرده برافتاد",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "تنها راز دل من نبود که آشکار شد؛ از زمانی که آسمان و روزگار وجود داشته‌اند، شیوه و رسم محبوب این بوده که پرده از رازها بردارد و اسرار را آشکار کند."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "تا بود فلک، شیوهٔ او پرده‌دری بود",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "منظورِ خردمندِ من آن ماه که او را",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "آن ماه‌رویی که منظور خردمند من به او توجه داشت، کسی بود که علاوه بر زیبایی، از ادب و بینش و آگاهی نیز برخوردار بود."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "با حُسنِ ادب شیوهٔ صاحب‌نظری بود",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "از چنگِ مَنَش اختر بَدمِهر به در برد",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "ستارهٔ بداقبال و ناسازگار، محبوب را از چنگ من بیرون برد. چه می‌توانستم بکنم؟ گویا بخت و اقبال من چنین بود و گردش روزگار به سود من نمی‌چرخید."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "آری چه کنم؟ دولتِ دورِ قمری بود",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "عُذری بِنِه ای دل، که تو درویشی و او را",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "ای دل، برای رفتن محبوب عذری پیدا کن و او را سرزنش نکن؛ زیرا تو درویش و بی‌چیز بودی و او در سرزمین زیبایی، پادشاه و صاحب مقام بود."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "در مملکتِ حُسن سَرِ تاجْوَری بود",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "اوقاتِ خوش آن بود که با دوست به سر رفت",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "روزگار خوش و ارزشمند، همان زمانی بود که در کنار دوست گذشت؛ باقی عمر، جز بیهودگی و غفلت و بی‌خبری چیزی نبود."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "باقی همه بی‌حاصلی و بی‌خبری بود",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "خوش بود لبِ آب و گل و سبزه و نسرین",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "چه خوش و دل‌انگیز بود آن روزهایی که کنار آب و گل و سبزه و گل نسرین می‌گذشت؛ افسوس که آن گنج گران‌بها و محبوب زنده و روان، مسافری گذرا بود و ماندگار نشد."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "افسوس که آن گنجِ روان رهگذری بود",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "خود را بکش ای بلبل از این رشک که گُل را",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "ای بلبل، از شدت حسادت و اندوه، خودت را بکش؛ زیرا گل در سپیده‌دم با وزش نسیم صبا، جلوه‌گری و زیبایی می‌کرد و تو شاهد این زیبایی و هم‌نشینی بودی."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "با بادِ صبا وقتِ سحر جلوه‌گری بود",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "هر گنجِ سعادت که خدا داد به حافظ",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هر بهره و گنج خوشبختی که خداوند به حافظ عطا کرد، به برکت دعاهای شبانه و ذکرهایی بود که در سحرگاه بر زبان می‌آورد."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "از یُمنِ دعایِ شب و وِردِ سَحَری بود",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    }
  ],
