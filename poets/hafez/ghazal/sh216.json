  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "آن یار کز او خانهٔ ما جایِ پَری بود",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آن معشوق که خانه‌مان به خاطر او پر از جمال و زیبایی بود، از سر تا پایش هیچ عیبی وجود نداشت و همچون پریان بی‌نقص بود."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "سر تا قدمش چون پَری از عیب بَری بود",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "دل گفت فروکش کنم این شهر به بویش",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "دل گفت که باید به خاطر وجود معشوق، در این شهر بمانم و جایی نروم، اما بیچاره متوجه نبود که عشقش در سفر است. (فروکش کنم یعنی بمانم. به بویش یعنی به آرزویش)"
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "بیچاره ندانست که یارش سفری بود",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "تنها نه ز رازِ دلِ من پرده برافتاد",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تنها پرده از راز دل من کنار نرفت، بلکه تا وقتی آسمان باشد، شیوه او همیشه این است که پرده‌ها را کنار می‌زند."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "تا بود فلک، شیوهٔ او پرده‌دری بود",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "منظورِ خردمندِ من آن ماه که او را",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: منظور من از آن ماه، شخصی است که به زیبایی و ادب شناخته شده و دارای دیدگاه‌هایی عمیق و خردمندانه است."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "با حُسنِ ادب شیوهٔ صاحب‌نظری بود",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "از چنگِ مَنَش اختر بَدمِهر به در برد",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ستاره‌ی بدشگون در زندگی‌ام از چنگ من فرار کرد، حالا چه کنم؟ این یک دوری و جدایی شبیه به سرنوشت یک ماهِ کامل است."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "آری چه کنم؟ دولتِ دورِ قمری بود",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "عُذری بِنِه ای دل، که تو درویشی و او را",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای دل، بهانه‌ای بساز که تو در حالتی ساده و بی‌خود هستی و او در دنیای زیبایی مثل تاجی در مقام و منزلت است."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "در مملکتِ حُسن سَرِ تاجْوَری بود",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "اوقاتِ خوش آن بود که با دوست به سر رفت",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: لحظات خوش، زمانی است که با دوست سپری شود؛ باقی زمان‌ها همه بی‌فایده و دور از آگاهی هستند."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "باقی همه بی‌حاصلی و بی‌خبری بود",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "خوش بود لبِ آب و گل و سبزه و نسرین",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در کنار آب و گل و سبزه و گل نسرین اینجا زیبا و دل‌انگیز است، اما افسوس که این زیبایی فقط گذرایی و موقتی است."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "افسوس که آن گنجِ روان رهگذری بود",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "خود را بکش ای بلبل از این رشک که گُل را",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای بلبل، خودت را از حسرتی که به خاطر زیبایی گل به تو دست داده، رها کن؛ زیرا در زمان صبحگاهی، گل با نسیم صبح خود را به نمایش می‌گذارد و زیبایی‌اش از آنِ اوست."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "با بادِ صبا وقتِ سحر جلوه‌گری بود",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "هر گنجِ سعادت که خدا داد به حافظ",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر خوشبختی و نعمت که خداوند به حافظ عطا کرده، ناشی از دعاهای شب و ذکرهای سحرگاه اوست."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "از یُمنِ دعایِ شب و وِردِ سَحَری بود",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    }
  ],
