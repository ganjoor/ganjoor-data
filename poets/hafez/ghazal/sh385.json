  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "یا رب آن آهوی مشکین به خُتَن باز رسان",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای خدا، آن آهوی زیبا و مشکین را به آغوش همسرش برگردان و نیز آن سرو خوش‌چهره و دلربا را به باغ بازگردان."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "وان سهی سروِ خرامان به چمن باز رسان",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "دل آزردهٔ ما را به نسیمی بنواز",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بگذار دل آشفته‌ام را با نسیمی آرامش دهی؛ به عبارتی از آن جان که از بدن رفته، دوباره به بدن برگردان."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "یعنی آن جانِ ز تن رفته به تن باز رسان",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "ماه و خورشید به منزل چو به امرِ تو رسند",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر ماه و خورشید به خواست تو به منزل خود برسند، پس دوست زیباروی مرا نیز به من برگردان."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "یارِ مه‌روی مرا نیز به من باز رسان",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "دیده‌ها در طلبِ لعلِ یَمانی خون شد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چشم‌ها به خاطر جست‌وجوی یاقوتی که در یمن است، به اشک بدل شده‌اند. ای خدا، آن ستاره‌ی درخشان را که در یمن است، به من برگردان."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "یا رب آن کوکبِ رخشان به یَمَن باز رسان",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "برو ای طایرِ میمونِ همایون آثار",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای پرندهٔ خوش‌شانسی که به کاروان آسمانی پیوسته‌ای، به پیش عنقا (پرندهٔ افسانه‌ای) برو و خبرهای زاغ و زغن (پرندگان عادی و بی‌ارزش) را منتقل کن."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "پیش عنقا سخنِ زاغ و زَغَن باز رسان",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "سخن این است که ما بی تو نخواهیم حیات",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: این بیت بیانگر این است که ما بدون تو قادر به ادامه زندگی نیستیم، پس ای پیام‌آور، خبر را به ما برسان."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "بشنو ای پیکِ خبرگیر و سخن باز رسان",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "آن که بودی وطنش دیدهٔ حافظ یا رب",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: حافظ از خدایش می‌خواهد کسی که وطنش چشمان اوست، یعنی شخصی که حافظ به او عشق ورزیده است، به خواسته‌اش برسد و او را از غربت به وطنش برگرداند."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "به مرادش ز غریبی به وطن باز رسان",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    }
  ],
