  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ای رُخَت چون خُلد و لَعلَت سَلسَبیل",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای کسی که چهره‌ات مانند بهشت است و لب سرخت مانند چشمهٔ سلسبیل بهشتی؛ جان و دل عاشقان خود را وقف آن چشمهٔ لبت کرده‌اند."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "سَلسَبیلت کرده جان و دل سَبیل",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "سبزپوشانِ خَطَت بر گِردِ لب",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: موهای تازه‌رُسته و سبز خط تو که گرداگرد لبت را گرفته‌اند، مانند مورچگانی هستند که به گرد چشمهٔ سلسبیل جمع شده‌اند."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "همچو مورانند گِردِ سَلسَبیل",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "ناوَکِ چشمِ تو در هر گوشه‌ای",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تیر نگاه تو در هر گوشه‌ای صدها کشته مانند من بر زمین انداخته است."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "همچو من افتاده دارد صد قَتیل",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "یا رب این آتش که در جانِ من است",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: خدایا، این آتش عشقی را که در جان من است سرد و آرام کن، همان‌گونه که آتش نمرود را بر ابراهیم خلیل سرد کردی."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "سرد کن زان سان که کردی بر خلیل",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "من نمی‌یابم مجال ای دوستان",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای دوستان، با آنکه آن یار زیبایی بسیار دلپذیری دارد، من فرصت و امکان رسیدن به او را نمی‌یابم."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "گرچه دارد او جمالی بس جمیل",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "پای ما لَنگ است و منزل بس دراز",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: پای ما ناتوان است و راه رسیدن به مقصد بسیار دور؛ دست ما کوتاه است و خرما بر بالای درخت خرما، یعنی رسیدن به یار از توان ما بیرون است."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "دست ما کوتاه و خرما بر نَخیل",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "حافظ از سرپنجهٔ عشقِ نگار",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: حافظ در چنگال نیرومند عشق آن محبوب، مانند مورچه‌ای ناتوان زیر پای فیل افتاده و درمانده است."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "همچو مور افتاده شد در پایِ پیل",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "شاهِ عالم را بقا و عِزّ و ناز",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آرزو می‌کنم که پادشاه جهان همیشه پایدار و عزیز و کامروا باشد و هرچه از این‌گونه نیکی‌هاست نصیبش شود."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "باد و هر چیزی که باشد زین قَبیل",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    }
  ],
