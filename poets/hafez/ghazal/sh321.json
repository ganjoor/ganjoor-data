  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "هر چند پیر و خسته‌دل و ناتوان شدم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: با اینکه پیر و دل‌شکسته و ناتوان شده‌ام، هر بار که چهرهٔ تو را به یاد آوردم، دوباره جوان شدم."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "هر گَه که یادِ رویِ تو کردم جوان شدم",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "شکرِ خدا که هر چه طلب کردم از خدا",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: خدا را شکر که هر چه از خدا خواستم، تا بالاترین حدِ همت و آرزویم به آن رسیدم و کامیاب شدم."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "بر مُنتهایِ همتِ خود کامران شدم",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "ای گُلبُن جوان! بَرِ دولت بخور که من",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای بوتهٔ گلِ جوان (معشوق یا ممدوح)، از میوهٔ بخت و اقبال بهره ببر و پایدار باش، چون من در سایهٔ تو بلبلِ نغمه‌خوانِ باغِ جهان و شاعرِ نامدار شدم."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "در سایهٔ تو بلبلِ باغِ جهان شدم",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "اول ز تحت و فوقِ وجودم خبر نبود",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در آغاز از پست و بلندِ هستی و رازهای آن چیزی نمی‌دانستم؛ در مکتبِ غمِ عشقِ تو چنین آگاه و نکته‌سنج شدم."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "در مکتبِ غمِ تو، چُنین نکته‌دان شدم",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "قسمت حوالتم به خرابات می‌کند",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: سرنوشتِ ازلی مرا به میکده و خرابات می‌فرستد، هر چند که در زندگی گاه این‌گونه و گاه آن‌گونه شدم و حال‌های گوناگون یافتم."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "هر چند کاینچنین شدم و آنچنان شدم",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "آن روز بر دلم درِ معنی گشوده شد",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: روزی که مقیمِ درگاهِ پیرِ مغان (مرشد و پیرِ میکده) شدم، درِ حقیقت و معرفت به روی دلم گشوده شد."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "کز ساکنانِ درگهِ پیرِ مغان شدم",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "در شاه‌راهِ دولتِ سرمد به تختِ بخت",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در راهِ بزرگِ سعادتِ جاودان، بر تختِ بخت نشستم و با جامِ شراب در دست، چنان‌که دوستان آرزو داشتند، کامروا شدم."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "با جامِ مِی به کامِ دلِ دوستان شدم",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "از آن زمان که فتنهٔ چشمت به من رسید",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از زمانی که فتنه و آشوبِ چشمِ تو گریبانم را گرفت، از بلا و فتنه‌های آخرالزمان در امان ماندم؛ چون بلایی بزرگ‌تر از آن نیست."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "ایمن ز شرِّ فتنهٔ آخرزمان شدم",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "من پیرِ سال و ماه نیَم، یار بی‌وفاست",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "من پیر شدهٔ سال و ماه نیستم، بلکه عمر بی‌وفاست؛ برای آن پیر شده‌ام که عمر من می‌گذرد."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "بر من چو عمر می‌گذرد پیر از آن شدم",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "دوشم نوید داد عنایت که حافظا",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دیشب لطفِ الهی به من مژده داد و گفت: ای حافظ، بازگرد که من ضامنِ بخشیده‌شدنِ گناهانت شدم."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "بازآ که من به عفوِ گناهت ضمان شدم",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    }
  ],
