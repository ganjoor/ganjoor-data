  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "گر دست دهد خاکِ کفِ پایِ نگارم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر موقعیتی پیش آید و بتوانم، خاک کف پای محبوبم را بر لوح چشمانم به عنوان نشانی از عشق بنویسم."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "بر لوحِ بَصَر خطِّ غباری بنگارم",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "بر بویِ کنارِ تو شدم غرق و امید است",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من در عطر و بوی وجود تو غرق شده‌ام و امیدوارم که اشک‌های من مانند موجی، مرا به تو برساند."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "از موجِ سرشکم که رسانَد به کنارم",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "پروانهٔ او گر رسدم در طلبِ جان",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر به عشق او برسم و در پی جان او باشم، مانند شمع در همان لحظه جانم را به او تقدیم می‌کنم."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "چون شمع همان دَم به دَمی جان بِسِپارَم",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "امروز مَکَش سر ز وفایِ من و اندیش",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: امروز به خاطر وفای من به خودت آسیب نزن و به یاد نیاور آن شبی که به خاطر غم، دست به دعا برداشتم."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "زان شب که من از غم به دعا دست برآرم",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "زلفین سیاهِ تو به دلداریِ عُشّاق",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: موهای سیاه تو دل عاشقان را آرامش بخشیده و برایشان تعهدی ایجاد کرده است، اما این زیبایی من را بی‌قرار کرده است."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "دادند قراری و بِبُردَند قرارم",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "ای باد از آن باده نسیمی به من آور",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای باد، از آن باده خوش مزه نسیمی برای من بیاور، زیرا بوی آن درمانگری دارد و می‌تواند خمار و حال بد مرا برطرف کند."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "کان بویِ شفابخش بُوَد دفعِ خُمارم",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "گر قلبِ دلم را نَنَهد دوست عیاری",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر عشق واقعی به من نرسد، تمام احساسات و ثروت‌های دلم را در لحظه‌ای که دوستانم را می‌بینم، از یاد می‌برم."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "من نقدِ روان در دَمَش از دیده شمارم",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "دامن مَفِشان از منِ خاکی که پس از من",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: این بیت به این معناست که از من که یک انسان خاکی و فانی هستم، دامن خود را دور کن، زیرا پس از من، هیچ چیزی جز غباری از من نخواهد ماند که باد بتواند آن را ببرد. به عبارتی، او به ناپایداری زندگی و اینکه پس از مرگش چیزی از او باقی نخواهد ماند، اشاره می‌کند."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "زین در نتواند که بَرَد باد غبارم",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "حافظ لبِ لَعلَش چو مرا جانِ عزیز است",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: حافظ می‌گوید که لبِ لعل محبوبش برای او به اندازه جانش ارزشمند است و او آماده است تا تمام عمرش را تلف کند تا آن لحظه‌ای که جانش در خطر است، به لبِ معشوق نزدیک‌تر شود."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "عمری بُوَد آن لحظه که جان را به لب آرم",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    }
  ],
