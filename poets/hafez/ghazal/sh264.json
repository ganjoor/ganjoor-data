  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "خیز و در کاسهٔ زر آبِ طَرَبناک انداز",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "بیا و در کاسه زر‌، باده شادی‌بخش بریز پیش از آنکه کاسه سر ما پر از خاک گردد."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "پیشتر زان که شَوَد کاسهٔ سَر خاک‌ انداز",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "عاقبت منزلِ ما وادیِ خاموشان است",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "عاقبت ما مردن و پیوستن به مردگان است پس الان به‌فکر این باش که غوغایی و شوری به‌پا کنی که در جهان بپیچد."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "حالیا غُلغُله در گنبدِ افلاک انداز",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "چشمِ آلوده‌نظر، از رخِ جانان دور است",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "چشم‌ آلوده و ناپاک هرگز روی معشوق را نخواهد دید؛ او را در آینه زلال (دل پاک) ببین."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "بر رخِ او نظر از آینهٔ پاک انداز",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "به سرِ سبزِ تو ای سرو که گر خاک شَوَم",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "به جان سرسبز و شاد تو، ای سرو خوش‌قامت من؛ که وقتی درگذشتم و مُردم به دیدار مزار من بیایی."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "ناز از سَر بِنِه و سایه بر این خاک انداز",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "دلِ ما را که ز مارِ سرِ زلفِ تو بِخَست",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "سر زلف بافته تو همچون مار، دل ما را زخمی‌کرد پس با بوسه‌ای (یا کلامی) ما را شفا ببخش."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "از لبِ خود به شفاخانهٔ تریاک انداز",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "مُلکِ این مزرعه دانی که ثباتی ندهد",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "خود می‌دانی که این دنیا بی‌وفاست و پایدار نیست؛ پس عمر را صرف شادی و می‌گساری کن."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "آتشی از جگرِ جام، در املاک انداز",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "غسل در اشک زدم کَاهلِ طریقت گویند",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "چشمانم را با اشک‌، غسل دادم و پاک‌کردم زیرا اهل سلوک و طریقت می‌گویند اول پاک شو، سپس لایق دیدار شو."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "پاک شو اول و پس دیده بر آن پاک انداز",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "یا رب آن زاهدِ خودبین که به جز عیب ندید",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "خدایا آن زاهد خودپرست که جز عیب‌جویی کاری نکرد ( و دل‌ها را شکست) دود یک آه (دل‌شکستگان) را در آینه ادراک او بینداز."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "دودِ آهیش در آیینهٔ اِدراک انداز",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "چون گُل از نَکهَتِ او جامه قبا کن حافظ",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "همچون گل، از نسیم عطر خوش یار، گریبان چاک کن ای حافظ، و جامه را در پای آن سرو روان بینداز. (جامه قبا کردن‌: گریبان چاک کردن)"
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "وین قبا در رَهِ آن قامتِ چالاک انداز",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    }
  ],
