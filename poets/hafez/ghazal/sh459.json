  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "زین خوش رقم که بر گل رخسار می‌کشی",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از این چهره‌ی زیبا که بر روی گل‌ها می‌کشی، آثاری بر صفحات گل و باغ گل‌ها به جا می‌گذاری."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "خط بر صحیفهٔ گل و گلزار می‌کشی",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "اشک حرم‌نشین نهان‌خانهٔ مرا",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اشک‌های من که در حرم نشسته‌اند، به شکلی پنهان به سوی بیرون از هفت پرده می‌روند و مرا به میدان و بازار می‌آورند."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "زان سوی هفت‌پرده به بازار می‌کشی",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "کاهل روی چو باد صبا را به بوی زلف",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تنبل و بی‌هواس، به مانند نسیم صبح، هر لحظه با عطر زلفت به دام محبتت گرفتار می‌شوم."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "هر دم به قید سلسله در کار می‌کشی",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "هر دم به یاد آن لب میگون و چشم مست",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر لحظه به یاد آن لبان شیرین و چشمان مست مشغول می‌شوم و از تنهایی‌ام به میخانه می‌روم."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "از خلوتم به خانهٔ خمار می‌کشی",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "گفتی سر تو بستهٔ فتراک ما شود",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تو گفتی که اگر سر تو به فتراک ما بسته شود، مشکلی نیست، فقط کافی است که برای این کار زحمت بکشید."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "سهل است اگر تو زحمت این بار می‌کشی",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "با چشم و ابروی تو چه تدبیر دل کنم؟",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: با نگاه و چهره زیبای تو چگونه می‌توانم دل را تسخیر کنم؟ ای وای از این کمان که بر من تیر می‌زند و مرا دردمند می‌کند."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "وه زین کمان که بر من بیمار می‌کشی",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "بازآ که چشم بد ز رخت دفع می‌کند",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: برگرد و با حضور زیبای خود، چشم زخم را از خود دور کن. ای گل تازه، تو که دامن خود را از این خارها می‌کشی."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "ای تازه گل که دامن از این خار می‌کشی",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "حافظ دگر چه می‌طلبی از نعیم دهر",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: حافظ، چه چیزی دیگر از خوشی‌های دنیا می‌خواهی؟ تو که در حال نوشیدن شراب هستی و با زیبایی محبوب خود به سر می‌بری."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "می می‌خوری و طرهٔ دلدار می‌کشی",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    }
  ],
