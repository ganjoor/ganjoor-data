  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "سحرگاهان، که مخمورِ شبانه",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "چَغانه‌: نوعی ساز."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "گرفتم باده با چنگ و چَغانه",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "نهادم عقل را ره ‌توشه از مِی،",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "عقل را غذای سفر و زادراه از باده دادم و او را از شهر هستی بیرون فرستادم.\u00A0"
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "زِ شهرِ هستی‌اش کردم روانه",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "نگارِ مِی‌فروشم عشوه‌ای داد،",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: معشوقی که مِی‌فروش است با ناز و عشوه‌ای سخن گفت و از این رو احساس امنیت کردم و از فریب‌های روزگار در امان ماندم."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "که ایمن گشتمَ از مکرِ زمانه",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "زِ ساقیِ کمان ‌ابرو شنیدم؛",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ساقی با ابروهای کمانی‌اش به من گفت که ای تیرِ ملامت، درست به هدف نشانه رفته است."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "که ای تیرِ ملامت را نشانه!",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "نبندی زان میان طرفی، کمروار،",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "از آن معشوقِ کمر‌باریک چیزی نصیبت نمی‌شود، اگر خودت را در میانه ببینی."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "اگر خود را ببینی در میانه",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "برو، این دام بر مرغی دگر نِه",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: برو، این تله یا دام را برای پرنده‌ای دیگر بگذار؛ زیرا عَنقا، پرنده‌ای افسانه‌ای و بزرگ، آشیانه‌اش در بلندای آسمان است."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "که عَنقا را بلند است آشیانه!",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "کِه بَندد طرفِ وصل ازْ حُسنِ شاهی؟",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چه کسی می‌تواند به وصل و پیوندی از جمال و زیبایی پادشاه (خدا) دست یابد؟ چه کسی می‌تواند با خود عشق را برای همیشه حفظ کند؟"
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "کِه با خود عشق بازد جاودانه‌؟",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "ندیم و مطرب و ساقی، همه اوست؛",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دوستان و نوازندگان و شراب‌فروش همگی او (عشق) است؛ این تصورات از ظواهر و زیبایی‌های جهان مادی تنها یک بهانه برای رسیدن به او هستند."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "خیالِ آب و گل در رَه، بهانه",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "بِده کشتیِ مِی تا خوش برانیم،",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بده، یعنی به ما شراب بده تا با استفاده از آن به خوشی و لذت بپردازیم و از این دریاچه عمیق و ناشناخته زندگی عبور کنیم."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "از این دریایِ ناپیداکرانه",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "وجودِ ما معمایی‌ست، حافظ؛",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: وجود ما، حافظ، مانند معمایی است که برای فهمیدنش باید به جادو و افسانه‌گری روی آورد."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "که تحقیقش، فُسون است و فِسانه",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    }
  ],
