  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "حُسن تو همیشه در فزون باد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: زیبایی تو همیشه در اوج است و چهره‌ات هر سال مانند گل لاله می‌درخشد."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "رویت همه ساله لاله‌گون باد",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "اندر سرِ ما خیالِ عشقت",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در ذهنِ ما هر روز خیالِ عشق تو وزش دارد و مانند بادی که همیشه در حال افزایش است."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "هر روز که باد در فزون باد",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "هر سرو که در چمن درآید",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر درخت سروی که به چمن بیفتد، باید در برابر قامت تو سرنگون شود."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "در خدمتِ قامتت نگون باد",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "چشمی که نه فتنهٔ تو باشد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چشمی که نتواند به زیبایی تو خیره شود، مثل اشکی است که از غم داغی در دل، غرق خون شده است."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "چون گوهرِ اشک غرقِ خون باد",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "چشمِ تو ز بهرِ دلربایی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چشم تو به خاطر دلربایی، همچون جادوگری مهارت دارد."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "در کردنِ سحر ذوفنون باد",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "هر جا که دلیست در غمِ تو",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر جایی که دل‌های عاشق وجود دارد، به خاطر غم تو در حال بی‌قراری و ناآرامی هستند."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "بی صبر و قرار و بی سکون باد",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "قَدِّ همه دلبرانِ عالم",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر کدام از زیباترین دلبران جهان، در مقایسه با زیبایی‌ات مثل نان در برابر باد است."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "پیشِ الفِ قَدَت چو نون باد",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "هر دل که ز عشقِ توست خالی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر کسی که دلش از عشق تو خالی باشد، نباید حلقه‌ی ارتباط و پیوند با تو را داشته باشد."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "از حلقهٔ وصلِ تو برون باد",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "لعلِ تو که هست جانِ حافظ",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: عشق و زیبایی تو، جان و زندگی حافظ است و دوری تو از مردم پست و بی‌ارزش، به مانند حرکتی نیکوست."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "دور از لبِ مردمانِ دون باد",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    }
  ],
