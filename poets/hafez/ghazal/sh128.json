  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "نیست دَر شهر نگاری که دلِ ما بِبَرَد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "در این شهر زیبارویی نیست که دل ما را ببرد ، بخت اگر کمکم کند، من را از اینجا ببرد ( شاید در حالی دیگر چنین یاری پیدا کردم)"
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "بختم اَر یار شَوَد رَختَم از این جا\u00A0بِبَرَد",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "کو حریفی کَشِ سَرمَست که پیشِ کَرَمَش",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "کو یاری که او چنان سر‌مست و با کرم و بخشش باشد که یک عاشق سوخته‌دل (مهجور) از او درخواست و تمنایی (وصال) داشته باشد؟\u00A0"
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "عاشقِ سوخته‌دل، نامِ تَمَنا\u00A0بِبَرَد",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "باغبانا زِ خَزان، بی‌خَبَرَت می‌بینم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "ای باغبان و صاحب باغ‌، تو را (مغرور‌) و بی‌خبر از قضا و تقدیر خزان می‌بینم‌، وای بر روزی که گل‌های رعنا و دلکش تو را باد پاییزی ببرد."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "آه از آن روز که بادَت گُلِ رَعنا\u00A0بِبَرَد",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "رَهزنِ دَهر نَخفته‌ست، مَشو ایمن از او",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "راهزن روزگار هرگز خواب نیست، پس از او احساس امنیت نکن! اگر امروز تو را نبرده است، مطمئن باش که فردا خواهد برد."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "اگر امروز نَبُرده‌ست که فردا\u00A0بِبَرَد",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "در خیال، این هَمه لُعبَت به هَوَس می‌بازَم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "در خیال خود و در شعر خود این همه لعبت زیبا به آرزو و هوس می‌آفرینم شاید صاحب‌نظری بیاید و این لعبت‌بازی را تماشا کند و بپسندد."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "بو که صاحب‌نَظَری نامِ تماشا بِبَرَد",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "عِلم و فَضلی که به چِل سال دلَم جمع آورد",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "دانش و بزرگی که در چهل سال بدین آورده ام را می‌ترسم که آن چشمان مست ببرد و غارت کند."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "تَرسَم آن نَرگسِ مَستانه به یَغما\u00A0بِبَرَد",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "بانگِ گاوی، چه صدا باز دَهَد؟ عِشوه مَخَر",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "بانگ گاو چه صدایی دارد؟ فریب مخور! سامری نیرنگ‌باز کیست که بر ید بیضا پیروز شود؟ (اشاره است به داستان گوساله‌ای که سامری از زر (سمبل پول) ساخت و صدایی از او بر‌می‌خواست (سمبل جادو و نیرنگ) و به بنی‌اسراییل گفت «خدای شما و موسی این است» در حالیکه دروغ می‌گفت و آن خدای موسی نبود.)"
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "سامری کیست که دَست از یَدِ بیضا\u00A0بِبَرَد؟",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "جامِ میناییِ مِی، سَدِ رَهِ تَنگ‌دِلی‌ست",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "جام مینایی و زلال‌ می، از دلتنگی و انده جلوگیری می‌کند آن‌را یک لحظه از دست فرو مگذار وگر نه سیل غم تو را با خود می‌برد"
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "مَنِه از دَست که سیلِ غَمَت از جا\u00A0بِبَرَد",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "راهِ عشق اَر چه کمینگاهِ کَمانداران اَست",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "راه و جاده عشق اگر‌چه پر‌خطر و پر از کمان‌دار است؛ ‌(شجاع باش و برو) زیرا هر کسی که با دانایی این راه را بپیماید بر دشمنان پیروز خواهد شد."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "هر که دانسته رَوَد صَرفه زِ اعدا\u00A0بِبَرَد",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "حافظ! اَر جان طَلَبَد غَمزهٔ مَستانهٔ یار",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "حافظا.. اگر چشم شوخ یار از تو جانت را خواست، تردید مکن و خانه دل را از هرچه غیر اوست پاک کن و بگذار تا ببرد."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "خانه از غیر بِپَرداز و بِهِل تا\u00A0بِبَرَد",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    }
  ],
