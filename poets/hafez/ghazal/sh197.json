  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "شاهدان گر دلبری زین سان کنند",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر زیبارویان این‌گونه دل‌ربایی کنند، در ایمان زاهدان هم شکاف می‌اندازند و پرهیزگاران را از راه به در می‌برند."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "زاهدان را رخنه در ایمان کنند",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "هر کجا آن شاخِ نرگس بِشْکُفد",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر جا آن معشوق که چشمش چون نرگس است جلوه کند، زیبارویان گل‌چهره چشم خود را گلدان آن نرگس می‌کنند؛ یعنی با شیفتگی به او خیره می‌شوند و او را در چشم خود جا می‌دهند."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "گُل‌رُخانَش دیده نرگس‌دان کنند",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "ای جوانِ سَروقَد! گویی بِبَر",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "\u00A0ای جوان بلند قامت، گویی (منظور گوی چوگان )ببر و تلاش کن تا برنده باشی قبل از اینکه پیر شوی و قامتت مانند چوگان خمیده شود\u00A0"
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "پیش از آن کز قامتت چوگان کنند",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "عاشقان را بر سرِ خود حُکم نیست",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: عاشقان بر سرنوشت و جان خود اختیاری ندارند و هر چه معشوق فرمان دهد همان را انجام می‌دهند."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "هر چه فرمانِ تو باشد آن کنند",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "پیشِ چشمم کمتر است از قطره‌ای",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: داستان‌هایی که از طوفان (طوفان نوح) می‌گویند، در برابر اشکی که از چشم من روان است از یک قطره هم کمتر است."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "این حکایت‌ها که از طوفان کنند",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "یارِ ما چون گیرد آغازِ سَماع",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هنگامی که یار ما به رقص و سماع می‌پردازد، فرشتگان آسمانی نیز بر عرش از شادی دست‌افشانی و پایکوبی می‌کنند."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "قُدسیان بر عرش دست‌افشان کنند",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "مردمِ چشمم به خون آغشته شد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: مردمک چشمم از بس گریستم به خون آغشته شد؛ این چه ستمی است و کجا با انسان چنین می‌کنند؟ «مردم چشم» هم مردمک و هم انسان را به ذهن می‌آورد."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "در کجا این ظلم بر انسان کنند؟",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "خوش برآ با غصه، ای دل! کاَهلِ راز",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای دل، با غم خوش بساز و شکیبا باش، زیرا رازدانان عشق، شادی واقعی را در کورهٔ جدایی به دست می‌آورند و هجران آنان را پاک و ناب می‌کند."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "عیشِ خوش در بوتهٔ هجران کنند",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "سر مکش حافظ ز آهِ نیم‌شب",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: حافظ، از آه و ناله و راز و نیاز نیمه‌شب روی برمگردان، تا دلت را مانند صبح روشن و آینه‌وار درخشان کنند."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "تا چو صبحت، آینه رخشان کنند",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    }
  ],
