  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "شاهدان گر دلبری زین سان کنند",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر دلبرانی چون آن شاهد، دلبری کنند، زاهدان (مؤمنان) نیز دچار تردید در ایمان خود خواهند شد."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "زاهدان را رخنه در ایمان کنند",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "هر کجا آن شاخِ نرگس بِشْکُفد",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر جا که گل‌های زیبای نرگس شکوفه دهند، آنجا چهره‌های زیبا را به عنوان نرگس می‌شناسند."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "گُل‌رُخانَش دیده نرگس‌دان کنند",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "ای جوانِ سَروقَد! گویی بِبَر",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "\u00A0ای جوان بلند قامت، گویی (منظور گوی چوگان )ببر و تلاش کن تا برنده باشی قبل از اینکه پیر شوی و قامتت مانند چوگان خمیده شود\u00A0"
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "پیش از آن کز قامتت چوگان کنند",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "عاشقان را بر سرِ خود حُکم نیست",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: عاشقان هیچ‌کدام محدود به دستورات و قوانین نیستند و هر کاری که تو بخواهی انجام می‌دهند."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "هر چه فرمانِ تو باشد آن کنند",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "پیشِ چشمم کمتر است از قطره‌ای",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: این حکایت‌ها و خبرهایی که دربارهٔ عشق و عاشقی می‌گویند، در نظر من به اندازهٔ یک قطره هم اهمیت و ارزش ندارند، چرا که به شدت تحت تأثیر طوفانی بزرگ‌تر و عمیق‌ترند."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "این حکایت‌ها که از طوفان کنند",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "یارِ ما چون گیرد آغازِ سَماع",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: وقتی که معشوق ما شروع به رقص و شادی می‌کند، فرشتگان در آسمان با شگفتی و شادی دست‌هایشان را به سمت او فرا می‌برند."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "قُدسیان بر عرش دست‌افشان کنند",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "مردمِ چشمم به خون آغشته شد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چشم‌های مردم شهر من از غم و اندوه مانند خون شده است؛ این همه ظلم و ستم بر انسان‌ها چه جایی انجام می‌شود؟"
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "در کجا این ظلم بر انسان کنند؟",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "خوش برآ با غصه، ای دل! کاَهلِ راز",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای دل، با غم و اندوه خوش باشید! چون بی‌تحرکی و رکود در فهم لذت‌های زندگی، در دوران جدایی و فراق، به انسان آسیب می‌زند."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "عیشِ خوش در بوتهٔ هجران کنند",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "سر مکش حافظ ز آهِ نیم‌شب",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چهرهٔ زیبا و درخشانت را در صبحگاهان مثل آینه روشن می‌کنند، پس از اندوه شبانه تا صبح، سر به زمین نگذار و غم به دل راه نده."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "تا چو صبحت، آینه رخشان کنند",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    }
  ],
