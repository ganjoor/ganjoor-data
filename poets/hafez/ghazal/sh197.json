  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "شاهدان گر دلبری زین سان کنند",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر کسانی با دلربایی و زیبایی خود این‌گونه رفتار کنند، ایمان زاهدان و پارسایان دچار تزلزل می‌شود."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "زاهدان را رخنه در ایمان کنند",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "هر کجا آن شاخِ نرگس بِشْکُفد",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر جا که آن گل نرگس شکفته شود، زیبایی‌اش را به چشمان دیگران نشان می‌دهد و آنها نیز آن را درک می‌کنند."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "گُل‌رُخانَش دیده نرگس‌دان کنند",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "ای جوانِ سَروقَد! گویی بِبَر",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "\u00A0ای جوان بلند قامت، گویی (منظور گوی چوگان )ببر و تلاش کن تا برنده باشی قبل از اینکه پیر شوی و قامتت مانند چوگان خمیده شود\u00A0"
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "پیش از آن کز قامتت چوگان کنند",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "عاشقان را بر سرِ خود حُکم نیست",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: عاشقان هیچ قانونی بر سر خود ندارند و هر چه تو دستور بدهی، همان را انجام می‌دهند."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "هر چه فرمانِ تو باشد آن کنند",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "پیشِ چشمم کمتر است از قطره‌ای",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: این داستان‌ها که از طوفان‌ها و مشکلات می‌گویند، در مقایسه با آنچه که در چشم من می‌بینم، بسیار ناچیز و کم‌اهمیت است."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "این حکایت‌ها که از طوفان کنند",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "یارِ ما چون گیرد آغازِ سَماع",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دوست ما وقتی که شروع به جشن و سرور می‌کند، فرشتگان در بلندای آسمان به شادی دست‌ها را به نشانهٔ خوشحالی می‌افشانند."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "قُدسیان بر عرش دست‌افشان کنند",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "مردمِ چشمم به خون آغشته شد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: مردم چشمم در خون غوطه‌ور شده‌اند. کاش کسی بگوید در کجا این ظلم‌ها بر انسان‌ها روا می‌دارند؟"
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "در کجا این ظلم بر انسان کنند؟",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "خوش برآ با غصه، ای دل! کاَهلِ راز",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: عشق و شادی را با غم و اندوه همراه کن، زیرا انسان‌های بی‌خیال از خوشی‌ها در درد جدایی به سر می‌برند."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "عیشِ خوش در بوتهٔ هجران کنند",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "سر مکش حافظ ز آهِ نیم‌شب",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: سر خود را از غم شبانه بردار، زیرا در سپیده‌دم، چهره‌ای درخشان ترسیم خواهد شد."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "تا چو صبحت، آینه رخشان کنند",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    }
  ],
