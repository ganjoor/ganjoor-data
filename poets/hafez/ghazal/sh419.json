      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "جوانا! سَر متاب از پندِ پیران",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "که رای پیر از بختِ جوان به",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "شبی می‌گفت چشمِ کَس ندیده‌ست",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
