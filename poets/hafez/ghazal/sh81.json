  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "صبحدم مرغ چمن با گل نوخاسته گفت",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "صبح‌گاه بلبل با گل تازه‌شکفته گفت که با من کم ناز کن زیرا در این باغ‌، گل‌‌‌های همچون تو بسیارند."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "ناز کم کن که در این باغ بسی چون تو شکفت",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "گل بخندید که از راست نرنجیم ولی",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "گل خندید و به او پاسخ داد: از سخن راست نمی‌رنجیم ولی کسی که عاشق است اینگونه با معشوق و محبوب‌، سخن نمی‌گوید."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "هیچ عاشق سخن سخت به معشوق نگفت",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "گر طمع داری از آن جام مرصع میِ لعل",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "اگر امید داری که از آن‌جام یگانه و مرصّع‌، باده بنوشی‌، بسیار مروارید‌های اشک باید از نوک مژگان بریزی."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "ای بسا دُر که به نوک مژه‌ات باید سفت",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "تا ابد بوی محبت به مشامش نرسد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "تا ابد و هرگز بوی عشق را نشنود و نخواهد دانست که عشق و محبت چیست، آن‌کس که چهره و رخسار بر خاک در میخانه ننهد."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "هر که خاک در میخانه به رخسار نرُفت",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "در گلستان ارم دوش چو از لطف هوا",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "دیشب در گلستان بهشت وقتی که نسیم ملایم‌ سحری، زلف سنبل را آشفته می‌کرد."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "زلف سنبل به نسیم سحری می‌آشفت،",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "گفتم: «ای مسند جم! جام جهان‌بینت کو؟»",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "از او پرسیدم که ای تکیه‌گاه جمشید، جام جهان‌بین تو کجاست (که مرا نصیب دهی) گفت افسوس که آن دولت نیک و سعادت خفت."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "گفت: «افسوس که آن دولت بیدار بخفت!»",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "سخن عشق نه آن است که آید به زبان",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هرچه که بیان شود سخن عشق نیست، ای ساقی باده بده و این گفتگو را کوتاه کن."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "ساقیا می ده و کوتاه کُن این گفت و شنفت",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "اشک حافظ، خرد و صبر، به دریا انداخت",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "اشک و گریه حافظ‌، عقل و صبر را به دریا انداخت، چه می‌توانست کرد زیرا سوز و درد عشق را نمی‌توانست نهان کند."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "چه کند؟ سوز غم عشق نیارست نهفت",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    }
  ],
