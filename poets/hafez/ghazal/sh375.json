  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "صوفی بیا که خرقه سالوس برکشیم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای صوفی (زاهد)، بیا که لباس ریا و بزرگ‌منشی را کنار بگذاریم و این نقوش بیهوده را باطل کنیم."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "وین نقش زرق را خط بطلان به سر کشیم",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "نذر و فتوح صومعه در وجه می نهیم",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ما در راه خدا و به خاطر می، نذر و صدقه می‌دهیم و در عوض، لباس ریاکاری را به دور می‌ریزیم و به میخانه می‌رویم."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "دلق ریا به آب خرابات برکشیم",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "فردا اگر نه روضه رضوان به ما دهند",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر فردا به ما نعمت‌های بهشتی مثل باغ‌های رضوان ندهند، ما غلمان (پسران بهشتی) و حور (زنان بهشتی) را از بهشت به سمت خود می‌آوریم."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "غلمان ز روضه حور ز جنت به درکشیم",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "بیرون جهیم سرخوش و از بزم صوفیان",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر روزی از دنیای شادی و خوشی خارج شویم، با سرخوشی و شادابی از محفل صوفیان، شراب و معشوقه را قاچاق می‌کنیم و نزد خود می‌آوریم."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "غارت کنیم باده و شاهد به بر کشیم",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "عشرت کنیم ور نه به حسرت کشندمان",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: باید در زندگی خوش بگذرانیم وگرنه روزی به حسرت و افسوس خواهیم افتاد، زمانی که جان‌مان را از بدن جدا کرده و به دنیای دیگری برویم."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "روزی که رخت جان به جهانی دگر کشیم",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "سر خدا که در تتق غیب منزویست",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: حافظ می‌گوید که سر و راز خدا که در عالم غیب پنهان و دور افتاده است، با شوری و شادی باید پرده‌اش را از روی چهره‌اش کنار بزنیم."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "مستانه‌اش نقاب ز رخسار برکشیم",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "کو جلوه‌ای ز ابروی او تا چو ماه نو",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر از ابرو و زیبایی معشوق، جلوه‌ای بیابیم، آن‌گاه همچون ماه نو، نشان قمر را در خم چوگان زرین به نمایش خواهیم گذاشت."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "گوی سپهر در خم چوگان زر کشیم",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "حافظ نه حد ماست چنین لاف‌ها زدن",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: حافظ می‌گوید لاف زدن و ادعا کردن دربارهٔ چیزهایی که به ما مربوط نیست، کار درستی نیست و نباید فراتر از ظرفیت خود صحبت کنیم."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "پای از گلیم خویش چرا بیشتر کشیم",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    }
  ],
