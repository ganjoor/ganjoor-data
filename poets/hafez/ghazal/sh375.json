  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "صوفی بیا که خرقه سالوس برکشیم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای صوفی، بیا تا خرقهٔ ریاکاری را از تن بیرون آوریم و بر این ظاهرِ فریبنده خط باطل بکشیم."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "وین نقش زرق را خط بطلان به سر کشیم",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "نذر و فتوح صومعه در وجه می نهیم",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: نذرها و هدیه‌هایی را که به خانقاه می‌رسد خرج شراب کنیم و جامهٔ ریاکاری را در آب میکده بشوییم."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "دلق ریا به آب خرابات برکشیم",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "فردا اگر نه روضه رضوان به ما دهند",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر فردای قیامت بهشت را به ما ندهند، غلمان و حوریان را به زور از بهشت بیرون می‌کشیم. این سخن گستاخانه و رندانه است."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "غلمان ز روضه حور ز جنت به درکشیم",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "بیرون جهیم سرخوش و از بزم صوفیان",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: سرمست از مجلس صوفیان بیرون بزنیم، شرابشان را به غنیمت ببریم و معشوق زیبا را در آغوش بگیریم."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "غارت کنیم باده و شاهد به بر کشیم",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "عشرت کنیم ور نه به حسرت کشندمان",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اکنون شادی و خوش‌گذرانی کنیم، وگرنه روزی که جان از این جهان به جهان دیگر می‌بریم با حسرت ما را خواهند برد."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "روزی که رخت جان به جهانی دگر کشیم",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "سر خدا که در تتق غیب منزویست",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: راز الهی را که در پردهٔ غیب پنهان است، در حال مستی از چهره‌اش پرده برمی‌داریم."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "مستانه‌اش نقاب ز رخسار برکشیم",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "کو جلوه‌ای ز ابروی او تا چو ماه نو",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: کجاست جلوه‌ای از ابروی معشوق، تا با آن ابروی هلال‌مانند چون چوگانی زرین، گوی آسمان را به دست آوریم و بر جهان چیره شویم."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "گوی سپهر در خم چوگان زر کشیم",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "حافظ نه حد ماست چنین لاف‌ها زدن",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: حافظ به خود می‌گوید: چنین ادعاهای بزرگی در اندازهٔ ما نیست. چرا بیش از توان و جایگاه خود پا فراتر بگذاریم؟"
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "پای از گلیم خویش چرا بیشتر کشیم",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    }
  ],
