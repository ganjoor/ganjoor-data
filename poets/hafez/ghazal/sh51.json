  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "لعلِ سیرابِ به‌خون‌تشنه‌، لب یار من است",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "معشوق من لب‌هایی دارد سیراب از سرخی همچون لعل اما تشنه به خون، و در اشتیاق دیدن آن لب‌ها‌، جان دادن و جان‌بازی کار و پیشه من است."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "وز پی دیدنِ او دادنِ جان کار من است",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "شرم از آن چشمِ سیه بادش و مژگان دراز",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "شرم باد بر کسی که به‌آن چشمان سیاه و مژگان بلند می‌نگرد وقتی که دل‌بردن آنها را از من می‌بیند و مرا نادیده می‌گیرد."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "هر که دل بردنِ او دید و در انکارِ من است",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "ساروان رَخت به دروازه مَبَر‌، کان سرِ کو",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "ای ساروان، به دروازه مرو و در آن محله توقف مکن که آنجا شاهراهی‌است که مأوا و منزل معشوق من است."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "شاهراهی‌ست که منزلگهِ دلدارِ من است",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "بندهٔ طالعِ خویشم که در این قحطِ وفا",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "بنده و ممنون فال نیکوی خودم هستم که در این قحطی وفا و مهر، من مهر آن لولی سرمست را در دل دارم. (لولی یا کولی‌ها در رقص و شاد بودن معروف بوده‌اند در اینجا در معنایی سمبلیک و مجازی به‌کار رفته‌است.)"
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "عشق آن لولیِ سرمست‌، خریدار من است",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "طَبلِهٔ عطرِ گل و زلفِ عبیر افشانش",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "بوستان گل و سنبل‌های خوش‌عطرش‌، یک رایحه از عطر عطار ( ومعشوق خوش‌عطر) من است."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "فیضِ یک شَمِّه ز بوی خوشِ عطارِ من است",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "باغبان همچو نسیمم ز درِ خویش مران",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "ای باغبان چون (نسیم که به دزدی عطرهای باغت می‌آید) با من رفتار مکن و مرا از در مران‌، اشک چشمان من است که گل‌های باغت را تازه نگه‌می‌دارد و\u00A0آبیاری می‌کند."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "کآبِ گلزارِ تو از اشکِ چو گلنارِ من است",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "شربتِ قند و گلاب از لبِ یارم فرمود",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "چشمان مستش که طبیب دل دردمند و عاشق من است، برای درمان من از لبانش شربت قند و گلاب نسخه‌کرد."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "نرگس او که طبیبِ دلِ بیمارِ من است",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "آن که در طرزِ غزل نکته به حافظ آموخت",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "کسی که نظم و طرز غزل‌آرایی را به حافظ آموخت یار و محبوبِ شیرین‌گفتار و نغزگوی بی‌همتای من است."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "یارِ شیرین‌سخنِ نادره‌گفتارِ من است",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    }
  ],
