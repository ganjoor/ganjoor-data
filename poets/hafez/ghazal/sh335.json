  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "در خراباتِ مُغان گر گذر افتد بازم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر بار دیگر گذرم به میخانهٔ مغان بیفتد، هرچه از خرقه و سجادهٔ زهد دارم بی‌درنگ در قمار می‌بازم و از دست می‌دهم."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "حاصلِ خرقه و سجاده، روان دربازم",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "حلقهٔ توبه گر امروز چو زُهّاد زنم",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر امروز مانند زاهدان در توبه را بکوبم و توبه کنم، فردا نگهبان میکده در را به رویم باز نخواهد کرد."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "خازنِ میکده فردا نَکُنَد در، بازم",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "ور چو پروانه دهد دست، فَراغِ بالی",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر مانند پروانه آسودگی و آزادی بال نصیبم شود، جز به سوی چهرهٔ شمع‌مانند تو پرواز نمی‌کنم."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "جز بدان عارضِ شمعی نَبُوَد پروازم",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "صحبتِ حور نخواهم که بُوَد عینِ قُصور",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: همنشینی با حوریان بهشت را نمی‌خواهم؛ زیرا اگر با وجود خیال تو به دیگری بپردازم، این خود عین کوتاهی و نقصان است. «قصور» به کاخ‌های بهشت نیز ایهام دارد."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "با خیالِ تو اگر با دِگری پردازم",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "سِرِّ سودایِ تو در سینه بماندی پنهان",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: راز عشق تو در سینه‌ام پنهان می‌ماند، اگر چشم گریان و بی‌پروای من با اشک‌هایش رازم را آشکار نکرده بود. «تردامن» به آلودگی و رسوایی هم ایهام دارد."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "چشمِ تَر دامن اگر فاش نکردی رازم",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "مرغْ سان از قفسِ خاک هوایی گشتم",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: مانند پرنده‌ای از قفس تن خاکی رها شدم و به هوا پریدم، به این امید که شاهباز (معشوق) مرا شکار کند."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "به هوایی که مگر صید کُنَد شهبازم",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "همچو چنگ ار به کناری ندهی کامِ دلم",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "اگر همچون ساز چنگ مرا در آغوش نگیری و ننوازی حداقل همچون نی مرا با لبانت یک لحظه بنواز (کنار: آغوش)"
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "از لبِ خویش چو نِی یک نفسی بِنْوازم",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "ماجرایِ دلِ خون گشته نگویم با کس",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: سرگذشت دل خونینم را با هیچ‌کس نمی‌گویم، زیرا جز شمشیر غم تو هیچ همدم و همرازی ندارم."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "زان که جز تیغِ غمت نیست کسی دَمسازم",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "گر به هر موی، سری بر تنِ حافظ باشد",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر بر تن حافظ به شمار هر مویش سری باشد، همه را مانند زلف تو که بر پایت افتاده است، در پای تو می‌افکنم و فدا می‌کنم."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "همچو زلفت همه را در قدمت اندازم",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    }
  ],
