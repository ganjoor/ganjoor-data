  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "در خراباتِ مُغان گر گذر افتد بازم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر در میخانه‌ی مغان قدم بگذارم، می‌دانم که با خودم، چیزی جز دوستی و محبت نخواهم برد."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "حاصلِ خرقه و سجاده، روان دربازم",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "حلقهٔ توبه گر امروز چو زُهّاد زنم",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: امروز تصمیم به توبه دارم و مانند زاهدان عمل می‌کنم، اما فردا اگر خواستم به میخانه بروم، کسی نمی‌تواند مانع ورود من شود."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "خازنِ میکده فردا نَکُنَد در، بازم",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "ور چو پروانه دهد دست، فَراغِ بالی",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر دست به من بدهد، پرواز من تنها به خاطر زیبایی آن شمع خواهد بود و هیچ پرواز دیگری ندارم."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "جز بدان عارضِ شمعی نَبُوَد پروازم",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "صحبتِ حور نخواهم که بُوَد عینِ قُصور",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من نمی‌خواهم درباره‌ی زیبایی‌های حوریان صحبت کنم، چون این موضوع خود به تنهایی مانند زندگی در قصر می‌ماند. اگر با خیال تو، به کسی دیگر فکر کنم و سخن بگویم، برایم بی‌معناست."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "با خیالِ تو اگر با دِگری پردازم",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "سِرِّ سودایِ تو در سینه بماندی پنهان",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آرزو و عشق تو در دل من مخفی مانده و اگر تو تاکنون راز مرا فاش نکرده‌ای، دلیلی بر این است که هنوز عاشقانه به یاد تو هستم."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "چشمِ تَر دامن اگر فاش نکردی رازم",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "مرغْ سان از قفسِ خاک هوایی گشتم",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به مانند پرنده‌ای که از قفس خاکی خود آزاد شده‌ام، به دنیای جدیدی پا گذاشته‌ام که شاید بتواند مرا به سوی شکار شهباز راهی کند."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "به هوایی که مگر صید کُنَد شهبازم",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "همچو چنگ ار به کناری ندهی کامِ دلم",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "اگر همچون ساز چنگ مرا در آغوش نگیری و ننوازی حداقل همچون نی مرا با لبانت یک لحظه بنواز (کنار: آغوش)"
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "از لبِ خویش چو نِی یک نفسی بِنْوازم",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "ماجرایِ دلِ خون گشته نگویم با کس",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من ماجرای دل شکسته و غمگینم را برای کسی نمی‌گویم، زیرا هیچ‌کس جز تیغ درد عشق تو، نمی‌تواند با من همدردی کند."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "زان که جز تیغِ غمت نیست کسی دَمسازم",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "گر به هر موی، سری بر تنِ حافظ باشد",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر به هر مویی یک سر بر تن حافظ باشد، مانند زلف تو، همه آن‌ها را در پای تو می‌ریزم."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "همچو زلفت همه را در قدمت اندازم",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    }
  ],
