  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "چراغ روی تو را شمع گشت پروانه",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "از نور رخسار تو چنان بر شمع رفت که خود همچون پروانه عاشق تو شد، من در عشقت چنانم که از خود بی‌خبرم."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "مرا ز حال تو با حال خویش پروا، نه",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "خِرد که قید مجانین عشق می‌فرمود",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "خرَد که حُکم زنجیرِ دیوانگان عشق را صادر می‌کرد، خود به عطر خوش زلفِ تو دیوانه شد. («بوی» معنی آرزو هم می‌دهد؛ در آرزوی رسیدن به زنجیر زلفت، دیوانه گشت.)"
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "به بوی سنبل زلف تو گشت دیوانه",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "به بوی زلف تو گر جان به باد رفت‌، چه شد؟",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "در آرزوی وصال زلف تو هر جان که کشته گشت، همه فدای تو باد ای جان‌ِ جان!"
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "هزار جان گرامی فدای جانانه",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "من‌ِ رمیده ز غیرت ز پا فتادم دوش",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "من رمیده‌غیرت که به هیچ‌کس غیرت نورزیده‌ام وقتی که نگار و محبوب خود را در دست بیگانه دیدم از فرط غیرت و غم از پای در‌افتادم."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "نگار خویش چو دیدم به دست بیگانه",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "چه نقش‌ها که برانگیختیم و سود نداشت",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "چه ترفند‌ها و حیله‌ها کردیم اما سود نکرد؛ فسون و حیله‌های ما برای او همچون داستانی قدیمی است."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "فسون ما بر او گشته است افسانه",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "بر آتش رخ زیبای او به جای سپند",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "بر رخ پر‌حرارت و گرم او به غیر از خال سیاهش که همچون سپند (او را از چشم بد نگه‌می‌دارد) چه کسی دانه‌ای زیباتر دیده است؟"
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "به غیر خال سیاهش که دید به دانه؟",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "به مژده، جان به صبا داد شمع در نفسی",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "در نفَسی‌: در یک آن‌، فورا.\u00A0 \u00A0 پروانه: مجازا به معنی نور و پرتو چراغ و شمع || و نیز به معنی اجازه و برات."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "ز شمع روی تواَش چون رسید پروانه",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "مرا به دور لب دوست هست پیمانی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "با لب دوست و یار خود پیمان بسته‌ام که جز سخن مستی و عشق‌، چیزی نگویم."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "که بر زبان نبرم جز حدیث پیمانه",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "حدیث مدرسه و خانقه مگوی که باز",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "از مدرسه و خانقاه سخن مگو که باز هوای می‌خانه در سر حافظ افتاد."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "فتاد در سر حافظ هوای میخانه",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    }
  ],
