  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "سَلامی چو بویِ خوشِ آشنایی",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "بِدان مَرْدُمِ دیدِهٔ روشَنایی",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "درودی چو نورِ دِلِ پارسایان",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "بِدان شَمْعِ خَلْوَتْگَهِ پارسایی",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "نِمی‌بینَم از هَمْدَمان، هیچ بَر جای",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "دِلَم، خون شد از غُصِّه؛ ساقی! کُجایی؟",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "زِ کویِ مُغان، رُخ مَگَرْدان! کِه آنجا",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "فُروشَنْد مِفْتاحِ مُشْکِل‌گُشایی",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "عَروسِ جَهان گَرچِه دَر حَدِّ حُسْن است",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "زِ حَد می‌بَرَد شیوِهٔ بی‌وَفایی",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "دِلِ خَسْتِهٔ مَن گَرَش هِمَّتی هَسْت",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "نَخواهَد زِ سَنْگین‌دِلان، مومیایی",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "مِیِ صوفی‌اَفْکَن، کُجا می‌فُروشَنْد؟",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "کِه دَر تابم اَز دَسْتِ زُهْدِ ریایی",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "رَفیقان، چُنان، عَهْدِ صُحْبَت شِکَسْتَنْد",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "کِه گویی نَبوده‌ست خود، آشْنایی",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "مَرا گَر تو بُگْذاری، اِی نَفْس طامِع!",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "بَسی پادْشایی کُنَم دَر گِدایی",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "بیاموزَمت کیمیایِ سَعادَت",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "زِ هَم‌صُحْبَتِ بَد،\u00A0جُدایی! جُدایی!",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "مَکُن «حافِظ» اَز جورِ دوران، شِکایَت!",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "چِه دانی تو، اِی بَنْدِه! کارِ خُدایی؟",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    }
  ]
}
