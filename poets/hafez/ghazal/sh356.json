  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "گَرَم از دست برخیزد که با دلدار بنشینم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "اگر روزی از دستم برآید و بتوانم که با یار بنشینم؛ مست وصالش می‌شوم و از گلزار زیبای لذت، گُل خواهم چید."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "ز جامِ وصل مِی‌ نوشم، ز باغِ عیش گل چینم",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "شرابِ تلخِ صوفی سوز، بنیادم بخواهد برد",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "شراب تلخ دین‌بر‌باد‌ده، بنیادم را خواهد بُرد؛ لب را بر لبم بنه ای ساقی و جانم را بستان."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "لبم بر لب نِه ای ساقی و بِستان جانِ شیرینم",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "مگر دیوانه خواهم شد در این سودا که شب تا روز",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "شاید از این سودا و خیال دیوانه‌شوم زیرا شب و روز با ماه هم‌سخن هستم و فرشته در خواب می‌بینم!"
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "سخن با ماه می‌گویم، پَری در خواب می‌بینم",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "لبت شِکَّر به مستان داد و چَشمت مِی به مِیخواران",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "لب تو نُقل و شیرینی به مستان داد و چشمت باده به می‌خواران؛ منم که از نهایت بی‌بهرگی و ناامیدی نه به آن می‌رسم نه به این."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "منم کز غایتِ حِرمان نه با آنم نه با اینم",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "چو هر خاکی که باد آورد، فیضی بُرد از اِنعامت",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "وقتی‌که هر کمتر خاکی از تو فیض و بهره‌ای بُرد؛ از من نیز یادی کن که خدمتکار و ارادتمند دیرین هستم."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "ز حالِ بنده یاد آور که خدمتگارِ دیرینم",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "نه هر کو نقشِ نظمی زد کلامش دلپذیر افتد",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "نه هرکس که نظمی سرود کلامش دلپذیر و دلنشین شد؛ تذرو عالی و شگرف را من شکار می‌کنم که شاهینی تیزپرواز هستم.\u00A0 (تذرو نام پرنده‌ای است)"
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "تَذَروِ طُرفه من گیرم که چالاک است شاهینم",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "اگر باور نمی‌داری، رو از صورتگرِ چین پُرس",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "اگر باور نمی‌کنی که در نقش و نقاشی همچون مانی هنرمندم، برو از صورتگران و نقاشان زُبده چین بپرس."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "که مانی نسخه می‌خواهد ز نوکِ کِلکِ مُشکینم",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "وفاداری و حق گویی نه کارِ هر کسی باشد",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "وفاداری و راستگویی کار هرکسی نیست؛ بنده\u00A0آصفِ ثانی جلالُ الحقِ و الدینم"
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "غلامِ آصفِ ثانی جلالُ الحقِ و الدینم",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "رموزِ مستی و رندی ز من بشنو نه از واعظ",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "رموز و اسرار مستی و رندی را از من بشنو نه از واعظ و شیخ؛ زیرا که هردَم‌، جام باده به‌دست‌، هم‌نشین ماه و پروین هستم."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "که با جام و قَدَح هر دَم ندیمِ ماه و پروینم",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    }
  ],
