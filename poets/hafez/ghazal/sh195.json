  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "غُلَامِ نَرْگِسِ مَسْتِ تو، تاجداران‌اَنْد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "شاهانِ تاجدار با همه بزرگی به غلامیِ چشم مست و زیبای تو مشغول اند و آنان که که از باده وجود تو نوشیده اند از مستی هوشیاری یافته اند"
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "خَرابِ بادِهٔ لَعْلِ تو، هوشیاران‌اَنْد",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "تو را صَبا و مَرا آبِ دیدِه شُد غَمّاز",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: باد صبا، تو را به عشق می‌تازد و اشک‌های من، نشان‌دهندهٔ درد عشق است. آنها که عاشق و معشوق را می‌شناسند، این راز را در دل دارند و آن را پنهان نگه می‌دارند."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "وَگَرنَه عاشِق و مَعْشوق، رازداران‌اَنْد",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "زِ زیرِ زُلْفِ دوتا چون گُذَر کُنی، بِنْگر",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر از زیر دو تار موی او عبور کنی، توجه کن که از راست و چپ چه افرادی غمگین و سوگوار هستند!"
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "کِه اَز یَمین و یَسارت چِه سوگواران‌اَنْد!",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "گُذار کُن چو صَبا بَر بَنَفْشِه‌زار! و بِبین",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به گُل‌زار برو و باد را به حرکت درآور، و ببین که چقدر به خاطر بلندی موهای تو، دل‌های عاشقان بی‌قرار شده‌اند!"
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "کِه اَز تَطاوُلِ زُلْفَت چِه بی‌قَراران‌اَنْد!",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "نَصیبِ ماست بِهِشْت، اِی خُداشِناس! بُرو!",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: نصیب ما بهشت است، ای کسی که خدا را می‌شناسی! برو و ببین که گناهکاران شایسته نعمت‌های تو هستند."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "کِه مُستَحَقِّ کِرامَت، گُناهکاران‌اَنْد",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "نَه مَن بر آن گُلِ عارِض، غَزَل سُرایم و بَس",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من به خاطر آن گل زیبا شعر نمی‌گویم، بلکه به خاطر آنچه که بلبل تو از هر سو می‌خواند، هزاران بلبل وجود دارند."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "که عَنْدَلیبِ تو اَز هَر طَرَف، هزاران‌اَنْد",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "تو دَسْتگیر شو! اِی خِضْرِ پِی‌خُجَسْتِه! کِه مَن",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای خضر، که به صورت معشوقه‌ام درآمده‌ای، تو مرا دستگیر کن! زیرا من مانند یک پیاده در مسیر عشق می‌روم و هم‌سفرانم سوار بر اسب هستند."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "پیادِه می‌رَوَم و هَمْرَهان، سَواران‌اَنْد",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "بیا به مِیکَدِه! و چِهْرِه، اَرغَوانی کُن!",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به میخانه بیا و چهره‌ات را به رنگ ارغوانی درآور، چرا که در صومعه، فقط افراد بدکار و سیاه‌رو وجود دارند."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "مَرو بِه صومَعِه کآنجا سیاه‌کاران‌اَنْد!",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "خَلاصِ «حافِظ» از آن زُلْفِ تابدار مَباد!",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: حافظ از شیدایی و عشق می‌گوید و تاکید می‌کند که او را از این زلف‌های پیچیده و شگفت‌انگیز رها نکن، زیرا کسانی که به دام این زلف‌ها افتاده‌اند، برای رهایی و نجات بخشی به او نیاز دارند."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "کِه بَسْتِگانِ کَمَنْدِ تو، رَسْتگاران‌اَنْد",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    }
  ],
