  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "فاش می‌گویم و از گفتهٔ خود دلشادَم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: صراحتاً می‌گویم و از گفته‌ام خوشحال هستم که من بندهٔ عشق هستم و از هر دو جهان آزاد شده‌ام."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "بندهٔ عشقم و از هر دو جهان آزادم",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "طایرِ گلشنِ قُدسم چه دَهَم شَرحِ فِراق؟",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "\u00A0پرنده‌ای هستم که به باغ بهشت تعلق دارد، چطور می‌توانم داستان جدایی‌ام را بگویم که چگونه به این دنیای پر از حادثه آمده‌ام."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "که در این دامگَهِ حادثه چون اُفتادم",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "من مَلَک بودم و فردوسِ بَرین جایَم بود",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من در اصل مَلَک (فرشته) بوده‌ام و بهشت جایگاه من بوده است، ولی اکنون آدم (انسان) مرا به این مکان خراب و بی‌کسی (دیر) آورده است."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "آدَم آوَرد دَر این دِیرِ خَراب‌آبادَم",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "سایهٔ طوبی و دلجوییِ حور و لبِ حوض",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "لذت بودن زیر سایهٔ درخت طوبی و در آغوش حوری‌ها و آرامش نشستن لب حوض بهشتی را به‌خاطر لذت بودن در کوی تو (نزدیک تو) فراموش کرده‌ام."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "به هوایِ سَرِ کویِ تو بِرَفت از یادم",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "نیست بر لوحِ دِلَم جُز اَلفِ قامَتِ دوست",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در دل من فقط تصویر دوست نقش بسته است و هیچ چیز دیگر یاد من نیامده است که معلم به من چیزی غیر از این آموزش داده باشد."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "چه کُنَم حَرفِ دِگَر یاد نداد اُستادم",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "کوکَبِ بَختِ مَرا هیچ مُنَجِّم نَشِناخت",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هیچ ستاره‌شناسی نتوانست بخت و سرنوشت مرا بشناسد. ای خدای بزرگ، نمی‌دانم با چه بخت و سرنوشتی پا به این دنیا گذاشته‌ام."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "یا رَب از مادرِ گیتی به چه طالع زادم؟",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "تا شُدم حَلقه به گوشِ دَرِ میخانهٔ عشق",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: وقتی که به گردن‌ آویختن گردنبند به محبت و عشق در میخانه عادت کردم، هر لحظه غم تازه‌ای به من اضافه می‌شود که باید آن را تبریک بگویم."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "هَر دَم آیَد غَمی اَز نو به مُبارَکبادَم",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "می‌خورَد خونِ دِلَم مَردُمکِ دیده، سِزاست",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "شایسته است که از چشمانم خون به‌جای اشک ببارد زیرا عاشق فرزند عزیز مردم شده‌ام."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "که چرا دِل به جِگرگوشهٔ مَردُم دادَم",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "پاک کن چهرهٔ حافظ به سَرِ زُلف زِ اَشک",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "اشک روی صورت حافظ را با نوک موهایت پاک کن و اگر این‌کار را نکنی، این اشک‌ها تبدیل به سیل پی‌درپی می‌شود و بنیاد و پایهٔ زندگی‌ام را نابود می‌کند."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "وَر نَه این سیلِ دَمادَم بِبَرَد بُنیادَم",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    }
  ],
