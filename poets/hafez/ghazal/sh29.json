  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ما را زِ خیالِ تو چه پروایِ شراب است؟",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "ما با خیال تو مستیم و به‌شراب نیاز نداریم به خُم بگو که پی کار خود گیر و برو که خمخانه تو بی‌رونق شد."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "خُم گو سر خود گیر، که خُمخانه خراب است",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "گر خَمر بهشت است بریزید که بی دوست",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "حتی شراب بهشتی را نیز میاورید که بی محبوبم بهترین شراب هم لذتی ندارد. (عَذْب‌: گوارا)"
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "هر شَربَتِ عَذبَم که دهی، عینِ عذاب است",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "افسوس که شُد دلبر و در دیدهٔ گریان",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "حیف که یارم رفت و خیال دیدن او بیهوده است."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "تحریرِ خیالِ خطِ او نقشِ بر آب است",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "بیدار شو ای دیده که ایمن نتوان بود",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "منظور از دیده: چشم. ای چشم من از خواب بیدار شو و مراد از سیل دمادم، اشک ریختن بسیار است.منزل خواب: چشم. ای چشم من بیدار شو که از اینهمه اشک ریزی امانی نیست"
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "زین سیلِ دمادم که در این منزلِ خواب است",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "معشوق عیان می‌گذرد بر تو، ولیکن",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "یار بر تو آشکارا می‌گذرد اما اغیار را دیده است و رخ نمی‌نماید."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "اغیار همی‌بیند از آن بسته نقاب است",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "گل بر رخِ رنگین تو تا لطفِ عرق دید",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "وقتی‌که گل‌، زیبایی شبنم روی تو را دید از عشق تو دلش پر آتش گشت و غرق گلاب شد."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "در آتشِ شوق از غمِ دل، غرقِ گلاب است",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "سبز است در و دشت بیا تا نگذاریم",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "تا بهار و خرمی است بیا کنار جویبار را از دست ندهیم که دنیا خیال و سرابی بیش نیست."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "دست از سرِ آبی که جهان جمله سراب است",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "در کُنجِ دِماغم مطلب جای نصیحت",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "در مغز من جایی برای پند وجود ندارد چون پُر از نغمه شاد چنگ و رباب و آهنگ و ترانه\u00A0 است."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "کـ‌این گوشه پر از زمزمهٔ چنگ و رَباب است",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "حافظ چه شد ار عاشق و رند است و نظرباز",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "چه ایرادی بر رندی و عاشقی و نظربازی حافظ هست؟ جوانی‌، این حالات را با خود دارد."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "بس طُورِ عجب لازمِ ایامِ شباب است",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    }
  ],
