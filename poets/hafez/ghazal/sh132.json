  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "به آبِ روشنِ می، عارفی طهارت کرد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در صبح زود، عارفی با آب زلال می، خود را پاکیزه کرد و به میخانه رفت تا آنجا را زیارت کند."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "عَلَی الصَّباح، که میخانه را زیارت کرد",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "همین که ساغرِ زَرّینِ خور، نهان گردید",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به محض آنکه جام زرقون خورشید غروب کرد، هلال عید با دقت به دور آن جام اشاره کرد."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "هِلال عید به دورِ قدح اشارت کرد",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "خوشا نماز و نیازِ کسی که از سرِ درد",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: کسی که از روی درد و رنج به درگاه خداوند نماز می‌گذارد و با اشک‌ها و احساسات عمیقش، خود را پاک می‌کند، حتماً در جایگاه والایی قرار دارد."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "به آبِ دیده و خونِ جگر طهارت کرد",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "امام خواجه، که بودش سرِ نمازِ دراز",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: امام خواجه که در مزاج و حالاتی خاص به نماز می‌ایستاد، به خاطر خون دختر رز، پوشش خود را به حالت کوتاه و مختصر درآورد."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "به خونِ دخترِ رَز، خرقه را قِصارت کرد",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "دلم ز حلقهٔ زلفش به جان خرید آشوب",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "دلم از حلقه‌‌ی زلفش آشفتگی را به بهای جان خرید، در این تجارت چه سودی دید، نمی‌دانم."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "چه سود دید؟ ندانم، که این تجارت کرد",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "اگر امامِ جماعت طلب کند امروز",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر امام جماعت بخواهد، امروز به او بگویید که حافظ به نوشیدن شراب پاک و زلال پرداخته است."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "خبر دهید که حافظ به می طهارت کرد",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    }
  ],
