  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "خوش خبر باشی ای نسیمِ شِمال",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای نسیم شمال، خوش خبر باش! به زودی زمان ملاقات و وصال ما فرا می‌رسد."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "که به ما می‌رسد زمانِ وصال",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "قصّةُ الْعِشق لَا اِنْفِصامَ لَها",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "قصه ی عشق را پایانی نیست...بلکه آن چه پایان می یابد، زبان است که از گفتن باز می ماند"
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "فُصِمَت ها هُنا لسانَ القال",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "ما لِسَلمی و من بِذی سَلَمٍ",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "سلمی (معشوق) و سلماییان (اهل و اهالی قبیله اش) را چه شد؟ آن همسایگانمان کجاهستند و به چه حالی هستند؟\u00A0"
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "أینَ جِیرانُنا و کَیفَ الْحال",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "عَفَتِ الدارُ بَعدَ عافیةٍ",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به دنبال روزهایی که خانه در حال آسایش بود، حال آن را از نشانه‌های باقی‌مانده‌اش بپرسید."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "فَاسألوا حالَها عَنِ الاَطْلال",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "فی جَمالِ الکمالِ نِلتَ مُنی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "در جمال\u00A0ِ کمال به آرزویت رسیده ای(در اوج هستی) ... خدا تو را ببخشد (در محاوره روزمره برای فرزندان می گوییم: خدا به تون ببخشه) ای عین کمال!\u00A0"
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "صَرَّفَ اللهُ عَنکَ عَینَ کمال",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "یا بَریدَ الْحِمی حَماکَ الله",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "ای نامه بر دوست، خدا حفظت کند ... مرحبا ... مرحبا، بیا ... بیا"
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "مرحباً مرحباً تَعال تَعال",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "عرصهٔ بزمگاه خالی ماند",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: محل جشن و میگساری از مهمانان خالی ماند و جام پر از نوشیدنی بی‌کس ماند."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "از حریفان و جامِ مالامال",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "سایه افکند حالیا شبِ هجر",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در حال حاضر، شب غم و جدایی بر همه جا سایه افکنده است و باید دید که خواب و خیال چه بازتابی از این وضعیت خواهند داشت."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "تا چه بازَند شبرُوانِ خیال",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "تُرکِ ما سویِ کَس نمی‌نِگرد",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ما به هیچ‌کسی غیر از خود نمی‌نگریم؛ آه از این بزرگی و مقام و عظمت!"
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "آه از این کبریا و جاه و جلال",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "حافظا عشق و صابری تا چند؟",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای حافظ، تا کی باید در عشق و صبر باقی بمانیم؟ ناله و گریهٔ عاشقان خوشایند است، پس بگذار ناله کنیم."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "نالهٔ عاشقان خوش است، بِنال",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    }
  ],
