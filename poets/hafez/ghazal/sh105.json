  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "صوفی ار باده به اندازه خورَد نوشش باد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر صوفی در خوردن باده، میانه‌روی کند، نوشیدنش مبارک باشد؛ وگرنه بهتر است که به فکر این کار نباشد."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "ور نه اندیشهٔ این کار فراموشش باد",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "آن که یک جرعه مِی از دست توانَد دادن",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر کس بتواند یک جرعه شراب را به کسی بدهد، خوشا به حالش که در آغوش معشوق خود باشد."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "دست با شاهدِ مقصود در آغوشش باد",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "پیرِ ما گفت خطا بر قلم صُنع نرفت",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "پیر ما فرمود که هیچ اشتباهی در ساخت و آفرینش رخ نمی‌دهد و باید به نظر پاک و خطا پوشاننده او آفرین گفت."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "آفرین بر نظرِ پاکِ خطاپوشَش باد",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "شاهِ تُرکان، سخنِ مدعیان می‌شِنَوَد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: سلطان ترک به سخنان مدعیان گوش می‌دهد، امیدوارم که از ظلمی که بر سیاوش رفته است، شرمسار باشد."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "شرمی از مَظلَمِهٔ خونِ سیاوشش باد",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "گر چه از کِبر، سخن با منِ درویش نگفت",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "اگرچه از غرور با من بیچاره حرف نزد؛ جانم فدای لب‌های شیرین و تنگ و ساکت او بادا!"
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "جان فدایِ شِکَرین‌پستهٔ خاموشش باد",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "چشمم از آینه‌دارانِ خط و خالش گشت",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "چشمم به آینه‌داری او رسید امیدوارم لبم نیز به بوسه‌ربایی بر و دوش او برسد."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "لبم از بوسه‌رُبایانِ بَر و دوشش باد",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "نرگسِ مست نوازش‌کُنِ مردم‌دارَش",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "چشم خمار و مهربانش؛ اگر خون عاشق را بریزد و بنوشد نوشش بادا!"
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "خونِ عاشق به قدح گر بِخورد نوشش باد",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "به غلامیِ تو مشهورِ جهان شد حافظ",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "حافظ از بندگی تو و در بندگی تو در جهان معروف شد؛ همیشه او، عاشق زلفت بادا!"
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "حلقهٔ بندگیِ زلفِ تو در گوشش باد",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    }
  ],
