  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "خدا را کم نشین با خرقه پوشان",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "تو را به خدا قسم میدهم که با افراد با اسم و رسم و مقام کمتر نشست و برخاست کن و چهره ات را از مستمندان و رندان پوشیده نگاه ندار"
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "رخ از رندان بی‌سامان مپوشان",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "در این خرقه بسی آلودگی هست",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "در لباس مقام بسیار زشتی ها نهفته است, خوشا به حال کسانی که مقامشان می فروشی ست"
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "خوشا وقت قبای می فروشان",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "در این صوفی‌وشان دَردی ندیدم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در میان صوفیان، هیچ دردی ندیدم که مانند درد شادمانی خمارترها و کسانی که نوشیدنی می‌نوشند، خالص باشد."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "که صافی باد عیش دُردنوشان",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "تو نازک‌طبعی و طاقت نیاری",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تو انسان حساسی هستی و نمی‌توانی بار سنگین دلفریب‌های افرادی که فقط ظاهری فریبنده دارند را تحمل کنی."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "گرانی‌های مشتی دلق‌پوشان",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "چو مستم کرده‌ای مستور منشین",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: وقتی مرا مست کرده‌ای، خودت کم‌نمایان باش و مخفی بمان. چون به من شراب نوشانده‌ای، زهر را به من نده."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "چو نوشم داده‌ای زهرم منوشان",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "بیا وز غَبْن این سالوسیان بین",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بیا و ببین که چگونه این سالوس‌پیشگان (دوچهرگان) از ما کلاه‌برداری کرده‌اند، در حالی که در دست یکی صراحی (جام) پر از خون دل و در دست دیگری بربطی (ساز) در حال نواختن است."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "صُراحی خون‌دل و بربط خروشان",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "ز دلگرمی حافظ بر حذر باش",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: حافظ از دلگرمی و دوستی خود بر حذر می‌کند و می‌گوید که ممکن است این محبت پنهان و عمیق در سینه‌اش مانند دیگ جوشان، در لحظه‌ای به خروش و ناآرامی تبدیل شود."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "که دارد سینه‌ای چون دیگ جوشان",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    }
  ],
