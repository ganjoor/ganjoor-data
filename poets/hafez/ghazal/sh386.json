  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "خدا را کم نشین با خرقه پوشان",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "تو را به خدا قسم میدهم که با افراد با اسم و رسم و مقام کمتر نشست و برخاست کن و چهره ات را از مستمندان و رندان پوشیده نگاه ندار"
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "رخ از رندان بی‌سامان مپوشان",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "در این خرقه بسی آلودگی هست",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "در لباس مقام بسیار زشتی ها نهفته است, خوشا به حال کسانی که مقامشان می فروشی ست"
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "خوشا وقت قبای می فروشان",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "در این صوفی‌وشان دَردی ندیدم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در این مردم صوفی‌نما، دردی ندیدم که پاک‌کننده لذت برای دردآوران باشد."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "که صافی باد عیش دُردنوشان",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "تو نازک‌طبعی و طاقت نیاری",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تو دل-sensitive هستی و نمی‌توانی بار سنگین رفتارهای عده‌ای ظاهرنما را تحمل کنی."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "گرانی‌های مشتی دلق‌پوشان",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "چو مستم کرده‌ای مستور منشین",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: وقتی تو مرا مست کرده‌ای، لطفاً زندگی‌ام را پنهان نکن. زمانی که زهر را به من می‌دهی، نگذار که از آن بنوشم."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "چو نوشم داده‌ای زهرم منوشان",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "بیا وز غَبْن این سالوسیان بین",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بیایید و از این فریب‌کاری سالوس‌ها آگاه شویم، جایی که ظرفی پر از خون دل و یک ساز شاداب را می‌بینیم."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "صُراحی خون‌دل و بربط خروشان",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "ز دلگرمی حافظ بر حذر باش",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به احساسات و عواطف حافظ توجه کن، زیرا او در درون خود احساسی پرآشوب و طوفانی دارد."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "که دارد سینه‌ای چون دیگ جوشان",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    }
  ],
