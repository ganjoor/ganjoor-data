  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "از دیده خونِ دل همه بر رویِ ما رَوَد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از چشمان من غم و اندوهی به سوی شما می‌ریزد و من نمی‌دانم از این غمچه چیزهایی بر سر شما می‌آید."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "بر رویِ ما ز دیده چه گویم چه‌ها رَوَد",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ما در درونِ سینه هوایی نهفته‌ایم",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در درون سینه‌ ما آرزویی وجود دارد که اگر دل ما بر اثر آن آرزو به پرواز درآید، قطعاً آن آرزو نیز به باد خواهد رفت."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "بر باد اگر رَوَد دلِ ما زان هوا رود",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "خورشیدِ خاوری کُنَد از رَشک جامه چاک",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر ماه محبوب من از پیش من برود، خورشید شرقی به خاطر حسادت، لباسی پاره خواهد کرد."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "گر ماهِ مِهرپرورِ من در قبا رود",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "بر خاکِ راهِ یار نهادیم رویِ خویش",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ما صورت خود را بر خاکِ مسیر یار گذاشتیم و اگر معشوقِ ما قدم بگذارد و ما را ببیند، حق دارد که بر روی ما نظر کند."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "بر رویِ ما رواست اگر آشنا رود",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "سیل است آبِ دیده و هر کس که بگذرد",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اشک و گریه مانند سیلی است که از چشمانم جاری می‌شود و هر کسی که از این مسیر عبور کند، حتی اگر دلش از سنگ باشد، تحت تأثیر قرار گرفته و دچار تغییر می‌شود."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "گر خود دلش ز سنگ بُوَد هم ز جا رود",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "ما را به آبِ دیده شب و روز ماجراست",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ما هر شب و روز در حال گریه و اندوه هستیم، زیرا کسی که به سر کوی او می‌رسد، ما را به یاد می‌آورد و باعث می‌شود که به خاطر او اشک بریزیم."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "زان رهگذر که بر سرِ کویش چرا رود",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "حافظ به کوی میکده دایم به صدقِ دل",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: حافظ به کوی میکده می‌گوید که همیشه با خلوص نیت مانند صوفیان با صفا به آنجا می‌رود."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "چون صوفیانِ صومعه دار از صفا رود",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    }
  ],
