  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "درآ که در دلِ خسته، توان درآید باز",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "بیا تا در دل دردمند من، زنده شود بیا تا تن مرده من دوباره جان بیابد"
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "بیا که در تنِ مُرده، رَوان درآید باز",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "بیا که فُرقَتِ تو، چشمِ من چنان در بست",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "بیا که دوری تو چنان چشمانم را بست که امید گشایش فقط در وصال دوباره توست."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "که فتحِ بابِ وصالت مگر گشاید باز",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "غمی که چون سپهِ زنگ، مُلکِ دل بگرفت",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "غمی که چون سیاهی، دل را فراگرفته‌است و آن را روی روشن تو دوباره نورانی کند."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "ز خیلِ شادیِ رومِ رُخَت زُدایَد باز",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "به پیشِ آینهٔ دل هر آن چه می‌دارم",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هر چه به دلم می‌نمایم بجز خیال روی زیبای تو را نمی‌خواهد."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "به جز خیالِ جمالت، نمی‌نماید باز",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "بدان مَثَل که شب آبستن است روز از تو",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "مانند آن مثل که گفته‌اند که شب آبستن حوادث روز بعد است شب‌ها بیدار می‌مانم و ستارگان را می‌شمارم تا روز بعد چه شود."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "ستاره می‌شِمُرَم تا که شب چه زاید باز",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "بیا که بلبلِ مطبوعِ خاطرِ حافظ",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "بیا که بلبل طبع حافظ به آرزوی دیدن گلبن وصال تو شعر می‌سراید."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "به بویِ گُلبُنِ وصلِ تو می‌سُراید باز",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    }
  ],
