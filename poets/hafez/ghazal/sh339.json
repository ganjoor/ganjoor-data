  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "خیالِ رویِ تو چون بُگذَرَد به گلشنِ چَشم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چهرهٔ تو وقتی که در خیال بیفتد، باعث می‌شود که دل، به دنبال دیدن تو، به سمت آن روزن که جایی برای دیدن است، برود."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "دل از پِیِ نظر آید به سویِ روزنِ چَشم",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "سزایِ تکیه گَهَت مَنظَری نمی‌بینم",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: برای آنکه در تکیه‌گاه تو، مناظر زیبایی وجود داشته باشد، من چیزی نمی‌بینم. من از این دنیا و این گوشهٔ مشخص چشمانم دورم."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "منم ز عالَم و این گوشهٔ مُعَیَّنِ چَشم",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "بیا که لَعل و گُهَر در نثارِ مَقْدَمِ تو",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بیا تا گوهری چون لعل و مروارید را به پای تو افشا کنم، زیرا برای تو از گنجینهٔ دل، به چشمانم نگاه می‌کنم."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "ز گنج‌خانه‌‌ دل می‌کشم به روزنِ چَشم",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "سَحَر سِرِشکِ رَوانم سرِ خرابی داشت",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: وقت سحر، اشک‌های روان من به خاطر خیانت و آسیب دیدن قلبم از عشق تو، دلیلی برای بی‌حالی و خرابی داشت؛ اگر چه اگر خون جگر من گرفته می‌شد، دامن چشمانم را نمی‌آلود."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "گَرَم نه خونِ جگر می‌گرفت دامنِ چَشم",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "نخست روز که دیدم رخِ تو دل می‌گفت",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در نخستین روزی که چهرهٔ تو را دیدم، قلبم می‌گفت که اگر مانع یا مشکلی پیش بیاید، خونم بر گردن چشمانم خواهد بود."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "اگر رسَد خلَلی، خونِ من به گردنِ چَشم",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "به بویِ مژدهٔ وصلِ تو تا سَحَر، شبِ دوش",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به خاطر بوی خوش خبر وصل تو تا صبحگاه، دیشب چراغ چشمانم را به سوی باد روشن گذاشتم."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "به راهِ باد نهادم چراغِ روشنِ چَشم",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "به مردمی که دلِ دردمندِ حافظ را",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به آن کسانی که دلِ پر درد حافظ را نزنند و با سختی‌های عشق بی‌رحمی نکنند، بگویید به چشمان دیگران آزار نرسانند."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "مَزَن به ناوَکِ دلدوزِ مردم افکنِ چَشم",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    }
  ],
