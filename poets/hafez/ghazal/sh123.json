  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "مطربِ عشق عجب ساز و نوایی دارد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "مطرب عشق‌، عجب خوش‌صدا و خنیاگر ماهری است که هر آهنگ که می‌زند به‌جایی راه دارد."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "نقشِ هر نغمه که زد راه به جایی دارد",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "عالَم از نالهٔ عُشّاق مبادا خالی",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "(آرزو دارم) دنیا از عاشقان خالی نشود زیرا دنیا با عاشقان خوش و فرح‌بخش است."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "که خوش‌آهنگ و فرح‌بخش هوایی دارد",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "پیر دُردی‌کَش ما گرچه ندارد زر و زور",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "پیر و مرشد دائم‌الخمر ما اگرچه پول و مقام ندارد اما خدایی خطاپوش و بخشنده دارد."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "خوش عطابخش و خطاپوش خدایی دارد",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "محترم دار دلم کاین مگسِ قندپَرست",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "دل مرا گرامی بدار زیرا اگرچه یک مگس است که به‌هوای قند تو آمده‌، اما در اثر این عشق‌، همچون هما باشکوه گشته‌است."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "تا هواخواهِ تو شد فَرِّ هُمایی دارد",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "از عدالت نَبُوَد دور گَرَش پُرسد حال",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "اگر پادشاهی از همسایه گدای خود حالی بپرسد، از عدالتش دور نیست."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "پادشاهی که به همسایه گدایی دارد",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "اشکِ خونین بنمودم به طبیبان گفتند",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "اشک خونین خود را به پزشکان نشان دادم؛ گفتند: درد عاشقی است و دوای آن بسیار جگرسوز و دردآور است."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "دردِ عشق است و جگرسوز دوایی دارد",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "ستم از غمزه میاموز که در مذهبِ عشق",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "راه ستم غمزه را در پیش مگیر که هر کار خوب پاداشی و هر کرده بد مجازاتی دارد."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "هر عمل اجری و هر کرده جزایی دارد",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "نغز گفت آن بتِ ترسابچهٔ باده‌پرست",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "چه زیبا گفت آن زیباروی ترسازاده باده‌پرست وقتی‌که گفت: به‌شادی روی آدم‌های باصفا بنوش!"
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "شادیِ رویِ کسی خور که صفایی دارد",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "خسروا حافظ درگاه‌نشین فاتحه خواند",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "پادشاها! حافظ درگاه‌نشین تو فاتحه خواند و از زبان تو دعای خیری طلب می‌کند."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "وز زبان تو تمنای دعایی دارد",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    }
  ],
