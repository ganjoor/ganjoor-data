  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "آن کس که به دست جام دارد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هر کس که مست است و باده می‌نوشد‌، سلطانی و شاهی جمشید را همیشگی دارد."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "سلطانیِ جَم مُدام دارد",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "آبی که خِضِر حیات از او یافت",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "آن آب حیات که خضر از او زندگی جاودانه یافت را در می‌کده جستجو کن و آنرا از پیاله شراب بخواه."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "در میکده جو‌ که جام دارد",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "سررشتهٔ جان به جام بگذار",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "کار و سر رشته جان را به می و باده بگذار زیرا جان بر مستی قوام یافته و از او آفریده شده است."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "کاین رشته از او نظام دارد",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "ما و مِی و زاهدان و تقوا",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "قسمت ما می و باده شده است و قسمت زاهدها‌، تقوا و پرهیزگاری تا میل و انتخاب یار کدام باشد."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "تا یار، سرِ کدام دارد",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "بیرون ز لبِ تو ساقیا نیست",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هر کس که مست است و خوش و شاد گشته است بجز از مستی و کرامت لب‌های تو نیست ای ساقی."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "در دور، کسی که کام دارد",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "نرگس، همه شیوه‌های مستی",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "گل نرگس و چشم‌های مست همگی یک گوشه و کرشمه از چشم‌های زیبای تو را به قرض گرفته‌اند."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "از چشمِ خوشت به وام دارد",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "ذکرِ رخ و زلف تو دلم را",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "وصف رخ زیبا\u00A0 و موی سیاه تو ورد زبان دل من است و دلم هر سپیده‌دم و شامگاه به یاد توست."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "وردی‌ست که صبح و شام دارد",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "بر سینهٔ ریشِ دردمندان",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "آن لب‌های سرخ تو هر دم دل عاشقان و دردمندان را بیشتر می‌سوزاند."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "لعلت نمکی تمام دارد",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "در چاهِ ذَقَن چو حافظ ای جان",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "زیبایی تو در یک قلم و فقط دویست غلام و چاکر همچون حافظ کشته‌مرده زیبایی چاه چانه دارد."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "حُسنِ تو دو صد غلام دارد",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    }
  ],
