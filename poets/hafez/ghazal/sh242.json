  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "بیا که رایتِ منصورِ پادشاه رسید",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بیا که پرچم پادشاه منصور به اهتزاز درآمد و خبر پیروزی و خوشحالی به آفتاب و ماه رسید."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "نویدِ فتح و بشارت به مِهر و ماه رسید",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "جمالِ بخت ز رویِ ظفر نقاب انداخت",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: خوشبختی با ظاهری زیبا از پیروزی پرده‌برداری کرد و کمالِ عدالت به کمکِ دادخواهی آمد."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "کمالِ عدل به فریادِ دادخواه رسید",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "سپهر، دور خوش اکنون کُنَد که ماه آمد",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "گردش آسمان، از آمدن ماه سامان گرفت و اکنون جهان از رسیدن شاه،\u00A0به کام دل\u00A0می‌رسد."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "جهان به کامِ دل اکنون رسد که شاه رسید",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "ز قاطعانِ طریق این زمان شوند ایمن",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "مژده دهید که اکنون قافله‌های دل و دانش، از راهزنان در امان خواهند بود."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "قوافلِ دل و دانش که مَرد راه رسید",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "عزیزِ مصر به رغمِ برادران غیور",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "عزیز مصر، با وجود تعصب برادران، از ته چاه بیرون آمد و به اوج بزرگی دست یافت."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "ز قعرِ چاه برآمد به اوجِ ماه رسید",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "کجاست صوفیِ دَجّال فِعلِ مُلحِدشکل",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "کجاست آن صوفیِ دجّال رفتارِ بی دین که به او بگویید بسوزد، چون مهدی دین‌پناه آمد."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "بگو بسوز، که مهدیِّ دین پناه رسید",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "صبا بگو که چه‌ها بر سرم در این غمِ عشق",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "صبا بگو که در این غم عشق، از آتش دل سوزان و دود آهم چه‌ها به سرم آمد."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "ز آتشِ دلِ سوزان و دودِ آه رسید",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "ز شوقِ رویِ تو شاها بدین اسیرِ فراق",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "شاها! از شوق روی تو بر این اسیر جدایی، همان آمد که آتش به [خرمن] کاه افتاده باشد."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "همان رسید کز آتش به برگِ کاه رسید",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "مرو به خواب که حافظ به بارگاهِ قبول",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "به خواب نرو، زیرا حافظ با نیایش نیمه‌شب و درس صبحگاه در درگاه پذیرفته شد."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "ز وِردِ نیمْ شب و درسِ صبحگاه رسید",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    }
  ],
