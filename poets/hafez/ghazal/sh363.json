  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "دَردَم از یار است و درمان نیز هم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: درد من از طرف محبوبم است و در عین حال، درمان نیز به دست اوست. دل و جانم را به خاطر او فدای او کرده‌ام."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "دل فدایِ او شد و جان نیز هم",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "این که می‌گویند آن خوشتر ز حسن",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آنچه گفته می‌شود که زیبایی معشوق ما از هر چیز دیگر بهتر است، در واقع این زیبایی ویژگی‌های خاص خودش را دارد و چیزهای دیگری نیز در آن وجود دارد."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "یار ما این دارد و آن نیز هم",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "یاد باد آن کاو به قصدِ خونِ ما",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: یاد آن کسی بخیر که به خاطر خون ما، عهد و پیمان را زیر پا گذاشت."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "عهد را بشکست و پیمان نیز هم",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "دوستان در پرده می‌گویم سخن",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دوستان، در خفا و به آرامی صحبت می‌کنم، چون این سخن به گوش دیگران هم خواهد رسید."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "گفته خواهد شد به دَستان نیز هم",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "چون سر آمد دولتِ شب‌هایِ وصل",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: وقتی دوره‌ی شب‌های وصال به پایان برسد، روزهای جدایی نیز به سر خواهد آمد."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "بگذرد ایامِ هِجران نیز هم",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "هر دو عالم یک فروغِ رویِ اوست",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر دو جهان، روشنایی و جلوه‌ای از روی او هستند. به تو گفتم که این روشنایی هم در آشکار و هم در نهان وجود دارد."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "گفتمت پیدا و پنهان نیز هم",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "اعتمادی نیست بر کارِ جهان",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به زندگی و کارهای دنیا نمی‌توان اعتماد کرد، حتی به چرخش زمان نیز نمی‌توان اتکا کرد."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "بلکه بر گردونِ گَردان نیز هم",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "عاشق از قاضی نترسد مِی بیار",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "\u00A0ساقی، شراب بیاور که عاشق نه تنها از قاضی نمی‌ترسد بلکه از بازپرس محکمه هم باکی ندارد"
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "بلکه از یَرغویِ دیوان نیز هم",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "محتسب داند که حافظ عاشق است",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دستگاه قضاوت، مطمئن است که حافظ در عشق غرق است، و آصف که مقام و ثروت سلیمان را دارد نیز به همین حال است."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "و آصفِ مُلکِ سلیمان نیز هم",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    }
  ],
