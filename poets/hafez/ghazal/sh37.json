  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "بیا که قصرِ اَمَل سخت سست‌بنیادست",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "(ساقی) بیا که کاخ آرزوهای ما سست و بی‌بنیاد است؛ باده بریز که عمر ما به‌سرعت باد می‌گذرد."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "بیار باده که بنیادِ عمر بر بادست",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "غلامِ همّتِ آنم که زیرِ چرخِ کبود",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "بنده آزادگی و همّت کسی هستم که از هر تعلّق و وابستگی رهاست."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "ز هر چه رنگِ تعلّق پذیرد آزادست",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "چه گویمت که به میخانه دوش مست و خراب",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "زبانم نمی‌تواند شرح دهد که دیشب در میخانه و در حال مستی، چه مژده‌هایی از سروش عالم غیب شنیده‌ام."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "سروشِ عالَمِ غیبم چه مژده‌ها دادست",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "که ای بلندنظر شاهبازِ سِدره‌نشین",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "(به من گفت) ای شاهباز بلند‌پرواز! جای تو این ویرانه و محنت‌کده نیست؛ جای تو بر اوج درخت سدره است. (سدره یعنی درخت بهشتی که بالای آسمان هفتم قرار دارد)"
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "نشیمن تو نه این کُنجِ محنت‌آبادست",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "تو را ز کنگرهٔ عرش می‌زنند صفیر",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "تو را از عرش والا، دعوت می‌کنند، شان و جای تو آنجاست؛ چرا در این جای پرخطر گرفتار شده‌ای؟"
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "ندانمت که در این دامگه چه افتادست",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "نصیحتی کنمت یاد گیر و در عمل آر",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "پندی ارزشمند را از من بشنو و بدان عمل کن؛ که آن‌را از پیر طریقت آموخته‌ام"
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "که این حدیث، ز پیرِ طریقتم یادست",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "غمِ جهان مخور و پندِ من مَبَر از یاد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "غم دنیا را مخور و این پند را فراموش مکن که این نکته عشق را از رهروی به‌یاد دارم"
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "که این لطیفهٔ عشقم ز رهروی یادست",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "رضا به داده بده وز جبین گره بگشای",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "به هرچه داری قناعت کن و شاد باش؛ که درِ اختیار بر ما گشوده نیست."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "که بر من و تو دَرِ اختیار نگشادست",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "مجو درستیِ عهد از جهانِ سست‌نهاد",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "به وفای جهان سست‌بنیاد اعتماد مکن؛ که این پیرزن زشت هزار شوهر است."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "که این عجوز، عروسِ هزاردامادست",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "نشان عهد و وفا نیست در تبسّمِ گل",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "در لبخند گل نشانی از عهد و وفا نمی‌بینم؛ ای بلبل‌، فغان برآور که جای فریاد و فغان است."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "بنال بلبل بی‌دل که جای فریادست",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "حسد چه می‌بری ای سست‌نظم بر حافظ؟",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "CoupletSummary": "چت جی پی تی: در این بیت، حافظ به حسودانی که بر او رشک می‌برند، می‌گوید که استعداد شاعری و مقبولیت سخن او، موهبتی الهی است و حسادت بر این نعمت بی‌ثمر است."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "قبولِ خاطر و لطفِ سخن خدادادست",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    }
  ],
