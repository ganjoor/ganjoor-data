  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "گر تیغ بارد در کوی آن ماه",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "اگر در کوی آن زیبارو شمشیر ببارد ما گردن بر سر راه آن می‌گذاریم و از آنجا نمی‌رویم تا خدا چه بخواهد."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "گردن نهادیم الحکمُ لِلّه",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "آیین تقوا ما نیز دانیم",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "ما هم از اصول تقوا باخبر هستیم، اما چه کنیم با تقدیر"
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "لیکن چه چاره با بخت گمراه؟\u00A0",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "ما شیخ و واعظ کمتر شناسیم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "ما آخوندها و شیخها را نمی‌شناسیم، اگر می‌خواهی با ما همصحبت شوی از شراب صحبت کن یا هیچ حرفی نزن."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "یا جام باده یا قصه کوتاه",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "من رند و عاشق در موسم گل",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "به من رند و عاشق می‌گویی که وقت بهار و موسم گل توبه کنم؟! دهانت را آب بکش! برای معنی دوم سوالی نمی‌خوانیم: من در بهاران رند و عاشق هستم (می‌شوم) و آن گاه که بهاران تمام می‌شود توبه میکنم و از خدا طلب آمرزش می‌کنم. یعنی من در وقت خوب و مناسب عشق و حال خودم را می‌کنم و بعد که شرایط عوض شد، زاهدانه توبه می‌کنم\u00A0"
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "آن گاه توبه، استغفرالله",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "مهر تو عکسی بر ما نیفکند",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای معشوقی که رویت چون آینه روشن است، مهر و محبت تو هیچ پرتوی بر ما نینداخت؛ افسوس از دل سخت و بی‌مهر تو."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "آیینه‌رویا! آه از دلت آه",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "اَلصَبرُ مُرٌّ و العُمرُ فانٍ",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: صبر تلخ است و عمر گذرا و نابودشدنی؛ ای کاش می‌دانستم تا کی باید در انتظار دیدار او بمانم."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "یا لَیتَ شِعري حَتّامَ أَلْقاه",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "حافظ چه نالی گر وصل خواهی",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "حافظ! چرا آه و ناله می‌کنی؟ اگر می‌خواهی به آن که عاشقش هستی برسی باید وقت و بی‌وقت زخم بخوری و رنج بکشی. آه و ناله ندارد."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "خون بایدت خورد در گاه و بی‌گاه",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    }
  ],
