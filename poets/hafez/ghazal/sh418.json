  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "گر تیغ بارد در کوی آن ماه",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "اگر در کوی آن زیبارو شمشیر ببارد ما گردن بر سر راه آن می‌گذاریم و از آنجا نمی‌رویم تا خدا چه بخواهد."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "گردن نهادیم الحکمُ لِلّه",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "آیین تقوا ما نیز دانیم",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "ما هم از اصول تقوا باخبر هستیم، اما چه کنیم با تقدیر"
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "لیکن چه چاره با بخت گمراه؟\u00A0",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "ما شیخ و واعظ کمتر شناسیم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "ما آخوندها و شیخها را نمی‌شناسیم، اگر می‌خواهی با ما همصحبت شوی از شراب صحبت کن یا هیچ حرفی نزن."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "یا جام باده یا قصه کوتاه",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "من رند و عاشق در موسم گل",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "به من رند و عاشق می‌گویی که وقت بهار و موسم گل توبه کنم؟! دهانت را آب بکش!"
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "آن گاه توبه؟ استغفرالله",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "مهر تو عکسی بر ما نیفکند",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: عشق و محبت تو هیچ اثری بر ما نداشته، ای کسی که مانند آینه زیبا هستی! آه از دل خودم، آه!"
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "آیینه‌رویا! آه از دلت آه",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "اَلصَبرُ مُرٌّ و العُمرُ فانٍ",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: صبر، تلخ و دردناک است و عمر نیز به زودی پایان می‌پذیرد. کاش می‌دانستم تا چه زمانی باید به این وضعیت ادامه دهم."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "یا لَیتَ شِعري حَتّامَ أَلْقاه",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "حافظ چه نالی گر وصل خواهی؟",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "حافظ! چرا آه و ناله می‌کنی؟ اگر می‌خواهی به آن که عاشقش هستی برسی باید وقت و بی‌وقت زخم بخوری و رنج بکشی. آه و ناله ندارد."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "خون بایدت خورد در گاه و بی‌گاه",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    }
  ],
