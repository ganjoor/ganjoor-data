  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "زبانِ خامه ندارد سرِ بیان فِراق",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: خامه (قلم) زبان ندارد تا بتواند درد و جدایی را بیان کند، و اگر داشت، داستان فراق را با تو بازگو می‌کردم."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "وگرنه شرح دهم با تو داستانِ فِراق",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "دریغ مدت عمرم که بر امیدِ وصال",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "آه و افسوس از طول عمر من که آن را به امید وصال و رسیدن به دوست، طی کردم و به سر رسید اما زمان جدایی و فراق به پایان نرسید."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "به سر رسید و نیامد به سر زمانِ فِراق",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "سری که بر سرِ گردون به فخر می‌سودم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: سری که با افتخار بر گردونه هستی می‌چرخید، اکنون به خاطر جدایی و فراق در آستانه‌ای ناامید و افسرده قرار گرفته است."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "به راستان که نهادم، بر آستانِ فِراق",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "چگونه باز کنم بال در هوایِ وصال",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چگونه می‌توانم در هوای دیدار عاشقانه پرواز کنم وقتی که دلِ من در آغوش جدایی، بال و پرش را از دست داده است."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "که ریخت مرغِ دلم پَر در آشیانِ فِراق",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "کنون چه چاره که در بَحرِ غم به گردابی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اکنون چه باید کرد وقتی که در دریای غم گرفتار شدم و کشتی صبرم به خاطر جدایی خراب شده است؟"
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "فُتاد زورقِ صبرم ز بادبانِ فِراق",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "بسی نَمانْد که کَشتیِ عمر غرقه شود",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: مدت زیادی باقی نمانده که زندگی انسان به دلیل شدت احساسات و اشتیاق به تو، دچار غرق شدگی شود در دریای بی‌پایان جدایی."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "ز موجِ شوقِ تو در بحرِ بی‌کرانِ فِراق",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "اگر به دستِ من اُفتَد فِراق را بِکُشَم",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر فراق به دست من بیفتد، آن را نابود می‌کنم، زیرا روز جدایی، سیاه و سخت است و باعث از هم پاشیدگی زندگی و آرامش می‌شود."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "که روزِ هجر سیَه باد و خان و مانِ فِراق",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "رفیقِ خِیلِ خیالیم و همنشینِ شَکیب",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من دوست و همراه خیال هستم و در کنار صبر قرار دارم. هم‌پیمان آتش جدایی و هم‌نشین دوری هستم."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "قَرینِ آتشِ هجران و هم قِرانِ فِراق",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "چگونه دَعویِ وصلت کُنَم به جان؟ که شده‌ست",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چطور می‌توانم ادعای وصل و نزدیکی به تو را داشته باشم، در حالی که وجودم تحت قضا و تقدیر قرار گرفته و قلبم در حال جدایی است؟"
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "تنم وکیلِ قَضا و دلم ضمانِ فِراق",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "ز سوزِ شوق دلم شد کباب دور از یار",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دل من از شدت شوق به عشق، مانند کبابی در آتش می‌سوزد. به دور از یارم همیشه در رنج و عذاب هستم و از غم فراق او خون جگر می‌خورم."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "مدام خونِ جگر می‌خورم ز خوانِ فِراق",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "فلک چو دید سرم را اسیرِ چَنبَرِ عشق",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: وقتی آسمان دید که من به عشق گرفتار شده‌ام، گردن صبرم را به بند فراق کشید."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "بِبَست گردنِ صبرم به ریسمانِ فِراق",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "به پایِ شوق گر این رَه به سر شدی حافظ",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر به خاطر شوق و علاقه‌ام به این مسیر پایان دادی، حافظ، هیچ‌کس را در جدایی به دست غم و فراق نخواهی سپرد."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "به دستِ هجر ندادی کسی عِنانِ فِراق",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    }
