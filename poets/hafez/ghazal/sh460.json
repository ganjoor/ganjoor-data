  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "سُلَیمیٰ مُنذُ حَلَّت بِالْعراقِ",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از هنگامی که سلیمی (معشوق) در عراق منزل گزیده است، از دوری او رنج و سختی بسیار می‌کشم که گفتنی نیست."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "أُلاقی مِن نَواها ما أُلاقی",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "الا ای ساروان منزل دوست",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای ساربانی که به منزل دوست می‌روی، اشتیاق من به کاروانیان شما (و همراهی با آنان) به درازا کشیده است."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "إِلی رُکبانِکُم طالَ اشْتیاقی",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "خِرَد در زنده‌رود انداز و می نوش",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: عقل و دوراندیشی را در زاینده‌رود بینداز و دور کن و با آواز خوش جوانان عراقی (اصفهانی) شراب بنوش."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "به گلبانگ جوانان عراقی",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "رَبیعُ العُمرِ فی مَرعیٰ حِماکُم",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بهار عمر من در چراگاه سرزمین حمایت‌شدهٔ شما گذشت؛ ای روزگار دیدار، خدا تو را نگه دارد."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "حَماکَ اللّهُ یا عَهدَ التَّلاقی",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "بیا ساقی بده رَطْل گرانم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "\u00A0بیا ای ساقی، به من می در پیاله ای بزرگ بده که دل سنگین و غمگینم را شاد کند. خداوند تو را از می خوشگوار سیراب کند."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "سَقاکَ اللّهُ مِن کَأسٍ دِهاقِ",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "جوانی باز می‌آرد به یادم",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: نوای چنگ و دست‌افشانی و رقص ساقی، روزگار جوانی را دوباره به یادم می‌آورد."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "سماع چنگ و دست افشان ساقی",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "می باقی بده تا مست و خوشدل",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: شراب باقی‌مانده را بده تا مست و شادمان، باقی عمرم را نثار یاران کنم."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "به یاران برفَشانم عمر باقی",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "درونم خون شد از نادیدن دوست",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از ندیدن دوست دلم خون شد؛ نابود و بدبخت باد روزهای جدایی."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "أَلا تَعْساً لِأیّامِ الفِراقِ",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "دُموعی بَعدَکُم لا تَحْقِروها",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اشک‌های مرا پس از دوری شما کوچک مشمارید، زیرا بسا دریای ژرفی که از جوی‌های کوچک پدید آمده است."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "فَکَم بحرٍ عَمیقٍ مِن سَواقِ",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "دمی با نیکخواهان متفق باش",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: لحظه‌ای با خیرخواهان همراه و همدل باش و فرصت‌های پیش‌آمده را غنیمت بشمار."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "غنیمت دان امور اتفاقی",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "بساز ای مطرب خوشخوان خوشگو",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای نوازندهٔ خوش‌آواز و خوش‌سخن، شعر فارسی را با آهنگ و مقام عراقی بنواز و بخوان."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "به شعر فارسی، صوت عراقی",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "عروسی بس خوشی ای دختر رَز",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای شراب (دختر تاک)، عروس بسیار خوشایندی هستی، اما گاهی سزاوار آنی که طلاقت داد و ترکت کرد."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "ولی گه گه سزاوار طلاقی",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "مسیحای مجرد را برازد",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تنها مسیحای وارسته و بی‌تعلق سزاوار است که با خورشید هم‌خانه شود؛ یعنی بی‌تعلقی شرط رسیدن به مقام بلند است."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "که با خورشید سازد هم‌وُثاقی",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "وصال دوستان روزی ما نیست",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: رسیدن به دوستان نصیب ما نیست؛ ای حافظ، غزل‌های جدایی بخوان."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "بخوان حافظ غزل‌های فراقی",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    }
  ],
