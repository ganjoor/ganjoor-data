  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "سُلَیمیٰ مُنذُ حَلَّت بِالْعراقِ",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: سلطانی که از زمانی که به عراق آمده، در هر نظر وی، جز غم و اندوه چیزی نمی‌بینم."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "أُلاقی مِن نَواها ما أُلاقی",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "الا ای ساروان منزل دوست",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای کاروان، به سوی منزل دوست بروید که اشتیاق من بسیار طولانی شده است."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "إِلی رُکبانِکُم طالَ اشْتیاقی",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "خِرَد در زنده‌رود انداز و می نوش",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: عقل را در رود زنده‌رود بینداز و می بنوش که صدای جوانان عراقی بلند است."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "به گلبانگ جوانان عراقی",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "رَبیعُ العُمرِ فی مَرعیٰ حِماکُم",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بهاری از زندگی در مرتع و سرزمین شما برقرار است. خداوند شما را حفظ کند، ای دوران دیدار."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "حَماکَ اللّهُ یا عَهدَ التَّلاقی",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "بیا ساقی بده رَطْل گرانم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "\u00A0بیا ای ساقی، به من می در پیاله ای بزرگ بده که دل سنگین و غمگینم را شاد کند. خداوند تو را از می خوشگوار سیراب کند."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "سَقاکَ اللّهُ مِن کَأسٍ دِهاقِ",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "جوانی باز می‌آرد به یادم",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: حالت جوانی و شادابی را در ذهنم زنده می‌کند و یادآور جشن و سرور با موسیقی چنگ و رقص و نواختهٔ ساقی است."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "سماع چنگ و دست افشان ساقی",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "می باقی بده تا مست و خوشدل",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: باقی‌ماندهٔ عمرم را با شراب پرکن تا بتوانم شاد و سرحال، خوشی‌هایم را با دوستانم تقسیم کنم."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "به یاران برفَشانم عمر باقی",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "درونم خون شد از نادیدن دوست",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از دیدن نکردن دوست، درونم پر از اندوه و خون شده است. ای کاش ایام جدایی و دوری از او لعنتی باشد."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "أَلا تَعْساً لِأیّامِ الفِراقِ",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "دُموعی بَعدَکُم لا تَحْقِروها",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: پس از رفتن شما، اشک‌هایتان را کوچک نشمارید، زیرا چه بسیار دریاهای عمیق به خاطرِ جویبارها به وجود می‌آیند."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "فَکَم بحرٍ عَمیقٍ مِن سَواقِ",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "دمی با نیکخواهان متفق باش",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: لحظه‌ای با نیک‌خواهان هم‌نظر و همراه باش و از این اتفاقات و لحظات ارزشمند استفاده کن، زیرا این موقعیت‌ها گران‌بها هستند."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "غنیمت دان امور اتفاقی",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "بساز ای مطرب خوشخوان خوشگو",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای مطرب خوشخوان و خوشگوی، به‌خاطر شعر فارسی، صدایی شاد و دلنشین بساز که شکوه و زیبایی موسیقی عراقی را به همراه داشته باشد."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "به شعر فارسی، صوت عراقی",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "عروسی بس خوشی ای دختر رَز",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای دختر توانمندی که در شادی و خوشی شبیه به عروسی، به گاهی هم ممکن است برای طلاق شایسته باشی."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "ولی گه گه سزاوار طلاقی",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "مسیحای مجرد را برازد",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: خداوند به تنهایی مانند مسیح (مسیحای مجرد) ستایش شده است و او را بخوانید تا با خورشید، که نماد روشنایی و حقیقت است، پیمان و دوستی برقرار کند."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "که با خورشید سازد هم‌وُثاقی",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "وصال دوستان روزی ما نیست",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دیدار دوستان به ما تقدیر نشده است، بنابراین حافظ را بخوان تا غزل‌های جدایی را بشنوی."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "بخوان حافظ غزل‌های فراقی",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    }
