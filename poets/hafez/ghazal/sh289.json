  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "مَجمَعِ خوبی و لطف است عِذار چو مَهَش",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چهره‌اش مانند ماه، جلوه‌ای از زیبایی و نیکی دارد، اما او مهری و وفایی در دل ندارد. خدایا، این دلبر را به من عطا کن."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "لیکَنَش مِهر و وفا نیست خدایا بِدَهَش",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "دلبرم شاهد و طفل است و به بازی روزی",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دلبر من که همچون یک شاهد زیبا و یک کودک بی‌تجربه است، روزی مرا با بازی خود به گریه می‌اندازد و در شرع (قوانین دینی) به خاطر این کارش گناهی از او نیست."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "بِکُشد زارم و در شرع نباشد گُنَهَش",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "من همان بِه که از او نیک نگه دارم دل",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من بهترم که دل را از او نگه‌دارم، زیرا او نه خوبی دیده و نه بدی و نمی‌داند چگونه نگاه کند."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "که بد و نیک ندیده‌ست و ندارد نِگَهَش",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "بویِ شیر از لبِ همچون شِکَرَش می‌آید",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بوی شیرین و خوش از لب‌های او به مشام می‌رسد، اما در عوض، اشک‌هایش مثل خون از چشمان سیاهش میریزد."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "گرچه خون می‌چکد از شیوهٔ چشمِ سیَهَش",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "چارده ساله بُتی چابُکِ شیرین دارم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من چهارده سال است که بتی زیبا و جذاب دارم که وجودش مانند جان برایم ارزشمند است و به او مثل حلقه‌ای به گوش، وابسته‌ام. این بت به مَهدی چاردَه‌اش، یعنی دختری با این سن و سال و زیبایی، تشبیه می‌شود."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "که به جان حلقه به گوش است مَهِ چاردَهَش",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "از پِی آن گُلِ نورُستِه دلِ ما یارب",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ما برای آن گلی که در نور است، دل‌مان را می‌سپاریم. ای کاش بدانیم که این دل‌باختگی کجا رفته و چرا در این مدت طولانی آن را ندیده‌ایم."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "خود کجا شد که ندیدیم در این چند گَهَش؟",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "یارِ دلدارِ من ار قلب بدین سان شِکَنَد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر دلبر من به این شکل قلب مرا بشکند، به زودی با زندگی خود،‌ پادشاهی را از آنِ خود خواهد کرد."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "بِبَرَد زود به جانداریِ خود پادشهَش",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "جان به شکرانه کنم صرف گَر آن دانهٔ دُر",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر دانهٔ گرانبهای وجود حافظ، درون صدف سینه‌اش به آرامش بیفتد، جان خود را به خاطر این شکرگزاری به کار خواهم گرفت."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "صدفِ سینهٔ حافظ بُوَد آرامگَهَش",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    }
  ],
