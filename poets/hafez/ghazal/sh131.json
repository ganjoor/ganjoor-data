  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "بیا که تُرکِ فلک خوانِ روزه غارت کرد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هشیار باش که روز جشن است و دست تقدیر‌، خوان و سفره روزه را برچید و هلال روز عید به‌ زبان حال‌، قدح باده را به تو نشان می‌دهد."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "هلالِ عید به دورِ قدح اشارت کرد",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ثوابِ روزه و حجِّ قبول آن کس بُرد",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "ثواب روزه و حج را کسی می‌برد که خاک میکده عشق را زیارت می‌کند. (میکده در شعر حافظ، محل دوری از خودپرستی و رها شدن از خود و دوری از ریا است.)"
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "که خاکِ میکدهٔ عشق را زیارت کرد",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "مُقامِ اصلیِ ما گوشهٔ خرابات است",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "جای و جایگاه اصلی و سزاوار ما گوشه میکده و خرابات است خدا خیرش دهاد کسی را که این بنا و عمارت را ساخت. (کرد‌‌: ساخت)"
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "خداش خیر دهاد آن که این عمارت کرد",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "بهایِ بادهٔ چون لعل چیست؟ جوهرِ عقل",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "بهای باده ناب و لعل‌گون را چطور و با چه باید پرداخت؟ با جوهر عقل. کسی که این معامله را انجام داد‌، سود بُرد."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "بیا که سود کسی بُرد، کاین تجارت کرد",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "نماز در خَمِ آن ابروانِ محرابی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "کسی می‌تواند در خم و طاق محراب آن ابروان کمانی نماز کند که با خون جگر طهارت کرد."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "کسی کُنَد که به خونِ جگر طهارت کرد",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "فغان که نرگس جَمّاشِ شیخِ شهر امروز",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "فریاد از دست چشمان فضول شیخ و زاهد شهر که امروز با دیده مذمت و حقارت به دُردکشان و می‌گساران نگاه‌کرد."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "نظر به دُردکشان از سرِ حقارت کرد",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "به رویِ یار نظر کن ز دیده مِنّت دار",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "به روی یار نگاه کن و از دیده و روی یار ممنون و سپاسگزار باش که آدم پخته و کاردیده‌، از روی بینش و بصیرت نگاه می‌کند."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "که کاردیده، نظر از سرِ بِصارت کرد",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "حدیثِ عشق ز حافظ شنو نه از واعظ",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "اگر داستان عشق را می‌خواهی بشنوی آن‌را از حافظ بشنو نه از واعظ و شیخ، اگر چه کلام و زبان پر هیاهو و پر فنی دارد."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "اگر چه صنعتِ بسیار در عبارت کرد",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    }
  ],
