  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "حالِ خونین دلان که گوید باز؟",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "چه کسی حال خونین‌دلان و دردمندان را می‌تواند شرح دهد؟ چه‌کس خون خم را از فلک و روزگار بجوید؟"
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "وز فلک خونِ خُم که جوید باز؟",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "شرمش از چشمِ مِی پرستان باد",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "شرم بر نرگس باد اگر با وجود چشم مست می‌پرستان باده‌نوش، بازهم بروید"
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "نرگسِ مست اگر بروید باز",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "جز فَلاطونِ خُم نشینِ شراب",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "بجز شراب خم‌نشین که همچون افلاطون است، چه کسی می‌تواند راز حکمت را به ما بگوید؟"
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "سِرِّ حکمت به ما که گوید باز؟",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "هر که چون لاله کاسه گَردان شد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر کسی که مانند لاله در برابر ظلم و بی‌عدالتی کمر خم کند، در نهایت از این درد و رنج به خود می‌آید و چهره‌اش را با خون خود شستشو می‌دهد."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "زین جفا رُخ به خون بشوید باز",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "نَگُشایَد دلم چو غنچه اگر",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دل من مانند غنچه‌ای است که تنها با بوییدن ساغری از لب او می‌تواند باز گردد و شکوفا شود. اگر این بوی خوش نیست، دل من همچنان در بسته باقی می‌ماند."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "ساغری از لبش نبوید باز",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "بس که در پرده چنگ گفت سخن",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بسیاری از صحبت‌ها و رازها در حین نواختن چنگ بیان می‌شود، اما برای اینکه این رازها فاش نشوند، باید موی شخصی که در حال نواختن است قطع شود تا دوباره ناپدید نشود."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "بِبُرَش موی تا نَمویَد باز",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "گِردِ بیتُ الحَرامِ خُم حافظ",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر حافظ در گرد خانه‌ی خدا بمیرد، بار دیگر سرش را به زمین خواهد زد و دوباره به سمت آنجا خواهد رفت."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "گر نمیرد به سَر بپوید باز",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    }
  ],
