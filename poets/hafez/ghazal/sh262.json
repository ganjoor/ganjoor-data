  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "حالِ خونین دلان که گوید باز؟",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "چه کسی حال خونین‌دلان و دردمندان را می‌تواند شرح دهد؟ چه‌کس خون خم را از فلک و روزگار بجوید؟"
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "وز فلک خونِ خُم که جوید باز؟",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "شرمش از چشمِ مِی پرستان باد",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "شرم بر نرگس باد اگر با وجود چشم مست می‌پرستان باده‌نوش، بازهم بروید"
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "نرگسِ مست اگر بروید باز",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "جز فَلاطونِ خُم نشینِ شراب",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "بجز شراب خم‌نشین که همچون افلاطون است، چه کسی می‌تواند راز حکمت را به ما بگوید؟"
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "سِرِّ حکمت به ما که گوید باز؟",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "هر که چون لاله کاسه گَردان شد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر کس مانند لاله جام شراب در دست گرداند، از ستم روزگار دوباره چهره‌اش را با خون می‌شوید؛ یعنی میخواره از جفای زمانه خون‌جگر و رنجور می‌شود."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "زین جفا رُخ به خون بشوید باز",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "نَگُشایَد دلم چو غنچه اگر",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر دلم دوباره بوی جامی را که از لب یار می‌آید نشنود، مانند غنچه باز و شکفته نمی‌شود؛ گشایش دلم به شراب و لب یار بسته است."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "ساغری از لبش نبوید باز",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "بس که در پرده چنگ گفت سخن",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چنگ چون پنهانی و در پرده بسیار سخن گفت و راز فاش کرد، تارهایش را که مانند مو است ببر تا دیگر ناله نکند. با ایهام «پرده» که هم به معنای پوشش است و هم پردهٔ موسیقی، به سخت‌گیری روزگار بر اهل طرب اشاره دارد."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "بِبُرَش موی تا نَمویَد باز",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "گِردِ بیتُ الحَرامِ خُم حافظ",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: حافظ اگر نمیرد، دوباره با سر، یعنی با شور و شتاب، گرد خم شراب که چون خانهٔ کعبه است طواف خواهد کرد."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "گر نمیرد به سَر بپوید باز",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    }
  ],
