  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "صوفی از پرتو مِی رازِ نهانی دانست",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "صوفی با نور و درخشش می راز بزرگی را فهمید؛ اصل هرکس را از این لعل سرخ می‌توانی بشناسی."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "گوهرِ هر کس از این لعل، توانی دانست",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "قدر مجموعهٔ گل، مرغِ سَحَر داند و بس",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "ارزش گل‌ها را فقط بلبل می‌داند، نه‌هر کسی که صفحه‌ای بخواند بدان معنی‌است که آن‌را فهمیده است."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "که نه هر کو ورقی خواند، معانی دانست",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "عرضه کردم دو جهان بر دلِ کاراُفتاده",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "تمام دو جهان را به دل عاشق دادم، به‌جز عشق تو همه چیز را فانی و نابود دانست."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "به جز از عشقِ تو باقی همه فانی دانست",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "آن شد اکنون که ز اَبنایِ عَوام اندیشم",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اکنون به آن مرحله رسیده‌ام که حتی از سوی مردم عادی نیز متوجه می‌شوم، و کسی که مسئولیت نظارت دارد، نیز از این لذت پنهانی که من تجربه می‌کنم، آگاه شده است."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "مُحتَسِب نیز در این عیشِ نهانی دانست",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "دل‌بر، آسایش ما مَصلحتِ وقت ندید",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "یار ما، آسایش ما را به‌مصلحت ندید وگرنه حال ما را درک می‌کند."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "ور نه از جانبِ ما دل‌نگرانی دانست",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "سنگ و گِل را کُنَد از یُمنِ نظر لعل و عقیق",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هرکسی ارزش نسیم یمانی را بفهمد، از نیکی نظر خود می‌تواند سنگ و گل را به لعل و عقیق تبدیل کند."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "هر که قَدرِ نفسِ بادِ یمانی دانست",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "ای که از دفترِ عقل، آیت عشق آموزی",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "ای کسی که از دانش و فهم عقل، بدنبال آموختن حقیقت عشق هستی، می‌ترسم که این نکته را به‌درستی درنیابی."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "ترسم این نکته به تَحقیق ندانی دانست",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "مِی بیاور که ننازد به گلِ باغِ جهان",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "شراب بیاور زیرا کسی که بداند چگونه باد خزان به باغ گل دنیا آسیب می‌زند، نباید به زیبایی‌های دنیا ببالد."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "هر که غارت‌گریِ بادِ خزانی دانست",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "حافظ این گوهرِ مَنظوم که از طَبع اَنگیخت",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: حافظ می‌گوید این شعر زیبا که به نظم درآمده، نتیجهٔ ذوق و talent اوست که تحت تأثیر تربیت آصف ثانی، یعنی وزیر و حکیمی بزرگ، شکل گرفته است."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "زَ اثرِ تربیتِ آصِفِ ثانی دانست",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    }
  ],
