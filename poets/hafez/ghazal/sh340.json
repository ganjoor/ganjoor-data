  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "من که از آتشِ دل چون خُمِ مِی در جوشم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من از عشق و درد قلبی به شدت می‌جوشم و مانند خُم شراب پر از می‌باشم. اما با این حال، روی لبم مهر سکوت زده‌ام و در خفا به رنج خود ادامه می‌دهم."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "مُهر بر لب زده، خون می‌خورم و خاموشم",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "قصدِ جان است طمع در لبِ جانان کردن",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من در تلاش هستم تا به عشق معشوقم دست یابم و این موضوع برای من بسیار جدی و حیاتی است. تو نگاه کن که چقدر برای رسیدن به این هدف جانفشانی می‌کنم."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "تو مرا بین که در این کار به جان می‌کوشم",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "من کِی آزاد شَوَم از غمِ دل؟ چون هر دَم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر لحظه با غم دل درگیر هستم و نمی‌دانم کی از آن رها می‌شوم، چرا که هر بار که به یاد محبوب می‌افتم، گویی زلف او به دور گوشم حلقه می‌زند و نمی‌گذاردم آزاد شوم."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "هندویِ زلفِ بُتی حلقه کُنَد در گوشم",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "حاشَ لِلَّه که نیَم معتقدِ طاعتِ خویش",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من هرگز به خودم اجازه نمی‌دهم که به طاعت خودم مغرور شوم، زیرا گاهی اوقات قدحی می‌نوشم و از خودم دور می‌شوم."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "این قَدَر هست که گَه گَه قدحی می‌نوشم",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "هست امیدم که علیرغمِ عدو روزِ جزا",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: امید دارم که با وجود دشمنی‌ها در روز حساب، لطف و بخشش خداوند بار گناهانی که بر دوشم هست را برطرف کند."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "فیضِ عَفوَش نَنَهد بارِ گُنَه بر دوشم",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "پدرم روضهٔ رضوان به دو گندم بفروخت",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: پدرم به بهای کمی مثل دو دانه گندم، بهشت را فروخت. حالا من چرا نباید برای رهایی از دنیا، مالکیت تمام جهان را به چیزی کمتر از آن بفروشم؟"
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "من چرا مُلکِ جهان را به جوی نفروشم؟!",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "خرقه‌پوشیِ من از غایتِ دین‌داری نیست",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من به خاطر دینداری‌ام لباس خاصی بر تن نکرده‌ام، بلکه این پوشش، مانند پرده‌ای است که عیب‌ها و نقص‌های پنهانم را می‌پوشاند."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "پرده‌ای بر سرِ صد عیبِ نهان می‌پوشم",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "من که خواهم که ننوشم به جز از راوَقِ خُم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من آرزو دارم فقط از شراب خم بنوشم، و چه کنم اگر سخنان حکیمانه عارفان را نشنوم؟"
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "چه کنم گر سخنِ پیرِ مُغان نَنْیوشَم؟",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "گر از این دست زَنَد مُطربِ مجلس رَهِ عشق",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر نوازنده در این مجلس نغمه‌ای از عشق بنوازد، شعر حافظ می‌تواند در زمان سماع و جشن، ذهنم را تسخیر کند."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "شعرِ حافظ بِبَرَد وقتِ سماع از هوشم",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    }
  ],
