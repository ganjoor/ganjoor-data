  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "من که از آتشِ دل چون خُمِ مِی در جوشم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من که از آتش عشقِ درونم مانند خمِ شراب در جوش و خروشم، لب را بسته‌ام، رنج و غصه را در خود فرو می‌برم و چیزی نمی‌گویم."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "مُهر بر لب زده، خون می‌خورم و خاموشم",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "قصدِ جان است طمع در لبِ جانان کردن",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آرزوی بوسه از لب معشوق داشتن به معنای به خطر انداختن جان است، اما مرا ببین که با تمام جان در این راه تلاش می‌کنم."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "تو مرا بین که در این کار به جان می‌کوشم",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "من کِی آزاد شَوَم از غمِ دل؟ چون هر دَم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من کی می‌توانم از غم دل رها شوم، در حالی که هر لحظه زلف سیاه معشوقی زیبا، مانند غلامی هندو، حلقه بر گوشم می‌اندازد و مرا بندهٔ خود می‌کند؟ حلقه در گوش نشانهٔ بندگی بوده است."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "هندویِ زلفِ بُتی حلقه کُنَد در گوشم",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "حاشَ لِلَّه که نیَم معتقدِ طاعتِ خویش",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: پناه بر خدا که به عبادت و طاعت خود دل ببندم و آن را مایهٔ نجات بدانم؛ کارم فقط همین است که گاهی جامی شراب می‌نوشم."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "این قَدَر هست که گَه گَه قدحی می‌نوشم",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "هست امیدم که علیرغمِ عدو روزِ جزا",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: امیدوارم که روز قیامت، برخلاف خواستِ دشمن و بدگو، بخشش و لطف خداوند بار گناه را بر دوش من نگذارد و مرا ببخشد."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "فیضِ عَفوَش نَنَهد بارِ گُنَه بر دوشم",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "پدرم روضهٔ رضوان به دو گندم بفروخت",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: پدرم آدم بهشت جاویدان را به دو دانه گندم فروخت؛ پس من که فرزند اویم، چرا پادشاهی دنیا را به یک جو نفروشم؟ یعنی دنیا در نظر من ارزشی ندارد."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "من چرا مُلکِ جهان را به جوی نفروشم؟!",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "خرقه‌پوشیِ من از غایتِ دین‌داری نیست",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اینکه من خرقهٔ صوفیانه پوشیده‌ام از کمال دینداری نیست؛ این خرقه پرده‌ای است که با آن صدها عیب پنهانم را می‌پوشانم."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "پرده‌ای بر سرِ صد عیبِ نهان می‌پوشم",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "من که خواهم که ننوشم به جز از راوَقِ خُم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من که می‌خواهم جز شراب صاف و پالوده از خم ننوشم، چاره‌ای ندارم جز اینکه به سخن پیر مغان، یعنی مرشد میخانه، گوش بسپارم و از او پیروی کنم."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "چه کنم گر سخنِ پیرِ مُغان نَنْیوشَم؟",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "گر از این دست زَنَد مُطربِ مجلس رَهِ عشق",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر نوازندهٔ مجلس آهنگ عشق را این‌گونه بنوازد، شعر حافظ در هنگام سماع و پایکوبی هوش از سر من می‌برد و مرا بی‌خود می‌کند."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "شعرِ حافظ بِبَرَد وقتِ سماع از هوشم",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    }
  ],
