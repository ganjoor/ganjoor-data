  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "من که از آتشِ دل چون خُمِ مِی در جوشم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من به شدت از عشق و آتش دل رنج می‌برم و احساساتی مشابه یک خُم مَی دارم که در حال جوشانیدن است. با این حال، هرچند درد و غم به جانم فشار می‌آورد، به هیچ‌کس چیزی نمی‌گویم و ساکت مانده‌ام."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "مُهر بر لب زده، خون می‌خورم و خاموشم",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "قصدِ جان است طمع در لبِ جانان کردن",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من قصد دارم جان خودم را در آرزوی لب‌های محبوب به خطر بیندازم. تو خود تماشا کن که در این کار چقدر تلاش می‌کنم و جانم را به مخاطره می‌اندازم."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "تو مرا بین که در این کار به جان می‌کوشم",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "من کِی آزاد شَوَم از غمِ دل؟ چون هر دَم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من هرگز از غم دل رهایی نخواهم یافت، زیرا هر لحظه زلف‌های بتی که به شکل یک هندو است، در گوشم حلقه می‌کند."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "هندویِ زلفِ بُتی حلقه کُنَد در گوشم",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "حاشَ لِلَّه که نیَم معتقدِ طاعتِ خویش",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من هرگز نمی‌توانم معتقد باشم که به بندگی خود پایبندم، زیرا گاهی شراب می‌نوشم و از این نظر آزاد هستم."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "این قَدَر هست که گَه گَه قدحی می‌نوشم",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "هست امیدم که علیرغمِ عدو روزِ جزا",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: امید دارم که در روز قیامت، با وجود دشمنان، فیض بخشش الهی شامل حالم شود و بار گناهم بر دوش من نخواهد بود."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "فیضِ عَفوَش نَنَهد بارِ گُنَه بر دوشم",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "پدرم روضهٔ رضوان به دو گندم بفروخت",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: پدر من به خاطر دو دانه گندم، بهشت را فروخت. من چرا باید دارایی و سرزمین گستردهٔ جهان را به یک جوی آب بفروشم؟!"
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "من چرا مُلکِ جهان را به جوی نفروشم؟!",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "خرقه‌پوشیِ من از غایتِ دین‌داری نیست",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: رسیدگی به ظاهر و نشان دادن خود به عنوان یک فرد دیندار، هدف من نیست. من این لباس و پوشش را به عنوان پرده‌ای برای پنهان کردن عیوب و نقص‌های پنهان خود بر تن کرده‌ام."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "پرده‌ای بر سرِ صد عیبِ نهان می‌پوشم",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "من که خواهم که ننوشم به جز از راوَقِ خُم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من فقط می‌خواهم از شراب خوشگوار ب‍خورم و جز آن چیزی ننوشم، اما اگر به نصیحت پیر مغان گوش ندهم، چه باید بکنم؟"
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "چه کنم گر سخنِ پیرِ مُغان نَنْیوشَم؟",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "گر از این دست زَنَد مُطربِ مجلس رَهِ عشق",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر مطرب، (که نوازنده است) در این مجلس، با نغمه‌های دلنواز خود به عشق بزند و اشعار حافظ را بخواند، در زمان خوشی و سماع، عقل و هوش من را از دست می‌دهد."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "شعرِ حافظ بِبَرَد وقتِ سماع از هوشم",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    }
  ],
