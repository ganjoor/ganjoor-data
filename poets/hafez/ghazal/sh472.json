  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "اَحمَدُ اللهَ عَلی مَعْدِلَةِ السُلطانِ",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: باید خرسند باشیم از وجود و حکومت سلطان احمد شیخ اویس حسن ایلخانی."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "احمدِ شیخ اُوِیسِ حسنِ ایلخانی",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "خانِ بِنْ خان و شهنشاهِ شهنشاه‌نژاد",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: فرمانروای بزرگ و سرور سرزمین‌ها، کسی است که اگر جان و زندگی‌اش را به پای تو بگذارد، شایسته‌ی احترام و محبت تو خواهد بود."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "آن که می‌زیبد اگر جان جهانش خوانی",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "دیده نادیده به اقبال تو ایمان آورد",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چشم نادیده به خوشبختی تو اعتماد کرد، آفرین بر تو که چنین رحمت خدا بر تو نازل شده است."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "مرحبا ای به چنین لطف خدا ارزانی",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "ماه اگر بی تو برآید به دو نیمش بزنند",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر ماه بی حضورت طلوع کند، آن را به دو نیم کنند، چون نعمت و معجزهٔ الهی به سراغ احمدی آمده است."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "دولت احمدی و معجزهٔ سبحانی",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "جلوهٔ بخت تو دل می‌برد از شاه و گدا",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: خوشبختی تو چنان درخشان است که دل هر دو قشر را می‌برد، چه شاه و چه گدا. چشمان حسود از تو دور باشد، چرا که تو هم جان می‌داری و هم محبوبی."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "چشم بد دور که هم جانی و هم جانانی",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "برشکن کاکل ترکانه که در طالع توست",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: موهای زیبای ترک‌ها را بشکن، زیرا در سرنوشت تو بخشش و تلاش خاقانی و چنگزخان وجود دارد."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "بخشش و کوشش خاقانی و چنگزخانی",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "گر چه دوریم به یاد تو قدح می‌گیریم",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر چند از تو دور هستیم، اما به خاطر تو هنوز هم زنده‌ایم و مشغول شادمانی هستیم. دیگر در این سفر روحانی جایی برای استراحت وجود ندارد."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "بُعد منزل نبود در سفر روحانی",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "از گل پارسیم غنچهٔ عیشی نشکفت",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از گل پارسی ما، غنچه‌ای از لذت و شادی باز نشده است. چه خوب است که دجله بغداد و بوی خوش ریحان در اینجا وجود دارد."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "حبّذا دجله بغداد و می ریحانی",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "سر عاشق که نه خاک در معشوق بود",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر دل عاشق به معشوق نرسد، هرگز از درد و رنج سردرگمی رهایی نخواهد یافت."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "کی خلاصش بود از محنت سرگردانی",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "ای نسیم سحری خاک در یار بیار",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای نسیم صبحگاهی، خاک را به یار برسان که حافظ از آن خاک برای دلش روشنی و نور می‌گیرد."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "که کند حافظ از او دیدهٔ دل نورانی",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    }
  ],
