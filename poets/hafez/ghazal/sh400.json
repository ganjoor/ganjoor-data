  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "بالابلندِ عِشْوِه‌گرِ نقش‌بازِ من",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: معشوقه‌ی من که بسیار فریبنده و بازیگوش است، باعث شد که داستان زهد و ریاضت طولانی من به سرعت تمام شود و بی‌خود و بی‌فایده شود."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "کوتاه کرد قصّهٔ زُهْدِ درازِ من",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "دیدی دلا که آخرِ پیری و زُهْد و عِلْم",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "آیا متوجه شدی که چطور این روحیه ی (دلْ سپارِ) من، در نهایت، با وجود تمام سالخوردگی، خودداری از هوس ها و بار دانشی که اندوخته ام، مرا دل باخته و داغ دارم کرد؟"
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "با من چه کَرْد دیدهٔ\u00A0معشوقه‌بازِ من؟",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "می‌ترسم از خرابیِ ایمان که می‌بَرَد",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: نگرانم که ایمانم خراب شود، چراکه ابروهای زیبای تو به قدری جذابیت دارند که مرا از یاد نماز و عبادت دور می‌کنند."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "مِحْرابِ ابرویِ تو، حُضورِ نمازِ من",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "گفتم به دَلْقِ زَرْق بپوشم نشانِ عشق",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: گفتم که با کلاهی زریّن نشانهٔ عشق را بپوشانم، اما عشق به طریقی مشخص شد و اشک‌هایم راز دلم را فاش کردند."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "غَمّاز بود اَشْک و عَیان کرد رازِ من",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "مست است یار و یادِ حریفان نمی‌کُنَد",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "\u00A0یار مست است و به یاد دوستانش نیست، یادش به خیر، آن یار چون شراب من"
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "ذکرش به خیر‌، ساقیِ مِسْکین‌نوازِ من",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "یا رب کی آن صبا بِوَزَد کز نسیمِ آن",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای خدا، کی آن نسیم صبحگاهی خواهد وزید که با وزش آن، بوی خوش گل‌های کرم برآید و برای من مفید و کمک‌کننده باشد؟"
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "گَرْدَد شمامهٔ\u00A0کَرَمَش، کارسازِ من؟",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "نقشی بر آب می‌زنم از گریه، حالیا",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از شدت گریه، اثری که به روح و دل من زده می‌شود و به صورت نقش بر آب به جا می‌ماند، نمی‌دانم تا کی باید منتظر بمانم تا این احساس واقعی شود و صرفاً خیال من نماند."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "تا کی شود قرینِ حقیقت، مجازِ من",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "بر خود، چو شمع، خنده‌زنان، گریه می‌کنم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من همچون شمعی که در حال سوختن است، با لبخند بر چهره در حال گریه‌ام تا ببینم سنگ‌دل تو با آتش عشق و احساسات من چه خواهد کرد."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "تا با تو سنگ‌دل چه کُنَد سوز و سازِ من؟",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "زاهد؛ چو از نمازِ تو کاری نمی‌رود",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای زاهد، وقتی که از نماز تو فایده‌ای نیست، پس مستی شبانه و راز و نیاز من چه اشکالی دارد؟"
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "هم مستیِ شبانه و راز و نیازِ من",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "«حافظ»، زِ گریه سوخت بگو حالش ای صبا",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: حافظ به صبا (نسیم) می‌گوید حالش را بگوید؛ او از شدت گریه سوخته و به یاد شاهی است که دوست‌پرور و دشمن‌گداز است، به این معنا که او حامی دوستانش است و دشمنانش را خوار می‌کند."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "با شاهِ دوست‌پرورِ دشمن‌گُدازِ من",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    }
  ],
