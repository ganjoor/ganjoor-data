  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ز دستِ کوتهِ خود زیرِ بارم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من به خاطر کم بودن امکانات و توانایی‌هایم زیر فشار و گران‌باری قرار دارم و از کسانی که در زندگی بالاتر و موفق‌تر از من هستند، شرمنده و خجالت‌زده‌ام."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "که از بالابلندان شرمسارم",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "مگر زنجیرِ مویی گیردَم دست",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر زنجیری از موهایت مرا در زندان عشق نگه دارد، وگرنه من دیوانه‌وار سر به آسمان بلند می‌کنم."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "وگر نه سر به شیدایی برآرم",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "ز چشمِ من بپرس اوضاعِ گردون",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از چشم من بپرس که چه خبرهایی از دنیا دارم، چون من هر شب و روز ستاره‌ها را حساب می‌کنم و به وقایع زندگی دقت می‌کنم."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "که شب تا روز اختر می‌شمارم",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "بدین شکرانه می‌بوسم لبِ جام",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به خاطر این نعمت، لبِ جام می را می‌بوسم، زیرا سبب شد تا از اسرار زندگی‌ام آگاه شوم."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "که کرد آگه ز رازِ روزگارم",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "اگر گفتم دعایِ مِی فروشان",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: منظور این است که وقتی از من می‌پرسند دعای کسانی که می‌نوشند چیست، من به خاطر نعمت شراب شکرگزاری می‌کنم و به آن احترام می‌گذارم."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "چه باشد؟ حقِّ نعمت می‌گزارم",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "من از بازویِ خود دارم بسی شُکر",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من از قدرت و توانایی خود بسیار سپاسگزارم، زیرا به دیگران آزار نمی‌رسانم و زور و قدرتی برای آزار دادن دیگران ندارم."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "«که زورِ مردم آزاری ندارم»",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "سری دارم چو حافظ مست لیکن",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من عقل و پختگی دارم و به خاطر آن همچنان به عشق و امید دل بسته‌ام؛ هرچند که مانند حافظ، مست و سرخوش هستم."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "به لطف آن سری امیدوارم",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    }
  ],
