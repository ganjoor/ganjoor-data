      "VOrder": 15,
      "Position": "Paragraph",
      "Text": "بوعثمان حیری٭ بر جوانی شد بیمار بود، آن جوان گفت: وی گفت: از که؟ جوان گفت: واخ! وی گفت با کی مردی از راهب پرسید: که بنزدیک شما بهتر چیز که اللّه یاوند چیست؟ گفت: دل که ازو بترسد گفت: که ازین گذشت. جان که او بیند گفت: که این نبود. گفت: تن که او پرستد:",
      "CoupletIndex": 9
    },
    {
      "VOrder": 16,
      "Position": "Paragraph",
      "Text": "شیخ الاسلام گفت: که در ورق صوفیان دل نیست در ورق صوفیان سخن از جان است، آن نه جانست، جان هم نیست، اما در طریق رشک بهانه بر جانست",
      "CoupletIndex": 10
    },
    {
      "VOrder": 17,
      "Position": "Comment",
      "Text": "لغیره:"
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "کان لی قلبقصار غلیا",
      "CoupletIndex": 11,
      "SectionIndex1": 2,
      "SectionIndex2": 4
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "لم یکن ذالک فی التحمل شیا",
      "CoupletIndex": 11,
      "SectionIndex1": 2,
      "SectionIndex2": 4
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "رحمة اللّه والسلام علیک",
      "CoupletIndex": 12,
      "SectionIndex1": 2,
      "SectionIndex2": 5
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "اننی میت و ان کنت حیا",
      "CoupletIndex": 12,
      "SectionIndex1": 2,
      "SectionIndex2": 5
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "ولی الفوجه قد عرفت طریقها",
      "CoupletIndex": 13,
      "SectionIndex1": 2,
      "SectionIndex2": 6
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "ولکن بلاقلبالی این اذهب؟",
      "CoupletIndex": 13,
      "SectionIndex1": 2,
      "SectionIndex2": 6
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "کان قلبی معی فلما التقینا",
      "CoupletIndex": 14,
      "SectionIndex1": 2,
      "SectionIndex2": 7
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "صار قلبی له فمن لی بقلبی",
      "CoupletIndex": 14,
      "SectionIndex1": 2,
      "SectionIndex2": 7
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "انا سلمت فی هواه قیادی",
      "CoupletIndex": 15,
      "SectionIndex1": 2,
      "SectionIndex2": 8
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "وفوادی قدذل فی‌الحب صعبی",
      "CoupletIndex": 15,
      "SectionIndex1": 2,
      "SectionIndex2": 8
    },
    {
      "VOrder": 28,
      "Position": "Comment",
      "Text": "للسمنون"
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "اناراض بطول صدک عنی",
      "CoupletIndex": 16,
      "SectionIndex1": 2,
      "SectionIndex2": 9
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "لیس الا ان ذالک هواک",
      "CoupletIndex": 16,
      "SectionIndex1": 2,
      "SectionIndex2": 9
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "فامتحن الجفا صبری علی",
      "CoupletIndex": 17,
      "SectionIndex1": 2,
      "SectionIndex2": 10
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "الود،ود عنی مقام بر جاک",
      "CoupletIndex": 17,
      "SectionIndex1": 2,
      "SectionIndex2": 10
    },
    {
      "VOrder": 33,
      "Position": "Paragraph",
      "Text": "شیخ الاسلام گفت: که روزی سمنون گفت:",
      "CoupletIndex": 18
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "ترید منی اختیار سری",
      "CoupletIndex": 19,
      "SectionIndex1": 3
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "و قد علمت المراد منی",
      "CoupletIndex": 19,
      "SectionIndex1": 3
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "ولیس لی فی واک حظ",
      "CoupletIndex": 20,
      "SectionIndex1": 3
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "فکیف ما شئت فاختبرنی",
      "CoupletIndex": 20,
      "SectionIndex1": 3
    },
    {
      "VOrder": 38,
      "Position": "Paragraph",
      "Text": "مرا مخوانید جز کذاب، تا ویرا نگفتندی که مذاب باز ننگرستی شیخ الاسلام گفت رضی اللّه عنه: که:",
      "CoupletIndex": 21
    },
    {
      "VOrder": 39,
      "Position": "Paragraph",
      "Text": "شیخ زهرون",
      "CoupletIndex": 22
    },
    {
      "VOrder": 40,
      "Position": "Paragraph",
      "Text": "بمغرب بود، شیخ مغرب بود، از اهل اطرابلس از اقران مظفر کرمانشاهی٭ با یکدیگر در صحبت بمکه رفته‌اند. زهرون فرا پیش و مظهر پس او، و سیده زن مظفر پس ایشان،و همه بجمله بر مکه برفته انداز دنیا. بوعبداللّه مغربی٭ گوید: که هیچ فنی ندیده‌ام از فتیان چون زهرون شیخ الاسلام گفت: که وقتی بتماشا بیرون شده بود، با جماعتی از درویشان. این دو بیت بر خواندند:",
      "CoupletIndex": 23
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "سنا برقی نفی عنی الکری",
      "CoupletIndex": 24,
      "SectionIndex1": 4
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "لم یزل یلمع لی من ذی طوی",
      "CoupletIndex": 24,
      "SectionIndex1": 4
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "منزل سلمی به نازلة",
      "CoupletIndex": 25,
      "SectionIndex1": 4
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "طیب الساحة معمور الفنا",
      "CoupletIndex": 25,
      "SectionIndex1": 4
    },
    {
      "VOrder": 45,
      "Position": "Paragraph",
      "Text": "وی بخروشید و بانگی چند بکرد و لختی شور کرد و بازگشت گفت: من تماشای خود بکردم",
      "CoupletIndex": 26
    },
    {
      "VOrder": 46,
      "Position": "Paragraph",
      "Text": "شیخ الاسلام گفت: در کتاب احمد بن الحواری دیدم، که:",
      "CoupletIndex": 27
    }
  ]
}
