      "Text": "سبک چون پر کاه شد در نظرها",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "رخی کز طمع زردچون کهرباشد",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
