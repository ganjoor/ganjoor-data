      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "از رخ چون آفتاب لاله عذاران",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
