      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "همچو آیینه، لوحِ ساده مرا",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
