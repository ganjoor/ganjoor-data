  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "کرد روزی شمس دین در دید و حال",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "از «جلال الدین رومی » این سئوال",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
