  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "در بیان فیض بخشی آن سر حلقۀ راستین و اسرار شکافتن آستین و مراتب پرده از اسرار برداشتن و نکتۀ توحید را از راه مکاشفات، معلوم عروس خود داشتن که بر مصداق: اولیائی تحت قبابی لایعرفهم غیری ما را تا ابد زندگی و دوام و دولت و پایندگیست:",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Right",
      "Text": "هیچ میدانی تو ای صاحب یقین",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Left",
      "Text": "چیست اینجا سر خرق آستین؟",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Right",
      "Text": "آستین وهم او را، خرق کرد",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Left",
      "Text": "حق و باطل را، بر او، فرق کرد",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "التیام از خرق او، وزخرقهاست",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "فرقها از فرق او تا فرقهاست",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "یعنی آگه شو که ما پاینده‌ایم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "تا ابد ما تازه‌ایم و زنده‌ایم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "فارغ آمد ذات ما ز افسردگی",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "نیست ما را، کهنگی و مردگی",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Right",
      "Text": "ناجی آنکو، راه ما را سالک‌ست",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Left",
      "Text": "غیر ما هر چیز بینی، هالک‌ست",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "عار داریم از حیات مستعار",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "کشته گشتن هست ما را اعتبار",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "هم فنا را هم بقا را، رونقیم",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "فانی اندر حق و باقی در حقیم",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "گر بصورت جان بجانان میدهیم",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "هم بمعنی مرده را جان میدهیم",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "گر بصورت غایب از هر ناظریم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "لیک در معنی بهر جا حاضریم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "متصل با بحر و خارج چون حباب",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "دوست را هستیم در تحت قباب",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "عارف ما نیست جز او، هیچکس",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "همچنین ما عارف اوییم و بس",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "آن ودیعت کز حسین بددر دلش",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "و آنچه محفوظ از ولی کاملش",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
