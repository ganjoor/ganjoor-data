      "Text": "آرزو را ترک گفتن، خوشترست",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "با عروس مرگ خفتن، خوشترست",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "کی خضاب دستتان باشد صواب؟",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "دست عاشق راز خون باید خضاب",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "این صدا آمد چو قاسم را، بگوش",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "شد ز غیرت وز تغیر در خروش",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "خاست از جا و عروس مقبلش",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "دست حسرت زد بدامان دلش",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "راهرو را پای از رفتار ماند",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "دل ز همراهی و دست از کار، ماند",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "گفت از پیش من ای بدردجی",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "چون برفتی، بینمت دیگر کجا؟",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "نوعروس خویش را، بوسید چهر",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "خوش در آغوشش کشید از روی مهر",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "ز آستین اشکش ز چشمان پاک کرد",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "بعد از آن آن آستین را، چاک کرد",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "گفت: در فردوس چون کردیم رو",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "مر مرا با این نشان، آنجا بجو",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    }
  ]
}
