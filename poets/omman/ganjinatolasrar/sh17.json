    {
      "VOrder": 4,
      "Position": "Right",
      "Text": "دور شد از شکرستانش مگس",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Left",
      "Text": "وز گلستان مرادش، خار و خس",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "خلوت از اغیار شد پرداخته",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "وز رقیبان، خانه خالی ساخته",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "پیر میخواران، بصدر اندر نشست",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "احتیاط خانه کرد و در ببست",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "محرمان راز خود را خواند؛پیش",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "جمله را بنشاند، پیرامون خویش",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Right",
      "Text": "با لب خود گوششان انباز کرد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Left",
      "Text": "در ز صندوق حقیقت، باز کرد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "جمله را کرد از شراب عشق، مست",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "یادشان آورد آن عهد الست",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "گفت شاباش این دل آزادتان",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "باده خوردستید، بادا یادتان",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "یادتان باد ای فرامش کرده‌ها",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "جلوه‌ی ساقی ز پشت پرده‌ها",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "یادتان باد ای بدلتان، شورمی",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "آن اشارت‌های ساقی پی زپی",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "اینک از هر گوشه‌یی، جم غفیر",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "مر شما را می‌زند ساقی، صفیر",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "کاین خمار آن باده را بد در قفا",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "هان و هان آن وعده را باید وفا",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "گوشه چشمی می‌نماید گاه گاه",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "سوی مستان می‌کند، خوش خوش نگاه",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    }
  ]
}
