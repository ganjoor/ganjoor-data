    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "بر حکیم از آن قعود و آن قیام",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "حل نمود اشکال خرق و التیام",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "و آن سپاه ظلم و آن احزاب جور",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "چون شیاطین مر نمازی را، بدور",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "تیر بر بالای تیر بیدریغ",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "نیزه بعد از نیزه تیغ از بعد تیغ",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "قصه کوته شمرذی الجوشن رسید",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "گفتگو را، آتش خرمن رسید",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "ز آستین، غیرت برون آورد دست",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "صفحه را شست و قلم را، سرشکست",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "از شنیدن، دیده بیتابست و گوش",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "شد سخنگوی از زبان من، خموش",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 60,
      "Position": "Right",
      "Text": "آنکه عمان را در آوردی بموج",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "گاه بردی در حضیض و گه به اوج",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 62,
      "Position": "Right",
      "Text": "ناله‌های بیخودانه بس کشید",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "اندرین جا، پای خود واپس کشید",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 64,
      "Position": "Right",
      "Text": "بیش از آن یارای در سفتن نداشت",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 65,
      "Position": "Left",
      "Text": "قدرت زین بیشتری گفتن نداشت",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 66,
      "Position": "Right",
      "Text": "شرمسارم از معانی جوئیش",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 67,
      "Position": "Left",
      "Text": "عذر خواهم از پریشان گوئیش",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 68,
      "Position": "Right",
      "Text": "حق همی داند که غالی نیستم",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 69,
      "Position": "Left",
      "Text": "اشعری و اعتزالی نیستم",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 70,
      "Position": "Right",
      "Text": "اتحادی و حلولی نیستم",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 71,
      "Position": "Left",
      "Text": "فارغ از اقوال بی معنیستم",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 72,
      "Position": "Right",
      "Text": "لیک من دارم دل دیوانه‌یی",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 73,
      "Position": "Left",
      "Text": "با جنون خوش از خرد بیگانه‌یی",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 74,
      "Position": "Right",
      "Text": "گاهگاهی از گریبان جنون",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 75,
      "Position": "Left",
      "Text": "سر به شیدایی همی آرد برون",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 76,
      "Position": "Right",
      "Text": "سعی ها دارد پی خامی من",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 77,
      "Position": "Left",
      "Text": "سخت می کوشد به بد نامی من",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 78,
      "Position": "Right",
      "Text": "لغزشی گر رفت نی از قائلست",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 79,
      "Position": "Left",
      "Text": "آنهم از دیوانگی های دلست",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 80,
      "Position": "Right",
      "Text": "منتها چون رشته باشد با حسین",
      "CoupletIndex": 40,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 81,
      "Position": "Left",
      "Text": "شاید ای دانا کنی گر غمض عین",
      "CoupletIndex": 40,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 82,
      "Position": "Right",
      "Text": "قافیه محهول اگر شد درپذیر",
      "CoupletIndex": 41,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 83,
      "Position": "Left",
      "Text": "و آنچه باشد، شو رودور وزیر و پیر",
      "CoupletIndex": 41,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 84,
      "Position": "Right",
      "Text": "دل بسی زین کار کرده‌ست وکند",
      "CoupletIndex": 42,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 85,
      "Position": "Left",
      "Text": "عشق ازین بسیار کرده‌ست و کند",
      "CoupletIndex": 42,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 86,
      "Position": "CenteredVerse1",
      "Text": "***",
      "CoupletIndex": 43,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "چونکه از اسرار سنگی بار شد",
      "CoupletIndex": 44,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "نام او «گنجینة الاسرار» شد",
      "CoupletIndex": 44,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    }
  ]
}
