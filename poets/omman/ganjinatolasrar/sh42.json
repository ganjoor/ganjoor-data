  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "در بیان محاربه‌ی آن موحد صاحب یقین در میدان مشرکین و پیغام آوردن جبرئیل امین از حضرت رب العالمین و افتادن آن حضرت از زین بر زمین، سلام اللّه علیه الی یوم الدین.",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Right",
      "Text": "گشت تیغ لامثالش، گرم سیر",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 3,
      "Position": "Left",
      "Text": "از پی اثبات حق و نفی غیر",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 4,
      "Position": "Right",
      "Text": "ریخت بر خاک از جلادت خون شرک",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 5,
      "Position": "Left",
      "Text": "شست ز آب وحدت از دین رنگ و چرک",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "جبرئیل آمد که ای سلطان عشق",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "یکه تاز عرصه‌ی میدان عشق",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "دارم از حق بر تو ای فرخ امام",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "هم سلام و هم تحیت هم پیام",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "گوید ای جان حضرت جان آفرین",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "مر تر ابر جسم و بر جان، آفرین",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 12,
      "Position": "Right",
      "Text": "محکمی ها از تو میثاق مراست",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 13,
      "Position": "Left",
      "Text": "رو سپیدی از تو عشاق مراست",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "این دویی باشد ز تسویلات نفس",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "من توام، ای من تو، در وحدت تو من",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 16,
      "Position": "Right",
