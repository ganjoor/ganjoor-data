      "VOrder": 32,
      "Position": "Right",
      "Text": "دستی اندر قبض و بسط و عزم و فسخ",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "دستی اندر قهر و لطف و طرح و نسخ",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "دستی اندر ارض و دستی در سما",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "دستی اندر نشو و دستی در نما",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "دستی اندر لیل و دستی در نهار",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "در خزان دستی و دستی در بهار",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "مرمرا اندر امور از نفع و ضر",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "نیست شغلی مانع شغل دگر",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "نیستم محتاج و بالذاتم غنی",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "هست فرع احتیاج این دشمنی",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "دشمنی باشد مرا با جهلشان",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "کز چه رو کرد اینچنین نااهلشان",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "قتل آن دشمن به تیغ دیگرست",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "دفع تیغ آن، به دیگر اسپرست",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "رو سپر می‌باش و شمشیری مکن",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "در نبرد روبهان شیری مکن",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "بازویت را، رنجه گشتن شرط نیست",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "با قضا هم پنجه گشتن شرط نیست",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "بوسه زن بر حنجر خنجر کشان",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "تیر کآید، گیر و در پهلو نشان",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "پس برفت آن غیرت خورشید و ماه",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "همچو نور از چشم و جان از جسم شاه",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "باز می‌کرد از ثریا تاثری",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "هر سر پیکان، به روی او، دری",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "مست گشت از ضربت تیغ و سنان",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "بیخودیها کرد و داد از کف عنان",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "عشق آمد، عقل ازو پا مال شد",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "آن نصیحت گو، لسانش لال شد",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 60,
      "Position": "Right",
      "Text": "وقت آن شد کز حقیقت دم زند",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "شعله بر جان بنی آدم زند",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 62,
      "Position": "Right",
      "Text": "پرده از روی مراتب؛ واکند",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "جمله‌ی عشاق را؛ رسوا کند",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 64,
      "Position": "Right",
      "Text": "باز عقل آمد، زبانش را گرفت",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 65,
      "Position": "Left",
      "Text": "پیر میخواران، عنانش را گرفت",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 66,
      "Position": "Right",
      "Text": "رو بدریا کرد دیگر آب جو",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 67,
      "Position": "Left",
      "Text": "زی پدر شد آب گوی و آب جو",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    }
  ]
}
