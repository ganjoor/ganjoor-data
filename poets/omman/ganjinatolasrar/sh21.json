  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "در بیان اشتداد وجد و حال و انقلاب حالت آن سید بی همال که مبادا فدایی آید یا بدائی رخ نماید:",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Right",
      "Text": "ز آن نمی‌آرم بر آوردن خروش",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Left",
      "Text": "ترسم او را آن خروش آید بگوش",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Right",
      "Text": "باورش آید که ما را تاب نیست",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Left",
      "Text": "تاب کتان در بر مهتاب نیست",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "رحمت آرد بر دل افکار ما",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "بخشد او بر ناله‌های زار ما",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "اندک اندک دست بر دارد ز جور",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "ناقص آید، بر من، این فرخنده دور",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "سرخوشم، کان شهریار مهوشان",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "کی به مقتل پا نهد دامن کشان",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Right",
      "Text": "عاشقان خویش بیند سرخ رو",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Left",
      "Text": "خون روان از چشمشان مانند جو",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "غرق خون افتاده در بالای خاک",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "سوده بر خاک مذلت، روی پاک",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "جان بکف بگرفته از بهر نیاز",
