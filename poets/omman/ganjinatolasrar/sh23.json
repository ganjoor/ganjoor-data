      "Position": "Right",
      "Text": "گشته با شور حسینی، نغمه گر",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Left",
      "Text": "کسوت عباسیان کرده به بر",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "جانب اصحاب، تازان با خروش",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "مشکی از آب حقیقت پر، به دوش",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "کرده از شط یقین، آن مشک پر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "مست و عطشان همچو آب آورشتر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "تشنه‌ی آبش، حریفان سر بسر",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "خود ز مجموع حریفان، تشنه‌تر",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "چرخ زاستسقای آبش در طپش",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "برده او بر چرخ بانگ العطش",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "ای ز شط سوی محیط آورده آب",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "آب خود را ریختی، واپس شتاب",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "آب آری سوی بحر موج خیز!",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "بیش ازین آبت مریز آبت بریز",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    }
  ]
