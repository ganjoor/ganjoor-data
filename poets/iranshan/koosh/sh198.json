  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "پس از بهر کارم بیاراست نیز",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "سزاوار شاهان ز هرگونه چیز",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ز تن جامهٔ خویش وز سر کلاه",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "فرستاد زرّین یکی تاج و گاه",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "درفش کیانی و تیغ به‌زر",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "ز گوهر یکی خسروانی کمر",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "یکی زنده‌پیلی همانند شیر",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "به حمله چو آتش به زفتی چو شیر",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "گرانتر ز کوه و سبکتر ز باد",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "ز هیبت سرشت و ز قوّت نهاد",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "دو دست و دو پایش چو سیمین ستون",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "دو دندان درخت و دو دیده چو خون",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "زمین کرده رنجور زیر قدم",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "هوا کرده چون دوزخ از دور و نم",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "ز سنگش شده گاو و ماهی ستوه",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "ز رنگش خجل برف بر تیغ کوه",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "گریزان ز خرطوم یازانْش، کرگ",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "کمین کرده در نیشِ دندانْش مرگ",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "گه کین و آرایش کارزار",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "یکی حمله و صد هزاران سُوار",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "برافگنده بر پیل هندی ستام",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "به دیبا بیاراستندش تمام",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "به منشور، ماچین بدو داد نیز",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "بسی هدیه در خورد و هرگونه چیز",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "نهادند مهدی بر او زرنگار",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "درفشی پر از گوهر شاهوار",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "به نستوه داد آن همه خواسته",
