      "Text": "به نام خداوند خورشید و ماه",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "برآرندهٔ بی‌ستون آسمان",
