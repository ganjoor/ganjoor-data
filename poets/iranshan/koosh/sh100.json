      "Text": "چو بردی به ما بر گمانی مبر",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "چون نامه به پایان رسانیده بود",
