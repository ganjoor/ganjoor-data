      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "جهان را چو سرگشته شد سر ز خواب",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
