  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "یکی نامور خواهم از انجمن",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "که او را دهم جوشن و اسب من",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "زبان پارسی دارد و پهلوی",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "ندارد سر تندی و بدخوی",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "شود پیش او از میان سپاه",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "بخواهد مر او را به آوردگاه",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "درنگ آورد چون به پیش آیدش",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "به گفتار شیرین چو خویش آیدش",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "مدارا کند پس بخواهد نشان",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "چو دارد نشان بچّهٔ سرکشان",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "چو باد آید از پشت مرکب فرود",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "رساند بدو از زبانم درود",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "بگوید که هستی تو فرزند من",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "گرامی‌تر از هرچه پیوند من",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "چو من بر تو بیداد کردم پدید",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "ز تو نیز بیداد بر من رسید",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "چو در تو نگه کردم و چهر تو",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "ز تندی بشستم دل از مهر تو",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "ز شرم بزرگانْت برداشتم",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "فگندمْت بر دشت و بگذاشتم",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "گنهکار گشتم سوی کردگار",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "گناهم پشیمانی آورد بار",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "تو را گر نیفگندمی من به خاک",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "نگشتی ز نیواسب جان را هلاک",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "کنون کرد پاداش من کردگار",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "که نیواسب شد کشته در کارزار",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "ز مرگش چنان سوگوارم هنوز",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "که از دیده خوناب بارم هنوز",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "نه خوردم، نه خفتم زمانی به کام",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "چنانم که مرغی گرفتار دام",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "دریغا گرامی یل شهریار",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "ستون سپاه و گزین تبار",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "کنون روزگار وی اندر گذشت",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "مرا پشت از اندوه آن کوژ گشت",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "زمان تا زمانم سرآید زمان",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "چنین آمد از گردش آسمان",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "جز از تو مرا نیست فرزند هیچ",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "به شادی و خوبی سوی ره بسیچ",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "گر از تخت چون بگسلد پای من",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "جز از تو نگیرد کسی جای من",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "چو اندر رسیدی، در آیی به گاه",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "سپارم تو را تخت و تاج و کلاه",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "به یزدان کنم نیز سوگند یاد",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "به ماه و به مهر و به تخت و به داد",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "که از کام و رای تو من نگذرم",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "سپارم به تو لشکر و کشورم",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "چرا بندگی کرد باید تو را",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "کسی را که خود بنده شاید تو را",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "بود چون نشستی تو بر تخت چین",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "هزارانْت بنده به از آتبین",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "تو تا بوده‌ای همچو گرگ و پلنگ",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "نکردی در آباد جایی درنگ",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "بیابان همی بینی و دشت و کوه",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "که از دیدنش دیو گردد ستوه",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "چو گلشن ببینی و خرّم‌سرای",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "می و رود و رامشگر خوش‌سرای",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "شبستان و خوبان آراسته",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "به رخساره چون ماه ناکاسته",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "به پیوند ایشان شوی مست و شاد",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "به باغ و به ایوان خرّم نهاد",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "ببینی تو این مایه‌ور شهر خویش",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "بیابی تو از کام دل بهر خویش",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "دریغ آیدت آن چنان زندگی",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "که در بیشه کردی بدین بندگی",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "چو گرگان گهی گرسنه گاه سیر",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "چو مرغان گهی بر هوا گاه زیر",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "ز هرگونه گویدش گفتار گرم",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 36
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "مگر گرددش دل به گفتار، نرم",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 36
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "به گفتار شیرین ز سوراخ مار",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 37
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "برون آورد مردم هوشیار",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 37
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "گر آید برِ ما ز آوردگاه",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 38
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "شود دور یکباره ز ایران سپاه",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 38
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "شکسته شود پشت ایرانیان",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 39
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "سواری نبندد کمر بر میان",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 39
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "یکایک ببندیمشان دست و پای",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 40
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "فرستیمشان پیش گیتی خدای",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 40
    }
  ]
}
