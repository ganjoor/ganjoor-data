  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "سر ماه چون ماهِ نو شد پدید",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "همه دامن کوه لشکر کشید",
