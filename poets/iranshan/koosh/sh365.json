  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "دگر شارسْتانی‌ست از سیم ناب",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "به شکل عقابی سر اندر سحاب",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "که اندازه زآن بر نشاید گرفت",
