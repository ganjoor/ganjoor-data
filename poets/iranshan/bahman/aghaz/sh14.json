  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "همی زخم شد تا بر و گردنش",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
