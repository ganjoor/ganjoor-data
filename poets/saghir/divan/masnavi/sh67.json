      "Text": "اگر بود رستم در آن روزگار",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "که فردوسی از خامه شد مشکبار",
