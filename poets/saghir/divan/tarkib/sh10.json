      "Text": "ز پاسش بود ملک اسلام سالم",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "به خلاق و خلق است محکوم و حاکم",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "قرینند او را همه خلق دائم",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 30,
      "Position": "CenteredVerse1",
      "Text": "به احسان بی‌مر به الطاف بی‌حد",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "وجودی که بر ذات حق مظهر آمد",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "بدان شاه دور امامت سر آمد",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "خود این رتبه مخصوص آنسرور آمد",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "بشد حاصل از پرده چون او درآمد",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 35,
      "Position": "CenteredVerse1",
      "Text": "خداوند را آنچه می‌بود مقصد",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "امیر اوست دیگر امیران عبیدش",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "مراد اوست دیگر مرادان مریدش",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "جز از جد او نیست شرع جدیدش",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "عجب نیست عمر شریف مدیدش",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 40,
      "Position": "CenteredVerse1",
      "Text": "بلی ظل حق است ممدود و ممتد",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "هم او مقصد طالبان حقیقت",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "هم او رهبر ره روان طریقت",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "نه تنها ز احمد رسیدش ودیعت",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "که او وارث هر مقام و فضیلت",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 45,
      "Position": "CenteredVerse1",
      "Text": "رسل را ز آدم بود تا به احمد",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "خط و خال آن مصدر دین و ایمان",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "زبور است و توریه و انجیل و فرقان",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "به هریک زلی و نبی اوست همشان",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "بود اندر آئینه او نمایان",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 50,
      "Position": "CenteredVerse1",
      "Text": "جمال علی و جمال محمد",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "نمی‌گشتم ار بنده زین نکته غالی",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "خدایش همی خواندم از بی مثالی",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "زهی ذوالجلالی که از ذوالجلالی",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "چو حیدر مقیم مقامی است عالی",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 55,
      "Position": "CenteredVerse1",
      "Text": "چو احمد مر او را به عرش است مسند",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "زهی میر افضل زهی شاه اکرم",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "که او را بود فرش ره عرش اعظم",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "چو نورش مکان یافت در صلب آدم",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "پی سجدهٔ او ز خلاق عالم",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 60,
      "Position": "CenteredVerse1",
      "Text": "به کروبیان آمد امر مؤکد",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "تو را باید ای عاقل عافیت‌جو",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "که بر سوی او روی آری زهر سو",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "مکن زو تغافل مگردان از او رو",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "همین است آن قبله کز سجدهٔ او",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 65,
      "Position": "CenteredVerse1",
      "Text": "ابا کرد ابلیس و گردید مرتد",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 66,
      "Position": "Right",
      "Text": "شها گرچه من بندهٔ رو سیاهم",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 67,
      "Position": "Left",
      "Text": "صغیرم ولی غرق بحر گناهم",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 68,
      "Position": "Right",
      "Text": "همین بس که مدحت سرای تو شاهم",
      "CoupletIndex": 40,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 69,
      "Position": "Left",
      "Text": "امید است عصیان ببخشد الهم",
      "CoupletIndex": 40,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 70,
      "Position": "CenteredVerse1",
      "Text": "ز درگاه رحمت نگردانم رد",
      "CoupletIndex": 41,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "چو پنهانی از من تو ای سر ذوالمن",
      "CoupletIndex": 42,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "به صابر علی باشدم دیده روشن",
      "CoupletIndex": 42,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "که او در توفانیست بی‌ریب و ‌بی‌ظن",
      "CoupletIndex": 43,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "به سوی تو گردید او رهبر من",
      "CoupletIndex": 43,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 75,
      "Position": "CenteredVerse1",
      "Text": "که بادا به تأیید یزدان مؤید",
      "CoupletIndex": 44,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    }
  ]
}
