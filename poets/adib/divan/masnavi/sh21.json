  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ای تازه عروس مهربانم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: ای عروس دلنشین و مهربان من، تو باعث شده‌ای که زندگی من همیشه سرشار از شادی و معنا باشد."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "وصل تو حیات جاودانم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "خورشید سپهر اقتدارم",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: خورشید آسمان قدرت من، زیور جشن افتخار من است."
    },
    {
