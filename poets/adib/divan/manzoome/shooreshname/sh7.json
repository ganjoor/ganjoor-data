  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "وز آن سو فرستاد خان اجل",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "یکی قاصدی تند پا چون اجل",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "به داین به نزدیک یحیای راد",
