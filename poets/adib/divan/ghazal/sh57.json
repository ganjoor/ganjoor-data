      "VOrder": 11,
      "Position": "Right",
      "Text": "قلت نعم قال و فی شادن",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "قد کحلت اجفانه بالسواد",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "قلت نعم قال و فی مطرب",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "اذارنا یرقص منه الجماد",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "قلت نعم قال فنم آمنا",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "یا کعبة الفسق و رکن الفساد",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Paragraph",
      "Text": "قطعه دوم منسوب به سناء الملک است ولی من بنده در دیوان زین الدین ابو حفص عمربن مظفربن عمرالوردی الشافعی آنرا یافته ام و آن اینست",
      "CoupletIndex": 8
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "بت و ابلیس اتی، بحیلة منتدبة",
      "CoupletIndex": 9,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "فقال ما قولک فی، حشیشة منتخبة",
      "CoupletIndex": 9,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "فقلت لا قال و لا، خمرة کرم مذهبة",
      "CoupletIndex": 10,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "فقلت لا قال و لا، اغید بالبدر اشتبه",
      "CoupletIndex": 10,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "فقلت لا قال و لا، ملیحة مطیعة",
      "CoupletIndex": 11,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "فقلت لا قال و لا، آلة لهو مطربة",
      "CoupletIndex": 11,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "فقلت لا قال فنم",
      "CoupletIndex": 12,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "ما انت الا حطبة",
      "CoupletIndex": 12,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "شب دوشین که تا قریب سحر",
      "CoupletIndex": 13,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "بودمی خسته از سهاد و سپهر",
      "CoupletIndex": 13,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "از پس پاس سیمین زان شب",
      "CoupletIndex": 14,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "سر نهادم بفکر در بستر",
      "CoupletIndex": 14,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "گرم چون گشت چشمم اندر خواب",
      "CoupletIndex": 15,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "دیدم ابلیس را بخواب اندر",
      "CoupletIndex": 15,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "گفت خواهی یکی فروزان شمع",
      "CoupletIndex": 16,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "که برد خواب را سبک از سر",
      "CoupletIndex": 16,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "گفتم آری بگفت لو لیکی",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "ز اکبر آباد هند یا کشمر",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "گفتم آری بگفت صاف مئی",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "که بود جمشید را دختر",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "گفتم آری بگفت دخترکی",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "که رخش زد بجان شرم شرر",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 13
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "گفتم آری بگفت شاهدکی",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 14
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "که ز مژگان به دل زند خنجر",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 14
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "گفتم آری بگفت مطربکی",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 15
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "کز ترانه اش برقص نجم و شجر",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 15
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "گفتم آری بگفت صد احسنت",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 16
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "بر تو ای خشک مغز دامن تر",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 16
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "شاد و آسوده خواب کن که توئی",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 17
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "کعبه فسق را سیاه حجر",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 17
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "چون بدین طعنه خاطرم آزرد",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 18
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "خرمن غیرتم گرفت آذر",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 18
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "جستم از هول و جستم از لاحول",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 19
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "بهر دفع بلیس نفس سپر",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 19
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "باز رفتم ز فکرت اندر خواب",
      "CoupletIndex": 26,
      "SectionIndex1": 1,
      "SectionIndex2": 20
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "دیدم او را بصورت دیگر",
      "CoupletIndex": 26,
      "SectionIndex1": 1,
      "SectionIndex2": 20
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "گفت ای یار سرخ رو خواهی",
      "CoupletIndex": 27,
      "SectionIndex1": 1,
      "SectionIndex2": 21
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "در می سبزه چون خط دلبر",
      "CoupletIndex": 27,
      "SectionIndex1": 1,
      "SectionIndex2": 21
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "گفتمش نی بگفت اگر باشد",
      "CoupletIndex": 28,
      "SectionIndex1": 1,
      "SectionIndex2": 22
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "قدحی ز آن شراب جان پرور",
      "CoupletIndex": 28,
      "SectionIndex1": 1,
      "SectionIndex2": 22
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "گفتمش نی بگفت اگر باشد",
      "CoupletIndex": 29,
      "SectionIndex1": 1,
      "SectionIndex2": 23
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "دختری لعل پوش و سیمین بر",
      "CoupletIndex": 29,
      "SectionIndex1": 1,
      "SectionIndex2": 23
    },
    {
      "VOrder": 60,
      "Position": "Right",
      "Text": "گفتمش نی بگفت اگر باشد",
      "CoupletIndex": 30,
      "SectionIndex1": 1,
      "SectionIndex2": 24
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "ساده نازنین چو قرص قمر",
      "CoupletIndex": 30,
      "SectionIndex1": 1,
      "SectionIndex2": 24
    },
    {
      "VOrder": 62,
      "Position": "Right",
      "Text": "گفتمش نی بگفت اگر باشد",
      "CoupletIndex": 31,
      "SectionIndex1": 1,
      "SectionIndex2": 25
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "مطربی با دف و نی و مزمر",
      "CoupletIndex": 31,
      "SectionIndex1": 1,
      "SectionIndex2": 25
    },
    {
      "VOrder": 64,
      "Position": "Right",
      "Text": "گفتمش نی بگفت نیک بخسب",
      "CoupletIndex": 32,
      "SectionIndex1": 1,
      "SectionIndex2": 26
    },
    {
      "VOrder": 65,
      "Position": "Left",
      "Text": "که نه زین شاخ برگ رست و نه بر",
      "CoupletIndex": 32,
      "SectionIndex1": 1,
      "SectionIndex2": 26
    },
    {
      "VOrder": 66,
      "Position": "Right",
      "Text": "هیزم خشکی و ز زهد و ریا",
      "CoupletIndex": 33,
      "SectionIndex1": 1,
      "SectionIndex2": 27
    },
    {
      "VOrder": 67,
      "Position": "Left",
      "Text": "میفروشی بخلق هیزم تر",
      "CoupletIndex": 33,
      "SectionIndex1": 1,
      "SectionIndex2": 27
    }
  ]
}
