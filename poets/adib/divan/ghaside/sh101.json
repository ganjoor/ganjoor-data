  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "باز بگشود صبا دست ستم",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "زد سر زلف ریاحین برهم",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ابر زد در صف بستان خیمه",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "سرو افراشته بگردون پرچم",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "سرو ماننده تیری شده راست",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "بید مجنون چو کمانی شده خم",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "باغ خوشبوی تر از روضه خلد",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "راغ دلجوی تر از باغ ارم",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "لعلگون لاله نعمان گوئی",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "رسته از خون سیاوش بقم",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "بر رخ باغ نوشتند ز نو",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "پی دفع نظر نامحرم",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "صاد والقرآن با طاسین میم",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "قاف والقرآن با نون و قلم",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "بید با باد سحرگه شب و روز",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "عشقبازیها دارند بهم",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "باد چون عنتره ابن الشداد",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "بید ماننده ام الهیثم",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "خار در دامن گل پنداری",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "ام خالد شد و مروان حکم",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "دست گل بوسه زند باد صبا",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "بمثال شمنان پای صنم",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "برق را باشد روی عذرا",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "رعد را باشد خوی اخزم",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "ابر پنداری مستسقی شد",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "پای تا سرش همی کرده ورم",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "باد مانند پزشگان بدرد",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "پرده ثرب و صفاقش از هم",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "بهر صحت را بزلش سازد",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "آب بیرون کشد از زیر شکم",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "شاخ نو رسته و آن شاخ کهن",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "گشته اندر صف بستان توأم",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "چون عروسی که یکی زلف برند",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "وآندگر زلف پریشان و بخم",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "آن شقایق را سرخست قبای",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "لیک تاریک و سیاهست شکم",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "گوئی اندر دل لعلین قدحی",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "دست نقاش زد از مشک رقم",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "باغ را رنگ و رخی ماویه سان",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "ابر را دست و دلی چون حاتم",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "همچو خوی بر رخ ترکان بهار",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "از هوا ریزد بر گل شبنم",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "در دل لاله یکی تیر چنان",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "چشم روئین تن و تیر رستم",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "حرم و رکن و صفاو مروه",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "حجر و حجر و منی و زمزم",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "ما نمی جوئیم ای شیخ نژند",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "ما نمیخواهیم ای پیر دژم",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "باده چون گهر و طرف چمن",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "ساقی چون قمر و روی صنم",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "اندرین عالم اگر دست دهد",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "نفروشم بهزاران عالم",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "این از آن من چه خوب و چه زشت",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "آن از آن تو چه بیش و چه کم",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "تا بسرسبزی دستور اجل",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "تا به اقبال امیر اعظم",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "باده روشن و گلگون گیریم",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "با رخی فرخ و جانی خرم",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "داور فضل و هنر میر نظام",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "شمع صاحبنظران صدر امم",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "آن ببستان هنر سبز درخت",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "باغ دولت را حی العالم",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "رخ زیبایش خورشید وجود",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "کف والایش دریای کرم",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "این بطغیان شداید صابر",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "آن بطوفان هزاهز محکم",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "تنش مجموعه آیات و کلم",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "دلش گنجینه آیات و حکم",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "رحمتش چیست سحابی وابل",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "غضبش چیست قضائی مبرم",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "ای قضا کرده بداندیش تولا",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "ای بامر تو فلک گفته نعم",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "کاه با مهرت از کوهی بیش",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "کوه با قهرت از کاهی کم",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "شهر تبریز همانست که بود",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "منبع فتنه و طغیان و ستم",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "روز در کوچه و بازار کسی",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "بتن تنها نگذاشت قدم",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "خانه ها یکسره بنگاه خطر",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "کوچه ها یکسسره دریای نقم",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "دیوها بودی در کسوت حور",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "گرگها بودی در جلد غنم",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "عصمت خلق از ایشان برباد",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "شادی مردم از ایشان ماتم",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "همه را دعوی حلوائی بود",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 86,
      "Position": "Left",
      "Text": "نو ز ناگشته عنبشان حصرم",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "روزگاری نگذشته است که تو",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "اندرین ملک نهادی مقدم",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "نوش در ساغر دیوان شده نیش",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "شهد در کاسه دونان شده سم",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 91,
      "Position": "Right",
      "Text": "لب استیزه ز بیمت شده لال",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 92,
      "Position": "Left",
      "Text": "گوش ظلم است ز بانگ تو اصم",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 93,
      "Position": "Right",
      "Text": "اژدها خوار حسام کج تو",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 94,
      "Position": "Left",
      "Text": "طعمه سازد دل شیران اجم",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 95,
      "Position": "Right",
      "Text": "ضیغم رایت فرخنده تو",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 96,
      "Position": "Left",
      "Text": "خواب خرگوش دهد بر ضیغم",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 97,
      "Position": "Right",
      "Text": "دیو عاجز شده گوئی دارد",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 98,
      "Position": "Left",
      "Text": "دست والای تو انگشتر جم",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 99,
      "Position": "Right",
      "Text": "یا در انگشت همایون تو شد",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 100,
      "Position": "Left",
      "Text": "خاتم مهر وصی خاتم",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 101,
      "Position": "Right",
      "Text": "آن علی ابن ابی طالب راد",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 102,
      "Position": "Left",
      "Text": "که بود ختم رسل را بن عم",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 103,
      "Position": "Right",
      "Text": "مالک عرصه امکان و حدوث",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 104,
      "Position": "Left",
      "Text": "خسرو کشور ایجاد و قدم",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 105,
      "Position": "Right",
      "Text": "ناز دارد ز نژادش حوا",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 106,
      "Position": "Left",
      "Text": "فخر سازد بوجودش آدم",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 107,
      "Position": "Right",
      "Text": "تیغ تیزش لسعی موسی کف",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 108,
      "Position": "Left",
      "Text": "لب لعلش خضری عیسی دم",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 109,
      "Position": "Right",
      "Text": "لب شیرینش سپهدار وجود",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 110,
      "Position": "Left",
      "Text": "تیغ رنگینش قلا ورز عدم",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 111,
      "Position": "Right",
      "Text": "ای باخلاص تومقبول نماز",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 112,
      "Position": "Left",
      "Text": "ای ز میلاد تو مسجود حرم",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 113,
      "Position": "Right",
      "Text": "هم توئی کوی نبی را محرم",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 114,
      "Position": "Left",
      "Text": "هم توئی راز خدا را محرم",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 115,
      "Position": "Right",
      "Text": "صدر والای مهین میر نظام",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 116,
      "Position": "Left",
      "Text": "خواجه راد و امیر اعظم",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 117,
      "Position": "Right",
      "Text": "کاسر خصم تو شد تا که بود",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 118,
      "Position": "Left",
      "Text": "رایت نصبش بر فتح تو ضم",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 119,
      "Position": "Right",
      "Text": "ای بهین مرتبه دستور اجل",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 120,
      "Position": "Left",
      "Text": "وی مهین پایه خداوند نعم",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 121,
      "Position": "Right",
      "Text": "بسکه دوشیزه طبعم بسرای",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 122,
      "Position": "Left",
      "Text": "ماند فرتوت شد و کوژ و دژم",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 123,
      "Position": "Right",
      "Text": "روح من عود سرودی همچون",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 124,
      "Position": "Left",
      "Text": "دخت ذوالاصبع یعنی اثرم",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 125,
      "Position": "Right",
      "Text": "این زمان از دم روح القدسی",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 126,
      "Position": "Left",
      "Text": "یعنی از نفخه آن فرخ دم",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 127,
      "Position": "Right",
      "Text": "حامل روح مدیح تو شده است",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    },
    {
      "VOrder": 128,
      "Position": "Left",
      "Text": "همچو بر نطفه عیسی مریم",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    }
  ]
}
