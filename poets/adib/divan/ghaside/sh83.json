      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "مجال خواب نداری درین سرای دو در",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
