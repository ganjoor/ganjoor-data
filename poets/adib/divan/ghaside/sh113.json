      "Position": "Left",
      "Text": "شسته ز رخ نقش پرده متلون",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "شد چو در آن آب غرق قافله شب",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
