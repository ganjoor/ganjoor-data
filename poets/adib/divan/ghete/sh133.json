      "VOrder": 2,
      "Position": "Left",
      "Text": "ثواب طاعت چل ساله آید از یزدان",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "بر این قیاس وزیر است اولین مؤمن",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "مسلم است سخن با دلیل و با برهان",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "که هم وزیر بخواب از نفاق و شر دورست",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "هم از بلای وی آسوده اند خلق جهان",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "چو او بخواب رود چشم فتنه در خوابست",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "زید زمانه تن آسان به مهد امن و امان",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "چو مزد خفتنش از کردگار این باشد",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "ثواب مردنش اندرچگونه است و چسان",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "بلی به مردن این خواجه کردگار بزرگ",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "سزد ز نو کند ایجاد حور و طرح جنان",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "هزار باغ بهشت آورد ز لطف پدید",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "هزار کوثر سازد به هر بهشت روان",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "هزار طوبی روید کنار هر کوثر",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "هزار حور کند زیر هر درخت مکان",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "قبا ز لعل بر از سیم و پیرهن ز حریر",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "کله ز مشک و رخ از لاله و لب از مرجان",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "بدست هر یک از آنان هزار جام و برو",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "صلا زنند که هان بوسه گیر و باده ستان",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "خدای عزوجل از سحاب همت وجود",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "برو فرستد باران رحمت و احسان",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "دهد قباله این باغ دست جبرائیل",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "نهد مفاتح آن روضه در کف رضوان",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "که زی وزیر شتابند و می بگویندش",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "همی ز گفته دادار داور سبحان",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "که پیکر تو سزوار دوزخ است و سزد",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "که می بسوزی تا روز حشر با شیطان",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "توئی که خانه بیداد کرده ای آباد",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "چنانکه از ستمت باغ داد شد ویران",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "ز بس چنین و چنان کرده ای به خلق بدی",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "ترا بباید کردن بسی چنین و چنان",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "گناه تو ز حیات تو بد کنون که رسید",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "ز مردن تو جهان را حیات جاویدان",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "بدوزخت نفرستم که اهل دوزخ را",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "کفایت است عذاب و شکنجه نیران",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "چو بندگان من از مردن تو آسودند",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "بود به چون تو گران جانی این بهشت ارزان",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "ایا وزیر موافق که زنده ات ثقلیست",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "به روده ثقلین و به معده ایران",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "جهانیان سزد ار قدر عافیت دانند",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "تو بر خلاف جهان قدر مرگ خویش بدان",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "که هم ز مرگ تهی گردد و بیاساید",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "سرت ز باد غرور و تنت ز بار گران",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "ز مردنت ملک الموت در فلک نازد",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "چنانکه عیسی از احیای زنده در کنعان",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "من ار لطیفه بگفتم ز روی دانش و فکر",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "ولیک نکته دیگر همی کنم عنوان",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "وزیر مؤمن خاصست لیک مسلم نیست",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "اگر چه عامست اسلام و خاص شد ایمان",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "بود مسلمان در شرع و آنکه مسلم را",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "گزند ناید از آزار او و بدست و زبان",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "بر این قیاس وزیر ارچه مؤمن است ولی",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "نه مسلم است که اسلام ازو رسیده به جان",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "کجا ز مسلم دین راست خار در دیده",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "کجا ز مسلم حق راست نار در شریان",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "کجا مسلمان گوید گزاف بر داور",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "کجا مسلمان جوید خلاف با قرآن",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "کجا مسلمان با مؤمنان کند حیلت",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "کجا مسلمان بر مسلمان زند بهتان",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "گر این مسلمان فاجر همی بود بوذر",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "گر این مسلمان کافر همی بود سلمان",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "گر این طریق مسلمانی است و این ره دین",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "سلام باد بر آن دواثیم و سه خوان",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "چنان ز آل مکرم ذلیل گشته کرام",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "که خاندان نبی از نژاد بوسفیان",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "چو تازیان صف ممتازیان همی تازند",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "به قصد صید گوزنان به جای شیر ژیان",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "ایا وزیر ستمگر که کردگار بزرگ",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "دهد سزایت یک بر هزار در دو جهان",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "ترا بتاری ایمان نه ای بلفظ فرانس",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "تمام پردگیان تواند بی ایمان",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "مرا ز پنجه جورت ز بعد پنجه سال",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "سرا چو خانه گور است و باغ چون زندان",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "به کنج غم ز جفای تو خون خورم گوئی",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "که من جنینم و گیتی همی بود زهدان",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "مرا زرشک بیغوله ای مکان دادی",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "چنانکه ناصرخسرو بغار در یمگان",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "عروس بخت ترا منشی قدر کابین",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "نبشته گاه به کابینه گه به پارلمان",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "معاشران و رفیقان و دوستانت را",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "که ایمنند به دهر از طوارق حدثان",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "درم به کیسه و می در پیاله یار ببر",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "جهان مسخر و گیتی به کام و حکم روان",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "مرا ز بعد دو سال انتظار خدمت و کار",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 86,
      "Position": "Left",
      "Text": "به جای رنج نشابور و زحمت سمنان",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "کنی روانه به ساوجبلاغ و خود باشی",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "وزیر عدلیه نائب مناب نوشروان",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "چرا نصیب تو از ملک نوش بی نیشست",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "چراست بهره من از تو درد بی درمان",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 91,
      "Position": "Right",
      "Text": "ترا چه پایه هنر بنده را چه عیب بود",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 92,
      "Position": "Left",
      "Text": "ترا زیاده کجا باشد و مرا نقصان",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 93,
      "Position": "Right",
      "Text": "بگو دلیل که تا ده بعذر پردازم",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 94,
      "Position": "Left",
      "Text": "بگو گناه که تا ده بیارمش تاوان",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 95,
      "Position": "Right",
      "Text": "بران امید بدم کز پی درستی و عدل",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 96,
      "Position": "Left",
      "Text": "عنایت تو بکارم دهد سر و سامان",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 97,
      "Position": "Right",
      "Text": "همی علاوه کنم افتخار و حشمت و جاه",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 98,
      "Position": "Left",
      "Text": "همی زیاده کنم اعتبار و شوکت و شان",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 99,
      "Position": "Right",
      "Text": "خلاص گردم از آن رنجهای پی درپی",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 100,
      "Position": "Left",
      "Text": "نجات یابم از آن ورطه های بی پایان",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 101,
      "Position": "Right",
      "Text": "به عکس آنچه همی داشتم ز بخت یقین",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 102,
      "Position": "Left",
      "Text": "خلاف آنچه همی بر دمی بخویش گمان",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 103,
      "Position": "Right",
      "Text": "مرا ترقی معکوس شد نصیب و نصیر",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 104,
      "Position": "Left",
      "Text": "مرا ستاره منحوس شد قرین و قران",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 105,
      "Position": "Right",
      "Text": "بجای آنکه ستانم نشان قدر و شرف",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 106,
      "Position": "Left",
      "Text": "بکاست قدرم و کم شد شرف برفت نشان",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 107,
      "Position": "Right",
      "Text": "ز آه سینه و طوفان دیده هر شب و روز",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 108,
      "Position": "Left",
      "Text": "در آتشم چو سمندر در آب چون سرطان",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 109,
      "Position": "Right",
      "Text": "ز ماه و کیوان وز بخت خود چرا نالم",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 110,
      "Position": "Left",
      "Text": "گنه تراست نه از بخت و نزمه و کیوان",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 111,
      "Position": "Right",
      "Text": "وزارت تو و ادبار من همی ماند",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 112,
      "Position": "Left",
      "Text": "بکار آنکه به سگ جو دهد به خر ستخوان",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 113,
      "Position": "Right",
      "Text": "رسید بر تن زار من از تو بس بیداد",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 114,
      "Position": "Left",
      "Text": "که دادم از تو ستاند خدای دادستان",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 115,
      "Position": "Right",
      "Text": "من از جفای تو آن دیدم ای وزیر که دید",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 116,
      "Position": "Left",
      "Text": "خلیل از پدر خویش و یوسف از اخوان",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 117,
      "Position": "Right",
      "Text": "وزارت تو همی گفت عدل را بدرود",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 118,
      "Position": "Left",
      "Text": "بلی کجا رمه ماند چو گرگ شد چوپان",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 119,
      "Position": "Right",
      "Text": "چه نالم آه عفاک الله آفرین به تو باد",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 120,
      "Position": "Left",
      "Text": "چه گویم اصلحک الله خانه آبادان",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 121,
      "Position": "Right",
      "Text": "مرا بکردان دادی قضا و خود گشتی",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 122,
      "Position": "Left",
      "Text": "ندیم ترکان در گلشن بهارستان",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 123,
      "Position": "Right",
      "Text": "به کوه و صحرا کردی رها و پرتابم",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 124,
      "Position": "Left",
      "Text": "گهی چو سنگ فلاخن گهی چو تیر کمان",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 125,
      "Position": "Right",
      "Text": "مگر بگورم از آن جایگه روان سازی",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 126,
      "Position": "Left",
      "Text": "که نیست قریه آن سو ترک ز عبادان",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 127,
      "Position": "Right",
      "Text": "که دور راشی و ایام مرتشی باشد",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    },
    {
      "VOrder": 128,
      "Position": "Left",
      "Text": "نه دور راستی و عدل و رأفت و احسان",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    },
    {
      "VOrder": 129,
      "Position": "Right",
      "Text": "شریح قاضی و فرزند بوشوارب را",
      "CoupletIndex": 64,
      "SectionIndex1": 0
    },
    {
      "VOrder": 130,
      "Position": "Left",
      "Text": "بود بنزد تو قدر و مقام و جاه و مکان",
      "CoupletIndex": 64,
      "SectionIndex1": 0
    },
    {
      "VOrder": 131,
      "Position": "Right",
      "Text": "نه مر مرا که ندارم بکژ روی پیوند",
      "CoupletIndex": 65,
      "SectionIndex1": 0
    },
    {
      "VOrder": 132,
      "Position": "Left",
      "Text": "نه مر مرا که نبرم ز راستی پیمان",
      "CoupletIndex": 65,
      "SectionIndex1": 0
    },
    {
      "VOrder": 133,
      "Position": "Right",
      "Text": "نه مر مرا که نظیرم نزاده مادر دهر",
      "CoupletIndex": 66,
      "SectionIndex1": 0
    },
    {
      "VOrder": 134,
      "Position": "Left",
      "Text": "به صدق لهجه و لطف کلام و حسن بیان",
      "CoupletIndex": 66,
      "SectionIndex1": 0
    },
    {
      "VOrder": 135,
      "Position": "Right",
      "Text": "ز رشک کلکم حسرت همی خورد وطواط",
      "CoupletIndex": 67,
      "SectionIndex1": 0
    },
    {
      "VOrder": 136,
      "Position": "Left",
      "Text": "ز شرم نطقم خجلت همی برد سحبان",
      "CoupletIndex": 67,
      "SectionIndex1": 0
    },
    {
      "VOrder": 137,
      "Position": "Right",
      "Text": "شود به نثر ثنا گسترم ابواسحق",
      "CoupletIndex": 68,
      "SectionIndex1": 0
    },
    {
      "VOrder": 138,
      "Position": "Left",
      "Text": "ز من ریاضی تحصیل کرده بوریحان",
      "CoupletIndex": 68,
      "SectionIndex1": 0
    },
    {
      "VOrder": 139,
      "Position": "Right",
      "Text": "شکسته خط سنبل به گل کند تعلیق",
      "CoupletIndex": 69,
      "SectionIndex1": 0
    },
    {
      "VOrder": 140,
      "Position": "Left",
      "Text": "رقاع نسخم نیلوفر آرد از ریحان",
      "CoupletIndex": 69,
      "SectionIndex1": 0
    }
  ]
}
