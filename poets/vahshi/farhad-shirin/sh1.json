  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "الهی سینه‌ای ده آتش افروز",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "در آن سینه دلی وان دل همه سوز",
