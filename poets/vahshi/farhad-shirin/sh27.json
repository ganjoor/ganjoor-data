  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "بدو فرهاد گفت که ای سرو نوخیز",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "لبت جان پرور و زلفت دلاویز",
