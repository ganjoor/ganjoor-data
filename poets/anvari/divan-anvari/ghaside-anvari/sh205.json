  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "با خاک در تو آشنایی",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آشنایی و همنشینی با خاک درگاه تو از هزار پادشاهی خوشایندتر است."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "خوشتر ز هزار پادشایی",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "دیده رخ راز مه ببیند",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چهرهٔ تو چنان روشن است که چشم در رخسار تو روی ماه را می‌بیند."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "بر عارض تو ز روشنایی",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "از نکتهٔ طوطی لب تو",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از سخن نغز لب شیرین‌گفتار تو، که چون طوطی سخن می‌گوید، سیمرغ شرمگین شد و گوشه‌گیری و پارسایی را برگزید."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "سیمرغ گزید پارسایی",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "جایی که زلب حیات بخشی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آنجا که تو با لب خود جان می‌بخشی، عیسی با دم زنده‌کنندهٔ خود همچون گدایی بر در تو است."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "عیسی بود از در گدایی",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "مهر تو و سینهٔ چو من کس",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: عشق تو در سینهٔ کسی چون من، مانند طاووس در خانهٔ روستایی است و با آن جا نمی‌خورد."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "طاوس و سرای روستایی",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "در خدمت عشق تست ما را",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در خدمت عشق تو دل ما امانتی است و جان ما بهایی است که می‌پردازیم."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "دل عاریتی و جان بهایی",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "بردی ز پری و آدمی هوش",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هوش پری و آدمی را ربودی؛ یک بار بگو که از آن کیستی."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "یک راه بگوی تا کرایی",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "در خانهٔ صبر فرقت تو",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دوری از تو در خانهٔ صبر هزار بینوایی و پریشانی افکنده است."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "افکند هزار بی‌نوایی",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "در دعوی حسن خود سخن‌گوی",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دربارهٔ ادعای زیبایی خود سخن بگو تا ماه بر آن گواهی دهد."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "تا ماه دهد بر آن گوایی",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "از کوی چو آفتاب از کوه",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تو از کوی خود مانند خورشید که از کوه برمی‌آید، به خدمت تاج‌الدین بیرون می‌آیی؛ اینجا شاعر از تغزل به مدح می‌رسد."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "در خدمت تاج دین برآیی",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "صورتگر عز پناه دولت",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ممدوح پدیدآورندهٔ عزت و پناه دولت و تکیه‌گاه دولت علایی است."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "معبرده دولت علایی",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "آن جان خرد که مر خرد را",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: او جانِ خرد است، و خرد تنها با فرمان‌بردن از او با حقیقت آشنا می‌شود."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "با طاعت اوست آشنایی",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "در نسبت آن شرف توان دید",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: شرف او در نسب و تبارش نمایان است، چنان‌که فضل خداوند در خداوندی او پیداست."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "چون فضل خدای در خدایی",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "نه چرخ گرفت و هفت اختر",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: یک اندیشهٔ او در شتاب از نُه فلک و هفت ستاره پیشی گرفت."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "یک فکرت او به تیزپایی",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "ای دیدهٔ ناظر نبوت",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای کسی که چشم نبوت بر توست، در ذات تو صفات پیامبر دیده می‌شود."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "در ذات تو دیده مصطفایی",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "چون روی خلقت نخواندت عقل",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چون خرد تو را از روی آفرینش ظاهری نشناخت، شایسته است که بدانی از نسل علی مرتضایی."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "شاید که ز پشت مرتضایی",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "خود عقل ترا کمال هرگز",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: عقل هرگز کمال تو را درنمی‌یابد و نمی‌داند که مقام تو تا کجاست."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "داند که ز جاه تا کجایی",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "پیش در تو قبول کرده",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: پیشانی سدرة‌المنتهی در برابر درگاه تو پذیرفته است که خاک پای تو باشد."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "پیشانی سدره خاک پایی",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "مرغ دل جبرئیل گیرد",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: مرغ دل جبرئیل در ستایش تو به سخن‌سرایی می‌پردازد."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "در مدحت تو سخن سرایی",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "اولاد بزرگ مرتضا را",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: خدایا، چه پیشوای بزرگی برای فرزندان بزرگوار علی مرتضاست!"
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "یارب چه بزرگ پیشوایی",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "کبر تو کم است و کبریا بیش",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: خودپسندی در تو اندک و بزرگی و شکوهت بسیار است؛ تو اهل تکبر نیستی، بلکه صاحب عظمتی."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "از کبر نه‌ای ز کبریایی",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "آن روز که عمر در غم مرگ",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در روز جنگ، که زندگی از ترس مرگ شادی و خوش‌رویی را از دست داده است،"
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "معزول بود ز خوش لقایی",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "نیلوفر تیغ چشمها را",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: شمشیر نیلگون چون نیلوفر، چشم‌ها را مانند لاله خونین و کوتاه‌عمر می‌کند."
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "چون لاله کند به کم بقایی",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "از نسبت فعل سایه گیرد",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در آن روز بانگ نای جنگ در هیبت به صدای صور قیامت می‌ماند."
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "در صدمت صور صوت نایی",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "از ساغر خوف تشنهٔ جنگ",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: کسی که تشنهٔ جنگ است، از جام ترس و ناامیدی سیراب می‌شود و دست از جنگ می‌کشد."
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "سیراب شود ز بی‌رجایی",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "جانهای مبارزان ز تنها",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در آن روز جان جنگاوران با شمشیر تو از تنشان جدا می‌شود."
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "بینند ز تیغ تو جدایی",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "این خاطر من ز غیبت تو",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ذهن من به سبب دوری از تو از ستایش شاه محروم مانده است."
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "محروم ز پادشا ستایی",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "دل در غم خدمت تو یک دم",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دلم در اندوه دوری از خدمت تو یک لحظه هم از رنج رهایی نیافته است."
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "نایافته از عنا رهایی",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "تا آمد مرگ جان غمگین",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: جان اندوهگینم چنان در هوای تو شیفته شده که گویی مرگ نزدیک آمده است."
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "گشته ز هوای تو هوایی",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "زنهار مرا مگو که رو رو",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: زنهار به من نگو که برو برو، تو شایستهٔ ماندن در شهر و نشستن بر حصیری."
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "تو در خور شهر و بوریایی",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "در غیبت تو خوش است ما را",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: و نگو که در نبودنت ما خوشیم و بهتر است به این سو نیایی."
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "آن به که بدین طرف نیایی",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "آخر به طریق لطف یکبار",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: سرانجام یک بار از سر مهربانی بنویس که برخیز، تا کی درنگ می‌کنی."
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "بنویس که خیز چند پایی",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "در خدمت دیگران چه کوشی",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: و بنویس که چرا در خدمت دیگران می‌کوشی، در حالی که بندهٔ خاندان مایی."
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "چون بندهٔ خاندان مایی",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "در جستن کرده گرد عالم",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: و بگو که چرا برای جست‌وجو مانند سنگ آسیا گرد جهان می‌چرخی."
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "گردنده چو سنگ آسیایی",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "در شکر علاء دین و دولت",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: و بگو که چرا در سپاس علاءالدین و دولت پیوسته شکر نمی‌خایی و به شیرینی سپاس نمی‌گویی."
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "پیوسته چرا شکر نخایی",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "از حضرت ما که روی کونست",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: و بپرس که چرا از درگاه ما که آبروی جهان است دوری می‌کنی."
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "دوری ز چه روی می‌نمایی",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "تا فائدهٔ نبات یابند",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تا زمانی که موجودات زمینی و آسمانی از گیاه و رستنی بهره می‌برند،"
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "اشکال زمینی و سمایی",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "حکم تو گسسته باد یارب",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: خدایا، فرمان تو از هر چون و چرایی آزاد باشد و کسی بر آن خرده نگیرد."
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "ار علت چونی و چرایی",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    }
  ]
}
