\u0022\u003E\u003Cp\u003Eکز ساده‌دلیش آرزوی شور و شر آمد\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn35\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eباس تو شهابیست که در کام شیاطین\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eبا حرقتش آتش چو شراب کدر آمد\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn36\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eخطم تو چه پروانه شود صاعقه‌ای را\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eکان را ز فلک دود و ز اختر شرر آمد\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn37\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eتو ساکنی و خصم تو جنبان و چنین به\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eزیرا که سکون حلیت کل سیر آمد\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn38\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eعنقا که ز نازک منشی جای نگه داشت\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eهرگز طرف دامنش از عار تر آمد\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn39\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eوز هرزه‌روی سر چو به هر جای فرو کرد\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eیک سال زغن ماده و یکسال نر آمد\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn40\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eای ملک‌ستانی که ز درگاه تو برخاست\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eهر مرغ که در عرصهٔ ملکی به پر آمد\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn41\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eمن بنده کز این پیش نزد زخم درشتی\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eگردون که نه احوال من او را سپر آمد\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn42\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eدر مدت ده سال که این گوشه و سکنه\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eدر قبهٔ اسلام مرا مستقر آمد\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn43\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eهر نور و نظامی که درآمد ز در من\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eاز جود تو آمد نه ز جای دگر آمد\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn44\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eگردون جگرم داد که احسان نه ز دل کرد\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eآن تو ز دل بود از آن بی‌جگر آمد\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn45\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eصدرا تو خداوند قدیمی نه مرا بس\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eآنرا که هنرهای من او را سمر آمد\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn46\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eاقران مرا زر ز طمع بیش تو دادی\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eزان در تو سخنشان همه چون آب زر آمد\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn47\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eاز خدمت فرخندهٔ تو باز نگشتند\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eهرگز که نه تشریف توشان بر اثر آمد\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn48\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eانعام تو بر اهل هنر گرچه به حدیست\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eکز شکر تو کام همه‌شان پر شکر آمد\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn49\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eنظمی که در احوال من آمد همه وقتی\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eاز فضل تو آمد نه ز فضل و هنر آمد\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn50\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eجانم که درو نقش هوای تو گرفتست\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eپاینده‌تر از نقش حجر بر حجر آمد\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn51\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eاقبال ز توقیع تو نقشی بنمودش\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eهرلحظه که بر غرفهٔ سمع و بصر آمد\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn52\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eاز تو نگزیرد که تو در قالب عالم\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eجانی و یقین است که جان ناگزر آمد\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn53\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eتا در مثل آرند که اندر سفر عمر\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eجان مرکب و دم‌زاد و جهان رهگذر آمد\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn54\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eیک دم ز جهان جان تو جز شاد مبادا\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eکز یک نظرت برگ چنین صد سفر آمد\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn55\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eمقصود جهان کام تو بادا که برآید\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eزان کز تو برآمد همه کامی که برآمد\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E",
      "PoemFormat": "Ghaside",
      "CoupletsCount": 55
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "خیزید که هنگام صبوح دگر آمد",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "شب رفت و ز مشرق علم صبح برآمد",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "نزدیک خروس از پی بیداری مستان",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "دیریست که پیغام نسیم سحر آمد",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "خورشید می اندر افق جام نکوتر",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "چون لشکر خورشید به آفاق درآمد",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "از می حشری به که درآرند به مجلس",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "زاندیشه چو بر خواب خماری حشر آمد",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "آغاز نهید از پی می بی‌خبری را",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "کز مادر گیتی همه کس بی‌خبر آمد",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "بر دل نفسی انده گیتی به سر آرید",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "گیرید که گیتی همه یکسر به سر آمد",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "بر بوک و مگر عمر گرامی مگذارید",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "خود محنت ما جمله ز بوک و مگر آمد",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "ای ساقی مه روی درانداز و مرا ده",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "زان می که رزش مادر و لهوش پسر آمد",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "بر من مشکن بیش که من توبه شکستم",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "زان دست که صد قلزم ازو یک شمر آمد",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "از دست گهر گستر دستور شهنشاه",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "دستی نه، محیطی که نوالش گهر آمد",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "دستور جلال‌الوزرا کز وزرا اوست",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "آن شاخ که در باغ جلالت به برآمد",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "صدری که تر و خشک جهان فانی و باقی",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "بر گوشهٔ خوان کرمش ماحضر آمد",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "جز بر در او قسمت روزی نکند بخت",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "آری چکند چون در رزق بشر آمد",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "هرگز چو فلک راه سعادت نکند گم",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "آن را که فلک سوی درش راهبر آمد",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "بی‌نعمت او بیخ بقا خشک لب افتاد",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "با همت او شاخ سخا بارور آمد",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "از همت او شکل جهانی بکشیدند",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "در نسبت او کل جهان مختصر آمد",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "ای شاه نشانی که ز عدل تو جهان را",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "در وصف نیاید که چه بختی به درآمد",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "عدل تو هماییست که چون سایه بگسترد",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "خاصیت خورشید در آن بی‌خطر آمد",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "نام تو بسی تربیت نام عمر داد",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "زان روی که عدل تو چو عدل عمر آمد",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "سرمایهٔ دریا نه به بازوی دلت بود",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "زین روی دفینش ز کران بر حذر آمد",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "کان در نظر رای تو نامد ز حقیری",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "آن چیست که آن رای ترا در نظر آمد",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "بی‌دست تو کس را به مرادی نرسد دست",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "بوسیدن دست تو از آن معتبر آمد",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "در شان نیاز آیت احسان و ایادیت",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "چون پیرهن یوسف و چشم پدر آمد",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "بر تو قدیمیست چنان کز ره تقدیر",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "نزد همه در کوکبهٔ خواب و خور آمد",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "عزم تو چه عزمیست که بی‌منت تدبیر",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "در هرچه بکوشید نصیبش ظفر آمد",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "عالم که ز نه برد به حیلت کلهی کرد",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "ترک کله قدر ترا آستر آمد",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "گردون که پی وهم مهندس نسپردش",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "آمد شد تایید ترا پی سپر آمد",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "اول قدم قدر تو بود آنکه چو برداشت",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "عالم همه زیر آمد و قدرت زبر آمد",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "صاحب که به سیر قلمش تیغ سکون یافت",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "حاتم که ز دست کرمش کان به سر آمد",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "اوصاف تو در نسبت آوازهٔ ایشان",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "وصف نفس عیسی و آواز خر آمد",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "در امر تو امکان تغیر ننهفتند",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "گویی که مثالی ز قضا و قدر آمد",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "در کین تو امید سلامت ننهادند",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "گویی که نشانی ز سعیر و سقر آمد",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "دشمن کمر کین تو از بیم تو بربست",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "نی را ز پی حملهٔ صرصر کمر آمد",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "از آتش باس تو مگر دود ندیدست",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "کز ساده‌دلیش آرزوی شور و شر آمد",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "باس تو شهابیست که در کام شیاطین",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "با حرقتش آتش چو شراب کدر آمد",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "خطم تو چه پروانه شود صاعقه‌ای را",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "کان را ز فلک دود و ز اختر شرر آمد",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "تو ساکنی و خصم تو جنبان و چنین به",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "زیرا که سکون حلیت کل سیر آمد",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "عنقا که ز نازک منشی جای نگه داشت",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "هرگز طرف دامنش از عار تر آمد",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "وز هرزه‌روی سر چو به هر جای فرو کرد",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "یک سال زغن ماده و یکسال نر آمد",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "ای ملک‌ستانی که ز درگاه تو برخاست",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "هر مرغ که در عرصهٔ ملکی به پر آمد",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "من بنده کز این پیش نزد زخم درشتی",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "گردون که نه احوال من او را سپر آمد",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "در مدت ده سال که این گوشه و سکنه",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "در قبهٔ اسلام مرا مستقر آمد",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "هر نور و نظامی که درآمد ز در من",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 86,
      "Position": "Left",
      "Text": "از جود تو آمد نه ز جای دگر آمد",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "گردون جگرم داد که احسان نه ز دل کرد",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "آن تو ز دل بود از آن بی‌جگر آمد",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "صدرا تو خداوند قدیمی نه مرا بس",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "آنرا که هنرهای من او را سمر آمد",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 91,
      "Position": "Right",
      "Text": "اقران مرا زر ز طمع بیش تو دادی",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 92,
      "Position": "Left",
      "Text": "زان در تو سخنشان همه چون آب زر آمد",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 93,
      "Position": "Right",
      "Text": "از خدمت فرخندهٔ تو باز نگشتند",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 94,
      "Position": "Left",
      "Text": "هرگز که نه تشریف توشان بر اثر آمد",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 95,
      "Position": "Right",
      "Text": "انعام تو بر اهل هنر گرچه به حدیست",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 96,
      "Position": "Left",
      "Text": "کز شکر تو کام همه‌شان پر شکر آمد",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 97,
      "Position": "Right",
      "Text": "نظمی که در احوال من آمد همه وقتی",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 98,
      "Position": "Left",
      "Text": "از فضل تو آمد نه ز فضل و هنر آمد",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 99,
      "Position": "Right",
      "Text": "جانم که درو نقش هوای تو گرفتست",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 100,
      "Position": "Left",
      "Text": "پاینده‌تر از نقش حجر بر حجر آمد",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 101,
      "Position": "Right",
      "Text": "اقبال ز توقیع تو نقشی بنمودش",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 102,
      "Position": "Left",
      "Text": "هرلحظه که بر غرفهٔ سمع و بصر آمد",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 103,
      "Position": "Right",
      "Text": "از تو نگزیرد که تو در قالب عالم",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 104,
      "Position": "Left",
      "Text": "جانی و یقین است که جان ناگزر آمد",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 105,
      "Position": "Right",
      "Text": "تا در مثل آرند که اندر سفر عمر",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 106,
      "Position": "Left",
      "Text": "جان مرکب و دم‌زاد و جهان رهگذر آمد",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 107,
      "Position": "Right",
      "Text": "یک دم ز جهان جان تو جز شاد مبادا",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 108,
      "Position": "Left",
      "Text": "کز یک نظرت برگ چنین صد سفر آمد",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 109,
      "Position": "Right",
      "Text": "مقصود جهان کام تو بادا که برآید",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 110,
      "Position": "Left",
      "Text": "زان کز تو برآمد همه کامی که برآمد",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    }
  ]
}
