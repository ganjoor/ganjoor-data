  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ای کلک تو پشت ملک عالم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای کسی که قلمت پشتیبان و نگهدار ملک جهان است و روزگارت برای همهٔ دوران آدمیان چون روز عید است."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "وی روز تو عید دور آدم",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "هرچ آمده زیر آفرینش",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هرچه در زیر آفرینش پدید آمده، از اندازهٔ بزرگی و شکوه تو کمتر است."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "زاندازهٔ کبریای تو کم",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "وقتی که هنوز آسمان طفل",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در آن هنگام که آسمان هنوز کودک و تازه‌آفریده بود، آدم به طفیل و به خاطر تو گرامی داشته شد؛ یعنی حقیقت تو پیش از آفرینش بوده است."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "آدم به طفیل تو مکرم",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "در سلسلهٔ زمان مخر",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تو در زنجیرهٔ زمان پس‌تر آمده‌ای، اما در طرح و نقشهٔ آفرینش جهان مقدم و پیشتری."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "بر هندسهٔ جهان مقدم",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "عدل تو شبی چو روز روشن",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: عدل تو شب را چون روز روشن می‌کند و روزگار تو چون روز عید شاد و خرم است."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "روز تو چو روز عید خرم",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "با رای تو چرخ در مصالح",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آسمان در کارهای مصلحت‌آمیز در برابر اندیشهٔ تو آواز برمی‌دارد که هان، سخن بگو و فرمان ده."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "الحان‌کنان که هان تکلم",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "با عزم تو دهر در مسالک",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: روزگار در راه‌ها همراه عزم تو پافشاری می‌کند که هین، پیش برو."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "اصرارکنان که هین تقدم",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "صدر تو به پایه تخت جمشید",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: جایگاه صدارت تو در بلندی هم‌پایهٔ تخت جمشید است و اسب سپید تو در شکوه هم‌سایهٔ رخش رستم."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "خنگ تو به سایه رخش رستم",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "در موکب تو به میخ پروین",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در موکب تو ماه نو با میخ‌هایی از ستارگان پروین چون نعل بر سم مرکب‌هایت استوار شده است."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "مه بر سم مرکبانت محکم",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "در کوکبهٔ تو طرهٔ شب",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در جلوهٔ شکوه تو، گیسوی سیاه شب چون پرچم بر نیزهٔ بندگانت آویخته است."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "بر نیزهٔ بندگانت پرچم",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "وز عکس طراز رایت تو",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از بازتاب نقش و نگار پرچم تو، بلندی و پیروزی گویی تجسم یافته‌اند."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "آن رفعت ونصرت مجسم",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "بر دوشت فلک قبای کحلی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آسمان چون قبای لاجوردی بر دوش توست و در چشم قضا نقش‌دار و حاشیه‌دوزی‌شده جلوه کرده است."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "در چشم قضا نموده معلم",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "در دست تو کارنامهٔ جود",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در دست تو دفتر کارهای بخشش است و در برابر جاه تو شکوه و کرّوفر جمشید ناچیز است."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "با جاه تو بارنامهٔ جم",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "بر آب روان نگاه دارد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: نگهبانی و حفظ تو چنان نیرومند است که نقش نگین را بر آب روان نیز نگاه می‌دارد."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "حفظ تو نشان نقش خاتم",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "در شوره ز فتح باب دستت",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از گشاده‌دستی و بخشش تو، دریا در زمین شوره‌زار هم‌پای نیروی رویاننده روان می‌شود و آن را آباد می‌کند."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "با نامیه هم عنان رود یم",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "در گرد جنیبت نفاذت",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: حتی قضای قطعی و حتمی به گرد اسب یدک نفوذ فرمان تو نمی‌رسد."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "هرگز نرسد قضای مبرم",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "در خشم تو عودهای رحمت",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در خشم تو نیز بازگشت‌های رحمت هست و همراه زخم تو مرهم‌های آماده هست."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "با زخم تو سفتهای مرهم",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "سبحان‌الله که دید هرگز",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: شگفتا، چه کسی هرگز آب زمزم را در آتش دوزخ دیده است؟ یعنی آمیختن مهر در خشم تو شگفت است."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "در آتش دوزخ آب زمزم",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "نوک قلم ترا پیاپی",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: نوک قلم تو پیوسته و خاک قدم تو همواره...؛ ادامهٔ معنا در بیت بعد است."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "خاک قدم ترا دمادم",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "اعجاز کف کلیم عمران",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: معجزهٔ دست موسی پسر عمران و اثر دم زنده‌کنندهٔ عیسی پسر مریم را دارد؛ یعنی قلمت معجزه می‌کند و خاک پایت جان می‌بخشد."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "آثار دم مسیح مریم",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "اسرار قضا نهاده کلکت",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: قلم تو رازهای قضا و تقدیر را در نقطه‌ها و خط حروف نقطه‌دار نهاده است."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "در خال و خط حروف معجم",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "آنجا که صریر او مقرر",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آنجا که صدای قلم تو برقرار است، عطارد که دبیر آسمان است در برابرش لال می‌ماند."
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "در معرض او عطارد ابکم",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "توقیع تو در دیار دولت",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: فرمان و امضای تو در سرزمین دولت، کارها را به‌طور قطعی و مسلم واگذار می‌کند."
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "تفویض همی کند مسلم",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "هر صدر به صاحبی مؤید",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به‌واسطهٔ توقیع تو هر صدر وزارت به صاحب‌منصبی تأیید می‌شود و هر تختی به پادشاهی بزرگ می‌گردد."
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "هر تخت به خسروی معظم",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "در عدل تو آوخ ار نبودی",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: افسوس اگر عدل تو نبود، آبادانی و ساختمان آفرینش درهم فرو می‌ریخت."
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "معماری کاینات مدغم",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "زیر لگد نحوس هستی",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: و زیر لگد نحوست‌های هستی، بام هر هفت آسمان شکسته می‌شد."
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "هر هفت فلک شکسته طارم",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "باطل شدهٔ قضای قهرت",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آنچه قضای قهر تو نابود کند، حتی در رستاخیز بزرگ هم دوباره پدید نمی‌آید."
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "حاصل نشود به حشر اعظم",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "کز بیم ملامت نشورش",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: زیرا از ترس سرزنش زنده کردن آن، نفس در روزن صور اسرافیل بریده می‌شود."
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "در منفذ صور بگسلد دم",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "گر قهر تو بر فلک نهد پای",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر خشم تو بر آسمان پا بگذارد، در محور جهان کجی و خمیدگی پدید می‌آورد."
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "در محور عالم افکند خم",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "تاب سخطت زمین ندارد",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: زمین تاب خشم تو را ندارد، چه رسد به زمین، آسمان هم تاب آن را ندارد."
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "چه جای زمین که آسمان هم",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "تا عرصهٔ عالم عناصر",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تا زمانی که میدان جهان عناصر از شادی و غم خالی نباشد،"
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "خالی نبود ز شادی و غم",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "شادی و سعادت تو بادا",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: شادی و نیک‌بختی تو همراه با اصل نظم جهان پایدار باشد."
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "با عنصر انتظام عالم",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "عمرت همه ملک و ملک باقی",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: همهٔ عمرت پادشاهی و پادشاهی‌ات پایدار باشد، و همهٔ روزگارت عید و عیدت شاد باشد."
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "دورت همه عید و عید خرم",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "واندر دو جهان مخالفت را",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: و دشمنانت در هر دو جهان با ناتوانی و سختی و رنج درآمیخته باشند."
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "با عجز و عنا و رنج در هم",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "با سخرهٔ سیلی حوادث",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: یا گرفتار سیلی حوادث روزگار باشند یا در کورهٔ آتش دوزخ."
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "یا کورهٔ آتش جهنم",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "نازان ز تو در صدور فردوس",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: و نیاکان و پدر و برادر و عموی تو در صدرهای بهشت به تو بنازند."
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "جد و پدر و برادر و عم",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    }
  ]
}
