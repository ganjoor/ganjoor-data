      "Position": "Right",
      "Text": "پس آنگه نوبت پائیز آید",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 38,
      "Position": "Left",
