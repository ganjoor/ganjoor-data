    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": " مستحق سجود جز او نیست",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": " زآنکه معبود انس و جان است او",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: چرا که او معبود دل‌ها و جان‌هاست، و خالق بدن، عقل و روح نیز اوست."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": " مبدع جسم و عقل و جان است او",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": " در رهش چرخ و انجم و ارکان",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: در راه او، تمام آسمان‌ها و ستاره‌ها و عناصر زمین، همگی در حیرت و گیجی به سر می‌برند."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": " همه درمانده‌اند و سرگردان",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": " همه پوینده‌اند در طلبش",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: همه به دنبال او هستند و شب و روز در جستجوی او می‌باشند."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": " همه جوینده‌اند روز و شبش",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": " جنبش هر یک از سرشوق است",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: هر حرکت و جنبش هر فرد از روی شادی و اشتیاق است و هر کدام از آن‌ها به دنبال لذتی خاص هستند."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": " هر یکی را از این طلب ذوق است",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": " حلقة حکم اوست شوق‌ همه",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: دوایر فرمان و اراده او، حاکم بر همه شوق‌ها و آرزوهاست. او از هر نوع شوق و ذوق پاک و منزه است."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": " او منزه زشوق و ذوق همه",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": " نامهای بزرگ طاهر او",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: نام‌های بزرگ او نمایانگر ویژگی‌های خوب و زیبایی‌های آفرینش او هستند."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": " هست اوصاف صنع ظاهر او",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": " فارغ از شوق و ذوق ونیک‌وبدست",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: این جمله به این معناست که در حالت آزاد و بدون هر گونه احساسات و هیجانات، چیزی وجود دارد که فراتر از تصورات و اندیشه‌های عادی انسان‌هاست."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": " برتر از وهم و فکرت‌وخردست‌",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "کس نداند که چیست الا او",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "CoupletSummary": "هوش مصنوعی: هیچ‌کس نمی‌داند او چه‌کسی است جز خود او؛ تنها اوست که صفاتش گفته می‌شود: «جز او هیچ معبودی نیست»."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": " صفتش ‌لا اله االا هو",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": " هر که خواهد که ذکر او گوید",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17,
      "CoupletSummary": "هوش مصنوعی: هر کس بخواهد دربارهٔ او صحبت کند، زبانش قادر نیست تنها با یک کلمه \u0022هو\u0022 (او) او را وصف کند."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": " در نگنجد زبان که «‌هو» گوید",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": " به زبان ذکر او که داند گفت‌؟",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18,
      "CoupletSummary": "هوش مصنوعی: کسی نمی‌داند چگونه باید از ذکر خداوند سخن گفت. تنها روح و جان است که می‌تواند به طور حقیقی نام او را بگوید."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": " جان بود آنکه «هو» تواند گفت",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": " سخن است آنکه بر زبان آید",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19,
      "CoupletSummary": "هوش مصنوعی: سخن حقیقی آن است که از دل و جان برآید، ذکر «هو» که همان نام خداست، از عمق وجود انسان سرچشمه می‌گیرد."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": " ذکر «‌هو» از میان جان آید",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": " گرچه بی‌جا و بی مکان است او",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20,
      "CoupletSummary": "هوش مصنوعی: هرچند او در جایی مشخص و معین نیست، اما در دل آن کسانی که شکست خورده‌اند و غمگین هستند، حضور دارد."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": " ساکن دل شکستگانست او",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": " نه به ذاتست ساکن هر دل",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21,
      "CoupletSummary": "هوش مصنوعی: هر دل به خودی خود آرام نیست، بلکه این لطف اوست که به دل‌ها سکون و آرامش می‌بخشد."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": " بلکه لطفش همی کند منزل",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": " هر کجا دل شکسته‌ای بینی",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22,
      "CoupletSummary": "هوش مصنوعی: هر کجا که دل‌های شکسته و درماندگی را ببینی، آثار ناامیدی و خستگی نیز در آنجا مشاهده می‌شود."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": " بینوایی و خسته‌ای بینی ،",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": " بی زبان ذکر او از او شنوی ",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23,
      "CoupletSummary": "هوش مصنوعی: بی‌زبان می‌تونی نام او را از خود او بشنوی و معنا و تفسیر اسم‌های او را هم از خود او بگیری."
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": " شرح اسماء «‌هو» از او شنوی ",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "ذکر او از زبان بسته طلب",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24,
      "CoupletSummary": "هوش مصنوعی: به یاد آوردن او از زبان خاموش و درخواست شناخت از قلبی که شکسته و رنجیده است."
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "معرفت از دل شکسته طلب",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": " چند، بی او به‌کعبه درتک و پوی",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25,
      "CoupletSummary": "هوش مصنوعی: برای مدتی بی‌او در کعبه به جست‌وجو بپرداز، اما در عین حال به خرابات برو و او را پیدا کن."
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": " در خرابات آی و او را جوی",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": " چون تو در جستنش نمایی جد ",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26,
      "CoupletSummary": "هوش مصنوعی: هرگاه به دنبالش بروی و کوششی جدی کنی، به دنبال او در مکان‌های ناب یا در مساجد هم می‌توانی بگردی."
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": " در خرابات جست یا مسجد ",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    }
  ]
}
