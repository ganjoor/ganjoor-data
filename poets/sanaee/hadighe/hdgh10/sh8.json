  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ابن خطّاب آن به مردی فرد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: ابن خطّاب از مردی به نام کعب احبار برای ما چیزهایی نقل کرده است."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "کعب احبار ازو روایت کرد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "گفت اگر نه ز بهر این سه خصال",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: گفت اگر این سه ویژگی در تو نبود، زندگی‌ات به بار نخواهد آمد و بی‌فایده خواهد بود."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "بودیی بودمی حیات وبال",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
