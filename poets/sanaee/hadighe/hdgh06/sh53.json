    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "راغ پر فرشهای بوقلمون",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "شاخها حلّه‌پوش و مشک آغوش",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: شاخه‌ها مانند پیراهنی زیبا پوشیده شده و عطر خوشی از دشت به مشام می‌رسد که مانند مشک است و این دشت به زیبایی مینا آراسته شده است."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "دشت عنبر نهاد و مینا پوش",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "شبنمِ اشک چون سهیل و سها",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: اشک‌هایی که مانند شبنم هستند، زیبایی و درخشندگی دارند و چهره‌اش مانند صبحگاه به شادابی گل‌هاست."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "روی چون بامداد روی گیا",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "عنبرین گشته از نسیم صبا",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: به خاطر نسیم صبحگاهی، عطر خوشی در هوا پراکنده شده و زمین نیز از این عطر معطر شده است."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "از مسام زمین مشام هوا",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "سرو چون حور سبز پیراهن",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: سرو مانند یک حور، با پیراهنی سبز و خوشبو، عطر مشک و عنبر را بر دامن خود پاشیده است."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "مشک و عنبر دمیده بر دامن",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "باغ مانند عطر مشک آگین",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: باغ مانند عطر مشک خوشبو و معطر است و راه مانند موهای زیبا و دلربای دختران بهشتی جلوه‌گری می‌کند."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "راغ مانند زلفِ حورالعین",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "چشمهٔ اشک چشم من بشتاب",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: چشمهٔ اشک چشم من، سریع‌تر بیا تا در باغی که از لب آب رفته، حضور پیدا کنیم."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "تا درِ باغ رفته از لبِ آب",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "خامه بر کار کرده شست بهار",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: دست بهار با دقت و ظرافت، بر روی زلف‌های کوتاه شده کار کرده و آن‌ها را به زیبایی مرتب کرده است."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "زلف کوتاه کرده دست بهار",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "نی چنانست گردش بی‌باک",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "CoupletSummary": "هوش مصنوعی: نی به شکلی شجاعانه و بدون ترس، زلف‌های شب را در بر می‌گیرد و آن را به سمت خاک می‌کشاند."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "زلف شب را گرفته کش سوی خاک",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "گر بخواهد به حکم خلق کمال",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17,
      "CoupletSummary": "هوش مصنوعی: اگر بخواهد، به فرمان مردم، به کمال و تمام، خون را مانند مشک خواهد کرد و مشک نیز در حال خون در می‌آید."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "خون کند مشک و مشک خون در حال",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "صفت گل کنون به قوّت دل",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18,
      "CoupletSummary": "هوش مصنوعی: بلبل به قدرت دل، از زیبایی گل سخن می‌گوید، مانند شخص عاقل که با فهم و درک صحیح صحبت می‌کند."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "گفت بلبل چو مردم عاقل",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "دشتها را لباسها رنگین",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19,
      "CoupletSummary": "هوش مصنوعی: دشت‌ها را مانند لباسی رنگین پوشانده و باغ‌ها را با زیورهای زیبای حلّه تزیین کرده است."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "باغها را ز حلّه‌ها آذین",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "کوه پر نقشها همه زیبا",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20,
      "CoupletSummary": "هوش مصنوعی: کوه‌ها که پر از نقش و نگار هستند، بسیار زیبا به نظر می‌رسند. ستاره‌ها در آسمان مانند هنرمندانی هستند که بر پارچه‌ای زیبا نقاشی می‌کنند."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "اختران نقش‌بند بر دیبا",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "شاخ مانند عقد پر لؤلؤ",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21,
      "CoupletSummary": "هوش مصنوعی: شاخ مانند رشته‌ای از مروارید است و باد همچون عطر دل‌انگیز آهو می‌وزد."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "باد مانند نافهٔ آهو",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "باغ پرحقه‌های درّ و گهر",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22,
      "CoupletSummary": "هوش مصنوعی: باغی پر از جواهرات قیمتی و درخشان، جایی که درختانش پر از شاخه‌های نقره‌ای و طلایی هستند."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "راغ پُر شفشه‌های نقره و زر",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "گنج قارون به دامن سنگی",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23,
      "CoupletSummary": "هوش مصنوعی: گنج قارون در دامن سنگی زیبا و جذاب حورا به وضوح و در رنگ‌های مختلف نمایان است."
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "زیب حورا عیان به هر رنگی",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "قطر باران چو دانه‌های گهر",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24,
      "CoupletSummary": "هوش مصنوعی: باران به قطره‌هایی شبیه به مروارید بر روی گل‌های شقایق نشسته، مانند جواهراتی زیبا و درخشان است."
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "بر شقایق چکیده همچو دُرر",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "قُمری و فاخته فراز چنار",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25,
      "CoupletSummary": "هوش مصنوعی: یک قمری و یک فاخته در بالای درخت چنار نشسته‌اند و از عاشقانی که صبر و آرامش دارند، سخن می‌گویند."
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "برده از عاشقان شکیب و قرار",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "سرو چون حور در میان چمن",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26,
      "CoupletSummary": "هوش مصنوعی: سرو مانند یک پری زیبا در میان چمن‌هایی با عطر خوش مشک قرار دارد."
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "سمن مشک‌بیز پیرامن",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "پایهٔ ابر همچو درّ خوشاب",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27,
      "CoupletSummary": "هوش مصنوعی: پای ابر مانند مرواریدی از آب شیرین به‌نظر می‌رسد که از مرز ارمنستان و سلاخ (سکلا) به‌سوی ما می‌آید."
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "آمد از حد ارمن و سقلاب",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "مرغ نالان فراز گلبن گل",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28,
      "CoupletSummary": "هوش مصنوعی: پرنده‌ای غمگین بر فراز باغ گل، در حالی که گل‌ها سرمست و شاداب هستند، بدون هیچ نوازنده و شرابی آواز می‌خواند."
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "مست بی‌مطربان و ساغر مُل",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "ابر شسته ز روی هامون پاک",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29,
      "CoupletSummary": "هوش مصنوعی: ابر، پس از بارش، آسمان را پاک کرده و هر گونه آلودگی را از روی زمین می‌زداید."
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "هرچه آلایشست از رخ خاک",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "راز دل کرده جمله عالم فاش",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30,
      "CoupletSummary": "هوش مصنوعی: دل انسان پر از رازها و پنهانی‌هاست که همهٔ دنیای اطراف این موضوع را می‌دانند، اما افرادی که عاقل و زیرک هستند، مانند آدم‌های بی‌خبر و بی‌توجه نمی‌توانند به این رازها پی ببرند."
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "زیرکان زمانه چون اوباش",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "خانه بگذاشته همه زن و مرد",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31,
      "CoupletSummary": "هوش مصنوعی: همه مردان و زنان خانه های خود را ترک کرده و به سمت بیابان بیرون رفته‌اند تا به تفریح و خوش‌گذرانی بپردازند."
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "سوی صحرا برون شده پی خورد",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "خنک آنکس که او به فصل بهار",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 32,
      "CoupletSummary": "هوش مصنوعی: خوش به حال کسی که در فصل بهار از زندگی لذت می‌برد و از عشق و محبت بی‌نصیب نیست."
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "لذّتی دارد او ز بوس و کنار",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "خانهٔ چین گشاده منظر اوی",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 33,
      "CoupletSummary": "هوش مصنوعی: خانهٔ چین به روی او گشوده است و شاه قیصر دخترش را به او داده است."
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "شاه قیصر نموده دختر اوی",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "خم زلف بنفشهٔ دل جوی",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 34,
      "CoupletSummary": "هوش مصنوعی: در کنارهٔ جوی، زلف‌های بنفشه‌ای که می‌بیند، مانند عود خامی است که به تازگی از روی آب سبز شده و زنده شده است."
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "عود خامست رُسته بر لبِ جوی",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "ناف آهو چو خورد سنبل دشت",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 35,
      "CoupletSummary": "هوش مصنوعی: وقتی که ناف آهو شاخساری را خورد، بوی خوش آن در همه جا پخش شد و حتی به دورترین نقاط کوه قاف و طور رسید."
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "بویش از کوه قاف و طور گذشت",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    }
  ]
}
