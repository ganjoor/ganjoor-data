  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "بود در شهر بلخ بقّالی",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "بی‌کران داشت در دکان مالی",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ز اهل حرفت فراشته گردن",
