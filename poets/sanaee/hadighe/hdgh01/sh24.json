  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "کرد روزی عمر به رهگذری",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: روزی جانی به مسیر رفت و آمدی برخورد کرد و به گروهی از کودکان نگاهی انداخت."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "سوی جوقی ز کودکان نظری",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "همه مشغول گشته در بازی",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: همه درگیر مشغله‌ها و بازی‌های خود شده‌اند و هرکسی به نوعی در تلاش است تا خود را برجسته کند."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "کرده هریک همی سرافرازی",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "هریکی از پس مصارعتی",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: هر کسی بعد از یک رقابت یا چالش، نشان داد که چه قدر از خود تلاش و کوشش کرده است."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "بنمودی ز خود مسارعتی",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "برکشیده برای خطّ و ادب",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: برای نشان دادن اهمیت خط و ادب، به سبک عربی، لباس را از سر برداشته‌اند."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "جامه از سر برون به رسم عرب",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "چون عمر سوی کودکان نگرید",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: وقتی عمر به سمت کودکان و نوجوانان توجه کند، جلال و شکوه او مانند پرده‌ای از شادی و سرور فرو می‌ریزد."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "حشمتش پردهٔ طرب بدرید",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "کودکان زو گریختند به تفت",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: کودکان از آنجا فرار کردند و به بیابان رفتند، جز عبدالله زبیر که نرفت."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "جز که عبدالله زبیر نرفت",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "گفت عمّر ز پیش من به چه فن",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: او می‌گوید: عمر از من پرسید که چرا به تو نگاه می‌کردم، و من جواب دادم..."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "تو بنگریختی بگفتا من",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "چه گریزم ز پیشت ای مُکرم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: من چگونه می‌توانم از پیش تو فرار کنم، در حالی که نه تو ستمگری و نه من گناهکارم؟"
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "نه تو بیدادگر نه من مُجرم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "نزد آنکس که دید جوهر خود",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: هر کس که به عمق وجود خود را بشناسد و حقیقت خود را ببیند، دیگر برایش مهم نیست که دیگران او را بپذیرند یا رد کنند، خوب یا بد بدانند."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "چه قبول و چه رد چه نیک و چه بد",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "میر چون جفت دین و داد بود",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: وقتی که حاکم مثل دین و عدالت باشد، مردم از عدل و انصاف او خوشحال و راضی هستند."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "خلق را دل ز عدل شاد بود",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "ور بود رای او سوی بیداد",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: اگر اندیشه او به سمت ستم برود، تمام هستی‌اش را به باد خواهد داد."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "ملک خود داد سر به سر بر باد",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "نیک باشی ز دردسر رستی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: اگر خوبی کنی، از مشکلات و نگرانی‌ها رها می‌شوی، اما اگر بد باشی، همه‌ی عهد و پیمان‌هایت را خواهی شکست."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "ور بدی جمله عهد بشکستی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "چون گرفتی ز عدل توشهٔ خویش",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: زمانی که تو از عدالت خود بهره‌برداری کردی، مرکب تو (وسایل و ابزار تو) دو منزل جلوتر از قبل است."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "مرکب تو بود دو منزل پیش",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "آنچنان شو به حیرت آبادش",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: آنقدر در شگفتی به سر ببر که دیگر هیچ چیزی از یاد نرود."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "که دگر یاد ناید از یادش",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    }
  ]
