      "Position": "Left",
      "Text": "مایه صورت‌پذیر و جسم صوَر",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "عشق را گفت جز زمن مهراس",
