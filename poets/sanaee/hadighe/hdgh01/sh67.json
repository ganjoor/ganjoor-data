    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "هرچه خواهد سبک ز وی بپذیر",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "به تلطّف بدار و بنوازش",
