      "Position": "Right",
      "Text": "گل عمر کسی که گِل خواهد",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "کی دهد گلش اگرچه دل خواهد",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "کی شود بی‌سبب نمودهٔ تو",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "بودهٔ حق چو عقل پودهٔ تو",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "سخت بسیار کس بود که خورد",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "قدح زهر صرف و زان نَمرد",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "بلکه او را غذای جان باشد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "که ز بحران چو خیزران باشد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "همه را از طریق حکمت و داد",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "آنچه بایست بیش از آن همه داد",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "پیل را پشه گر بدرّد پوست",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "گو بران گوشت پشه‌ران با اوست",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "شپش ار هست ناخنت هم هست",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "کیک را گوش مال چون برجست",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "کوه اگر پر ز مار شد مشکوه",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "سنگ و تریاک هست هم در کوه",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "ور ز گزدم به دل نشان داری",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "کفش و نعل از برای آن داری",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "درد در عالم از فراوان است",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "هریکی را هزار درمان است",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "درهم آویخت از پی تصویر",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "کرهٔ زمهریر و چرخ اثیر",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "معتدل بهر جنبش گل را",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "سردی مغز گرمی دل را",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "جگر و دل ز اکحل و شریان",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "سوی تن باد و آب کرده روان",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "تا جسد را به واسطهٔ دم و خون",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "جان دهد این به جنبش آن به سکون",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "ملکوتست و ملک در عالم",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "زبر تخت نور و تحت ظلم",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "کرد بخش این دو مایه را در صُنع",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "چون بگسترد سایه را بر صُنع",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "ملکوت از شرف روان دارد",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "ملک از راه لطف جان دارد",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "تا درون و برون پذیرد قوت",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "تن ز ذی‌الملک و جان ز ذی‌الملکوت",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "نوش دان هرچه زهر او باشد",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "لطف دان هرچه قهر او باشد",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "باشد از مادران ما بر ما",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "هم حجامت نکو و هم خرما",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    }
  ]
}
