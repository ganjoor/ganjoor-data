    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "جان ربود و سپر تن به وجل",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "گرچه این بیتها تمام نشد",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "تیغ گفتار در نیام نشد",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "آنچه گفتم نظام او به کمال",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "هست چون شمس و ماه و آب زلال",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "اگر اندر جهان مقام بُدی",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "گفت من تا ابد تمام بُدی",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "چون برفتم به عذر معذورم",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "پیش استاد دین چو مزدورم",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "یارب این عذر گفته‌ها بپذیر",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "به خطاها و کردهام مگیر",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 60,
      "Position": "Right",
      "Text": "تو که خواننده‌ای دعاگو باش",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "دین نگهدار و جای جان جو باش",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 62,
      "Position": "Right",
      "Text": "چون ترا جای جان برون از جاست",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "پاک جان‌دار اگر نه بیم عناست",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 64,
      "Position": "Right",
      "Text": "که چو خاکی تنت به خاک شود",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 65,
      "Position": "Left",
      "Text": "پاک باید که جای پاک شود",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 66,
      "Position": "Right",
      "Text": "من ز کردار و گفت ترسانم",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 67,
      "Position": "Left",
      "Text": "بو که گیرند هردو آسانم",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 68,
      "Position": "Right",
      "Text": "لیکن ای دوست رفتنم زین‌سان",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 69,
      "Position": "Left",
      "Text": "گر بخواهی تو هم کنون آسان",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 70,
      "Position": "Right",
      "Text": "کرد خود گِرد خود درآوردم",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 71,
      "Position": "Left",
      "Text": "آنچه کردم ز دهر آن بُردم",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 72,
      "Position": "Right",
      "Text": "تو چنان دان که همچنین باشی",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 73,
      "Position": "Left",
      "Text": "جهد کن تا مرید دین باشی",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 74,
      "Position": "Right",
      "Text": "چون ترا دین بود مرید لحد",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 75,
      "Position": "Left",
      "Text": "یافتی خلعت ثنای احد",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    }
  ]
}
