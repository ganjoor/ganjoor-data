  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "از عقوبت سه حرف بیش مگیر",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: تنها سه حرف از مجازات و عواقب را در نظر بگیر و در پذیرش آن، به وسوسه‌های د evil دل نبند."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "با و تا را ز دیو در مپذیر",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "بر تن از راه رفق بر تن خصم",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: با نرمی و مهربانی به دشمن نزدیک شو و از روی خوی او آگاه شو؛ سپس نقاط ضعف او را پیدا کن و بر آن‌ها تمرکز کن."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "بشکن از روی خُلق گردن خصم",
