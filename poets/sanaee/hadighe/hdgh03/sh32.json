  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": " ذکر الحسین یضئی العینین سلالة الانبیاء و ولدالاصفیا والاولیاء والاوصیاء و شهید الکربلاء و قرّة عین المصطفی، بضعة المرتضی و کبد فاطمة‌الزهراء رضی‌اللّٰه عنه و عن‌والدیه، قال‌اللّٰه سبحانه و تعالی عزّ من قائل فی‌محکم کتابه: ان‌الذین یؤذون‌اللّٰه و رسوله لعنهم اللّٰه فی‌الدنیا والآخرة واعدّ لهم عذاباً مهیناً و اولئک هم‌الخاسرون، و قال النّبی علیه‌السّلام: ترکت کتاب‌اللّٰه و عترتی فاخبر ان و عداللّٰه حق.",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Right",
      "Text": "پسرِ مرتضی امیر حسین",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Left",
      "Text": "که چنویی نبود در کونین",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Right",
      "Text": "منبتِ عزّ نباهتِ شرفش",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Left",
      "Text": "حشمتِ دین نزاهتِ لطفش",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "مشربِ دین اصالتِ نسبش",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "منصبِ دین نزاهتِ ادبش",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "اصل او در زمین علّیّین",
