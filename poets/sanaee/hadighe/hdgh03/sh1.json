      "Text": "نامد اندر سراسر آفاق",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "پای مردی چنوی بر میثاق",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "آن سپهرش چه بارگاه ازل",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "آفتابش که احمدِ مرسل",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Right",
      "Text": "آدمی زنده‌اند از جانش",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Left",
      "Text": "انبیا گشته‌اند مهمانش",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "شرع او را فلک مسلّم کرد",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "خانه بر بام چرخ اعظم کرد",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "اندر آمد به بارگاه خدای",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "دامن خواجگی کشان در پای",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "پیش او سجده کرده عالم دون",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "زنده گشته چو مسجد ذوالنون",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "زبدهٔ جانِ پاکِ آدم ازو",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "معنی بکر لفظ محکم ازو",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "جان عاقل جهان بدو دیده",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "زانش بر جان خویش بگزیده",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "انبیا ریخته هم از زر اوی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "هرچه‌شان نقد بود بر سرِ اوی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "تا شب نیست صبح هستی زاد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "آفتابی چون او ندارد یار",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "همه شاگرد و او مدرسشان",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "همه مزدور و او مهندسشان",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "او سری بود و عقل گردن او",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "او دلی بود و انبیا تن او",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "دل کند جسم را به آسانی",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "میزبانی به روح حیوانی",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "کوشکش در ولایت تقدیس",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "صحن او بام خانهٔ ادریس",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "آستانِ درش به روضهٔ انس",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "بوده بستان روح روح‌القدس",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "کرده با شاه پرِّ طاوسی",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "جلوه در بوستان قدوسی",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "جان او خوانده پیش از آمد رق",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "ابجد لم یزل ز تختهٔ حق",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "سِرّ او سورهٔ وقا خوانده",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "دل او مرکب صفا رانده",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "گوی بربوده دست منقبتش",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "پای بر سر نهاده مرتبتش",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "عالم جزو را نظام بدو",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "غرض نفس کل تمام بدو",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "قدمش را ازل بپیموده",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "بودهٔ کلِّ کون و نابوده",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "داده اِشراف بر همه عالم",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "مر ورا کردگار لوح و قلم",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "قدمش در ازل نفرسودست",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "ندمش در ابد نیاسودست",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "علم او میزبان عالم داد",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "شرع او شحنهٔ خدای آباد",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "آمد از رب سوی زمین عرب",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "چشمهٔ زندگانی اندر لب",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "هم عرب هم عجم مسخّر او",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "لقمه خواهان رحمتِ درِ او",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 60,
      "Position": "Right",
      "Text": "قابلی چون عتیقش اندر بر",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "قاتلی همچو حیدرش بر در",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 62,
      "Position": "Right",
      "Text": "فیض فضل خدای دایهٔ او",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "فرّ پِرّ همای سایهٔ او",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 64,
      "Position": "Right",
      "Text": "چرخ پر چشم همچونرگس تر",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 65,
      "Position": "Left",
      "Text": "عقل پر گوش همچو سیسنبر",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 66,
      "Position": "Right",
      "Text": "جان او دیده ز آسمان قِدم",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 67,
      "Position": "Left",
      "Text": "زادنِ عقل و آدم و عالم",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 68,
      "Position": "Right",
      "Text": "بلکه از عقل بیشتر دل او",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 69,
      "Position": "Left",
      "Text": "دیده صنع خدای در گِل او",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 70,
      "Position": "Right",
      "Text": "گفته او را به وقت وحی و وجل",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 36
    },
    {
      "VOrder": 71,
      "Position": "Left",
      "Text": "جبرئیل امین که لاتعجل",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 36
    },
    {
      "VOrder": 72,
      "Position": "Right",
      "Text": "بوده چون نقش صورت خویشش",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 37
    },
    {
      "VOrder": 73,
      "Position": "Left",
      "Text": "ماجراهای غیب در پیشش",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 37
    },
    {
      "VOrder": 74,
      "Position": "Right",
      "Text": "هست کرده ز لطف و نور گُلشن",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 38
    },
    {
      "VOrder": 75,
      "Position": "Left",
      "Text": "شرق و غرب ازل درون دلش",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 38
    }
  ]
}
