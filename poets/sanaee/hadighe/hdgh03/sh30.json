    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "انبیا را به حق خلف او بود",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "جگر و جان علی و زهرا را",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "دیده و دل حبیب و مولی را",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "چون بهار است بر وضیع و شریف",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "منصف و خوب‌رو و پاک و لطیف",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "فلک جامه کوه زهره دواج",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "قمر تخت مهر پروین تاج",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "در سیادت شرف مؤیّد اوست",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "در رسالت رسول و سیّد اوست",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "نسبش در سیادت از سلطان",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "حسبش در سعادت از یزدان",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "چون علی در نیابت نبوی",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "کوثر داعی و عدو دعی",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "نامهٔ دوست حاکی دل اوست",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "دوست را چیست به ز نامهٔ دوست",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "منهج صدق در دلائل او",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "مهتری زنده در مخایل او",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "بود مانند جد به خُلق عظیم",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "پاک علق و نفیس عِرق و کریم",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "فلذه‌ای بود از دلِ زهرا",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "جدّهٔ او خدیجهٔ کبری",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "زهر قهر عدو هلاکش کرد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "فقد تریاک دردناکش کرد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "پاک ناید ز مردم بی‌باک",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "عود ناید ز دود چوب اراک",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "ماه در چشم او هلال نمود",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "زهر در کام او زلال نمود",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "زانکه زان واسطه چشیدن زهر",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "وان ز دشمن بسی کشیدن قهر",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "بجهانید جانش از رهِ حلق",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "برهانیدش از دنائت خلق",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "روز باطل چو حق شود پنهان",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "اهل حق را تو به ز کور مدان",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "پای باطل چو دست بر تابد",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "دل دانا به مرگ بشتابد",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "چون جهان حیز را امیر کند",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "زال زر روی چون زریر کند",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "گرچه این بد به روی او آمد",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "پشتِ اقبال سوی او آمد",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "بود با این دُژم دلی همه روز",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "همچو خورشید دهر شهرافروز",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "آن بهی طلعت بزرگ نسب",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "آن ز علم و ورع چراغ عرب",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "خواسته چون خرد ز بهر پناه",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "شرف از منصب کریمش جاه",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "خاطرش همچو بحری اندر شرع",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "راسخ اصل بود و شامخ فرع",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "مسند و مرقدش بر از افلاک",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "مشرب و منهلش ز عالم پاک",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "مشرب عِرق و منهل جگرش",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "بود از حوض جدّش و پدرش",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "مانده آباد از سخای کفش",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "خاندان نبوّت از شرفش",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    }
  ]
}
