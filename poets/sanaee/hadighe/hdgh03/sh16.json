  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "عندلیبان باغ آن خوشبوی",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: پرندگان باغ آن خوشبو در حال نغمه‌خوانی هستند و برای نعمت‌های خداوند حمد و سپاس می‌گویند."
