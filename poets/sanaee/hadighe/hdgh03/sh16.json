  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "عندلیبان باغ آن خوشبوی",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "در ترنّم تبارک‌الله گوی",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "بر زمان حکم چون شهان کرده",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "بر زمین نان چو بندگان خورده",
