      "Position": "Left",
      "Text": "مسلم کن مرا باری جهنم",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "به فردوس از چه طاعت شد سگ کهف",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
