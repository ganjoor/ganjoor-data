    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "تو گویی می مخور من می خورم می",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "تو گویی کم مزن من می‌زنم کم",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "فتادی تو به کعبه من به خاور",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
