      "Position": "Left",
      "Text": "تو و رکن و مقام و آب زمزم",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "ترا کردم مسلم کوثر و خلد",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
