      "Position": "Left",
      "Text": "نه در مشاهد قربی جلال اوست جدال",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "به قدرت صمدیت لطایف صنعش",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
