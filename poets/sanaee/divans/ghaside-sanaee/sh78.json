  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "تا چرخ برگشاد گریبان نوبهار",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "از لاله بست دامن کهپایه‌ها ازار",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "چونان نمود کل اثیری اثر به کوه",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "کاجزای او گرفت همه طرف جویبار",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "از اعتدال و تقویت طبع او ز خاک",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "صد برگ گل بزاد ز یک نوک تیز خار",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "اکنون که پر ز برگ زمرد شد از صبا",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "شاخی که بد چو هیکل افعی تهی ز بار",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "زان می‌کفد ز دیدن او دیده‌های شاخ",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "کز خاصیت کفد ز زمرد دو چشم مار",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "از هجر نالش آرد بس بلبل از درخت",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "با وصل گل برو چکند ناله‌های زار",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "زاید همی هوا به لطافت ز سعی چرخ",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "آن قوتی که داد عناصر به کوهسار",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "با آفتاب اگر بنتابد بروز نجم",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "بیواسطه اگرچه نپاید بر آب نار",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "گر به سما بهشت نهانست تا به حشر",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "بی حشر چونکه کرد زمینش پس آشکار",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "بر دشت و باغ چیست پس از یاسمین و گل",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "گردون پر ستاره و دریای پر شرار",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "گلزار بین سبزه پر از آب نارگون",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "کهسار بین ز لاله پر از نار آبدار",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "بر شبه چنگ باز سر غنچه‌های گل",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "بر شکل پای شیر شده پنجهٔ چنار",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "گر دشت خرمست چرا گرید از فراز",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "این پردهٔ کثیف لطیف اصل تند بار",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "زینجا نفیر ریزد ز آنجا نوای نای",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "زینجا خروش عاشق و ز آنجا نشاط یار",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "خلقی پر از نشاط ز دشتی تهی ز برف",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "طبعی تهی ز غم ز درختان پر ز بار",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "آن لاله فام باده‌خوران زیر شاخ گل",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "و آن گلرخان نشاط کنان گرد لاله‌زار",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "بیخ زمین چو افسر شاهان پر از گهر",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "شاخ شجر چون گوش عروسان ز گوشوار",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "بر هر طرف بهشتی در هر بهشت حور",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "بر هر چمن کناری و در هر کنار یار",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "مرغی بهر درخت و چراغی بهر چمن",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "شاهی بهر طریق و عروسی بهر کنار",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "گرچه ز هر درخت خوشی دید هر دماغ",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "ورچه درین بهار بها یافت هر دیار",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "لیک از بهار خرمیی نیستی به طبع",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "چون خلق و طبع خواجه اگر نیستی بهار",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "منصوربن سعیدبن احمد که از کرم",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "چون نصرت و سعادت و حمدست نامدار",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "آن کز مزاج گوهر و تاثیر علم او",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "بر نه فلک چهار گهر می‌کند نثار",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "آن خواجه‌ای که گشت ز تعجیل جود خویش",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "چون شخص سل گرفته سوال از کفش نزار",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "یک فکر تند از پی مدحش همه سخن",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "یک منزلند از تک جودش همه قفار",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "کرد از تف سخاوت خود همچو چوب خشک",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "در کامهای خلق زبانهای افتخار",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "چشمی که نشر سیرت او بیند از مدیح",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "آن چشم ایمنست بهر حال از انتشار",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "گر بنگرد به خشم سوی چرخ و آفتاب",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "در ساعتی دو لیل بخیزد ز یک نهار",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "ای دایرهٔ نجات ز جود تو مستدیر",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "وی مرکز حیات ز عون تو مستدار",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "رویی که یافت گرد ستانهٔ درت ز لطف",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "هرگز شکن نگیرد چون پشت سوسمار",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "خاکی که یافت سایهٔ حزم تو زان سپس",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "از باد کوه کن نبرد در هوا غبار",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "آبی که یافت آتش عزمت کند چو وهم",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "در نیم لحظه چنبر افلاک را گذار",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "هرگز سپاه مرگ نیابد بدو ظفر",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "آن کس که دارد از علم و علم تو حصار",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "مدحست طبع و فعل ترا سال و مه خورش",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "شکرست باز عمر ترا روز شب شکار",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "شد فرش پای قدر تو گردون مستقیم",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "شد غرق بحر دست تو کشتی انتظار",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "گویی که هست بر بشره نزد خاطرت",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "آنها که در عروق مفاصل بود نثار",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "زنده شود به علم و به احسانت هر زمان",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "آنرا که کشت بوالحسن از زخم ذوالفقار",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "آخر گشاد تیر علوم تو از علاج",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "بر مرگ سوی شخص فروبست رهگذار",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "از لطف و بخشش تو چو شمس ای فلک محل",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "وز جود و بر یافت همه خلق بر و بار",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "پرمایه‌ای چو گوهر و پر سایه‌ای چو ماه",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "پس چونکه هست روی عدو از تو همچو قار",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "نی نی مه و گهر چه خوانم ترا چو هست",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "هر نکته صد سپهر و هر انگشت صد بحار",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "ای چرخ را به بذل یمینت همه یمین",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "وی خلق را به جود یسارت همه یسار",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "هستم من آن بلند که گشتم ز چرخ پست",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 86,
      "Position": "Left",
      "Text": "هستم من آن عزیز که ماندم ز دهر خوار",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "از جور این زمان و زمانه نهاد من",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "یک لحظه می‌نیابد همچون زمین قرار",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "از جهل عار باشد حظم ازوست فخر",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "وز شعر فخر زاید قسمم ازوست عار",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 91,
      "Position": "Right",
      "Text": "هرگز نیافتم به چنین شعرهای نغز",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 92,
      "Position": "Left",
      "Text": "از هیچ رادمرد به صد شعر یک شعار",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 93,
      "Position": "Right",
      "Text": "تا پنجگانه‌ایم دهند از دویست شعر",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 94,
      "Position": "Left",
      "Text": "روزی هزار بار دو چشمم شود چهار",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 95,
      "Position": "Right",
      "Text": "چشمم همی ستاره از آن بارد از مژه",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 96,
      "Position": "Left",
      "Text": "زیرا که چون شبست برو روزگار تار",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 97,
      "Position": "Right",
      "Text": "هستی سخن چه سود کسی را که نیستی",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 98,
      "Position": "Left",
      "Text": "از سر همی برآرد هر ساعتی دمار",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 99,
      "Position": "Right",
      "Text": "شوخیست مایهٔ طمع اشعار خوش چه سود",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 100,
      "Position": "Left",
      "Text": "کامروز فرق کس نکند افسر از فسار",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 101,
      "Position": "Right",
      "Text": "آنراست یمن و یسر که با قوت تمیز",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 102,
      "Position": "Left",
      "Text": "نشناسد او ز جهل یمین خود از یسار",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 103,
      "Position": "Right",
      "Text": "گر کارها چنانکه بباید چنان بدی",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 104,
      "Position": "Left",
      "Text": "در پستی آب کی بدی و در هوا بخار",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 105,
      "Position": "Right",
      "Text": "شاید که خاکپای تو بوسم که خود تویی",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 106,
      "Position": "Left",
      "Text": "مداح را به جود و به انصاف دستیار",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 107,
      "Position": "Right",
      "Text": "مجبور بخت بد بدم از روی چاکری",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 108,
      "Position": "Left",
      "Text": "زان مر ترا چو دولت تو کردم اختیار",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 109,
      "Position": "Right",
      "Text": "نشکفت اگر ز روی تو والا شوم از آنک",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 110,
      "Position": "Left",
      "Text": "نه تو کم از مهی و نه من کمتر از خیار",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 111,
      "Position": "Right",
      "Text": "تخمیم بر دهنده ز مدح و ثنا و شکر",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 112,
      "Position": "Left",
      "Text": "در بوستان عمر خود از حکمتم به کار",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 113,
      "Position": "Right",
      "Text": "در زینهار خویش نگهدارم از بلا",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 114,
      "Position": "Left",
      "Text": "ای خلق را به علم تو از مرگ زینهار",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 115,
      "Position": "Right",
      "Text": "بودم صبور تا برسیدم به صدر تو",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 116,
      "Position": "Left",
      "Text": "گرچه ز خلق بود روان و دلم فگار",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 117,
      "Position": "Right",
      "Text": "آری به زخم ماری ابوبکر صبر کرد",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 118,
      "Position": "Left",
      "Text": "تا لاجرم وزیر نبی گشت و یار غار",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 119,
      "Position": "Right",
      "Text": "تا ز آتش و ز آب و ز خاک و هوا بود",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 120,
      "Position": "Left",
      "Text": "مر خلق را ز حکمت باری همی نگار",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 121,
      "Position": "Right",
      "Text": "بادی چو آب و آتش و بادی چو باد و خاک",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 122,
      "Position": "Left",
      "Text": "در صفوت و بلندی و در لطف و در وقار",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 123,
      "Position": "Right",
      "Text": "بادت ز سعی بخت همیشه تهی و پر",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 124,
      "Position": "Left",
      "Text": "از رنج تن روان و ز مقصود دل کنار",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    }
  ]
}
