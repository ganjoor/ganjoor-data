  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "امامی کو امامت را حسن بود",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "حسن آمد که جمله حسن ظن بود",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "همه حسن و همه خلق و همه حلم",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "همه لطف و همه جود و همه علم",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
