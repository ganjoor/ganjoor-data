      "Position": "Left",
      "Text": "گلاب و عود پیش آورد بسیار",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "چو رویش از گلاب و عود تر شد",
