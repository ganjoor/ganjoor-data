      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "نه مظلم بینی آنجا نه منیری",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "همین اجسام کاینجا باشد امروز",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "همین اجسام باشد عالم افروز",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "چو پشت آینه‌ست اجسام اینجا",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "شود چون روی آیینه مصفا",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "عمر اینجا عمر آنجا سراجست",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "بلال ابنوسین همچو عاجست",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "چو مغز پای بوبکر و عمر را",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "توان دیدن چنان کاینجا قمر را",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "چو سیبی راکه اندر خلد بشکافت",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "توانی در میانش حور عین یافت",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "چه باشد گر تن تو نور باشد",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "همه ذرات عالم حور باشد",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "چو در چشم آیدت چون ماه نوری",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "چرا ناید در آن هر ذره حوری",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "نه سید گفت کین دم شد پدیدار",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "بهشت و دوزخم زین پاره دیوار",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "چو خورد اندر نماز انگور جنت",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "چرا دایم ندید او حور جنت",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "نه سید گفت خلد و نار کونین",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "بتو نزدیک‌تر از بند نعلین",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "بهشتی دان تو از قول پیمبر",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "ز حد حجره او تا به منبر",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "چو او را دیدهء جبریل بین بود",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "بهشتش لاجرم اندر زمین بود",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "وضو اینجا وضو آنجایگه نور",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "جماد اینجا جماد آن جایگه حور",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "چو تو بینندهٔ گور و زمینی\u00A0",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "زمین جز روضه و حفره نبینی",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "ببینی گر ترا آن چشم باز است",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "که پیغامبر بگور اندر نماز است",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "ترا این آب خوش خوش می‌نماید",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "پری را آبت آتش می‌نماید",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "چگونه شرح جسم و جان دهم من",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "که جان و جسم را یکسان نهم من",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "زنی کامروز پیر و ناتوانست",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "چو آنجا رفت بکر است و جوانست",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "نیارد مرد ریش آنجا بره برد",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "که نتوان باد ریش آنجایگه برد",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "کسی کاینجا بود در کین و در زور",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "کنندش حشر اندر صورت مور",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "عوان آنجا سگی خیزد چو آذر",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "سگ و بلعام در صورت برابر",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "یک آیینه‌ست جسم و جان درویش",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "به حکمت می‌نماید از دو رویش",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "اگر زین سو نماید جسم باشد",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "وز آن سو جان پاکش اسم باشد",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "عزیزا تو چه دانی خویشتن را",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "طلسمی بوالعجب دان جان و تن را",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "بهشت از نور تو زینت پذیرد",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "که بی اعمال تو زینت نگیرد",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    }
  ]
}
