  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "سئوالی کرد زین شیوه یکی خام",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "از آن سلطان بر حق پیر بسطام",
