  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "حقیقت بشنو از اسرار او تو",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "چه اندیشی هم از کردار او تو",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "حقیقت بود او دانسته اسرار",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "که دائم دیده بُد اعیان اسرار",
