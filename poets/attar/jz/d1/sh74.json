  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "جلال من فنای جاودانیست",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: شکوه و عظمت من از بین نرود و همیشه باقی خواهد ماند، زیرا نمایانگر وجودی بی‌نهایت و پایدار است."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "نمود من بقای جاودانی است",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "جلال من ز ذاتم در صفاتست",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: جلال و عظمت من از وجود خودم ناشی می‌شود و همه اجزای وجود من در عشق به حیرت آمده‌اند."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "همه ذرّات من در عشق ماتست",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "جلال من کجا هرگز کسی دید",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: جلال و عظمت من کجا بود که کسی آن را دیده باشد؛ حتی اگر عقل و درک در اینجا به سن و سالی برسد."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "اگرچه عقل اینجا پیر گردید",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "جلال من ندید اینجا عیانی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: منظور این است که شخصیت مهمی که از جلال و شکوه برخوردار است، در این مکان نتوانسته است حقایق و اسرار عمیق را به وضوح مشاهده کند، هرچند که درباره معانی و مفاهیم پنهان بسیار صحبت شده است."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "بسی دم زد ز اسرار معانی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "جلال من ندید و هم فرو ماند",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: جلال من را هیچ‌کس ندید و در سکوت باقی ماند، هرچند همیشه در حال صحبت و بحث بود."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "اگرچه دائمادر گفت و گو ماند",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "جلال من وصال جاودانست",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: عظمت من در پیوندی ابدی است؛ هر کس بتواند به این پیوند دست یابد، باید از هر گونه نشانه و نامی فراتر باشد."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "کسی یابد که بی نام ونشانست",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "جلال من همه دارند اینجا",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: جلال و شکوه من در اینجا همه جا احساس می‌شود و تمام ذرات در حیرت و شگفتی نسبت به ما هستند."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "همه ذرّات حیرانند در ما",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "بعالم در نمود جمله پیداست",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: تمام نشانه‌ها در جهان پیداست که وجود من در عمق جان نمایان است."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "که ذاتم در درون جان هویداست",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "جلالم انبیا اینجای دیدند",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: جلال انبیا در اینجا به تماشای ما آمده‌اند و از پیوند ما به رضایت و خشنودی دلشان دست یافته‌اند."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "ز وصل ما بکام دل رسیدند",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "مرا زیبد که بنمایم جلالم",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: من سزاوار است که به دیگران نمایش دهم عظمت خود را و در وصالم، همه را به معرفت و نزدیکی برسانم."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "رسانم جملگی اندر وصالم",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "مرا زیبد که پیدائی نمایم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: بهتر است که ابتدا خود را بشناسم و سپس ویژگی‌های یکتایی و منحصر به فردی که دارم را به دیگران نشان دهم."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "پس آنگه دید یکتائی نمایم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "مرا زیبد بعالم پادشاهی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: من شایسته‌ی زندگی سلطنتی هستم، چون رحمت و زندگی در وجود من است و من به خداوند وابسته‌ام."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "منم رحمان منم حیّ و الهی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "درون جملهام هم در برونم",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: در درون کلماتم و بیرون وجودم، همه‌ی وجودم را به نمایش گذاشته‌ام و خودم راهنمای خودم هستم."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "من آوردم همه من رهنمونم",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "نمایم راه هر کس را بر خویش",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: من راه هر فردی را نشان می‌دهم، اما وقتی پرده از جلوی چشمانم برداشته شود، به وضوح می‌بینم."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "حجاب آخر چو بردارم من از پیش",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "نمایم راه جمله سالکانم",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "CoupletSummary": "هوش مصنوعی: من به همه سالکان راه را نشان می‌دهم و اسرار آنها را می‌دانم."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "نمود راز ایشان من بدانم",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "نمایم راه را ذرّات عالم",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17,
      "CoupletSummary": "هوش مصنوعی: من در اینجا به طور مداوم، راه را برای ذرات عالم آشکار می‌کنم."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "بر خود در عیان اینجا دمادم",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "صفاتم هست موجود حقیقی",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18,
      "CoupletSummary": "هوش مصنوعی: من ویژگی‌ها و صفاتم نشان‌دهنده‌ی حقیقت وجود من هستند، و من در این مکان، واقعیت وجودی‌ام را به نمایش گذاشته‌ام."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "منم اینجایگه بود حقیقی",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "صفاتم هست اسرار نهانی",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19,
      "CoupletSummary": "هوش مصنوعی: ویژگی‌ها و خصوصیات من مانند اسرار پنهانی است که هر جزء و ذرّه‌ای از آن معنای خاصی را در خود دارد."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "نمایم جمله ذرّات از معانی",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "همه در بود خودشان راه دادم",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20,
      "CoupletSummary": "هوش مصنوعی: همه را در حقیقت خودشان پذیرفتم و به آن‌ها اجازه دادم تا درک عمیق‌تری از دل و احساساتشان پیدا کنند."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "ز دید خود دل آگاه دادم",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "همه در بود من کلّی فتادند",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21,
      "CoupletSummary": "هوش مصنوعی: همه در وجود من به صورت کلی درگیر شدند و در مسیر من، مردم را به وجود آوردند."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "سراندر راه من مردم نهادند",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "مرا جویا و من خود جمله هستم",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22,
      "CoupletSummary": "هوش مصنوعی: من به دنبال آن هستی و در واقع خودم هستم. بارها قدم گذاشتم و اینجا به نتیجه نرسیدم."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "بسی آوردم و اینجا شکستم",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "بسی آوردهام از پرده بیرون",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23,
      "CoupletSummary": "هوش مصنوعی: من از پرده پنهانی به بیرون آمده‌ام و اکنون خود را به همه نشان می‌دهم، مانند کودک بی‌گناهی که ناگهان خود را در برابر دیدگان دیگران می‌بیند."
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "ز دید دید خود من بیچه و چون",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "بسی آوردهام در کن یقین من",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24,
      "CoupletSummary": "هوش مصنوعی: من به فراوانی از تجربیات و دانش دست یافته‌ام و به خوبی مطمئنم که من نخستین و آخرین وجود هستم."
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "که هستم اوّلین و آخرین من",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "چو خود بنمودهام خود بودهام باز",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25,
      "CoupletSummary": "هوش مصنوعی: من از خودم پرده‌برداری کرده‌ام و همواره به حقیقت خودم آگاه بوده‌ام، چه در آغاز و چه در پایان."
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "عیان خویش در انجام و آغاز",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "نمایم تا همه اینجا بدانند",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26,
      "CoupletSummary": "هوش مصنوعی: می‌خواهم نشان دهم که همه اینجا متوجه شوند و همه در نگاه من متعجب باقی بمانند."
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "همه در دید من حیران بمانند",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "کمالم را ندانند رایگانی",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27,
      "CoupletSummary": "هوش مصنوعی: من را به عنوان فردی کامل نمی‌شناسند، اما همه کسانی که در اینجا حضور دارند، به طور پنهانی مرا می‌بینند."
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "ببینندم همه اینجا نهانی",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "بچشم سر نبیند هیچکس من",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28,
      "CoupletSummary": "هوش مصنوعی: هیچ کس نمی‌تواند با چشمانش مرا ببیند؛ من که هستم، به راستی رازهای روشنی دارم."
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "که من هستم یقین اسرار روشن",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "بچشم سر جمال من نبیند",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29,
      "CoupletSummary": "هوش مصنوعی: اگر کسی زیبایی من را به چشم نبیند، حتی اگر مدت زیادی در تنهایی بماند، باز هم نمی‌تواند آن را درک کند."
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "چه گر بسیار درخلوت نشیند",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "ندارم غیر هستم قل هواللّه",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30,
      "CoupletSummary": "هوش مصنوعی: من چیزی جز وجود خدا ندارم، بگو که من همان خدا هستم، در تمام جزئیات و کلیات، مظهر خداوند هستم."
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "منم در جزو و کل پیدای اللّه",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    }
  ]
}
