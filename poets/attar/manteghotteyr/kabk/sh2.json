    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "پادشاها من به چشمِ اعتبار",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 16,
