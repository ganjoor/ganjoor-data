  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "در رهی می‌رفت پیری راهبر",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "دید از روحانیان خلقی مگر",
