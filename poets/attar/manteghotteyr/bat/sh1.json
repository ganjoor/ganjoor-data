  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "بط به صد پاکی برون آمد ز آب",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
