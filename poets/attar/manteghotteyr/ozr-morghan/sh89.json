      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "جمع کن خاکسترش یک روز تو",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "این همه خاکستر آنگه برفشان",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "تا شود از باد عزت بی‌نشان",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "چون چنین کردی ترا آید کنون",
