    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "گه ز پیش کعبه بازت می‌دهند",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "گه درون دیر رازت می‌دهند",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "گر ازین گرداب سر بیرون کنی",
