  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "در خراسان بود دولت بر مزید",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "زانک پیدا شد خراسان را عمید",
