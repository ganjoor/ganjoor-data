      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "به لب آید بدین امید جانم",
      "CoupletIndex": 3,
      "SectionIndex1": 0
