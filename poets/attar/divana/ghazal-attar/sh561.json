      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "و گر در بند خویش آری مرا تو",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "نخواهم کفر و دین در بند آنم",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
