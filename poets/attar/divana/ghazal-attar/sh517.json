      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "خورشید همه جهان گرفته است",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
