      "VOrder": 30,
      "Position": "Left",
      "Text": "در میان پوستین می‌بایدش",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "گنج‌ها بخشید و از تو وام خواست",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "تا شوی گستاخ این می‌بایدش",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "امتحان را زلف هر دم کژ کند",
