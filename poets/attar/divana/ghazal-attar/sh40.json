      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "آفتاب طلعت زیبای توست",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
