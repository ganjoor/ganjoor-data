      "Text": "آن پر و بال جز وبالم نیست",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "تا جگر گوشهٔ خودت خواندم",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
