      "Position": "Left",
      "Text": "که او خر مهره است و ما چو درّیم",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "بباید دست او اینجا بریدن",
