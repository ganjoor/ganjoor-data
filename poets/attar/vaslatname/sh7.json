      "Text": "ای بسا کس را که شاه و میر کرد",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "ای بسا کس را که قطب و پیر کرد",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "ای بسا کس را که جام فقر داد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "ای بسا کس را که جانی در نهاد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "از خدای خویش حکمت یافته",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "در سلوک خویش رفعت یافته",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "اوحکیم صادق و سر خداست",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "همچو او دیگر حکیمی خود کجا است",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "صدهزاران حکمت بی‌منتها",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "از خدایش یافته بحر صفا",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "هیچ کس از حال او آگه نشد",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "احولی با او مگر همخانه شد",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "اندر آن خانه یکی آیینه‌دان",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "هر دو عالم را از آن آیینه دان",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "بود آن آیینه در پیش حکیم",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "روی خود را دید او در وی مقیم",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "احولک گفت این حکیم پر خرد",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "هر زمان درآینه می بنگرد",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "حکمتش بیشک در این آیینه‌دان",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "لاجرم زیبا رخش ز آیینه دان",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "حکمت او من از این پیدا کنم",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "در جهان خود را چو او زیبا کنم",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "وانگهی در آینه کرد او نگاه",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "دید او دو صورت زشت سیاه",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "احولک در دید اندر آینه",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "زان بکثرت دید او معاینه",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    }
  ]
}
