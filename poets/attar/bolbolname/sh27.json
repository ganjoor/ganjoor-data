      "Position": "Right",
      "Text": "ترا گردیدهٔ سر یار بودی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "کجا با این و آن غمخوار بودی",
