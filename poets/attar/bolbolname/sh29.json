    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "زبان حال و رای کسوت قال",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: نبوت، از عقل فعال الهام می‌گیرد و به ما می‌آموزد که زبان حال افراد و افکار آن‌ها را چون لباس و گفتارشان شناسایی کنیم."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "بیاموزد نبی از عقل فعال",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "مثال خوش ترا خواهم نمودن",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: می‌خواهم مثالی زیبا و شگفت‌انگیز بیاورم که با آن صدها فرصت و موفقیت برای تو فراهم خواهد شد."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "که صد دولت ترا خواهد گشودن",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "بفرما تا بیارند مرد استاد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: بفرمایید تا مرد استاد یک آینه از پولاد بسازد و آن را بیاورند."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "یکی آیینه‌ای سازند ز پولاد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "ز هندوستان بیارند طوطیان را",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: طوطی‌هایی از هندوستان بیاورند و در لانه‌شان پر از شکر بریزند تا خوشایند و شادی‌آور باشند."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "پر از شکر بریزند آشیان را",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "به گرد آینه طوطی بیاورد",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: طوطی را در دور و بر آینه آوردند و به محل خصوصی شاه ایران بردند."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "به خلوت‌خانهٔ شاه جهان برد",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "پس‌ِ آیینه شد زیر گلیمی",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: پس از آن، طوطی زیر یک گلیم پنهان شد، مانند موسی که با قوم بنی‌اسرائیل روبه‌رو شد."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "چو موسی کرد با طوطی کلیمی",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "گمان بردش دل کژ‌بین طوطی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: دل طوطی که دیدگاه نادرستی دارد، گمان می‌کند که طوطی تنها به او یاد می‌دهد و نصیحت می‌کند."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "که طوطی می‌کند تلقین طوطی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "بدین تصنیف شد طوطی سخن‌دان",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: در این بیت گفته شده که طوطی، سخن‌دان و باهوش، با این آهنگ و لحن، می‌تواند انسان را تحت تأثیر قرار دهد و به او آموخته‌هایی بدهد."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "ملک زینسان کند تلقین انسان",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "ز سیمرغ و ز بلبل وز چکاوک",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: فقط یک پرنده از سیمرغ، بلبل و چکاوک دارای طبع زیرک و باهوش است."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "همین یک مرغ دارد طبع زیرک",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "ز جنس آدمی پیغمبرانند",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: پیامبران از جنس انسان هستند و دارای توانایی و دانش خاصی هستند که آن‌ها را متمایز می‌کند."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "که استعداد آن دارند و دانند",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "همی آید ملک تا حد انسان",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: ملک (مانند فرشتگان) برای آنکه با انسان ارتباط برقرار کند، به حد و مرتبهٔ انسانی می‌رسد تا در پسِ آینهٔ جان انسان بنشیند و درون او را ببیند."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "نشیند از پس‌ِ آیینهٔ جان",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "بیاموزد نبی را علم انسان",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: نبی (پیامبر) به علم انسانی آموخته می‌شود و آن علم را در سخنانش به دیگران منتقل می‌کند."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "نبی آن علم را آرد به گفتار",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    }
  ]
}
