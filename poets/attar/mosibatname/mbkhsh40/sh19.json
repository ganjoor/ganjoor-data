  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "رهروی را چون درآمد وقت مرگ",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "لرزهٔ افتاد بر وی همچو برگ",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
