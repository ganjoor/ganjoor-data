  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "پادشاهی بود مجنون را بخواند",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "پیش تخت خویش بر کرسی نشاند",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "گفت چندین درجهان صاحب جمال",
