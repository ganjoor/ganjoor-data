    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "هم رسیده بودم از درگاه حق",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "هم مهلل آمدم در راه حق",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "بود رنگ و لذت و بویم بسی",
