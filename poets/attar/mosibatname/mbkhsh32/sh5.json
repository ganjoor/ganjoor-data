  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "گفت چون یعقوب بر عزم سفر",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "رفت از کنعان برون پیش پسر",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "مصریان بی پا و سر برخاستند",
