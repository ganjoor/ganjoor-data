      "Text": "چون امل بسیار و چون عمر اندکست",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "گر بسی اندک شود کم چه شکست",
