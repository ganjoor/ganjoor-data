  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "نور چشم مصطفی و مرتضی",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
