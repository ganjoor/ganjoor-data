  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "گشت مجنون هر زمان شوریده تر",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "همچنان در کوی لیلی شد مگر",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "هرچه را در کوی لیلی دید او",
