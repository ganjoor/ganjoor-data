  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "گفت دزدی را گرفت آن سر فراز",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "در میان جمع دستش کرد باز",
