      "Position": "Left",
      "Text": "هرچه آن من بود آنت بود",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "چون میان ما یکی حاصل شود",
