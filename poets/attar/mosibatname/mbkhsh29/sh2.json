  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "بندهٔ را امتحان میکرد شاه",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "خواند یک روزیش پیش خود پگاه",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "گفت این دم دامن من بر سرآر",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
