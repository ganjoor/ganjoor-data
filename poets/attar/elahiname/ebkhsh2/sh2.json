  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "پدر گفتش تو زنهار این میندیش",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "که برگیرم خیال شهوة از پیش",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ولی چون تو ز عالم این گزیدی",
