      "Text": "که من فردا چه خواهم خورد اینجا",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "همه خوردم چه خواهم کرد اینجا",
