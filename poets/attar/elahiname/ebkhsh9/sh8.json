      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "زبان بگشاد آن مجنونِ مضطر",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
