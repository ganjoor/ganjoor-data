  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "مگردیوانهٔ شوریده برخاست",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "برهنه بُد ز حق کرباس می‌خواست",
