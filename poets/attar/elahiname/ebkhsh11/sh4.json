  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "یکی تابوت می‌بردند بر دست",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "بدید از دور آن دیوانهٔ مست",
