    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "ادب دادیم و گستاخی گزیدیم",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
