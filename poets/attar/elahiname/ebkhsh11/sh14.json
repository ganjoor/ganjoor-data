      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "اگر تو کافری ایمانت بخشد",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "وگر درماندهٔ درمانت بخشد",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
