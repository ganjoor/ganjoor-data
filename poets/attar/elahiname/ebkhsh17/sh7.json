  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "یکی پرسید ازان دیوانه ساری",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
