      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "چه با اسفندیاری کرد دستان؟",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "به باطن هرچه بتوان کرد میکن",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
