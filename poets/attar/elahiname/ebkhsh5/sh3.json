      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "بکن جهدی که گردی از ریا خاص",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "برای سگ توانی بود هاجر",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31
