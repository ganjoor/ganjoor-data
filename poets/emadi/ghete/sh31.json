    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "عقل قبول کی کند کار فرشته زاهرمن",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "ابر کفا بلا ز من سایه‌صفت نمی‌رود",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "بر من و روزگار من سایه دولتت فکن",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "کس غم من نمی‌خورد زآن که کسی گمان برد",
      "CoupletIndex": 4,
