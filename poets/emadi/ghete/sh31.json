    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "پاک‌ضمیر پاک‌دین خوب‌لقای خوب‌‎ظن",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "در همه فن کمال او نیست چنان که مثل او",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "عقل نشان نمی‌دهد هیچ کسی به هیچ فن",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "دولت و ملک منتظم از تو بود نه از فلک",
      "CoupletIndex": 2,
      "SectionIndex1": 0
