  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "هزار شکر خداوند را که بار دگر",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "طلوع کرد ز شرق آفتاب فضل و هنر",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
