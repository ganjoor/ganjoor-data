  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "مرا مناقب مخدوم خود مجیرالدین",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "مهم‌تر است ز نعت بهار و فروردین",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "به پیش مجلس محروس او ز ذکر بهار",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "سمج بود که دهم نظم خویش را تزیین",
