      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "با جود تو مثل چو ز دریا و کان زدند",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
