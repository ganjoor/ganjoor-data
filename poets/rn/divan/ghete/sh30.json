      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "نیافت وصل دوام و در آن نیم ای کاش",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "که با جفای فلک هجر را دوام بود",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "چگونه ممکن گردد دوام هجر چو عمر",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
