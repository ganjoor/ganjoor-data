      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "تو آن بزرگ سخن‌پروری که گاه سخن",
      "CoupletIndex": 5,
