      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "زره را و انگشتری را بهم",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "بدو داد انگشتری با زره",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
