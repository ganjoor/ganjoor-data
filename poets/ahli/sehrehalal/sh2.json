      "SectionIndex4": 20
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "نقطهٔ بسم الله از آن درگشاد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 16,
      "SectionIndex4": 20
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "با که در این بسمله باب آمده",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "SectionIndex3": 16,
      "SectionIndex4": 21
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "بانی فتح از همه باب آمده",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "SectionIndex3": 16,
      "SectionIndex4": 21
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "ارّهٔ دندانهٔ سین شانه ساخت",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 16,
      "SectionIndex4": 22
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "بازوی دین را قوی این شانه ساخت",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 16,
      "SectionIndex4": 22
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "هر الف آزاده‌ای از دلبری",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 16,
      "SectionIndex4": 23
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "در رهش افتاده‌ای از دل بری",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 16,
      "SectionIndex4": 23
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "طرّهٔ لامش شده دور از قصور",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "SectionIndex3": 16,
      "SectionIndex4": 24
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "مایل او گیسوی حور از قصور",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "SectionIndex3": 16,
      "SectionIndex4": 24
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "چشمهٔ ها آمده جویای مهر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "SectionIndex3": 16,
      "SectionIndex4": 25
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "منبع جوی مه و دریای مهر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "SectionIndex3": 16,
      "SectionIndex4": 25
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "رای دل‌آرا همه از رای اوست",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "SectionIndex3": 16,
      "SectionIndex4": 26
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "راحت دل‌ها همه از رای اوست",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "SectionIndex3": 16,
      "SectionIndex4": 26
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "غنچهٔ حایش دل و جان را بهشت",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "SectionIndex3": 16,
      "SectionIndex4": 27
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "دید در آن آدم و آن را بهشت",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "SectionIndex3": 16,
      "SectionIndex4": 27
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "ماهی نون کشتی دریا وجود",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "SectionIndex3": 16,
      "SectionIndex4": 28
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "در خور او بخشش و آلا و جود",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "SectionIndex3": 16,
      "SectionIndex4": 28
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "یا که در این دایره گویا شده",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "SectionIndex3": 16,
      "SectionIndex4": 29
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "مرکز نه دایره گویا شده",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "SectionIndex3": 16,
      "SectionIndex4": 29
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "حلقهٔ میم است بر آن خاتمت",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "SectionIndex3": 16,
      "SectionIndex4": 30
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "دارد از آن حلقهٔ جان خاتمت",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "SectionIndex3": 16,
      "SectionIndex4": 30
    }
  ]
}
