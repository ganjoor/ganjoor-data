      "Position": "Left",
      "Text": "تا تو در آن آینه روی آوری",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "SectionIndex3": 16,
      "SectionIndex4": 18
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "در دل من بوی امیدست باز",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "SectionIndex3": 16,
      "SectionIndex4": 19
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "چشم دل از روی امیدست باز",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "SectionIndex3": 16,
      "SectionIndex4": 19
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "غنچه سربسته گل باز شد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 16,
      "SectionIndex4": 20
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "هدهد پر بسته گل باز شد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 16,
      "SectionIndex4": 20
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "خواند جم آن نامه و آن راز او",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "SectionIndex3": 16,
      "SectionIndex4": 21
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "گفت که من نشنوم آنرا ز او",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "SectionIndex3": 16,
      "SectionIndex4": 21
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "جم دگر آمد ره زاری سپرد",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 16,
      "SectionIndex4": 22
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "کرد خطی از پی یاری سپرد",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "SectionIndex3": 16,
      "SectionIndex4": 22
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "کای گل از این خواری جم درگذر",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 16,
      "SectionIndex4": 23
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "چون گل و خار آمده هم درگذر",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 16,
      "SectionIndex4": 23
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "ره بده ای گلبن جان بخش من",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "SectionIndex3": 16,
      "SectionIndex4": 24
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "تا رسد از خرمن جان بخش من",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "SectionIndex3": 16,
      "SectionIndex4": 24
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "گر شده پر این چمن از صد هزار",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "SectionIndex3": 16,
      "SectionIndex4": 25
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "کو یکی ای گل چو من از صد هزار",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "SectionIndex3": 16,
      "SectionIndex4": 25
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "غصه من کز دل من خون مزید",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "SectionIndex3": 16,
      "SectionIndex4": 26
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "آمده بر قصه مجنون مزید",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "SectionIndex3": 16,
      "SectionIndex4": 26
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "گر دمد از کهگل من یاسمن",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "SectionIndex3": 16,
      "SectionIndex4": 27
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "کی رود از این دل من یاس من",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "SectionIndex3": 16,
      "SectionIndex4": 27
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "گر نظر ایگل سمن آسا کنی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "SectionIndex3": 16,
      "SectionIndex4": 28
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "صد دل آشفته تن آسا کنی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "SectionIndex3": 16,
      "SectionIndex4": 28
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "چشمه مهرت دل ما تشنه دید",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "SectionIndex3": 16,
      "SectionIndex4": 29
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "چاره ما هیچ جز آتش ندید",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "SectionIndex3": 16,
      "SectionIndex4": 29
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "مرغ اگر از صحبت گلزار سوخت",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "SectionIndex3": 16,
      "SectionIndex4": 30
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "مرغ من از فرقت گل زار سوخت",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "SectionIndex3": 16,
      "SectionIndex4": 30
    }
  ]
}
