    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "یافته از لطف تو جنت نعم",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 15,
      "SectionIndex4": 22
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "قهر تو لا گفته و رحمت نعم",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "SectionIndex3": 15,
      "SectionIndex4": 22
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "بخشش تو نعمت و گنج روان",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "SectionIndex3": 15,
      "SectionIndex4": 23
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "رنجش تو علت و رنج روان",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "SectionIndex3": 15,
      "SectionIndex4": 23
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "تا شدی از بنده دین رنج‌کاه",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "SectionIndex3": 15,
      "SectionIndex4": 24
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "یافته صد راحت ازین رنجگاه",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "SectionIndex3": 15,
      "SectionIndex4": 24
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "گلبن تن را دهی از جان نوا",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "SectionIndex3": 15,
      "SectionIndex4": 25
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "بلبل دل را رسد از آن نوا",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "SectionIndex3": 15,
      "SectionIndex4": 25
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "نغمه شوقت دل عشاق راست",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "SectionIndex3": 15,
      "SectionIndex4": 26
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "آمد از آن نغمه عشاق راست",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "SectionIndex3": 15,
      "SectionIndex4": 26
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "بنده بی‌عشق تو مرد ار زنست",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "SectionIndex3": 15,
      "SectionIndex4": 27
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "بهتر از آن بی‌غم و درد ارزنست",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "SectionIndex3": 15,
      "SectionIndex4": 27
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "در مکش از کرده بد روز ما",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "SectionIndex3": 15,
      "SectionIndex4": 28
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "شب مکن از هیبت خود روز ما",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "SectionIndex3": 15,
      "SectionIndex4": 28
    }
  ]
}
