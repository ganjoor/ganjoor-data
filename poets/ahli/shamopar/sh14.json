  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "دو خادم داشت آن سرو گل اندام",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "یکی کافور و دیگر عنبرش نام",
