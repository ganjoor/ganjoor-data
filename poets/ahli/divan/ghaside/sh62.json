    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "الهی بنور علی آنکه افراخت",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
