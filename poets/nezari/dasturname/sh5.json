  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "چو بر مرکبِ فکر گردم سوار",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "نیارم گرفتن عنان استوار",
