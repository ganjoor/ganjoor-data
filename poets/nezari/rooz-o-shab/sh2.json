  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "نظری یا مفتح الابواب",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: به من نگاه کن یا ای دروازه‌های گشوده، تو علت و منبع همه علل هستی."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "سببی یا مسبب الاسباب",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "مرحمت کن که وقت مرحمت است",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: خواهش می‌کنم به من لطف کن، زیرا اکنون زمان لطف و مرحمت است و من زیر بار گناه و خطاهایم خجالت زده‌ام."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "گردنم زیر بار معصیت است",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "هیچ کم گردد از خزانه عام",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: آیا با بخشیدن خطای یک فرد نادان، از ثروت و دارایی‌های عمومی کاسته می‌شود؟"
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "که ببخشی گناه مشتی خام؟",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "چون تو پروردیم به اول کار",
