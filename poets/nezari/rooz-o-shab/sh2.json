  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "نظری یا مفتح الابواب",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: ای گشایندهٔ درها، نظری به من کن؛ ای پدیدآورندهٔ سبب‌ها، برای کار من سببی فراهم کن."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "سببی یا مسبب الاسباب",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "مرحمت کن که وقت مرحمت است",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: بر من رحم کن که اکنون هنگام رحمت است و گردنم زیر بار گناهان خم شده است."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "گردنم زیر بار معصیت است",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "هیچ کم گردد از خزانه عام",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: آیا اگر گناه گروهی نادان و خام را ببخشی، چیزی از خزانهٔ بخشش همگانی تو کم می‌شود؟ (یعنی هرگز کم نمی‌شود.)"
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "که ببخشی گناه مشتی خام؟",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "چون تو پروردیم به اول کار",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: چون در آغاز کار مرا پروردی، در پایان نیز رهایم مکن و مرا بیفکن؛ بلکه مرا بردار و دستگیری کن."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "هم به آخِر میفکنم، بر دار",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "گرچه از روی عفو تو خجلم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: هرچند از بخشش تو شرمسارم، باز بر من رحم کن، زیرا بسیار دل‌شکسته‌ام."
    },
    {
      "VOrder": 10,
