  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "شب دگر بار گشت آشفته",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: شب بار دیگر برآشفت و گفت که روز به من ناسزا گفته است."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "که: «مرا روز ناسزا گفته»",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "گفت از روی جِدّ نه از سر لاغ",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: شب جدی و نه به شوخی گفت: ای کسی که از زیاده‌روی و خودبینیِ ذهنت تباه شده‌ای!"
    },
    {
      "VOrder": 4,
      "Position": "Left",
