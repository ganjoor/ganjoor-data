      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "چه می خواهی دل ما خود دو نیم است",
      "CoupletIndex": 4,
      "SectionIndex1": 0
