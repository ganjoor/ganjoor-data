      "Text": "ارواح جنود شد جنود ارواح",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "تو بر سرِ کارِ خویشتن رایی",
