      "Text": "به جز بر آستانِ دل ستانم",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "نمی خواهم محلّ و منصب و جاه",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
