      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "به خرد می سزد مفاخرتم",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
