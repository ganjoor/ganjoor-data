      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "قبای مرصع کلاه مغرّق",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "ازین‌ها نباشد مرا در خزینه",
      "CoupletIndex": 4,
      "SectionIndex1": 0
