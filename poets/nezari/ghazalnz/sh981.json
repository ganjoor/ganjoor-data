    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "به راحی کن دوایِ دردِ مخمور",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "که باشد صاف همچون روحِ مؤمن",
      "CoupletIndex": 1,
      "SectionIndex1": 0
