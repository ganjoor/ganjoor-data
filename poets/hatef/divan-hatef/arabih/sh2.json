  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "سلمی علی رحلها و الرحل محمول",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: سلمی (دختری محبوب) با بارش (بار و وسایل سفر) آماده رفتن است و مسافران (عزیزان) در حال حرکت‌اند، اما دل من به عشق او بی‌قرار و پریشان است."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "والرکب مرتحل و القلب مبتول",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "تودع الصحب فی لهف و فی اسف",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: دوستان را با اندوه و حسرت ترک می‌کند و دل او از یاد دوستان غافل نیست."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "و قلبها بی عن‌الاصحاب مشغول",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "ترنوا الی بطرف مدنف خفر",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: به چشمان خود نگاه می‌کنید که به طرف مردی می‌روند که در آنجا در حال گریه است و اشک‌هایش صورتش را خیس کرده است."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "وردنها من سحوم الدمع مبلول",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "بقیت لما سروا جیران اثر هم",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: با وجود اینکه دوستانم به سوی عشق رفته‌اند و خوشحال هستند، من همچنان در پشت آن شتران سعادتمند و خوشحال، به یاد آثار و نشانه‌های غمش هستم."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "کاننی خلف تلک العیس عزمول",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "لا ضیر لولا منی فی حبها احد",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: در عشق او نبود اشکالی، اگر کسی از حال من و حال جوان عاشق بی‌خبر باشد، چرا که عشق و احوال عاشق ناشناخته است."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "جهلا بحالی و حال الصب مجهول",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "یا عاذلی فی هواها ما بذالک قل",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: ای عذاب‌دهنده‌ام به خاطر عشق او، نگو که این احساس کم‌ارزش است؛ زیرا جوان عاشق در حالتی که مورد تمسخر قرار دارد، بیشتر به او عشق می‌ورزد."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "فالصب یزداد حبا و هو معذول",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "دخلت منزلها لیلا علی و جل",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: در شب، به خانه‌اش وارد شدم و همه اهل خانه در آنجا بودند و پردهٔ شب به‌طور کامل پایین افتاده بود."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "من اهلها و قناع اللیل مسدول",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "مالت الی و قالت و هی ضاحکة",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: لیلا به طرف من خم شده و در حالی که می‌خندید گفت: ای در کوچه شب، آیا تو جن هستی یا غول؟"
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "یا طارق اللیل جن انت ام غول",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "مم اجتراء ک و الحراس ایقاظ",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: شما چه جرأت دارید در حالی که نگهبانان بیدار هستند و در میان دوتا چشمان شما، کشته‌ای بی‌جان وجود دارد."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "و بین عینیک مذبوح و مقتول",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "نحوه عنی سریعا لا ابالکم",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: سرعت و جسارت من را نادیده بگیرید، زیرا من نسبت به جان بیگانگان در مکان‌های پنهان (از جمله جنگ و خطر) بی‌تفاوت هستم."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "دم‌الاجانب فی الا خدار مطلول",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "فقلت صبک لابل عبدالعاصی",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: من به تو می‌گویم که تو که کودک و فرزند عبدالعاص هستی، به امور من توجه کن و از تو انتظار دارم که مرا عفو کنی."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "امری الیک و منک العفو مامول",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "فداک ما ولدت امی و ما رضعت",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: جانم فدای تو باشد، حتی آنچه مادرم مرا به دنیا آورد و آنچه را که در لحظهٔ نیاز به عشق شیر نوشیدم، در حالتی طرد شده و دور از عشق، با من است."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "اللب عند اهتیاج الشوق معزول",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "فقبلتنی و قالت مرحبا بفتی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: او (که به شاعر محبت دارد) مرا در آغوش گرفت و گفت: خوش آمدی ای جوان، عشق من تو را فریفته است و معذرت‌خواهی عاشق نیز پذیرفته است."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "اغواه حبی و عذر الصب مقبول",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "انعم مساء فنعم الضیف انت لنا",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: شبتان بخیر، خوش آمدید مهمان گرامی. ما هم از روح و جان خود برای پذیرایی از شما می‌کوشیم."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "والروح فینا علی الضیفان مبذول",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "جرت بذمانی الی اعلی اریکتها",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "CoupletSummary": "هوش مصنوعی: زمانه مرا به بالاترین عرش خود برده است و آغوشش پر از عطر مشک است."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "و مهدها عبق بالمسک مشمول",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "دنت و من معصیها قلدت عنقی",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17,
      "CoupletSummary": "هوش مصنوعی: به تو نزدیک شده‌ام و در عین حال از معصیت‌ها دوری می‌کنم، اما دلم به خاطر این زنجیر (غلی) که بر گردنم است، به شدت در فشار است."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "و عز جید بذاک الغل مغلول",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "شدت حبایل قلبی من غدایرها",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18,
      "CoupletSummary": "هوش مصنوعی: عشق شدید من مانند زنجیری است که قلبم را به خودش بسته و مرا به بند کشیده است."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "و ساد عبد بهذالقید مکبول",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "فارقدتنی و جائت فی غلالتها",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19,
      "CoupletSummary": "هوش مصنوعی: دلم برای تو تنگ شده و تو در درون لباس‌های خود مانند بادی به آرامی به سمتم می‌آیی، در حالی که آن لباس‌ها مانند باران بر بدن تو چسبیده‌اند."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "تمیس نحوی رویدا و هی عطبول",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "بیض ترائبها سود ذوائبها",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20,
      "CoupletSummary": "هوش مصنوعی: سینه‌اش سفیدتر از دانه‌های مروارید و موهایش سیاه و مجعد است، آنچه در میان این دو زیبایی می‌بینم، مانند زینت و زیبایی مروارید است."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "ما بینها من نظیم‌الدر عثکول",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "قز عقایصها بالبان فائحة",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21,
      "CoupletSummary": "هوش مصنوعی: موهایی که فر خورده و حجیم هستند، به خوبی عطر و بوی خوشی ساطع می‌کنند، و دست او (حوراء، زنی زیبا) به آن‌ها چنگ زده و محکم نگه داشته است."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "ممسک بید الحوراء مفتول",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "الدر منتشر فی‌النطق من فمها",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22,
      "CoupletSummary": "هوش مصنوعی: صدای دلپذیری از دهان او پخش می‌شود و بعد، شگفتا که چگونه این ملای که مورد مدح قرار گرفته است!"
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "و بعد یا عجبا ملای من‌اللل",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "ازیبق ثدیها فی الدرع منعقد",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23,
      "CoupletSummary": "هوش مصنوعی: سینه‌های او مانند دُرّی در زره محکم و بسته است، آیا مانند ستاره‌ای در سحرگاه آزاد و روشن نیست؟"
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "ام کوکب بحلیب الفجر محلول",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "لابل عی صدرها بدر بلا کلف",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24,
      "CoupletSummary": "هوش مصنوعی: سینهٔ او مانند ماهی بی عیب و بدون هیچ خال و لک است که مانند مرواریدی سفید و زیبا به نظر می‌رسد."
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "علیه من درة بیضاء ثولول",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "فالصقتنی علی صدر لها بهج",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25,
      "CoupletSummary": "هوش مصنوعی: من به سینهٔ او چسبیدم که چنان زیباست که گویی خورشید یا مانند طلای براق است."
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "کانه الشمس او بالشمس مصقول",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "فصرت لما سقتنی خمر ریقتها",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26,
      "CoupletSummary": "هوش مصنوعی: وقتی که از شراب لطیفش به من نوشاند، احساس کردم که مانند شخصی مست و سرمست و ناتوان شدم."
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "کاننی ثمل نشوان معلول",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "قنمت فی اطیب العیش الرغیدبها",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27,
      "CoupletSummary": "هوش مصنوعی: راضی و خشنود شدم از بهترین زندگی خوش‌گذرانی با او، زیرا او معتقد بود که در شب‌های ما با او طولانی‌تر می‌گذرد."
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "زعمت ان معها فی لیلنا طول",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "فینهتنی و قالت و هی باکیة",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28,
      "CoupletSummary": "هوش مصنوعی: او (مخاطب) به من گفت و در حال گریه بود که برخیز و از تیغ صبح (یعنی صبح) که کشیده شده فرار کن."
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "قم و اهربن فسیف الصبح مسلول",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 55,
