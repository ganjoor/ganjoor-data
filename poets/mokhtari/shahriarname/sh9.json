  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "دلاور برون راند آن فیل زود",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
