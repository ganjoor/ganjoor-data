  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "به نزدیک شیر آمد آن اهرمن",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "جهان جوی بفراخت گرز کشن",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
