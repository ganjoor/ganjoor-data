    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "شب آمد برو سوی پرده سرای",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "نشین شاد با نای و پرده سرای",
      "CoupletIndex": 31,
