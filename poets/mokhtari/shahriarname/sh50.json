    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "زره از تن هر دو بر خاک ریخت",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "رخ هر دوان پر خوی و خاک شد",
