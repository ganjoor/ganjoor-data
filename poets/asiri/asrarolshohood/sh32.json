      "SectionIndex1": 1,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "علمهای برتر از درک فهوم",
      "CoupletIndex": 15,
      "SectionIndex1": 1,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "این چنین دل هر کسی را چون دهند",
      "CoupletIndex": 16,
      "SectionIndex1": 1,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "تا نپنداری که هر کس زین دهند",
      "CoupletIndex": 16,
      "SectionIndex1": 1,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "سالها راه طریقت گر روی",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "ور ز درد عشق عمری نغنوی",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "ور تو گردی سالها خلوت نشین",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "دایما ً با ذکر حق باشی قرین",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "تادلت خالی ز مال و جاه نیست",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "جان تو محرم درین درگاه نیست",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "کی در عرفان گشاید جز به فکر",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "فکر صافی کی شود الا به ذکر",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "ذکر را باید دل خالی ز غیر",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "دل که در وی نیست جای شر و خیر",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "آن دلی پاکی که در وی غیر یار",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "هیچ دیاری نیابی وقت کار",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "تا نگردی از حظوظ نفس دور",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "کی دل و جانت شود روشن ز نور",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "جان طاعت چیست اخلاص و یقین",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 25
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "از تن بیجان چه حاصل خود ببین",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 25
    }
  ]
}
