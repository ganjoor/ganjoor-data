      "Position": "Left",
      "Text": "ره چه داند طالب راه اله",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "هر که او در عشق جانان می رود",
