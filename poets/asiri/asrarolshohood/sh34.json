      "SectionIndex2": 14
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "اختلاف امتی چون رحمت است",
      "CoupletIndex": 13,
      "SectionIndex1": 1,
      "SectionIndex2": 14
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "اختلاف امتان انبیا",
      "CoupletIndex": 14,
      "SectionIndex1": 1,
      "SectionIndex2": 15
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "چون ز عین حکمت آ مد ای فتی",
      "CoupletIndex": 14,
      "SectionIndex1": 1,
      "SectionIndex2": 15
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "اختلاف خلق و خالق چون بود",
      "CoupletIndex": 15,
      "SectionIndex1": 1,
      "SectionIndex2": 16
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "رحمت این بیگمان افزون بود",
      "CoupletIndex": 15,
      "SectionIndex1": 1,
      "SectionIndex2": 16
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "ره برین رحمت نبردی جاهلی",
      "CoupletIndex": 16,
      "SectionIndex1": 1,
      "SectionIndex2": 17
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "اعتراضی می ک نی بیحاصلی",
      "CoupletIndex": 16,
      "SectionIndex1": 1,
      "SectionIndex2": 17
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "گنج ایمانست زیر هر طلسم",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 18
    },
    {
      "VOrder": 67,
      "Position": "Left",
      "Text": "پیش عارف شد مسمی عین اسم",
      "CoupletIndex": 17,
      "SectionIndex1": 1,
      "SectionIndex2": 18
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "او بهر جا می ن ماید وصف خاص",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 19
    },
    {
      "VOrder": 71,
      "Position": "Left",
      "Text": "عین یک دیگر شمر تو عام و خاص",
      "CoupletIndex": 18,
      "SectionIndex1": 1,
      "SectionIndex2": 19
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "کرده در هر مظهری نوعی ظهور",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 20
    },
    {
      "VOrder": 75,
      "Position": "Left",
      "Text": "او به ما نزدیک و ما زو دور دور",
      "CoupletIndex": 19,
      "SectionIndex1": 1,
      "SectionIndex2": 20
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "گر به صورت گشت بیگانه زما",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 21
    },
    {
      "VOrder": 79,
      "Position": "Left",
      "Text": "او به معنی هست با ما آشنا",
      "CoupletIndex": 20,
      "SectionIndex1": 1,
      "SectionIndex2": 21
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "غیر دریا گر نماید موج آب",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 22
    },
    {
      "VOrder": 83,
      "Position": "Left",
      "Text": "عین دریا دان تو امواج و حباب",
      "CoupletIndex": 21,
      "SectionIndex1": 1,
      "SectionIndex2": 22
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "باز دیوانه شدم ای عاقلان",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 23
    },
    {
      "VOrder": 87,
      "Position": "Left",
      "Text": "در خور مجنون بود بند گران",
      "CoupletIndex": 22,
      "SectionIndex1": 1,
      "SectionIndex2": 23
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "دارم از دیوانگی صد غلغله",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 24
    },
    {
      "VOrder": 91,
      "Position": "Left",
      "Text": "خواهم از زنجیر زلفش سلسله",
      "CoupletIndex": 23,
      "SectionIndex1": 1,
      "SectionIndex2": 24
    },
    {
      "VOrder": 93,
      "Position": "Right",
      "Text": "زلف و جعد تابدار و پر گره",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 25
    },
    {
      "VOrder": 95,
      "Position": "Left",
      "Text": "حلقه حلقه گشته درهم چ ون زره",
      "CoupletIndex": 24,
      "SectionIndex1": 1,
      "SectionIndex2": 25
    },
    {
      "VOrder": 97,
      "Position": "Right",
      "Text": "هر دو عالم مست زلف مشکبوش",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 26
    },
    {
      "VOrder": 99,
      "Position": "Left",
      "Text": "گشته بر حسن جمالش روی پوش",
      "CoupletIndex": 25,
      "SectionIndex1": 1,
      "SectionIndex2": 26
    },
    {
      "VOrder": 101,
      "Position": "Right",
      "Text": "پای ما زین بند چون آزاد شد",
      "CoupletIndex": 26,
      "SectionIndex1": 1,
      "SectionIndex2": 27
    },
    {
      "VOrder": 103,
      "Position": "Left",
      "Text": "خانۀ تقلید بی بنیاد شد",
      "CoupletIndex": 26,
      "SectionIndex1": 1,
      "SectionIndex2": 27
    },
    {
      "VOrder": 105,
      "Position": "Right",
      "Text": "قول و فعل کاملان را کن سند",
      "CoupletIndex": 27,
      "SectionIndex1": 1,
      "SectionIndex2": 28
    },
    {
      "VOrder": 107,
      "Position": "Left",
      "Text": "گر همی خواهی ز حق یابی مدد",
      "CoupletIndex": 27,
      "SectionIndex1": 1,
      "SectionIndex2": 28
    },
    {
      "VOrder": 109,
      "Position": "Right",
      "Text": "توسن عرفان بود تند و حرون",
      "CoupletIndex": 28,
      "SectionIndex1": 1,
      "SectionIndex2": 29
    },
    {
      "VOrder": 111,
      "Position": "Left",
      "Text": "هان عنانش را بکش ای ذو فنون",
      "CoupletIndex": 28,
      "SectionIndex1": 1,
      "SectionIndex2": 29
    },
    {
      "VOrder": 113,
      "Position": "Right",
      "Text": "گر عنان او رها کردی بجست",
      "CoupletIndex": 29,
      "SectionIndex1": 1,
      "SectionIndex2": 30
    },
    {
      "VOrder": 115,
      "Position": "Left",
      "Text": "خیره گشت و اختیارت شد ز دست",
      "CoupletIndex": 29,
      "SectionIndex1": 1,
      "SectionIndex2": 30
    },
    {
      "VOrder": 117,
      "Position": "Right",
      "Text": "گه به دارت آورد حلاج وار",
      "CoupletIndex": 30,
      "SectionIndex1": 1,
      "SectionIndex2": 31
    },
    {
      "VOrder": 119,
      "Position": "Left",
      "Text": "گه بر خلقان شوی مطعون و خوار",
      "CoupletIndex": 30,
      "SectionIndex1": 1,
      "SectionIndex2": 31
    },
    {
      "VOrder": 121,
      "Position": "Right",
      "Text": "گه به زندیقی ترا نسبت کند",
      "CoupletIndex": 31,
      "SectionIndex1": 1,
      "SectionIndex2": 32
    },
    {
      "VOrder": 123,
      "Position": "Left",
      "Text": "گه به الحادت گواهی می دهد",
      "CoupletIndex": 31,
      "SectionIndex1": 1,
      "SectionIndex2": 32
    },
    {
      "VOrder": 125,
      "Position": "Right",
      "Text": "گه به مجنونی شوی مشهور شهر",
      "CoupletIndex": 32,
      "SectionIndex1": 1,
      "SectionIndex2": 33
    },
    {
      "VOrder": 127,
      "Position": "Left",
      "Text": "گه اسیر آیی تو در زندان دهر",
      "CoupletIndex": 32,
      "SectionIndex1": 1,
      "SectionIndex2": 33
    },
    {
      "VOrder": 129,
      "Position": "Right",
      "Text": "گه برونت می کند از شهر خویش",
      "CoupletIndex": 33,
      "SectionIndex1": 1,
      "SectionIndex2": 34
    },
    {
      "VOrder": 131,
      "Position": "Left",
      "Text": "گه برون از مذهب و دین است و کیش",
      "CoupletIndex": 33,
      "SectionIndex1": 1,
      "SectionIndex2": 34
    },
    {
      "VOrder": 133,
      "Position": "Right",
      "Text": "تا توانی رهروی هشیار باش",
      "CoupletIndex": 34,
      "SectionIndex1": 1,
      "SectionIndex2": 35
    },
    {
      "VOrder": 135,
      "Position": "Left",
      "Text": "راز جانت را مکن با خلق فاش",
      "CoupletIndex": 34,
      "SectionIndex1": 1,
      "SectionIndex2": 35
    },
    {
      "VOrder": 137,
      "Position": "Right",
      "Text": "سر حق را جز به اهل حق مگو",
      "CoupletIndex": 35,
      "SectionIndex1": 1,
      "SectionIndex2": 36
    },
    {
      "VOrder": 139,
      "Position": "Left",
      "Text": "غیر راه کاملان ای دل مپو",
      "CoupletIndex": 35,
      "SectionIndex1": 1,
      "SectionIndex2": 36
    }
  ]
}
