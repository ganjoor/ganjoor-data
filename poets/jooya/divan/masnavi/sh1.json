  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "بنام فروزندهٔ ماه و مهر",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "فرازندهٔ بارگاه سپهر",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ازو گشته در کار خود اوستاد",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "اگر آب و آتش اگر خاک و باد",
