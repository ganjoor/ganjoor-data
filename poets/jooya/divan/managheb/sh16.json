      "Text": "چو اهل طبع گشایند دیدهٔ انصاف",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "کجا لطافت نظم من و کجا گوهر",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
