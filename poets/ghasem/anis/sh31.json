  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ابلهی را علت درد شکم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "کرد عاجز هفته ای، یا بیش و کم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "رفت نزدیک طبیب خرده دان",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "علت خود عرضه کرد اندر زمان",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "چون سؤالش از غذا کرد آن عزیز",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "گفت: جغرات و چغندر با مویز",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "این سخن بشنید ازو داننده مرد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "بر سر و ریشش زمانی خنده کرد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "گفت: چشمت را سبل کرده است کور",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "ای ز تو دانش به صد فرسنگ دور",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "این چنین غافل نمی شاید غنود",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "بایدت رفتن بر کحال زود",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "تا سبل گرداند از چشم تو کم",
