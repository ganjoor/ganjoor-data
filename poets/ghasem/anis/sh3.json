      "CoupletsCount": 1,
      "MetreId": 6,
      "MetreRefSectionIndex": 0
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "صدر عالم،آفتاب شرع ودین",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: سرآمد همه عالم و منبع نور دین و شرع، بهترین انسان‌ها، پیامبر مرسلین است."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "صفوت آدم،نبی المرسلین",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "در دریای نبوت جان او",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: در عمق وجود پیامبران، روح آنان در نزد خداوند است و این نشان از مقام والای آنها دارد."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "«لی مع الله »آیتی در شأن او",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "روح پاکش معدن صدق وصفا",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: روح پاک او محل صداقت و صفا است، مانند شمعی که در ایوان هدایت پیامبر مصطفی میدرخشد."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "شمع ایوان هدایت مصطفا",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "عقل کل وامانده در معراج او",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: عقل کامل در مقابل صعود و ترقی او عاجز مانده و تنها در طول عمرش، تاجی از سوی خدا به او داده شده است."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "از«لعمرک »داده یزدان تاج او",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "مطلع انوار حق،مقصود کل",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: نخستین منبع روشنایی حقیقت، هدف تمامی رهبران دینی و پیشوایان پیامبران است."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "پیشوای شرع و سلطان رسل",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "ماحی عصیان آدم نام او",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: او کسی است که نافرمانی آدم را از بین برده و در هر دو جهان، همه را به نوشیدن از جام خود تشویق می‌کند."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "هر دو عالم جرعه خوار جام او",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "اختیار انبیا،بی اختلاف",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: اقتدار و شرافت پیامبران بدون هیچ گونه اختلافی، به خاندان عبد مناف تعلق دارد."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "افتخار دوده عبد مناف",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "ای ولایت خاتم جان رانگین",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: ای سرزمین خاتم پیامبران، پر از نور الهی و رحمت برای جهانیان."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "نور یزدان،رحمة للعالمین",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "لاف فرزندی ندارم،یا رسول",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: من ادعای فرزندی و نسبت به تو ندارم، ای رسول! من در راه تو خاک پای تو هستم، لطفاً مرا بپذیر و قبول کن."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "در رهت خاکم،قبولم کن،قبول",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "خود ندارم لاف فرزندی و هست",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: من ادعای فرزندی و بزرگ‌زاده بودن ندارم، اما سرم در کنار کوی تو مانند خاکی بی‌ارزش است."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "بر سر کویت سرم چون خاک پست",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "ای بشرعت قاسمی را افتخار",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: ای انسان، قاسمی را به عنوان شافع امت و افتخار پیامبر پروردگار تجلیل می‌کنیم."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "شافع امت، رسول کردگار",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "چار یارت پیشوای انس وجان",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: چهار یار تو پیشوای انسان‌ها و جان‌ها هستند و هر یک در زمان خود، صاحب قرآن می‌باشند."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "هریک ی در عهد خود صاحب قران",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "کار سازان شریعت هر چهار",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: کارگزاران دین و قوانین شرع، همانند چهار پرنده بزرگ و برتر در آسمان حقیقت هستند."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "شاهبازان حقیقت هر چهار",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "صد هزاران رحمت از دارالسلام",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: بسیاری از رحمت‌ها از بهشت بر روح پاک آنها نازل شود و درود بر آنان."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "بر روان پاک ایشان والسلام",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    }
  ]
}
