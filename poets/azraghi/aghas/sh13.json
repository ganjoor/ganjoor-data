      "Text": "اجل بازو زنان هرسو همی شد",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "بخون اندر ، چو مرد آشناور",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
