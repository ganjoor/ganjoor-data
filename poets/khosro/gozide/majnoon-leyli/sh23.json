  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "چون بر سر چرخ لاجوردی",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
