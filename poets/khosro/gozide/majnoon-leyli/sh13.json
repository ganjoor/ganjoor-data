  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "گوینده، حکایت آن چنان کرد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: گفتار او به گونه‌ای بود که کسی که دلتنگ و خسته بود، وقتی به پدرش رسید، آرامش گرفت."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "کان خسته چو با پدر روان کرد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "آمد به سرای خویش رنجور",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: به خانه‌اش برگشت، در حالی که بیمار و نزدیک به مرگ بود و از نوجوانی و جوانی‌اش چیزی نمانده بود."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "نزدیک به مرگ و از خرد دور",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "مادر چو بدید حال فرزند",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: مادر وقتی حال فرزندش را دید، از شدت درد و نگرانیش همه چیز را فراموش کرد و در فشار احساساتش، خود را رها ساخت."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "بگسست ز درد بندش از بند",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "بوسید، چو مادران، سرش را",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: او مانند مادران، سرش را بوسید و با اشک‌هایش، جسم او را تر کرد."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "تر کرد به گریه پیکرش را",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "گه جامه درید بهر سامانش",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: هر از گاهی برای بهبود وضعیت او، لباسش را می‌درد و گاهی با چشمانش چاک دامنش را می‌دوزد."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "گاه از مژه دوخت چاک دامانش",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "گریان نفسی به سر کشیدش",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: او با گریه‌ای جانسوز، خود را به زحمت بالا کشید و سپس لباس پاره‌ای به تن کرد."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "پس جامهٔ پاره بر کشیدش",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "شست از نم دیدگان نخستش",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: چشمانش را با عطر مشک و گلاب شستشو داد."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "از مشک و گلاب باز شستش",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "وانگاه تنش چو نقش خامه",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: سپس بدنش مانند یک نقاشی زیبا با عبا و عمامه تزیین شد."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "آراست به جبه و عمامه",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "زین لابه گری چو باز پرداخت",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: در این بیت، شاعر به تصویر کشیدن حالتی اشاره می‌کند که شخصی با اضطراب و ناله به سمت آشپزخانه می‌شتابد، شاید برای بررسی یا انتظار یک غذا یا خوراکی گرم. این حرکت او نشان‌دهنده‌ی اشتیاق و میل به چیزی دلپذیر است که او را به سرعت به سمت آن سوق می‌دهد."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "گرمی به سوی مطبخ خورش تاخت",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "آورد، ز راه مهربانی",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: از آنجا که مادر با محبت و مهربانی‌اش تو را بزرگ کرده است، باید محبت او را بشناسی و قدر آن را بدانی."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "مادر پختی، چنانکه دانی",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
