      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "تو چشم و غمزه را کشتن میاموز",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "که کس این شیوه به زیشان نداند",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "خیالت بین به چشمم تا نگویی",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
