      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 65,
      "Position": "CenteredVerse1",
      "Text": "از بندگی حضرت او جسته مباهات",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 66,
      "Position": "Right",
      "Text": "یا رب به درش قامت افلاک نگون باد",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 67,
      "Position": "Left",
      "Text": "از کوه وقارش به دل خاره سکون باد",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 68,
      "Position": "Right",
      "Text": "از نه فلک و شش جهتش ملک فزون باد",
