      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "تا کی زجفای تو رسانم به فلک آه؟",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "اکنون که نداری خبر از آه سحرگاه",
