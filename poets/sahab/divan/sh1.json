      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 35,
      "Position": "CenteredVerse1",
      "Text": "سهل است که جوید به سگان تو مباهات",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "از بسکه غم عشق تو در دل بفزودم",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "گوی از همه عشاق به عشقت بربودم",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "بسیار نکویان جهان را بستودم",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "هر جای که از مصحف خوبی بگشودم",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 40,
      "Position": "CenteredVerse1",
      "Text": "در شان تو دیدم شده نازل همه آیات",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "ای نخل تمنای من از وصل تو پر بار",
