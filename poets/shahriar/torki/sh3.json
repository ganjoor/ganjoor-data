{
  "Id": 49099,
  "CatId": 1735,
  "Title": "سهندیم",
  "FullTitle": "شهریار » گزیدهٔ اشعار ترکی » سهندیم",
  "FullUrl": "/shahriar/torki/sh3",
  "SourceName": "همراهان گنجور",
  "SourceUrlSlug": "hamrahan",
  "Language": "azb",
  "PoemSummary": "هوش مصنوعی: این متن شعر زیبایی است که به توصیف طبیعت و زیبایی‌های زندگی در منطقه‌ای به نام \u0022سهند\u0022 می‌پردازد. شاعر با استفاده از تصویرسازی‌های زیبا، داغستان را به عنوان محیطی پر از عشق، زیبایی و احساس معرفی می‌کند. او به عناصر طبیعی مانند کوه‌ها، دره‌ها، گل‌ها و آبشارها اشاره می‌کند و همچنین به احساست انسانی و عواطفی که با این طبیعت مرتبط هستند. شاعر عشق و اشتیاق خود را به سرزمینش ابراز می‌کند و زیبایی‌های آن را با دقت و عشق به تصویر می‌کشد. این شعر از عشق به وطن و زیبایی‌های آن سرشار است و شاعر به نوعی روح ملی و فرهنگی خود را در آن روایت می‌کند.",
  "Sections": [],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Single",
      "Text": "شاه داغیم، چال پاپاغیم، ائل دایاغیم، شانلی سهند´یم",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Single",
      "Text": "باشی طوفانلی سهند´یم",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Single",
      "Text": "باشدا حئیدر بابا تک قارلا، قیروولا قاریشیب سان",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Single",
      "Text": "سون ایپک تئللی بولودلارلا اوفوقده ساریشیب سان",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Single",
      "Text": "ساواشارکن باریشیب سان",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Single",
      "Text": "گؤیدن ایلهام آلالی سیرری سماواتا دئیه رسه ن",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Single",
      "Text": "هله آغ کورکو بورون، یازدا یاشیل دون دا گئیه رسه ن",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Single",
      "Text": "قورادان حالوا یئیه رسه ن",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Single",
      "Text": "دؤشلرینده سونالار سینه سی تک شوخ ممه لرده",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Single",
      "Text": "نه شیرین چئشمه لرین وار",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Single",
      "Text": "او یاشیل تئللری، یئل هؤرمه ده آینالی سحه رده",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Single",
      "Text": "عشوه لی ائشمه لرین وار",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Single",
      "Text": "قوی یاغیش یاغسا دا یاغسین",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Single",
      "Text": "سئل اولوب آخسا دا آخسین",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Single",
      "Text": "یان لاریندا دره لر وار",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Single",
      "Text": "قوی قلمقاش لارین اوچسون فره لرله، هامی باخسین",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Single",
      "Text": "دوش لرینده هئره لر وار",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Single",
      "Text": "سیلدیریم لار، سره لر وار",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Single",
      "Text": "او اتک لرده نه قیزلار یاناغی لاله لرین وار",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 20,
      "Position": "Single",
      "Text": "قوزولار اوتلایاراق نی ده نه خوش ناله لرین وار",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Single",
      "Text": "آی کیمی هاله لرین وار",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Single",
      "Text": "گول چیچکدن بزه ننده، نه گلین لر کیمی نازین",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Single",
      "Text": "یئل اسنده او سولاردا نه درین راز و نیازین",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Single",
      "Text": "اوینایار گوللو قوتازین",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Single",
      "Text": "تیتره ییر ساز تئلی تک شاخه لرین چایدا - چمنده",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Single",
      "Text": "یئل او تئل لرده گزه نده، نه کوراوغلو چالی سازین",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Single",
      "Text": "اؤرده گین خلوت ائدیب گؤلده پری لرله چیمنده",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 28,
      "Position": "Single",
      "Text": "قول-قاناددان اونا آغ حوله آچار غمزه لی قازین",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Single",
      "Text": "قیش گئدر، قوی گله یازین",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 30,
      "Position": "Single",
      "Text": "هله نوروز گولی وار، قار چیچگین وار، گله جکلر",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Single",
      "Text": "سئل - یاغشیدا یویونارکن ده گونش له گوله جکلر",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 32,
      "Position": "Single",
      "Text": "اوزلرین تئز سیله جکلر",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Single",
      "Text": "قیشدا کهلیک هوسیله، چؤله قاچدیقدا جوان لار",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 34,
      "Position": "Single",
      "Text": "قاردا قاققیلدایاراق نازلی قلمقاش لارین اولسون",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Single",
      "Text": "یاز، او دؤش لرده ناهار منده سین آچدیقدا چوبان لار",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 36,
      "Position": "Single",
      "Text": "بوللو ، سودلو سورولر، دادلی قاووتماش لارین اولسون",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Single",
      "Text": "آد آلیب سندن او شاعیر کی سن اوندان آد آلارسان",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Single",
      "Text": "اونا هر داد وئره سه ن، یوز او مقابل داد آلارسان",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Single",
      "Text": "تاریدان هر زاد آلارسان",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Single",
      "Text": "آداش اولدوقدا، سن اونلا، داها آرتین اوجالارسان",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Single",
      "Text": "باش اوجالدیقدا دماوند داغیندان باج آلارسان",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 42,
      "Position": "Single",
      "Text": "شر الیندن تاج آلارسان!",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Single",
      "Text": "او دا شعرین ادبین شاه داغیدر، شانلی سهندی",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 44,
      "Position": "Single",
      "Text": "او دا سن تک آتار اولدوزلارا شعر ایله کمندی",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Single",
      "Text": "او دا سیمرغدن آلماقدادی فندی",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 46,
      "Position": "Single",
      "Text": "شعر یازاندا قلمیندن باخاسان درسپه‌لندی",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Single",
      "Text": "سانکی اولدوزلار الندی",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 48,
      "Position": "Single",
      "Text": "سوز دینده گوروسن قاتدی گولی، پسته‌نی، قندی",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Single",
      "Text": "یاشاسین شاعر افندی!",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 50,
      "Position": "Single",
      "Text": "او نه شاعر کی داغین وصفینه مصداق اونی گوردوم",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Single",
      "Text": "من سنین تک اوجالیق مشقینه مشاق اونی گوردوم",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 52,
      "Position": "Single",
      "Text": "عشقه، عشق اهلینه مشتاق اونی گوردوم.",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Single",
      "Text": "او نه شاعر کی خیال مرکبینه شووشیغایاندا",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 54,
      "Position": "Single",
      "Text": "او نهنگ آت آیاغین توزلی بولودلاردا قویاندا",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Single",
      "Text": "لوله‌لنمکده‌دی یر گوی، نجه طومار ساریاندا",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 56,
      "Position": "Single",
      "Text": "گوره‌جکسن او زماندا:",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Single",
      "Text": "نه زمان وارسا، مکان وار ساکسیب بیچدی بیر آندا",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 58,
      "Position": "Single",
      "Text": "کچه‌جکلر، گله‌جکلر نه بویاندا نه اویاندا",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Single",
      "Text": "نه بیلیم قالدی هایاندا؟",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 60,
      "Position": "Single",
      "Text": "باخ نه حرمت وار اونون اوز دمیشی توک پاپاغیندا",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Single",
      "Text": "شعرینین تاجی اگیلمیش باشی دورموش قاباغیندا",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 62,
      "Position": "Single",
      "Text": "باشینا ساوریلان اینجی، چارلیق اولموش آیاغیندا",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Single",
      "Text": "وحی‌دیر شعری، ملکلردی پیچیلدیر قولاغیندا.",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 64,
      "Position": "Single",
      "Text": "شهدی وار بال دوداغیندا.",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Single",
      "Text": "او دا داغلار کیمی شانینده نه یازسام یاراشاندیر",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 66,
      "Position": "Single",
      "Text": "او دا ظالم قوپاران قارلا، کولکله دوروشاندیر",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Single",
      "Text": "قودوزا، ظالمه قارشی سینه گرمیش، ووروشاندیر",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 68,
      "Position": "Single",
      "Text": "قودوزون کورکونه، ظالم بیره‌لر تک داراشاندیر",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Single",
      "Text": "اما وجهینده فقیر خلقی اگیلمیش سوروشاندیر",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 70,
      "Position": "Single",
      "Text": "قارا ملتده هنر بولسا، هنرله آراشاندیر",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Single",
      "Text": "قارالارلا قاریشاندیر،",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 72,
      "Position": "Single",
      "Text": "ساریشاندیر!",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Single",
      "Text": "گئجه حقین گوزودیر، طور تورتمیش اوجاغیندا",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 74,
      "Position": "Single",
      "Text": "اریییب یاغ تک اورکلردی یانیرلار چراغیندا",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Single",
      "Text": "می، محبتدن ایچیب لاله بیتیبدیر یاناغیندا",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 76,
      "Position": "Single",
      "Text": "او بیر اوغلان کی، پری‌لر سو ایچرلر چاناغیندا",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Single",
      "Text": "اینجی قاینار بولاغیندا",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 78,
      "Position": "Single",
      "Text": "طبعی بیر سوگلی بولبول کی، اوخور گول بوداغیندا",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Single",
      "Text": "ساری سونبول قوجاغیندا",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 80,
      "Position": "Single",
      "Text": "سولار افسانه‌دی سؤیلر اونون افسونلی باغیندا",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Single",
      "Text": "سحرین چنلی چاغیندا.",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 82,
      "Position": "Single",
      "Text": "شاعرین ذوقی، نه افسونلی، نه افسانه‌لی باغلار،",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 83,
      "Position": "Single",
      "Text": "آی نه باغلار، کی «الف لیلی» ده افسانه‌ده باغلار.",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 84,
      "Position": "Single",
      "Text": "اود یاخیب، داغلاری داغلار،",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 85,
      "Position": "Single",
      "Text": "گول گولرسه بولاغ آغلار.",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 86,
      "Position": "Single",
      "Text": "شاعرین عالمی اولمز، اونا عالمده زوال یوخ",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 87,
      "Position": "Single",
      "Text": "آرزولار اوردا نه خاطرلیه امکاندی، محال یوخ",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 88,
      "Position": "Single",
      "Text": "باغ جنت کیمی اوردا «بو حرامدیر، بو حلال» یوخ.",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    },
    {
      "VOrder": 89,
      "Position": "Single",
      "Text": "او محبتده ملال یوخ،",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    },
    {
      "VOrder": 90,
      "Position": "Single",
      "Text": "اوردا حالدیر، داها قال یوخ!",
      "CoupletIndex": 64,
      "SectionIndex1": 0
    },
    {
      "VOrder": 91,
      "Position": "Single",
      "Text": "گئجه‌لر اوردا گوموشدندی، قیزیلدان نه گونوزلر،",
      "CoupletIndex": 64,
      "SectionIndex1": 0
    },
    {
      "VOrder": 92,
      "Position": "Single",
      "Text": "نه زمرد کیمی باغلاردی، نه مرمر کیمی دوزلر،",
      "CoupletIndex": 65,
      "SectionIndex1": 0
    },
    {
      "VOrder": 93,
      "Position": "Single",
      "Text": "نه ساری تئللی اینکلر، نه آلاگؤزلو اوکوزلر،",
      "CoupletIndex": 65,
      "SectionIndex1": 0
    },
    {
      "VOrder": 94,
      "Position": "Single",
      "Text": "آی نئجه، آی کیمی اوزلر؟",
      "CoupletIndex": 66,
      "SectionIndex1": 0
    },
    {
      "VOrder": 95,
      "Position": "Single",
      "Text": "گول آغاجلاری نه طاووس کیمی چترین آچیب الوان،",
      "CoupletIndex": 66,
      "SectionIndex1": 0
    },
    {
      "VOrder": 96,
      "Position": "Single",
      "Text": "«حله» کروانیدی چؤللر، بزه نر سورسه بو کروان،",
      "CoupletIndex": 67,
      "SectionIndex1": 0
    },
    {
      "VOrder": 97,
      "Position": "Single",
      "Text": "دوه کروانی دا داغلار، یوکی اطلسدی بو حیوان،",
      "CoupletIndex": 67,
      "SectionIndex1": 0
    },
    {
      "VOrder": 98,
      "Position": "Single",
      "Text": "صابرین شهرینه دوغرو، قاطاری چکمه‌ده سروان،",
      "CoupletIndex": 68,
      "SectionIndex1": 0
    },
    {
      "VOrder": 99,
      "Position": "Single",
      "Text": "او خیالیمداکی شیروان!",
      "CoupletIndex": 68,
      "SectionIndex1": 0
    },
    {
      "VOrder": 100,
      "Position": "Single",
      "Text": "اوردا قار دا یاغار، اما داها گوللر سولا بیلمز",
      "CoupletIndex": 69,
      "SectionIndex1": 0
    },
    {
      "VOrder": 101,
      "Position": "Single",
      "Text": "بو طبیعت، او طراوتده محالدیر، اولا بیلمز",
      "CoupletIndex": 69,
      "SectionIndex1": 0
    },
    {
      "VOrder": 102,
      "Position": "Single",
      "Text": "عمر پئیمانه سی اوردا دولا بیلمز",
      "CoupletIndex": 70,
      "SectionIndex1": 0
    },
    {
      "VOrder": 103,
      "Position": "Single",
      "Text": "او افق لرده باخارسان نه ده نیزلر، نه بوغازلار",
      "CoupletIndex": 71,
      "SectionIndex1": 0
    },
    {
      "VOrder": 104,
      "Position": "Single",
      "Text": "نه پری لر کیمی قولار، قونوب-اوچماقدا نه قازلار",
      "CoupletIndex": 72,
      "SectionIndex1": 0
    },
    {
      "VOrder": 105,
      "Position": "Single",
      "Text": "گؤلده چیممکده نه قیزلار",
      "CoupletIndex": 73,
      "SectionIndex1": 0
    },
    {
      "VOrder": 106,
      "Position": "Single",
      "Text": "بالیق، اولدوز کیمی گؤل لرده، ده نیزلرده پاریلدار",
      "CoupletIndex": 74,
      "SectionIndex1": 0
    },
    {
      "VOrder": 107,
      "Position": "Single",
      "Text": "آبشار مرواری سین سئل کیمی تؤکدوکده خاریلدار",
      "CoupletIndex": 75,
      "SectionIndex1": 0
    },
    {
      "VOrder": 108,
      "Position": "Single",
      "Text": "یئل کوشولدار، سو شاریلدار",
      "CoupletIndex": 76,
      "SectionIndex1": 0
    },
    {
      "VOrder": 109,
      "Position": "Single",
      "Text": "قصرلر واردی قیزیلدان، قالالار واردی عقیق دن",
      "CoupletIndex": 77,
      "SectionIndex1": 0
    },
    {
      "VOrder": 110,
      "Position": "Single",
      "Text": "«رافائل» تابلوسی تک، صحنه لری عهد عتیق دن",
      "CoupletIndex": 78,
      "SectionIndex1": 0
    },
    {
      "VOrder": 111,
      "Position": "Single",
      "Text": "دویماسان کؤهنه رفیق دن",
      "CoupletIndex": 79,
      "SectionIndex1": 0
    },
    {
      "VOrder": 112,
      "Position": "Single",
      "Text": "جننتین باغ لاری تک باغلاری نین حورو قصوری",
      "CoupletIndex": 80,
      "SectionIndex1": 0
    },
    {
      "VOrder": 113,
      "Position": "Single",
      "Text": "دوزولوب غرفه‌ده، ایواندا، جواهر کیمی حوری،",
      "CoupletIndex": 81,
      "SectionIndex1": 0
    },
    {
      "VOrder": 114,
      "Position": "Single",
      "Text": "الده حوری‌لرینین جام بلوری،",
      "CoupletIndex": 81,
      "SectionIndex1": 0
    },
    {
      "VOrder": 115,
      "Position": "Single",
      "Text": "تونگونون گول کیمی «صهبای طهوری».",
      "CoupletIndex": 82,
      "SectionIndex1": 0
    },
    {
      "VOrder": 116,
      "Position": "Single",
      "Text": "نه ماراقلار کی آییق گؤزلره رؤیادی دییرسن،",
      "CoupletIndex": 82,
      "SectionIndex1": 0
    },
    {
      "VOrder": 117,
      "Position": "Single",
      "Text": "نه شفقلر کی درین باخمادا دریادی دییرسن،",
      "CoupletIndex": 83,
      "SectionIndex1": 0
    },
    {
      "VOrder": 118,
      "Position": "Single",
      "Text": "اویدوران جنت مأوادی دییرسن!",
      "CoupletIndex": 83,
      "SectionIndex1": 0
    },
    {
      "VOrder": 119,
      "Position": "Single",
      "Text": "زهره‌نین قری بریلیان، حصاری اینجی‌دی، یاقوت،",
      "CoupletIndex": 84,
      "SectionIndex1": 0
    },
    {
      "VOrder": 120,
      "Position": "Single",
      "Text": "قصر جادودی، مهندسلری هاروت ایله ماروت،",
      "CoupletIndex": 84,
      "SectionIndex1": 0
    },
    {
      "VOrder": 121,
      "Position": "Single",
      "Text": "اوردا «مانی» دایانیب قالمیش او صورتلره مبهوت،",
      "CoupletIndex": 85,
      "SectionIndex1": 0
    },
    {
      "VOrder": 122,
      "Position": "Single",
      "Text": "قاپی قوللوچی‌سی هاروت!",
      "CoupletIndex": 85,
      "SectionIndex1": 0
    },
    {
      "VOrder": 123,
      "Position": "Single",
      "Text": "اوردا شعرین، موزیکون منبعی سرچشمه‌دی قاینار،",
      "CoupletIndex": 86,
      "SectionIndex1": 0
    },
    {
      "VOrder": 124,
      "Position": "Single",
      "Text": "نه پری‌لر کیمی فواره‌دن افشان اولوب اوینار،",
      "CoupletIndex": 86,
      "SectionIndex1": 0
    },
    {
      "VOrder": 125,
      "Position": "Single",
      "Text": "شاعر آنجاق اونو آنلار!",
      "CoupletIndex": 87,
      "SectionIndex1": 0
    },
    {
      "VOrder": 126,
      "Position": "Single",
      "Text": "دولو مهتاب کیمی استخردی فواره‌لر ایله،",
      "CoupletIndex": 87,
      "SectionIndex1": 0
    },
    {
      "VOrder": 127,
      "Position": "Single",
      "Text": "ملکه اوردا چیمیر، آی کیمی مهپاره‌لر ایله،",
      "CoupletIndex": 88,
      "SectionIndex1": 0
    },
    {
      "VOrder": 128,
      "Position": "Single",
      "Text": "گوللو گوشواره‌لر ایله.",
      "CoupletIndex": 88,
      "SectionIndex1": 0
    },
    {
      "VOrder": 129,
      "Position": "Single",
      "Text": "شعر و موسیقی شاباش اولمادا، افشاندی پریشان،",
      "CoupletIndex": 89,
      "SectionIndex1": 0
    },
    {
      "VOrder": 130,
      "Position": "Single",
      "Text": "سانکی آغ شاهی‌دیر اولماقدا گلین باشینا افشان،",
      "CoupletIndex": 89,
      "SectionIndex1": 0
    },
    {
      "VOrder": 131,
      "Position": "Single",
      "Text": "نه گلینلر کی نه انلیک اوزه سورترله، نه کیرشان،",
      "CoupletIndex": 90,
      "SectionIndex1": 0
    },
    {
      "VOrder": 132,
      "Position": "Single",
      "Text": "یاخا، نه تولکی، نه دووشان!",
      "CoupletIndex": 90,
      "SectionIndex1": 0
    },
    {
      "VOrder": 133,
      "Position": "Single",
      "Text": "آغ پری‌لر، ساری کؤینکلی بولودلاردان انیرلر،",
      "CoupletIndex": 91,
      "SectionIndex1": 0
    },
    {
      "VOrder": 134,
      "Position": "Single",
      "Text": "سود گؤلونده ملکه ایله چیمیرکن سئوینیرلر،",
      "CoupletIndex": 91,
      "SectionIndex1": 0
    },
    {
      "VOrder": 135,
      "Position": "Single",
      "Text": "سئوینیرلر، اویونورلر.",
      "CoupletIndex": 92,
      "SectionIndex1": 0
    },
    {
      "VOrder": 136,
      "Position": "Single",
      "Text": "قووزایاندا هره الده دولو بیر جام آپاریلار،",
      "CoupletIndex": 92,
      "SectionIndex1": 0
    },
    {
      "VOrder": 137,
      "Position": "Single",
      "Text": "سانکی چنگی‌لره، شاعرلره الهام آپاریرلار،",
      "CoupletIndex": 93,
      "SectionIndex1": 0
    },
    {
      "VOrder": 138,
      "Position": "Single",
      "Text": "دریا قیزلارینا پیغام آپاریرلار",
      "CoupletIndex": 94,
      "SectionIndex1": 0
    },
    {
      "VOrder": 139,
      "Position": "Single",
      "Text": "ده نیزین اؤرتوگو ماوی، افقون سقفی سماوی",
      "CoupletIndex": 95,
      "SectionIndex1": 0
    },
    {
      "VOrder": 140,
      "Position": "Single",
      "Text": "آینا دیر هر نه باخیرسان : یئر اولوب گؤی له مساوی",
      "CoupletIndex": 96,
      "SectionIndex1": 0
    },
    {
      "VOrder": 141,
      "Position": "Single",
      "Text": "غرق اونون شعرینه راوی",
      "CoupletIndex": 97,
      "SectionIndex1": 0
    },
    {
      "VOrder": 142,
      "Position": "Single",
      "Text": "غرفه لر، آی، بولود آلتیندا اولار تک گؤرونورلر",
      "CoupletIndex": 98,
      "SectionIndex1": 0
    },
    {
      "VOrder": 143,
      "Position": "Single",
      "Text": "گؤز آچیب-یومما، چیراغ لار کیمی یاندیقدا سؤنورلر",
      "CoupletIndex": 99,
      "SectionIndex1": 0
    },
    {
      "VOrder": 144,
      "Position": "Single",
      "Text": "صحنه لر چرخ فلک تک بورولوب، گاه دا چؤنورلر",
      "CoupletIndex": 100,
      "SectionIndex1": 0
    },
    {
      "VOrder": 145,
      "Position": "Single",
      "Text": "کؤلگه لیک لر سورونورلر",
      "CoupletIndex": 101,
      "SectionIndex1": 0
    },
    {
      "VOrder": 146,
      "Position": "Single",
      "Text": "زهره ایواندا الهه شینلینده گؤرونرکن",
      "CoupletIndex": 102,
      "SectionIndex1": 0
    },
    {
      "VOrder": 147,
      "Position": "Single",
      "Text": "باخاسان حافظی ده اوردا جلالت له گؤررسن",
      "CoupletIndex": 103,
      "SectionIndex1": 0
    },
    {
      "VOrder": 148,
      "Position": "Single",
      "Text": "نه سئور سن",
      "CoupletIndex": 104,
      "SectionIndex1": 0
    },
    {
      "VOrder": 149,
      "Position": "Single",
      "Text": "گاه گؤرن حافظ شیراز ایله ایواندا دوروبلار",
      "CoupletIndex": 105,
      "SectionIndex1": 0
    },
    {
      "VOrder": 150,
      "Position": "Single",
      "Text": "گاه گؤرن اورتادا شطرنج قورارکن اوتوروبلار",
      "CoupletIndex": 106,
      "SectionIndex1": 0
    },
    {
      "VOrder": 151,
      "Position": "Single",
      "Text": "گاه گؤرن سازیله، آوازیله اگلنجه قوروبلار",
      "CoupletIndex": 107,
      "SectionIndex1": 0
    },
    {
      "VOrder": 152,
      "Position": "Single",
      "Text": "سانکی ساغر ده ووروبلار",
      "CoupletIndex": 108,
      "SectionIndex1": 0
    },
    {
      "VOrder": 153,
      "Position": "Single",
      "Text": "خاجه الحان اوخویاندا، هامی ایشدن دایانیرلار",
      "CoupletIndex": 109,
      "SectionIndex1": 0
    },
    {
      "VOrder": 154,
      "Position": "Single",
      "Text": "او نوالرله پری لر گاه اویوب گاه اویانیرلار",
      "CoupletIndex": 110,
      "SectionIndex1": 0
    },
    {
      "VOrder": 155,
      "Position": "Single",
      "Text": "لاله لر شعله سی، الوان شیشه رنگی بویانیرلار",
      "CoupletIndex": 111,
      "SectionIndex1": 0
    },
    {
      "VOrder": 156,
      "Position": "Single",
      "Text": "نه خومار گؤزلو یانیرلار",
      "CoupletIndex": 112,
      "SectionIndex1": 0
    },
    {
      "VOrder": 157,
      "Position": "Single",
      "Text": "قاناد ایستیر بو افق، قوی قالا طرلانلی سهند´یم",
      "CoupletIndex": 113,
      "SectionIndex1": 0
    },
    {
      "VOrder": 158,
      "Position": "Single",
      "Text": "ائشید اؤز قصه می، دستانیمی، دستانلی سهند´یم",
      "CoupletIndex": 114,
      "SectionIndex1": 0
    },
    {
      "VOrder": 159,
      "Position": "Single",
      "Text": "سنی «حیدر بابا» اول نعره لر ایله چاغیراندا",
      "CoupletIndex": 115,
      "SectionIndex1": 0
    },
    {
      "VOrder": 160,
      "Position": "Single",
      "Text": "او سفیل داردا قالان تولکو قووان شئر باغیراندا",
      "CoupletIndex": 116,
      "SectionIndex1": 0
    },
    {
      "VOrder": 161,
      "Position": "Single",
      "Text": "شیطانین شیللاغا قالخان قاطیری نوخدا قیراندا",
      "CoupletIndex": 117,
      "SectionIndex1": 0
    },
    {
      "VOrder": 162,
      "Position": "Single",
      "Text": "«دده قورقود» سسین آلدیم، دئدیم «آرخامدی» ایناندیم",
      "CoupletIndex": 118,
      "SectionIndex1": 0
    },
    {
      "VOrder": 163,
      "Position": "Single",
      "Text": "آرخا دوردوقدا «سهندیم» ساوالان تک هاوالاندیم",
      "CoupletIndex": 119,
      "SectionIndex1": 0
    },
    {
      "VOrder": 164,
      "Position": "Single",
      "Text": "سئله قارشی قووالاندیم",
      "CoupletIndex": 120,
      "SectionIndex1": 0
    },
    {
      "VOrder": 165,
      "Position": "Single",
      "Text": "«جوشغون»ون دا قانی داشدی، منه بیر هایلی سس اولدو",
      "CoupletIndex": 121,
      "SectionIndex1": 0
    },
    {
      "VOrder": 166,
      "Position": "Single",
      "Text": "هر سسیز بیر نفس اولدو",
      "CoupletIndex": 122,
      "SectionIndex1": 0
    },
    {
      "VOrder": 167,
      "Position": "Single",
      "Text": "«باکی »داغلاری دا، های وئردی سسه، قیها اوجالدی",
      "CoupletIndex": 123,
      "SectionIndex1": 0
    },
    {
      "VOrder": 168,
      "Position": "Single",
      "Text": "او تایین نعره‌لری سانکی بو تایدان دا باج آلدی،",
      "CoupletIndex": 124,
      "SectionIndex1": 0
    },
    {
      "VOrder": 169,
      "Position": "Single",
      "Text": "قورد آجالدیقدا قوجالدی.",
      "CoupletIndex": 124,
      "SectionIndex1": 0
    },
    {
      "VOrder": 170,
      "Position": "Single",
      "Text": "«راحمین» نعره‌سی قووزاندی دین توپلار آتیلدی،",
      "CoupletIndex": 125,
      "SectionIndex1": 0
    },
    {
      "VOrder": 171,
      "Position": "Single",
      "Text": "سئل گلیب نهره قاتیلدی.",
      "CoupletIndex": 125,
      "SectionIndex1": 0
    },
    {
      "VOrder": 172,
      "Position": "Single",
      "Text": "«رستمین» توپلاری سسلندی دیین بوملار آچیلدی،",
      "CoupletIndex": 126,
      "SectionIndex1": 0
    },
    {
      "VOrder": 173,
      "Position": "Single",
      "Text": "بیزه گول غنچه ساچیلدی.",
      "CoupletIndex": 126,
      "SectionIndex1": 0
    },
    {
      "VOrder": 174,
      "Position": "Single",
      "Text": "«قورخما گلدیم» دیه، سسلرده منه جان ددی قارداش",
      "CoupletIndex": 127,
      "SectionIndex1": 0
    },
    {
      "VOrder": 175,
      "Position": "Single",
      "Text": "یاشا اوغلان سیزه داغدان دلی جیران ددی قارداش",
      "CoupletIndex": 127,
      "SectionIndex1": 0
    },
    {
      "VOrder": 176,
      "Position": "Single",
      "Text": "ائل سیزه قافلان ددی قارداش!",
      "CoupletIndex": 128,
      "SectionIndex1": 0
    },
    {
      "VOrder": 177,
      "Position": "Single",
      "Text": "داغ سیزه اصلان ددی قارداش!",
      "CoupletIndex": 128,
      "SectionIndex1": 0
    },
    {
      "VOrder": 178,
      "Position": "Single",
      "Text": "داغلی حیدربابانین آرخاسی هر یئرده داغ اولدی،",
      "CoupletIndex": 129,
      "SectionIndex1": 0
    },
    {
      "VOrder": 179,
      "Position": "Single",
      "Text": "داغا داغلار دایاغ اولدی.",
      "CoupletIndex": 129,
      "SectionIndex1": 0
    },
    {
      "VOrder": 180,
      "Position": "Single",
      "Text": "آرازیم آینا چراغ قویمادا، آیدین شافاغ اولدی،",
      "CoupletIndex": 130,
      "SectionIndex1": 0
    },
    {
      "VOrder": 181,
      "Position": "Single",
      "Text": "او تایین نغمه‌سی قووزاندی، اورکلر قولاغ اولدی،",
      "CoupletIndex": 130,
      "SectionIndex1": 0
    },
    {
      "VOrder": 182,
      "Position": "Single",
      "Text": "ینه قارداش دیرک قاچمادا باشلار آیاغ اولدی،",
      "CoupletIndex": 131,
      "SectionIndex1": 0
    },
    {
      "VOrder": 183,
      "Position": "Single",
      "Text": "قاچدیق، اوزلشدیک آرازدا، ینه گؤزلر بولاغ اولدی،",
      "CoupletIndex": 131,
      "SectionIndex1": 0
    },
    {
      "VOrder": 184,
      "Position": "Single",
      "Text": "ینه غملر قالاغ اولدی.",
      "CoupletIndex": 132,
      "SectionIndex1": 0
    },
    {
      "VOrder": 185,
      "Position": "Single",
      "Text": "ینه قارداش سایاغی سؤزلریمیز بیر سایاغ اولدی،",
      "CoupletIndex": 132,
      "SectionIndex1": 0
    },
    {
      "VOrder": 186,
      "Position": "Single",
      "Text": "وصل ایگین آلمادا، ال چاتمادی، عشقیم داماغ اولدی،",
      "CoupletIndex": 133,
      "SectionIndex1": 0
    },
    {
      "VOrder": 187,
      "Position": "Single",
      "Text": "هله‌لیک غم سارالارکن قارالار دؤندی آغ اولدی،",
      "CoupletIndex": 133,
      "SectionIndex1": 0
    },
    {
      "VOrder": 188,
      "Position": "Single",
      "Text": "آرازین سود گولی داشدی، قایالیقلاردا باغ اولدی،",
      "CoupletIndex": 134,
      "SectionIndex1": 0
    },
    {
      "VOrder": 189,
      "Position": "Single",
      "Text": "ساری سونبوللره زلف ایچره اوراخلار داراغ اولدی،",
      "CoupletIndex": 134,
      "SectionIndex1": 0
    },
    {
      "VOrder": 190,
      "Position": "Single",
      "Text": "یونجالیقلار ینه بلدرچینه یای یاز یاتاغ اولدی.",
      "CoupletIndex": 135,
      "SectionIndex1": 0
    },
    {
      "VOrder": 191,
      "Position": "Single",
      "Text": "گؤزده یاشلار چراغ اولدی،",
      "CoupletIndex": 135,
      "SectionIndex1": 0
    },
    {
      "VOrder": 192,
      "Position": "Single",
      "Text": "لاله بیتدی یاناغ اولدی،",
      "CoupletIndex": 136,
      "SectionIndex1": 0
    },
    {
      "VOrder": 193,
      "Position": "Single",
      "Text": "غنچه گولدی، دوداغ اولدی،",
      "CoupletIndex": 136,
      "SectionIndex1": 0
    },
    {
      "VOrder": 194,
      "Position": "Single",
      "Text": "نه صول اولدی، نه صاغ اولدی!",
      "CoupletIndex": 137,
      "SectionIndex1": 0
    },
    {
      "VOrder": 195,
      "Position": "Single",
      "Text": "ائلیمی آرخامی گؤردیکده ظالم اووچوقیسیلدی،",
      "CoupletIndex": 137,
      "SectionIndex1": 0
    },
    {
      "VOrder": 196,
      "Position": "Single",
      "Text": "سئل کیمی ظلمی باسیلدی، زینه آرخ اولدی، کسیلدی،",
      "CoupletIndex": 138,
      "SectionIndex1": 0
    },
    {
      "VOrder": 197,
      "Position": "Single",
      "Text": "گول گؤزوندن یاشی سیلدی.",
      "CoupletIndex": 138,
      "SectionIndex1": 0
    },
    {
      "VOrder": 198,
      "Position": "Single",
      "Text": "تور قوران اووچی آتین قوومادا سیندی گری قالدی،",
      "CoupletIndex": 139,
      "SectionIndex1": 0
    },
    {
      "VOrder": 199,
      "Position": "Single",
      "Text": "اوزی گتدی، توری قالدی.",
      "CoupletIndex": 139,
      "SectionIndex1": 0
    },
    {
      "VOrder": 200,
      "Position": "Single",
      "Text": "اما حیدربابا دا بیلدی کی بیز تک هامی داغلار،",
      "CoupletIndex": 140,
      "SectionIndex1": 0
    },
    {
      "VOrder": 201,
      "Position": "Single",
      "Text": "باغلانیب قول قولا زنجیرده، بولودلار اودیر آغلار،",
      "CoupletIndex": 140,
      "SectionIndex1": 0
    },
    {
      "VOrder": 202,
      "Position": "Single",
      "Text": "نه بیلیم، بلکه طبیعت اوزی نامرده گون آغلار،",
      "CoupletIndex": 141,
      "SectionIndex1": 0
    },
    {
      "VOrder": 203,
      "Position": "Single",
      "Text": "اگری یوللاری آچارکن، دوز اولان قوللاری باغلار،",
      "CoupletIndex": 141,
      "SectionIndex1": 0
    },
    {
      "VOrder": 204,
      "Position": "Single",
      "Text": "صاف اولان سینه‌نی داغلار!",
      "CoupletIndex": 142,
      "SectionIndex1": 0
    },
    {
      "VOrder": 205,
      "Position": "Single",
      "Text": "داغلارین هر نه قوچی، طرلانی، جیرانی، مارالی،",
      "CoupletIndex": 142,
      "SectionIndex1": 0
    },
    {
      "VOrder": 206,
      "Position": "Single",
      "Text": "هامی دوشگون، هامی پوزغون، سینه‌لر داغلی، یارالی،",
      "CoupletIndex": 143,
      "SectionIndex1": 0
    },
    {
      "VOrder": 207,
      "Position": "Single",
      "Text": "گول آچان یئرده سارالی!",
      "CoupletIndex": 143,
      "SectionIndex1": 0
    },
    {
      "VOrder": 208,
      "Position": "Single",
      "Text": "اما ظن اتمه کی داغلار ینه قالخان اولاجاقدیر،",
      "CoupletIndex": 144,
      "SectionIndex1": 0
    },
    {
      "VOrder": 209,
      "Position": "Single",
      "Text": "محشر اولماقدادی بونلار، داها ولکان اولاجاقدیر،",
      "CoupletIndex": 144,
      "SectionIndex1": 0
    },
    {
      "VOrder": 210,
      "Position": "Single",
      "Text": "ظلم دنیاسی یانارکنده تیلیت قان اولاجاقدیر!",
      "CoupletIndex": 145,
      "SectionIndex1": 0
    },
    {
      "VOrder": 211,
      "Position": "Single",
      "Text": "وای! نه طوفان اولاجاقدیر!",
      "CoupletIndex": 145,
      "SectionIndex1": 0
    },
    {
      "VOrder": 212,
      "Position": "Single",
      "Text": "ددین: آذر ائلینین، بیر یارالی نیسگیلی‌یم من،",
      "CoupletIndex": 146,
      "SectionIndex1": 0
    },
    {
      "VOrder": 213,
      "Position": "Single",
      "Text": "نیسگیل اولسام دا، گولوم! بیر ابدی سوگلی‌یم من،",
      "CoupletIndex": 146,
      "SectionIndex1": 0
    },
    {
      "VOrder": 214,
      "Position": "Single",
      "Text": "یاد منی آتسا دا، اوز گلشنیمین بولبولی‌یم من،",
      "CoupletIndex": 147,
      "SectionIndex1": 0
    },
    {
      "VOrder": 215,
      "Position": "Single",
      "Text": "ائلیمین فارسیجادا دردینی سؤیلر دیلی‌یم من،",
      "CoupletIndex": 147,
      "SectionIndex1": 0
    },
    {
      "VOrder": 216,
      "Position": "Single",
      "Text": "حقه دوغرو نه قارانلیق ایسه، ائل مشعلی‌یم من،",
      "CoupletIndex": 148,
      "SectionIndex1": 0
    },
    {
      "VOrder": 217,
      "Position": "Single",
      "Text": "ابدیت گولی‌یم من!",
      "CoupletIndex": 148,
      "SectionIndex1": 0
    },
    {
      "VOrder": 218,
      "Position": "Single",
      "Text": "نیسگیل اول چرچیه قالسین کی، جواهر نه‌دی قانمیر،",
      "CoupletIndex": 149,
      "SectionIndex1": 0
    },
    {
      "VOrder": 219,
      "Position": "Single",
      "Text": "مدنیت ده بین ایلیر بدویت، بیر اوصانمیر،",
      "CoupletIndex": 149,
      "SectionIndex1": 0
    },
    {
      "VOrder": 220,
      "Position": "Single",
      "Text": "گون گدیر، آز قالا باتسین، گئجه‌سیندن بیر اویانمیر،",
      "CoupletIndex": 150,
      "SectionIndex1": 0
    },
    {
      "VOrder": 221,
      "Position": "Single",
      "Text": "بیر اوز احوالینا یانمیر!",
      "CoupletIndex": 150,
      "SectionIndex1": 0
    },
    {
      "VOrder": 222,
      "Position": "Single",
      "Text": "آتار انسانلیغی، اما یالان انسانی آتانماز،",
      "CoupletIndex": 151,
      "SectionIndex1": 0
    },
    {
      "VOrder": 223,
      "Position": "Single",
      "Text": "فتنه قووزانماسا بیر گون گئجه آسوده یاتانماز،",
      "CoupletIndex": 151,
      "SectionIndex1": 0
    },
    {
      "VOrder": 224,
      "Position": "Single",
      "Text": "باشی باشلاره قاتانماز!",
      "CoupletIndex": 152,
      "SectionIndex1": 0
    },
    {
      "VOrder": 225,
      "Position": "Single",
      "Text": "اما مندن ساری، سن آرخایین اول، شانلی سهندیم،",
      "CoupletIndex": 152,
      "SectionIndex1": 0
    },
    {
      "VOrder": 226,
      "Position": "Single",
      "Text": "دلی جیرانلی سهندیم.",
      "CoupletIndex": 153,
      "SectionIndex1": 0
    },
    {
      "VOrder": 227,
      "Position": "Single",
      "Text": "من داها عرش علا کؤلگه‌سی تک باشدا تاجیم وار،",
      "CoupletIndex": 153,
      "SectionIndex1": 0
    },
    {
      "VOrder": 228,
      "Position": "Single",
      "Text": "الده موسی کیمی فرعونه غنیم، بیر آغاجیم وار،",
      "CoupletIndex": 154,
      "SectionIndex1": 0
    },
    {
      "VOrder": 229,
      "Position": "Single",
      "Text": "حرجیم یوخ، فرجیم وار.",
      "CoupletIndex": 154,
      "SectionIndex1": 0
    },
    {
      "VOrder": 230,
      "Position": "Single",
      "Text": "من علی اوغلویام، آزاده‌لرین مردی، مرادی،",
      "CoupletIndex": 155,
      "SectionIndex1": 0
    },
    {
      "VOrder": 231,
      "Position": "Single",
      "Text": "او، قارانلیقدا مشعل،",
      "CoupletIndex": 155,
      "SectionIndex1": 0
    },
    {
      "VOrder": 232,
      "Position": "Single",
      "Text": "او، ایشیقلیقلاردا هادی،",
      "CoupletIndex": 156,
      "SectionIndex1": 0
    },
    {
      "VOrder": 233,
      "Position": "Single",
      "Text": "حقه، ایمانه منادی!",
      "CoupletIndex": 156,
      "SectionIndex1": 0
    },
    {
      "VOrder": 234,
      "Position": "Single",
      "Text": "باشدا سینماز سپریم، الده کوتلمز قلجیم وار!",
      "CoupletIndex": 157,
      "SectionIndex1": 0
    }
  ]
}
