      "Position": "Right",
      "Text": "تا پای حیات من نلغزد",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "من دست هوس ندارم از وی",
