  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "بود به چنگ درنگ جیب مهم جهان",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "تا به میان زد قضا دامن آخر زمان",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
