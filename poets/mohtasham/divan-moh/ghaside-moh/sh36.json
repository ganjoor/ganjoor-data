  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "گشت در مهد گران جنبش دهر آخر کار",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "خوش خوش از خواب گراندیدهٔ بختم بیدار",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ادهم واشهب پدرام شب و روز شدند",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "زیر ران امل از رایض صبرم رهوار",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "داروی صبر که بس دیر اثر بود آخر",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "اثری داد که نگذشت ز دردم آثار",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "کشتی را که به یک جذبهٔ گرداب تعب",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "دور می‌برد به ته بخت کشیدش به کنار",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "دیر شد خسرو بهجت سپه‌انگیز ولی",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "زود از خیل غم و درد برآورد دمار",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "آخر آن کلبه که زیبش ز حجر بود اکنون",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "بدر و گوهرش آراسته شد سقف و جدار",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
