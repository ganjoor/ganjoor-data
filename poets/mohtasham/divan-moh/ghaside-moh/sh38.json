  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "به ساحل خواهد افتادن دگر بار",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "دری از جنبش دریای اسرار",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "بنان در کشف رازی خواهد آورد",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "زبان کلک را دیگر به گفتار",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "حدیث لطف و بی‌لطفی مولی",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "لب تقریر خواهد کرد اظهار",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "چه مولی آن که در بازار معنی است",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "سخن را بهترین میزان و معیار",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "بلیغی کاندر اوصاف کمالش",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "به عجز خود بلاغت راست اقرار",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "مهین دستور اعظم رای اکبر",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "کز اخلاصند شاهانش پرستار",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "سمی نیر اوج رسالت",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "محمد مهرانور نور انوار",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "که بر روی زمینش خالق‌الارض",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "ز آفات زمان بادا نگهدار",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "به بازارش سه در برد از من ایام",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "یکی فرد و دو از نسبت بهم یار",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "چه درها گنج‌های خسروانه",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "ز حمل هر یکی گیتی گران بار",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "ولی از همت آن فرزانه گنجور",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "چو از من آن در را شد خریدار",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "دو در را ثلث یک در داد قیمت",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "وزین خاطر نشینم شد که این بار",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "در این بازار از بخت بد من",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "از آن سودا به غایت بود بیزار",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "خدا را ای صبا در گوش آصف",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "بگو آهسته کای دانای اسرار",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "شناسای دم و نطق گهر ریز",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "خداوند دل و دست درم بار",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "شنیدم از بسی مردم که داری",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "به مروارید و گوهر میل بسیار",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "و گر گاهی به دست در فروشی",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "به کف می‌آیدت یک در شهوار",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "چو باد گل‌فشان می‌ریزی از دست",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "زر سرخش بپا خروار خروار",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "بفرما کز گهرها چیست حالی",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "تو را در مخزن ای دریای ذخار",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "که می‌نازد به آنها گوش شاهان",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "جز آنها کت من آوردم به بازار",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "به تخصیص آن چنان کز بهر شهرت",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "بر آن نام خوشت کندم نگین‌وار",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "خموش ای محتشم کز بالغان است",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "به غایت خود ستائی ناسزاوار",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "درین سان سرزمینی تخم دعوی",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "نمی‌آرد به جز شرمندگی بار",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "در نظم تو را با این زبونی",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "بهائی داد آن رای جهاندار",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "که در چشم دل از صد گنج بیش است",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "به قیمت نه به عظم و قدر و مقدار",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "سراسر تحفه‌های برگزیده",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "علم از بی‌نظیری‌ها در انظار",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "اگر دیگر دری داری بیاور",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "کزین به نیست در عالم خریدار",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "شروع اندر ثنایش کن که چون او",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "کریمی نیست در بازار اشعار",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "زهی برگرد قصرت پاسبان‌وار",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "بسر تا روز گردان چرخ دوار",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "زهی اعظم وزیری کز شکوهت",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "وزارت راست از شاهنشهی عار",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "زهی گردون سریری کز سرورت",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "ابد سیر است چنگ زهره بر تار",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "تو آن مسند نشینی کایستاده",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "ز تعظیمت به خدمت چرخ سیار",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "تو آن آصف نشانی کاوفتاده",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "ز توصیف سلیمانی در اقطار",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "اگر بالفرض باشد رای امرت",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "برون آید چو تیغ از جلد خودمار",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "و گر در جنبش آید باد نهیت",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "بره سیل نگون ماند ز رفتار",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "کنی گر منع وحشت از طبایع",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "به شهر آیند یک سر وحش کوهسار",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "چراغ دین چو گردد از تو ذوالنور",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "بسوزد کافر صد ساله زنار",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "اگر جازم شود دهقان سعیت",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "دماند در جبل ز احجار اشجار",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "نیابد در پناه حفظت آسیب",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "حریر برگ گل از سوزن خار",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "و گر ماه از تو پوشد کسوت نور",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "شود از روز روشن‌تر شب تار",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "اگر یکبار خواهی رفع ظلمت",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "برآرد خور سر از ظلمات ناچار",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "گر از حکمت زنی دم در زمانت",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "چه عنقا و چه اکسیر و چه بیمار",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "اگر حیز طلب گردد جلالت",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 86,
      "Position": "Left",
      "Text": "برون تازد فرس زین چار دیوار",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "دو عالم بر در و گوهر شود تنگ",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "شوی غواص چون در بحر افکار",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "ز گل گر پیکری سازی و در وی",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "دمی یک نفخه گردد مرغ طیار",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 91,
      "Position": "Right",
      "Text": "جهان را سر به سر این قابلیت",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 92,
      "Position": "Left",
      "Text": "نبود ای قیصر اسکندر آثار",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 93,
      "Position": "Right",
      "Text": "که گرد خوب و زشتش باشد از حفظ",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 94,
      "Position": "Left",
      "Text": "حفیظی چون تو گردانندهٔ پرگار",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 95,
      "Position": "Right",
      "Text": "اگر کس از سر ملکت گزینی",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 96,
      "Position": "Left",
      "Text": "جرون را حالیا تالار سالار",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 97,
      "Position": "Right",
      "Text": "و گرنه گر بدی در بسته از تو",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 98,
      "Position": "Left",
      "Text": "همهٔ انصار بی‌اعوان و انصار",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 99,
      "Position": "Right",
      "Text": "چنان حفظش نمودی کز دل مور",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 100,
      "Position": "Left",
      "Text": "ضمیر انورت بودی خبردار",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 101,
      "Position": "Right",
      "Text": "سرای جغد هم گشت از تو معمور",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 102,
      "Position": "Left",
      "Text": "چو گردیدی درین ویرانه معمار",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 103,
      "Position": "Right",
      "Text": "گر از مرغان این گلشن مرا نیز",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 104,
      "Position": "Left",
      "Text": "که جز شکر نمی‌ریزم ز منقار",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 105,
      "Position": "Right",
      "Text": "دهی زین بیش ره در گلشن خویش",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 106,
      "Position": "Left",
      "Text": "شود شکرستان این طرفه گلزار",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 107,
      "Position": "Right",
      "Text": "وز اوصافت چنان عالم شود پر",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 108,
      "Position": "Left",
      "Text": "که بر امسال صد حسرت برد پار",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 109,
      "Position": "Right",
      "Text": "غرض کز بهر ترتیب ثنایت",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 110,
      "Position": "Left",
      "Text": "من از بحر ضمیر معجز آثار",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 111,
      "Position": "Right",
      "Text": "کشم در رشتهٔ فکرت لالی",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 112,
      "Position": "Left",
      "Text": "ز آغاز لیالی تا به اسحار",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 113,
      "Position": "Right",
      "Text": "خموش ای دل که از بسیارگوئی",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 114,
      "Position": "Left",
      "Text": "دل نازک دلان می‌یابد آزار",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 115,
      "Position": "Right",
      "Text": "عنان تاب از ره افکار شو هان",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 116,
      "Position": "Left",
      "Text": "که شد ز اطناب پای خامهٔ افکار",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 117,
      "Position": "Right",
      "Text": "به تنگ آمد ثنا از دست نطقت",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 118,
      "Position": "Left",
      "Text": "دعا نوبت طلب شد دست بردار",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 119,
      "Position": "Right",
      "Text": "درین سطح از پی رسم دوایر",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 120,
      "Position": "Left",
      "Text": "بود تا گردش پرگار در کار",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 121,
      "Position": "Right",
      "Text": "ز امرت هر که در دوران کشد سر",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 122,
      "Position": "Left",
      "Text": "چو پرگارش فلک سازد نگون‌سار",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 123,
      "Position": "Right",
      "Text": "بود تا ملک جسم از خسرو روح",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 124,
      "Position": "Left",
      "Text": "بود تاسر بر آن اقلیم سردار",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 125,
      "Position": "Right",
      "Text": "تو سردار جهان باشی و دایم",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 126,
      "Position": "Left",
      "Text": "بود جای سر خصمت سر دار",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 127,
      "Position": "Right",
      "Text": "به کینت هر که بر بالین نهد سر",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    },
    {
      "VOrder": 128,
      "Position": "Left",
      "Text": "نگردد تابه صبح حشر بیدار",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    }
  ]
}
