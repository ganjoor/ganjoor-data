      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "کانکه راهت نمود، گمراهی است",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "قصهٔ تلخیش دراز مکن",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
