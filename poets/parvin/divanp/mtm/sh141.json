    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "بهر دانه‌ای، قصه‌ای از فریبی",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "بهر ذره نوری، حدیثی ز شامی",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "بپهلوش، صیاد ناخوبرویی",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "بکشتن حریصی، بخون تشنه کامی",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "نه عاریش از دامن آلوده کردن",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "نه‌اش بیم ننگی، نه پروای نامی",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
