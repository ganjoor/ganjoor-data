      "VOrder": 25,
      "Position": "Right",
      "Text": "چنانش کوفت سخت و سخت بر بست",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "که پشت و گردن و پهلوش بشکست",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "بوقت کار، باید کرد تدبیر",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "چه تدبیری، چو وقت کار شد دیر",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "بگفت، ای تیره روز آزمندی",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "تو گرگ بس شبان و گوسفندی",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "بدینسان داد پاسخ، گرگ نالان",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "نه چوپانی تو، نام تست چوپان",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "نشاید وقت بیداری غنودن",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "شبان بودن، ز گرگ آگه نبودن",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "شبانی باید، ای مسکین، شبان را",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "توان شب نخفتن، پاسبان را",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "نه هر کو گله‌ای راند، شبان است",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "نه هر کو چشم دارد، پاسبان است",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "تو، عیب کار خویش از خود نهفتی",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "بهنگام چرای گله، خفتی",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "شدی پست، این نه آئین بزرگی است",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "ندانستی که کار گرگ، گرگی است",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "تو خفتی، کار از آن گردید دشوار",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "نشاید کرد با یکدست، ده کار",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "چرا امروز پشت من شکستی",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "کجا بود آن زمان این چوبدستی",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "شبانان نیستند از گرگ، ایمن",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "تو وارون بخت، ایمن بودی از من",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "نخسبد هیچ صاحب خانه آرام",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "چو در نامحکم و کوته بود بام",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "شبانان، آنقدر پرسند و پویند",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "که تا گمگشته‌ای را، باز جویند",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "من از تدبیر و رای خانمانسوز",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "در آغلها بسی شب کرده‌ام روز",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "چه غم گر شد مرا هنگام مردن",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "پس از صد گوسفند و بره خوردن",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "مرا چنگال، روزی خون بسی ریخت",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "به گردنها و شریانها در آویخت",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "بعمری شد ز خون آشامیم رنگ",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "بطرف مرغزاران، سبزه و سنگ",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "بسی گوساله را پهلو فشردم",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "بسی بزغاله را از گله بردم",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "اگر صد سال در زنجیر مانم",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "نخستین روز آزادی، همانم",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "شبان فارغ از گرگ بداندیش",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "بود فرجام، گرگ گلهٔ خویش",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "کنون دیگر نه وقت انتقام است",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "که کار گله و چوپان، تمام است",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    }
  ]
}
