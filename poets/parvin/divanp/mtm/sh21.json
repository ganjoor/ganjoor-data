      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "شو روز بفکر آب و دانه",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "هنگام شب، آرمیدن آموز",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 11,
      "Position": "CenteredVerse1",
      "Text": "از لانه برون مخسب زنهار",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 12,
      "Position": "Right",
      "Text": "این لانهٔ ایمنی که داری",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 13,
      "Position": "Left",
      "Text": "دانی که چسان شدست آباد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "کردند هزار استواری",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "تا گشت چنین بلند بنیاد",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "دادند به اوستادکاری",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "دوریش ز دستبرد صیاد",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "تا عمر تو با خوشی گذاری",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "وز عهد گذشتگان کنی یاد",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "یک روز، تو هم پدید آری",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "آسایش کودکان نوزاد",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 22,
      "Position": "CenteredVerse1",
      "Text": "گه دایه شوی، گهی پرستار",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "این خانهٔ پاک، پیش از این بود",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "آرامگه دو مرغ خرسند",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "کرده به گل آشیانه اندود",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "یکدل شده از دو عهد و پیوند",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "یکرنگ چه در زیان چه در سود",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "هم رنجبر و هم آرزومند",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "از گردش روزگار خشنود",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "آورده پدید بیضه‌ای چند",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "آن یک، پدر هزار مقصود",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "وین مادر بس نهفته فرزند",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 33,
      "Position": "CenteredVerse1",
      "Text": "بس رنج کشید و خورد تیمار",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "گاهی نگران ببام و روزن",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "بنشست برای پاسبانی",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "روزی بپرید سوی گلشن",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "در فکرت قوت زندگانی",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "خاشاک بسی ز کوی و برزن",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "آورد برای سایبانی",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "یک چند به لانه کرد مسکن",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "آموخت حدیث مهربانی",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "آنقدر پرش بریخت از تن",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "آنقدر نمود جانفشانی",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 44,
      "Position": "CenteredVerse1",
      "Text": "تا راز نهفته شد پدیدار",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "آن بیضه بهم شکست و مادر",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "در دامن مهر پروراندت",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "چون دید ترا ضعیف و بی پر",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "زیر پر خویشتن نشاندت",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "بس رفت به کوه و دشت و کهسر",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "تا دانه و میوه‌ای رساندت",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "چون گشت هوای دهر خوشتر",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "بر بامک آشیانه خواندت",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "بسیار پرید تا که آخر",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "از شاخه به شاخه‌ای پراندت",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 55,
      "Position": "CenteredVerse1",
      "Text": "آموخت بسیت رسم و رفتار",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "داد آگهیت چنانکه دانی",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "از زحمت حبس و فتنهٔ دام",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "آموخت همی که تا توانی",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "بیگاه مپر به برزن و بام",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 60,
      "Position": "Right",
      "Text": "هنگام بهار زندگانی",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "سرمست براغ و باغ مخرام",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 62,
      "Position": "Right",
      "Text": "کوشید بسی که در نمانی",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "روز عمل و زمان آرام",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 64,
      "Position": "Right",
      "Text": "برد اینهمه رنج رایگانی",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 65,
      "Position": "Left",
      "Text": "چون تجربه یافتی سرانجام",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 66,
      "Position": "CenteredVerse1",
      "Text": "رفت و به تو واگذاشت این کار",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    }
  ]
}
