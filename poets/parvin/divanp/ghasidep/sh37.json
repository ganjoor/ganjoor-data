      "Text": "آید گه درگذشتنت ناچار",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "خود بگذری، آنچه هست بگذاری",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
