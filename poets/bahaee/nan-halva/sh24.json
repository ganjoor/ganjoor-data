    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "بنت کرم تجعلن الشیخ شاب",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: اگر دختر کرم بر این سرزمین ببارد، هر که طعم آن را بچشد، جوانی و تازگی را به دست خواهد آورد و از دو دنیا دور خواهد شد."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "من یذق منها عن الکونین غاب",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "خمرة من نار موسی نورها",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: شراب من آتش موسی است، نورها به دل و سینه‌ام می‌تابند، مانند کوه طور."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "دنها قلبی و صدری طورها",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "قم فلاتمهل، فما فی‌العمر مهل",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: برو و درنگ نکن، زیرا زمان در عمر فرصتی نیست. نوشیدنی‌اش سخت نیست و کار آسان است."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "لا تصعب شربها و الامر سهل",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "قم فلاتمهل فان الصبح لاح",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: برو و تردید نکن، زیرا صبح در حال سر زدن است و ستارهٔ ثریا در حال غروب. پدرت صدا زده است."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "والثریا غربت والدیک صاح",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "قل لشیخ قلبه منها نفور",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: به کسی که دلش از عشق دور است بگو: نترس، زیرا خداوند بخشنده و مهربان است و توبه‌پذیر است."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "لا تخف، فالله تواب غفور",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "یا مغنی ان عندی کل غم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: ای خوش‌صدا، به من بگویید همه غم‌ها را کنار بگذارم و با نغمه‌ها آتش را در آن خاموش کنم."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "قم والق النار فیها بالنغم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "یا مغنی قم فان العمر ضاع",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: ای خواننده، بیدار باش! که زندگی هدر رفته و خوشی واقعی تنها با شنیدن موسیقی است."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "لا یطیب العیش الا بالسماع",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "انت ایضا یا مغنی لا تنم",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: ای گنجینه شادی، بیدار باش و از دل من همه غم‌ها را دور کن."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "قم واذهب عن فؤادی کل غم",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "غن لی دورا، فقد دار القدح",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: به من بخواه دوری کن، چون هم اینک دور می‌چرخد و باده در جام است، و بوی نسیم تازگی به مشام می‌رسد و قمری آواز دل‌نوازی سر می‌دهد."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "والصبا قد فاح والقمری صدح",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "واذکرن عندی احادیث الحبیب",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: به یادم بیاورید داستان‌های محبوب او را؛ زیرا زندگی‌ام بدون آن‌ها خوشایند نیست."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "ان عیشی من سواها لا یطیب",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "واذکرن ذکری احادیث الفراق",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: و به یاد بیاورید سخنان جدایی را، زیرا یادآوری فاصله و دوری از یکدیگر، طاقت‌فرسا و دشوار است."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "ان ذکر البعد مما لا یطاق",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "روحن روحی باشعار العرب",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: شعری از شاعر عربی بیانگر این است که روح زندگی در شعر و موسیقی نهفته است و در این زمان، خوشبختی و شادی در کنار ما قرار دارد."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "کی یتم الحظ فینا والطرب",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "وافتحن منها بنظم مستطاب",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "CoupletSummary": "هوش مصنوعی: از آن نشانه‌ها را که در جوانی نوشته‌ام، با خوشحالی و شوق باز می‌کنم."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "قلته فی بعض ایام الشباب",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "قد صرفنا العمر فی قیل و قال",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17,
      "CoupletSummary": "هوش مصنوعی: ما عمر خود را در صحبت‌های بی‌پایه و حاشیه‌پردازی گذراندیم، دوست من! بلند شو که زمان برای ما تنگ شده است."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "یا ندیمی! قم فقد ضاق المجال",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "ثم اطربنی باشعار العجم",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18,
      "CoupletSummary": "هوش مصنوعی: سپس شعرهای عجم مرا شاد کند و هموزنی بر قلبم حمله کند."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "و اطردن همتا علی قلبی هجم",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "وابتداء منها ببیت المثنوی",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19,
      "CoupletSummary": "با بیتی از مثنوی معنوی حکیم مولوی آعاز می‌کنم."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "للحکیم المولوی المعنوی",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "« بشنو از نی، چون حکایت می‌کند",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20,
      "CoupletSummary": "هوش مصنوعی: از نی بشنو، او داستان‌هایی را بازگو می‌کند و از غم فراق و جدایی‌ها ناله می‌زند."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "وز جدایی‌ها، شکایت می‌کند»",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "قم و خاطبنی بکل الالسنه",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21,
      "CoupletSummary": "هوش مصنوعی: در این بیت، سخن از این است که ای قم، با هر زبانی با من صحبت کن، که دل من از گفته‌های صاحب زبان بیدار می‌شود. یعنی جایی که به یاد و یادآوری نیاز دارد، می‌توان به آن زبان‌های مختلف در ارتباط بود تا تأثیرگذاری بیشتری بر روی دل بیفتد."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "عل قلبی ینتبة من ذی السنه",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "انه فی غفلة عن حاله",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22,
      "CoupletSummary": "هوش مصنوعی: او در غفلت از حال خود است و درگیر سخنان دیگران می‌باشد."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "خائض فی قیله مع قاله",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "کل ان فهو فی قید جدید",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23,
      "CoupletSummary": "هوش مصنوعی: همه چیز در زندان جدیدی قرار دارد، و بگویید آیا چیزی دیگر هم هست که ندانید؟"
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "قائلا من جهله: هل من مزید",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "تائه فی الغی قد ضل الطریق",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24,
      "CoupletSummary": "هوش مصنوعی: کسی که در گیجی و سرگشتگی است و راه را گم کرده است، به دلیل شیفتگی و دلدادگی، قادر به بازگشت و به هوش آمدن نیست."
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "قط من سکرالهوی لا یستفیق",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "عاکف دهرا، علی اصنامه",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25,
      "CoupletSummary": "هوش مصنوعی: مدت‌هاست که در برابر عقاید و بت‌ها مانده و مردم از بی‌ادبی و کفرشان به خاطر ایمان به اسلام دوری می‌کنند."
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "تنفر الکفار من اسلامه",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "کم انادی و هو لایسقی یصغی؟ التناد",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26,
      "CoupletSummary": "هوش مصنوعی: در این بیت شاعر به موضوعی اشاره دارد که نشان می‌دهد انسان‌ها در مواجهه با چالش‌ها و ناملایمات زندگی، چگونه باید خود را با شرایط وفق دهند. او به این نکته اشاره می‌کند که برخی افراد در تلاش‌اند تا از دیگران یاری بگیرند، اما در واقع باید خودشان برای مشکلاتشان چاره‌اندیشی کنند. این هشدار به ما یادآوری می‌کند که همواره باید در تلاش باشیم و خود را به راه‌حل‌ها نزدیک کنیم، و کمک دیگران اگرچه مهم است، اما نباید کاملاً به آن وابسته باشیم."
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "وافادی، وافادی، وافاد",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "یا بهائی اتخذ قلبا سواه",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27,
      "CoupletSummary": "هوش مصنوعی: هر که دلش را به غیر از عشق تو بسپارد، معبودی جز هوای نفس خود نخواهد داشت."
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "فهو ما معبوده الا هواه",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "هر چه از حق باز دارد ای پسر",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28,
      "CoupletSummary": "هوش مصنوعی: هر چیزی که از حقیقت دور است، ای پسر، تنها صحبت کردن درباره‌اش بی‌فایده است، مانند نان و حلوایی که هیچ وقت به دست نمی‌آید."
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "نام کردن، نان و حلوا، سر به سر",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "گر همی خواهی که باشی تازه‌جان",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29,
      "CoupletSummary": "هوش مصنوعی: اگر می‌خواهی همیشه سرزنده و بانشاط باشی، به مطالعه‌ی کتاب‌هایی درباره‌ی نان و حلوا بپرداز."
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "رو کتاب نان و حلوا را بخوان",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    }
  ]
}
