      "VOrder": 24,
      "Position": "Left",
      "Text": "ورنه گر چرخی تو، سرگردان شوی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "زهر دارد در درون، دنیا چو مار",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "گرچه دارد در برون، نقش و نگار",
