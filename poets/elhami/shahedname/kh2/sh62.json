      "Position": "Left",
      "Text": "بیامد بگفت ای شه دین پناه",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "مراهم بده رخصت کار زار",
