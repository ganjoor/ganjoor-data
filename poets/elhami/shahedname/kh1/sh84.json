      "MetreId": 23,
      "MetreRefSectionIndex": 0
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "بیامد یکی کاروان گشن",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: در آن سرزمین (منزل تنعیم) کاروانی بزرگ و انبوه از سرزمین یمن فرارسید."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "درآن سرزمین از دیار یمن",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "یکی کاروان بود آراسته",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: کاروانی آراسته بود که همهٔ بارهایش هدیه و مال و دارایی بود."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "همه بارشان هدیه و خواسته",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "فرستاده بد هدیه هارا تمام",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: فرمانروای یمن همهٔ این هدیه‌ها را برای فرمانروای شام (یزید) فرستاده بود."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "امیر یمن بهر دارای شام",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "یکی آمد و نزد دارای راز",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: کسی نزد امام حسین، که دانای رازها بود، آمد و همهٔ ماجرای آن کاروان را برایش بازگفت."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "همه راز آن کاروان گفت باز",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "بفرمود فرزند خیر الانام",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: فرزند بهترین مردمان (پیامبر) فرمود: اکنون من در هر دو جهان امام و پیشوای به حق هستم."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "که من در دو گیتی کنونم امام",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "مرا می رسد اینهمه خواسته",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: این همه مال حقِ من است، زیرا خداوند آن را برای من خواسته و مقرر کرده است."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "که یزدانش ازبهر من خواسته",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "به فرمان فرمانگذار جهان",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: به فرمان امام، که فرمانروای جهان خوانده شده، همهٔ آن اموال را از کاروان گرفتند."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "گرفتند آن جمله از کاروان",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "شهنشه سر کاروان را بخواند",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: امام سرپرست کاروان را فراخواند و این سخن را با او در میان نهاد."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "پس آنگه بدو اینچنین راز راند",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "که باشد مراساز و برگ سفر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: گفت: من بار و ساز سفر دارم و شما شترانی دارید که بار می‌کشند."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "شما را هیونان بود باربر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "بیاور ز آلات من باربند",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: بارهای مرا بر شتران ببند و غمگین و آزرده‌خاطر مباش."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "دژم دل مگردان و خاطر نژند",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "همی هر چه خود خواهی ازآن فزون",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: هر اندازه کرایهٔ شتر بخواهی، حتی بیش از آن، از من بگیر."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "زمن باز بستان کرایه ی هیون",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "سرآهنگ نیز آنچه ازشه شنفت",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: سرپرست کاروان آنچه از امام شنیده بود را نزد کاروانیان آورد و برایشان بازگفت."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "برکاروان آمد و باز گفت",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "گروهی بماندند نزد امام",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: گروهی از کاروانیان نزد امام ماندند و همراهش شدند و گروهی دیگر راه شام را در پیش گرفتند."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "گروهی سپردند ره سوی شام",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "چو عبدالله جعفر نامور",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: هنگامی که عبدالله بن جعفر نامدار آگاه شد که امام بار سفر بسته است...؛ این بیت آغاز ماجرای بعدی است و جمله در بیت پسین کامل می‌شود."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "شد آگه که شد بسته بارسفر",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    }
  ]
}
