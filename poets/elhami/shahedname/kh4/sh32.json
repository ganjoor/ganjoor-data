      "Text": "بدش نام عبداله بن اسد",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "که نفرین رسادش به روح و جسد",
