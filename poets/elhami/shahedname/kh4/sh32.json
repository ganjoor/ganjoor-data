  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "که بربسته بودش به بندی گران",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "که پردخته بودند آهنگران",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
