    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "موجود ز جودت آفرینش",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "برتر ز خیال خلق ذاتت",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: فکر و تصور انسان‌ها از وجود تو بالاتر است و عقل‌ها در درک ویژگی‌های تو بهت زده و گیج هستند."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "سرگشته عقول در صفاتت",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "حسن از تو گرفته خلعت ناز",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: زیبایی از تو بهره‌مند شده و عشق، از تو خواسته است که محبتش را آغاز کنی."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "عشق از تو نیاز کرده آغاز",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "بی مثل و شریک و بی نظیری",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: که هیچ نظیر و شریکی ندارد، همواره نگهدارنده و تسلط‌دهنده و توانمند است."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "قیّوم و مهیمن و قدیری",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "کاخ فلک از تو برکشیده",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: پناهگاه آسمان به خاطر تو ساخته شده و زمین به خاطر تو آرامش یافته است."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "سطح زمی از تو آرمیده",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "خورشید به بر قبای زربفت",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: خورشید در آغوش خود، لباس زربفتی بر تن کرده و از تو هفت نصیب کرده است."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "پوشیده و از تو کرده هر هفت",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "پاکان همه عاشق جمالت",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: نگاهی به زیبایی تو، دل‌های پاک را مسحور کرده و آن‌ها را در شوری عمیق غرق کرده است."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "سرمست ز باده ی خیالت",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "شاد از تو به بخت عشق سرمد",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: شادمان از تو، ای عشق جاودانه، که آغازگر دفتر عاشقانه محمد هستی."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "سر دفتر عاشقان محمد",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    }
  ]
}
