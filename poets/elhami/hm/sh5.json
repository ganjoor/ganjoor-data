  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ای شورش عشق از تو شوری",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: ای خدایی که شور و هیجانِ عشق از توست و خورشید و ماه و ستارگان روشنایی خود را از تو دارند."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "مهر و مه و انجم از تو نوری",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "منظور تویی ز عشق ما را",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: مقصود ما از عشق تنها تو هستی، نه چهرهٔ زیبای آن معشوقِ دل‌ربا."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "نی منظر حسن آن دلارا",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "زین نامه که هست دفتر حسن",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: این منظومه که دفتری دربارهٔ زیبایی است، نامش «حسن منظر» است."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "نامی است به نام منظر حسن",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "مقصود تویی تو دیگری نیست",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: مقصودِ حقیقی تنها تویی و جز تو کسی نیست؛ زیبایی‌ای که شایستهٔ نام «حسن منظر» باشد جز زیبایی تو وجود ندارد."
    },
    {
      "VOrder": 8,
