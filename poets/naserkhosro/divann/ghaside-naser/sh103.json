  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ای زده تکیه بر بلند سریر",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "بر سرت خز و زیر پای حریر",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
