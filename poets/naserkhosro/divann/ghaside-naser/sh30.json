003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eهمه زیر این گنبد چنبری است\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn29\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eجهان را چو نادان نکوهش مکن\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eکه بر تو مر او را حق مادری است\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn30\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eبه فعل اندرو بنگر و شکر کن\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eمر آن را که صنعش بدین مکبری است\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn31\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eچه چیز است از این چرخ گردان برون؟\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eدرین عاقلان را بسی داوری است\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn32\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eجهانی فراخ است و خوش کاین جهان\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eدرو کمتر از حلقهٔ انگشتری است\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn33\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eمر آن راست فردا نعیم اندرو\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eکه امروز بر طاعتش صابری است\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn34\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eنباشد کسی تشنه و گرسنه\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eدرو، کاین سخن در خور ظاهری است\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn35\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eچو تشنه نباشد کس آنجا پس آن\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eچه جای شراب هنی و مری است؟\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn36\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eحذر کن ز عام و ز گفتار خام\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eگرت میل زی مذهب حیدری است\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn37\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eتو را جان در این گنبد آبگون\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eیکی کار کن رفتنی لشکری است\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn38\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eبیلفنج ملک سکندر کنون\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eکه جانت در این سد اسکندری است\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn39\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eسخن‌های حجت به حجت شنو\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eکه قولش نه بیهوده و سرسری است\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E",
      "PoemFormat": "Ghaside",
      "CoupletsCount": 39
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "خرد چون به جان و تنم بنگریست",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "از این هر دو بیچاره بر جان گریست",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "مرا گفت کاینجا غریب است جانت",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "بدو کن عنایت که تنت ایدری است",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "عنایت نمودن به کار غریب",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "سر فضل و اصل نکو محضری است",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "گر آرایش بت ز بتگر بود",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "تنت را میارای کاین بتگری است",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "نکوتر نگر تا کجا می‌روی",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "که گمره شد آنک او نکو ننگریست",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "اگر دیو را با پری دیده‌ای،",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "و گر نی، تنت دیو و جانت پری است",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "پریت ای برادر برهنه چراست",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "اگر دیوت اندر خز و ششتری است؟",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "چو تنت از عرض جامه دارد بدان",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "که مر جانت را جامهٔ جوهری است",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "به صابون دین شوی مر جانت را",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "بیاموز کاین بس نکو گازری است",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "ز دانش یکی جامه کن جانت را",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "که بی‌دانشی مایهٔ کافری است",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "سر علمها علم دین است کان",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "مثل میوهٔ باغ پیغمبری است",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "به دین از خری دور باش و بدان",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "که بی‌دینی، ای پور، بی شک خری است",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "مگر جهل درداست و دانش دواست",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "که دانا چنین از جهالت بری است",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "به داروی علمی درون علم دین",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "ز بس منفعت شکر عسکری است",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "سخن به ز شکر کزو مرد را",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "ز درد فرومایگی بهتری است",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "سخن در ره دین خردمند را",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "سوی سعد رهبرتر از مشتری است",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "گلی جز سخن دید هرگز کسی",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "که بی‌آب و بی نم همیشه طری است؟",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "بیاموز گفتار و کردار خوب",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "که‌ت این هر دو بنیاد نیک‌اختری است",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "مراد خدای از جهان مردم است",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "دگر هرچه بینی همه بر سری است",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "نبینی که بر آسمان و زمین",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "مر او را خداوندی و مهتری است",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "خداوند تمییز و عقل شریف",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "خداوند تدبیر و قول آوری است",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "متاب، ای پسر، سر ز فرمان آنک",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "ازوت این بزرگی و این سروری است",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "به طاعت بکن شکر و احسان او",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "که این داد نزد خرد عمری است",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "بجز شکر نعمت نگیرد که شکر",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "عقاب است و نعمت چو کبگ دری است",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "مکن شکر جز فضل آن را که او",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "به فردوس شکر تو را مشتری است",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "جهان جای الفنج ملک بقاست",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "بقائی و ملکی که نااسپری است",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "گر از بهر ملک آفریدت خدای",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "چرا مر تو را میل زی چاکری است",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "طلب کن بقا را که کون و فساد",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "همه زیر این گنبد چنبری است",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "جهان را چو نادان نکوهش مکن",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "که بر تو مر او را حق مادری است",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "به فعل اندرو بنگر و شکر کن",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "مر آن را که صنعش بدین مکبری است",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "چه چیز است از این چرخ گردان برون؟",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "درین عاقلان را بسی داوری است",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "جهانی فراخ است و خوش کاین جهان",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "درو کمتر از حلقهٔ انگشتری است",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "مر آن راست فردا نعیم اندرو",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "که امروز بر طاعتش صابری است",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "نباشد کسی تشنه و گرسنه",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "درو، کاین سخن در خور ظاهری است",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "چو تشنه نباشد کس آنجا پس آن",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "چه جای شراب هنی و مری است؟",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "حذر کن ز عام و ز گفتار خام",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "گرت میل زی مذهب حیدری است",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "تو را جان در این گنبد آبگون",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "یکی کار کن رفتنی لشکری است",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "بیلفنج ملک سکندر کنون",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "که جانت در این سد اسکندری است",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "سخن‌های حجت به حجت شنو",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "که قولش نه بیهوده و سرسری است",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    }
  ]
}
