  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ای پسر ار عمر تو یک ساعت است",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "ایزد را بر تو درو طاعت است",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "نعمت تخم است وزو شکر بار",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "وین بر و این تخم نه هر ساعت است",
      "CoupletIndex": 1,
      "SectionIndex1": 0
