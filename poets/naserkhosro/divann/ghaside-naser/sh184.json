  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "دیر بماندم در این سرای کهن من",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "تا کهنم کرد صحبت دی و بهمن",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "خسته ازانم که شست سال فزون است",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "تا به شبانروزها همی بروم من",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
