      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "گر تو بیاسودی این زمانه ز گشتن",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
