      "Text": "از حق مپرسید مست است باطل",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "چون اشک رنگی بستیم آخر",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "خونها غرق شد از شرم قاتل",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
