      "Text": "دل در قدم آبله پایان‌که شکسته‌ست",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "این‌شیشه به‌هرکوه‌و بیابان‌که شکسته‌ست",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
