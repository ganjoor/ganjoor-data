      "Text": "غرورنی‌و خجلت بوریایی",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "به هستی من وما ضروریست بید‌ل",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
