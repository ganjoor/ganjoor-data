  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "و هُوَ قدوة العارفین و شیخ المتاخرین آقامحمد هاشم بن میرزا اسماعیل. آن جناب در عنفوان شباب نویسندگی سلطان عهد را می‌نمود. در اواسط حال از منصب استیفا استعفا فرمود. سر ارادت برپای جناب عارف فاضل و سید کامل سید قطب الدین شیرازی که از مشایخ سلسلهٔ علیّهٔ ذهبیّهٔ کبرویه، بود نهاد. در خدمت آن حضرت به درجات عالیه فایض شد. شرف مصاهرت و خلافت دریافت. گویند آن جناب را حالات و کرامات عظیمه بود وپیوسته اوقات به عبادات و مجاهدات قلبیه و قالبیه مبادرت می‌نمود. آستانش مرجع طالبان طریقت و صومعه‌اش مجمع عالمان شریعت. نفسش مرده و دلش زنده. جسمش افسرده و روانش پاینده. عمر معقولی دریافته و آخرالامر در سنهٔ]۱۱۹۹[به جنت شتافته. مرقد آن جناب در خارج شیراز در جنب خواجه شمس الدین محمدحافظ زیارتگاه اهل نیاز است. آن جناب را رسالات معرفت دلالات است مانند مناهل التحقیق و ولایت نامه و غیره. از اوست:",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Comment",
      "Text": "مِن غزلیاته قُدِّسَ سِرُّه"
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ای دوستان ای دوستان رفتم ز خود من بارها",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "تا آنکه دیدم یار را در کسوت اغیارها",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "وحدت چو آمد در نظر کثرت شد از پیش بصر",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "بت‌ها شکستم سر به سر وارستم از ادبارها",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "ز نیک و بد ز چه رنجیم چون که می‌دانیم",
      "CoupletIndex": 3,
      "SectionIndex1": 35,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "که هرچه بر سر ما می‌رود مشیت اوست",
      "CoupletIndex": 3,
      "SectionIndex1": 35,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "هرچند نبینند عیان مهر چو خفاش",
      "CoupletIndex": 4,
      "SectionIndex1": 34,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "خورشید نهان نیست ز صاحب نظری چند",
      "CoupletIndex": 4,
      "SectionIndex1": 34,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "غواص صفت غوطه درین لُجّهٔ توحید",
      "CoupletIndex": 5,
      "SectionIndex1": 34,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "خوردیم بسی تا که برآمد گهری چند",
      "CoupletIndex": 5,
      "SectionIndex1": 34,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "حجاب روی تو نبود بجز شؤون کمال",
      "CoupletIndex": 6,
      "SectionIndex1": 33,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "منم که روی ترا بی حجاب می‌بینم",
      "CoupletIndex": 6,
      "SectionIndex1": 33,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "ظاهر نشان آن یار از هر کسی و یاری",
      "CoupletIndex": 7,
      "SectionIndex1": 32,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "بینم جمال رویش در وجه هر نگاری",
      "CoupletIndex": 7,
      "SectionIndex1": 32,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Comment",
      "Text": "مِنْ مثنوی موسوم به ولایت نامه"
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "چون بتابد بر دل آن نور خدا",
      "CoupletIndex": 8,
      "SectionIndex1": 31,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "رنگ باطل‌ها شود ازوی جدا",
      "CoupletIndex": 8,
      "SectionIndex1": 31,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "شبهه و شک نیست در ذات قدیم",
      "CoupletIndex": 9,
      "SectionIndex1": 31,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "که بود محتاج اثبات ای حکیم",
      "CoupletIndex": 9,
      "SectionIndex1": 31,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "این ولایت راه عشق دوست است",
      "CoupletIndex": 10,
      "SectionIndex1": 31,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "لُبّ دین است این نه قشر و پوست است",
      "CoupletIndex": 10,
      "SectionIndex1": 31,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "تا نباشد جذب معشوقان ز پیش",
      "CoupletIndex": 11,
      "SectionIndex1": 31,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "عاشقان کی بگذرند از جان خویش",
      "CoupletIndex": 11,
      "SectionIndex1": 31,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "شاخ جنبان بینی اما باد نه",
      "CoupletIndex": 12,
      "SectionIndex1": 31,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "برگ رقصان بینی و شمشاد نه",
      "CoupletIndex": 12,
      "SectionIndex1": 31,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "جمله عالم همچو جامی پر شراب",
      "CoupletIndex": 13,
      "SectionIndex1": 31,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "عکس خورشید است کافتاده در آب",
      "CoupletIndex": 13,
      "SectionIndex1": 31,
      "SectionIndex2": 14
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "جمله ظلمت دیده و انوار نه",
      "CoupletIndex": 14,
      "SectionIndex1": 31,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "عکس‌ها بینند روی یار نه",
      "CoupletIndex": 14,
      "SectionIndex1": 31,
      "SectionIndex2": 15
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "نقش‌ها بینی تو و نقاش نه",
      "CoupletIndex": 15,
      "SectionIndex1": 31,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "دانه‌ها بینی و دانه پاش نه",
      "CoupletIndex": 15,
      "SectionIndex1": 31,
      "SectionIndex2": 16
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "چون که برق نار عشق از دل بجست",
      "CoupletIndex": 16,
      "SectionIndex1": 31,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "طور و موسی هر دو گردیدند مست",
      "CoupletIndex": 16,
      "SectionIndex1": 31,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "قلب درویشان حق خانهٔ شه است",
      "CoupletIndex": 17,
      "SectionIndex1": 31,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "اعظم از کعبه است کاین جا اللّه است",
      "CoupletIndex": 17,
      "SectionIndex1": 31,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "حفر کن این چاه و گل از وی برآر",
      "CoupletIndex": 18,
      "SectionIndex1": 31,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "تا خوری زین چاه آب خوشگوار",
      "CoupletIndex": 18,
      "SectionIndex1": 31,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "ظرف اگر صد هست می‌باشد یکی",
      "CoupletIndex": 19,
      "SectionIndex1": 31,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "گفتمت گر عارف این مسلکی",
      "CoupletIndex": 19,
      "SectionIndex1": 31,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "جمله اشیا ظرف می می واحد است",
      "CoupletIndex": 20,
      "SectionIndex1": 31,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "می در آنها وصف خود را شاهد است",
      "CoupletIndex": 20,
      "SectionIndex1": 31,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "این حباب از آن پیدا چون قِباب",
      "CoupletIndex": 21,
      "SectionIndex1": 31,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "آب باشد ثابت و صنفی حباب",
      "CoupletIndex": 21,
      "SectionIndex1": 31,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "ما علوم عشق از بر خوانده‌ایم",
      "CoupletIndex": 22,
      "SectionIndex1": 31,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "نز کتاب و نقش دفتر خوانده‌ایم",
      "CoupletIndex": 22,
      "SectionIndex1": 31,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "چون ز سرّ عشق ما آگه شدیم",
      "CoupletIndex": 23,
      "SectionIndex1": 31,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "از خرد بیگانه و ابله شدیم",
      "CoupletIndex": 23,
      "SectionIndex1": 31,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "عشق روح و ماش همچون قالبیم",
      "CoupletIndex": 24,
      "SectionIndex1": 31,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "از دل و جان عشق را ما طالبیم",
      "CoupletIndex": 24,
      "SectionIndex1": 31,
      "SectionIndex2": 25
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "الحذر زان مردمان بدخیال",
      "CoupletIndex": 25,
      "SectionIndex1": 31,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "کانبیا قولند و شیطانی فعال",
      "CoupletIndex": 25,
      "SectionIndex1": 31,
      "SectionIndex2": 26
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "لیس محضم نیستم من هیچ شیء",
      "CoupletIndex": 26,
      "SectionIndex1": 31,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "هستی از حق باشد و بنده است نی",
      "CoupletIndex": 26,
      "SectionIndex1": 31,
      "SectionIndex2": 27
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "آنچه دارد عبد زان مولی است",
      "CoupletIndex": 27,
      "SectionIndex1": 31,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "زین جهت عبد است گر خود فانی است",
      "CoupletIndex": 27,
      "SectionIndex1": 31,
      "SectionIndex2": 28
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "خواب و خور از من گرفت و چشم و گوش",
      "CoupletIndex": 28,
      "SectionIndex1": 31,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "رفتم از خود او مرا شد عقل و هوش",
      "CoupletIndex": 28,
      "SectionIndex1": 31,
      "SectionIndex2": 29
    },
    {
      "VOrder": 60,
