      "Text": "ساخت مجنونم چو کرد از خود جدا",
      "CoupletIndex": 29,
      "SectionIndex1": 31,
      "SectionIndex2": 30
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "همچو نی پیچید در من این صدا",
      "CoupletIndex": 29,
      "SectionIndex1": 31,
      "SectionIndex2": 30
    }
  ]
