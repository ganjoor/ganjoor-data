    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "دل منه بر وی که می‌گردد جهان",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "صبغة اللّه رنگ بی رنگی بود",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "شو به رنگ او که مانی تا ابد",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "رنگ کو ار حق نشانت می‌دهد",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "رنگ بی رنگست جانت می‌دهد",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "بندهٔ حق شو که آزادی کنی",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "با غمش درساز تا شادی کنی",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Comment",
      "Text": "رباعیّات"
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "ای آنکه به دلبری تویی بالادست",
      "CoupletIndex": 20,
      "SectionIndex1": 26,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "عمری است که گشته‌ام به دامت پابست",
      "CoupletIndex": 20,
      "SectionIndex1": 26,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "پایی به سرم نه که فتادم از پا",
      "CoupletIndex": 21,
      "SectionIndex1": 26,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "دستی به دلم رسان که رفتم از دست",
      "CoupletIndex": 21,
      "SectionIndex1": 26,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "تا بتوانی به جان بکش بار دلی",
      "CoupletIndex": 22,
      "SectionIndex1": 25,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "می‌کوش که تا دلت شود یار دلی",
      "CoupletIndex": 22,
      "SectionIndex1": 25,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "آزار دلی مکن که ناگاه کنی",
      "CoupletIndex": 23,
      "SectionIndex1": 25,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "کاردو جهان در سر آزار دلی",
      "CoupletIndex": 23,
      "SectionIndex1": 25,
      "SectionIndex2": 24
    }
  ]
}
