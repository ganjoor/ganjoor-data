      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "نورفشان همچو کف موسوی",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "روح فزا همچو دم عیسوی",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "بوی خدا از یمنم می‌رسد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "نفخ اویس از قرنم می‌رسد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "طوس، حریم حرم کبریاست",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "مدفن پاک شهِ پاکان، رضاست",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "کعبه اگر خانهٔ آب و گل است",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "طوس رضا کعبهٔ جان و دل است",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "کعبه بود سجده گه خاکیان",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "طوس بود قبلهٔ افلاکیان",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "مهبط انوار الهی است طوس",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "جلوه گه حضرت شاهی است طوس",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "آینهٔ سینهٔ سیناست طوس",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "خوابگه بضعهٔ موساست طوس",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "قبّهٔ او سرزده از ساق عرش",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "سُدّهٔ آن قبه بود طاق عرش",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    }
  ]
}
