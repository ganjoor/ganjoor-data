      "SectionIndex1": 46,
      "SectionIndex2": 25
    },
    {
      "VOrder": 116,
      "Position": "Right",
      "Text": "القصه به صد کرشمه و ناز مرا",
      "CoupletIndex": 35,
      "SectionIndex1": 46,
      "SectionIndex2": 26
    },
    {
      "VOrder": 118,
      "Position": "Left",
      "Text": "عاشق کردی و سر به صحرا دادی",
      "CoupletIndex": 35,
      "SectionIndex1": 46,
      "SectionIndex2": 26
    },
    {
      "VOrder": 120,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 36
    },
    {
      "VOrder": 122,
      "Position": "Right",
      "Text": "در کوی تو می‌دهند جانی به جوی",
      "CoupletIndex": 37,
      "SectionIndex1": 45,
      "SectionIndex2": 27
    },
    {
      "VOrder": 124,
      "Position": "Left",
      "Text": "جانی چه بود که کاروانی به جوی",
      "CoupletIndex": 37,
      "SectionIndex1": 45,
      "SectionIndex2": 27
    },
    {
      "VOrder": 126,
      "Position": "Right",
      "Text": "از وصل تو یک جو به جهانی ارزد",
      "CoupletIndex": 38,
      "SectionIndex1": 45,
      "SectionIndex2": 28
    },
    {
      "VOrder": 128,
      "Position": "Left",
      "Text": "زین نقد که ماراست جهانی به جوی",
      "CoupletIndex": 38,
      "SectionIndex1": 45,
      "SectionIndex2": 28
    },
    {
      "VOrder": 130,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 39
    },
    {
      "VOrder": 132,
      "Position": "Right",
      "Text": "گفتم که کرایی تو بدین زیبایی",
      "CoupletIndex": 40,
      "SectionIndex1": 44,
      "SectionIndex2": 29
    },
    {
      "VOrder": 134,
      "Position": "Left",
      "Text": "گفتا خود را که من خودم یکتایی",
      "CoupletIndex": 40,
      "SectionIndex1": 44,
      "SectionIndex2": 29
    },
    {
      "VOrder": 136,
      "Position": "Right",
      "Text": "هم عشقم و هم عاشقم و هم معشوقم",
      "CoupletIndex": 41,
      "SectionIndex1": 44,
      "SectionIndex2": 30
    },
    {
      "VOrder": 138,
      "Position": "Left",
      "Text": "هم آینه، هم جمال هم بینایی",
      "CoupletIndex": 41,
      "SectionIndex1": 44,
      "SectionIndex2": 30
    },
    {
      "VOrder": 140,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 42
    },
    {
      "VOrder": 142,
      "Position": "Right",
      "Text": "بردارم دل، گر از جهان فرمایی",
      "CoupletIndex": 43,
      "SectionIndex1": 43,
      "SectionIndex2": 31
    },
    {
      "VOrder": 144,
      "Position": "Left",
      "Text": "بر هم زنم از سود و زیان فرمایی",
      "CoupletIndex": 43,
      "SectionIndex1": 43,
      "SectionIndex2": 31
    },
    {
      "VOrder": 146,
      "Position": "Right",
      "Text": "بنشینم اگر بر سر آتش گویی",
      "CoupletIndex": 44,
      "SectionIndex1": 43,
      "SectionIndex2": 32
    },
    {
      "VOrder": 148,
      "Position": "Left",
      "Text": "برخیزم اگر از سر جان فرمایی",
      "CoupletIndex": 44,
      "SectionIndex1": 43,
      "SectionIndex2": 32
    }
  ]
}
