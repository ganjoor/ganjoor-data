      "Position": "Left",
      "Text": "زین طایفه در حشر حسابی دگر است",
      "CoupletIndex": 5,
      "SectionIndex1": 16,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 6
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "می خورده ز خانقاه می‌باید رفت",
      "CoupletIndex": 7,
      "SectionIndex1": 15,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "بی توشه و برگ راه می‌باید رفت",
      "CoupletIndex": 7,
      "SectionIndex1": 15,
      "SectionIndex2": 7
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "آلودهٔ صد گناه می‌باید مرد",
      "CoupletIndex": 8,
      "SectionIndex1": 15,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "شرمنده و روسیاه می‌باید رفت",
      "CoupletIndex": 8,
      "SectionIndex1": 15,
      "SectionIndex2": 8
    },
    {
      "VOrder": 19,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 9
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "هر نقش که بر تختهٔ هستی پیداست",
      "CoupletIndex": 10,
      "SectionIndex1": 14,
      "SectionIndex2": 9
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "آن صورت آن کس است کان نقش آراست",
      "CoupletIndex": 10,
      "SectionIndex1": 14,
      "SectionIndex2": 9
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "دریای کهن چو برزند موجی نو",
      "CoupletIndex": 11,
      "SectionIndex1": 14,
      "SectionIndex2": 10
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "موجش خوانند و در حقیقت دریاست",
      "CoupletIndex": 11,
      "SectionIndex1": 14,
      "SectionIndex2": 10
    },
    {
      "VOrder": 24,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "از واعظ شهر کی مرا عار شود",
      "CoupletIndex": 13,
      "SectionIndex1": 13,
      "SectionIndex2": 11
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "با کفر من اسلام کجا یار شود",
      "CoupletIndex": 13,
      "SectionIndex1": 13,
      "SectionIndex2": 11
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "گر حبل متین به گردنم درفکنند",
      "CoupletIndex": 14,
      "SectionIndex1": 13,
      "SectionIndex2": 12
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "بیم است ز کفر من که زنّار شود",
      "CoupletIndex": 14,
      "SectionIndex1": 13,
      "SectionIndex2": 12
    }
  ]
}
