      "SectionIndex1": 28,
      "SectionIndex2": 7
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "حضرت بی مثل را مرآت انسان آرزوست",
      "CoupletIndex": 10,
      "SectionIndex1": 28,
      "SectionIndex2": 7
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "به غیر هستی حق هیچ روی ننماید",
      "CoupletIndex": 11,
      "SectionIndex1": 27,
      "SectionIndex2": 8
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "ترا که دیدهٔ دل روشن و مصفا شد",
      "CoupletIndex": 11,
      "SectionIndex1": 27,
      "SectionIndex2": 8
    },
    {
      "VOrder": 20,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 12
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "هرکه را زلف چو زنجیر تو دیوانه کند",
      "CoupletIndex": 13,
      "SectionIndex1": 26,
      "SectionIndex2": 9
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "ز آشنایانِ جهانش همه بیگانه کند",
      "CoupletIndex": 13,
      "SectionIndex1": 26,
      "SectionIndex2": 9
    },
    {
      "VOrder": 23,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 14
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "چو ختمِ آفرینش آدمی بود",
      "CoupletIndex": 15,
      "SectionIndex1": 25,
      "SectionIndex2": 10
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "به آخر نوعِ انسان آفریدند",
      "CoupletIndex": 15,
      "SectionIndex1": 25,
      "SectionIndex2": 10
    },
    {
      "VOrder": 26,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 16
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "دلا در بوتهٔ عشقش چو زر بگدازوصافی شو",
      "CoupletIndex": 17,
      "SectionIndex1": 24,
      "SectionIndex2": 11
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "وگرنه قلب می‌مانی و آن صراف می‌آید",
      "CoupletIndex": 17,
      "SectionIndex1": 24,
      "SectionIndex2": 11
    },
    {
      "VOrder": 29,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 18
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "ز نورِ طلعت او سوخت هرچه موجود است",
      "CoupletIndex": 19,
      "SectionIndex1": 23,
      "SectionIndex2": 12
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "به غیرِ زلف که بر رویِ او نقاب شود",
      "CoupletIndex": 19,
      "SectionIndex1": 23,
      "SectionIndex2": 12
    },
    {
      "VOrder": 32,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 20
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "یک عین که جز اونیست در ظاهر و درباطن",
      "CoupletIndex": 21,
      "SectionIndex1": 22,
      "SectionIndex2": 13
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "هفتاد و دوملت شد ترسا ویهودآمد",
      "CoupletIndex": 21,
      "SectionIndex1": 22,
      "SectionIndex2": 13
    },
    {
      "VOrder": 35,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 22
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "عاقبت سیل سرشکیِ بِبَرَد بنیادش",
      "CoupletIndex": 23,
      "SectionIndex1": 38,
      "SectionIndex2": 14
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "هرکه بر گریهٔ اربابِ نظر می‌خندد",
      "CoupletIndex": 23,
      "SectionIndex1": 38,
      "SectionIndex2": 14
    },
    {
      "VOrder": 38,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 24
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "کامِ دل هیچ کس از لعل تو هرگز نگرفت",
      "CoupletIndex": 25,
      "SectionIndex1": 37,
      "SectionIndex2": 15
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "نام آن لب همه را کام و دهان می‌سوزد",
      "CoupletIndex": 25,
      "SectionIndex1": 37,
      "SectionIndex2": 15
    },
    {
      "VOrder": 41,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 26
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "بی جان و تن دلم شد در وصل یار واصل",
      "CoupletIndex": 27,
      "SectionIndex1": 36,
      "SectionIndex2": 16
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "تحصیل یار کردیم عمری و بود حاصل",
      "CoupletIndex": 27,
      "SectionIndex1": 36,
      "SectionIndex2": 16
    },
    {
      "VOrder": 44,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 28
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "عرش و کرسی و آسمان و زمین",
      "CoupletIndex": 29,
      "SectionIndex1": 35,
      "SectionIndex2": 17
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "غرقه در بحرِ بی‌کرانهٔ دل",
      "CoupletIndex": 29,
      "SectionIndex1": 35,
      "SectionIndex2": 17
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "همه در دل چو بی نشان شده‌اند",
      "CoupletIndex": 30,
      "SectionIndex1": 35,
      "SectionIndex2": 18
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "ندهد هیچ کس نشانهٔ دل",
      "CoupletIndex": 30,
      "SectionIndex1": 35,
      "SectionIndex2": 18
    },
    {
      "VOrder": 49,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 31
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "می‌نگنجد در زمین و عرش و کرسی آه آه",
      "CoupletIndex": 32,
      "SectionIndex1": 34,
      "SectionIndex2": 19
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "جز دل پرخون نمی‌بینیم جایی جای او",
      "CoupletIndex": 32,
      "SectionIndex1": 34,
      "SectionIndex2": 19
    },
    {
      "VOrder": 52,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 33
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "ای که از فرط بزرگی می‌نگنجی در جهان",
      "CoupletIndex": 34,
      "SectionIndex1": 33,
      "SectionIndex2": 20
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "در دلم کان قطرهٔ خونیست چون جاکرده‌ای",
      "CoupletIndex": 34,
      "SectionIndex1": 33,
      "SectionIndex2": 20
    },
    {
      "VOrder": 55,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 35
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "کشف شد سر ازل تا به ابد چون یک دم",
      "CoupletIndex": 36,
      "SectionIndex1": 32,
      "SectionIndex2": 21
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "بر من از عالم اسرار گشودند دری",
      "CoupletIndex": 36,
      "SectionIndex1": 32,
      "SectionIndex2": 21
    }
  ]
}
