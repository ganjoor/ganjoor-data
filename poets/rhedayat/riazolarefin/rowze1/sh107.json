  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "عماد الدین فقیه مشهور است در عهد دولت آل مظفر. از سلاطین زمان تعظیم و تکریم یافته و در سنهٔ ۷۷۳ به روضهٔ رضوان شتافتند. دیوانش به نظر رسیده، مشتمل است بر مثنویات چند که صفانامه و محبت نامه و طریقت نامه و ره نامه و فاتحة الاخلاص و قصاید و غزلیات و رباعیات است. اشعار خوب دارد. از آنهاست:",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Right",
      "Text": "غم این تودهٔ خاک از دل مستان مطلب",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Left",
      "Text": "کاین غباریست که بر خاطر هشیارانست",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "عالمی از سر زلف تو پریشان و هنوز",
      "CoupletIndex": 3,
      "SectionIndex1": 22,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "از سرِ زلف تو بویی به مشامی نرسد",
      "CoupletIndex": 3,
      "SectionIndex1": 22,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 4
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "بر خیز تا بجوییم از هر دری مرادی",
      "CoupletIndex": 5,
      "SectionIndex1": 21,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "کز در به روی بستن کاری نمی‌گشاید",
      "CoupletIndex": 5,
      "SectionIndex1": 21,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "طاعت ناقص من موجب کفران نشود",
      "CoupletIndex": 7,
      "SectionIndex1": 20,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "راضیم گر مدد علت عصیان نشود",
      "CoupletIndex": 7,
      "SectionIndex1": 20,
      "SectionIndex2": 5
    },
    {
      "VOrder": 13,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 8
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "وصلش به جستجو نتوان یافتن ولی",
      "CoupletIndex": 9,
      "SectionIndex1": 19,
      "SectionIndex2": 6
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "آن به که عمر در سر این جستجو رود",
      "CoupletIndex": 9,
      "SectionIndex1": 19,
      "SectionIndex2": 6
    },
    {
      "VOrder": 16,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 10
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "گر ز طلب روی نتابد مرید",
      "CoupletIndex": 11,
      "SectionIndex1": 18,
      "SectionIndex2": 7
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "عاقبت الامر بیابد مراد",
      "CoupletIndex": 11,
      "SectionIndex1": 18,
      "SectionIndex2": 7
    },
    {
      "VOrder": 19,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 12
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "هیچ دانی دولت من از کجاست",
      "CoupletIndex": 13,
      "SectionIndex1": 17,
      "SectionIndex2": 8
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "از دَرِ دلها گدایی کرده‌ام",
      "CoupletIndex": 13,
      "SectionIndex1": 17,
      "SectionIndex2": 8
    },
    {
      "VOrder": 22,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 14
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "ما که امروز گرانان جهانیم اینیم",
      "CoupletIndex": 15,
      "SectionIndex1": 16,
      "SectionIndex2": 9
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "که سبک روح‌تر از عیسی مریم بودیم",
      "CoupletIndex": 15,
      "SectionIndex1": 16,
      "SectionIndex2": 9
    },
    {
      "VOrder": 25,
      "Position": "Comment",
      "Text": "ایضاً قطعةٌ فی المَوعظَةِ والنّصیحةِ"
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "بر لوح جان نوشته‌ام از گفتهٔ پدر",
      "CoupletIndex": 16,
      "SectionIndex1": 15,
      "SectionIndex2": 10
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "روز ازل که تربت او باد عنبرین",
      "CoupletIndex": 16,
      "SectionIndex1": 15,
      "SectionIndex2": 10
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "کای طفل اگر به صحبت افتاده‌ای رسی",
      "CoupletIndex": 17,
      "SectionIndex1": 15,
      "SectionIndex2": 11
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "شوخی مکن به چشم حقارت درو مبین",
      "CoupletIndex": 17,
      "SectionIndex1": 15,
      "SectionIndex2": 11
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "گر در جهان دلی ز تو خرم نمی‌شود",
      "CoupletIndex": 18,
      "SectionIndex1": 15,
      "SectionIndex2": 12
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "باری چنان مکن که شود خاطری غمین",
      "CoupletIndex": 18,
      "SectionIndex1": 15,
      "SectionIndex2": 12
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "بر شیر از آن شدند بزرگان دین سوار",
      "CoupletIndex": 19,
      "SectionIndex1": 15,
      "SectionIndex2": 13
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "کآهسته‌تر ز مور گذشتند بر زمین",
      "CoupletIndex": 19,
      "SectionIndex1": 15,
      "SectionIndex2": 13
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "یاری بجز خدا نتوان خواستن عماد",
      "CoupletIndex": 20,
      "SectionIndex1": 15,
      "SectionIndex2": 14
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "یا مستعانُ عَوْنَکَ إیّاکَ نَسْتَعِیْنُ",
