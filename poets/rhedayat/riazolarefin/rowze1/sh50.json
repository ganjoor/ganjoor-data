      "Text": "اصلش از لاهیجان رشت و نامش شیخ محمدعلی و از متأخرین است. در اواخر دولت صفویه ظهور نموده و صاحب کمالات صوری و معنوی بوده و خطوط را نیکو رقم می‌نمود. آذربایجان و خراسان و عراق و فارس را سیاحت کرده و از راه لارستان و بندر عباسی روی به هندوستان آورد. در دهلی توطن گزید و معروف اهالی آن بلاد گردید. اعاظم آن بلد را مراد و طلاب را محل اعتماد و جمعی را به خدمتش اعتقاد به هم رسیده. دیوانش ملاحظه و این ابیاتش منتخب شد:",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Comment",
      "Text": "مِنْغزلیاته"
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "با هرچه بود انس تو جای تو همان است",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "هر چیز هوای تو خدای تو همان است",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 2
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "کودک مشیمه را نشمارد به خویش نیک",
      "CoupletIndex": 3,
      "SectionIndex1": 22,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "دنیا به چشم مردم دنیا حقیر نیست",
      "CoupletIndex": 3,
      "SectionIndex1": 22,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "از صحبت صوفی منشان سوخت دماغم",
      "CoupletIndex": 5,
      "SectionIndex1": 21,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "ای باده پرستان ره میخانه کدامست",
      "CoupletIndex": 5,
      "SectionIndex1": 21,
      "SectionIndex2": 4
    },
    {
      "VOrder": 11,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 6
    },
    {
      "VOrder": 12,
      "Position": "Right",
      "Text": "نومیدی عاشقان قدیم است",
      "CoupletIndex": 7,
      "SectionIndex1": 20,
      "SectionIndex2": 5
    },
    {
      "VOrder": 13,
      "Position": "Left",
      "Text": "مخصوص به روزگار من نیست",
      "CoupletIndex": 7,
      "SectionIndex1": 20,
      "SectionIndex2": 5
    },
    {
      "VOrder": 14,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "کرد داغم نگه زاهد خاموش حزین",
      "CoupletIndex": 9,
      "SectionIndex1": 19,
      "SectionIndex2": 6
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "چه بگویم به من این صورت دیوار چه کرد",
      "CoupletIndex": 9,
      "SectionIndex1": 19,
      "SectionIndex2": 6
    },
    {
      "VOrder": 17,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 10
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "بنمای رخ چون دیده را گرم تماشا کرده‌ای",
      "CoupletIndex": 11,
      "SectionIndex1": 18,
      "SectionIndex2": 7
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "ار خوش بود مستوریت ما را چه رسوا کرده‌ای",
      "CoupletIndex": 11,
      "SectionIndex1": 18,
      "SectionIndex2": 7
    },
    {
      "VOrder": 20,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 12
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "تو و زهد خشک زاهد، من و عشق و می پرستی",
      "CoupletIndex": 13,
      "SectionIndex1": 17,
      "SectionIndex2": 8
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "تو و عیش هوشیاری، من و گریه‌های مستی",
      "CoupletIndex": 13,
      "SectionIndex1": 17,
      "SectionIndex2": 8
    },
    {
      "VOrder": 23,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 14
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "بازوی زال دنیا چند افکند به خاکت",
      "CoupletIndex": 15,
      "SectionIndex1": 16,
      "SectionIndex2": 9
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "بی درد پشت دستی نامرد پشت پایی",
      "CoupletIndex": 15,
      "SectionIndex1": 16,
      "SectionIndex2": 9
    },
    {
      "VOrder": 26,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 16
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "دولت طلبی دامن دل را مده از دست",
      "CoupletIndex": 17,
      "SectionIndex1": 15,
      "SectionIndex2": 10
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "شاید که برون آید از این بیضه همایی",
      "CoupletIndex": 17,
      "SectionIndex1": 15,
      "SectionIndex2": 10
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "نالیدن بلبل ز نوآموزی عشق است",
      "CoupletIndex": 18,
      "SectionIndex1": 14,
      "SectionIndex2": 11
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "هرگز نشنیدیم ز پروانه صدایی",
      "CoupletIndex": 18,
      "SectionIndex1": 14,
      "SectionIndex2": 11
    },
    {
      "VOrder": 31,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 19
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "پیاله می‌کشم امشب به طاق ابرویی",
      "CoupletIndex": 20,
      "SectionIndex1": 13,
      "SectionIndex2": 12
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "سبوکشان خرابات عشق را هویی",
      "CoupletIndex": 20,
      "SectionIndex1": 13,
      "SectionIndex2": 12
    }
  ]
}
