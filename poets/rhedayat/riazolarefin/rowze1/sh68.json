      "VOrder": 8,
      "Position": "Left",
      "Text": "خار ما در راه او گلزار باد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "هر که چاهی می‌کند در راه ما",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "چاه ما در راه او هموار باد",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "هرکه ملک و مال ما را حاسد است",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "ملک و مالش در جهان بسیار باد",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "هر که را مستی زرکوب آرزوست",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "گو که ما مستیم او هشیار باد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Comment",
      "Text": "رباعی"
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "تا طارم نُه سپهر آراسته‌اند",
      "CoupletIndex": 7,
      "SectionIndex1": 16,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "تا باغ جهان طبع پیراسته‌اند",
      "CoupletIndex": 7,
      "SectionIndex1": 16,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "در خار فزوده و ز گل کاسته‌اند",
      "CoupletIndex": 8,
      "SectionIndex1": 16,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "چه توان کردن که این چنین خواسته‌اند",
      "CoupletIndex": 8,
      "SectionIndex1": 16,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 9
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "از بود ونبود کل اشیاء در طلق",
      "CoupletIndex": 10,
      "SectionIndex1": 15,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "گویم سخنی فراخ کن سینه و حلق",
      "CoupletIndex": 10,
      "SectionIndex1": 15,
      "SectionIndex2": 10
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "بودی و نمودی است وجود اشیاء",
      "CoupletIndex": 11,
      "SectionIndex1": 15,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "بودش همه حق است و نمودش همه خلق",
      "CoupletIndex": 11,
      "SectionIndex1": 15,
      "SectionIndex2": 11
    },
    {
      "VOrder": 25,
      "Position": "Comment",
      "Text": "قطعه"
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "منم زرکوب و محصولم ز صنعت",
      "CoupletIndex": 12,
      "SectionIndex1": 14,
      "SectionIndex2": 12
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "بجز فریادی و بانگی نباشد",
      "CoupletIndex": 12,
      "SectionIndex1": 14,
      "SectionIndex2": 12
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "همیشه در میان زر نشینم",
      "CoupletIndex": 13,
      "SectionIndex1": 14,
      "SectionIndex2": 13
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "ولیکن هرگزم دانگی نباشد",
      "CoupletIndex": 13,
      "SectionIndex1": 14,
      "SectionIndex2": 13
    }
  ]
}
