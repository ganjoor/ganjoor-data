      "Text": "اسمش حسین و ازفضلای زمان خود بوده. در نزد علما و عرفا کسب کمالات ظاهری و باطنی نموده. مدتها به تصفیه و تزکیهٔ نفس اشتغال داشته، آخر لوای سفر عقبی افراشته، بر عالم فانی دامن افشاند و این رباعیات در عالم از او یادگار مانده:",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Comment",
      "Text": "مِنْرباعیّاتِهِ"
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "نتوان به خدا رسید از علم کتاب",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "حجت نبرد راه به اقلیم صواب",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "در وادی معرفت براهین حکیم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "چون جاده‌هاست در چراگاه دواب",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 3
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "فعلِ بد ما چو قّصهٔ بوالعجب است",
      "CoupletIndex": 4,
      "SectionIndex1": 18,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "روز همه در فکرت این قصه شب است",
      "CoupletIndex": 4,
      "SectionIndex1": 18,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "تهمت نشتوان به قدرتِ ناقص کرد",
      "CoupletIndex": 5,
      "SectionIndex1": 18,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "حق هم نتوان گفت که ترکِ ادب است",
      "CoupletIndex": 5,
      "SectionIndex1": 18,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "مؤمن به بدی نیست کسی مانندت",
      "CoupletIndex": 7,
      "SectionIndex1": 17,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "این طرفه که خلق نیک می‌خوانندت",
      "CoupletIndex": 7,
      "SectionIndex1": 17,
      "SectionIndex2": 6
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "یک چند چنان بدی که خود می‌دانی",
      "CoupletIndex": 8,
      "SectionIndex1": 17,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "یک چند چنان باش که می‌دانندت",
      "CoupletIndex": 8,
      "SectionIndex1": 17,
      "SectionIndex2": 7
    },
    {
      "VOrder": 17,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 9
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "در پهلوی دل وثاقم از ناله پُر است",
      "CoupletIndex": 10,
      "SectionIndex1": 16,
      "SectionIndex2": 8
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "جانم ز تب ولبم ز تبخاله پر است",
      "CoupletIndex": 10,
      "SectionIndex1": 16,
      "SectionIndex2": 8
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "از دیدهٔ خونبار که چشمش مرساد",
      "CoupletIndex": 11,
      "SectionIndex1": 16,
      "SectionIndex2": 9
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "دامان و کنارم ز گلِ لاله پر است",
      "CoupletIndex": 11,
      "SectionIndex1": 16,
      "SectionIndex2": 9
    },
    {
      "VOrder": 22,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "ما حرص به نیروی قناعت شکنیم",
      "CoupletIndex": 13,
      "SectionIndex1": 15,
      "SectionIndex2": 10
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "وندر دل خلق خارِ منّت شکنیم",
      "CoupletIndex": 13,
      "SectionIndex1": 15,
      "SectionIndex2": 10
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "پا بر سر تاج کیقبادی ننهیم",
      "CoupletIndex": 14,
      "SectionIndex1": 15,
      "SectionIndex2": 11
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "آنجا که کُله گوشهٔ همت شکنیم",
      "CoupletIndex": 14,
      "SectionIndex1": 15,
      "SectionIndex2": 11
    },
    {
      "VOrder": 27,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 15
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "دل چیست درون سینه سوزی و تفی",
      "CoupletIndex": 16,
      "SectionIndex1": 14,
      "SectionIndex2": 12
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "تن چیست غم و رنج و بلا را هدفی",
      "CoupletIndex": 16,
      "SectionIndex1": 14,
      "SectionIndex2": 12
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "القصه به قصد جان ما بسته صفی",
      "CoupletIndex": 17,
      "SectionIndex1": 14,
      "SectionIndex2": 13
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "مرگ از طرفی وزندگی از طرفی",
      "CoupletIndex": 17,
      "SectionIndex1": 14,
      "SectionIndex2": 13
    }
  ]
}
