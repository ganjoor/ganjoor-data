      "Position": "Left",
      "Text": "نه در میخانه کاین خمار، خام است",
      "CoupletIndex": 3,
      "SectionIndex1": 35,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "میان مسجد و میخانه راهیست",
      "CoupletIndex": 4,
      "SectionIndex1": 35,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "غریبم، عاشقم، آن ره کدام است",
      "CoupletIndex": 4,
      "SectionIndex1": 35,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "خواستم شرح غم دل به قلم بنویسم",
      "CoupletIndex": 6,
      "SectionIndex1": 34,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "آتشی در قلم افتاد که طومار بسوخت",
      "CoupletIndex": 6,
      "SectionIndex1": 34,
      "SectionIndex2": 5
    },
    {
      "VOrder": 13,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 7
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "غره مشو که مرکب مردان مرد را",
      "CoupletIndex": 8,
      "SectionIndex1": 33,
      "SectionIndex2": 6
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "در سنگلاخ بادیه پی ها بریده‌اند",
      "CoupletIndex": 8,
      "SectionIndex1": 33,
      "SectionIndex2": 6
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "نومید هم مباش که رندان باده نوش",
      "CoupletIndex": 9,
      "SectionIndex1": 33,
      "SectionIndex2": 7
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "ناگه به یک ترانه به منزل رسیده‌اند",
      "CoupletIndex": 9,
      "SectionIndex1": 33,
      "SectionIndex2": 7
    },
    {
      "VOrder": 18,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "یارم ز خرابات درآمد سرمست",
      "CoupletIndex": 11,
      "SectionIndex1": 32,
      "SectionIndex2": 8
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "مانند لب خویش می لعل به دست",
      "CoupletIndex": 11,
      "SectionIndex1": 32,
      "SectionIndex2": 8
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "گفتم صنما من از تو کی خواهم رست",
      "CoupletIndex": 12,
      "SectionIndex1": 32,
      "SectionIndex2": 9
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "گفتا نرهد هر آنکه در ما پیوست",
      "CoupletIndex": 12,
      "SectionIndex1": 32,
      "SectionIndex2": 9
    },
    {
      "VOrder": 23,
      "Position": "Comment",
      "Text": "رباعیات"
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "عشق آینه‌ایست کاندرو زنگی نیست",
      "CoupletIndex": 13,
      "SectionIndex1": 31,
      "SectionIndex2": 10
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "با بی خبران در این سخن جنگی نیست",
      "CoupletIndex": 13,
      "SectionIndex1": 31,
      "SectionIndex2": 10
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "دانی که که را عشق، مسلم باشد",
      "CoupletIndex": 14,
      "SectionIndex1": 31,
      "SectionIndex2": 11
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "آن را که ز بدنام شدن ننگی نیست",
      "CoupletIndex": 14,
      "SectionIndex1": 31,
      "SectionIndex2": 11
    },
    {
      "VOrder": 28,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "چون تیشه مباش و جمله بر خود متراش",
      "CoupletIndex": 16,
      "SectionIndex1": 30,
      "SectionIndex2": 12
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "چون رنده ز کار خویش بی بهره مباش",
      "CoupletIndex": 16,
      "SectionIndex1": 30,
      "SectionIndex2": 12
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "تعلیم زاره گیر در عقل معاش",
      "CoupletIndex": 17,
      "SectionIndex1": 30,
      "SectionIndex2": 13
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "چیزی سوی خود می‌کش و چیزی می‌پاش",
      "CoupletIndex": 17,
      "SectionIndex1": 30,
      "SectionIndex2": 13
    },
    {
      "VOrder": 33,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 18
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "با درد بساز چون دوای تو منم",
      "CoupletIndex": 19,
      "SectionIndex1": 29,
      "SectionIndex2": 14
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "در کس منگر که آشنای تو منم",
      "CoupletIndex": 19,
      "SectionIndex1": 29,
      "SectionIndex2": 14
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "گر بر سر کوی عشق ما کشته شوی",
      "CoupletIndex": 20,
      "SectionIndex1": 29,
      "SectionIndex2": 15
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "شکرانه بده که خونبهای تو منم",
      "CoupletIndex": 20,
      "SectionIndex1": 29,
      "SectionIndex2": 15
    },
    {
      "VOrder": 38,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 21
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "چون قدر به نیستی است هستی کم کن",
      "CoupletIndex": 22,
      "SectionIndex1": 28,
      "SectionIndex2": 16
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "هستی بت تست بت پرستی کم کن",
      "CoupletIndex": 22,
      "SectionIndex1": 28,
      "SectionIndex2": 16
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "از هستی و نیستی چو فارغ گشتی",
      "CoupletIndex": 23,
      "SectionIndex1": 28,
      "SectionIndex2": 17
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "می نوش شراب ذوق و مستی کم کن",
      "CoupletIndex": 23,
      "SectionIndex1": 28,
      "SectionIndex2": 17
    },
    {
      "VOrder": 43,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 24
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "تا یک سر موی از تو هستی باقی است",
      "CoupletIndex": 25,
      "SectionIndex1": 27,
      "SectionIndex2": 18
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "آیین دکان خودپرستی باقی است",
      "CoupletIndex": 25,
      "SectionIndex1": 27,
      "SectionIndex2": 18
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "گفتی بت پندار شکستم، رستم",
      "CoupletIndex": 26,
      "SectionIndex1": 27,
      "SectionIndex2": 19
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "آن بت که ز پندار برستی، باقی است",
      "CoupletIndex": 26,
      "SectionIndex1": 27,
      "SectionIndex2": 19
    },
    {
      "VOrder": 48,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 27
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "چشمم، که سرشک لاله گون آورده",
      "CoupletIndex": 28,
      "SectionIndex1": 26,
      "SectionIndex2": 20
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "بر هر مژه قطره‌های خون آورده",
      "CoupletIndex": 28,
      "SectionIndex1": 26,
      "SectionIndex2": 20
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "نی نی به نظاره‌اش دل خون شده‌ام",
      "CoupletIndex": 29,
      "SectionIndex1": 26,
      "SectionIndex2": 21
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "از روزن دید سر برون آورده",
      "CoupletIndex": 29,
      "SectionIndex1": 26,
      "SectionIndex2": 21
    },
    {
      "VOrder": 53,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 30
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "از خلق مخواه، ار ندهد سوخته شی",
      "CoupletIndex": 31,
      "SectionIndex1": 37,
      "SectionIndex2": 22
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "ور زانکه دهد به منت افروخته شی",
      "CoupletIndex": 31,
      "SectionIndex1": 37,
      "SectionIndex2": 22
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "از خالق خواه ار دهد اندوخته شی",
      "CoupletIndex": 32,
      "SectionIndex1": 37,
      "SectionIndex2": 23
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "ور می‌ندهد، بر درش آموخته شی",
      "CoupletIndex": 32,
      "SectionIndex1": 37,
      "SectionIndex2": 23
    },
    {
      "VOrder": 58,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 33
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "گه ترک وجودغم فزاینده کنی",
      "CoupletIndex": 34,
      "SectionIndex1": 36,
      "SectionIndex2": 24
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "گه آرزوی حیات پاینده کنی",
      "CoupletIndex": 34,
      "SectionIndex1": 36,
      "SectionIndex2": 24
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "آیندهٔ عمر خواهی از رفته فزون",
      "CoupletIndex": 35,
      "SectionIndex1": 36,
      "SectionIndex2": 25
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "در رفته چه کردی که در آینده کنی",
      "CoupletIndex": 35,
      "SectionIndex1": 36,
      "SectionIndex2": 25
    }
  ]
}
