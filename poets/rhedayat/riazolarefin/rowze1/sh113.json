      "VOrder": 9,
      "Position": "Right",
      "Text": "در کعبه اگر دل سوی غیر است تو را",
      "CoupletIndex": 4,
      "SectionIndex1": 42,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "طاعت گنه است و کعبه دیر است تو را",
      "CoupletIndex": 4,
      "SectionIndex1": 42,
      "SectionIndex2": 4
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "گر دل به حق است و ساکن بتکده‌ای",
      "CoupletIndex": 5,
      "SectionIndex1": 42,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "خوش باش که عاقبت به خیر است تو را",
      "CoupletIndex": 5,
      "SectionIndex1": 42,
      "SectionIndex2": 5
    },
    {
      "VOrder": 13,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 6
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "تا کی گویی که گوی اقبال که برد",
      "CoupletIndex": 7,
      "SectionIndex1": 41,
      "SectionIndex2": 6
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "تا کی گویی که ساغرِعیش که خورد",
      "CoupletIndex": 7,
      "SectionIndex1": 41,
      "SectionIndex2": 6
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "اینها چو فسانه‌است می‌باید رفت",
      "CoupletIndex": 8,
      "SectionIndex1": 41,
      "SectionIndex2": 7
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "اینها چو حکایت است می‌باید مرد",
      "CoupletIndex": 8,
      "SectionIndex1": 41,
      "SectionIndex2": 7
    },
    {
      "VOrder": 18,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "سلطان گوید که نقد گنجینهٔ من",
      "CoupletIndex": 10,
      "SectionIndex1": 40,
      "SectionIndex2": 8
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "صوفی گوید که دلق پشمینهٔ من",
      "CoupletIndex": 10,
      "SectionIndex1": 40,
      "SectionIndex2": 8
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "عاشق گوید که داغ دیرینهٔ من",
      "CoupletIndex": 11,
      "SectionIndex1": 40,
      "SectionIndex2": 9
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "من دانم و من که چیست در سینهٔ من",
      "CoupletIndex": 11,
      "SectionIndex1": 40,
      "SectionIndex2": 9
    },
    {
      "VOrder": 23,
      "Position": "Comment",
      "Text": "مثنوی نقش بدیع"
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "خاک دل آن روز که می‌بیختند",
      "CoupletIndex": 12,
      "SectionIndex1": 39,
      "SectionIndex2": 10
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "شبنمی از عشق بر او ریختند",
      "CoupletIndex": 12,
      "SectionIndex1": 39,
      "SectionIndex2": 10
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "دل که بدان رشحه غم اندود شد",
      "CoupletIndex": 13,
      "SectionIndex1": 39,
      "SectionIndex2": 11
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "بود کبابی که نمک سود شد",
      "CoupletIndex": 13,
      "SectionIndex1": 39,
      "SectionIndex2": 11
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "دیدهٔ عاشق که دهد خونِ ناب",
      "CoupletIndex": 14,
      "SectionIndex1": 38,
      "SectionIndex2": 12
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "هست همان خون که چکد زان کباب",
      "CoupletIndex": 14,
      "SectionIndex1": 38,
      "SectionIndex2": 12
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "بی اثر مهر چه آب و چه گل",
      "CoupletIndex": 15,
      "SectionIndex1": 38,
      "SectionIndex2": 13
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "بی نمکِ عشق چه سنگ و چه دل",
      "CoupletIndex": 15,
      "SectionIndex1": 38,
      "SectionIndex2": 13
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "دل که ز عشق آتش سودا دروست",
      "CoupletIndex": 16,
      "SectionIndex1": 37,
      "SectionIndex2": 14
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "قطرهٔ خونیست که دریا دروست",
      "CoupletIndex": 16,
      "SectionIndex1": 37,
      "SectionIndex2": 14
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "سبحه شماران ثریا گسل",
      "CoupletIndex": 17,
      "SectionIndex1": 37,
      "SectionIndex2": 15
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "مهرهٔ گل را نشمارند دل",
      "CoupletIndex": 17,
      "SectionIndex1": 37,
      "SectionIndex2": 15
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "به که نه مشغول به این دل شوی",
      "CoupletIndex": 18,
      "SectionIndex1": 37,
      "SectionIndex2": 16
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "کش ببرد گریه چو غافل شوی",
      "CoupletIndex": 18,
      "SectionIndex1": 37,
      "SectionIndex2": 16
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "آهن و سنگی که شراری دروست",
      "CoupletIndex": 19,
      "SectionIndex1": 37,
      "SectionIndex2": 17
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "بهتر از آن دل که نه یاری دروست",
      "CoupletIndex": 19,
      "SectionIndex1": 37,
      "SectionIndex2": 17
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "نیست دل آن دل که در او داغ نیست",
      "CoupletIndex": 20,
      "SectionIndex1": 37,
      "SectionIndex2": 18
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "لالهٔ بی داغ در این باغ نیست",
      "CoupletIndex": 20,
      "SectionIndex1": 37,
      "SectionIndex2": 18
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "نازکی دل سبب قرب تست",
      "CoupletIndex": 21,
      "SectionIndex1": 37,
      "SectionIndex2": 19
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "گر شکند کار تو گردد درست",
      "CoupletIndex": 21,
      "SectionIndex1": 37,
      "SectionIndex2": 19
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "دامن از اندیشهٔ باطل بکش",
      "CoupletIndex": 22,
      "SectionIndex1": 37,
      "SectionIndex2": 20
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "دست ز آسودگی دل بکش",
      "CoupletIndex": 22,
      "SectionIndex1": 37,
      "SectionIndex2": 20
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "کار چنان کن که درین تیره خاک",
      "CoupletIndex": 23,
      "SectionIndex1": 37,
      "SectionIndex2": 21
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "دامن عصمت نکنی چاک چاک",
      "CoupletIndex": 23,
      "SectionIndex1": 37,
      "SectionIndex2": 21
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "قدر دل آنها که قوی یافتند",
      "CoupletIndex": 24,
      "SectionIndex1": 37,
      "SectionIndex2": 22
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "از قدمِ پاکروی یافتند",
      "CoupletIndex": 24,
      "SectionIndex1": 37,
      "SectionIndex2": 22
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "عشق بلند آمد و دلبر غیور",
      "CoupletIndex": 25,
      "SectionIndex1": 37,
      "SectionIndex2": 23
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "در ادب آویز و رها کن غرور",
      "CoupletIndex": 25,
      "SectionIndex1": 37,
      "SectionIndex2": 23
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "چرخ درین سلسله پا در گل است",
      "CoupletIndex": 26,
      "SectionIndex1": 37,
      "SectionIndex2": 24
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "عقل درین میکده لایعقل است",
      "CoupletIndex": 26,
      "SectionIndex1": 37,
      "SectionIndex2": 24
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "جان و جسد خستهٔ این مرهمند",
      "CoupletIndex": 27,
      "SectionIndex1": 37,
      "SectionIndex2": 25
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "ملک و ملک سوختهٔ این غمند",
      "CoupletIndex": 27,
      "SectionIndex1": 37,
      "SectionIndex2": 25
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "ای به نظاره شده‌ای دیده باز",
      "CoupletIndex": 28,
      "SectionIndex1": 37,
      "SectionIndex2": 26
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "سهل مبین در مژه‌های دراز",
      "CoupletIndex": 28,
      "SectionIndex1": 37,
      "SectionIndex2": 26
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "کان مژه در سینه چو کاوش کند",
      "CoupletIndex": 29,
      "SectionIndex1": 37,
      "SectionIndex2": 27
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "خون دل از دیده تراوش کند",
      "CoupletIndex": 29,
      "SectionIndex1": 37,
      "SectionIndex2": 27
    },
    {
      "VOrder": 60,
      "Position": "Right",
      "Text": "رویِ بتان گرچه سراسر خوش است",
      "CoupletIndex": 30,
      "SectionIndex1": 37,
      "SectionIndex2": 28
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "کشتهٔ آنیم که عاشق کش است",
      "CoupletIndex": 30,
      "SectionIndex1": 37,
      "SectionIndex2": 28
    },
    {
      "VOrder": 62,
      "Position": "Right",
      "Text": "هر بتِ رعنا که جباکیش تر",
      "CoupletIndex": 31,
      "SectionIndex1": 37,
      "SectionIndex2": 29
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "میلِ دل ما سوی او بیشتر",
      "CoupletIndex": 31,
      "SectionIndex1": 37,
      "SectionIndex2": 29
    },
    {
      "VOrder": 64,
      "Position": "Right",
      "Text": "سوزش و تلخی است غرض از شراب",
      "CoupletIndex": 32,
      "SectionIndex1": 37,
      "SectionIndex2": 30
    },
    {
      "VOrder": 65,
      "Position": "Left",
      "Text": "ورنه به شیرینی ازو خوشتر آب",
      "CoupletIndex": 32,
      "SectionIndex1": 37,
      "SectionIndex2": 30
    },
    {
      "VOrder": 66,
      "Position": "Right",
      "Text": "یار گرفتم که به خوبی پری است",
      "CoupletIndex": 33,
      "SectionIndex1": 37,
      "SectionIndex2": 31
    },
    {
      "VOrder": 67,
      "Position": "Left",
      "Text": "سوختن او نمکِ دلبری است",
      "CoupletIndex": 33,
      "SectionIndex1": 37,
      "SectionIndex2": 31
    },
    {
      "VOrder": 68,
      "Position": "Right",
      "Text": "ناله ز بی درد نباشد پسند",
      "CoupletIndex": 34,
      "SectionIndex1": 37,
      "SectionIndex2": 32
    },
    {
      "VOrder": 69,
      "Position": "Left",
      "Text": "چند دل و دین چو نه‌ای دردمند",
      "CoupletIndex": 34,
      "SectionIndex1": 37,
      "SectionIndex2": 32
    },
    {
      "VOrder": 70,
      "Position": "Right",
      "Text": "یا منگر سویِ بتان تیز تیز",
      "CoupletIndex": 35,
      "SectionIndex1": 37,
      "SectionIndex2": 33
    },
    {
      "VOrder": 71,
      "Position": "Left",
      "Text": "یا قدمِ دل مکش از رستخیز",
      "CoupletIndex": 35,
      "SectionIndex1": 37,
      "SectionIndex2": 33
    },
    {
      "VOrder": 72,
      "Position": "Right",
      "Text": "لاله رخان گرچه که داغ دلند",
      "CoupletIndex": 36,
      "SectionIndex1": 37,
      "SectionIndex2": 34
    },
    {
      "VOrder": 73,
      "Position": "Left",
      "Text": "روشنیِ چشم و چراغ دلند",
      "CoupletIndex": 36,
      "SectionIndex1": 37,
      "SectionIndex2": 34
    },
    {
      "VOrder": 74,
      "Position": "Right",
      "Text": "مهر و جفا کاریشان دلفروز",
      "CoupletIndex": 37,
      "SectionIndex1": 37,
      "SectionIndex2": 35
    },
    {
      "VOrder": 75,
      "Position": "Left",
      "Text": "دیدن و نادیدنشان سینه سوز",
      "CoupletIndex": 37,
      "SectionIndex1": 37,
      "SectionIndex2": 35
    },
    {
      "VOrder": 76,
      "Position": "Right",
      "Text": "حسن چه دل بود که دادش نداد",
      "CoupletIndex": 38,
      "SectionIndex1": 37,
      "SectionIndex2": 36
    },
    {
      "VOrder": 77,
      "Position": "Left",
      "Text": "عشق چه تقوی که به بادش نداد",
      "CoupletIndex": 38,
      "SectionIndex1": 37,
      "SectionIndex2": 36
    }
  ]
}
