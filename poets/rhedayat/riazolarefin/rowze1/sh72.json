      "CoupletIndex": 13,
      "SectionIndex1": 30,
      "SectionIndex2": 10
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "من نقطهٔ حرف بر سر حرف زدم",
      "CoupletIndex": 14,
      "SectionIndex1": 30,
      "SectionIndex2": 11
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "بگشاد در حرف و شدم بر سر حرف",
      "CoupletIndex": 14,
      "SectionIndex1": 30,
      "SectionIndex2": 11
    },
    {
      "VOrder": 27,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 15
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "گر با غم عشق سازگار آید دل",
      "CoupletIndex": 16,
      "SectionIndex1": 29,
      "SectionIndex2": 12
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "بر مرکب آرزو سوار آید دل",
      "CoupletIndex": 16,
      "SectionIndex1": 29,
      "SectionIndex2": 12
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "گر دل نبود کجا وطن سازد عشق",
      "CoupletIndex": 17,
      "SectionIndex1": 29,
      "SectionIndex2": 13
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "ور عشق نباشد به چه کار آید دل",
      "CoupletIndex": 17,
      "SectionIndex1": 29,
      "SectionIndex2": 13
    },
    {
      "VOrder": 32,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 18
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "در دل ز فراق خستگی‌ها دارم",
      "CoupletIndex": 19,
      "SectionIndex1": 28,
      "SectionIndex2": 14
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "در کار ز چرخ بستگی‌ها دارم",
      "CoupletIndex": 19,
      "SectionIndex1": 28,
      "SectionIndex2": 14
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "با این همه غم تو نیز پیمان وفا",
      "CoupletIndex": 20,
      "SectionIndex1": 28,
      "SectionIndex2": 15
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "مشکن که جز این شکستگی‌ها دارم",
      "CoupletIndex": 20,
      "SectionIndex1": 28,
      "SectionIndex2": 15
    },
    {
      "VOrder": 37,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 21
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "حق جان جهان است و جهان جمله بدن",
      "CoupletIndex": 22,
      "SectionIndex1": 27,
      "SectionIndex2": 16
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "افلاک و لطایف و حواس آمد تن",
      "CoupletIndex": 22,
      "SectionIndex1": 27,
      "SectionIndex2": 16
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "افلاک و عناصر و موالید اعضا",
      "CoupletIndex": 23,
      "SectionIndex1": 27,
      "SectionIndex2": 17
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "توحید همین است و دگرها همه فن",
      "CoupletIndex": 23,
      "SectionIndex1": 27,
      "SectionIndex2": 17
    },
    {
      "VOrder": 42,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 24
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "خورشید حق است و هر دو عالم سایه",
      "CoupletIndex": 25,
      "SectionIndex1": 26,
      "SectionIndex2": 18
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "آن سایه که نور باشد آن را مایه",
      "CoupletIndex": 25,
      "SectionIndex1": 26,
      "SectionIndex2": 18
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "افتاده ز پای ما و او بر سر ما",
      "CoupletIndex": 26,
      "SectionIndex1": 26,
      "SectionIndex2": 19
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "ما غایب ازو و او به ما همسایه",
      "CoupletIndex": 26,
      "SectionIndex1": 26,
      "SectionIndex2": 19
    },
    {
      "VOrder": 47,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 27
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "گر عین خدا به خویش مقرون بینی",
      "CoupletIndex": 28,
      "SectionIndex1": 25,
      "SectionIndex2": 20
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "در کل جهان خدای بی چون بینی",
      "CoupletIndex": 28,
      "SectionIndex1": 25,
      "SectionIndex2": 20
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "چون کل جهان آینهٔ کل خداست",
      "CoupletIndex": 29,
      "SectionIndex1": 25,
      "SectionIndex2": 21
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "در کل جهان غیر خدا چون بینی",
      "CoupletIndex": 29,
      "SectionIndex1": 25,
      "SectionIndex2": 21
    },
    {
      "VOrder": 52,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 30
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "یا رَاحةَ بَهْجَتی وَنورَ بَصَری",
      "CoupletIndex": 31,
      "SectionIndex1": 24,
      "SectionIndex2": 22
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "اِستَیْقَظَ قَلْبی بِکَ وَقْتَ سَحَری",
      "CoupletIndex": 31,
      "SectionIndex1": 24,
      "SectionIndex2": 22
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "ناجَیْتُ ضَمیرَ خاطِری یا قَمَرِی",
      "CoupletIndex": 32,
      "SectionIndex1": 24,
      "SectionIndex2": 23
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "إِنِّی َأَنافِیْکَ وَأَنْتَ لی فی نَظَری",
      "CoupletIndex": 32,
      "SectionIndex1": 24,
      "SectionIndex2": 23
    }
  ]
}
