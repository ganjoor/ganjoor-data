      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Right",
      "Text": "به مصر وجود آن زمان آمدم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Left",
      "Text": "که با یوسفِ جان زلیخا نبود",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "فرشته مرا سجده آن روز کرد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "که با آدم ای خواجه حوا نبود",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "من آن دم دم از زندگی می‌زدم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "که در نفس مریم مسیحا نبود",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "سخن گفت موسیِ ما با خدا",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "زمانی که گوینده پیدا نبود",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Right",
      "Text": "چرا دیده‌ام نقش اشیا در او",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Left",
      "Text": "چو در ذات اونقش اشیا نبود",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "خدا را از آن می‌پرستد خدا",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "که علم پرستیدن از ما نبود",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Comment",
      "Text": "و له ایضاً"
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "نور رخت افتاد شبی در دل منصور",
      "CoupletIndex": 8,
      "SectionIndex1": 16,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "فریاد اناالحق ز سموات برآمد",
      "CoupletIndex": 8,
      "SectionIndex1": 16,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "در صومعه تا زمزمهٔ عشق تو افتاد",
      "CoupletIndex": 9,
      "SectionIndex1": 16,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "صوفی چو من از توبه و طامات برآمد",
      "CoupletIndex": 9,
      "SectionIndex1": 16,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 10
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "چنان نهفته‌ام اسرار عشقت اندر دل",
      "CoupletIndex": 11,
      "SectionIndex1": 15,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "که ازدلم به زبانم نمی‌رسد آواز",
      "CoupletIndex": 11,
      "SectionIndex1": 15,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "خورشید ازل بتافت از روزن تن",
      "CoupletIndex": 13,
      "SectionIndex1": 14,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "تا چهرهٔ خود ببیند اندر روزن",
      "CoupletIndex": 13,
      "SectionIndex1": 14,
      "SectionIndex2": 12
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "گوید که چو روزن ز میان برخیزد",
      "CoupletIndex": 14,
      "SectionIndex1": 14,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "من باشم و من باشم و من باشم و من",
      "CoupletIndex": 14,
      "SectionIndex1": 14,
      "SectionIndex2": 13
    }
  ]
}
