    {
      "VOrder": 5,
      "Position": "Left",
      "Text": "غازی چو تویی رواست کافر بودن",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Paragraph",
      "Text": "غرض، وی مرید شیخ رکن الدین سجاسی بوده و اوحدی مراغه‌ای و فخر الدین عراقی همدانی در چله خانهٔ او آسوده. مثنوی مصباح الارواح از اوست. وفاتش در سنهٔ ۵۳۶ این چند بیت از مثنوی و اشعار او انتخاب و تبرکاً در این سفینه ثبت افتاد. مِنْمثنوی مصباح الارواح:",
      "CoupletIndex": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "تا جنبش دست هست مادام",
      "CoupletIndex": 4,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "سایه متحرک است ناکام",
      "CoupletIndex": 4,
      "SectionIndex1": 1,
      "SectionIndex2": 3
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "چون سایه ز دست یافت مایه",
      "CoupletIndex": 5,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "پس نیست خود اندر اصل سایه",
      "CoupletIndex": 5,
      "SectionIndex1": 1,
      "SectionIndex2": 4
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "چیزی که وجود او به خود نیست",
      "CoupletIndex": 6,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "هستیش نهادن از خرد نیست",
      "CoupletIndex": 6,
      "SectionIndex1": 1,
      "SectionIndex2": 5
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "هست است ولیک هست مطلق",
      "CoupletIndex": 7,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "نزدیک حکیم نیست جز حق",
      "CoupletIndex": 7,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "هستی که به حق قوام دارد",
      "CoupletIndex": 8,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "او نیست ولیک نام دارد",
      "CoupletIndex": 8,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "برنقش خود است فتنه نقاش",
      "CoupletIndex": 9,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "کس نیست درین میان تو خوش باش",
      "CoupletIndex": 9,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "خود گفت و حقیقت خود اشنید",
      "CoupletIndex": 10,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "آن روی که خود نمود خود دید",
      "CoupletIndex": 10,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "پس باد یقین که نیست واللّه",
      "CoupletIndex": 11,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "موجود حقیقی سوی اللّه",
      "CoupletIndex": 11,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 23,
      "Position": "Comment",
      "Text": "رباعیات"
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "جز نیستی تو نیست هستی به خدا",
      "CoupletIndex": 12,
      "SectionIndex1": 34,
      "SectionIndex2": 11
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "ای هشیاران خوش است مستی به خدا",
      "CoupletIndex": 12,
      "SectionIndex1": 34,
      "SectionIndex2": 11
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "گر زانکه بتی بحق، پرستی روزی",
      "CoupletIndex": 13,
      "SectionIndex1": 34,
      "SectionIndex2": 12
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "حقا که رسی ز بت پرستی به خدا",
      "CoupletIndex": 13,
      "SectionIndex1": 34,
      "SectionIndex2": 12
    },
    {
      "VOrder": 28,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "چشمی دارم همه پر از صورت دوست",
      "CoupletIndex": 15,
      "SectionIndex1": 33,
      "SectionIndex2": 13
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "بادیده مرا خوش است چون دوست دروست",
      "CoupletIndex": 15,
      "SectionIndex1": 33,
      "SectionIndex2": 13
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "از دیده و دوست فرق کردن نه نکوست",
      "CoupletIndex": 16,
      "SectionIndex1": 33,
      "SectionIndex2": 14
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "یا اوست درون دیده یا دیده خود اوست",
      "CoupletIndex": 16,
      "SectionIndex1": 33,
      "SectionIndex2": 14
    },
    {
      "VOrder": 33,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 17
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "اوحد دیدی که هرچه دیدی هیچ است",
      "CoupletIndex": 18,
      "SectionIndex1": 32,
      "SectionIndex2": 15
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "هر چیز که گفتی و شنیدی هیچ است",
      "CoupletIndex": 18,
      "SectionIndex1": 32,
      "SectionIndex2": 15
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "سرتاسر آفاق دویدی هیچ است",
      "CoupletIndex": 19,
      "SectionIndex1": 32,
      "SectionIndex2": 16
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "این هم به گوشه‌ای خزیدی هیچ است",
      "CoupletIndex": 19,
      "SectionIndex1": 32,
      "SectionIndex2": 16
    },
    {
      "VOrder": 38,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "زان می‌نگرم به چشم سر در صورت",
      "CoupletIndex": 21,
      "SectionIndex1": 31,
      "SectionIndex2": 17
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "زیرا که ز معنی است اثر در صورت",
      "CoupletIndex": 21,
      "SectionIndex1": 31,
      "SectionIndex2": 17
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "این عالم صورت است و ما در صوریم",
      "CoupletIndex": 22,
      "SectionIndex1": 31,
      "SectionIndex2": 18
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "معنی نتوان دید مگر در صورت",
      "CoupletIndex": 22,
      "SectionIndex1": 31,
      "SectionIndex2": 18
    },
    {
      "VOrder": 43,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 23
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "در مدرسه‌ها جواب گفتارم نیست",
      "CoupletIndex": 24,
      "SectionIndex1": 30,
      "SectionIndex2": 19
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "در بتکده‌ها صلیب و زنارم نیست",
      "CoupletIndex": 24,
      "SectionIndex1": 30,
      "SectionIndex2": 19
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "سرتاسر آفاق به هیچم نخرند",
      "CoupletIndex": 25,
      "SectionIndex1": 30,
      "SectionIndex2": 20
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "یا رب چه متاعم که خریدارم نیست",
      "CoupletIndex": 25,
      "SectionIndex1": 30,
      "SectionIndex2": 20
    },
    {
      "VOrder": 48,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 26
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "اسرار حقیقت نشود حل به سؤال",
      "CoupletIndex": 27,
      "SectionIndex1": 29,
      "SectionIndex2": 21
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "نی نیز به در یافتن حشمت و مال",
      "CoupletIndex": 27,
      "SectionIndex1": 29,
      "SectionIndex2": 21
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "تا دیده و دل خون نکنی پنجه سال",
      "CoupletIndex": 28,
      "SectionIndex1": 29,
      "SectionIndex2": 22
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "هرگز ندهند راهت از قال به حال",
      "CoupletIndex": 28,
      "SectionIndex1": 29,
      "SectionIndex2": 22
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "دل مغز حقیقت است تن پوست ببین",
      "CoupletIndex": 29,
      "SectionIndex1": 28,
      "SectionIndex2": 23
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "در کسوت پوست صورت دوست ببین",
      "CoupletIndex": 29,
      "SectionIndex1": 28,
      "SectionIndex2": 23
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "هر چیز که آن نشان هستی دارد",
      "CoupletIndex": 30,
      "SectionIndex1": 28,
      "SectionIndex2": 24
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "یا پرتو روی اوست یا اوست ببین",
      "CoupletIndex": 30,
      "SectionIndex1": 28,
      "SectionIndex2": 24
    },
    {
      "VOrder": 57,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 31
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "اوحد در دل می‌زنی آخر دل کو",
      "CoupletIndex": 32,
      "SectionIndex1": 27,
      "SectionIndex2": 25
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "عمری است که راه می‌روی منزل کو",
      "CoupletIndex": 32,
      "SectionIndex1": 27,
      "SectionIndex2": 25
    },
    {
      "VOrder": 60,
      "Position": "Right",
      "Text": "تا کی گویی ز خلوت و خلوتیان",
      "CoupletIndex": 33,
      "SectionIndex1": 27,
      "SectionIndex2": 26
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "هفتاد و دو چله داشتی حاصل کو",
      "CoupletIndex": 33,
      "SectionIndex1": 27,
      "SectionIndex2": 26
    }
  ]
}
