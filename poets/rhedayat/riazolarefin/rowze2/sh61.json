      "VOrder": 5,
      "Position": "Right",
      "Text": "مگشای لب به خنده که تو خفته‌ای از آنک",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "در خواب خنده موجب دلتنگی وبکاست",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "مشکل تر آن که گر به مثل دور روزگار",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "روزی دو مهلتی دهدت گویی این بقاست",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "چون طینتت ز حسرت و محنت سرشته‌اند",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "گر بر تو وحش و طیر بگریند هم رواست",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "نی نی کزین میانه تو مخصوص نیستی",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "بر هر که بنگری به همین درد مبتلاست",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "این آسمان که جوهر علویست نام آن",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "بنگر چگونه قامتش از بار غم دوتاست",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "خورشید را که مردمک چشمِ عالم است",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "تر دامنی ابر سیه مانع ضیاست",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "گردون خلاف عنصر و ظلمت نقیض نور",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "آتش عدوی خاک و زمین دشمن هواست",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "از سنگ گریه بین و مگو آن ترشح است",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "از کوه ناله بین و مپندار کان صداست",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "دریا فتاده در تب لرز است روز و شب",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "طعم دهان و گونهٔ رویش برین گواست",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "پیلِ تمام خلقت محکم نهاد را",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "از نیش پشه غصّهٔ بی حد و منتهاست",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "شیر ژیان که لاف ز سر پنجه می‌زند",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "از دست مور در کف صد محنت و بلاست",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "کبک دری که قهقههٔ شوق می‌زند",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "آسیب قهر پنجهٔ شاهینش از قفاست",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "وین آدمی که زبدهٔ ارکانش می‌نهند",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "پیوسته در کشاکش این چار اژدهاست",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "عقل است بر سر آمده از کاینات داد",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "هم پایمال شهوت و هم دستخوش هواست",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Comment",
      "Text": "و له ایضاً"
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "بکوش تا به سلامت به مأمنی برسی",
      "CoupletIndex": 16,
      "SectionIndex1": 28,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "که راه، سخت مخوف است و منزلت بس دور",
      "CoupletIndex": 16,
      "SectionIndex1": 28,
      "SectionIndex2": 17
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "ترا مسافت دور و دراز در پیش است",
      "CoupletIndex": 17,
      "SectionIndex1": 28,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "ز آستان عدم تا به پیشگاه نشور",
      "CoupletIndex": 17,
      "SectionIndex1": 28,
      "SectionIndex2": 18
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "تو درمیان گروهی غریب مهمانی",
      "CoupletIndex": 18,
      "SectionIndex1": 28,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "چنان مکن که به یک بارگی کنند نفور",
      "CoupletIndex": 18,
      "SectionIndex1": 28,
      "SectionIndex2": 19
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "کناغ چند ضعیفی به خون دل بتند",
      "CoupletIndex": 19,
      "SectionIndex1": 28,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "به مجمع آری کاین اطلس است و آن سیفور",
      "CoupletIndex": 19,
      "SectionIndex1": 28,
      "SectionIndex2": 20
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "ز کرم مرده کفن درکشی و درپوشی",
      "CoupletIndex": 20,
      "SectionIndex1": 28,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "میان اهل مروت که داردت معذور",
      "CoupletIndex": 20,
      "SectionIndex1": 28,
      "SectionIndex2": 21
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "به دشت جانوری خار می‌خورد غافل",
      "CoupletIndex": 21,
      "SectionIndex1": 28,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "تو تیز کرده‌ای از بهر صلب آن ساطور",
      "CoupletIndex": 21,
      "SectionIndex1": 28,
      "SectionIndex2": 22
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "بدان طمع که دهان خوش کنی ز غایت حرص",
      "CoupletIndex": 22,
      "SectionIndex1": 28,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "نشسته‌ای مترصد که قی کند زنبور",
      "CoupletIndex": 22,
      "SectionIndex1": 28,
      "SectionIndex2": 23
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "به باده دست میالای کان همه خونیست",
      "CoupletIndex": 23,
      "SectionIndex1": 28,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "که قطره قطره چکیده است از دل انگور",
      "CoupletIndex": 23,
      "SectionIndex1": 28,
      "SectionIndex2": 24
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "به وقت صبح شود همچو روز معلومت",
      "CoupletIndex": 24,
      "SectionIndex1": 28,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "که با که باخته‌‌ای عشق در شب دیجور",
      "CoupletIndex": 24,
      "SectionIndex1": 28,
      "SectionIndex2": 25
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "دل مرا چو گریبان گرفت جذبهٔ حق",
      "CoupletIndex": 25,
      "SectionIndex1": 28,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "فشاند دامن همت ز خاکدان غرور",
      "CoupletIndex": 25,
      "SectionIndex1": 28,
      "SectionIndex2": 26
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "بشد ز خاطرم اندیشهٔ می و معشوق",
      "CoupletIndex": 26,
      "SectionIndex1": 28,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "برفت از سرم آواز بربط و طنبور",
      "CoupletIndex": 26,
      "SectionIndex1": 28,
      "SectionIndex2": 27
    }
  ]
}
