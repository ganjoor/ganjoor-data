      "VOrder": 47,
      "Position": "Left",
      "Text": "بی زحمت پا گِردِ جهان گردیدن",
      "CoupletIndex": 25,
      "SectionIndex1": 35,
      "SectionIndex2": 14
    },
    {
      "VOrder": 48,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 26
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "ای در طلب گره گشایی مرده",
      "CoupletIndex": 27,
      "SectionIndex1": 34,
      "SectionIndex2": 15
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "در وصل بزاده در جدایی مرده",
      "CoupletIndex": 27,
      "SectionIndex1": 34,
      "SectionIndex2": 15
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "ای در لبِ بحر و تشنه در خواب شده",
      "CoupletIndex": 28,
      "SectionIndex1": 34,
      "SectionIndex2": 16
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "ای بر سر گنج و وز گدایی مرده",
      "CoupletIndex": 28,
      "SectionIndex1": 34,
      "SectionIndex2": 16
    },
    {
      "VOrder": 53,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 29
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "ای آنکه خلاصهٔ چهار ارکانی",
      "CoupletIndex": 30,
      "SectionIndex1": 33,
      "SectionIndex2": 17
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "بشنو سخنی ز عالم روحانی",
      "CoupletIndex": 30,
      "SectionIndex1": 33,
      "SectionIndex2": 17
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "دیوی و ددی و ملکی انسانی",
      "CoupletIndex": 31,
      "SectionIndex1": 33,
      "SectionIndex2": 18
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "در تست هر آنچه غالب آیی آنی",
      "CoupletIndex": 31,
      "SectionIndex1": 33,
      "SectionIndex2": 18
    },
    {
      "VOrder": 58,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 32
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "از کبر مدار هیچ در سر هوسی",
      "CoupletIndex": 33,
      "SectionIndex1": 32,
      "SectionIndex2": 19
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "کز کبر به جایی نرسیده است کسی",
      "CoupletIndex": 33,
      "SectionIndex1": 32,
      "SectionIndex2": 19
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "چون زلفِ بتان شکستگی عادت کن",
      "CoupletIndex": 34,
      "SectionIndex1": 32,
      "SectionIndex2": 20
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "تا صید کنی هزار دل در نفسی",
      "CoupletIndex": 34,
      "SectionIndex1": 32,
      "SectionIndex2": 20
    },
    {
      "VOrder": 63,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 35
    },
    {
      "VOrder": 64,
      "Position": "Right",
      "Text": "ای نسخهٔ نامهٔ الهی که تویی",
      "CoupletIndex": 36,
      "SectionIndex1": 31,
      "SectionIndex2": 21
    },
    {
      "VOrder": 65,
      "Position": "Left",
      "Text": "وی آینهٔ جمال شاهی که تویی",
      "CoupletIndex": 36,
      "SectionIndex1": 31,
      "SectionIndex2": 21
    },
    {
      "VOrder": 66,
      "Position": "Right",
      "Text": "بیرون ز تو نیست هرچه در عالم هست",
      "CoupletIndex": 37,
      "SectionIndex1": 31,
      "SectionIndex2": 22
    },
    {
      "VOrder": 67,
      "Position": "Left",
      "Text": "از خود بطلب هر آنچه خواهی که تویی",
      "CoupletIndex": 37,
      "SectionIndex1": 31,
      "SectionIndex2": 22
    },
    {
      "VOrder": 68,
      "Position": "Paragraph",
      "Text": "٭٭٭",
      "CoupletIndex": 38
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "کم گوی به جز مصلحت خویش مگوی",
      "CoupletIndex": 39,
      "SectionIndex1": 30,
      "SectionIndex2": 23
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "چیزی که نپرسند تو خود پیش مگوی",
      "CoupletIndex": 39,
      "SectionIndex1": 30,
      "SectionIndex2": 23
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "گوشِ تو دو دادند و زبانِ تو یکی",
      "CoupletIndex": 40,
      "SectionIndex1": 30,
      "SectionIndex2": 24
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "یعنی که دو بشنو و یکی بیش مگوی",
      "CoupletIndex": 40,
      "SectionIndex1": 30,
      "SectionIndex2": 24
    }
  ]
}
