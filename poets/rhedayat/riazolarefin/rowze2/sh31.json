      "Text": "از حادثهٔ زمان ز آینده مترس",
      "CoupletIndex": 15,
      "SectionIndex1": 39,
      "SectionIndex2": 16
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "وز هرچه رسد چو نیست پاینده مترس",
      "CoupletIndex": 15,
      "SectionIndex1": 39,
      "SectionIndex2": 16
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "این یک دمِ نقد را به عشرت گذران",
      "CoupletIndex": 16,
      "SectionIndex1": 39,
      "SectionIndex2": 17
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "از رفته میندیش و ز آینده مترس",
      "CoupletIndex": 16,
      "SectionIndex1": 39,
      "SectionIndex2": 17
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "آنم که پدید گشتم از قدرتِ تو",
      "CoupletIndex": 17,
      "SectionIndex1": 38,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "پرورده شدم به ناز در نعمت تو",
      "CoupletIndex": 17,
      "SectionIndex1": 38,
      "SectionIndex2": 18
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "صد سال به امتحان گنه خواهم کرد",
      "CoupletIndex": 18,
      "SectionIndex1": 38,
      "SectionIndex2": 19
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "یا جرم من است بیش یا رحمت تو",
      "CoupletIndex": 18,
      "SectionIndex1": 38,
      "SectionIndex2": 19
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "یارب به دل اسیر من رحمت کن",
      "CoupletIndex": 19,
      "SectionIndex1": 37,
      "SectionIndex2": 20
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "بر خاطر غم پذیرِ من رحمت کن",
      "CoupletIndex": 19,
      "SectionIndex1": 37,
      "SectionIndex2": 20
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "بر پایِ خرابات روِ من بخشای",
      "CoupletIndex": 20,
      "SectionIndex1": 37,
      "SectionIndex2": 21
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "بر دستِ پیاله گیر من رحمت کن",
      "CoupletIndex": 20,
      "SectionIndex1": 37,
      "SectionIndex2": 21
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "برخیز و مخور غم جهانِ گذران",
      "CoupletIndex": 21,
      "SectionIndex1": 36,
      "SectionIndex2": 22
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "بنشین و جهان به شادمانی گذران",
      "CoupletIndex": 21,
      "SectionIndex1": 36,
      "SectionIndex2": 22
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "در طبع جهان اگر وفایی بودی",
      "CoupletIndex": 22,
      "SectionIndex1": 36,
      "SectionIndex2": 23
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "نوبت به تو خود نیامدی از دگران",
      "CoupletIndex": 22,
      "SectionIndex1": 36,
      "SectionIndex2": 23
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "از تن چو رود، روانِ پاکِ من و تو",
      "CoupletIndex": 23,
      "SectionIndex1": 51,
      "SectionIndex2": 24
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "خشتی دو نهند بر مغاک من و تو",
      "CoupletIndex": 23,
      "SectionIndex1": 51,
      "SectionIndex2": 24
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "وانگاه برای خشتِ گور دگران",
      "CoupletIndex": 24,
      "SectionIndex1": 51,
      "SectionIndex2": 25
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "در کالبدی کشند خاک من و تو",
      "CoupletIndex": 24,
      "SectionIndex1": 51,
      "SectionIndex2": 25
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "ناکرده گناه در جهان کیست بگو",
      "CoupletIndex": 25,
      "SectionIndex1": 50,
      "SectionIndex2": 26
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "وان کس که گنه نکرد چون زیست بگو",
      "CoupletIndex": 25,
      "SectionIndex1": 50,
      "SectionIndex2": 26
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "من بد کنم و تو بد مکافات کنی",
      "CoupletIndex": 26,
      "SectionIndex1": 50,
      "SectionIndex2": 27
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "پس فرق میان من و تو چیست بگو",
      "CoupletIndex": 26,
      "SectionIndex1": 50,
      "SectionIndex2": 27
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "تا کی غم این خورم که دارم یا نه",
      "CoupletIndex": 27,
      "SectionIndex1": 49,
      "SectionIndex2": 28
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "وین عمر به خوش دلی گذارم یا نه",
      "CoupletIndex": 27,
      "SectionIndex1": 49,
      "SectionIndex2": 28
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "در ده قدح باده که معلومم نیست",
      "CoupletIndex": 28,
      "SectionIndex1": 49,
      "SectionIndex2": 29
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "کاین دم که فرو برم بر آرم یا نه",
      "CoupletIndex": 28,
      "SectionIndex1": 49,
      "SectionIndex2": 29
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "دانی ز چه روی اوفتاده است و چه راه",
      "CoupletIndex": 29,
      "SectionIndex1": 48,
      "SectionIndex2": 30
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "آزادی سرو و سوسن اندر افواه",
      "CoupletIndex": 29,
      "SectionIndex1": 48,
      "SectionIndex2": 30
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "کاین دارد صد زبان ولیکن خاموش",
      "CoupletIndex": 30,
      "SectionIndex1": 48,
      "SectionIndex2": 31
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "وان دارد صد دست ولیکن کوتاه",
      "CoupletIndex": 30,
      "SectionIndex1": 48,
      "SectionIndex2": 31
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "افتاده مرا با می و مستی کاری",
      "CoupletIndex": 31,
      "SectionIndex1": 47,
      "SectionIndex2": 32
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "ما را ز چه می‌کنی ملامت باری",
      "CoupletIndex": 31,
      "SectionIndex1": 47,
      "SectionIndex2": 32
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "ای کاش که هر حرام مستی دادی",
      "CoupletIndex": 32,
      "SectionIndex1": 47,
      "SectionIndex2": 33
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "تا من به جهان ندیدمی هشیاری",
      "CoupletIndex": 32,
      "SectionIndex1": 47,
      "SectionIndex2": 33
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "آدم چو صراحی بود و روح چو می",
      "CoupletIndex": 33,
      "SectionIndex1": 46,
      "SectionIndex2": 34
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "قالب چو نیی بود صدایی در نی",
      "CoupletIndex": 33,
      "SectionIndex1": 46,
      "SectionIndex2": 34
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "دانی چه بود آدمی خاکی خیام",
      "CoupletIndex": 34,
      "SectionIndex1": 46,
      "SectionIndex2": 35
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "فانوس خیالی و چراغی در وی",
      "CoupletIndex": 34,
      "SectionIndex1": 46,
      "SectionIndex2": 35
    }
  ]
}
