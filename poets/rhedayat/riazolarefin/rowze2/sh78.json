    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Paragraph",
      "Text": "وهُوَ ابوعبداللّه محمدبن حسن القرشی التمیمی البکری. ازمعارف فضلا و حکماست و در فنون علوم قدرت داشته. تصانیف بسیار دارد و به امام المتکلمین مشهور شده و اکثر عارفین در وی طعن کرده‌اند. مفصلِّ احوال وی در کتب ثبت است. ولادتش در سنهٔ ۵۴۴، وفاتش در سنهٔ ۶۰۶. این اشعار منسوب به اوست و قلمی می‌شود:",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Comment",
      "Text": "عربیه"
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "نِهایَةُ إقْدامِ الْعُقُولِ عِقْالُ",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "وَأَکْثَرُ سَعْی العالَمینَ ضَلالُ",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "وَکَمْرَأَیْنَا مِنْرِجالٍ وَدَوْلَةٍ",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "فَبَادُوا جَمِیْعاً مُسْرِعیْنَ وَزَالُوا",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "وَکَمْمِنْجِبالٍ قَدْعَلَتْشُرُفَاتِها",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "وِعالٌ فَزَالُوا وَالْجِبالُ جِبالُ",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "وَأَرْواحُنَا فِی وَحْشَةٍ مِنْجُسُومِنا",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "وَحاصِلُ دُنْیانَآ إَذیَّ وَوَبالُ",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "وَلَمْنَسْتَفِدْمِنْبَحْثِنا طُوُلَ عُمْرِنا",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "سِوَی اَنْجَمْعَنا فِیْهِ قِیْلٌ وَقَالُ",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Comment",
      "Text": "رباعیات"
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "هرجا که زمهرت اثری افتاده است",
      "CoupletIndex": 6,
      "SectionIndex1": 18,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "سودازده‌ای بر گذری افتاده است",
      "CoupletIndex": 6,
      "SectionIndex1": 18,
      "SectionIndex2": 7
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "در وصلِ تو کی توان رسیدن کانجا",
      "CoupletIndex": 7,
      "SectionIndex1": 18,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "هرجا که نهی پای سری افتاده است",
      "CoupletIndex": 7,
      "SectionIndex1": 18,
      "SectionIndex2": 8
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "کنه خردم در خور اثبات تو نیست",
      "CoupletIndex": 8,
      "SectionIndex1": 17,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "و آرامش جان بجز مناجات تونیست",
      "CoupletIndex": 8,
      "SectionIndex1": 17,
      "SectionIndex2": 9
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "من ذات ترا به واجبی کی دانم",
      "CoupletIndex": 9,
      "SectionIndex1": 17,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "دانندهٔ ذاتِ تو بجز ذاتِّ تو نیست",
      "CoupletIndex": 9,
      "SectionIndex1": 17,
      "SectionIndex2": 10
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "هرگز دل من ز علم محروم نشد",
      "CoupletIndex": 10,
      "SectionIndex1": 16,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "کم ماند ز اسرار که معلوم نشد",
      "CoupletIndex": 10,
      "SectionIndex1": 16,
      "SectionIndex2": 11
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "هفتاد و دو سال فکر کردم شب و روز",
      "CoupletIndex": 11,
      "SectionIndex1": 16,
      "SectionIndex2": 12
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "معلومم شد که هیچ معلوم نشد",
      "CoupletIndex": 11,
      "SectionIndex1": 16,
      "SectionIndex2": 12
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "ترسم بروم عالم جان نادیده",
      "CoupletIndex": 12,
      "SectionIndex1": 15,
      "SectionIndex2": 13
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "بیرون شوم از جهان جهان نادیده",
      "CoupletIndex": 12,
      "SectionIndex1": 15,
      "SectionIndex2": 13
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "در عالم جان چون روم از عالم تن",
      "CoupletIndex": 13,
      "SectionIndex1": 15,
      "SectionIndex2": 14
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "در عالم تن عالم جان نادیده",
      "CoupletIndex": 13,
