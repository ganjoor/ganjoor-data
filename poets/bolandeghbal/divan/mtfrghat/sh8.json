      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "حلقه حلقه شکن شکن خم خم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "از بر دوش تا به زانوئی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "زنخ یار گوئی از سیم است",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "توچوچوگان به پیش او گوئی",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "بی قراری به روی یار چرا",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "گرنه آشفته رخ اوئی",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "تا بسنجی وفا ومهر مرا",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "شده آونگ چون ترازوئی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "لام برچهره می کشد هندو",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "شکل لا می توگر چه هندوئی",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "با وجودی که بوی مشک تو راست",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "بر دل ریش نوشداروئی",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "روزم از تیره شب سیاه تر است",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "زآنکه دایم حجاب آن روئی",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "هرکه در بند بیندت گوید",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "که چودزدان بسته باروئی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "کرده ای جا به دوش یار مگر",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "مار ضحاک دوش جادوئی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "آفتاب است زیر سایه تو",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "مر چو منشاه را ثنا گوئی",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 29,
      "Position": "CenteredVerse1",
      "Text": "شیریزدان امیر اژدر در",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "SectionIndex3": 4
    },
    {
      "VOrder": 30,
      "Position": "CenteredVerse2",
      "Text": "شافع حشر خواجه قنبر",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "SectionIndex3": 4
    }
  ]
}
