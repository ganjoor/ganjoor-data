  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "خری باخری گفت در زیر بار",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "که آسودگی نیست در روزگار",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "به ما صاحب ار می دهدکاه وجو",
