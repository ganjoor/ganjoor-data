      "Text": "بر عدد روزگار روزه یک امروز",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 15,
      "Position": "CenteredVerse1",
      "Text": "بخش مرا سی ایاغ می بتوالی",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "عقل من از خواب روز مجنون گردید",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "دل ز نشست شبم پر از خون گردید",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "روزم شب شد شرابم افیون گردید",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "راست شنو روزگار وارون گردید",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 20,
      "Position": "CenteredVerse1",
      "Text": "مسند ایام را گرفت لیالی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "ای تن تو خوبتر ز روح فرشته",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "گرد رخت حسن خط ناز نبشته",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "باز طرب را پدید شد سر رشته",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "خیز که اینک قضای عهد گذشته",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 25,
      "Position": "CenteredVerse1",
      "Text": "یک مه باید زدن شراب دو سالی",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "بزم رنود ار نداشت زمرمه نی",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "بود بمسجد اگر تهاجم لاشی",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "امروز آن کر و فر دگرگون شد هی",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "هرچه بگوئی کم است مجلس بی می",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 30,
      "Position": "CenteredVerse1",
      "Text": "آنچه بخواهی پر است مسجد خالی",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "موذن کازرد بر مناره گلورا",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "برد ز سر خواب خلق برز وکورا",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "صوتش سوزن نمود بر تن مورا",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "شکر که اکنون زرشک مطرب اورا",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 35,
      "Position": "CenteredVerse1",
      "Text": "گشته به لالی بدل زبان بلالی",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "باز زخردان گسست سلک بزرگان",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "جام میشان فتاد از تن گرگان",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "میکده گردید وقف عیش سترکان",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "یافت تبدل بفکر غمره ترکان",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 40,
      "Position": "CenteredVerse1",
      "Text": "ذکر ابوحمزه فرید ثمالی",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "شد فرح از چرخ بر زمین متراکم",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "هر طرف از عشرتی بپاست مراسم",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "صف زده اندر اسلام خواجه اعاظم",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "خواجه اعظم محمد بن القاسم",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 45,
      "Position": "CenteredVerse1",
      "Text": "آنکه ملقب بود زشاه بوالی",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "عرش محامد براق ران معارج",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "جان روافض هلاک جسم خوارج",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "مفخر دانشوران داخل و خارج",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "داده ز اقرانش ارتقای معارج",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 50,
      "Position": "CenteredVerse1",
      "Text": "عاطفت حق تبارک و تعالی",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "فاتح ابواب مغلقات مباحث",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "سد سدید سبیل سیل حوادث",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "تخت نیارا زمجد نعم الوارث",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "در برجاهش که هست عالم ثالث",
