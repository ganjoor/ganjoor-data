      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "ایکه زرایت بدام رای و نجاشی",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "عقل برهوشت از فطن بتحاشی",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "فتح و ظفر را بدوش از تو غواشی",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "بزم ترا آسمان مقیم حواشی",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 60,
      "Position": "CenteredVerse1",
      "Text": "کوی تو را بخت پاسبان حوالی",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "میرا بهر ملوک ازگهر وگنج",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "بی سخن شاعران نخیزد جز رنج",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "شعر بماند نه حکمرانی از گنج",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "خاصه چو من شاعری ادیب سخن سنج",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 65,
      "Position": "CenteredVerse1",
      "Text": "کامده ضرب المثل بنغزه مقالی",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 66,
      "Position": "Right",
      "Text": "پار در این بزم و این بساط و همین تخت",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 67,
      "Position": "Left",
      "Text": "سعدالملک آرمیده بود جوان بخت",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 68,
      "Position": "Right",
      "Text": "امروز از سست کار کرده و یا سخت",
      "CoupletIndex": 40,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 69,
      "Position": "Left",
      "Text": "شعر منش حاصل است نی زر و نی رخت",
      "CoupletIndex": 40,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 70,
      "Position": "CenteredVerse1",
      "Text": "زان همه اعتبار ملکی و مالی",
      "CoupletIndex": 41,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "هان چکنی تا بمن که دور تو باشد",
      "CoupletIndex": 42,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "گردش گیتی منوط شورتو باشد",
      "CoupletIndex": 42,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "شیر فلک سخره پیش ثور تو باشد",
      "CoupletIndex": 43,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "به که بما لطف و بذل طور تو باشد",
