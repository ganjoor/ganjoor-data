      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 75,
      "Position": "CenteredVerse1",
      "Text": "کت بستائیم درخجسته خصالی",
      "CoupletIndex": 44,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 76,
      "Position": "Right",
      "Text": "تا بفلک باشد از هلال علامت",
      "CoupletIndex": 45,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 77,
      "Position": "Left",
      "Text": "تا رمضانست ماه خیر و کرامت",
      "CoupletIndex": 45,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 78,
      "Position": "Right",
      "Text": "تاکه بشوال درخوشی است اقامت",
      "CoupletIndex": 46,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 79,
      "Position": "Left",
      "Text": "شادی بی یاد تو بدام ندامت",
      "CoupletIndex": 46,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 80,
      "Position": "CenteredVerse1",
      "Text": "صدر جدا از تو در شکنج لئالی",
      "CoupletIndex": 47,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    }
  ]
}
