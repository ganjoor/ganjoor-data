      "Position": "Left",
      "Text": "که همدم نافه ختن باشد؟",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "با لطف تو آب چون در آرد سر",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
