      "Position": "Left",
      "Text": "آرایش صدر و انجمن باشد",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "ایام کریم و عهد میمونت",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "تاریخ مفاخر زمن باشد",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
