  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ای عکس رخ جان دهد آیینه دل را",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: ای چهره تو جان میبخشد به دل و جان من، مانند معجزه عیسی!"
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "چون معجز عیسی!",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "طوطی شده حیران سخن‌های تو جانا",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: طوطی از زیبایی و جذابیت سخنان تو، ای جانان، حیرت‌زده و شگفت‌زده شده است؛ همانطور که لب‌های تو به خوبی و روشنی می‌گویند."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "با آن لب گویا!",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "تا با قد شمشاد گذشتی سوی گلشن",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: زمانی که تو با قامت باریک و زیبا همچون شمشاد از کنار او عبور کردی، به ناگاه قمری که در باغ نشسته بود، با صدای ناله و فریاد به اعتراض درآمد."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "قمری به فغان شد",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "نرگس پی نظاره شود دیده سراپا",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: چشم‌ها به تماشای نرگس دوخته شده‌اند و همه وجود انسان برای دیدن او آماده است."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "از بهر تماشا",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "از شرم جمال تو شده یوسف مصری",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: یوسف مصری به خاطر زیبایی تو آنقدر سرشکسته و خجالت‌زده شده که در گوشه چاه پنهان شده است."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "در زاویه چاه",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "سودای تو دارد به سر وامق و عذرا",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: در دل وامق و عذرا عشق تو نقش بسته است و تنها این دو نفر نیستند که در اندوه عشق تو به سر می‌برند، بلکه زلیخا نیز در این غم شریک است."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "تنها نه زلیخا!",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "پیراهن گل در چمن از شوق تو چاک است",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: پیراهن گلی که در چمن است به خاطر شوق تو پاره شده و این نشانه دوری و جدایی از چهره‌ات است."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "از فرقت رویت",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "خون بسته دل غنچه ز لعل تو همانا",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: دل غنچه به خاطر زیبایی و رنگ لبت مانند شراب در جام است."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "چون باده به مینا!",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "باد سحر از نکهت زلفت به گلستان",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: باد سحرگاهی عطر خوش زلف تو را به باغی پر از گل و گیاه می‌آورد."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "آورد نسیمی",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "سوسن به زبان طعنه زد آهوی خطا را",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: گل سوسن با زبانی کنایه‌آمیز به آهویی که اشتباه کرده بود، طعنه زد و سپس به سمت دشت رفت."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "زان رفت به صحرا",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "خضر خط تو داده به ریحان ادب ناز",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: خضر، که نماد دانش و راهنمایی است، زیبایی و لطافت نوشته‌های تو را به دل riحان که نشانی از ادب و ناز دارد، داده است و این زیبایی از قواعد و اصول خاصی پیروی می‌کند."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "از قاعده بو",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "در کشور خوبی نبود لاله‌عذارا",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: در سرزمینی که لاله‌عذرا وجود نداشت، کسی با شکوه و مقام تو نبود!"
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "چون تو شه والا!",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "تا لشکر حسن تو به تاراج ز هر سو",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: این بیت بیان می‌کند که لشکر زیبایی و حسن تو از هر سو به سمت من حمله‌ور شده و دل و جانم را تحت تأثیر قرار داده است."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "آورد شبیخون",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "چشم از پی جان بردن و رخ از پی یغما",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: چشم به دنبال جان و روح من است و چهره‌اش به دنبال دزدی قلبم."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "در ملک دل ما!",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "طغرل به خیال سر زلف تو اسیر است",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "CoupletSummary": "هوش مصنوعی: طغرل به خاطر تصور و خیال زیبایی های زلف تو در بند و اسیر شده و نمی‌تواند از آن رها شود."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "رستن نتواند",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "زنجیر بود هر سر مو پای جنون را",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17,
      "CoupletSummary": "هوش مصنوعی: هر قسمت از موی او مانند زنجیری است که پای جنون را به آن می‌بندد. این زلف زیبا و دلربا، سبب شگفتی و دیوانگی می‌شود."
    },
    {
      "VOrder": 32,
      "Position": "Left",
