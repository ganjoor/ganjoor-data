      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "در ملک دل ما!",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "طغرل به خیال سر زلف تو اسیر است",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
