      "Position": "Right",
      "Text": "بی شکی جز یکی نخواهد دید",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "دیده گر گرد دو سرا گردد",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "هر که با ما نشست در دریا",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "واقف از حال و ذوق ما گردد",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "بار اغیار بارها بکشد",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
