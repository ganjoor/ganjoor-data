      "SectionIndex1": 0
    },
    {
      "VOrder": 99,
      "Position": "Left",
      "Text": "خجل و شرمسار می‌بینم",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 100,
      "Position": "Right",
      "Text": "بر کف دست ساقی وحدت",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 101,
      "Position": "Left",
      "Text": "بادهٔ خوشگوار می‌بینم",
