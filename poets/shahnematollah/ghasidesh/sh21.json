    {
      "VOrder": 97,
      "Position": "Left",
      "Text": "همه را کامکار می‌بینم",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 98,
      "Position": "Right",
      "Text": "عاصیان از امام معصومم",
