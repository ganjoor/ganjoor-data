  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "چون رسول خدا به امر خدا",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "عزم فرمود تا به دار بقا",
