    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "فتنه قایل بعجز روباهی",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "همه صرف نوازش احباب",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چشمش همه را صرف نواختن دوستان می‌کند و تنها با بی‌میلی نگاه می‌کند؛ یعنی نگاهش به دیگران از سر اکراه است."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "نرگسش را نگاه اکراهی",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "دل و چشمم زروی او خجلند",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دل و چشم من در برابر روی او شرمنده‌اند؛ چشمم از اینکه اشک ندارد و دلم از اینکه آه ندارد."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "این زبی اشکی آن زبی آهی",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "کرده از باد دامنش در رقص",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: باد دامن او دود عودسوز را به رقص درآورده و آن را چون سماع درون خیمه به حرکت انداخته است."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "دود مجمر سماع خرگاهی",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "دامن افشاند بر تصرف دست",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: زلف آن ماه‌رو مانند دم ماهی که از دست می‌لغزد، از دست هر کس که بخواهد آن را بگیرد دامن می‌کشد و رها می‌شود."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "زلف آن ماه چون دم ماهی",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "روی او برگ لاله را گوید",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: روی سرخ او به برگ لاله طعنه می‌زند که از چه رنجی رنگت مانند کاه زرد شده است؛ یعنی لاله در برابر رخ او بی‌رنگ است."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "کز چه رنجست گونه‌ات کاهی",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "داد از آن زلف عنبرین که زند",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: فریاد از آن زلف خوشبو و سیاه که از بس بلند است، شب قدر را به کوتاهی طعنه می‌زند."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "بر شب قدر طعن کوتاهی",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "با چنین زلف می‌تواند بود",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آن معشوق با چنین زلفی می‌تواند جاروکش درگاه پادشاه پادشاهان باشد؛ و این گریز به مدح ممدوح است."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "خاکروب در شهنشاهی",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "شاه خیبر گشا که پنجهٔ اوست",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آن شاه، علی است که خیبر را گشود و دست او جلوه‌گاه قدرت دست خداست."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "مظهر قدرت یداللهی",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "آنکه ارشاد او برد بکنار",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: کسی است که راهنمایی‌اش عقل را از دریای گمراهی به ساحل نجات می‌رساند."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "عقل را از محیط گمراهی",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "بختها را بدل کند عونش",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: یاری او بخت‌ها را دگرگون می‌کند و ناتوانی پیری را به نیروی جوانی بدل می‌سازد."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "ضعف پیری بزور برناهی",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "جرم پوش است هرقدر کوشی",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر چه گناه کنی، گناهت را می‌پوشاند و هر چه بخواهی، آرزویت را برآورده می‌کند."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "کام بخش است هرقدر خواهی",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "دامن همتش نیالودست",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دامن همت بلند او هرگز به آرزوی مال و مقام آلوده نشده است."
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "بتمنای مالی و جاهی",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "سایلان درش فرو نارند",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: گدایان درگاه او از بلندهمتی سر به تاج پادشاهی فرود نمی‌آورند."
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "سر همت بافسر شاهی",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "ساکنان دیار حزمش را",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: کسانی که در قلمرو احتیاط و دوراندیشی او ساکن‌اند، با رغبت می‌گریند و با بی‌میلی می‌خندند؛ یعنی از غفلت و شادی بیهوده دورند."
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "گریه طوعی و خنده اکراهی",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "بحر لبیک را بجوش آرد",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دعای «یارب» سحرگاهی او دریای اجابت خداوند (لبیک) را به جوش می‌آورد؛ یعنی دعایش بی‌درنگ مستجاب می‌شود."
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "لبش از یارب سحرگاهی",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "عنکبوت دیار همت او",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: حتی عنکبوتِ سرزمین همت او چنان بلندهمت است که به ننگ بافندگی (تار تنیدن برای روزی) تن نمی‌دهد."
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "ندهد تن به ننگ جولاهی",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "گل روی ریاضتش را رنگ",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چهرهٔ او از ریاضت، از بیرون سرخ و درخشان چون لعل است و از درون، از رنج و زهد، زرد چون کاه."
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "از برون لعل وز درون کاهی",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "بر حریر تنش نشان حصیر",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اثر حصیری که بر تن لطیف و حریرمانند او نقش بسته، چنان زیباست که نقش‌های دیبا بر آن رشک می‌برند؛ اشاره به زهد و ساده‌زیستی علی (ع)."
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "رشک فرمای نقش دیباهی",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "صف اعداش بی‌نصیب از اصل",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: صف دشمنان او مانند سخنان دروغی که بر سر زبان‌هاست، بی‌اصل و بی‌ریشه است."
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "چون مقالات کذب افواهی",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "همتش چون درم نثار کند",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هنگامی که همت او درم نثار می‌کند، ماه آسمان از آن سکه‌ها چنان پر می‌شود که مانند ماهی پر از فلس (پولک) می‌گردد."
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "مه شود پر پشیزه چون ماهی",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "بی پیام نسیم روضهٔ او",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بی‌آنکه پیام نسیم باغ و آرامگاه او را که مایهٔ آگاهی دل است با خود داشته باشد،"
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "که بود مایهٔ دل آگاهی",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "از دیار سحر بکشور صبح",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: باد صبا، این پیک، از سرزمین سحر به کشور صبح راه نمی‌افتد؛ یعنی صبحدم و نسیم آن هم از فیض او مایه می‌گیرد."
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "نشود قاصد صبا راهی",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "از اثر اوفتاده بود مرا",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: گریه و نالهٔ سحرگاهی من بی‌اثر مانده بود."
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "گریه و نالهٔ سحرگاهی",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "مرقدش تا نکرد جلوه، نکرد",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تا آرامگاه او بر من جلوه نکرد، اشک من اشک واقعی و آه من آه کارگر نشد؛ زیارت او به گریه و آهم اثر بخشید."
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "اشک من اشکی، آه من، آهی",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "ای خدیوی که ترک صبح تراست",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای فرمانروایی که خورشید صبح (ترک صبح) یکی از بندگان درگاه توست."
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "یکی از بندگان درگاهی",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "اسداللهی و صلابت تو",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تو شیر خدایی و صلابت تو رنگ ستیز و دشمنی را از ترس زرد چون کاه کرد."
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "کرد رنگ ستیزه را کاهی",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "شیر گردون چو صولت بیند",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر برج اسد (شیر آسمان) هیبت و حملهٔ تو را ببیند، از لاف دلیری خود که در برابر تو چون روباه‌بازی است شرمسار می‌شود."
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "شرمش آید ز لاف روباهی",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "دل برون ننهد از طریق تو گام",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دل از راه تو بیرون نمی‌رود، چنان‌که از خضر که راهنمای راه است گمراهی دیده نمی‌شود."
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "که نیابد ز خضر گمراهی",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "تو مصیبی در اجتهاد امور",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تو در داوری و اجتهاد کارها همیشه به حق می‌رسی و دیگران همه خطاکار و غافل‌اند."
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "دیگران جمله مخطی و ساهی",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "هرچه جز وصف تو همه هذیان",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر سخنی جز وصف تو بیهوده‌گویی است و هر چیزی جز مدح تو سست و بی‌پایه است."
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "هرچه جز مدح تو همه واهی",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "بیشتر گردد و بدل شکند",
      "CoupletIndex": 40,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اندیشهٔ بدخواهی در دل حسود تو هرچه بیشتر شود، بیشتر دل خود او را می‌شکند و آزارش می‌دهد."
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "حاسدت را خیال بدخواهی",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "صرفهٔ جان بوادی شوقت",
      "CoupletIndex": 41,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دریغ‌کردن و نگه داشتن جان در بیابان شوق تو، نشانهٔ نادانی و گمراهی است؛ باید جان را در این راه فدا کرد."
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "رسم نادانی است و بیراهی",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "به هوس در ره غلامی تو",
      "CoupletIndex": 42,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: کسی از روی هوس در راه بندگی تو سر نمی‌بازد؛ آفرین بر آن زیرکی که آگاهانه سر می‌بازد."
    },
    {
      "VOrder": 86,
      "Position": "Left",
      "Text": "سر نبازد کسی زهی داهی",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "یاوصی النبی بدرگه خویش",
      "CoupletIndex": 43,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای جانشین پیامبر، این چهرهٔ زرد مرا به گرد درگاه خود برسان."
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "برسان گرد این رخ کاهی",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "خضر شوق توأم دلیل بس است",
      "CoupletIndex": 44,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: شوق تو برای من چون خضر راهنمایی بس است؛ به بخت بگو لازم نیست فال همراهی با من بزند."
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "گو مزن بخت فال همراهی",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
