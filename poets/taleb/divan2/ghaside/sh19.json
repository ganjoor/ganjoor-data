  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "سیل اشکم را بطوفان می‌زنم",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "قطره جوشان و خروشان می‌زنم",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "تا شود رنگین سرشکم هرنفس",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "ناخنی بر چشم گریان می‌زنم",
      "CoupletIndex": 1,
      "SectionIndex1": 0
