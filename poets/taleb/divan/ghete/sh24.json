      "SectionIndex2": 1
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "همیشه دست درآغوش افعی و اژدر",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "چو حکم فصد رسید از خرد بدین دستور",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "که شدت مرض از خون فاسدست اکثر",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "بهر رگم که زدی نوک نشتر فصاد",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "بجای خون همه سیماب تازه کردی سر",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "سپهر تامژه در موج شعله غوطه زدی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "اگر شدی جگرم بر هوا نفس گستر",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "سموم گشتی در ساعت از حرارت تب",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "اگر فکندی بر پیکرم نسیم گذر",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "بی‌علاج صداعم طبیب حل کردی",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "بدست شعله بر اطراف جبهه‌ام اخگر",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "گر آفتاب زدی فال دیدن نبضم",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "شدی انامل ناریش جمله خاکستر",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "برون زدی چو عرق از مسام تن گفتی",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "که چیده‌اند براندام تن بساط شرر",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "گرانی بدنم گر به بحر رو کردی",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "هزار کشتی سیار را شدی لنگر",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "گهی که لرز شبیخون زدی بر اندامم",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "زمین بزلزله کندی سپهر را محور",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "زبانگ العطش جان تشنه طبع غیور",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "زبان گزیدی و کردی گدائی کوثر",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "دماغ خشک چو امداد عطشدئی کردی",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "زمغز سوخته گشتی سیاه دامن تر",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "کشیدی از تف دل دیده‌ام رطوبت اشک",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "صدف ز تشنه‌لبی جذب کردی آب گهر",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "هزار شکر کز آن شعله های جانسوزم",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "نمانده غیر شراری بجسم خاکستر",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "ولی ضعیف چنانم که گر کشم آهی",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "شود مجزا غمنامهٔ تنم یکسر",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "لطیف گشتن اجزای تن چو بوی بهار",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "همیشه برحذرم دارد از نسیم سحر",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "تموجی که هواراست از نهایت ضعف",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "بشکل موجهٔ دریا در آیدم بنظر",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "ز بسکه بر جگرم گشته استخوان ظاهر",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "هما چو بیندم از دور تازدم برسر",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "یکی ببین بترحم تن نزارم را",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "که ضعف ساخته شریان نمای چون مسطر",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "ز خشکی نفسم در نوازدن گوئی",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "که نغمه های ترم را فشرده‌ئی یکسر",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "همین منم که ز مشت غبار فرق نبود",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "گرم فتادی صد کوه بیستون بر سر",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "کنون اگر فتدم برگ لالدئی برفرق",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "کشد همی سرم آسیب آهنین مغفر",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "سپهر اگر مددی میکنی کنون وقتست",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "که طاقتم شده از برگ لاله نازکتر",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 65,
      "Position": "CenteredVerse1",
      "Text": "نمانده قدرت بیمار خفتنم زین پس",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "SectionIndex3": 4
    },
    {
      "VOrder": 66,
      "Position": "CenteredVerse2",
      "Text": "ترحمی که شدم نقش بالش و بستر",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "SectionIndex3": 4
    }
  ]
}
