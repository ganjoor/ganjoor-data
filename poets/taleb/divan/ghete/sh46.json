    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "همچو گلبن فشرده خاطر باش",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: مانند بوتهٔ گل، دل فشرده و خاطر جمع باش تا از بیانت بهار بپراکنی."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "که بهار از بیان بیفشانی",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "دلبران جیب طره بگشایند",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چون گره از ابروان خود بگشایی و سخن شاد بگویی، دلبران گریبان گیسوی خود را می‌گشایند."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "چون گره ز ابروان بیفشانی",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "گرکنی نغمهٔ پریشان زلف",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر نغمه‌ای در وصف زلف پریشان بسرایی، از زبانت بلبل‌ها می‌پراکنی."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "عندلیب از زبان بیفشانی",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "ورکنی نامه را مخالف سیر",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: و اگر نامهٔ شعرت را در پردهٔ «مخالف» بسرایی، از بیانت نوای ارغنون برمی‌خیزد."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "ارغنون از بیان بیفشانی",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "در بنان ورد خامه را تا چند",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تا کی گل قلم خود را در سرانگشتان برای این فرومایگان بپاشی؟ یعنی دیگر سخن خود را در ستایش ناکسان هدر مده."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "بهر این سفلگان بیفشانی",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "در ثنای گزیدگان هجا",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تا کی آبروی زبانت را در ستایش کسانی می‌ریزی که سزاوار هجو و نکوهش‌اند؟"
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "آبروی زبان بیفشانی",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "چاک زن جیب صفحه را تا چند",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تا کی با نوشتن نام و ستایش این و آن، صفحه را وامی‌داری که از اندوه گریبان چاک کند؟"
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "رقم این و آن بیفشانی",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "هرکه را دشنه در جگر باید",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به کسی که سزاوار خنجری در جگر است، آب کوثر در دهان می‌ریزی."
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "کوثرش بر دهان بیفشانی",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "هرکه را زهر در گلو زیبد",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به کسی که زهر در گلو برازندهٔ اوست، شیر بر لبانش می‌ریزی."
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "لبنش بر لبان بیفشانی",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "سینه‌ئی راکه دشنه در کار است",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: سینه‌ای را که سزاوار خنجر است، با غمزهٔ دلبران می‌نوازی. یعنی ستایشِ نوازشگر نثار کسی می‌کنی که سزایش زخم است."
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "غمزهٔ دلبران بیفشانی",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "دیده‌ئی را که باب مسمار است",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چشمی را که سزاوار میخ‌کوبیدن و کور شدن است، با لالهٔ بوستان می‌آرایی."
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "لالهٔ بوستان بیفشانی",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "مدح مغز سخنوریست مباد",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: مدح، جوهر و مغز سخنوری است؛ مبادا آن را نثار این فرومایگان کنی."
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "که بر این ناکسان بیفشانی",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "جهد کن تا براین سگان ز هجا",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بکوش تا با هجو، دامنی استخوان پیش این سگان بریزی. یعنی سزای فرومایگان هجو است، نه مدح."
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "دامنی استخوان بیفشانی",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "سرمه‌ات جوهریست هان مپسند",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: سخن تو مانند سرمه‌ای گران‌بهاست؛ مبادا روا بداری که آن را به سرزمین نابینایان بپاشی."
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "که باعمی ستان بیفشانی",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "در طاوس عرش زن تا چند",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در خانهٔ طاووسِ عرش را بکوب و همت بلند داشته باش؛ تا کی برای مرغان خانگی دانه می‌پاشی؟"
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "دانه بر ماکیان بیفشانی",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "سعی‌کن تا چمن چمن‌گل مدح",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بکوش تا گلزارهای مدح را نثار شاه پاکان و فرشتگان کنی."
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "برشه قدسیان بیفشانی",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "شمع ایمان علی که بر یادش",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آن شاه، علی است، شمع ایمان، که با یاد او از همهٔ جهان دست می‌شویی و آستین می‌افشانی."
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "آستین بر جهان بیفشانی",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "روضه‌اش چون درآوری بضمیر",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چون آرامگاه او را به یاد آوری، از چشم دل اشک خونین می‌ریزی."
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "دیدهٔ دل چکان بیفشانی",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "وانکه در اوج تازی مدحش",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: و او کسی است که چون در اوجِ مدحش اسب سخن بتازی، سایهٔ سخنت بر عالم بی‌مکان می‌افتد."
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "سایه براز مکان بیفشانی",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "سده‌اش چون رقم زنی بخیال",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چون درگاه او را در خیال تصویر کنی، از شرم و حرمت پیشانی‌ات عرق می‌کند و آن عرق را می‌افشانی."
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "جبههٔ خوی فشان بیفشانی",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "اوج گیرد غبار گویش اگر",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر گیسوی فرشتگان و روحانیان را بیفشانی، غبار کوی او برمی‌خیزد و اوج می‌گیرد. گویا یعنی فرشتگان با گیسو کوی او را می‌روبند."
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "زلف روحانیان بیفشانی",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "کردم نزع لذت زخمش",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر در هنگام جان‌کندن لذت زخمی را که از عشق او خورده‌ای به یاد آوری، آن لذت را بر دل خون‌چکانت نثار می‌کنی."
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "بدل خونچکان بیفشانی",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "در لحد چاک سینه خواهی دید",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در گور، سینه‌ات را چاک‌چاک خواهی دید، گویی آن را با نوک نیزه از شوق او شکافته‌ای."
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "که بنوک سنان بیفشانی",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "ور کنی وصف جوهر تیغش",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: و اگر گوهر و درخشش شمشیرش را وصف کنی، از زبانت موج آذرخش می‌جهد."
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "موج برق از زبان بیفشانی",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "ایخوش آنشب که بر سرکویش",
      "CoupletIndex": 40,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: خوشا آن شبی که در کوی او ناله و فغان سر دهی."
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "طرح آه و فغان بیفشانی",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "قدسیان چون بخاکبوس آیند",
      "CoupletIndex": 41,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: خوشا آن شب که چون فرشتگان برای بوسیدن خاکِ درگاه علی فرود آیند، تو گردِ راه را از بال‌هایشان بتکانی؛ یعنی خادمِ درگاهی باشی که فرشتگان نیز به آن سر می‌سایند."
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "گردی از بالشان بیفشانی",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "صبح چون خادمان بدامن شرم",
      "CoupletIndex": 42,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: و صبحگاه مانند خادمانِ درگاه، با دامنِ شرم و ادب آستانش را بروبی و بر آن بوسه بزنی."
    },
    {
      "VOrder": 86,
      "Position": "Left",
      "Text": "بوسه از آستان بیفشانی",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "گر غباری ز دامن مهرش",
      "CoupletIndex": 43,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر ذره‌ای غبار از دامنِ محبتِ او بر دل‌خستگان بپاشی،"
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "بر جگر خستگان بیفشانی",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "هر زمان از لباس یعقوبی",
      "CoupletIndex": 44,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر لحظه گویی بوی پیراهنِ یوسف را که یعقوب را شفا داد بر کاروان می‌افشانی؛ یعنی غبارِ مهرِ علی دردمندان را درمان می‌کند."
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "عطر بر کاروان بیفشانی",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 91,
      "Position": "Right",
      "Text": "گل دمد گر بیاد تربتش",
      "CoupletIndex": 45,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر به یادِ آرامگاهِ او حتی در پاییز قطره‌ای عرق بیفشانی، از آن گل می‌روید؛ یاد مزارش خزان را هم بهار می‌کند."
    },
    {
      "VOrder": 92,
      "Position": "Left",
      "Text": "عرق مهرگان بیفشانی",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 93,
      "Position": "Right",
      "Text": "چون بتحریر نامهٔ عذبش",
      "CoupletIndex": 46,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هنگامی که برای نوشتنِ نامه‌ای شیرین در ستایش او قلمِ سحرآمیزت را به کار می‌اندازی،"
    },
    {
      "VOrder": 94,
      "Position": "Left",
      "Text": "کلک جادو زبان بیفشانی",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 95,
      "Position": "Right",
      "Text": "شاید از بهر انتظام مداد",
      "CoupletIndex": 47,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: شاید برای فراهم کردنِ مرکبِ آن نامه، خونِ انوشیروانِ دادگر را بریزی؛ یعنی حتی خونِ پادشاهی چون انوشیروان تنها شایستهٔ مرکبِ مدحِ اوست."
    },
    {
      "VOrder": 96,
      "Position": "Left",
      "Text": "خون نوشیروان بیفشانی",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 97,
      "Position": "Right",
      "Text": "ای قضا صولتی که گاه مصاف",
      "CoupletIndex": 48,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای کسی که هیبتت چون قضای الهی است، در میدانِ جنگ چون لگامِ خشمت را رها کنی،"
    },
    {
      "VOrder": 98,
      "Position": "Left",
      "Text": "چون غضب را عنان بیفشانی",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 99,
      "Position": "Right",
      "Text": "فوج سرها ز شاخسار بدن",
      "CoupletIndex": 49,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: انبوهِ سرها را از شاخهٔ تن‌ها مانند برگِ پاییزی فرو می‌ریزی."
    },
    {
      "VOrder": 100,
      "Position": "Left",
      "Text": "همچو برگ خزان بیفشانی",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 101,
      "Position": "Right",
      "Text": "هرکرا گر ز بر سر افرازی",
      "CoupletIndex": 50,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بر سرِ هر کس گرز بلند کنی، مغزش را از مرکزِ جانش بیرون می‌پاشی."
    },
    {
      "VOrder": 102,
      "Position": "Left",
      "Text": "مغزش از ناف جان بیفشانی",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 103,
      "Position": "Right",
      "Text": "هرکرا تیغ بر تن آویزی",
      "CoupletIndex": 51,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بر تنِ هر کس شمشیر فرود آوری، خونش از زرهِ اسبش نیز بیرون می‌زند."
    },
    {
      "VOrder": 104,
      "Position": "Left",
      "Text": "خون ز برکستوان بیفشانی",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 105,
      "Position": "Right",
      "Text": "چون دهی عرض بیج و تاب کمند",
      "CoupletIndex": 52,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چون پیچ و تابِ کمندت را به نمایش بگذاری، آب و رونقِ زلفِ پیچانِ زیبارویان را از میان می‌بری."
    },
    {
      "VOrder": 106,
      "Position": "Left",
      "Text": "آب زلف از بتان بیفشانی",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 107,
      "Position": "Right",
      "Text": "رقص فرمای باره را تا خوی",
      "CoupletIndex": 53,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اسبت را به جولان درآور تا از شتابش آسمانِ دورنگِ شب و روز هم عرق بریزد."
    },
    {
      "VOrder": 108,
      "Position": "Left",
      "Text": "ز ابلق آسمان بیفشانی",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 109,
      "Position": "Right",
      "Text": "خندهٔ زخم خصم بین چوگره",
      "CoupletIndex": 54,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ببین که زخمِ دشمن چگونه چون خنده دهان باز می‌کند، هنگامی که گرهِ ابروی کمانت را می‌گشایی و تیر رها می‌کنی."
    },
    {
      "VOrder": 110,
      "Position": "Left",
      "Text": "ز ابروان کمان بیفشانی",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 111,
      "Position": "Right",
      "Text": "داورا ایکه چون مسیح از لب",
      "CoupletIndex": 55,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای داور، ای که مانند مسیح از لبانت داروی جان‌بخش می‌افشانی،"
    },
    {
      "VOrder": 112,
      "Position": "Left",
      "Text": "نوشداروی جان بیفشانی",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 113,
      "Position": "Right",
      "Text": "در تکلم هزار چشمهٔ نوش",
      "CoupletIndex": 56,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: و در سخن گفتن، هزار چشمهٔ شیرین از منفذهای بیانت جاری می‌کنی،"
    },
    {
      "VOrder": 114,
      "Position": "Left",
      "Text": "از مسام بیان بیفشانی",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 115,
      "Position": "Right",
      "Text": "چشم دارم که بر لب نطقم",
      "CoupletIndex": 57,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: امید دارم که بر لبِ سخنِ من نیز از عسلِ شیرین‌زبانیِ خود بیفشانی و مرا سخن‌ور کنی."
    },
    {
      "VOrder": 116,
      "Position": "Left",
      "Text": "شهد عذب‌اللسان بیفشانی",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 117,
      "Position": "Right",
      "Text": "(طالب) اینک رسید وقت دعا",
      "CoupletIndex": 58,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای طالب، اکنون هنگامِ دعا رسیده است که از کانِ سخن گوهر بیفشانی."
    },
    {
      "VOrder": 118,
      "Position": "Left",
      "Text": "که جواهر ز کان بیفشانی",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 119,
      "Position": "Right",
      "Text": "وقت آن شدکه چشمه‌های عرق",
      "CoupletIndex": 59,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: وقت آن است که با تمامِ توان بکوشی، چنان که از پیشانیِ زبانت چشمه‌های عرق جاری شود."
    },
    {
      "VOrder": 120,
      "Position": "Left",
      "Text": "از جبین زبان بیفشانی",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 121,
      "Position": "Right",
      "Text": "نفسی هم بگلستان دعا",
      "CoupletIndex": 60,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دمی هم در گلستانِ دعا نغمه‌ای سوزناک و خونین سر بدهی."
    },
    {
      "VOrder": 122,
      "Position": "Left",
      "Text": "نغمهٔ خونچکان بیفشانی",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 123,
      "Position": "Right",
      "Text": "یا ربی سرکنی و آمینی",
      "CoupletIndex": 61,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: «یا رب»ی آغاز کنی و «آمین» را از لبِ فرشتگان جاری سازی."
    },
    {
      "VOrder": 124,
      "Position": "Left",
      "Text": "از لب قدسیان بیفشانی",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    }
  ]
}
