  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ز هی سرفرازی که در رتبه زیبد",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "کمین چاکران ترا تاج داری",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "چو با جیش نصرت کنی عزم جولان",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "کند نه فلک موکبت را غباری",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
