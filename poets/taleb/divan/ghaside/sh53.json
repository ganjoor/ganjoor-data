    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "گاه تحدیب بادهٔ نابی",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "حرف شمشاد پیش قامتشان",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "بر زبان نارسیده اطنابی",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "وصف خورشید پیش‌عارضشان",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "مثل آب شور و اعرابی",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "هرطرف نهرهای می غلطان",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "همچو مستان بگاه بیخوابی",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "ناز کوثر کرشمهٔ تسنیم",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "تشنه را کرده مست سیرآبی",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "مجملا مست‌خواب چون دیدم",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "جلوه‌گاهی باین خوش اسبابی",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "در تحیر شدم چو باز نمود",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "توسن حیرتم عنان تابی",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "گفتم آیا ز ممکنات بود",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "شبه این در صفا و شادابی",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "گفت رضوان مگر ندیدستی",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "مرقد الفیض قطب اقطابی",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "شیر یزدان علی که می نکشد",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "عشوهٔ کنیوی و القابی",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "آنکه با عدل او ز شعله کشند",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "ابره بر پوستین سنجابی",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "وانکه با حفظش از شرار زنند",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "میخ بر موزه‌های مرغابی",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "در صفات جلالش ار سطری",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "ریزد از خامه‌های کتابی",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "در مقامات فتح و کسر کنند",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "آسمان و زمینش اعرابی",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "حفظ او در ضمیر گرسنه‌ئی",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "شب رود گر بخواب بیتابی",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "صبحدم باز ماندش بمذاق",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "لذت اکل لقمهٔ خوابی",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "گر بایمای ابروی کرمش",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "عام گردد خواص جذابی",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "زربه‌کان انجذاب سکه کند",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "هم ز چین جبین ضرابی",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "عمرها در مدارس علمش",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "کرده خیل علوم کتابی",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "چون کشد فوج خصم را بکمند",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "گوید آندم سپهر دولابی",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "از تو فرمان ز بنده جلادی",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "و ز تو ایما ز بنده قصابی",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "داورا میزند همی (طالب)",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "دم ز عبدیت نی ز اصحابی",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "تازه‌گو شاعریست چرب زبان",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "سخنش در کمال شادابی",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "آمد و رفت پای خاطر او",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "فارغ از جزر و مدّ اعصابی",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "تارو پود کتان نظمش را",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "فیض خیط الشعاع مهتابی",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "مضطرب توسنی است خامهٔ او",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 86,
      "Position": "Left",
      "Text": "تار و پود عنان سیمابی",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "نیست فارغ انامل نطقش",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "یکدم از رشتهٔ سخن تابی",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "تربیت تشنه است از تو و بس",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "برسانش بفیض سیرابی",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 91,
      "Position": "Right",
      "Text": "تا ز مضراب در فغان آید",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 92,
      "Position": "Left",
      "Text": "ساز بو نصر ساز فارابی",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 93,
      "Position": "Right",
      "Text": "ارغنون دل عدوی ترا",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 94,
      "Position": "Left",
      "Text": "ناخن غم کناد مضرابی",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    }
  ]
}
