  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "تن بفراغت مده عاشق آزار باش",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "بر گل گلشن مجوش همنفس خار باش",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "دست رفیقان مبوس سینهٔ دشمن مکاو",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
