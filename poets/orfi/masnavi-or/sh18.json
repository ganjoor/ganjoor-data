  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "عابدی از شمع هدی نور یاب",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: یک عابد در شب نور هدایت را از شمعی دریافت کرد و در این حال، دلش به خواب رفت و همچون پرنده‌ای در دام خواب افتاد."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "گشت شبی مرغ دلش صید خواب",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "نیم شبی واقعه رو نمود",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: نیمه شب، حادثه‌ای رخ داد که دیدم در آسمان آبی رنگ، اتفاقی افتاده است."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "دید که بر فرق سپهر کبود",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "خوابگه عرش برین دوش اوست",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: خوابگاه بلند مرتبه آسمان متعلق به اوست و او خود تماشاگر این عرش آسمانی است."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "منظره عرش نشین دوش اوست",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "صبح که مرغ دلش از خواب جست",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: صبح که دل پرنده از خواب بیدار شد، چشم‌هایش را مالید و روی زمین نشست."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "چشم بمالید و بزانو نشست",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "دمبدم از واقعه نیم شب",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: هر لحظه از آنچه در نیمه شب اتفاق افتاده، انگشت تعجب تو در دهان بود."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "داشتی انگشت تحیر بلب",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "وسوسه پایی بدلش برفشرد",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: وسوسه‌ای او را به سمتی سوق می‌دهد و دستش به سوی آب پاک می‌رود."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "دست سوی مطهره آب برد",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "ساخت وضوئی و عبادات کرد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: وضو گرفت و عبادت کرد، سپس دست به دعا برداشت و راز و نیاز کرد."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "دست بر آورد و مناجات کرد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "کی تو بر آرنده حاجات ما",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: کی تو خواسته‌های ما را برآورده می‌کنی و کی تو عمل‌های نیک ما را می‌پذیری؟"
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "وی تو پذیرنده طاعات ما",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "نیستم آگاه زتعبیر خواب",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: من از تعبیر خواب اطلاعی ندارم، فقط می‌خواهم تأثیر آن را به طور واضح ببینم."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "بازنما صورت تأثیر خواب",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "بادلی اندر کف حسرت زبون",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: در دل خود حسرتی بزرگ داشت و با حالتی ناتوان و سرگردان از معبد خارج شد."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "رفت زمعبد متحیر برون",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "دید که ماتمزده دردناک",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: او دید که کسی به شدت غمگین و بی‌تاب، همچون ماهی‌ای که از آب خارج شده، روی زمین افتاده است."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "مضطرب افتاده چو ماهی بخاک",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "نوحه کنان، اشک فشان، سینه کوب",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: با زاری و گریه، اشک می‌ریزد و به سینه‌زنی مشغول است، چهره‌اش را به زمین می‌ساید و با مژه‌اش خاک را می‌روباید."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "چهره زمین سای و مژه خاک روب",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "آمد و برداشت سرش از زمین",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: او آمد و سرش را از زمین بلند کرد و اشک‌ها از چشمانش بر روی آستینش ریخت."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "اشک فشاند از مژه اش زآستین",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "گفت که ای مرد بر آشفته حال",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: تو ای مردی که در اضطراب و نگرانی به سر می‌بری، هم ظاهر تو و هم درونت پر است از غم و ناراحتی."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "صورت و معنی همه حزن و ملال",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "گوهر اشک تو وفات که سفت",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "CoupletSummary": "هوش مصنوعی: گلوله‌ای از اشک تو مانند جواهر ارزشمندی است، که در آن سوگ و اندوهی نهفته است. وقتی که دست به زانو زده‌ای و ناله می‌کنی، گویی می‌گویی که این اشک‌ها بیان‌گر تمام غصه‌ها و دردهای تو هستند."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "دست بزانو زده نالید وگفت",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "شمع شبستان امل بایزند",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17,
      "CoupletSummary": "هوش مصنوعی: شمعی که در شبستان امید روشن است، به مانند سرور و بزرگی در عالم هستی است که جان ازلی را به خود جلب می‌کند."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "صدر شهان جان ازل بایزند",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "عابد دلسوخته چون این شنید",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18,
      "CoupletSummary": "هوش مصنوعی: عابد عاشق وقتی این سخنان را شنید، دلش به شدت جریحه‌دار شد و اشک‌هایش سرازیر شد."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "گشت دلش خون وزمژگان چکید",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "راه حریم حرم او سپرد",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19,
      "CoupletSummary": "هوش مصنوعی: در راه ورود به آستان محبوب، ادب به دوش خود بار سنگینی را حمل کرد."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "دوش ادب را بته نعش برد",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "آمدش از عرش صدایی بگوش",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20,
      "CoupletSummary": "هوش مصنوعی: از آسمان صدایی به گوش رسید که نشان از عظمت و ارزش بلندش داشت."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "کی ز شرف پایه عرشت بدوش",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "شب که ترا مستی غفلت فزود",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21,
      "CoupletSummary": "هوش مصنوعی: در شب وقتی که نشئه‌ی غفلت تو بیشتر شد، حادثه‌ای شگفت‌انگیز نمایان گردید."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "واقعه بولعجبت رخ نمود",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "درنگر این صورت تأثیر اوست",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22,
      "CoupletSummary": "هوش مصنوعی: به زیبایی این شخص دقت کن، زیرا اثر او در اینجا مشهود است و نمایانگر عمق معانی و تفاسیر وجودش است."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "جلوه ده معنی تعبیر اوست",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "روحش از این زمزمه پرواز کرد",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23,
      "CoupletSummary": "هوش مصنوعی: روح او از این نغمه به پرواز درآمد و با خشم و قوتی از نفس خود به سخن گفتن آغاز کرد."
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "عربده بانفس خو آغاز کرد",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "گفت که ای نفس تو خود کیستی",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24,
      "CoupletSummary": "هوش مصنوعی: گفت: ای جان، تو کیستی و چرا برای این همه بیهوده زندگی می‌کنی؟"
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "وین همه بیهوده چه میزیستی",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "نعش یکی دعوی عرشی کند",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25,
      "CoupletSummary": "هوش مصنوعی: یک جنازه در آسمان ادعایی می‌کند، در حالی که زیر آن، دوش تو را به زمین می‌برد."
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "در ته آن دوش تو فرشی کند",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "آنهمه عزاینهمه ذلت زچیست",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26,
      "CoupletSummary": "هوش مصنوعی: این همه سختی و ذلت که ما کشیده‌ایم، به چه دلیلی است؟ انصاف بدهید، تقصیر کیست؟"
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "خود بده انصاف که تقصیر کیست",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "شرمت ازین زمزمه پست باد",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27,
      "CoupletSummary": "هوش مصنوعی: از نطق بی‌فایده‌ات شرمنده باش، از این بی‌توجهی مداوم‌ات خجالت بکش."
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "شرمت ازین غفلت پیوست باد",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "نعش یکی مرده بود عرش تو",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28,
      "CoupletSummary": "هوش مصنوعی: یک جسد در برابر تو بود، پس تلاش کن که تا زمانی که عرش هست، فرش تو نیز پابرجا باشد."
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "کوش که تا عرش بود فرش تو",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "عرفی از این دایره برگیرپای",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29,
      "CoupletSummary": "هوش مصنوعی: زبانت را از این دایره بیرون ببر تا بتوانی به مقام و درجه‌ای بالا دست یابی."
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "تا شودت پای طلب عرش سای",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "میل کش دیده امید باش",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30,
      "CoupletSummary": "هوش مصنوعی: به چشم‌هایت امید و آرزو داشته باش و زندگی کن؛ زندگی‌ای که همیشه پا برجا باشد."
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "نفس بکش زنده جاوید باش",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    }
  ]
}
