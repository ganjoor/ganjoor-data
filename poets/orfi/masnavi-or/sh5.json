  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ای طلب چشمه امید ما",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: ای آرزوی ما، چشمه‌ی امید! ما در کنار غم‌های همیشگی‌مان لذت می‌بریم."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "ذوق فروش غم جاوید ما",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "گنج طلب زیر قدم سوده ایم",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: ما ابتدا گنج را زیر پای خود قرار داده‌ایم و به دنبال آن هستیم، اما از جستجوی برای به‌دست آوردن گنج خسته نشده‌ایم."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "وز طلب گنج نیاسوده ایم",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "هر نفسم چشمه گشای طلب",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: هر نفس من، شوقی جدید برای خواسته‌هایم ایجاد می‌کند و هر خواسته‌ام مانند عطر و بوی خوشی است که به دنبال آن می‌روم."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "هر طلبم غالیه سای طلب",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "نیست ادب روی زره تافتن",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: اگر ادب و احترام بر تن آدمی نباشد، به چه کسی می‌توان به عنوان تکیه‌گاه اعتماد کرد؟"
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "ورنه که داند بتوره یافتن",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "ماعدم و ذات تو عین وجود",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: وجود من ناشی از وجود توست؛ انگار که عدم، زمانی می‌تواند در هستی تأثیر بگذارد که تو خود بخواهی."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "دست عدم کی در هستی گشود",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "از عدم آرایش ما کرده ای",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: تو از وجود خالی ما، جواهری ساخته‌ای که از هیچ چیز به دست آمده است."
    },
    {
