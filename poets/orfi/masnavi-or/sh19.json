  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "انجمن آرای درون با یزید",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
