      "VOrder": 50,
      "Position": "Left",
      "Text": "وز بنشیند ز غمم شاد باد",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "دل که بود چشمه سودای دوست",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27,
      "CoupletSummary": "هوش مصنوعی: دل سرچشمهٔ سودای دوست است و زندگی اهل محبت به همین دل وابسته است."
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "زندگی اهل محبت بدوست",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "آنکه دهد روح بوی ساز و برگ",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28,
      "CoupletSummary": "هوش مصنوعی: به کسی که به جان ساز و برگ و اهمیت می‌دهد بگو برو از مرگ مهلت بگیر؛ یعنی جان ماندنی نیست."
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "گوبستان مایه مهلت ز مرگ",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "عرفی از اندیشه جان باز گرد",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29,
      "CoupletSummary": "هوش مصنوعی: عرفی، از فکر جان بازگرد؛ و از غم هر چیزی که دل نیست روی برگردان."
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "هر چه نه دل از غم آن باز گرد",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "شمع که سرتا بقدم دل بود",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30,
      "CoupletSummary": "هوش مصنوعی: شمع که سراپا دل است، روشنی‌بخش چشم مجلس است."
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "روشنی دیده محفل بود",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "چهره بر افروز و غم دل فشان",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31,
      "CoupletSummary": "هوش مصنوعی: چهره را برافروز و غم دل را بیفشان، و گوهر جان را نثار پای دل کن."
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "گوهر جان در قدم دل نشان",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "دل به طواف حرم طور بر",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 32,
      "CoupletSummary": "هوش مصنوعی: دل را به طواف حرم کوه طور ببر و سینه را به گدایی از منصور حلاج ببر."
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "سینه به دریوزه منصور بر",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "تا لمن الملک بر آرد نفس",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 33,
      "CoupletSummary": "هوش مصنوعی: تا ندای «لمن الملک» برآید و پس از آن شعلهٔ نور «انا الحق» زبانه کشد."
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "شعله زند نور انا الحق ز پس",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "کفر تو آرایش ایمان کند",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 34,
      "CoupletSummary": "هوش مصنوعی: آنگاه کفر ظاهری تو زینت ایمان می‌شود و نام دلت سرور شهیدان عشق خواهد شد."
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "نام دلت صدر شهیدان کند",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    }
  ]
}
