      "VOrder": 26,
      "Position": "Left",
      "Text": "طوبی طلبد بجای هیزم",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "در ابره اطلس فلک دوخت",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اندیشهٔ او از سپیدی صبح، پوست قاقم دوخت و بر رویهٔ اطلس آسمان نشاند."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "رایش زبیاض صبح قاقم",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "رضوان زپی شراب بزمش",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: رضوان، نگهبان بهشت، برای شراب مجلس او بر داربست انگور می‌پروراند."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "انگور ، بپرورد بطارم",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "بر خاک در طبیعت او",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دریای محیط بر خاک درگاه طبع او تیمم می‌کند؛ یعنی دریا در برابر طبع او فروتن و نیازمند است."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "دریای محیط در تیمم",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "گردون بنظاره ضمیری",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آسمان برای تماشای ضمیر او یکسره چشم شد و خورشید مردمک آن چشم گشت."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "یک دیده و آفتاب مردم",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "ازآب سخاش خوشه برداشت",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از آب بخشش او حتی نوک مژه مانند ساقهٔ گندم خوشه آورد."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "نوک مژه چون درخت گندم",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "عرفی بمدیح خود شتابی",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: شاعر به خود می‌گوید: ای عرفی، در ستایش خود شتاب می‌کنی؛ هوشیار باش که راه را گم نکنی."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "هشدار مباد، ره کنی گم",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "داد سخنت بده که مردند",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: حق سخنت را ادا کن، زیرا معنا و عبارت از دادخواهی و شکایت مردند."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "معنی و عبارت از تظلم",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "هان شرم مکن ثنای خودگو",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: شرم نکن و ستایش خود را بگو، بگذار حسود به ریشخند لبخند بزند."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "گوباش حسود در تبسم",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "شایسته تویی به مدح امروز",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: امروز تنها تو سزاوار ستایشی، ای کسی که خاک راهت بر سر مردم است."
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "ای خاک رهت به فرق مردم",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    }
  ]
}
