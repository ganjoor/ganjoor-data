  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "کردم ز شراب ناب توبه",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از شراب خالص توبه کردم و از سخنان نادرست نیز توبه کردم."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "وز گفته ناصواب توبه",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "میساختمش بباده ممزوج",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: گلاب را با باده درمی‌آمیختم؛ اکنون بی‌دریغ از گلاب هم توبه می‌کنم، چون با شراب همراه بود."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "بی خستگی از گلاب توبه",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "در لفظ شراب چون بود آب",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چون در واژهٔ «شراب» کلمهٔ «آب» هست، با وجود تشنگی از آب هم توبه می‌کنم."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "با تشنه لبی زآب توبه",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "در وصف بباده چون شریک است",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چون عسل در صفت شیرینی با باده شریک است، صد بار از عسل ناب هم توبه می‌کنم."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "صد بار ز شهد ناب توبه",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "مستانه رود اگر سمندم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر اسبم مستانه و تلوتلوخوران راه برود، پایم از رکاب توبه می‌کند و دیگر سوار نمی‌شوم."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "پایم کند از رکاب توبه",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "گر عرض کنم زبان مستی",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر زبان مستی‌ام را بازگو کنم، خود شراب هم از سرمستی‌اش توبه می‌کند؛ یعنی مستیِ من از مستیِ شراب فراتر بود."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "از نشئه کند شراب توبه",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "گر درد ندامتم بسنجد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر درد پشیمانی مرا بسنجند، عذاب هم از سختی آن زخم توبه می‌کند؛ یعنی پشیمانی‌ام از هر عذابی سخت‌تر است."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "زآسیب کند عذاب توبه",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "تا باده بخواب هم نه بینم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: برای آنکه باده را حتی در خواب هم نبینم، شاید از خوابیدن هم توبه کنم."
    },
    {
      "VOrder": 16,
