  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "فدت نفسی و ما تهواه مالی",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: روح من فدای آن چیزی است که دوست می‌داری، یعنی همت بزرگ و آرزوهای عالی."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "همام العصر ذالهمم العوالی",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "جهان فضل شمس الدین که دولت",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: جهان پر از نعمت و فضیلت شمس‌الدین است و امیدوارم که این نعمت‌ها در پیوند با مجلس و جمع‌های عرفانی یا علمی او از بین نرود."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "مباد از مجلس عالیت خالی",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "اذا مامشت الاقلام یموما",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: وقتی قلم‌ها به سمت بالا حرکت می‌کنند، فقط در برابر چشمان بزرگ و بلندمدت قرار می‌گیرند."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "امام الا رئا بالعوالی",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "عروس فضل را الفاظ عذبش",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: عروس علم و فضل را با کلمات زیبا و شیرین مزین کرده و به آن معنا و مفهوم زیبایی بخشیده است."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "به زیورهای معنی کرده حالی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "سواد سجله أبدی بیاضا",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: این بیت به مفهوم دائمی بودن سیاه‌رویی و ایستادگی در بستر روزگار اشاره دارد و بر زیبایی و کمالی که در دلها و چشم‌ها وجود دارد، تأکید می‌کند. به نوعی، به نقش نور و زیبایی در زندگی پرداخته می‌شود."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "کمالت من السنح اللآلی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "چه گفت ابن یمین چون دیده بگشاد",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
