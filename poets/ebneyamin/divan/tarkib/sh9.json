    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "بی اکراه",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "کفتم ز سر لطف که ای طرف پسر",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "CoupletSummary": "هوش مصنوعی: من با محبت به او گفتم، ای جوان، قبل از اینکه مورها به صف بیفتند، تو باید خودت را آماده کنی."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "زان پیش که مور صف کشد گردشکر",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "خواهم نفسی ز صحبتت آسودن",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17,
      "CoupletSummary": "هوش مصنوعی: می‌خواهم از صحبت با تو آسوده شوم، چون می‌دانم تو راضی هستی."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "دانم که رضا داری",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "از شام شراب دادنت تا بسحر",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18,
      "CoupletSummary": "هوش مصنوعی: در این بیت، شاعر به لحظات شادی و خوشی اشاره می‌کند که در طول شب با نوشیدن شراب سپری می‌شود. او از لذت‌بخشی این شب تا بامداد سخن می‌گوید و در نهایت زمانی که اثر مستی از بین می‌رود، به واقعیت برمی‌گردد. به عبارتی، شاعر فضای پرشور و شگفت‌انگیز شب را توصیف می‌کند که سرشار از شادی و آزادگی است، اما بعد از آن، انسان ناچار به مواجهه با واقعیت می‌شود."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "وانگه که فرو شد از سر مستی سر",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "گویم که میان ما چه خواهد بودن",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19,
      "CoupletSummary": "هوش مصنوعی: می‌گویم که در رابطه ما چه قوانینی برای وفاداری وجود خواهد داشت."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "آئین وفا داری",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "ای روی تو بر سپهر خوبی ماهی",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20,
      "CoupletSummary": "هوش مصنوعی: ای چهره زیبایت در آسمان، همچون ماه درخشان است. از غم تو، همچون ماهی در بند، بر غم هر دشمنی فائق می‌آید."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "از بند غمت بر غم هر بد خواهی",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "آزادم کن",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21,
      "CoupletSummary": "هوش مصنوعی: مرا از قید و بند آزاد کن، می‌دانم که غم عشق تو می‌تواند دل من را شاد کند."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "دانم غم عشقت دل من شاد کند",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "تا کی ز غم عشق تو هم گه گاهی",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22,
      "CoupletSummary": "هوش مصنوعی: تا چه زمانی می‌خواهی من را از غم عشق خود ناراحت کنی؟ گاهی اوقات هم دلم را شاد کن."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "دلشادم کن",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "ای چشم سیاه تو بلای دل من",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23,
      "CoupletSummary": "هوش مصنوعی: ای چشم‌های سیاه تو برای دل من مایه عذاب و درد شده‌اند، دلم به شدت برای تو تنگ شده است."
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "مشتاق تو شد دلم برای دل من",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "برخیز و بیا",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24,
      "CoupletSummary": "هوش مصنوعی: بیا و بلند شو، اگر صاحب خانه تو را در روزها تنها نمی‌گذارد."
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "گر خواجه ترا روزها رها می نکند",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "آخر شبکی بهر رضای دل من",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25,
      "CoupletSummary": "هوش مصنوعی: در پایان شب برای خوشنودی دل من، دور شو و بیا."
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "بگریز و بیا",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    }
  ]
}
