      "VOrder": 16,
      "Position": "CenteredVerse2",
      "Text": "والا بهاء ملت و دین قطب اصفیا",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "SectionIndex3": 7
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "آن عارف زمانه که دوران معرفت",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "نارد نظیر او گهر از کان معرفت",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "جان و جهان معرفت او بود در جهان",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "چون او برفت رفت ز تن جان معرفت",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "نالان چو بلبل از غم آنم که پژمرید",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "از صرصر فنا گل بستان معرفت",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "تا میزبان جان تن خاکی است مثل او",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "مهمان ندید کس بلب خوان معرفت",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "پیوسته عقل کل ز پی زاد آخرت",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "بردی ز خوان نعمت او نان معرفت",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "آنرا که بود منکر عرفانش مینمود",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "سیر و سلوک همت و برهان معرفت",
