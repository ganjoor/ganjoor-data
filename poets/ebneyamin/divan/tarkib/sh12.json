      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "SectionIndex3": 8
    },
    {
      "VOrder": 32,
      "Position": "CenteredVerse2",
      "Text": "برهان صدق و جان صفا رهنمای حق",
