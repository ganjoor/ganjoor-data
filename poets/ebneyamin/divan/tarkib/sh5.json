      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "SectionIndex3": 11
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "یک صبحدم ای نسیم خوشبوی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "بگذر بسوی نگار و بر گوی",
