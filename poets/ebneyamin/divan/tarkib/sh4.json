      "Position": "CenteredVerse1",
      "Text": "زاری بفلک نمیرسانم",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "ای وصل تو اصل شادمانی",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "دامن بفراق جاودانی",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "بر ابن یمین چه میفشانی",
