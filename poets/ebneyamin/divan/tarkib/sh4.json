      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 35,
      "Position": "CenteredVerse1",
      "Text": "عهد تو شکست و من همانم",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "گر سر ببری بتیغ تیزم",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "از کوی وفات بر نخیزم",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "ور زانکه کنند ریز ریزم",
