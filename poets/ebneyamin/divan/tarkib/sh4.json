      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "گیرم نه در وفا گشودیم",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "نه بود هر آنچه مینمودیم",
