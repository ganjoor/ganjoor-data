      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 45,
      "Position": "CenteredVerse1",
      "Text": "فریاد بر آید از روانم",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "گر غمزه تو زند به تیرم",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "ور زلف تو در کشد بقیرم",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "یکدم نبود ز تو گزیرم",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "من ترک وصال تو نگیرم",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 50,
      "Position": "CenteredVerse1",
      "Text": "الا بفراق جسم و جانم",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "گر بگذردم به پیش خیلی",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "هر یک بصفا به از سهیلی",
