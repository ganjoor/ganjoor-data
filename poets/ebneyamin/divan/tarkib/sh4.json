      "Text": "هر چند ستمگری ترا خوست",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "کم کن ز بدی که آن نه نیکوست",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "گر آنکه دلت ز آهن و روست",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "آخر بسرم گذر کن ایدوست",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 15,
      "Position": "CenteredVerse1",
      "Text": "انگار که خاک آستانم",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "گفتم که چو کشتیم بزاری",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "زین پس ره مرحمت سپاری",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "بر دل رقم وفا نگاری",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "تو خود سر وصل ما نداری",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 20,
      "Position": "CenteredVerse1",
      "Text": "من عادت بخت خویش دانم",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "ای بسته کمر ز دور و نزدیک",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "بر هیچ بخون ترک و تازیک",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "وز مسکن اخلص الممالیک",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "کر خانه محقرست و تاریک",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 25,
      "Position": "CenteredVerse1",
      "Text": "بر دیده روشنت نشانم",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "من از تو بجز وفا نجویم",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "بیرون ز گلی وفا نبویم",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "الا ره بندگی نپویم",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "اسرار تو پیش کس نگویم",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 30,
      "Position": "CenteredVerse1",
      "Text": "اوصاف تو پیش کس نخوانم",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "نه مهر بمهر تو فزودیم",
