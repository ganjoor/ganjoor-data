      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "جز راه رضای حق نپویند",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "خاک من زار چون ببویند",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "گر نام تو بر سرم بگویند",
