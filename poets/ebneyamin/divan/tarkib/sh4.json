      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 65,
      "Position": "CenteredVerse1",
      "Text": "سهلست ز خویشتن مرانم",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    }
  ]
}
