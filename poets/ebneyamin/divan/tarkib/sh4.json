      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 55,
      "Position": "CenteredVerse1",
      "Text": "ملک عرب و عجم ستانم",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "گفتم صنما در آرزویت",
