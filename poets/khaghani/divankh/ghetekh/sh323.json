      "Position": "Right",
      "Text": "خواجه‌ای وعدهٔ نوالم داد",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "بر زبان عزیزتر مردی",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "گفتم آن مرد را که بهر دلت",
