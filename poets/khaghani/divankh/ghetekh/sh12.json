      "Position": "Left",
      "Text": "کاینه عیب‌نمای است مرا",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "هم فراغ است کز آئینهٔ جان",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
