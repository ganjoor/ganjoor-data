      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "کو نقوعی که در میانه خورم؟",
      "CoupletIndex": 8,
      "SectionIndex1": 0
