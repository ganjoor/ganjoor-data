      "Position": "Left",
      "Text": "کارها نیک کردگار کند",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "گرچه خصمان ز ریگ بیشترند",
