3E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn28\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eنجار گوهرم که نجیبان طبع من\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eجز زیر تیشهٔ پدر خویشتن نیند\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn29\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eوین جاهلان ملمع کارند و منتحل\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eز آن گاه امتحان به جز از ممتحن نیند\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn30\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eاز نوک خامه دفتر دلشان سیه کنم\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eکایشان زنخ زنند، همه خامه زن نیند\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn31\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eآنجا که من فقاع گشایم ز جیب فضل\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eالا ز درد دل چو یخ افسرده تن نیند\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn32\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eمعصوم کی شوند ز طوفان لفظ من\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eکز نوح عصمت الا فرزند و زن نیند\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn33\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eدر کون هم طویلهٔ خاقانیند لیک\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eاز نقش و نطرتند ز نفس و فطن نیند\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022b\u0022 id=\u0022bn34\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eحقا به جان شاه که هم شاه آگه است\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eکایشان سزای حضرت شاه ز من نیند\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E",
      "PoemFormat": "Ghaside",
      "CoupletsCount": 34
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "مشتی خسیس ریزه که اهل سخن نیند",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "با من قران کنند وقرینان من نیند",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "چون ماه نخشبند مزور از آن چو من",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "انجم فروز گنبد هر انجمن نیند",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "از هول صور فکرت من در قیامتند",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "گرچه چو اهل صور فکنده کفن نیند",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "پروردگان مائدهٔ خاطر منند",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "گر خود به جمله جز پسر ذوالیزن نیند",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "بل نایبان یاوگیان ولایتند",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "زیرا که شه طغان جهان سخن نیند",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "گاوی کنند و چون صدف آبستنند لیک",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "از طبع گوهر آور و عنبر فکن نیند",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "چون طشت بی‌سرند و چو در جنبش آمدند",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "الا شناعتی و دریده دهن نیند",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "گاه فریب دمنهٔ افسون گرند لیک",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "روز هنر غضنفر لشکر شکن نیند",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "چون ارقم از درون همه زهرند و از برون",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "جز کآبش رنگ رنگ و شگال شکن نیند",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "اوباش آفرینش و حشو طبیعتند",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "کالا به دست حرص و حسد مرتهن نیند",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "اندر چه اثیر اسیرند تا ابد",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "زان جز شکسته پای و گسسته رسن نیند",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "گویند در خلافه ولیعهد آدمیم",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "مشنو خلافشان که جز ابلیس فن نیند",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "گویند عیسی دگریم از طریق نطق",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "برکن بروتشان که به جز گور کن نیند",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "خود را همای دولت خوانند و غافلند",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "کالا غراب ریمن و جغد دمن نیند",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "بر قله‌های کوه ریاضت کشیده‌اند",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "ارباب تهمتند ولی برهمن نیند",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "از روی مخرقه همه دعوی دین کنند",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "وز کوی زندقه به جز اهل فتن نیند",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "چون شمع صبح‌گاهی و چون مرغ بی‌گهی",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "الا سزاید کشتن و گردن زدن نیند",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "من میوه دار حکمتم از نفس ناطقه",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "و ایشان ز روح نامیه جز نارون نیند",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "جمعند بر تفرق عالم ولی ز ضعف",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "موران با پرند و سپاه پرن نیند",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "تازند رخش بدعت و سازند تیر کید",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "اما سفندیار مرا تهمتن نیند",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "فرعونیان بی‌فر و عونند لاجرم",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "اصحاب بینش ید بیضای من نیند",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "خود عذرشان نهم که جعل پیشه‌اند پاک",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "ز آن طالبان مشک و نسیم سمن نیند",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "آری به آب نایژه خو کرده‌اند از آنک",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "مستسقیان لجهٔ بحر عدن نیند",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "بل تا مرض کشند ز خوان‌های بد گوار",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "کارزانیان لذت سلوی و من نیند",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "بینا دلان ز گفتهٔ من در بشاشت‌اند",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "کوری آن گروه که جز در حزن نیند",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "جائی است ضیمران ضمیر مرا چمن",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "کارواح قدس جز طرف آن چمن نیند",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "نساج نسبتم که صناعات فکر من",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "الا ز تار و پود خرد جامه تن نیند",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "نجار گوهرم که نجیبان طبع من",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "جز زیر تیشهٔ پدر خویشتن نیند",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "وین جاهلان ملمع کارند و منتحل",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "ز آن گاه امتحان به جز از ممتحن نیند",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "از نوک خامه دفتر دلشان سیه کنم",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "کایشان زنخ زنند، همه خامه زن نیند",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "آنجا که من فقاع گشایم ز جیب فضل",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "الا ز درد دل چو یخ افسرده تن نیند",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "معصوم کی شوند ز طوفان لفظ من",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "کز نوح عصمت الا فرزند و زن نیند",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "در کون هم طویلهٔ خاقانیند لیک",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "از نقش و نطرتند ز نفس و فطن نیند",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "حقا به جان شاه که هم شاه آگه است",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "کایشان سزای حضرت شاه ز من نیند",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    }
  ]
