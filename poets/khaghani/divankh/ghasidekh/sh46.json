  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "صبح چون زلف شب براندازد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: صبح که می‌رسد، مانند زلف‌های شب کنار می‌رود و مرغ صبح را از شادی به پرواز در می‌آورد."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "مرغ صبح از طرب پر اندازد",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "کرکس شب غراب‌وار از حلق",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: پرنده‌ای شب‌زنده‌دار مانند کلاغ، از دهان خود تخم آتشین را بیرون می‌اندازد."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "بیضهٔ آتشین براندازد",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "کرتهٔ فستقی بدرَّد چرخ",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هرگاه درخت فندق به بار بنشیند، لازم است که دانه‌های آن از چرخ آسیاب بگذرد تا به پرنده‌ی آوازخوان برسد."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "تا به مرغ نواگر اندازد",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "برشکافد صبا مشیمهٔ شب",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: باد صبحدم از پردهٔ شب می‌گسلد و کودک خونین را به سوی شرق می‌افکند."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "طفل خونین به خاور اندازد",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "زخمهٔ مطربان صلای صبوح",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: نواهای خوش آهنگ نوازندگان، صبح را با صدای شاد خود زنده می‌کند و در دل‌های شنوندگان خوش طنین می‌شود."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "در زبان‌های مزهر اندازد",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "زلف ساقی کمند شب پیکر",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: زلف‌های ساقی مانند کمندی است که شب را در آغوش دو انسان می‌گیرد."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "در گلوی دو پیکر اندازد",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "بر قدح‌های آسمان زنار",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در آسمان، زنجیری از ستاره‌ها مانند کمربند زیبایی دور سیاره مشتری می‌درخشد."
