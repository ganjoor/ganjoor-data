      "Text": "کو عقل مرا تمام بستاند",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "کهسار شما نیارد آن سیلی",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "کو سنگ مرا ز جا بگرداند",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
