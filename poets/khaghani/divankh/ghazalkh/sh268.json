      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "که آنجا مجلس آشویی ندارم",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "چه پویم بر پی مردان عالم",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
