      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "بهر مویی مرا واخواست از کیست",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "که اینجا محرم مویی ندارم",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "گر از حلوای هر خوان بی‌نصیبم",
      "CoupletIndex": 7,
      "SectionIndex1": 0
