      "Position": "Left",
      "Text": "نه سکبای هر ابرویی ندارم",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "در این عالم که آب روی من رفت",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
