      "VOrder": 18,
      "Position": "Left",
      "Text": "سیر فی اللّه شد کنونش خو",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "سفر واصلان چنین می‌دان",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: سفر واصلان را چنین بدان؛ مگر نشنیده‌ای که خدا هر روز در کاری تازه است؟"
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "نشنیدی که کل یوم شان",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "سایۀ حق چو گشت ظاهرشان",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: چون ظاهر ایشان سایهٔ حق شده، جان پاکشان راز عرش الهی است."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "سر عرش است جان طاهرشان",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "سایه جنبد ز شخص نی از خود",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: سایه به حرکت صاحبش می‌جنبد نه به خود، و سایه از نیک و بد خبری ندارد."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "چه خبر سایه را ز نیک و ز بد",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "سیر ایشان چو سر حق باشد",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: چون سیر ایشان راز حق است، هر لحظه از حق درس و بهره‌ای تازه می‌گیرند."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "دم‌به‌دم‌شان ز حق سبق باشد",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "بد و نیک ولی است از یزدان",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: نیک و بدی که از ولی سر می‌زند از خداست؛ هرچه سایه کند، بدان که از صاحب سایه است."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "هرچه سایه کند ز شخص بدان",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "مارمیت اذ رمیت در قرآن",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "CoupletSummary": "هوش مصنوعی: به همین سبب آفرینندهٔ دو جهان در قرآن فرمود: «تو نینداختی آنگاه که انداختی»."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "زین سبب گفت خالق دو جهان",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "مرد خودبین ازین سخن دور است",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17,
      "CoupletSummary": "هوش مصنوعی: آدم خودبین از فهم این سخن دور است، زیرا نفس تاریک ضد این نور است."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "نفس تاریک ضد این نور است",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "پیش خلق این سخن محال بود",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18,
      "CoupletSummary": "هوش مصنوعی: این سخن نزد مردم عادی محال می‌نماید، اما نزد عاشقان بیان حال خودشان است."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "پیش عشاق وصف حال بود",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "مرد عاشق از این شود آگه",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19,
      "CoupletSummary": "هوش مصنوعی: عاشق از این حقیقت آگاه می‌شود، ولی عاقل در این باره نادان می‌ماند."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "مرد عاقل در این بود ابله",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "عقل معمار این جهان آمد",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20,
      "CoupletSummary": "هوش مصنوعی: عقل آبادکنندهٔ این جهان است و عشق ویران‌کنندهٔ دکان و کسب دنیا."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "عشق ویرانی دکان آمد",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "می‌کند عقل پرده را افزون",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21,
      "CoupletSummary": "هوش مصنوعی: عقل پرده و حجاب را بیشتر می‌کند و عشق آدمی را از پرده بیرون می‌برد."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "عشق از پرده می‌برد بیرون",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "عقل دربند نام و ناموس است",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22,
      "CoupletSummary": "هوش مصنوعی: عقل گرفتار نام و آبرو است و عشق با ننگ و رسوایی خو گرفته است."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "عشق با ننگ و عار مأنوس است",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "عقل خواهد که تا شود سروَر",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23,
      "CoupletSummary": "هوش مصنوعی: عقل می‌خواهد سرور و بزرگ شود، اما عشق خاک پای هر خدمتگزاری است."
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "لیک عشق است خاک هر چاکر",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "خاک پاشی است عاشقان را دین",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24,
      "CoupletSummary": "هوش مصنوعی: آیین عاشقان خاکساری و افتادگی است و از جامه و آرایش فارغ‌اند."
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "فارغ‌اند از لباس و از تزیین",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "همه از خواجگی گریزانند",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25,
      "CoupletSummary": "هوش مصنوعی: همه از سروری و آقایی می‌گریزند و دشمن مال و دکان‌اند."
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "همه اعدای مال و دکانند",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "گاه مستی کنند و گه پستی",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26,
      "CoupletSummary": "هوش مصنوعی: گاهی مست‌اند و گاهی افتاده و فروتن، و همیشه از هستی و خودی ننگ دارند."
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "ننگ دارند دایم از هستی",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "نیستی را طلب کنند به جان",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27,
      "CoupletSummary": "هوش مصنوعی: با جان نیستی و فنا را می‌جویند و خرامان به سوی معشوق می‌روند."
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "سوی جانان روند جلوه‌کنان",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "همچو جان از نظر نهان گردند",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28,
      "CoupletSummary": "هوش مصنوعی: مانند جان از چشم‌ها پنهان می‌شوند و با فرشتگان در آسمان سیر می‌کنند."
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "با ملائک در آسمان گردند",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "تن‌شان گرچه در نظر باشد",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29,
      "CoupletSummary": "هوش مصنوعی: هرچند تنشان دیده می‌شود، جانشان از ماه برتر است."
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "جانشان برتر از قمر باشد",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "همدگر را همه همی‌دانند",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30,
      "CoupletSummary": "هوش مصنوعی: همه یکدیگر را می‌شناسند؛ اگر هزاران تن باشند، یک جان‌اند."
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "گر هزاران تنند یک جانند",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "گرچه از چشم خلق محجوبند",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31,
      "CoupletSummary": "هوش مصنوعی: هرچند از چشم مردم پوشیده‌اند، نزد آفریدگار بسیار محبوب‌اند."
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "پیش خالق عظیم محبوبند",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "خلق اگر لمعه‌ای بدیدندی",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 32,
      "CoupletSummary": "هوش مصنوعی: اگر مردم پرتوی از حال ایشان را می‌دیدند، عشقشان را به بهای جان می‌خریدند."
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "عشقشان را به جان خریدندی",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "خاکدان را از آن همی‌جویند",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 33,
      "CoupletSummary": "هوش مصنوعی: مردم از آن رو این خاکدان دنیا را می‌جویند که مانند جوی‌ها روان به سوی دریا نیستند."
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "که روان سوی یم نه چون جویند",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "سغبۀ این جهان از آن گشتند",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 34,
      "CoupletSummary": "هوش مصنوعی: مردم فریفتهٔ این جهان شدند چون اولیای خدا از چشمشان پنهان‌اند."
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "کاولیای خدا نهان گشتند",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 67,
      "Position": "Paragraph",
      "Text": "",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 68,
      "Position": "Paragraph",
      "Text": "",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    }
  ]
}
