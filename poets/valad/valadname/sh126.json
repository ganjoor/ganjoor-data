      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "تا ببینی جمال معنی را",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "بگذاری خیال و دعوی را",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "هست معنی چو آفتاب سما",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "هست صورت حقیر همچو سها",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "هردو هستند با تو نیک نگر",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "که کدامین به است ای سرور",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "بهترین را گزین چو دانایان",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "تا نمانی شقی چو خودرایان",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "زین که داری چرا تو بیخبری",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "عمر را بی عوض همی سپری",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "خویشتن را بدان چه چیزی تو",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "خوار منشین که بس عزیزی تو",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "نور یزدان درون قالب تست",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "خنک آنکس گه نور حق را جست",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "خویشتن را بدید کان نورا ست",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "از لطافت اگرچه مستور است",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "هر که بشناخت خویش را نیکو",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "هم خدا را شناخت بی ریب او",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "سوی شیطان اگر همیپوئی",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "در حقیقت تو بیگمان اوئی",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "ور بعکس آرزوت رحمان است",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "آخر الامرجات رضوان است",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "مینمایند هر دمت ز درون",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "گاه نقشی عزیز و گاهی دون",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "گه نموده فرشته گه شیطان",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "گونه گونه گهی از این گه از آن",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "تا کدامین ترا شود مخ ت ار",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "حشر با او شوی در آخر کار",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "راه عصیان و راه طاعت را",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "چون که بنمود حق بتو پیدا",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "خواه رو سوی نور اهل نعیم",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "خواه رو سوی نار اهل جحیم",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "چون نداری ز اصل قوت این",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "که گزینی بعشق راه گزین",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "دامن اهل دل بگیر که تا",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "دهدت راه در سرای بقا",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "قوتت بخشد ار ضعیفی تو",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "زو شوی فربه ار نحیفی تو",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "دهدت دیده تا شوی بینا",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "بی کتابی ترا کند استا",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "نظرش کیمیای بی ریبی",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "زر شوی زو نماندت عیبی",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "بردت آن طرف که منزل اوست",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "بی حجابی نمایدت رخ دوست",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "صحبتش را گزین کزان صحبت",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "دل رنجور تو برد صحت",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 67,
      "Position": "Paragraph",
      "Text": "",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    },
    {
      "VOrder": 68,
      "Position": "Paragraph",
      "Text": "",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 35
    }
