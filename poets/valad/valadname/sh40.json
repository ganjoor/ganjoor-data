  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "آن امانت که گفت در قرآن",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "حاملش شد ز جاهلی انسان",
