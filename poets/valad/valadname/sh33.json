  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "نقل صائب شنو از آن سرور",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: داستانی را که صائب نقل می‌کند، درباره آن شخصی است که در مورد ویژگی‌های دو نفر صحبت می‌کند."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "در بیان صفات این دو نفر",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "زاهد از ترس گفته «من چه کنم؟",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: زاهد از خوف و نگرانی ابراز می‌کند که با این همه مشکلات و سختی‌ها چه باید کرد و چگونه باید رفتار کرد."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "در میان چنین محن چه کنم؟»",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "عارف از عشق گفته «او چه کند؟",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: عارف در اینجا به بیان احساسی عمیق و شگفتی از عشق می‌پردازد و می‌پرسد که محبوب چه تأثیری بر او دارد، در حالی که از این موضوع تعجب می‌کند که خداوند برای او چه کارهایی انجام می‌دهد. این احساس نشان‌دهنده ارتباط عاطفی عمیق و تأمل در مورد عشق و وجود خداوند است."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "عجب از بهر من خدا چه تَنَد؟»",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "نظر او بود به سوی خودی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: چشم او به سوی من بود، پس من تلاش می‌کنم تا کارهای خوب انجام دهم و به بدی‌ها توجه نکنم."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "که کنم نیک و نگروم به بدی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "نظر این بود به سوی خدا",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: همیشه باید به سمت خداوند توجه داشت و نگاهتان را به او معطوف کنید."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "نگرد دائماً بر وی خدا",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "نظر الزاهدین فی الافعال",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: نگاه زاهدان به اعمال، مانند نگاه عارفان به زوال و افول است."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "نظر العارفین فی اضمحلال",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "صحوة الزاهد من الاعمال",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: بیداری زاهد از اعمال خود مانند مستی عارف از بزرگی و عظمت حق است."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "سکرة العارف من الاجلال",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "عمل البر متکا الزاهد",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: عمل نیک پناهگاه پارسایان و هدف آگاهان در نزد خداوند یگانه است."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "مطمح العارف لدی الواحد",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "ذا یری نفسه یفعل البر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: کسی که نیکویی‌ها را انجام می‌دهد، در دل خود گواهی بر حقیقت دارد."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "ذاک للحق شاهد فی السر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "ذاک احسانه مدی معدود",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: این جمله به خوبی نشان می‌دهد که لطف و احسان او محدود به زمان و مکان خاصی نیست و ویژگی‌های عارفان حقیقی را که درک عمیقی از حقیقت دارند، توصیف می‌کند. او می‌تواند مرزها و محدودیت‌ها را بشکند و به انسان‌ها کمک کند تا به شناخت بالاتری برسند."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "عارف الحق هادم المحدود",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "ذاک فی الارض عمره یفنی",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: در این دنیا، عمر انسان به سر می‌آید، اما کسی که حقیقت بقا را می‌شناسد، در آسمان جاودانه باقی می‌ماند."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "عارف الحق فی البقاء سما",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
