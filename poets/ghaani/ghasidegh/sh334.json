  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "به‌ گیسو روی آن ترک تتاری",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "به ماهی ماند اندر شام تاری",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "مرا آن زلف تاری بنده دارد",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
