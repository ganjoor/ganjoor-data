  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "کس مبادا چو من دلی زارش",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هیچ‌کس مانند من دلی زار و نالان نداشته باشد، دلی که راه و روشش وارونه و نادرست است."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "که بود باژگونه هنجارش",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "از ره و رسم مردمی به‌ کنار",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: این دل از راه و رسم آدمیت و انسانیت دور افتاده و از روی نادانی و سبک‌سری، اندیشه‌ای اهریمنی دارد."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "به سفه رأی اهرمن‌وارش",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "باده ‌پیما و رند و امردباز",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: باده‌نوش و رند و دلباختهٔ پسران نوخط است؛ کارش دل‌باختن و عاشقی است."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "بیدلی پیشه، عاشقی کارش",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "هرکجا عشرتی به طبع رَمان",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از هر جا که شادی و خوشی هست گریزان است و هر جا که رنج و سختی هست، همدم و پرستار آن است."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "هرکجا محنتی پرستارش",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "رنج نخلیست جان او برگش",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "رنج [چون] نخلی است که جان او برگش و درد [چون] پودی است که جسم او تارِ آن."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "درد پودیست جسم او تارش",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "روز تیره چو موی جانانش",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "روز تیزه‌اش چون موی جانان است و بخت بدش چون خوی دلدار."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "بخت خیره چو خوی دلدارش",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "سال و مه یار درد و اندوهش",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در همهٔ ماه‌ها و سال‌ها همدم درد و اندوه است و شب و روز با رنج و غم جفت است."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "روز و شب جفت رنج و تیمارش",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "دایم از حاصل نظربازی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به سبب چشم‌چرانی و نظربازی، همیشه بازار دیوانگی‌اش گرم و پررونق است."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "در جنونست‌ گرم بازارش",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "از هوس سر به‌ سر چو بوتیمار",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از شدت هوس او را مانند مرغ بوتیمار، که همیشه غمگین است، ناتوان و بیمار می‌بینی."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "باز بینی سقیم و بیمارش",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "کس ندیده‌ست در تمامی عمر",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در تمام عمر کسی از او چیزی جز تن زخمی و نالهٔ زار ندیده است."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "جز تن ریش و ناله زارش",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "وین عجب‌تر کزین همه محنت",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: و شگفت‌تر آنکه با این همه رنج، شادمان است و از آن آزرده نمی‌شود."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "شادمانست و نیست آزارش",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "همه را دل به عشرت آرد میل",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دل همه به شادی و خوشی میل دارد، جز دل من که یارش غم است."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "جز دل من ‌که غم بود یارش",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "هردم از خودسری و خودرایی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر لحظه به سبب خودسری و خودرایی، پایش در دامی گرفتار است."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "پا به دامی بود گرفتارش",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "گه به یاد بتی سمن سیما",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: گاهی به یاد زیبارویی سپیدچهره، چشمش مانند بت‌پرستی در برابر بت گریان است."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "دیده گریان بود شمن‌وارش",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "گه به فکر مهی سهیل جبین",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: گاهی در اندیشهٔ ماه‌رویی با پیشانی درخشان مانند ستارهٔ سهیل، اشکش مانند ستارگان گردنده بر چهره روان است."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "گشته بر رخ سرشک سیّارش",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "زهره‌رویی‌ گهی به چاهِ زنخ",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: گاهی زیبارویی چون زهره او را مانند هاروت، که در چاه بابل سرنگون آویخته شد، در چاه زنخدان خود سرنگون کرده است."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "کرده هاروت‌وَش نگونسارش",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "گه‌ کمان ابرویی به تیر مژه",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: گاهی معشوقی کمان‌ابرو با تیر مژگان و چشم خمارش او را شکار کرده است."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "کرده نخجیر چشم بیمارش",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "الغرض هر دمی به خواهش وقت",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: خلاصه آنکه هر لحظه، به اقتضای هوس و وقت، حالتی تازه در او می‌بینی."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "بنگری حالتی پدیدارش",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "هرکجا شاهدیست شیرین‌کار",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر جا زیبارویی دلربا و شیرین‌کار باشد، با جان و دل خواهان و خریدار اوست."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "باشد از جان و دل خریدارش",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "کارها دارد او که نتوان‌ گفت",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: کارهایی می‌کند که گفتنی نیست؛ پس به سخنان نرم و آرامش فریفته نشو."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "تا نبینی به نرم‌گفتارش",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "زیر هر پیچ او دو صد دغلست",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر پیچ‌های دستارش را باز کنی، زیر هر پیچ آن صدها نیرنگ و فریب پنهان است؛ یعنی ظاهرش آراسته و باطنش پر از حیله است."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "چون‌ کنی باز، پیچِ دستارش",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "باده و خمر و کوکنار و حشیش",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: باده و شراب و تریاک و حشیش، بازارشان از کار او گرم است؛ یعنی مصرف‌کنندهٔ همیشگی آن‌هاست."
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "گرم از فعل اوست بازارش",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "هرکجا نقش دلبری ساده",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر جا تصویر دلبری ساده‌روی و بی‌ریش باشد، او را مانند نقش دیوار، مات و حیران در برابرش می‌یابی."
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "مات یابی چو نقش دیوارش",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "جمله بر بوی ساغری باده",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "CoupletSummary": "او را می‌بینی که به بوی یک جام باده، در میخانه فرش زمین است!"
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "فرش بینی به‌ کوی خمّارش",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "چون سُرینی درون شلواری",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "CoupletSummary": "چون سرینی در شلواری ببیند، کک به تنبانش می‌افتد (بی‌تاب می‌شود)!"
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "دید، کَیْک اوفتد به شلوارش",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "حیله‌ها کرده رنگها ریزد",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "CoupletSummary": "ترفندها و نیرنگ‌ها به کار می‌بندد تا میخش را در سوراخ بکوبد!"
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "تا بکوبد به ثُقبه مسمارش",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "ننشیند ز پای تا نکند",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از پا نمی‌نشیند تا او را مانند فرامرز، که بر دار کشیده شد، بر سر دار کند؛ کنایه‌ای هزل‌آمیز از رسیدن به کام خویش."
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "چون فرامرز بر سر دارش",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "وینک از بس که معصیت‌ کرده‌ست",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: و اکنون از بس گناه کرده، در دلش امیدی به امان و بخشش نمانده است."
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "نیست در دل امید زنهارش",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "می‌ندانم بر او چه خواهد رفت",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: نمی‌دانم هنگامی که خداوند از کردارش بازخواست کند، چه بر سرش خواهد آمد."
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "باز پرسد عمل چو دادارش",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "هم مگر موجب نجات شود",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: مگر ستایش پادشاه جهان سبب رهایی او از گناهانش شود."
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "از گنه، مدحت جهاندارش",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "شاه‌ گیتی ستان محمد شه",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آن پادشاه جهان‌گشا محمدشاه است که آسمان بر درگاهش بوسه زده است."
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "کاسمان بوسه زد به دربارش",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "شاه غازی ‌که چون ماثر دین",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: پادشاه جنگاور در راه دین که آثار و یادگارهایش، مانند نشانه‌های دین، تا روز قیامت باقی خواهد ماند."
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "تا قیامت بماند آثارش",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "رسم امنیت از میان برخاست",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر جا که خنجر آتش‌بار او برسد، امنیت و آسودگی از دشمنان رخت برمی‌بندد."
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "هرکجا خنجر شرر بارش",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "همچنان بی‌مکاره است و فِتن",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر جا که خوی بهشت‌گونهٔ او حاضر باشد، آنجا از سختی و فتنه آسوده است."
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "هرکجا خُلق خُلد اطوارش",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "دودی از مطبخ عطای ویست",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آنچه آن را آسمان گردان می‌نامند، تنها دودی است که از آشپزخانهٔ بخشش او برخاسته است."
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "اینکه‌ گویند چرخ دوّارش",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "تیغ او دوزخیست تفتیده",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: شمشیر او دوزخی سوزان است برای عذاب دادن جان بدکاران."
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "پی تعذیب جان اشرارش",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "تا جهانست شاه شاه جهان",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تا جهان برپاست، پادشاه جهان پاینده باشد و یاری آسمان همواره همراهش باشد."
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "باد تایید آسمان یارش",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    }
  ]
}
