      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "از بخت واژگون به لب چاه بیژنا",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
