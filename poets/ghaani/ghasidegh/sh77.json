      "Position": "Right",
      "Text": "وانکه را کردگار کرد عزیز",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "نتواند زمانه خوارکند",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
