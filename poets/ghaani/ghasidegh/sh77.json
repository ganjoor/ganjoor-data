  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "هر کرا ایزد اختیار کند",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "در دوگیتیش‌ بختیارکند",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
