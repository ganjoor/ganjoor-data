      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "فریادش اگر رسی کنون رس",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
