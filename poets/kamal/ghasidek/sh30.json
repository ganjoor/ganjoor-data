  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "بوی فصل بهار می آید",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بوی فصل بهار به مشام می‌رسد و کارها رونق و آبرو می‌یابد."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "آب با روی کار می آید",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "غنچه های امید می شکفد",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: غنچه‌های امید باز می‌شود و گل اقبال و دولت به بار می‌نشیند."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "گل دولت ببار می آید",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "تازه و تر شکوفه های امل",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: شکوفه‌های تازه و شاداب آرزو بر سر شاخه‌ها پدیدار می‌شود."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "بر سر شاخسار می آید",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "صورت کارها بنامیزد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چشم بد دور، چهرهٔ همهٔ کارها چون نقش و نگاری زیبا جلوه می‌کند."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "همه همچون نگار می آید",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "در چمن لطف و نرمی گلبرگ",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در باغ، لطافت و نرمی گلبرگ چنان است که تیزی و آزار خار را جبران می‌کند و عذر آن را می‌خواهد."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "عذر تیزیّ خار می آید",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "عوض بادهای نوروزی",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به جای بادهای نوروزی، گویی کاروانی از مشک تاتار می‌رسد؛ یعنی نسیم بهاری بوی مشک دارد."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "کاروان تتار می آید",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "دیدۀ ابر را بجای سرشک",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از چشم ابر به جای اشک، مرواریدهای شاهوار فرو می‌ریزد؛ قطره‌های باران چون گوهر است."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "گوهر شاهوار می آید",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "چمن از برگ و شاخ و ناله مرغ",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: باغ با برگ و شاخه و نالهٔ پرندگان که از دلی بی‌قرار برمی‌خیزد، (آماده می‌شود)."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "کز دل بیقرار می آید",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "بست آذین و مطربان بنشاند",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: باغ آذین بست و نوازندگان را نشاند، زیرا پادشاه بهار در راه است."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "که شه نوبهار می آید",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "پای درخاک و تاج زر بر سر",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: نرگسِ خمارچشم، پا در خاک و تاجی زرین بر سر، پیش می‌آید."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "نرگس پر خمار می آید",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "متمایل چو یار من سر مست",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: نرگس مانند یار سرمست من خرامان و خوش و شادنوش می‌آید."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "بس خوش و شاد خوار می آید",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "چشمها چار کرده بر ره دوست",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چشم بر راه دوست دوخته و از انتظار حیران پیش می‌آید."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "خیره از انتظار می آید",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "شاخ چشم شکوفه بگشاده",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: شاخه، چشمِ شکوفه‌ها را گشوده و برای دیدار بر سر راه آمده است."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "بسر رهگذار می آید",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "دست یازید و سیم پیش آورد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: شاخه دست دراز کرد و سیم (شکوفه‌های سپید) پیش آورد، زیرا هنگام نثار کردن رسیده است."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "زآنکه وقت نثار می آید",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "رعد چاوش وار مقرعه زن",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: رعد مانند چاووش تازیانه می‌زند و راه باز می‌کند و برق مانند شمشیرزن پیش می‌آید."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "برق خنجر گزار می آید",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "سرو آزاد دستها برهم",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: سرو آزاده دست‌ها را به نشانهٔ ادب بر هم نهاده و براستی بنده‌وار پیش می‌آید."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "راستی بنده وار می آید",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "گر ندارد نشاط استقبال",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگر گل شوق به پیشواز رفتن ندارد، پس چرا سواره می‌آید؟ یعنی گل بر ساقه‌اش سوار است تا به استقبال برود."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "گل چه معنی سوار می آید",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "جان همی پرورد صبا، پنداشت",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: باد صبا جان را می‌پرورد؛ گمان بردم که از نزد آن یار زیبا می‌آید."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "کز برآن نگار می آید",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "خوابگه کرده بود در زلفش",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: صبا در زلف یار خوابیده بود؛ از این رو چنین مشک‌افشان می‌آید."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "زان چنین مشکبار می آید",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "این همه چیست؟ موکب عالی",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: این همه شور برای چیست؟ برای آن است که کاروان و موکب بلندمرتبهٔ ممدوح با شکوه بسیار می‌رسد."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "با هزار اعتبار می آید",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "از دهان جهان بگوش دلم",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از زبان جهان به گوش دلم مژدهٔ رسیدن یار می‌رسد."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "مژده وصل یار می آید",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "هرچه در سرّ غیب تعبیه بود",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هرچه در نهان غیب پنهان و آماده بود، لحظه به لحظه آشکار می‌شد."
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "دم بدم آشکار می امد",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "یزک نصرت و طلیعۀ فتح",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: پیشروان پیروزی و طلایه‌های فتح از راست و چپ فرا می‌رسیدند."
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "از یمین و یسار می آمد",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "لشکر آرزو ز مکمن غیب",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: سپاه آرزوها از کمینگاه غیب یکی پس از دیگری به صف می‌آید."
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "یک بیک بر قطار می آید",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "ترکتاز سپاه عیش و طرب",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: سپاه شادی و عیش با تاخت و تاز بر روزگار هجوم می‌آورد."
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "بسر روزگار می آید",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "در و دیوار شهر می گویند",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در و دیوار شهر می‌گویند که خواجه کامیاب و پیروز بازمی‌گردد."
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "خواجه بس کامکار می آید",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "لاله چون دشمنان صدر جهان",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: لاله مانند دشمنان صدر جهان (ممدوح) سرخ‌روی از شرم و خجالت پدیدار می‌شود."
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "خجل و شرمسار می آید",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "خون دل در قرح همی بیند",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: لاله در جام خود خون دل می‌بیند، از این رو چنین دل‌خسته و داغدار است."
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "زان چنان دلفکار می آید",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "آب هم رنگ اشک او دارد",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آبِ رنگ لاله به رنگ اشک خونین دشمن است؛ برای همین افتاده و بر خاک می‌روید."
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "زین سبب خاکسار می آید",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "گرچه از روزگار بر دل ما",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هرچند از روزگار زخم‌های سخت بر دل ما وارد می‌شود،"
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "زخمها استوار می آید",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "زین یکی خوشدلم که مولانا",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به همین یک چیز خوشدلم که مولانا (ممدوح) آهسته رفت و اکنون شتابان و چهارنعل بازمی‌گردد؛ یا با شکوهی دوچندان بازمی‌گردد."
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "دو برفت و چهار می آمد",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "لفظ جمع ار چه کرده ام واحد",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اگرچه لفظ جمع را برای یک تن به کار برده‌ام، این کار عذرخواهی می‌طلبد."
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "عذر را خواستار می آید",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "کاندر آن حضرت ار چه بسیارند",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: عذرم این است که در آن درگاه هرچند بزرگان بسیارند، تنها همان یک تن به حساب می‌آید."
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "آن یکی در شمار می آید",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "گرچه در خاطرم به دولت تو",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هرچند به برکت دولت تو صدها هزار معنی به ذهنم می‌رسد،"
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "معنی صد هزار می آید",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "بس کنم بس که در طریق سخن",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: سخن را کوتاه می‌کنم، زیرا در راه سخن، کوتاه‌گویی را برگزیده‌ام."
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "کوتهی اختیار می اید",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    }
  ]
}
