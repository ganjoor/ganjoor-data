      "Position": "Right",
      "Text": "طراز جمله دیوانهای اشعار",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "ثنای خسروگیتی ستان باد",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
