  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "اصفهان خرّمست ومردم شاد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اصفهان سرسبز و شاداب است و مردمش شادمان‌اند؛ هیچ‌کس روزگاری چنین خوش به یاد ندارد."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "این چنین عهدکس ندارد یاد",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "عدل سلطان واعتدال بهار",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دادگری فرمانروا و هوای معتدل بهار، جهان را یکسره آباد کرده است."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "کرد یکبارگی جهان آباد",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "نه بجز لاله هست سوخته دل",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در این روزگار جز لاله که میانش سیاه است کسی دل‌سوخته نیست و جز چنگ کسی ناله و فریاد نمی‌کند."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "نه بجزچنگ میکند فریاد",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "کله نرگس وقباچۀ گل",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: نرگس کلاه بر سر دارد و گل قبای کوچکی پوشیده است؛ گویی یکی عروس است و دیگری داماد."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "این عروسست گویی آن داماد",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "تن واندام یاسمین وسمن",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تن و اندام یاسمن و سمن در جامهٔ نازک ابریشمین بسیار لطیف و زیبا می‌نماید."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "بس لطیفست درغلالۀ لاد",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "زلف راتاب میدهد سنبل",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: سنبل گیسوی خود را تاب می‌دهد و شمشاد، که شانه از چوبش می‌سازند، موهای مجعد را شانه می‌زند."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "جعد را شانه میزند شمشاد",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "بگل ولاله داده اند مگر",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: گویی لب شیرین شیرین را به گل و سینهٔ خونین فرهاد را به لاله داده‌اند."
    },
    {
      "VOrder": 14,
      "Position": "Left",
