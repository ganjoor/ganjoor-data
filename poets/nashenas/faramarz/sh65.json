  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "دگر باره گفتش همی جنگجوی",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
