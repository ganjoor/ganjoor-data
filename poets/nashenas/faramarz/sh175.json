    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "یکی تاج با طوق و با گوشوار",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: یک تاج زیبا با نوار و گوشواره، همانند تختی از فیروزه و با تشریفات خاص."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "همان تخت فیروزه زرنگار",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "فرامرز را داد شاه جهان",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: شاه جهان به فرامرز گفت: ای روشن روان و دلیر، تو را می‌سپارم."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "بدو گفت کای گرد روشن روان",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "نگر تا نیاری به بیداد،دست",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: حواست باشد که به ظلم و ستم متوسل نشوی، زیرا دنیا جایی برای آرامش و سکون نخواهد بود."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "که دنیا نباشد سرای نشست",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "هرآن کس که باتو کند کارزار",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: هر کسی که با تو به جنگ بیاید، باید از مرز و ارتشش نابود شود."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "برآور ز مرز و سپاهش دمار",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "دل زیردستان میازار هیچ",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: به هیچ‌عنوان دل زیردستان را نران، چرا که بعداً عواقب دردناک و سختی را مشاهده خواهی کرد."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "کزین پس ببینی بسی درد و پیچ",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "به هر جایگه یار درویش باش",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: در هر مکانی مانند دوست و یار درویش باش و با دهقان بیچاره همانند خودت رفتار کن."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "به دهقان بیچاره چون خویش باش",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "چنان کن که هر جا که نامت برند",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: هر چقدر که از تو یاد کنند، به خوبی و به نیکی از تو یاد کنند و در مورد تو همواره صحبت‌های مثبت و خوشایند بگویند."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "به نیکی به تن آفرین گسترند",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "زمین را ببوسید در پیشگاه",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: زمین را در برابر او بوسید و به او گفت: ای پادشاه معروف و سرشناس."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "بدوگفت کای نامور پادشاه",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "زپیمان شاه جهان نگذرم",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: به هیچ وجه از عهد و پیمان خود با پادشاه جهان خارج نخواهم شد، در هر کجا که باشم، زیرا من همیشه خدمتگزار او هستم."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "به هر جا که باشم کهین چاکرم",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "ده ودوهزار از دلیران گرد",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "CoupletSummary": "هوش مصنوعی: شاه از دلیران و دلیرمردان، ده هزار نفر را برگزید و آن‌ها را تحت فرمان خود قرار داد."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "گزین کرد شاه و مر او را سپرد",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "سپیده دمان برخروشید نای",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17,
      "CoupletSummary": "هوش مصنوعی: در آغاز سپیده‌دم، صدای شجاعانه‌ای به گوش رسید که به باد پرواز کرد."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "دلاور نشست از بر بادپای",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "سوی هندوان تیز لشکر براند",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18,
      "CoupletSummary": "هوش مصنوعی: لشکری به سوی هند حرکت کرد و در زابل به مدت دو هفته توقف کرد."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "بیامد به زابل دوهفته بماند",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "همی بود با او گو پیل تن",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19,
      "CoupletSummary": "هوش مصنوعی: پیام این بیت بیانگر این است که فردی به دیگری نصیحت و پندهایی می‌دهد و او را در جمع‌های مختلف به تعلیم و تربیت دعوت می‌کند، حتی اگر او دارای جسم و ظاهر قوی باشد. این نشان می‌دهد که حتی بزرگ‌ترین قدرت‌ها هم نیاز به نصیحت و راهنمایی دارند."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "بسی پند دادش به هر انجمن",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "که در کار،هشیار باید بدن",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20,
      "CoupletSummary": "هوش مصنوعی: در کارها باید هوشمند باشید و حواستان جمع باشد، زیرا ممکن است دشمن از غفلت شما بهره‌برداری کند."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "نباید که دشمن کند تاختن",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "دگر نامور زال سام سوار",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21,
      "CoupletSummary": "هوش مصنوعی: زال، قهرمان معروف و سوارکار، به شخصی که نامش در تاریخ مشهور است، گفت: ای پهلو، تو که نامی بزرگ داری و در کارهای بزرگی شناخته شده‌ای."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "بدو گفت ای پهلو نامدار",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "به هر کار باموبدان گفت کن",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22,
      "CoupletSummary": "هوش مصنوعی: هر کاری را با مشورت و نظر بزرگترها انجام بده، سپس بر اساس آن مشورت، تصمیم نهایی خود را بگیر."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "پس آنگه بدان رای خود جفت کن",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "نباید که آسیب یابی ز دهر",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23,
      "CoupletSummary": "هوش مصنوعی: نباید از روزگار آسیب ببینی؛ چون خوشی و شادی تو به خاطر روزگار است."
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "همان خرمی بادت از دهر،بهر",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "و دیگر ز هر نیک و بد کایدت",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24,
      "CoupletSummary": "هوش مصنوعی: هر چیز خوب و بدی که به تو می‌رسد، باید به ما گزارش دهی."
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "فرستاده نزدیک ما بایدت",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "پذیرفت گفت نیا وپدر",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25,
      "CoupletSummary": "هوش مصنوعی: او قبول کرد و گفت که نیا، سپس پدر زمین را بوسید و به در رفت."
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "زمین را ببوسید وآمد به در",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "وز آن جا به قنوج شد با سپاه",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26,
      "CoupletSummary": "هوش مصنوعی: از آنجا به قنوج رفت و با لشکر جهان که به خاطر او دلی شاد و خوش دارند."
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "جهان گشته از دل،ورا نیکخواه",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "چوآمد،برآسود وخرم بزیست",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27,
      "CoupletSummary": "هوش مصنوعی: زمانی که او وارد شد، آسوده و خوشحال زندگی کرد و به شکار پرداخت و از زندگی لذت برد."
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "به نخجیر و رامش همی کرد زیست",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    }
  ]
}
