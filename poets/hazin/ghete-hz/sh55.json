      "Position": "Right",
      "Text": "کج اگر باخت ناکسی چه عجب؟",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "کو نداند یسار را ز یمین",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
