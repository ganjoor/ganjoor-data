      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "از غم من مکن پریشان دل",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "که مبادت ز چرخ، چین به جبین",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
