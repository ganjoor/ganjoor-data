    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "کام قلم، قافیه سنجی گرفت",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17,
      "CoupletSummary": "هوش مصنوعی: کام قلم به سنجیدن قافیه پرداخت و قلمی که از نژاد روم، یعنی سپید، است، زلف زنگی، یعنی سیاهی مرکب، را به دست گرفت."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "روم نسب، طرّهٔ زنجی گرفت",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "خطبهٔ معنی، به مرادم نشد",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18,
      "CoupletSummary": "هوش مصنوعی: خطبهٔ معنی چنان که می‌خواستم ادا نشد، تا آنکه دل خود را حل کردم و مرکبِ قلمم ساختم."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "تا دل حل کرده، مدادم نشد",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "شانه صفت، سینه به صد زخم خست",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19,
      "CoupletSummary": "هوش مصنوعی: مانند شانه، سینه‌ام را با صد زخم خستم تا سرانجام سر زلف سخن به دستم آمد؛ یعنی سخن نیکو با رنج فراوان به دست می‌آید."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "تا سر زلف سخن آمد به دست",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "لاله صفت، نازده از خون ایاغ",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20,
      "CoupletSummary": "هوش مصنوعی: تا مانند لاله جام را از خون دل پر نکنی، نمی‌توانی دامن خود را از باغ پر از گل کنی؛ بی‌رنج و خون دل، بهره‌ای به دست نمی‌آید."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "گل نتوان کرد به دامن ز باغ",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "صبح شد ای ساقی مشکینه موی",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21,
      "CoupletSummary": "هوش مصنوعی: ای ساقی مشکین‌موی، صبح شد؛ جامی از آن بادهٔ خورشیدرو بیاور."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "جامی از آن بادهٔ خورشید روی",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "باز بپیما به حزین خراب",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22,
      "CoupletSummary": "هوش مصنوعی: باز هم به حزینِ مست و خراب باده بپیما تا از قلم او آفتاب سخن بدمد."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "تا دمد از خامهٔ او آفتاب",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    }
  ]
}
