  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "کلّ ما فی الوجود لیس سواه",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: تمام آنچه در هستی وجود دارد، جز او نیست. هیچ معبودی جز خداوند یگانه وجود ندارد."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "وحده لا اله الّا الله",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "دیده گر مغز بیند و گر پوست",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: اگر چشم تاریک را ببینند، فقط پوست و ظاهر را می‌توانند مشاهده کنند، اما اگر به حقیقت و عمق ببینند، به وجود و خالق آن پی می‌برند."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "رقم آفریدگاری اوست",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "شجر طور هستی، انسان شد",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: درخت وجود انسان، جلوه‌گاه زیبایی‌های الهی و مقام مقدس است."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "جلوه گاه جمال سبحان شد",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "آن شجر را زبان چو بار آمد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: آن درخت زمانی که میوه‌اش پربار شد، به حقیقت وجود خداوند متصل شد."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "وقت توحید کردگار آمد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "متعالی ز وصمت اطلاق",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: وجودی عالی و بی‌نقص در خود و در دنیای بیرون به وضوح نمایان می‌شود."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "متجلی در انفس و آفاق",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "ازلش تا ابد دو تا نبود",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: از آغاز تا همیشه، هیچ چیز دوگانه نبوده است و جاودانگی‌اش از آغاز خلقت جدا نیست."
    },
    {
