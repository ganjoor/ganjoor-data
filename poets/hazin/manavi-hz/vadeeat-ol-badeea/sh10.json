  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "هستی بر مقیدات از حق",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: وجود به شرایط و محدودیت‌ها وابسته نیست و حقیقت واقعی از قید و بندها آزاد است."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "بی مقیّد نمی شود مطلق",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "از دو جانب فتاده استلزام",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: نیاز و درخواست ما از دو سو به ما فشار می‌آورد، اما این ضرورت به طور مداوم از یک سمت و به طور مستمر حس می‌شود."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "حاجت از یک طرف بود به دوام",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "واجب از ممکن است مستغنی",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: چیزی که وجودش ضروری و واجب است، نیازی به هیچ چیز دیگری ندارد و از چیزهای ممکن بی‌نیاز است."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "بی نیاز است و احتیاجی نی",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
