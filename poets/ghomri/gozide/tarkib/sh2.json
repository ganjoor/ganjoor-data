      "Text": "بجز خون رزان مرهم نجوید",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "کسی کاو دل زگردون ریش دارد",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "سرمن، خاک آن، کاین راه ورزد",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "دلم قربان آن، کاین کیش دارد",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "حدیث عقل کمترگو، که از عقل",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "حدیث باده، لذت بیش دارد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "در این کژدم صفت طاس نگون سر",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "که در هر دل، زغم صد نیش دارد",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "بود سودای فاسد، گرکسی را",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "غم عقل صلاح اندیش دارد",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "سبک باید که مردم کار راند",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "که روزی بس گران در پیش دارد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 15,
      "Position": "CenteredVerse1",
      "Text": "زتو گر زشت و گر خوبت سرشتند",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "SectionIndex3": 4
    },
    {
      "VOrder": 16,
      "Position": "CenteredVerse2",
      "Text": "همان آید که دی برتو نوشتند",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "SectionIndex3": 4
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "نباتی چو خط تو بستان ندارد",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "مذاق لبت شکرستان ندارد",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "همه«آنی»و ملک خوبی تو داری",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "تو این داری و جز تو، کس«آن»ندارد",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "چو گردون نیی، زانکه کین تو پیدا",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "چو روز است و، او مهر پنهان ندارد",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "خضر همچو خضرای دمنه بود خوار",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "اگر از لبت آب حیوان ندارد",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "بران آب حیوانت، شوق سکندر",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "چو ظلمات زلف تو، پایان ندارد",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "چو دل، جانت ندهم، که حاجت نداری",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "که تو جان محضی و، جان، جان ندارد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "چو خاموش باشی، برد ظن همه کس",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "که دندان چون گوهرت، کان ندارد",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    }
  ]
}
