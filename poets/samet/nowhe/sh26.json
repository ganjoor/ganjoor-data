  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "زینتِ دوشِ نبی! خاکِ سیه جایِ تو نیست",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
