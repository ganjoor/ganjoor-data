  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "مهِ شعبان گذشت و گشت عیان",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "پیکِ ماهِ مبارکِ رمضان",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ای غزل‌خوانِ من! غزل برخوان",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "غزلی تازه و به ما مستان",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 5,
      "Position": "CenteredVerse1",
      "Text": "شو به رغمِ حسود، باده‌گسار",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "کو چنان عُمر و کو چنان اقبال؟",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "که دگر باره در مَهِ شوال",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "ز غمِ روزگار، فارغ‌بال",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "بنشینیم خرّم و خوشحال",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 10,
      "Position": "CenteredVerse1",
      "Text": "صومِ خود را زِ مِی کنیم افطار!",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "دو سه روزی به روزه مانده که باز",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "خم شود قامتم ز بارِ نماز",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "حالیا از پیِ «کلوخ‌انداز»",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "ساغرِ مِی به گردش آور باز",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 15,
      "Position": "CenteredVerse1",
      "Text": "تا ز کار افکنی مرا یک‌بار",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "آن‌چنان مست کن مرا از مِی",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "که شود صومِ من به مستی طی",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "مِی به ساغر بریز پی‌درپی",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "با دف و عود و بَربَط و با نی",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 20,
      "Position": "CenteredVerse1",
      "Text": "با بَم و زیرِ چنگ و موسیقار",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "نه مِیِ دختِ رَز بُوَد غرضم",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "که بَرَد جوهر و نهد عَرَضم",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "سستی آرد به درکِ ما‌فَرضم",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "کاهد از صحت و دهد مرضم",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 25,
      "Position": "CenteredVerse1",
      "Text": "جایِ اقبال، آورد ادبار",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "خواهم از آن مِیی که کرده خدا",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "وصفِ او را به «لیلةُ‌الاسریٰ»",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "عارف و عامی از طریقِ وفا",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "کرد تفسیر، او خدا به خدا",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 30,
      "Position": "CenteredVerse1",
      "Text": "به مِیِ حُبِّ حیدرِ کرار",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "علتِ غائیِ جهانِ وجود",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "مایهٔ اعتبارِ بود و نبود",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "هر وجودی ز جودِ او موجود",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "بندهٔ پاکِ حضرتِ معبود",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 35,
      "Position": "CenteredVerse1",
      "Text": "وصیِ خاصِ احمدِ مختار",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "چمن‌آرایِ گلشنِ وهاب",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "زینت‌افزایِ منبر و محراب",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "شرفِ خاک و باد و آتش و آب",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "باعثِ رتبهٔ اولوا الالباب",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 40,
      "Position": "CenteredVerse1",
      "Text": "مردمِ دیدهٔ اولوا الابصار",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "موجِ دریایِ قدرتِ احدی",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "ثمرِ نخلِ هیئتِ صمدی",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "نعت‌ِ خوانِ نعمتِ ابدی",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "تحفهٔ زاکیاتِ «لم یلدی»",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 45,
      "Position": "CenteredVerse1",
      "Text": "باد دائم به آن جناب، نثار",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "ای ولیِ خدا! خدایی کن",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "یعنی از غیب، خودنمایی کن",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "در جهان کارِ کبریایی کن",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "از محبان گره‌گشایی کن",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 50,
      "Position": "CenteredVerse1",
      "Text": "روبهان جمله گشته شیرِ شکار!",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "کربلا بر حسینت ای سَرور!",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "تنگ شد آن‌قدر ز جورِ قَدر",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "که لبِ خشک با دو دیدهٔ تر",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "شد ز شمشیرِ شِمرِ دون، بی‌سر",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 55,
      "Position": "CenteredVerse1",
      "Text": "دادرس بهرِ وی نبُد دیار",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "هر چه گفت: ای ستمگران! رحمی",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "می‌دهم بهرِ آب، جان؛ رحمی",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "کَس چو من نیست در جهان، رحمی",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "که به دشمن بَرَد امان، رحمی",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 60,
      "Position": "CenteredVerse1",
      "Text": "سنگ، خون گرید از چنین گفتار",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "لیک بر شمرِ دون نکرد اثری",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "گرچه آهش بسوخت هر جگری",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "یا علی! گر تو داشتی خبری",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "همچو «صامت» مدام نوحه‌گری",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 65,
      "Position": "CenteredVerse1",
      "Text": "بود کارِ تو تا به روزِ شمار",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    }
  ]
}
