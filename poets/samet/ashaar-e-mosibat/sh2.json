      "Text": "شاهِ قریشی‌نژاد و هاشمی‌افسر",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "سیدِ بطحاشرافت و مدنی‌فر",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "میرِ «لَعَمْرُک»‌سریر و «یاسین»‌مظهر",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "سرورِ «اَسرا»‌مقام و «طاها»‌منظر",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 20,
      "Position": "CenteredVerse1",
      "Text": "باعثِ ایجادِ هر چه مخفی و موجود",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "ملکِ نبوَت به سعیِ حضرتش آباد",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "کشورِ دین از او قوی شده بنیاد",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "همچو خدا بی‌شریک و همره و انباز",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "هستیِ کَونَین را وسیلهٔ ایجاد",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 25,
      "Position": "CenteredVerse1",
      "Text": "خلقتِ افلاک را نتیجهٔ موجود",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "مسقطُ‌الراسش به خاکِ پاکِ تهامه",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "زیبِ جهانِ وجود و زینِ قیامه",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "صانعِ امکان چو شد محرکِ خامه",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "در ورقِ صنع، حرفِ اولِ نامه",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 30,
      "Position": "CenteredVerse1",
      "Text": "نامِ نکویش نوشت خالقِ معبود",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "آئینهٔ حق‌نمایِ ذاتِ قدیم است",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "رحمتِ بی‌منتها و ذاتِ عظیم است",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "دُرِّ یتیمِ بحارِ لطفِ کریم است",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "بر دلِ احبابِ نور، طورِ کلیم است",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 35,
      "Position": "CenteredVerse1",
      "Text": "در تنِ اعداء، شرارِ آتشِ اخدود",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "آیتِ ذات و صفاتِ حضرتِ باری",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "در تنِ اشیاء چو روح، ساری و جاری",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "از دمِ سبابه بهرِ معجزه‌کاری",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "شق‌ِ قمر کرد تا که در شبِ تاری",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 40,
      "Position": "CenteredVerse1",
      "Text": "تیره کند روزِ خصمِ کافرِ مردود",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "ای شده در دفترِ تو ختمِ رسالت!",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "آمده از کبریات شرطِ جلالت",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "کارِ شفاعت به عهدهٔ تو حوالت",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "قربِ تو را طالبم که در همه حالت",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 45,
      "Position": "CenteredVerse1",
      "Text": "کویِ تو خوش‌تر مرا ز جنتِ موعود",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "ای سببِ بودِ خلق، جودِ وجودت",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "نیست تفاوت میانِ غیب و شهودت",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "زندگیِ کائنات جمله ز جودت",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "ساخت نزولِ وجود، عرش‌ صعودت",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 50,
      "Position": "CenteredVerse1",
      "Text": "شاهدِ حق را به ماسویٰ همه مشهود",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "قاسمِ اشیاء چه دستِ فیض گشاده",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "بهرهٔ «صامت» ز فضل، کرده زیاده",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "هم به دلم مهرِ تو ودیعه نهاده",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "هم به کَفم اختیارِ مدحِ تو داده",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 55,
      "Position": "CenteredVerse1",
      "Text": "شکر ز بختِ بلند و طالعِ مسعود",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    }
  ]
}
