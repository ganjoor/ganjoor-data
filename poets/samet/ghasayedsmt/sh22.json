      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "گیری شبها عروس غفلت در بر",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
