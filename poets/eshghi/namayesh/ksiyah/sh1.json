      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "خانه بیوه زنی، تنگ‌تر از خانه دل",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "باری آن خانه بدو یک باره",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 36,
      "Position": "CenteredVerse1",
      "Text": "داد آنهم به منش یک باره",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "خانه، جز بیوه زن و کهنه جلی هیچ نداشت",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "بیوه زن رفت و فقط کهنه جلی باز گذاشت",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "پیرمردی ز کسانش به حضورم بگماشت",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "خانه بی شمع و سیه پرده تاریکی چاشت",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "به نظر گاهی من منظر گوران افراشت",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "خانه آباد که اندک مهتاب",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 43,
      "Position": "CenteredVerse1",
      "Text": "سر زد از خانه آن خانه خراب",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "جوئی از نور مه، از پنجره‌ئی در جریان",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "رویش اسپید که روی سیه شب ز میان:",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "برد و از پنجره شد قلعه‌یی از دور عیان",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "باشکوه آنقدر آن قلعه که ناید به بیان",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "لیک ویرانه چو سر تا سر آثار کیان",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "پیر بنشسته بر پنجره، من:",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 50,
      "Position": "CenteredVerse1",
      "Text": "گفتمش: ماتم ازین منظره من!",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "(من): آن خراب ابنیه کز پنجره پیداست کجاست؟",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "خیره بر پنجره شد پیر و به زانو برخاست",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "گفت: آن قلعه که مخروبه آبادی ماست",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "دیرگاهیست که ویران شده و باز بپاست",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "ارگ شاهنشهی و بنگه شاهان شماست",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "این «مهاباد» بلند ایوان است",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 57,
      "Position": "CenteredVerse1",
      "Text": "که سرش همسر با کیوان است",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "نه گماندار: مهاباد، همین این بوده؟",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "نه مهاباد صد اینگونه به تخمین بوده!",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 60,
      "Position": "Right",
      "Text": "فصل دی خرم و گردشگه پیشین بوده",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "قصر قشلاقی شاهان مه آئین بوده",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 62,
      "Position": "Right",
      "Text": "حجله و کامگه خسرو و شیرین بوده",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "لیکن امروز مهابادی نیست",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 64,
      "Position": "CenteredVerse1",
      "Text": "دیگر این کوره ده، آبادی نیست!",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "حرف آخرش همین بود و ز در بیرون شد",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "لیک از این حرف چه گویم که دل من چون شد؟",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "یاد شد وقعه خونینی، وز آن دل خون شد",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "گوئی آن جنگ عرب در دل من اکنون شد!",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 69,
      "Position": "CenteredVerse1",
      "Text": "و آن وقوعات، چنان با نظرم مقرون شد",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 70,
      "Position": "Right",
      "Text": "که شد آن قلعه دگر وضع دگر",
      "CoupletIndex": 40,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 71,
      "Position": "Left",
      "Text": "منظر دیگرم آمد به نظر:",
      "CoupletIndex": 40,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    }
  ]
}
