      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "بر سر خاک سر خلق، قدم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "هشتم آن شب بسی القصه قدم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "نخل‌ها: سایه به همسایگی‌ام گسترده",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "باد آن سایه گه آورده و گاهی برده",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "من در این وسوسه، از منظره این پرده",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "روح اموات است این‌ها که تجلی کرده",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 25,
      "Position": "CenteredVerse1",
      "Text": "که حضور منشان در هیجان آورده",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "چه ازین روی همی جنبندی",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "گه جهندی و گهی خسبندی",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "باد در غرش و از قهر درختان غوغاست",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "همه‌سو ولوله و زلزله و واویلاست",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "خاک اموات بشد گرد و به گردون برخاست",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "صد هزار آه دل مرده، در این گرد هواست",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 32,
      "Position": "CenteredVerse1",
      "Text": "مرده‌دل، منظر نخلستان از این گردفناست",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "نامه مرگ همانا هر برگ",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "هر درختی دو هزار آیت مرگ",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "باد، هی برگ درختان به چمن می‌بارد",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "مرگ، گو نامه دعوت سر من می‌بارد",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "بس ز سیمای فلک، داغ کهن می‌بارد",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "از سفیدی، مه، آثار محن می‌بارد",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 39,
      "Position": "CenteredVerse1",
      "Text": "برف مرگ است و یا ابر کفن می‌بارد",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "باری این صحنه، پر از وحشت و موت",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "گوش من کر شده از کثرت صوت",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "این زمین: انجمن خلوت خاموشان است",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "بستر خفتن داروی عدم نوشان است",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "مهد آسودن از یاد فراموشان است",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "جای پیراهن یکتای بتن پوشان است",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 46,
      "Position": "CenteredVerse1",
      "Text": "این خرابات پر از کله مدهوشان است",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "چشم این خاک ز هر چیز پرست",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "مرده شویش ببرد مرده خورست",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "بر سر نعش پسر، شیون مادر دیده",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "نوعروسان به کفن، در بر شوهر دیده",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "سال‌ها بوده که از اشک زمین تر دیده",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "پیر هفتاد به عمر، آنچه سراسر دیده",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 53,
      "Position": "CenteredVerse1",
      "Text": "این بهر هفته، هفتاد برابر دیده",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "من در این فکرت و هی باد افزود",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "گوشم از خاک «مه آباد» آلود",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    }
  ]
}
