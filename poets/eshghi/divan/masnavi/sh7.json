  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "خری از گلستان باغی گذشت",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "بسی گل به ره دیده، وقعی نهشت",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "نسنجید کآن جلوه گل، ز چیست؟",
