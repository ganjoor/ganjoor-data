      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "وآنگه این ریش دم گامیش چیست؟",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "کاین چنین در صورتت گلناری است!",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "گفت این ریشی که بینی ریش نیست:",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "ریشخند مردم بازاری است!",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "تازه در خط وکالت رفته‌ام",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "با عوامم عزم خوش‌رفتاری است!",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "گفتمش: تغییر «اونیفورم» هم",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "در وکالت، چون نظام اجباری است؟",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "هشتی عمامه، کله برداشتی!",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "گفت: این رسم کله‌برداری است!",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "وین لباس و هیکل مردم‌فریب",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "اولین فرمول مردم‌داری است!!",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "ریش انباری ز رأی مردم است",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "رأی مردم اندر آن انباری است",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "اولین شرط وکالت: ریش و آنک",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "می‌تراشد از وکالت عاری است",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "دیدمش آنگه که می‌گفت این سخن",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "آبی از بینی به ریشش جاری است",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 47,
      "Position": "CenteredVerse1",
      "Text": "کاولین شرطش کثافت‌کاری است!",
      "CoupletIndex": 23,
