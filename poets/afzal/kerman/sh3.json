    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "ز بیم جان همی تن کرد پنهان",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "چو دراج از پس خس‌ها غضنفر",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "زمین دریای موج‌افکن شد از خون",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "در او کشتی سوار و کشته لنگر",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "اجل با زوزنان هر سو همی‌رفت",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "به خون اندر چو مرد آشناور",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "جهانی دیده بر خسرو نهاده",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "به تیر و نیزه از دیوار و از در",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "ز شه برج ار قضا را چرخ داری",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "ملک را یافت در میان برابر",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "ز خون شمشیر هندی بر کفش لعل",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "ز خوی خفتان رومی بر تنش تر",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "چو آتش چرخ را پر کرد و بشتافت",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "کز آتش بیند او پاداش و کیفر",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "بزد بر باره برگستوان‌ دار",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "خدنگ راست‌رو برگستوان‌در",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "ز زخم تیر تا پای خداوند",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "به دستی مانده بد یا نیز کمتر",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "ز دیگر سو به آن سو تیر بگذشت",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "که از تیری نیالودش به خون پر",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "ملک چون سرو و گل نازان و خندان",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "نشاطی بادپایی خواست دیگر",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "ملایک در هوا آواز دادند",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "ز شادی و شگفت الله اکبر",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "ز فر ایزد از آثار دولت",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "نشانی باشد این واضح نه مضمر",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "دو پیکر بود اسب و مرد جنگی",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "بسوزانی و تیزی برق و صرصر",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "به زخم اندر چه داند تیر پیچان",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "تفاوت جستن از پیکر به پیکر",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "به گیتی زآب و آتش خیره‌تر نیست",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "دو جانور یار شیطان ستمگر",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "سیاوش را و خسرو را نیازرد",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "چو فر ایزدی دید آب و آذر",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "تهور گر نه بد بودی ز شاهان",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "نه جوشن داردی در کین نه مغفر",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "چه باید مغفر از آهن مر آن را",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "که یزدان داده باشد مغفر از فر",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 60,
      "Position": "Right",
      "Text": "ایا شاهی که شخصت را بیاراست",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "به عقل و حلم یزدان پیکر و بر",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 62,
      "Position": "Right",
      "Text": "فزون شد دولتت تا بازگشتی",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "ز جنگ سگزیان دیو منظر",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 64,
      "Position": "Right",
      "Text": "توان بردن هنوز از جنگ جایت",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Left",
      "Text": "دریده زهره سگزی به زنبر",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 66,
      "Position": "Right",
      "Text": "از اکنون تا پسین روزی ز گیتی",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Left",
      "Text": "بر آن خاک ار فرود آید کبوتر",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 68,
      "Position": "Right",
      "Text": "بس آغاز خون کز دانه چیند",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Left",
      "Text": "طبرخون رویدش از حلق و زاغر",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 70,
      "Position": "Right",
      "Text": "چنان کردی که بر ایوان شاهان",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Left",
      "Text": "به جای جنگ گاه رستم زر",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 72,
      "Position": "Right",
      "Text": "از این پس مر تو را در زین نگارند",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Left",
      "Text": "تن تنها دریده قلب لشکر",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 74,
      "Position": "Right",
      "Text": "به عون رخش و زال و تیر سیمرغ",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Left",
      "Text": "ز یک تن کرد رستم پاک کشور",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 76,
      "Position": "Right",
      "Text": "تو تنها گر بکوشی با سپاهی",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Left",
      "Text": "چو قوم عاد در بالای صرصر",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 78,
      "Position": "Right",
      "Text": "چنانشان باز گردانی که از بیم",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Left",
      "Text": "برادر سبق جوید بر برادر",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 80,
      "Position": "Right",
      "Text": "تو را سیمرغ و تیر گز نباید",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Left",
      "Text": "به رخش جادو زال فسونگر",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 82,
      "Position": "Right",
      "Text": "ز مردی و جگر نگذاشت باقی",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 83,
      "Position": "Left",
      "Text": "مصور بر تو ای زیبا مصور",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 84,
      "Position": "Right",
      "Text": "الا این نامور شاهی که هستی",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 85,
      "Position": "Left",
      "Text": "ز شاهان در هر انواعی مخیر",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 86,
      "Position": "Right",
      "Text": "ز سهم افزای کاری بازگشتی",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 87,
      "Position": "Left",
      "Text": "که آن با دیده کس را نیست باور",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 88,
      "Position": "Right",
      "Text": "ز خفتان معصفر بند بگشای",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 89,
      "Position": "Left",
      "Text": "ز ساقی باده‌ای بستان معصفر",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 90,
      "Position": "Right",
      "Text": "به جای جوشن اندر پوش قاقم",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 91,
      "Position": "Left",
      "Text": "به جای نیزه بر کف گیر ساغر",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 92,
      "Position": "Right",
      "Text": "قدح بر کف نه و عنبر همی بوی",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 93,
      "Position": "Left",
      "Text": "برافروز آتشی چون چشم عبهر",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 94,
      "Position": "Right",
      "Text": "اگر بستان آزاری به پژمرد",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 95,
      "Position": "Left",
      "Text": "به آذر بوستانی کن ز آذر",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 96,
      "Position": "Right",
      "Text": "ایا شاهی که از نظم مدیجت",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 97,
      "Position": "Left",
      "Text": "نگردد سیر طبع مدح‌گستر",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 98,
      "Position": "Right",
      "Text": "مرا از نظم در خاطر عروسی است",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 99,
      "Position": "Left",
      "Text": "که از مدح تو خواهد نقش و زیور",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 100,
      "Position": "Right",
      "Text": "بسا کاشعار من در مدحت تو",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 101,
      "Position": "Left",
      "Text": "بخواهد گشتن از دفتر به دفتر",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 102,
      "Position": "Paragraph",
      "Text": "و این قصیده شصت و چهار بیت است همه بر این نظم و اسلوب.",
      "CoupletIndex": 51
    },
    {
      "VOrder": 103,
      "Position": "Paragraph",
      "Text": "و سلطان‌شاه را بعد از قتل قاوردشاه میل کشیدند اما سلطان‌شاه را بنا بر تقدیر سمیع بصیر آینه بصر از آه قصد تیره نشد و بادام بصر از سنگ تکحیل شکسته نشد. و او را شخصی از حشم پدرش از لشکرگاه ملک‌شاه بدزدید و بر پشت خود او را باز کرمان رسانید. و در کرمان، کرمان‌شاه که پدر او را به جای خود نشانده بود همه کلبه دنیا را وداع کرده بود و به گوشه عقبی رفته.",
      "CoupletIndex": 52
    },
    {
      "VOrder": 104,
      "Position": "Paragraph",
      "Text": "و امیرحسین طفل بود مهد او را بر تخت می‌نهادند و بارها می‌دادند و دیگر پسران او در قلاع بودند قلعه کوچک که آن را گوهریه خوانند و چند جا نام عمر و مردان‌شاه بن قاورد بر دیوار نبشته است.",
      "CoupletIndex": 53
    },
    {
      "VOrder": 105,
      "Position": "Paragraph",
      "Text": "چون رکن الدوله سلطان‌شاه برسید در ماه صفر سنه سبع و ستین و اربعمائه (۴۶۷) تخت ملک موروثی را به زینت فر خویش بیاراست و امور ممالک را در نصاب تقویم قرار داد. چون مدت یک سال بگذشت سلطان ملک‌شاه بنابر حرکت قاورد به قصد استیصال نهال اقبال خاندان قاوردی عزم کرمان فرمود و هفده روز بر در شهر بردسیر کرمان بود و سلطان‌شاه در لباس خضوع به قدم خشوع پیش آمد و گفت مرا چهل خواهر است که به حکم خویش همه محرم تواند. کرم سلطان جهان روا ندارد که به دست خربندگان لشکرگاه افتند.",
      "CoupletIndex": 54
    },
    {
      "VOrder": 106,
      "Position": "Paragraph",
      "Text": "بعد از تردد سفر او استشفاع امراء و وزراء چون سلطان سوگند خورده بود که شهر کرمان را خراب کند تصدیق سوگند او را، یک برج از قلعه‌ای کهنه که آن را برج فیروزه می‌خوانند و این ساعت هنوز خراب است، خراب کردند.",
      "CoupletIndex": 55
    },
    {
      "VOrder": 107,
      "Position": "Paragraph",
      "Text": "و سلطان بعد از آن که هفتده روز بر در بردسیر مقام کرده بود بازگردید.",
      "CoupletIndex": 56
    },
    {
      "VOrder": 108,
      "Position": "Paragraph",
      "Text": "سلطان‌شاه پادشاهی بود عشرت دوست و در مدت ده سال که پادشاه کرمان بود غیرت عشرت با امری دیگر نپرداخت و در عهود او حدوث واقعه‌ای مأثور نیست و در آخر عهد ملک او از برادران او در کرمان توران‌شاه مانده بود و او را به جانب بم فرستاد، نه بر طریق نیابت بل به حکم استهانت چه ملک توران‌شاه در میان زنان پرورده شده بود و تضاعیف شمایل او جنس بی‌سنتی بود و اکثر سخن به زبان کرمانی گفتی و سلطان‌شاه و دیگران از وی حساب پادشاهی بر نمی‌گرفتند.",
      "CoupletIndex": 57
    }
  ]
}
