      "Text": "گر به دو عالم دهی ارزان دهی",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "سدره ز آرایشِ صدرت زهی‌ست",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "عرش در ایوان تو کرسی نهی‌ست",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "روزن حاجت چو بود صبح‌تاب",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "ذره بود عرش در آن آفتاب",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "گر نه ز صبح آینه بیرون فتاد",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "نور تو بر خاک زمین چون فتاد‌‌",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "ای دو جهان، زیر زمین از چه‌ای؟",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "گنج نه‌ای خاک‌نشین از چه‌ای؟",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "تا تو به خاک اندری ای گنج پاک",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "شرط بود گنج سپردن به خاک",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "گنج ترا فقر تو ویرانه بس",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "شمع ترا ظِلِّ تو پروانه بس",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "چرخ مقوس هدف آه تست",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "چنبر دلوَش رسن چاه تست",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "این‌دو طرف گرد سپید و سیاه",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "راه تو را پیک ز پیکان راه",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "عقل شفاجوی و طبیبش تویی",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "ماه سفرساز و غریبش تویی",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "خیز و شب منتظر‌ان روز کن",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "طبع نظامی طرب‌افروز کن",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 34
    }
  ]
}
