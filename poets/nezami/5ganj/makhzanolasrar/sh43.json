  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "با دو حکیم از سر هم‌خانگی",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "شد سخنی چند ز بیگانگی",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "لاف منی بود و توی برنتافت",
