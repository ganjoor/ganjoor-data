      "Position": "Right",
      "Text": "فلاطون چو در رفتن‌آمد چه گفت",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "که ما نیز در خاک خواهیم خفت",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "چنان شد حکایت در آن مرز و بوم",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "که بالغ‌ترین کس منم ز‌اهل روم",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "چو در پردهٔ مرگ ره‌یافتم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "ز هر پرده‌ای روی برتافتم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "بدان طفل مانم که هنگام خواب",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "به گهوارهٔ خوابش آید شتاب",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "به خفتن مَنَش رهنمون آیدش",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "نداند که این خواب چون آیدش",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "درین چار طبع‌ِ مخالف‌نهاد",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "که آب آمد و آتش و خاک و باد",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "چگونه توان راستی یافتن",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "ز کژی بباید عنان تافتن",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "بوَد چار دیوار آن خانه سست",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "که بنیادش اول نباشد درست",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "گذشت از صد و سیزده سال‌ِ من",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "به ده سالگان مانَد احوال من",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "همان آرزو خواهی‌ام در سر است",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "کهن من شدم‌، آرزو نوتر است",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "بدین آرزو چون زمانی گذشت",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "فلک فرش او نیز هم درنوَشت",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "مغنی به یاد آر بر یاد من",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "سرودی بر آهنگ فریاد من",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "بکن شادم از شادی آن سرود",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "مگر بگذرم زاب این هفت رود",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "چو والیس را سر درآمد به خواب",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "درافکند کشتی به طوفان آب",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "نشسته رفیقان یاریگرش",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "به یاریگری چون فلک بر سرش",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "چو بر ناتوان یافت تیمار دست",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "تنومند را ناتوانی شکست",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "ز نیروی طالع خبر باز جست",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "بناهای اوتاد را یافت سست",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "ستاره دل از داد برداشته",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "ستمگر شده داد بگذاشته",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "به آن هم‌نشینان که بودند پیش",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "خبر داد از اندازه عمر خویش",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "چنین گفت کایمن مباشید کس",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "از این هفت هندوی کحلی جرس",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "که این اختران گرچه فرخ پیند",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "ز نافرخی نیز خالی نیند",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "چو نحس اوفتد دور سیارگان",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "بود دور دور ستمکارگان",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "شمار ستم تا نیاید به سر",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "به گیتی نیاید کسی دادگر",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "چو باز اختر سعد یابد قران",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "به نیکی رسد کار نیک‌اختران",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "فلک تا رسیدن بدان بازگشت",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "ورق‌های ما باری اندر نوشت",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "چو گفت این‌، پناهنده را کرد یاد",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "فروبست لب‌، دیده برهم نهاد",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    }
  ]
}
