  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "چو ختم سخن قرعه بر شاه زد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "سخن سکهٔ قدر بر ماه زد",
