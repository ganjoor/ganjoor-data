      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "سر اگر پیش بت سجود کند",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "نیست نقصان چو دل بود با یار",
