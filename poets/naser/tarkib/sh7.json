      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "SectionIndex3": 6
    },
    {
      "VOrder": 48,
      "Position": "CenteredVerse2",
      "Text": "هرچه جز عاشقی‌ست هیچ انگار",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "SectionIndex3": 6
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "دل که از درد دوست خالی ماند",
