      "Text": "سایه گوید ز نور خود ناچار",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "گر نباشد از آن دهان سخنم",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 70,
