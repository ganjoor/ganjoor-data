      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "نیست عشق آنچه در بیان آید",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "فرق باشد ز دیده تا گفتار",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "گر چه اظهار عاشق از عشق است",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "عشق ظاهر نگردد از اظهار",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "گر همه عمر وصف عشق کنیم",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "گفته باشیم قطره‌ای ز بحار",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "زان دهان است گفتهٔ ناصر",
