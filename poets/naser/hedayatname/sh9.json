      "Text": "متاعی ز هر جانب آوردمی",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "یکی وقت با کاروانی عظیم",
