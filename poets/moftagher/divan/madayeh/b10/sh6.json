      "HtmlText": "\u003Cdiv class=\u0022b\u0022 id=\u0022bn1\u0022\u003E\u003Cdiv class=\u0022m1\u0022\u003E\u003Cp\u003Eاز هزاران غم نهانی تو\u003C/p\u003E\u003C/div\u003E\r\n\u003Cdiv class=\u0022m2\u0022\u003E\u003Cp\u003Eعزیز مادر\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E",
      "CoupletsCount": 1,
      "MetreId": 9,
      "MetreRefSectionIndex": 0
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ای بقربان جانفشانی تو",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: ای فرزند عزیزم، جانم فدای جان‌فشانی و فداکاری تو باد."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "عزیز مادر",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "شام شد صبح زندگانی تو",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: صبح زندگی تو هنوز آغاز نشده به شام رسید و عمر جوانت زود به پایان آمد."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "عزیز مادر",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "یک چمن لاله رفت و کرد داغم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: مادر می‌پرسد آیا باغی پر از لاله از دست رفت که از غم و غصه بر دلم داغ گذاشت؟"
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "ز غصه و غم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "یا گل روی ارغوانی تو",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: یا آنچه از دست رفت چهرهٔ گلگون و ارغوانی تو بود؟ یعنی رفتن روی تو برابر نابودی گلزاری است."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "عزیز مادر",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "یک فلک شد ز آفتاب خاور",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: آیا آسمانی که خورشید از مشرقش برآمده بود در خون غرق شد؟"
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "بخون شناور",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "یا رخ ماه آسمانی تو",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: یا چهرهٔ ماه‌گون تو بود که در خون فرو رفت؟"
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "عزیز مادر",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "یک جهان صورت از صحیفۀ حسن",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: جهانی از صورت‌های زیبا که از کتاب زیبایی برآمده بود، ای لطیفه و یادگار حسن،"
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "لطیفۀ حسن",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "رفت با یک جهان معانی تو",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: همراه جهانی از معنا و کمالی که در تو بود از دست رفت. در «حسن» به امام حسن، پدر قاسم، نیز اشاره شده است."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "عزیز مادر",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "یک یمن از عقیق بی صفا شد",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: آیا سرزمین یمن، با همهٔ عقیقش، بی‌رونق شد و عقیقش مانند کهربا زرد و بی‌رنگ گشت؟"
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "چه کهربا شد",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "یا عقیق لب یمانی تو",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: یا لب سرخ تو، که چون عقیق یمنی بود، از تشنگی رنگ باخت؟"
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "عزیز مادر",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "حجله ات را بخون نگار بستم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: حجلهٔ عروسی تو را با خون آراستم و خود در خون و ماتم نشستم."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "بخون نشستم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "وای از این سور و کامرانی تو",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: دریغ و فریاد از این جشن عروسی و کامروایی تو که به عزا تبدیل شد."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "عزیز مادر",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "آرزوهای من برفت از دل",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: همهٔ آرزوهایم از دلم رفت و با تو در خاک فرو شد."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "برفت در گل",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "داد از این مرگ ناگهانی تو",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: فریاد از این مرگ ناگهانی تو."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "عزیز مادر",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "شاخ شمشاد من شدم زمین گیر",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "CoupletSummary": "هوش مصنوعی: ای شاخهٔ شمشاد من، از سوز غم پیر و زمین‌گیر شدم،"
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "ز سوز غم پیر",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "چون بیاد آورم جوانی تو",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17,
      "CoupletSummary": "هوش مصنوعی: هر بار که جوانی تو را به یاد می‌آورم."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "عزیز مادر",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "حلقۀ سور شد محیط ماتم",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18,
      "CoupletSummary": "هوش مصنوعی: حلقهٔ جشن عروسی به دایره‌ای از ماتم بدل شد و همهٔ جهان را فرا گرفت."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "فضای عالم",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "شد غم و غصه شادمانی تو",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19,
      "CoupletSummary": "هوش مصنوعی: شادمانی تو به غم و غصه تبدیل شد."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "عزیز مادر",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "غنچۀ لب ز گفتگو به بستی",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20,
      "CoupletSummary": "هوش مصنوعی: غنچهٔ لبت را از سخن گفتن بستی و با این خاموشی دلم را زخمی کردی."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "مرا بخستی",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "جان به قربان خوش زبانی تو",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21,
      "CoupletSummary": "هوش مصنوعی: جانم فدای شیرین‌زبانی تو باد."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "عزیز مادر",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "نخلۀ طور من ز تشنگی سوخت",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22,
      "CoupletSummary": "هوش مصنوعی: ای نخل طور من، از تشنگی سوختی و با این سوختن مرا هم به آتش کشیدی."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "مرا بیفروخت",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "سوز آهنگ لم ترانی تو",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23,
      "CoupletSummary": "هوش مصنوعی: سوز ناله و آهنگ «لن ترانی» تو مرا شعله‌ور کرد. «لن ترانی» یعنی «هرگز مرا نخواهی دید» و اشاره به داستان موسی در طور است؛ یعنی دیگر تو را نخواهم دید."
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "عزیز مادر",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "زیر سم سمند کین چنانی",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24,
      "CoupletSummary": "هوش مصنوعی: زیر سم اسبان دشمنان کینه‌توز چنان پایمال شده‌ای که نشانی از تو نمانده است."
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "که بی نشانی",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "ای دریغا ز بی نشانی تو",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25,
      "CoupletSummary": "هوش مصنوعی: دریغ از اینکه حتی نشانی از تو باقی نماند."
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "عزیز مادر",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "سایۀ سرت آرزوی من بود",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26,
      "CoupletSummary": "هوش مصنوعی: آرزویم این بود که سایهٔ تو بر سرم باشد، اما سر تو بر نیزه نمایان شد."
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "سر تو بنمود",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "شد سر نیزه سایبانی تو",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27,
      "CoupletSummary": "هوش مصنوعی: سر نیزه سایه‌بان و جایگاه سر تو شد."
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "عزیز مادر",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "از غمت قامتم دوتا شد ای رود",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28,
      "CoupletSummary": "هوش مصنوعی: ای فرزندم، از غم تو قامتم خمیده شد. ای فرزندم، کجا رفت"
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "کجا شد ای رود",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "دلنوازی و مهربانی تو",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29,
      "CoupletSummary": "هوش مصنوعی: آن دل‌نوازی و مهربانی تو؟"
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "عزیز مادر",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "من به بند غمت چنان اسیرم",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30,
      "CoupletSummary": "هوش مصنوعی: چنان در بند غم تو گرفتارم که تا زمان مرگ"
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "که تا بمیرم",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "دل نگیرم ز دلستانی تو",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31,
      "CoupletSummary": "هوش مصنوعی: از دلبری و محبت تو دل نمی‌کنم و خسته نمی‌شوم."
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "عزیز مادر",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "مو بمو تا ابد اگر بمویم",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 32,
      "CoupletSummary": "هوش مصنوعی: اگر تا ابد به اندازهٔ هر تار مو بر تو گریه کنم، باز هم نمی‌توانم حتی یکی را بازگو کنم"
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "یکی نگویم",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "از هزاران غم نهانی تو",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 33,
      "CoupletSummary": "هوش مصنوعی: از هزاران غم پنهانی که تو کشیدی."
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "عزیز مادر",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    }
  ]
}
