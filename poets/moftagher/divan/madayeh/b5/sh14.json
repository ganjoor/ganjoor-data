  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ای به میدان وفا از دل و جان کرده نثار",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "سر و تن در ره یار",
