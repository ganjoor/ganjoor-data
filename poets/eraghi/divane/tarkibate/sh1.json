      "Text": "هم ظاهر و هم نهان نماید",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "آن نقطه به تو کمال مطلق",
