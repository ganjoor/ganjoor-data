      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "در صورت این و آن نماید",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "آن سرعت دور نقطه دایم",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "ساکن به یکی مکان نماید",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "هر لمحه به تو کمال هستی",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "در کسوت ناقصان نماید",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "آن نقطه بیان کنم چه چیز است",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "هر چند تو را گمان نماید",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "آن نقطه بدان که ظل نور است",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "کان نور ورای جان نماید",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "آن نور دل پیمبر ماست",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "اکنون به تو حق عیان نماید",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 27,
      "Position": "CenteredVerse1",
      "Text": "آن بحر محیط بی‌کرانه",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "SectionIndex3": 5
    },
    {
      "VOrder": 28,
      "Position": "CenteredVerse2",
      "Text": "و آن نور بسیط جاودانه",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "SectionIndex3": 5
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "آن بحر، که موج اوست دریا",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "و آن نور، که ظل اوست اشیا",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "نوری که جمال جمله هستی",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "از تاب جمال اوست پیدا",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "اول ز پی نظارهٔ او",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "شد عین همه جهان مهیا",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "و آخر هم آفتاب رویش",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "شد صورت جسم و جان هویدا",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "او روی حق است و عین حق نیز",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "بل عین حقیقت است و اعلا",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "دریاب، که اوست اسم اعظم",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "زو گشت عیان صفات و اسما",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "آن ذات که حق بود صفاتش",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "او را بنگر، چه باشد اسما؟",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "اسمی که بود صفات او حق",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "بنگر که چه باشدش مسما",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "و آن نور که حق بدو توان دید",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "باشد همه والضحی و طاها",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "فی‌الجمله کمال صورت اوست",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "آیینهٔ ذات حق تعالی",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "در آینه مصطفی چه بیند؟",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "جز حسن و جمال ذات والا",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "کو عاشق روی حق؟ بیا گو",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "بنگر رخ خوب مصطفی را",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "در صورت او حق ار ندیدی",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "اینجا به یقین ببینی آنجا",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "در صورت شرح او عراقی",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "چون دید حقیقت آشکارا",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "امید که از شفاعت او",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "حاصل شودش کلام اعلی",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 59,
      "Position": "CenteredVerse1",
      "Text": "تا هر نفسی به دیدهٔ حق",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "SectionIndex3": 6
    },
    {
      "VOrder": 60,
      "Position": "CenteredVerse2",
      "Text": "بینند همه جمال مطلق",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "SectionIndex3": 6
    }
  ]
}
