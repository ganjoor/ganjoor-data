    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "چه کردم؟ دلبرا، از من چه دیدی؟",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
