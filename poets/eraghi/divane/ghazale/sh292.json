  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "در کوی تو لولیی، گدایی",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در محله تو، شخصی فقیر و نیازمند به امید دریافت محبت و خوش‌آمدگویی آمد."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "آمد به امید مرحبایی",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "بر خاک درت گدای مسکین",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بر زمین درگاه تو، فقیر و بی‌بضاعت عابری است که هرگز از جایی دور نشده است."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "با آنکه نرفته بود جایی",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "از دولت لطف تو، که عام است",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از محبت تو که به همه می‌رسد، چرا بی‌نواها از آن بی‌بهره‌اند؟"
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "محروم چراست بی‌نوایی؟",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "پیش که رود؟ کجا گریزد؟",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به کجا خواهد رفت؟ در کجا می‌تواند پنهان شود؟ از درد و غم تو، که به زمین افتاده است."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "از دست غمت شکسته پایی",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "مگذار که بی نصیب ماند",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: اجازه نده که کسی از درگاه پادشاه بی بهره بماند و از کمک و نعمت او محروم شود."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "از درگه پادشه گدایی",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "چشمم ز رخ تو چشم دارد",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: چشمانم هر لحظه به خاطر دیدن چهره تو به شادی و خوشبختی نگاه می‌کند."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "هر دم به مبارکی لقایی",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "جانم ز لب تو می‌کند وام",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هر لحظه وجودم به عشق تو تازه و شاداب می‌شود و وجودم تنها به تو وابسته است."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "هر لحظه به تازگی بقایی",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "جستم همه جای را، ندیدم",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در تلاش بودم تا هر جایی را بگردم، اما جز در دل تنگ، هیچ جای دیگری نیافتم."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "جز در دل تنگ جایگایی",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "بی روی تو هر رخی که دیدم",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بدون حضور تو، هر چهره‌ای که دیدم، برایم هیچ احساسی جز حس ابتدایی نداشت."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "ننمود مرا جز ابتدایی",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "دل در سر زلف هر که بستم",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من قلبم را به زلف کسی سپردم و همین باعث شد که دل خود را به خطر بیندازم."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "دادم دل خود به اژدهایی",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "در بحر فراق غرق گشتم",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در دریا و عمق دوری و جدایی غرق شدم و هیچ دوستی به کمکم نیامد."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "دستم نگرفت آشنایی",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "در بادیهٔ بلا بماندم",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در وسط مشکلات و سختی‌ها مانده‌ام و هیچ‌کس نیست که مرا راهنمایی کند."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "راهم ننمود رهنمایی",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "در آینهٔ جهان ندیدم",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در آینهٔ دنیا فقط تصویر تو را دیدم که خودی از جهان نشان می‌دهد."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "جز عکس رخت جهان نمایی",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "خود هر چه به جز تو در جهان است",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: هرچیزی جز تو در این دنیا وجود دارد، مانند یک سراب یا صدایی زودگذر است."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "هست آن چو سراب یا صدایی",
