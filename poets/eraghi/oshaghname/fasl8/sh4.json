    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "راه برگیر و بگذر از دعوی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "به فلان کوه رو، مقامی ساز",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: به فلان کوه برو، آنجا جایگاهی برای خود بساز، گوشه‌نشین شو و راز خود را به کسی نگو."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "کنج گیر و مگوی با کس راز",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "طاعت کردگار عادت کن",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "CoupletSummary": "هوش مصنوعی: فرمانبرداری از خدا را عادت خود کن و آفریدگارت را عبادت کن."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "صانع خویش را عبادت کن",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "روزگاری بدین صفت می‌باش",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17,
      "CoupletSummary": "هوش مصنوعی: مدتی بر این حال بمان تا عبادت پنهانی‌ات خودبه‌خود آشکار شود."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "خود شود طاعت نهانی فاش",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "در تو مردم ارادت افزایند",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18,
      "CoupletSummary": "هوش مصنوعی: مردم به تو ارادت پیدا می‌کنند و برای تبرک به خدمتت می‌آیند."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "به تبرک به خدمتت آیند",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "هیچ چیزی ز کس قبول مکن",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19,
      "CoupletSummary": "هوش مصنوعی: از هیچ کس چیزی نپذیر و با هیچ کس هم سخن مگو."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "نیز با هیچ کس مگوی سخن",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "چون شوی در میان خلق علم",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20,
      "CoupletSummary": "هوش مصنوعی: وقتی در میان مردم مشهور شدی، خبر تو به اتابک هم می‌رسد."
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "به اتابک رسد حدیث تو هم",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "چون اتابک تو را مرید شود",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21,
      "CoupletSummary": "هوش مصنوعی: وقتی اتابک مرید تو شود، اندوهت به شادی بدل می‌شود (و راه رسیدن به من باز می‌شود)."
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "اندهت را فرح پدید شود",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "چون که عاشق پیام دوست شنید",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22,
      "CoupletSummary": "هوش مصنوعی: عاشق چون پیغام محبوب را شنید، فرمان او را با جان و دل پذیرفت."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "امر او را به جان و دل بگزید",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "شد به کوهی که او اشارت کرد",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23,
      "CoupletSummary": "هوش مصنوعی: به کوهی که دختر نشان داده بود رفت و اتاقکی کوچک با چهار دیوار ساخت."
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "چار دیوارکی عمارت کرد",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "وندر آنجا، چنان که دختر گفت",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24,
      "CoupletSummary": "هوش مصنوعی: و در آنجا، همان‌گونه که دختر گفته بود، از عبادت آرام نگرفت و نخوابید."
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "از عبادت نیارمید و نخفت",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    }
  ]
}
