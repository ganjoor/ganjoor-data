  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ای هوای تو مونس جانم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: ای هوای تو، پناه دل من و همدم جانم، هم موجب رنج من هستی و هم منبع شفای من."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "مایهٔ درد و اصل درمانم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "مرغ جان تا بیافت دیدهٔ باز",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: پرندهٔ وجودم وقتی چشمش به تو می‌افتد، در آرزوی تو به پرواز در می‌آید."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "در هوای تو می‌کند پرواز",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "گفت و گوی تو روز و شب یارم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: صحبت و گفت‌وگو با تو، روز و شب برای من مهم است و جست‌وجو کردن برای تو نتیجه تلاش‌هایم را به نمایش می‌گذارد."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "جست و جوی تو حاصل کارم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "دلم از عشق توست دیوانه",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: دل من به خاطر عشق تو دیوانه شده است؛ تو همچون شمعی هستی و من مانند پروانه‌ای در اطراف تو می‌چرخم."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "تا تو شمعی، تو راست پروانه",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "نیک در کار خویش حیرانم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: من در کارهای خودم شگفت‌زده‌ام و نمی‌دانم چگونه بر دردهای خود فائق آیم."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "درد خود را دوا نمی‌دانم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "در غم دوستان مهر گسل",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: در دل من به خاطر غم دوستان، آتش محبت دشمنان شعله‌ور شد."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "دشمنان را بسوخت بر من دل",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "ما همه مشتری بی‌پایه",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: همه ما مشتریان بدون اعتبار او هستیم و محصولات او بسیار ارزشمند و گرانبها هستند."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "او و کالای او گران‌مایه",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "ای ز سوداییان درین بازار",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: ای کسی که در این بازار از تیرگی‌های دل و افکار پریشان بی‌خبری، آرام و بی‌دغدغه‌ای، در حالی که من از این مشکلات و وسوسه‌ها بسیار رنج می‌برم."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "فارغ از مثل من هزار هزار",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "خواب خواهم من از خدا به دعا",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: من از خدا درخواست خواب دارم تا شاید در خواب تو را ببینم."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "تا ببینم مگر به خواب تو را",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "نکند خود به خاطرت گذری",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: شاید به خاطر تو در اندیشه بیدلی نگاهی بیندازم."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "که کنی سوی بیدلی نظری",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "چون سرماست خاک سودایت",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: به خاطر سرمایی که بر خاک عشق تو حاکم است، فرصتی پیش آمده تا عشق و احساس خود را به تو تقدیم کنیم."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "فرصتی، تا نهیم در پایت",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "می‌سزد جز به وقت دل بردن",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: چندان بی‌اعتنایی به کسی که در دلش نمی‌دارد، شایسته نیست، مگر اینکه زمانش برسد و دل او را به دست آورد."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "التفاتی به بی‌دلی کردن",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "به تلطف ز ما ربودی دل",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: به خاطر مهربانی‌ات دل مرا ربودی و اکنون که با تکبر رفتار می‌کنی، به من کمی مهلت بده."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "به تکبر کنون زیاد مهل",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "تو به خود عاشقی، زهی مشکل!",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: تو به خودت عاشق شده‌ای، چه دشواری! که عشق ما از دل تو خواهد گذشت."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "که ز ما بگذرد تو را در دل",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "تو سبق برده‌ای ز نیکویان",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "CoupletSummary": "هوش مصنوعی: تو در زیبایی‌ها از همه جلوتر هستی و عشق تو باعث شده که من این شعر را بگویم."
    },
    {
      "VOrder": 30,
