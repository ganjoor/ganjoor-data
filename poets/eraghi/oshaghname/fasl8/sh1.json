  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ای هوای تو مونس جانم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: ای کسی که عشق و آرزوی تو همدم جان من است؛ تو هم سرچشمهٔ درد منی و هم اصل درمان آن."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "مایهٔ درد و اصل درمانم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "مرغ جان تا بیافت دیدهٔ باز",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: مرغ جان من از وقتی چشمش باز شد، مانند بازِ شکاری که چشم‌بندش را برداشته‌اند، در هوای تو پرواز می‌کند. «هوا» هم به معنای آسمان است و هم به معنای عشق و آرزو."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "در هوای تو می‌کند پرواز",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "گفت و گوی تو روز و شب یارم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: سخن گفتن از تو شب و روز همدم من است و تمام حاصل کار من جست‌وجوی توست."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "جست و جوی تو حاصل کارم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "دلم از عشق توست دیوانه",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: دلم از عشق تو دیوانه شده است. تا وقتی تو شمعی، دل من پروانهٔ توست و گرد تو می‌سوزد."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "تا تو شمعی، تو راست پروانه",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "نیک در کار خویش حیرانم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: در کار خود سخت سرگردانم و نمی‌دانم دوای درد خود چیست."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "درد خود را دوا نمی‌دانم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "در غم دوستان مهر گسل",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: از رنجی که دوستانِ پیمان‌شکن به من رساندند، حال من چنان شد که حتی دل دشمنان نیز بر من سوخت."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "دشمنان را بسوخت بر من دل",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "ما همه مشتری بی‌پایه",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: ما همه خریدارانی بی‌سرمایه‌ایم، اما معشوق و کالای او یعنی وصال و زیبایی‌اش بسیار گران‌بهاست."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "او و کالای او گران‌مایه",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "ای ز سوداییان درین بازار",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: ای کسی که در این بازار عشق، از هزاران هزار عاشقِ شیفته مانند من بی‌نیاز و فارغی."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "فارغ از مثل من هزار هزار",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "خواب خواهم من از خدا به دعا",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: از خدا با دعا خواب می‌خواهم، شاید دست‌کم تو را در خواب ببینم."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "تا ببینم مگر به خواب تو را",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "نکند خود به خاطرت گذری",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: حتی به ذهنت هم نمی‌رسد که نگاهی به عاشقِ دل‌باخته‌ای بیندازی."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "که کنی سوی بیدلی نظری",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "چون سرماست خاک سودایت",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: چون سر ما خاکِ راه عشق توست، فرصتی بده تا این سر را به پایت بگذاریم."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "فرصتی، تا نهیم در پایت",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "می‌سزد جز به وقت دل بردن",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: سزاوار است که جز هنگام دل بردن، در وقت دیگری هم به عاشقِ بی‌دل توجهی کنی."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "التفاتی به بی‌دلی کردن",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "به تلطف ز ما ربودی دل",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: با مهربانی دل ما را ربودی؛ اکنون از روی تکبر ما را از یاد مبر."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "به تکبر کنون زیاد مهل",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "تو به خود عاشقی، زهی مشکل!",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: تو عاشق خودت هستی و این کار را دشوار می‌کند؛ چگونه ممکن است یاد ما از دل تو بگذرد؟"
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "که ز ما بگذرد تو را در دل",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "تو سبق برده‌ای ز نیکویان",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "CoupletSummary": "هوش مصنوعی: تو در زیبایی از همهٔ نیکورویان پیشی گرفته‌ای و ما از عشق تو این غزل را می‌سراییم."
    },
    {
      "VOrder": 30,
