  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ای هوای تو مونس جانم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: ای وجود تو باعث آرامش روح من است و در عین حال، منبع رنج و نشانهٔ بهبودی من نیز هست."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "مایهٔ درد و اصل درمانم",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "مرغ جان تا بیافت دیدهٔ باز",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: روح و جان من مانند پرنده‌ای است که وقتی با چشم برانگیخته تو روبه‌رو می‌شود، به شوق پرواز در آغوش تو بالا می‌رود."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "در هوای تو می‌کند پرواز",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "گفت و گوی تو روز و شب یارم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: گفت‌وگوی تو با من در روز و شب، بهترین یار من است و جست‌وجوی تو، نتیجه و هدف تلاش‌های من به شمار می‌آید."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "جست و جوی تو حاصل کارم",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "دلم از عشق توست دیوانه",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: دل من از شدت عشق تو دیوانه شده است، تا زمانی‌که تو مانند شمعی درخشانی، من هم مانند پروانه‌ای به دور تو می‌چرخم."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "تا تو شمعی، تو راست پروانه",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "نیک در کار خویش حیرانم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: در کار خود، خوب و بد را نمی‌فهمم و دردم را راه حلی نمی‌بینم."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "درد خود را دوا نمی‌دانم",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "در غم دوستان مهر گسل",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: در میان غم دوستان، محبت و دوستی را که بین دشمنان وجود دارد، برای من سوزانده است. دل من به خاطر این مسأله دچار درد و رنج شده است."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "دشمنان را بسوخت بر من دل",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "ما همه مشتری بی‌پایه",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: ما همه خریداران بی‌اساس و بدون ارزش واقعی هستیم و او کالا و محبتی را عرضه می‌کند که بسیار باارزش و گرانبهاست."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "او و کالای او گران‌مایه",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "ای ز سوداییان درین بازار",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: ای تو که از دیوانه‌های عاشق در این بازار بی‌خیال و ساکتی، هزاران نفر همچون من وجود دارند."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "فارغ از مثل من هزار هزار",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "خواب خواهم من از خدا به دعا",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: از خدا می‌طلبم که در خواب ببینم تو را، شاید در خوابم تو را ملاقات کنم."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "تا ببینم مگر به خواب تو را",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "نکند خود به خاطرت گذری",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: شاید تو به یاد من بیفتی و به سمت غم و اندوه توجه کنی."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "که کنی سوی بیدلی نظری",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "چون سرماست خاک سودایت",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: در این بیت، شاعر به سردی و بی‌حالی گویی اشاره دارد و می‌گوید که حالا که دلش پر از غم و دلتنگی است، فرصت خوبی است تا این احساسات را در وجودش بگنجاند و از آن بهره‌برداری کند."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "فرصتی، تا نهیم در پایت",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "می‌سزد جز به وقت دل بردن",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: فقط زمانی که دل را می‌ربایی، شایسته است که به بی‌حالی و بی‌دلی دیگران توجه کنی."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "التفاتی به بی‌دلی کردن",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "به تلطف ز ما ربودی دل",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: با محبت و لطفی که از سوی ما بود، دل ما را به خود جذب کردی، اما اکنون با arrogance (تکبر) خود، دیگر مهلتی به ما نمی‌دهی."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "به تکبر کنون زیاد مهل",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "تو به خود عاشقی، زهی مشکل!",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: عاشق‌بودن تو بر ما دشوار است، چون تو از دل ما غافل می‌گذری و به عشق ما توجهی نداری."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "که ز ما بگذرد تو را در دل",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
