  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "مرحبا! مرحبا! نسیم صبا",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "خبر از دوست چیست؟ باز نما",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "حال ما بین درین پریشانی",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "باز گو تا ازو چه می‌دانی؟",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "این چنینم هنوز بگذارد؟",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "یا عزیمت بدین طرف دارد؟",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "گوییا تخم مهر ما کارد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "یا خود از ما فراغتی دارد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "سخن بی‌دلان به یاد آرد؟",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "یا خود او این سرود نشمارد؟",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "باشدش هیچ میل و رغبت ما؟",
