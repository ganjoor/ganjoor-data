      "Text": "انگبین کرده بر لب ارقم",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "طبع موزون او سرشته ز نور",
