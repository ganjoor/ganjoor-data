      "VOrder": 56,
      "Position": "Left",
      "Text": "وی چو بدر منیر محض کمال",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "هست رای تو نور امن و امان",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30,
      "CoupletSummary": "هوش مصنوعی: اندیشه و تدبیر تو نورِ امنیت و آرامش است که همهٔ جهان از آن روشن است."
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "که بدو روشن است جمله جهان",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "درگه تو چو مجمع فضلاست",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31,
      "CoupletSummary": "هوش مصنوعی: درگاه تو محل گرد آمدن فاضلان است و سایهٔ خدا از نور تو آشکار می‌شود."
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "سایهٔ حق ز نور تو پیداست",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "هر خدنگی، که شست قهر گشاد",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 32,
      "CoupletSummary": "هوش مصنوعی: هر تیری که از کمان خشم رها شود، آماجش جان دشمنان تو باشد."
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "هدفش جان دشمنان تو باد",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "چشم معنی ز صورتت روشن",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 33,
      "CoupletSummary": "هوش مصنوعی: چشم حقیقت از دیدن چهرهٔ تو روشن باد تا چشم دشمن کور شود."
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "تا شود کور دیدهٔ دشمن",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    }
  ]
}
