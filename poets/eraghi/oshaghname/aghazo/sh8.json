    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "هر چه گویند هست صد چندان",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "خوبرو را چه حاجت زیور؟",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26,
      "CoupletSummary": "هوش مصنوعی: چهره زیبا و خوش‌نما نیازی به زیورآلات ندارد؛ او خود به اندازه کافی با ویژگی‌های درخشانش، مانند گوهر، شناخته می‌شود."
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "وصف خود خویشتن کند گوهر",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "چیست کان نیست ذات پاکش را؟",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27,
      "CoupletSummary": "هوش مصنوعی: چرا چیزی که باطنی پاک دارد، نیازی به زیور ندارد؟ حتی من برای او از خدا درخواست دعایی می‌کنم."
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "تا بخواهم من از خدا به دعا",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "گوهر کان و بحر معدلت است",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28,
      "CoupletSummary": "هوش مصنوعی: وجود او همچون گوهر و دریا بر پایهٔ عدل قرار دارد و مقامش فراتر از هر مرتبه و منزلتی است."
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "پایهٔ او ورای منزلت است",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "ای چو خورشید نور ورز جلال",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29,
      "CoupletSummary": "هوش مصنوعی: تو مانند خورشید، نور و روشنی بخش جلال هستی و مانند ماه، روشنایی محض کمال."
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "وی چو بدر منیر محض کمال",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "هست رای تو نور امن و امان",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30,
      "CoupletSummary": "هوش مصنوعی: رای تو، یعنی اندیشه و نظر تو، مانند نوری است که مایهٔ امنیت و آرامش است و همهٔ عالم را روشن کرده است."
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "که بدو روشن است جمله جهان",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "درگه تو چو مجمع فضلاست",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31,
      "CoupletSummary": "هوش مصنوعی: درگاه تو مثل مرکزی برای دانشمندان است و سایهٔ حقیقت از نور تو آشکار است."
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "سایهٔ حق ز نور تو پیداست",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "هر خدنگی، که شست قهر گشاد",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 32,
      "CoupletSummary": "هوش مصنوعی: هر تیری که از کمان قهر تو رها شود، هدفش جان دشمنان تو باشد."
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "هدفش جان دشمنان تو باد",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "چشم معنی ز صورتت روشن",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 33,
      "CoupletSummary": "هوش مصنوعی: چشم من با دیدن زیبایی تو روشن می‌شود، تا اینکه دیدهٔ دشمنان تو به دلیل کوری، دیگر نتوانند تو را ببینند."
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "تا شود کور دیدهٔ دشمن",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    }
  ]
}
