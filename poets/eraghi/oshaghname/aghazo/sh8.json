    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "خوبرو را چه حاجت زیور؟",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26,
      "CoupletSummary": "هوش مصنوعی: زن زیبا و خوشرو نیازی به زیورآلات ندارد؛ زیرا خود زیبایی او مانند جواهر می‌باشد."
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "وصف خود خویشتن کند گوهر",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "چیست کان نیست ذات پاکش را؟",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27,
      "CoupletSummary": "هوش مصنوعی: این عبارت به این معناست که چه چیزی وجود دارد که ذات خالص خداوند آن را نمی‌داند؟ من برای دعا کردن از خدا چه چیزی را بخواهم؟"
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "تا بخواهم من از خدا به دعا",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "گوهر کان و بحر معدلت است",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28,
      "CoupletSummary": "هوش مصنوعی: جوهر و ارزش واقعی انسان در عمق وجود اوست و این ارزش بالاتر از هر جایگاهی است که ممکن است به دست آورد."
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "پایهٔ او ورای منزلت است",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "ای چو خورشید نور ورز جلال",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29,
      "CoupletSummary": "هوش مصنوعی: ای خورشید که نور و جلالت بر همه می‌تابد، و همچون ماه کامل و روشن، تجلی کمال را به نمایش می‌گذاری."
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "وی چو بدر منیر محض کمال",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "هست رای تو نور امن و امان",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30,
      "CoupletSummary": "هوش مصنوعی: نظر تو مانند نوری است که امنیت و آرامش را به همراه دارد و به واسطه آن، تمام جهان روشنایی می‌یابد."
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "که بدو روشن است جمله جهان",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 30
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "درگه تو چو مجمع فضلاست",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31,
      "CoupletSummary": "هوش مصنوعی: می‌خواهی بگویی که مکان تو مانند محلی است که دانشمندان و فرهیختگان جمع شده‌اند و نور وجود تو باعث روشنایی و تابش سایهٔ حق و حقیقت می‌شود."
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "سایهٔ حق ز نور تو پیداست",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 31
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "هر خدنگی، که شست قهر گشاد",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 32,
      "CoupletSummary": "هوش مصنوعی: هر تیر و گلوله‌ای که به سمت دشمنان تو پرتاب می‌شود، باید به هدف پاک کردن جان آن‌ها باشد."
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "هدفش جان دشمنان تو باد",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 32
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "چشم معنی ز صورتت روشن",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 33,
      "CoupletSummary": "هوش مصنوعی: چشمان دشمنان به زیبایی و جذابیت تو آگاه می‌شود و از این رو نابینا می‌گردند."
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "تا شود کور دیدهٔ دشمن",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 33
    }
  ]
}
