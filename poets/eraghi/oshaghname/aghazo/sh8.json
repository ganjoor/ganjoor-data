    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "کرمش سابق است بر مایل",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "به کفش نسبتی چو کرد سحاب",
