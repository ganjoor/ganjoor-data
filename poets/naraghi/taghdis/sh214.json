  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "دیده‌ای خواهم ازین هم تیزتر",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "تا ببینم زیر این مکری دگر",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "شاید این میل جهاد اندر نهاد",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "منبعث باشد ز عقل ذو سداد",
