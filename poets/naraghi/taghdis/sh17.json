    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "وانگهی سیر جهان نور کن",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "دل اگرچه زندهٔ آب و گل است",
