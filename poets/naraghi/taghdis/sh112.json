  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "آنکه او باشد نشان خویشتن",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
