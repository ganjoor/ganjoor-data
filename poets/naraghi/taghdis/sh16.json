  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "چون شنید آن گرگ از خر نعل زر",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "از طمع ابله شد و مفتون خر",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "پس دوید از حرص تا نزدیک پای",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "پای خر برداشت با دندان ز جای",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "تا ز دندان نعل زراندام را",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "برکند زانجا و یابد کام را",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "خر لگد زد بر دهان و بر سرش",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "کرد خالی سر ز سودای زرش",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "یک لگد زد خر بر آن گرگ کهن",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "هم شکستش آسیا و هم دهن",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "کام نگرفته هنوز از نعل زر",
