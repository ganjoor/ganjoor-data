  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "آن شب ابراهیم تا وقت صباح",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
