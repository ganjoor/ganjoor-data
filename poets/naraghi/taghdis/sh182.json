  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "چون رها از منجنیق آمد خلیل",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
