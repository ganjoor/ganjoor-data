  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "انجیرفروش را چه بهتر",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: ای برادر، برای انجیرفروش چه کاری بهتر از انجیرفروشی است؟ یعنی هر کس به کار و پیشهٔ خود دل‌بسته است."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "انجیرفروشی ای برادر",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "یا ساقی عشقنا تذکر",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: ای ساقی عشق ما، ما را به یاد آور؛ زیرا زندگی بی بخشش و عطای تو ناقص و بی‌حاصل است."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "فالعیش بلا نداک ابتر",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "ما را سر صنعت و دکان نیست",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: ما سودای پیشه و دکان نداریم؛ ای ساقی جان، جام کجاست؟ کار ما فقط باده‌نوشی از دست توست."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "ای ساقی جان کجاست ساغر",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "لا تترکنا سدی صحایا",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: ما را بی‌سرپرست و هوشیار و بی‌باده رها مکن؛ نیکی را باید زود به دست آورد و نباید به تأخیر انداخت.\n\nسورهٔ القِيَامَةِ، آیهٔ ۳۶\n«أَيَحْسَبُ ٱلْإِنسَٰنُ أَن يُتْرَكَ سُدًى»\nترجمهٔ فولادوند: «آيا انسان گمان مى‌كند بى‌هدف رها مى‌شود؟!»"
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "الخیر ینال لا یوخر",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "کم جوی وفا عتاب کم کن",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: از ما کمتر وفا بخواه و کمتر سرزنش کن، ای که هزاران درمانده را زنده می‌کنی."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "ای زنده کن هزار مضطر",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "الحنطه حیث کان حنطه",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: گندم هر جا باشد گندم است و در روز خرمن‌کوبی هم همان گندم است؛ یعنی گوهر و ذات چیزها دگرگون نمی‌شود."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "اذ کان کذاک یوم بیدر",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "چون پیشه مرد زرگری شد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: وقتی پیشهٔ کسی زرگری باشد، به هر شهر که برود زرگر همان اوست؛ هنر و گوهر آدمی همراه اوست."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "هر شهر که رفت کیست زرگر",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "ابرارک یشربون خمراً",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: نیکان تو در سایهٔ بخشش برگزیده‌ات شراب می‌نوشند؛ اشاره به آیهٔ قرآن دربارهٔ نوشیدن ابرار از جام بهشتی.\n\nسورهٔ الإِنسَانِ، آیهٔ ۵\n«إِنَّ ٱلْأَبْرَارَ يَشْرَبُونَ مِن كَأْسٍۢ كَانَ مِزَاجُهَا كَافُورًا»\nترجمهٔ فولادوند: «به يقين ابرار (و نيكان) از جامى مى‌نوشند كه با عطر خوشى آميخته است،»"
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "فی ظل سخایک المخیر",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "خود دل دهدت که برنهی بار",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: آیا دلت راضی می‌شود که بار بر مرکبی لاغر و پشت‌زخمی بنهی؟ یعنی بر ما ناتوانان بار سنگین منه."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "بر مرکب پشت ریش لاغر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "من کاسک للثری نصیب",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: از جام تو خاک هم بهره‌ای دارد و زمین از همان جرعه سرسبز شده است."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "و الارض بذاک صار اخضر",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "بگذار که می‌چرد ضعیفی",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: بگذار این ناتوان آزادانه در باغ رحمت تو بچرد و بهره ببرد."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "در روضه رحمتت محرر",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "یا ساقی‌هات لا تقصر",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: ای ساقی، باده بیاور و کوتاهی مکن؛ ای که مایهٔ درازی زندگی کوتاه مایی."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "یا طول حیاتنا المقصر",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "در سایه دوست چون بود جان",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: جان در سایهٔ دوست چنان است که ماهی در میان چشمهٔ کوثر؛ سرشار از زندگی و شادی."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "همچون ماهی میان کوثر",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "طهر خطراتنا و طیب",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: اندیشه‌ها و خطورهای دل ما را با جام شراب پاکت پاک و خوش کن."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "من کأس مدامک المطهر",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "ما را بمران وگر برانی",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "CoupletSummary": "هوش مصنوعی: ما را از خود مران، و اگر هم برانی، مانند کبوتر باز بر گرد تو می‌گردیم و به سوی تو برمی‌گردیم."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "هم بر تو تنیم چون کبوتر",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "و الفجر لذی لیال عشر",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17,
      "CoupletSummary": "هوش مصنوعی: سوگند به سپیده‌دم و شب‌های دهگانه؛ از جوی شراب ناب تو که روان و جوشان است. اشاره به آغاز سورهٔ فجر و بازی با معنای «فجر» به‌عنوان روان شدن آب."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "من نهر رحیقک المفجّر",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "آمد عثمان شهاب دین هین",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18,
      "CoupletSummary": "هوش مصنوعی: عثمان شهاب‌الدین آمد؛ هان، غزل مرا دوباره و پیاپی بخوان. ظاهراً خطاب به خواننده یا قوال مجلس است."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "واگو غزل مرا مکرر",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    }
  ]
