  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "انجیرفروش را چه بهتر",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: بهتر است که کسی که انجیرافروشی می‌کند، در این کارش شکست ناپذیر باشد و در آن مهارت داشته باشد."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "انجیرفروشی ای برادر",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "یا ساقی عشقنا تذکر",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: ای ساقی عشق ما، یادآوری کن که زندگی بدون صدای تو ناقص و تباه است."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "فالعیش بلا نداک ابتر",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "ما را سر صنعت و دکان نیست",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: ای ساقی جان، ما به دنبال کار و مادیات نیستیم، بلکه می‌خواهیم بدانیم ساغر (جام شراب) کجاست."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "ای ساقی جان کجاست ساغر",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "لا تترکنا سدی صحایا",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: ای ساقی، ما را ترک مکن که در دنیای پر خیر و برکت، به ماین‌های خود نخواهیم رسید و سفرمان به تأخیر نخواهد افتاد."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "الخیر ینال لا یوخر",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "کم جوی وفا عتاب کم کن",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: ای زنده‌کننده، از یادآوری شکایت و عتاب درباره وفا و صداقت کم کن، زیرا تعداد زیادی از افراد در حال حاضر در اضطراب و ناامیدی به سر می‌برند."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "ای زنده کن هزار مضطر",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "الحنطه حیث کان حنطه",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: در این بیت به واقعیت‌هایی اشاره می‌شود که در هر جایی از زندگی وجود دارند. اگر چیزی در جایی به خوبی و بنا بر شرایط مشخصی باشد، در همان مکان و در زمان‌های مشابه هم باید دارای کیفیت مشابهی باشد. به طور خاص، شاید به اوضاع و احوال یکدیگر و استمرار ویژگی‌ها در زمان و مکان‌های مختلف پرداخته شده باشد."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "اذ کان کذاک یوم بیدر",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "چون پیشه مرد زرگری شد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: هر جا که مرد زرگری (طلا فروش) می‌رود، می‌پرسند کیست زرگر، یعنی در هر شهری که طلا فروش قدم می‌گذارد، مردم توجه و احترام خاصی به او می‌کنند و او برایشان شناخته شده است."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "هر شهر که رفت کیست زرگر",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "ابرارک یشربون خمراً",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: نیکان و صالحان در سایهٔ درختان سرسبز، شراب ناب می‌نوشند."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "فی ظل سخایک المخیر",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "خود دل دهدت که برنهی بار",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: دل تو خودش به تو می‌گوید که بار سنگینی را بر دوش مرکب لاغر (یعنی حیوانی که برای حمل بار استفاده می‌شود) نگذاری."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "بر مرکب پشت ریش لاغر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "من کاسک للثری نصیب",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: من مانند کاسه‌ای هستم که پر از خاک است و به این دلیل زمین سبز و پرخیر و برکت شده است."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "و الارض بذاک صار اخضر",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "بگذار که می‌چرد ضعیفی",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: اجازه بده که فردی ضعیف و ناتوان در باغ رحمت تو بچرخد و از نعمت‌های آن بهره‌مند شود."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "در روضه رحمتت محرر",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "یا ساقی‌هات لا تقصر",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: ای ساقی، از ما کم نکن و به ما بنوشان، یا ما را از حیات کوتاه‌مدت خود بهره‌مند کن."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "یا طول حیاتنا المقصر",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "در سایه دوست چون بود جان",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: در کنار دوست، روح آدمی مانند ماهی در آب زلال کوثر است و از زندگی و آرامشی عمیق برخوردار است."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "همچون ماهی میان کوثر",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "طهر خطراتنا و طیب",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: همهٔ خطرها و بحران‌ها را از ما دور کن و نوشیدنی پاک و خوشگوار خود را همواره به ما بده."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "من کأس مدامک المطهر",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "ما را بمران وگر برانی",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "CoupletSummary": "هوش مصنوعی: اگر ما را بکشید (به مرگ برسانید) یا اگر از خود برانید، فرقی ندارد؛ ما همچنان مانند کبوتر به سوی شما خواهیم آمد."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "هم بر تو تنیم چون کبوتر",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "و الفجر لذی لیال عشر",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17,
      "CoupletSummary": "هوش مصنوعی: و سپیده‌دمی که در ده شب (عید قربانی) قرار دارد، از نهر گوارای تو که به چشمه‌ساری جوشان می‌ریزد."
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "من نهر رحیقک المفجّر",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "آمد عثمان شهاب دین هین",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18,
      "CoupletSummary": "هوش مصنوعی: عثمان شهاب‌الدین، شاعری است که به حضورش اشاره می‌شود و از او خواسته می‌شود که غزلی که شاعر سروده را با شوق و محبت بیان کند و تکرار کند."
    },
    {
      "VOrder": 34,
