  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "انجیرفروش را چه بهتر",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: انجیرفروش، کاری که می‌کند بهتر است که همان کار را ادامه دهد و در آن تخصص پیدا کند، برادر."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "انجیرفروشی ای برادر",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "یا ساقی عشقنا تذکر",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: ای ساقی، یادآوری کن که زندگی بدون ندا و آواز تو ناقص و بی‌محتواست."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "فالعیش بلا نداک ابتر",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "ما را سر صنعت و دکان نیست",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: ما در کار و مشغله‌های دنیوی نمی‌خواهیم، ای ساقی، جانم کجاست تا جامی بیاوری؟"
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "ای ساقی جان کجاست ساغر",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "لا تترکنا سدی صحایا",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: ما را در سختی‌ها تنها نگذار، بگذار خیر و نیکی به ما برسد و درنگ نکن."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "الخیر ینال لا یوخر",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "کم جوی وفا عتاب کم کن",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: با کم توقع بودن، کمتر از دیگران انتقاد کن، ای کسی که هزاران نفر را زنده می‌کنی و به آنها امید می‌بخشی."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "ای زنده کن هزار مضطر",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "الحنطه حیث کان حنطه",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: گندم هر جا که باشد، همان جاست؛ همان‌طور که در روز بدر بود."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "اذ کان کذاک یوم بیدر",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "چون پیشه مرد زرگری شد",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: هرگاه مردی به حرفه طلاگری مشغول شود، در هر شهری که برود باید ببیند که چه کسی طلاگر آنجاست."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "هر شهر که رفت کیست زرگر",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "ابرارک یشربون خمراً",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: درشتی‌ها نوشیدنی شیرینی می‌نوشند در سایه‌ی چشمه‌های خوشمزه."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "فی ظل سخایک المخیر",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "خود دل دهدت که برنهی بار",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: خودت بر مرکب لاغر بار نگذار، چون دل خودت به تو می‌گوید که می‌توانی این کار را بکنی."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "بر مرکب پشت ریش لاغر",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "من کاسک للثری نصیب",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: من سهم خود را از خاک گرفتم و همین باعث شد که زمین سبز شود."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "و الارض بذاک صار اخضر",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "بگذار که می‌چرد ضعیفی",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: اجازه بده که در باغ رحمتت، ضعیفی مست و سرمست بچرخد."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "در روضه رحمتت محرر",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "یا ساقی‌هات لا تقصر",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: ای ساقی، یا تو از می نخور، یا آرزوی ما برای زندگی کوتاه است."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "یا طول حیاتنا المقصر",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "در سایه دوست چون بود جان",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: در کنار دوست، جان انسان مانند ماهی است که در آب زلال زندگی می‌کند."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "همچون ماهی میان کوثر",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "طهر خطراتنا و طیب",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: پاک کن خطرات ما را و دل را با شراب دائمی تو گوارا کن."
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "من کأس مدامک المطهر",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "ما را بمران وگر برانی",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "CoupletSummary": "هوش مصنوعی: اگر ما را به قتل برسانی، حتی اگر از ما دور شوی، ما همچنان به تو مانند کبوترانی که به پرواز درمی‌آیند، وابسته و دلبسته خواهیم بود."
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "هم بر تو تنیم چون کبوتر",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "و الفجر لذی لیال عشر",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17,
      "CoupletSummary": "هوش مصنوعی: و صبحی که از شب‌های ده‌گانه برمی‌خیزد، از نهر گوارای تو جاری می‌شود."
    },
    {
