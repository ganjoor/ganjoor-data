    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "چگونه مه نه ارضی نی سمایی",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "که ارضی و سمایی را غروب است",
      "CoupletIndex": 7,
      "SectionIndex1": 0
