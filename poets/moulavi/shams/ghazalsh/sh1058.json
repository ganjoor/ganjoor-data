      "Position": "Left",
      "Text": "در عشق جفاست از وفا سیر",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "کز ملکت سیر شد سلیمان",
