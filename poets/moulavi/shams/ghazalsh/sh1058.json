      "Position": "Left",
      "Text": "تا لوت خورند اولیا سیر",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "تا ذوق جفاش دید جانم",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
