      "Position": "Right",
      "Text": "چه مکر و چه نعل باژگونه‌ست",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "خود گرسنه نادرست یا سیر",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
