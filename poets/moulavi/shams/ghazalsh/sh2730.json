    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "آورد خبر شکرستانی",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: خبر رسید که کاروانی از شکرستان به مصر آمده است."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "کز مصر رسید کاروانی",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "صد اشتر جمله شکر و قند",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای خدا، صد شتر که همه‌شان شکر و قند هستند، چه هدیه‌ی دلپذیری!"
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "یا رب چه لطیف ارمغانی",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "در نیم شبی رسید شمعی",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در نیمه شب، شمعی در کنار جسم بی‌جان ظاهر شد و روحی از آن جدا گشت."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "در قالب مرده رفت جانی",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "گفتم که بگو سخن گشاده",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: گفتم که صحبت کن، اما او پاسخ داد که زمان آن شخص فرا رسیده است."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "گفتا که رسید آن فلانی",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "دل از سبکی ز جای برجست",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دل به خاطر سبکی و خوشحالی از جای خودش بلند شد و به عقل مانند یک نردبان تکیه زد."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "بنهاد ز عقل نردبانی",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "بر بام دوید از سر عشق",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: بر روی سقف دوید و از شدت عشق به دنبال نشانه‌ای از این خبر می‌گشت."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "می‌جست از این خبر نشانی",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "ناگاه بدید از سر بام",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ناگهان او را دید که از روی بام به بیرون نگاه می‌کند و جهانی متفاوت از جهان ما را مشاهده می‌کند."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "بیرون ز جهان ما جهانی",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "دریای محیط در سبویی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دریای وسیع و بی‌کران در ظرفی کوچک چون یک سبو، در چهره‌ی خاکی و ساخته شده از آسمان."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "در صورت خاک آسمانی",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "بر بام نشسته پادشاهی",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: یک پادشاه بر بام نشسته و لباس نگهبانی به تن کرده است."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "پوشیده لباس پاسبانی",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "باغی و بهشت بی‌نهایت",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در دل مرد باغبانی، باغی زیبا و بهشتی بی‌پایان وجود دارد."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "در سینه مرد باغبانی",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "می‌گشت به سینه‌ها خیالش",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: او در دل‌ها می‌گشت و با خیال خود، از عشق به شاه، بیانی را ایجاد می‌کرد."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "می‌کرد ز شاه دل بیانی",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "مگریز ز چشمم ای خیالش",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: از دیدگانم دور باش ای خیال زیبایت، تا دلم نفسی تازه کند و شاداب شود."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "تا تازه شود دلم زمانی",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "شمس تبریز لامکان دید",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: شمس تبریز به جایی فراتر از مکان‌های عادی نگاه کرد و از آنجا فضایی جدید و فراوانی را شکل داد."
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "برساخت ز لامکان مکانی",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    }
  ]
