  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "یا کالمینا یا حاکمینا",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای کاش ما را مورد ظلم قرار ندهید، ای معلم ما، ای حاکم ما، ای مالک ما."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "یا مالکینا لا تَظلَمونا",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "یا ذَاالفَضائِل زهر الشَمائِل",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای کسی که دارای فضایل فراوانی هستی و زیبایی‌ها و خصایل نیکو در تو نهفته است، ای شمشیری که دلیل‌نمای حق و حقیقتی، به ما ظلم نکنید."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "سِیفُ الدَلائِل لا تظلمونا",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "یا نعم ساقی حلو التلاقی",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای ساقی، بگذار طعم دیدار شیرین باشد و جدایی را دور نگه‌دارید، ما را ظلم نکنید."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "مر الفراقٖ لا تظلمونا",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "فی القلب بارق مثل الطوارق",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: در دلِ من جرقه‌ای چون ستاره‌های درخشان در شرق و غرب وجود دارد، شما را به ظلمت نمی‌کشانم."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "بین المشارق لا تظلمونا",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "نادی المنادی فی کل وادی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: شخصی در هر گوشه و کنار دنیا فریاد می‌زند که ما را مورد ظلم قرار ندهید و در این خواسته هیچ اصراری وجود ندارد."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "لا بالعنادٖ لا تظلمونا",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "افدیک روحی عِندَ الصَبوحٖ",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: من جانم را فدای تو می‌کنم، ای با نشاط و خوش‌خبر در سپیده‌دم. از ما ظلم نکنید."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "یا ذَا الفتوحٖ لا تظلمونا",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "هذا فؤادی فی العشق بادی",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دل من در عشق آشکار است و در محبت بی‌پروا. شما ما را مظلوم نکنید."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "فی الحب عادی لا تظلمونا",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "إسمَع کَلامی نومی حرامی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به حرف من گوش کن، ای کسی که در میان انسان‌های محترم هستی، ما را ظلم و ستم نکنید."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "عند الکرامٖ لا تظلمونا",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "عشقی حصانی نحو المعانی",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: عشق مانند اسبی است که مرا به سمت معانی و مفاهیم می‌برد. این عشق برای من کافی است و نمی‌خواهم مورد ظلم و یا بی‌عدالتی قرار بگیرم."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "هذا کفانی لا تظلمونا",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "العشق حالٖ ملکٌ و مالٖ",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: عشق حالتی است که مانند پادشاهی و دارایی، خواب را از انسان می‌گیرد و ممکن نیست که در این حالت به کسی ظلم شود."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "نومی محال لا تظلمونا",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    }
  ]
}
