    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "که از اندیشه بیزارم، بده می",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "مرا تا کی به اندیشه سپاری؟!",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "چه حیله سازم ای ساقی؟! چه حیله؟!",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
