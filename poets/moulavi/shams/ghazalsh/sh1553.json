      "Text": "دامن دامن ز گل بچینیم",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "از باغ هر آنچ جمع کردیم",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
