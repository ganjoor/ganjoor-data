    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "این دم که نشسته‌ایم با هم",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "می بر کف و گل در آستینیم",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
