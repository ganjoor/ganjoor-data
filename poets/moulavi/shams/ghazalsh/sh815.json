      "Text": "کرد دیدم کو کند دزدی ولیک",
      "CoupletIndex": 5,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "کرد ما را بین که او دزدید کرد",
      "CoupletIndex": 5,
      "SectionIndex1": 1,
      "SectionIndex2": 6
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "کی گمان دارد که او دزدی کند",
      "CoupletIndex": 6,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "خاصه شه صوفی شد آمد مو سترد",
      "CoupletIndex": 6,
      "SectionIndex1": 1,
      "SectionIndex2": 7
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "دزد خونی بین که هر کس را که کشت",
      "CoupletIndex": 7,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "خضر و الیاسی شد و هرگز نمرد",
      "CoupletIndex": 7,
      "SectionIndex1": 1,
      "SectionIndex2": 8
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "رخت برد و بخت داد آنگه چه بخت",
      "CoupletIndex": 8,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "سیم برد و دامن پرزر شمرد",
      "CoupletIndex": 8,
      "SectionIndex1": 1,
      "SectionIndex2": 9
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "دردها و دردها را صاف کرد",
      "CoupletIndex": 9,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "پیش او آرید هر جا هست درد",
      "CoupletIndex": 9,
      "SectionIndex1": 1,
      "SectionIndex2": 10
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "این جهان چشمست و او چون مردمک",
      "CoupletIndex": 10,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "تنگ می‌آید جهان زین مرد خرد",
      "CoupletIndex": 10,
      "SectionIndex1": 1,
      "SectionIndex2": 11
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "باز رشک حق دهانم قفل کرد",
      "CoupletIndex": 11,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "شد کلید و قفل را جایی سپرد",
      "CoupletIndex": 11,
      "SectionIndex1": 1,
      "SectionIndex2": 12
    }
  ]
}
