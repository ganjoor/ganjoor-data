      "Text": "سر مرا هر یک غماز نو",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "گرم درآ گرم که آن گرمدار",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
