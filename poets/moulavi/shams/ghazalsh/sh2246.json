  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ای سر مردان برگو برگو",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای سرور و بزرگ مردان و ای شاه میدان، سخن بگو و باز هم بگو."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "وی شه میدان برگو برگو",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ای مه باقی وی شه ساقی",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای ماه پایدار و ای شاه ساقیان، ای جانِ سخن‌شناس، سخن بگو و بگو."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "جان سخن دان برگو برگو",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "قبله جمعی شعله شمعی",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تو قبلهٔ جمعی هستی که رو به تو دارند و شعلهٔ شمعِ آن جمعی؛ داستان آنان را بازگو کن."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "قصه ایشان برگو برگو",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "ای همه دستان ساقی مستان",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای که همهٔ نغمه‌ها و هنرها از توست و ساقی مستانی، راز گلستان را بگو."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "راز گلستان برگو برگو",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "هم همه دانی هم همه جانی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تو هم به همه‌چیز دانایی و هم جانِ همه‌چیزی؛ ای سرور دیوان و مجلس، سخن بگو."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "خواجه دیوان برگو برگو",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "آب حیاتی شاخ نباتی",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تو آب زندگی و شاخهٔ نیشکری؛ نکته‌های لطیفِ معشوق را بگو."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "نکته جانان برگو برگو",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "غم نپذیری خشم نگیری",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: تو غم را به خود راه نمی‌دهی و خشمگین نمی‌شوی؛ ای دلِ شادمانان، سخن بگو."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "ای دل شادان برگو برگو",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "خسرو شیرین بنشین بنشین",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای خسروِ شیرین‌کار، بنشین و از راه سپاهان (اصفهان) سخن بگو."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "راه سپاهان برگو برگو",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "دل بشکفتی خیلی و گفتی",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دل را بسیار شکوفا کردی و سخن گفتی؛ اکنون دوباره دو برابر آن بگو."
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "باز دو چندان برگو برگو",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "آن می صافی جام گزافی",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: آن شراب صاف را در جامی لبریز و بی‌حساب بده و خندان سخن بگو."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "درده و خندان برگو برگو",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "یار ربابی هر چه که یابی",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای همدمِ رباب، هرچه به دستت می‌آید، به حرمت ایمان آن را بگو."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "حرمت ایمان برگو برگو",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "نی بستیزی نی بگریزی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: نه ستیزه کن و نه بگریز؛ بی‌آغاز و انجام و بی‌پایان سخن بگو."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "بی‌سر و پایان برگو برگو",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    }
  ]
