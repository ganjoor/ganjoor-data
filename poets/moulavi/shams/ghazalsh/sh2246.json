  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ای سر مردان برگو برگو",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای سرداران بزرگ، بگو، بگو! ای فرمانده میدان، بگو، بگو!"
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "وی شه میدان برگو برگو",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ای مه باقی وی شه ساقی",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای ماه جاوید، ای سرور، ای نوش کننده جان، سخنان پندآموز را به من بگو و به من بایست بگو."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "جان سخن دان برگو برگو",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "قبله جمعی شعله شمعی",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به جمعی که به دور یک شمع جمع شده‌اند و مانند شعله‌های آن می‌درخشند، داستان و روایتی را بگو و بازگو کن."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "قصه ایشان برگو برگو",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "ای همه دستان ساقی مستان",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای ساقی، تو که دستانت پر از عشق و شادابی است، راز و رمز گلستان و زیبایی‌های آن را برای مستان بگو و روشن کن."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "راز گلستان برگو برگو",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "هم همه دانی هم همه جانی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: متن به بیان می‌آورد که همه چیز را می‌دانی و همه چیز برایت مهم است. ای صاحب مقام، هرچه می‌دانید، باز هم بگویید و تکرار کنید."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "خواجه دیوان برگو برگو",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "آب حیاتی شاخ نباتی",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: زندگی و روح واقعی به شاخ نباتی و آب حیات شبیه است و نکته‌های ظریف و زیبا از جانان را بازگو کن و بازگو کن."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "نکته جانان برگو برگو",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "غم نپذیری خشم نگیری",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای دل شاد، غم نخور و عصبانی نشو، از آنچه که در دل داری، بگو و بگو."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "ای دل شادان برگو برگو",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "خسرو شیرین بنشین بنشین",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: ای خسرو شیرین، بر روی تخت بنشین و به یاد سپاهان گام بردار و از دل مردم بگو."
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "راه سپاهان برگو برگو",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "دل بشکفتی خیلی و گفتی",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دل بسیار شاد و خوشحال شد و گفت: باز هم از شادی و خوشی بگو، بگو!"
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "باز دو چندان برگو برگو",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "آن می صافی جام گزافی",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: به ما شراب خالص و گوارا بده و با لبخند بگو که بیا، بیا."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "درده و خندان برگو برگو",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "یار ربابی هر چه که یابی",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: دوست من، هر چیزی که به دست می‌آوری، به احترام ایمان به من بگو و بگو."
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "حرمت ایمان برگو برگو",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "نی بستیزی نی بگریزی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "CoupletSummary": "هوش مصنوعی: نه با کسی درشت‌خویی کن و نه فرار کن، بی‌هیچ سرانجامی فقط فریاد بزن و بگو."
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "بی‌سر و پایان برگو برگو",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    }
  ]
}
