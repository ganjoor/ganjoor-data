      "Text": "روح، که بود از تن خود لنگری",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "گرچه جدا گشت ز دست و ز پا",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
