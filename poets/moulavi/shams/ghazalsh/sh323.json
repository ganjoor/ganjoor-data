      "VOrder": 1,
      "Position": "Right",
      "Text": "آن نفسی که باخودی یار چو خار آیدت",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "وان نفسی که بیخودی یار چه کار آیدت",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "آن نفسی که باخودی خود تو شکار پشه‌ای",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "وان نفسی که بیخودی پیل شکار آیدت",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "آن نفسی که باخودی بستهٔ ابر غصه‌ای",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "وان نفسی که بیخودی مه به کنار آیدت",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "آن نفسی که باخودی یار کناره می‌کند",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "وان نفسی که بیخودی بادهٔ یار آیدت",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "آن نفسی که باخودی همچو خزان فسرده‌ای",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "وان نفسی که بیخودی دی چو بهار آیدت",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "جملهٔ بی‌قراریت از طلب قرار توست",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "طالب بی‌قرار شو تا که قرار آیدت",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "جملهٔ ناگوارشت از طلب گوارش است",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "ترک گوارش ار کنی زهر گوار آیدت",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "جملهٔ بی‌مرادیت از طلب مراد توست",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "ور نه همه مرادها همچو نثار آیدت",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
