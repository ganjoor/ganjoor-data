      "HtmlText": "\u003Cdiv class=\u0022b2\u0022 id=\u0022bn1\u0022\u003E\u003Cp\u003Eبه تبریز آ دلا، از بهر عشقش\u003C/p\u003E\r\n\u003Cp\u003Eچو بندهٔ عیبناک اندر مزادی\u003C/p\u003E\u003C/div\u003E",
      "CoupletsCount": 1
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "زهی دریا زهی بحر حیاتی",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "زهی حسن و جمال و فر ذاتی",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ز تو جانم براتی خواست از رنج",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "یکی شمعی فرستادش، براتی",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "ز تندی عشق او آهن چو مومست",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "زهی عشق حرون تند عاتی",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "ولیکن سر عشقش شکرستان",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "ز نخلستان ز جوهای فراتی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "شکر لب، مه رخان جام بر کف",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "تو می‌گو هر کرا خواهی که: « هاتی »",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "ز هر لعل لبی بوست رسیده",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "تو درویشی و آن لعلش زکاتی",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "در آن شطرنج اگر بردی تو، شاهی",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "ولی کو بخت پنهان؟! چونک ماتی",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "خداوند شمس دین دریای جان‌بخش",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "تو شورستان درین دولت، مواتی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "زهی شاهی، لطیفی، بی‌نظیری",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "که مجموعست ازو جان شتاتی",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "اگر تبریز دارد حبهٔ زو",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "چه نقصان گر شود از گنجها، تی",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 21,
      "Position": "CenteredVerse1",
      "Text": "هزاران زاهد زهد صلاحی",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 6
    },
    {
      "VOrder": 22,
      "Position": "CenteredVerse2",
      "Text": "ز تو خونش مباح و او مباحی",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 6
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "زهی کعبه که تو جان‌بخش حاجی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "زهی اقبال هر محتاج راجی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "هر آن سر کو فرو ناید به کیوان",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "ز روی فخر، بر فرقش تو تاجی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "نهاده سر به تسلیم و به طاعت",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "به پیشت از دل و جان هر لجاجی",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "زهی نور جهان جان، که نورت",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "نه از خورشید و ماهست و سراجی",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "همه جانها باقطاع مثالت",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "که بعضی عشری، و بعضی خراجی",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "خداوند! شمس دینا! این مدیحت",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "بجای جاه و فرت هست هاجی",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "ایا تبریز، بستان باج جانها",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "که فرمان ده توی بر جان و باجی",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "مزاج دل اگر چون برف گردد",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "ز آتشهای تو گردد نتاجی",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "هرآن جان و دلی کان زنده باشد",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "ز مهر تستشان دایم تناجی",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "در آن بازار کز تو هست بویی",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "زهی مر یوسفان را بی‌رواجی",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 43,
      "Position": "CenteredVerse1",
      "Text": "به چرخ چارمت عیسیست داعی",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 7
    },
    {
      "VOrder": 44,
      "Position": "CenteredVerse2",
      "Text": "به پیش دولتت چاوش ساعی",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 7
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "ز شاه ماست ملک با مرادی",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "که او ختمست احسان را، و بادی",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "گر احسان را زبان باشد بگردد",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "به مدح و شکر او سیصد عبادی",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "بدان سوی جهان گر گوش داری",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "چه چاوشان جانندش منادی!",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "دهان آفرینش باز مانده",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "ازان روزی که دیدستش ز شادی",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "همی گوید به عالم او به سوگند",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "که: « تا زادی، چنین روزی نزادی »",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "یکی چندی نهان شو تا نگردد",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "همه بازار مه‌رویان کسادی",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "بدیدم عشق خونی را فتاده",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "به خاک و خون بگفتم: « چون فتادی؟ »",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "که تو خون‌ریز جمله عاشقانی",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "تو نیزک دل چنین بر باد دادی؟! »",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "بگفتا: « دیده‌ام چیزی که صد ماه",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "ازو سوزند در نار ودادی »",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "خداوند شمس دین! آخر چه نوری؟",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "فرشته یا پری، یا تش نژادی",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 65,
      "Position": "CenteredVerse1",
      "Text": "به تبریز آ دلا، از بهر عشقش",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 8
    },
    {
      "VOrder": 66,
      "Position": "CenteredVerse2",
      "Text": "چو بندهٔ عیبناک اندر مزادی",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 8
    }
  ]
}
