    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "مکن رخ همچو زر از غصهٔ سیم",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "که تا زین سیم، ز آن سیما نمانی",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "چو تو ملک ابد جویی به همت",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "ازین نان و ازین شربا نمانی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "رها کن عربده، خو کن حلیمی",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "که تا از بزم شاه ما نمانی",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "همی کش سرمهٔ تعظیم در چشم",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "پیاپی، تا که نابینا نمانی",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "چو ذره باش پویان سوی خورشید",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "که تا چون خاک، زیر پا نمانی",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "چو استاره به بالا شب‌روی کن",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "که تا ز آن ماه بی‌همتا نمانی",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "مزن هر کوزه را در خنب صفوت",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "که تا از عروةالوثقی نمانی",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 27,
      "Position": "CenteredVerse1",
      "Text": "ز بعد این غزل ترجیع باید",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 6
    },
    {
      "VOrder": 28,
      "Position": "CenteredVerse2",
      "Text": "شراب گل مکرر خوشتر آید",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 6
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "چو در عهد و وفا دلدار مایی",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "چو خوانیمت، چرا دل‌وار نایی؟",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "چو الحمدت همی خوانیم پیوست",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "کچون الحمد دفع رنجهایی",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "درآ در سینها کآرام جانی",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "درآ در دیدها که توتیایی",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "فرو کن سر ز روزنهای دلها",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "که چاره نیست هیچ از روشنایی",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "چو عقلی بی‌تو دیوانه شود مرد",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "چو جانی، کس نمی‌داند کجایی",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "چو خمری، در سر مستان درافتی",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "برآیند از حیا و پارسایی",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "نباشد حسن بی‌تصدیع عشاق",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "که نبود عیدها بی‌روستایی",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "اگر چیزی نمی‌دانم به عالم",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "همی دانم که تو بس جان‌فزایی",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "چه جولانها کنند جانها چو ذرات",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "که تو خورشید از مشرق برآیی",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "به جانبازی گشاده‌دار، دو دست",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "که حاتم را تو استاد سخایی",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "مکش پای از گلیم خویش افزون",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "که تا داناتر آیی از کسایی",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "عدو را مار و ما را یار می‌باش",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "که موسی صفا را تو عصایی",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "تمسک کن به اسباب سماوات",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "که در تنویر قندیل سمایی",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 55,
      "Position": "CenteredVerse1",
      "Text": "به ترجیع سوم مرصاد بستیم",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 7
    },
    {
      "VOrder": 56,
      "Position": "CenteredVerse2",
      "Text": "که بر بوی رجوع یار مستیم",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 7
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "ایا خوبی، که در جانها مقیمی",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "به وقت بی‌کسی جان را ندیمی",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "ز تو باغ حقایق برشکفتست",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "نباتش را هم آبی، هم نسیمی",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "چو خوبان فانی و معزول گردند",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "تو در خوبی و زیبایی مقیمی",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "به وقت قحط بفرستی تو خوانی",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "خذوا رزقا کریما من کریم",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "سهیلی دیگری در چرخ معنی",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "یزکی کل روح کالادیم",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "درآری نیمشب، روشن شرابی",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "بگردانی، که اشرب یا حمیمی",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "زهی ساقی، زهی جام، و زهی می",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "نعیم قی نعیم فی نعیم",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "هزاران صورت زیبا و دلبر",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "یولدهم شرابک من عقیم",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "حباب آن شراب و صفوت او",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "شفاء فی شفاء للسقیم",
      "CoupletIndex": 36,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "تصاعد سکره فی ام رأس",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "ازال اللوم فی طبع اللئیم",
      "CoupletIndex": 37,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "شود صحرای بی‌پایان اخضر",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "فواد ضیقه کقلب میم",
      "CoupletIndex": 38,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "فطوبی للندامی والسکارا",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "اذا ماهم حسوها حسوهیم",
      "CoupletIndex": 39,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "ز یسقون رحیقا نوش می‌کن",
      "CoupletIndex": 40,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "وخل ذاالتحدث یا کلیمی",
      "CoupletIndex": 40,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 83,
      "Position": "CenteredVerse1",
      "Text": "کسی که آفتاب آمد غلامش",
      "CoupletIndex": 41,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 8
    },
    {
      "VOrder": 84,
      "Position": "CenteredVerse2",
      "Text": "همی آید به مشتاقان سلامش",
      "CoupletIndex": 41,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 8
    }
  ]
}
