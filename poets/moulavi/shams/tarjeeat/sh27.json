      "Text": "مظلوم و شکسته دل شمارش",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "گشتست چو لاله غرقهٔ خون",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "گشتست چو زعفران عذارش",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "خواهد که به پیش تو بمیرد",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "اینست همیشه کسب و کارش",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "یاری دگری کجا پسندد",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "آن را که خدا بدست یارش؟",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "آن را که بخواندهٔ تو روزی",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "مسپار بدست روزگارش",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "هرچند به زیر کوه غم ماند",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "اندیشهٔ تست یار غارش",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "امسال چو ماه می‌گدازد",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "می‌آید یاد وصل پارش",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "راهی بگشا درین بیابان",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "ماهی بنما درین غبارش",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 71,
      "Position": "CenteredVerse1",
      "Text": "گر شرح کنم تمام پیغام",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 8
    },
    {
      "VOrder": 72,
      "Position": "CenteredVerse2",
      "Text": "می‌مانم از شراب و از جام",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 8
    }
  ]
}
