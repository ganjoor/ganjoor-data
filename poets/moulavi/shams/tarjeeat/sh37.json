      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "رنجور بود جهان به تشویش",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "بی‌عدل و سیاست و لوایی",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "بیماری و علت جهان را",
