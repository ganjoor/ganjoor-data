      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "خیز ای صوفی، بکن غزایی",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 63,
