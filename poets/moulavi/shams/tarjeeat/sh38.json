      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "در نیست، وجود می‌نمایی",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "دی کرده هزار گونه توبه",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "بگرفته طریق پارسایی",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "چون بیند توبه روی خوبت",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "داند که عدوی تو بهایی",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "بگریزد توبه و دل او را",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "فریادکنان، بیا، کجایی؟",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "گوید که: « رسید مرگ توبه",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "از توبه دگر مجو کیایی",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "توبه اگر اژدهای نر بود",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "ای عشق، زمرد خدایی",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 1
    },
    {
      "VOrder": 19,
      "Position": "CenteredVerse1",
      "Text": "ترجیع نهم به گوش قوال",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 6
    },
    {
      "VOrder": 20,
      "Position": "CenteredVerse2",
      "Text": "تو گوش رباب را همی مال",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 6
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "ای بسته ز توبه بیست ترکش",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "بستان قدحی رحیق و درکش",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "زیرا که فضای بی‌امانست",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "آن زلف معنبر مشوش",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "ای شاهد وقت، وقت شه رخ",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "سودت نیکند رخ مکرمش",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "بینی کردن چه سود دارد؟",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "با آن که دهان زنی چو گربش",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "سجده کن و سر مکش چو ابلیس",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "پیش رخ این نگار مه‌وش",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "از شش جهت است یار بیرون",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "پرنور شده ز روش هر شش",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "دلدار امروز سخت مستست",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "پرفتنه و غصه و مخمش",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "جان دارد صدهزار حیرت",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "از حسن منقش منقش",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "از عشق زمین پر از شقایق",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "در عشق فلک چنین منعش",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "خاموش و شراب عشق کم‌نوش",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "ایمن شو از ارتعاش و مرعش",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 41,
      "Position": "CenteredVerse1",
      "Text": "چون لعل لبت نمود تلقین",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 7
    },
    {
      "VOrder": 42,
      "Position": "CenteredVerse2",
      "Text": "بر دل ننهیم بند لعلین",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 7
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "تا ساقی ما توی بیاری",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "کفرست و حرام، هوشیاری",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "ای عقل، اگرچه بس عزیزی",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "در مست نظر مکن به خواری",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "گر آن، داری، نکو نظر کن",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "کان کو دارد، تو آن نداری",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "گر پای ترا بتی بگیرد",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "یکدم نهلد که سر به خاری",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "دیوانه شوی که تو ز سودا",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "در ریگ سیاه، تخم کاری",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "در مرگ حیات دید عارف",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "چون رست ز دیدهای ناری",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "نورآمد و نار را فرو کشت",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "دی را بکشد دم بهاری",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "در چشم تو شب اگرچه تیره‌ست",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "در دیدهٔ او کند نهاری",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "می‌گوید عشق با دو چشمش",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "« مستی و خوشی و پرخماری »",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "بس کردم، تا که عشق بی‌من",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "تنها بکند سخن گزاری",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 63,
      "Position": "CenteredVerse1",
      "Text": "امروز دلست آرزومند",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 8
    },
    {
      "VOrder": 64,
      "Position": "CenteredVerse2",
      "Text": "چون طره اوست بند بربند",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 8
    }
  ]
}
