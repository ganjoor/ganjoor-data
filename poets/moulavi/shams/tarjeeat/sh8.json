      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 6
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "ای رخ تو حسرت ماه و پری",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "پر بگشادی به کجا می‌پری",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "هین گروی ده سره آنگه برو",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "رفتن تو نیست ز ما سرسری",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "زنده جهان ز آب حیات توست",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "مست قروی تو دل لاغری",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "خود چه بود خاک که در چرخ تست",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "این فلک روشن نیلوفری",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "زین بگذشتم به خدا راست گو",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "رخت ازین خانه کجا می‌بری",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "در دو جهان کار تو داری و بس",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "راست بگو تا بچه کار اندری",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "ور بنگویی تو گواهی دهد",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "چشم تو آن فتنه گر عبهری",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "جان چو دریای تو تنگ آمدست",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "زین وطن مختصر ششدری",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "چون نشوی سیر ازین آب شور",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "چونک امیر آب دو صد کوثری",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "رست ز پای تو به فضل خدا",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "بهر ره چرخ پر جعفری",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "شاعر تو دست دهان برنهاد",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "تا که کند شاه به خود شاعری",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 47,
      "Position": "CenteredVerse1",
      "Text": "شاه همی گوید ترجیع را",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 7
    },
    {
      "VOrder": 48,
      "Position": "CenteredVerse2",
      "Text": "تا سه تمامش کن و باقی ترا",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 7
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "ای که ملک طوطی آن قندهات",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "کوزه‌گرم کوزه کنم از نبات",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "لیک فقیرم تو ز یاقوت خویش",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "وقت زکاتست مرا ده زکات",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "سابق خیری تو و خاصه کنون",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "موسم خیرست و اوان صلات",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "نک رمضان آمد و قدرست و عید",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "وز تو رسیدست در آن شب برات",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "در هوس بحر تو دارم لبی",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "کان نشود تر ز هزاران فرات",
      "CoupletIndex": 28,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "حبس دلم چاه زنخدان تست",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "کی طلبم زین چه و زندان نجات",
      "CoupletIndex": 29,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "عرض فلک دارد این قعر چاه",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "عرصهٔ او تیز نظر را کفات",
      "CoupletIndex": 30,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "صورت عشقی تو و بی‌صورتی",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "این عدد اندر صفت آمد نه ذات",
      "CoupletIndex": 31,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "هم تو بگو زانک سخنهای خلق",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "پیش کلام توبود ترهات",
      "CoupletIndex": 32,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "هم تو بگو ای شه نطع وجود",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "ای همه شاهان ز تو در بیت مات",
      "CoupletIndex": 33,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "چونک سه ترجیع بگفتم بده",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "تا عربی گویم یا سعد هات",
      "CoupletIndex": 34,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 71,
      "Position": "CenteredVerse1",
      "Text": "یا قمرالحسن مزیل‌الظلام",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 8
    },
    {
      "VOrder": 72,
      "Position": "CenteredVerse2",
      "Text": "جد بطلوع مع کاس المدام",
      "CoupletIndex": 35,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "SectionIndex3": 8
    }
  ]
}
