      "Text": "ای دل من باده بخور فاش فاش",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "حد نزنندت، چو تو بی‌حد شدی",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "حد اگر باشد هم بگذرد",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "شاد بمان تو که مخلد شدی",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "ای دل پرکینه مصفا شدی",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "وی تن دیرینه، مجدد شدی",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "مست همی باش و مَیا سوی خود",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "چون به خود آیی، تو مقید شدی",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "روح چو آب‌ست و بدن همچو خاک",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "آبی و از خاک مجرد شدی",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "تیره بُدی در بُن خنب جهان",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "راوقی اکنون و مصعد شدی",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "خواست چراغت که بمیرد ولیک",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "رو که به خورشید موید شدی",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "جان تو خفاش بُد و باز شد",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "چونک درین نور معود شدی",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "هم نفسی آمد، لب را ببند",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "تا بکی ای دم تو درآمد شدی",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 47,
      "Position": "CenteredVerse1",
      "Text": "ساقی جان آمد با جام جم",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "SectionIndex3": 6
    },
    {
      "VOrder": 48,
      "Position": "CenteredVerse2",
      "Text": "نوبت عشرت شد خامش کنم",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "SectionIndex3": 6
    }
  ]
}
