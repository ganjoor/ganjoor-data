  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "چونک تعویق آمد اندر عرض و طول",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "شاه شد زان گنج دل سیر و ملول",
