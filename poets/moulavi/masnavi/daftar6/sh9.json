  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "شرفه‌ای بشنید در شب معتمد",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2,
      "CoupletSummary": "هوش مصنوعی: مرد امانت‌دار (صاحب‌خانه) در شب صدای پایی شنید و آتش‌زنه را برداشت تا آتش روشن کند و ببیند چه کسی آمده است."
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "برگرفت آتش‌زنه که آتش زند",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "دزد آمد آن زمان پیشش نشست",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3,
      "CoupletSummary": "هوش مصنوعی: دزد همان لحظه آمد و نزدیک او نشست و هر بار که آتش در سوخته (پارچهٔ آتش‌گیر) می‌گرفت، آن را خاموش می‌کرد."
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "چون گرفت آن سوخته می‌کرد پست",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "می‌نهاد آنجا سر انگشت را",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4,
      "CoupletSummary": "هوش مصنوعی: دزد نوک انگشتش را روی سوخته می‌گذاشت تا جرقهٔ آتش از میان برود."
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "تا شود استارهٔ آتش فنا",
      "CoupletIndex": 2,
      "SectionIndex1": 0,
      "SectionIndex2": 4
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "خواجه می‌پنداشت کز خود می‌مرد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5,
      "CoupletSummary": "هوش مصنوعی: صاحب‌خانه گمان می‌کرد آتش خودبه‌خود خاموش می‌شود و نمی‌دید که دزد آن را خاموش می‌کند."
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "این نمی‌دید او که دزدش می‌کشد",
      "CoupletIndex": 3,
      "SectionIndex1": 0,
      "SectionIndex2": 5
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "خواجه گفت این سوخته نمناک بود",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6,
      "CoupletSummary": "هوش مصنوعی: صاحب‌خانه گفت این سوخته نمناک است و جرقه از خیسی آن زود خاموش می‌شود."
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "می‌مرد استاره از تریش زود",
      "CoupletIndex": 4,
      "SectionIndex1": 0,
      "SectionIndex2": 6
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "بس که ظلمت بود و تاریکی ز پیش",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7,
      "CoupletSummary": "هوش مصنوعی: چون پیش رویش تاریکی بسیار بود، کسی را که آتش را خاموش می‌کرد در کنار خود نمی‌دید."
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "می‌ندید آتش‌کشی را پیش خویش",
      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "این چنین آتش‌کشی اندر دلش",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8,
      "CoupletSummary": "هوش مصنوعی: به همین‌سان، چشم کافر از کوری دل، آن خاموش‌کننده‌ای را که در دلش آتش را می‌کُشد (یعنی دست پنهان خدا در کارها) نمی‌بیند."
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "دیدهٔ کافر نبیند از عمش",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "چون نمی‌داند دل داننده‌ای",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9,
      "CoupletSummary": "هوش مصنوعی: چرا دلِ کسی که اهل دانش است نمی‌فهمد که هر چیز گردنده، گرداننده‌ای دارد؟"
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "هست با گردنده گرداننده‌ای",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "چون نمی‌گویی که روز و شب به خود",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10,
      "CoupletSummary": "هوش مصنوعی: چرا نمی‌گویی که شب و روز چگونه خودبه‌خود و بی‌صاحبی می‌آیند و می‌روند؟"
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "بی‌خداوندی کی آید کی رود",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "گرد معقولات می‌گردی ببین",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11,
      "CoupletSummary": "هوش مصنوعی: ای که خود را بزرگ می‌پنداری و پیرامون معقولات و استدلال‌ها می‌گردی، این بی‌خردی خود را ببین."
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "این چنین بی‌عقلی خود ای مهین",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "خانه با بنا بود معقول‌تر",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12,
      "CoupletSummary": "هوش مصنوعی: ای کم‌هنر، بگو خانه‌ای که بنّایی دارد پذیرفتنی‌تر است یا خانه‌ای بی‌بنّا؟"
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "یا که بی‌بنا بگو ای کم‌هنر",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "خط با کاتب بود معقول‌تر",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13,
      "CoupletSummary": "هوش مصنوعی: ای پسر، بیندیش که نوشته با نویسنده عاقلانه‌تر است یا بی‌نویسنده؟"
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "یا که بی‌کاتب بیندیش ای پسر",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "جیم گوش و عین چشم و میم فم",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14,
      "CoupletSummary": "هوش مصنوعی: گوش که مانند حرف جیم است و چشم مانند عین و دهان مانند میم، ای متّهم، چگونه بی‌نویسنده‌ای پدید آمده‌اند؟"
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "چون بود بی‌کاتبی ای متهم",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "شمع روشن بی‌ز گیراننده‌ای",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15,
      "CoupletSummary": "هوش مصنوعی: آیا شمع بی‌آنکه کسی آن را روشن کند روشن است، یا روشن‌کننده‌ای آگاه آن را افروخته است؟"
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "یا بگیرانندهٔ داننده‌ای",
      "CoupletIndex": 13,
      "SectionIndex1": 0,
      "SectionIndex2": 15
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "صنعت خوب از کف شل ضریر",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16,
      "CoupletSummary": "هوش مصنوعی: آیا صنعت و ساخته‌ای نیکو از دست شل و کور سزاوارتر است یا از استادی بینا و چیره‌دست؟"
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "باشد اولی یا بگیرایی بصیر",
      "CoupletIndex": 14,
      "SectionIndex1": 0,
      "SectionIndex2": 16
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "پس چو دانستی که قهرت می‌کند",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17,
      "CoupletSummary": "هوش مصنوعی: پس اکنون که دانستی کسی تو را مقهور می‌کند و گرز رنج و محنت بر سرت می‌کوبد،"
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "بر سرت دبوس محنت می‌زند",
      "CoupletIndex": 15,
      "SectionIndex1": 0,
      "SectionIndex2": 17
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "پس بکن دفعش چو نمرودی به جنگ",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18,
      "CoupletSummary": "هوش مصنوعی: اگر می‌توانی مانند نمرود به جنگش برو و او را دفع کن و تیری به سوی آسمان بینداز."
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "سوی او کش در هوا تیری خدنگ",
      "CoupletIndex": 16,
      "SectionIndex1": 0,
      "SectionIndex2": 18
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "هم‌چو اسپاه مغل بر آسمان",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19,
      "CoupletSummary": "هوش مصنوعی: یا مانند سپاه مغول برای دفع مرگ و جان‌کندن به آسمان تیر بینداز؛ سخنی طعنه‌آمیز که بیهودگی ستیز با خدا را نشان می‌دهد."
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "تیر می‌انداز دفع نزع جان",
      "CoupletIndex": 17,
      "SectionIndex1": 0,
      "SectionIndex2": 19
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "یا گریز از وی اگر توانی برو",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20,
      "CoupletSummary": "هوش مصنوعی: یا اگر می‌توانی از او بگریز؛ اما چگونه می‌گریزی وقتی در دست او گرو و اسیری؟"
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "چون روی چون در کف اویی گرو",
      "CoupletIndex": 18,
      "SectionIndex1": 0,
      "SectionIndex2": 20
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "در عدم بودی نرستی از کفش",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21,
      "CoupletSummary": "هوش مصنوعی: تو حتی وقتی در نیستی بودی از دست او رها نبودی؛ ای بازیچهٔ دست او، اکنون چگونه رها می‌شوی؟"
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "از کف او چون رهی ای دست‌خوش",
      "CoupletIndex": 19,
      "SectionIndex1": 0,
      "SectionIndex2": 21
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "آرزو جستن بود بگریختن",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22,
      "CoupletSummary": "هوش مصنوعی: دنبال آرزو و هوس رفتن خود نوعی گریختن از خداست و در برابر عدل او ریختن خون پرهیزگاری است."
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "پیش عدلش خون تقوی ریختن",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "این جهان دامست و دانه‌آرزو",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23,
      "CoupletSummary": "هوش مصنوعی: این جهان دام است و دانه‌اش آرزوست؛ برای گریز از دام‌ها زود به سوی خدا روی آور."
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "در گریز از دامها روی آر زو",
      "CoupletIndex": 21,
      "SectionIndex1": 0,
      "SectionIndex2": 23
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "چون چنین رفتی بدیدی صد گشاد",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24,
      "CoupletSummary": "هوش مصنوعی: وقتی چنین راه رفتی (از آرزو گریختی) صد گشایش دیدی و هرگاه خلاف آن کردی تباهی دیدی."
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "چون شدی در ضد آن دیدی فساد",
      "CoupletIndex": 22,
      "SectionIndex1": 0,
      "SectionIndex2": 24
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "پس پیمبر گفت استفتوا القلوب",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25,
      "CoupletSummary": "هوش مصنوعی: از این رو پیامبر فرمود از دل‌هایتان فتوا بخواهید، هرچند مفتیان بیرونی سخنان دیگر و بزرگ بگویند."
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "گرچه مفتیتان برون گوید خطوب",
      "CoupletIndex": 23,
      "SectionIndex1": 0,
      "SectionIndex2": 25
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "آرزو بگذار تا رحم آیدش",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26,
      "CoupletSummary": "هوش مصنوعی: آرزو را رها کن تا خدا بر تو رحم آورد؛ خود آزموده‌ای که او چنین را می‌پسندد."
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "آزمودی که چنین می‌بایدش",
      "CoupletIndex": 24,
      "SectionIndex1": 0,
      "SectionIndex2": 26
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "چون نتانی جست پس خدمت کنش",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27,
      "CoupletSummary": "هوش مصنوعی: چون نمی‌توانی از او بگریزی، پس بندگی و خدمتش کن تا از زندان او به گلستان او راه یابی."
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "تا روی از حبس او در گلشنش",
      "CoupletIndex": 25,
      "SectionIndex1": 0,
      "SectionIndex2": 27
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "دم به دم چون تو مراقب می‌شوی",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28,
      "CoupletSummary": "هوش مصنوعی: ای گمراه، اگر لحظه به لحظه مراقب حال خود باشی، هم عدل و داد را می‌بینی و هم دادگر را."
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "داد می‌بینی و داور ای غوی",
      "CoupletIndex": 26,
      "SectionIndex1": 0,
      "SectionIndex2": 28
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "ور ببندی چشم خود را ز احتجاب",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29,
      "CoupletSummary": "هوش مصنوعی: و اگر از سر پوشیدگی چشمت را ببندی، آفتاب کار خود را رها نمی‌کند؛ یعنی ندیدن تو چیزی از حقیقت نمی‌کاهد."
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "کار خود را کی گذارد آفتاب",
      "CoupletIndex": 27,
      "SectionIndex1": 0,
      "SectionIndex2": 29
    }
  ]
}
