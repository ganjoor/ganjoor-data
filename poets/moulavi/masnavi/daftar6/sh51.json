  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "گفت قاضی صوفیا خیره مشو",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "یک مثالی در بیان این شنو",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "هم‌چنانک بی‌قراری عاشقان",
