  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "چون بپیوستی بدان ای زینهار",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
