  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "آتشی افتاد در عهد عمر",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "همچو چوب خشک می‌خورد او حجر",
