  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "این حکایت بشنو از صاحب بیان",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "در طریق و عادت قزوینیان",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "بر تن و دست و کَتَف‌ها بی‌گزند",
      "CoupletIndex": 1,
      "SectionIndex1": 0,
      "SectionIndex2": 3
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "از سر سوزن کبودیها زنند",
