      "Text": "گو بشو سرکنگبین او از شکر",
      "CoupletIndex": 12,
      "SectionIndex1": 0,
      "SectionIndex2": 14
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "معنی اندر شعر جز با خبط نیست",
