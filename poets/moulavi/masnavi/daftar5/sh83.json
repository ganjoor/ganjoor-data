      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "خونبهای جرم نفس قاتله",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "هست بر حلمش دیت بر عاقله",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
