      "Position": "Left",
      "Text": "خوب‌تر از تو بدو بسپرده‌ام",
      "CoupletIndex": 20,
      "SectionIndex1": 0,
      "SectionIndex2": 22
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "در امانت یافتم او را تمام",
