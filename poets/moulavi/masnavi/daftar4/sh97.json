      "CoupletIndex": 5,
      "SectionIndex1": 0,
      "SectionIndex2": 7
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "پس به دست خویش گیری تیشه‌ای",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "می‌زنی بر خانه بی‌اندیشه‌ای",
      "CoupletIndex": 6,
      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "که حجاب گنج بینی خانه را",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "مانع صد خرمن این یک دانه را",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "پس در آتش افکنی این دانه را",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "پیش گیری پیشهٔ مردانه را",
      "CoupletIndex": 8,
      "SectionIndex1": 0,
      "SectionIndex2": 10
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "ای به یک برگی ز باغی مانده",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "هم‌چو کرمی برگش از رز رانده",
      "CoupletIndex": 9,
      "SectionIndex1": 0,
      "SectionIndex2": 11
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "چون کرم این کرم را بیدار کرد",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "اژدهای جهل را این کرم خورد",
      "CoupletIndex": 10,
      "SectionIndex1": 0,
      "SectionIndex2": 12
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "کرم کرمی شد پر از میوه و درخت",
      "CoupletIndex": 11,
      "SectionIndex1": 0,
      "SectionIndex2": 13
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "این چنین تبدیل گردد نیکبخت",
