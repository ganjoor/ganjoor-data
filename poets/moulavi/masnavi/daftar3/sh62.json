      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "می‌نبینی حال من در احتراق",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
