      "SectionIndex1": 0,
      "SectionIndex2": 8
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "خواجه را کشتی باستم زار زار",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "هم برینجا خواجه گویان زینهار",
      "CoupletIndex": 7,
      "SectionIndex1": 0,
      "SectionIndex2": 9
