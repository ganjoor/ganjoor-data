  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "که لئیمان در جفا صافی شوند",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "چون وفا بینند خود جافی شوند",
