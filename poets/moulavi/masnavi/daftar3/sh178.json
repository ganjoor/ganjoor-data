  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "در بخارا بندهٔ صدر جهان",
      "CoupletIndex": 0,
      "SectionIndex1": 0,
      "SectionIndex2": 2
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "متهم شد گشت از صدرش نهان",
